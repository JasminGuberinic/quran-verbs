tUsed": false, "spoken": "audio/bbce4a8706599887fd5c.m4a", "recited": "audio/9b52b4f5c4ca0cfd3aa5.m4a", "recitedText": "وَٱرْجُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُرْجُونَ", "plain": "اُرْجُونَ", "quran": false, "notUsed": false, "spoken": "audio/edb82250e61a7c73c191.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "78:27", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5699.mp3", "translation": {"en": {"text": "For lo! they looked not for a reckoning;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Çünkü onlar hiçbir hesap ummazlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک انہیں حساب کا خوف نہ تھا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya mereka tidak berharap (takut) kepada hisab,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَرْجُونَ", "hit": true, "audio": "audio/c0a911b3c4e880ab60a8.m4a", "gloss": {"bs": "nadaju se", "en": "they hope", "tr": "umarlar", "fr": "ils espèrent", "id": "mereka berharap", "ur": "وہ امید رکھتے ہیں", "bn": "তারা আশা করে", "fa": "امید دارند"}}, {"text": "حِسَابًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "29:5", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3345.mp3", "translation": {"en": {"text": "Whoso looketh forward to the meeting with Allah (let him know that) Allah's reckoning is surely nigh, and He is the Hearer, the Knower.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Her kim Allah'a kavuşmayı umuyorsa bilsin ki, Allah'ın tayin ettiği o vakit elbette gelecektir. O her şeyi işiten ve bilendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جسے اللہ سے ملنے کی امید ہو تو بیشک اللہ کی میعاد ضرور آنے والی ہے اور وہی سنتا جانتا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Barangsiapa yang mengharap pertemuan dengan Allah, maka sesungguhnya waktu (yang dijanjikan) Allah itu, pasti datang. Dan Dialah Yang Maha mendengar lagi Maha Mengetahui.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَرْجُوا۟", "hit": true, "audio": "audio/1a6951a69e711874b537.m4a", "gloss": {"en": "he/it hopes", "bs": "nada se", "tr": "umar", "fr": "il espère", "id": "dia berharap", "ur": "وہ امید رکھتا ہے", "bn": "সে আশা করে", "fa": "امید دارد"}}, {"text": "لِقَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجَلَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَءَاتٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمِيعُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَلِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "71:13", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5432.mp3", "translation": {"en": {"text": "What aileth you that ye hope not toward Allah for dignity", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Niçin siz Allah'a bir vakar yakıştıramıyorsunuz?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تمہیں کیا ہوا اللہ سے عزت حاصل کرنے کی امید نہیں کرتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mengapa kamu tidak percaya akan kebesaran Allah?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَرْجُونَ", "hit": true, "audio": "audio/e90a0bc6f92e56bd35e9.m4a", "gloss": {"en": "you (all) hope", "bs": "nadate se", "tr": "umarsınız", "fr": "vous espérez", "id": "kalian berharap", "ur": "تم امید رکھتے ہو", "bn": "তোমরা আশা কর", "fa": "امید دارید"}}, {"text": "لِلَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَقَارًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "17:28", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2057.mp3", "translation": {"en": {"text": "But if thou turn away from them, seeking mercy from thy Lord, for which thou hopest, then speak unto them a reasonable word.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer Rabbinden beklediğin bir rahmet (rızık) için, onlardan yüz çevirmek mecburiyetinde kalırsan, o vakit de onlara yumuşak ve tatlı bir söz söyle.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر تو ان سے منہ پھیرے اپنے رب کی رحمت کے انتظار میں جس کی تجھے امید ہے تو ان سے آسان بات کہہ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan jika kamu berpaling dari mereka untuk memperoleh rahmat dari Tuhanmu yang kamu harapkan, maka katakanlah kepada mereka ucapan yang pantas.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تُعْرِضَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْهُمُ", "hit": false, "audio": null, "gloss": null}, {"