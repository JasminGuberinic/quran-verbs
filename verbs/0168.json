: [{"text": "أَلَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَرَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "بَدَّلُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "نِعْمَتَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "كُفْرًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَحَلُّوا۟", "hit": true, "audio": "audio/94fe585f60c27670d2ee.m4a", "gloss": {"bs": "i nastanili su", "en": "and they settled", "tr": "ve yerleştiler", "fr": "et ils ont installé", "id": "dan mereka menetap", "ur": "اور انہوں نے اتارا (بسایا)", "bn": "এবং তারা নামিয়ে এনেছে", "fa": "و فرود آوردند"}}, {"text": "قَوْمَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "دَارَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبَوَارِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أُحِلَّ", "count": 5, "first": "2:187", "audio": "audio/66ced2226a8435891686.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "it was permitted", "bs": "dozvoljeno je", "tr": "izin verildi", "fr": "il a été permis", "id": "telah diizinkan", "ur": "اجازت دی گئی", "bn": "অনুমোদিত করা হয়েছে", "fa": "اجازه داده شد"}}, {"arabic": "أُحِلَّتْ", "count": 2, "first": "4:160", "audio": "audio/79ec728ae92852660a77.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": true, "objects": []}], "gloss": {"en": "it was permitted", "bs": "dozvoljeno je", "tr": "izin verildi", "fr": "elle a été permise", "id": "telah diizinkan", "ur": "اجازت دی گئی", "bn": "অনুমোদিত করা হয়েছে", "fa": "اجازه داده شد"}}, {"arabic": "أَحَلَّ", "count": 2, "first": "5:87", "audio": "audio/6d4c87e34872f669ff85.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}