t": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "فِرَّا", "plain": "فِرَّا", "quran": false, "notUsed": false, "spoken": "audio/b2f09e98e06145fea8f9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "فِرُّوٓا۟", "plain": "فِرُّوا", "quran": true, "notUsed": false, "spoken": "audio/162c8b065b8e1364abea.m4a", "recited": "audio/04c64f9c2e0cb66192ff.m4a", "recitedText": "فَفِرُّوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِفْرِرْنَ", "plain": "اِفْرِرْنَ", "quran": false, "notUsed": false, "spoken": "audio/d0c200351dab3a80da3a.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "26:21", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2953.mp3", "translation": {"en": {"text": "Then I fled from you when I feared you, and my Lord vouchsafed me a command and appointed me (of the number) of those sent (by Him).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Sizden korkunca da hemen aranızdan kaçtım. Sonra Rabbim bana hikmet bahşetti ve beni peygamberlerden kıldı.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو میں تمھا رے یہا ں سے نکل گیا جب کے تم سے ڈرا تو میرے رب نے مجھے حکم عطا فرمایا اور مجھے پیغمبروں سے کیا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Lalu aku lari meninggalkan kamu ketika aku takut kepadamu, kemudian Tuhanku memberikan kepadaku ilmu serta Dia menjadikanku salah seorang di antara rasul-rasul.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَفَرَرْتُ", "hit": true, "audio": "audio/7a49018c086a50b1ef69.m4a", "gloss": {"en": "so I fled", "bs": "pa sam pobjegao", "tr": "böylece kaçtım", "fr": "alors je me suis enfui", "id": "maka aku telah lari", "ur": "پس میں بھاگا", "bn": "অতএব আমি পালালাম", "fa": "پس گریختم"}}, {"text": "مِنكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "خِفْتُكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَوَهَبَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِى", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّى", "hit": false, "audio": null, "gloss": null}, {"text": "حُكْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَجَعَلَنِى", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُرْسَلِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "51:50", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4725.mp3", "translation": {"en": {"text": "Therefor flee unto Allah; lo! I am a plain warner unto you from him.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey Muhammed! de ki: \"Öyleyse Allah'a koşun, gerçekten ben size O'nun tarafından gönderilmiş apaçık bir uyarıcıyım.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اللہ کی طرف بھاگو بیشک میں اس کی طرف سے تمہارے لیے صریح ڈر سنانے والا ہوں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka segeralah kembali kepada (mentaati) Allah. Sesungguhnya aku seorang pemberi peringatan yang nyata dari Allah untukmu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَفِرُّوٓا۟", "hit": true, "audio": "audio/04c64f9c2e0cb66192ff.m4a", "gloss": {"bs": "pa bježite", "en": "so flee (pl.)", "tr": "öyleyse kaçın", "fr": "alors fuyez", "id": "maka larilah kalian", "ur": "پس بھاگو (تم سب)", "bn": "অতএব পালাও (তোমরা সবাই)", "fa": "پس بگریزید (شما همه)"}}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "لَكُم"