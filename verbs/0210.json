{"rank": 210, "root": "قدر", "form": 2, "lemma": "قَدَّرَ", "count": 16, "ayahCount": 16, "share": 0.08, "meaning": {"bs": "odmjeriti, odrediti", "en": "to measure, to determine", "tr": "ölçmek, takdir etmek", "fr": "mesurer, déterminer", "id": "menakar, menentukan", "ur": "اندازہ لگانا، مقرر کرنا", "bn": "পরিমাপ করা, নির্ধারণ করা", "fa": "اندازه گرفتن، مقدر کردن"}, "lemmaSpoken": "audio/7e870539f4dd7d2dce4f.m4a", "animation": "<svg class=\"va va-qaddara_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes qaddara_2-d{from{stroke-dashoffset:100}}.va-qaddara_2 .tk{stroke-dasharray:100;animation:qaddara_2-d 2s linear .3s both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-qaddara_2.off,.va-qaddara_2.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-qaddara_2,.va-qaddara_2 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><path class=\"q\" d=\"M20 46h80v8H20z\"/><path class=\"p\" d=\"M20 41h80\"/><path class=\"p tk\" pathLength=\"100\" d=\"M20 41v-5M30 41v-3M40 41v-5M50 41v-3M60 41v-5M70 41v-3M80 41v-5M90 41v-3M100 41v-5\"/></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "قَدَّرَ", "plain": "قَدَّرَ", "quran": true, "notUsed": false, "spoken": "audio/7e870539f4dd7d2dce4f.m4a", "recited": "audio/c3d526d3546d22158454.m4a", "recitedText": "قَدَّرَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُقَدِّرُ", "plain": "يُقَدِّرُ", "quran": true, "notUsed": false, "spoken": "audio/fb35fd2b6b6f1aa52783.m4a", "recited": "audio/e622fc6bed75b899ae98.m4a", "recitedText": "يُقَدِّرُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "قَدِّرْ", "plain": "قَدِّرْ", "quran": true, "notUsed": false, "spoken": "audio/482ecd6ab516eea63a3c.m4a", "recited": "audio/016b9ad3cdb0e8a6f6b2.m4a", "recitedText": "وَقَدِّرْ"}], "nouns": {"v