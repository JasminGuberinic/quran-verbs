يَخْلُقُ", "quran": true, "notUsed": false, "spoken": "audio/08f20e7d7622dc86acea.m4a", "recited": "audio/ba1160f9d72e567d258f.m4a", "recitedText": "يَخْلُقُ"}, {"tense": "present", "pronoun": "hiya", "arabic": "تَخْلُقُ", "plain": "تَخْلُقُ", "quran": false, "notUsed": false, "spoken": "audio/5375333427b152f387ff.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يَخْلُقَانِ", "plain": "يَخْلُقَانِ", "quran": false, "notUsed": false, "spoken": "audio/b4c65653b5424277eefb.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَخْلُقُونَ", "plain": "يَخْلُقُونَ", "quran": true, "notUsed": false, "spoken": "audio/593c7c5a0f4b2a2a2d2e.m4a", "recited": "audio/8ab9146c412bf3c12255.m4a", "recitedText": "يَخْلُقُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَخْلُقْنَ", "plain": "يَخْلُقْنَ", "quran": false, "notUsed": false, "spoken": "audio/a1167606675677f234d8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اُخْلُقْ", "plain": "اُخْلُقْ", "quran": false, "notUsed": false, "spoken": "audio/8dbb73adca3f55999305.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُخْلُقِي", "plain": "اُخْلُقِي", "quran": false, "notUsed": false, "spoken": "audio/626705fcf512f7edb133.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُخْلُقَا", "plain": "اُخْلُقَا", "quran": false, "notUsed": false, "spoken": "audio/582e24980b26e8a94635.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُخْلُقُوا", "plain": "اُخْلُقُوا", "quran": false, "notUsed": false, "spoken": "audio/0f6f942e723ff7c17021.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُخْلُقْنَ", "plain": "اُخْلُقْنَ", "quran": false, "notUsed": false, "spoken": "audio/5895e314ca1cd909d36c.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "71:14", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5433.mp3", "translation": {"en": {"text": "When He created you by (divers) stages?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Oysa o sizi aşama aşama yaratmıştır.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "حالانکہ اس نے تمہیں طرح طرح بنایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Padahal Dia sesungguhnya telah menciptakan kamu dalam beberapa tingkatan kejadian.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقَكُمْ", "hit": true, "audio": "audio/4b0f23bf536e60f97fde.m4a", "gloss": {"bs": "stvorio vas je", "en": "He created you", "tr": "sizi yarattı", "fr": "Il vous a créés", "id": "Dia menciptakan kamu", "ur": "تمہیں پیدا کیا", "bn": "তিনি তোমাদের সৃষ্টি করেছেন", "fa": "شما را آفرید"}}, {"text": "أَطْوَارًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "56:57", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5036.mp3", "translation": {"en": {"text": "We created you. Will ye then admit the truth?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz sizi yarattık; tasdik etmeniz gerekmez mi?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہم نے تمہیں پیدا کیا تو تم کیوں نہیں سچ مانتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kami telah menciptakan kamu, maka mengapa kamu tidak membenarkan?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "نَحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقْنَٰكُمْ", "hit": true, "audio": "audio/41e53cc705f6a9e42196.m4a", "gloss": {"en": "we created you (all)", "bs": "stvorili smo vas", "tr": "sizi yarattık", "fr": "nous vous avons créés", "id": "kami telah menciptakan kalian", "ur": "ہم نے تمہیں پیدا کیا", "bn": "আমরা তোমাদের সৃষ্টি করেছি", "fa": "شما را آفریدیم"}}, {"text": "فَلَوْلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُصَدِّقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:191", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1145.mp3", "translation": {"en": {"text": "Attribute they as partners to Allah those who created naught, but are themselves created,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hiçbir şey yaratmayan ve kendileri yaratılmış olan putları mı Allah'a ortak ediyorlar, ona eş koşuyorlar?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا اسے شریک کرتے ہیں جو کچھ نہ بنائے اور وہ خود بنائے ہوئے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apakah mereka mempersekutukan (Allah dengan) berhada-berhala yang tak dapat menciptakan sesuatupun? Sedangkan berhala-berhala itu sendiri buatan orang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَيُشْرِكُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَخْلُقُ", "hit": true, "audio": "audio/78cea8264f9743cef651.m4a", "gloss": {"en": "he/it creates", "bs": "stvara", "tr": "yaratır", "fr": "il crée", "id": "dia menciptakan", "ur": "وہ پیدا کرتا ہے", "bn": "সে সৃষ্টি করে", "fa": "می‌آفریند"}}, {"text": "شَيْـًٔا", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُخْلَقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "38:76", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4046.mp3", "translation": {"en": {"text": "He said: I am better than him. Thou createdst me of fire, whilst him Thou didst create of clay.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İblis dedi ki: \"Ben ondan hayırlıyım. Beni ateşten yarattın, onu ise çamurdan yarattın.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولا میں اس سے بہتر ہوں تو نے مجھے آگ سے بنایا اور اسے مٹی سے پیدا کیا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Iblis berkata: \"Aku lebih baik daripadanya, karena Engkau ciptakan aku dari api, sedangkan dia Engkau ciptakan dari tanah\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَا۠", "hit": false, "audio": null, "gloss": null}, {"text": "خَيْرٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقْتَنِى", "hit": true, "audio": "audio/f26b1b9ebdf59809482d.m4a", "gloss": {"en": "you created me", "bs": "stvorio si me", "tr": "beni yarattın", "fr": "tu m'as créé", "id": "kamu telah menciptakanku", "ur": "تم نے مجھے پیدا کیا", "bn": "তুমি আমাকে সৃষ্টি করেছ", "fa": "مرا آفریدی"}}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "نَّارٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَخَلَقْتَهُۥ", "hit": true, "audio": "audio/55bc1b9a89a82907af68.m4a", "gloss": {"en": "and you created him", "bs": "i stvorio si ga", "tr": "ve onu yarattın", "fr": "et tu l'as créé", "id": "dan kamu telah menciptakannya", "ur": "تم نے اسے پیدا کیا", "bn": "এবং তুমি তাকে সৃষ্টি করেছ", "fa": "و او را آفریدی"}}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "طِينٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "52:36", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4771.mp3", "translation": {"en": {"text": "Or did they create the heavens and the earth? Nay, but they are sure of nothing!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yoksa gökleri ve yeri onlar mı yarattılar? Hayır, onlar düşünüp hakikati anlamazlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا آسمان اور زمین انہوں نے پیدا کیے بلکہ انہیں یقین نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ataukah mereka telah menciptakan langit dan bumi itu?; sebenarnya mereka tidak meyakini (apa yang mereka katakan).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقُوا۟", "hit": true, "audio": "audio/c0fcd6eed9cecb529a83.m4a", "gloss": {"en": "they created", "bs": "stvorili su", "tr": "yarattılar", "fr": "ils ont créé", "id": "mereka telah menciptakan", "ur": "انہوں نے پیدا کیا", "bn": "তারা সৃষ্টি করেছে", "fa": "آفریدند"}}, {"text": "ٱلسَّمَٰوَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْأَرْضَ", "hit": false, "audio": null, "gloss": null}, {"text": "بَل", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يُوقِنُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "56:59", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5038.mp3", "translation": {"en": {"text": "Do ye create it or are We the Creator?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onu siz mi yaratıyorsunuz yoksa yaratan biz miyiz?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا تم اس کا آدمی بناتے ہو یا ہم بنانے والے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kamukah yang menciptakannya, atau Kamikah yang menciptakannya?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ءَأَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَخْلُقُونَهُۥٓ", "hit": true, "audio": "audio/61c800ba95f82f4bef79.m4a", "gloss": {"bs": "stvarate li ga", "en": "do you create it", "tr": "onu siz mi yaratıyorsunuz", "fr": "le créez-vous", "id": "kamu menciptakannya", "ur": "تم اسے بناتے ہو", "bn": "তোমরা কি তা সৃষ্টি কর", "fa": "آیا آن را می‌آفرینید"}}, {"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَٰلِقُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "خَلَقَ", "count": 58, "first": "2:29", "audio": "audio/98ec23acf9d481a799d4.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it created", "bs": "stvorio je", "tr": "yarattı", "fr": "il a créé", "id": "dia telah menciptakan", "ur": "اُس نے پیدا کیا", "bn": "সে সৃষ্টি করেছে", "fa": "آفرید"}}, {"arabic": "خَلَقْنَا", "count": 18, "first": "15:26", "audio": "audio/a13ccb3257cb29b01342.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "we created", "bs": "stvorili smo", "tr": "yarattık", "fr": "nous avons créé", "id": "kami telah menciptakan", "ur": "ہم نے پیدا کیا", "bn": "আমরা সৃষ্টি করেছি", "fa": "آفریدیم"}}, {"arabic": "يَخْلُقُ", "count": 11, "first": "3:47", "audio": "audio/ba1160f9d72e567d258f.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it creates", "bs": "stvara", "tr": "yaratır", "fr": "il crée", "id": "dia menciptakan", "ur": "وہ پیدا کرتا ہے", "bn": "সে সৃষ্টি করে", "fa": "می‌آفریند"}}, {"arabic": "خَلَقَكُمْ", "count": 8, "first": "2:21", "audio": "audio/fe78c8f1133896d116eb.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["antum"]}], "gloss": {"bs": "stvorio vas je", "en": "He created you", "tr": "sizi yarattı", "fr": "Il vous a créés", "id": "Dia menciptakan kamu", "ur": "تمہیں پیدا کیا", "bn": "তিনি তোমাদের সৃষ্টি করেছেন", "fa": "شما را آفرید"}}, {"arabic": "خَلَقَكُم", "count": 8, "first": "4:1", "audio": "audio/71e1941be9900a0a7807.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["antum"]}], "gloss": {"en": "he/it created you (all)", "bs": "stvorio vas je", "tr": "sizi yarattı", "fr": "il vous a créés", "id": "dia telah menciptakan kalian", "ur": "اُس نے تمہیں پیدا کیا", "bn": "সে তোমাদের সৃষ্টি করেছে", "fa": "شما را آفرید"}}, {"arabic": "خَلَقْنَٰكُمْ", "count": 6, "first": "6:94", "audio": "audio/dce7ae39a148b3f02e05.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["antum"]}], "gloss": {"en": "we created you (all)", "bs": "stvorili smo vas", "tr": "sizi yarattık", "fr": "nous vous avons créés", "id": "kami telah menciptakan kalian", "ur": "ہم نے تمہیں پیدا کیا", "bn": "আমরা তোমাদের সৃষ্টি করেছি", "fa": "شما را آفریدیم"}}, {"arabic": "وَخَلَقَ", "count": 5, "first": "4:1", "audio": "audio/c7a40cb253ea4d5d04ca.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it created", "bs": "i stvorio je", "tr": "ve yarattı", "fr": "et il a créé", "id": "dan dia telah menciptakan", "ur": "اور اُس نے پیدا کیا", "bn": "এবং সে সৃষ্টি করেছে", "fa": "و آفرید"}}, {"arabic": "خَلَقَهُۥ", "count": 4, "first": "3:59", "audio": "audio/298d439fc8854c4340b6.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "he/it created him/it", "bs": "stvorio ga je", "tr": "onu yarattı", "fr": "il l'a créé", "id": "dia telah menciptakannya", "ur": "اُس نے اسے پیدا کیا", "bn": "সে তাকে সৃষ্টি করেছে", "fa": "او را آفرید"}}, {"arabic": "خَلَقُوا۟", "count": 4, "first": "13:16", "audio": "audio/2630d96