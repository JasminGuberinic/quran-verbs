 "spoken": "audio/16111bd968fb18d3cd74.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَسْقِيَا", "plain": "أَسْقِيَا", "quran": false, "notUsed": false, "spoken": "audio/17e344575eaa29c932ab.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَسْقُوا", "plain": "أَسْقُوا", "quran": false, "notUsed": false, "spoken": "audio/5e78d8a86dd6d4a5a1fd.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَسْقِينَ", "plain": "أَسْقِينَ", "quran": false, "notUsed": false, "spoken": "audio/718d5fffa44b903c44d9.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "72:16", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5463.mp3", "translation": {"en": {"text": "If they (the idolaters) tread the right path, We shall give them to drink of water in abundance", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar gerçekten o yol üzere dosdoğru gitselerdi, elbette kendilerine bol bir su verirdik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور فرماؤ کہ مجھے یہ وحی ہوئی ہے کہ اگر وہ راہ پر سیدھے رہتے تو ضرور ہم انہیں وافر پانی دیتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan bahwasanya: jikalau mereka tetap berjalan lurus di atas jalan itu (agama Islam), benar-benar Kami akan memberi minum kepada mereka air yang segar (rezeki yang banyak).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَلَّوِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱسْتَقَٰمُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلطَّرِيقَةِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَأَسْقَيْنَٰهُم", "hit": true, "audio": "audio/e7930290c2a8cdce3e56.m4a", "gloss": {"bs": "sigurno bismo ih napojili", "en": "We would have given them to drink", "tr": "onlara kesinlikle içirirdik", "fr": "Nous leur aurions certes donné à boire", "id": "niscaya Kami akan memberi mereka minum", "ur": "ہم ضرور انہیں پلاتے", "bn": "আমরা অবশ্যই তাদের পান করাতাম", "fa": "قطعاً به آنان می‌نوشانیدیم"}}, {"text": "مَّآءً", "hit": false, "audio": null, "gloss": null}, {"text": "غَدَقًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "25:49", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2904.mp3", "translation": {"en": {"text": "That We may give life thereby to a dead land, and We give many beasts and men that We have created to drink thereof.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ki biz (o suyla) ölü toprağa can verelim, yarattığımız nice hayvanlara ve insanlara su sağlayalım, diye.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تاکہ ہم ا سسے زندہ کریں کسی مردہ شہر کو اور اسے پلائیں اپنے بنائے ہوئے بہت سے چوپائے اور آدمیوں کو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "agar Kami menghidupkan dengan air itu negeri (tanah) yang mati, dan agar Kami memberi minum dengan air itu sebagian besar dari makhluk Kami, binatang-binatang ternak dan manusia yang banyak.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لِّنُحْۦِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "بَلْدَةً", "hit": false, "audio": null, "gloss": null}, {"text": "مَّيْتًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَنُسْقِيَهُۥ", "hit": true, "audio": "audio/7e1174058e61b9b1bf7e.m4a", "gloss": {"bs": "i da njome napojimo", "en": "and that We give it to drink", "tr": "ve ona içirmemiz için", "fr": "et que Nous l'abreuvions", "id": "dan agar Kami memberinya minum", "ur": "اور یہ کہ ہم اسے پلائیں", "bn": "এবং যাতে আমরা তা পান করাই", "fa": "و تا آن را بنوشانیم"}}, {"text": "مِمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقْنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنْعَٰمًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنَاسِىَّ", "hit": false, "audio": null, "gloss": null}, {"text": "كَثِيرًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "نُّسْقِيكُم", "count": 2, "first": "16:66", "audio": "audio/c0b16fb0abfc84660e2a.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "we give you (all) to drink", "bs": "napajamo vas", "tr": "sizi suvarırız", "fr": "nous vous abreuvons", "id": "kami memberi minum kalian", "ur": "ہم تم سب کو پلاتے ہیں", "bn": "আমরা তোমাদের পান করাই", "fa": "شما را سیراب می‌کنیم"}}, {"arabic": "فَأَسْقَيْنَٰكُمُوهُ", "count": 1, "first": "15:22", "audio": "audio/9020081c56b14cf6def7.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["antum", "huwa"]}]}, {"arabic": "وَنُسْقِيَهُۥ", "count": 1, "first": "25:49", "audio": "audio/7e1174058e61b9b1bf7e.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["huwa"], "mood": "subjunctive"}], "gloss": {"bs": "i da njome napojimo", "en": "and that We give it to drink", "tr": "ve ona içirmemiz için", "fr": "et que Nous l'abreuvions", "id": "dan agar Kami memberinya minum", "ur": "اور یہ کہ ہم اسے پلائیں", "bn": "এবং যাতে আমরা তা পান করাই", "fa": "و تا آن را بنوشانیم"}}, {"arabic": "لَأَسْقَيْنَٰهُم", "count": 1, "first": "72:16", "audio": "audio/e7930290c2a8cdce3e56.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["hum"]}], "gloss": {"bs": "sigurno bismo ih napojili", "en": "We would have given them to drink", "tr": "onlara kesinlikle içirirdik", "fr": "Nous leur aurions certes donné à boire", "id": "niscaya Kami akan memberi mereka minum", "ur": "ہم ضرور انہیں پلاتے", "bn": "আমরা অবশ্যই তাদের পান করাতাম", "fa": "قطعاً به آنان می‌نوشانیدیم"}}, {"arabic": "وَيُسْقَوْنَ", "count": 1, "first": "76:17", "audio": "audio/0c9e97b5f2162c1bd68d.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "and they are given to drink", "bs": "i bivaju napojeni", "tr": "ve suvarılırlar", "fr": "et ils sont abreuvés", "id": "dan mereka diberi minum", "ur": "اور انہیں پلایا جاتا ہے", "bn": "এবং তারা পান করানো হয়", "fa": "و سیراب می‌شوند"}}, {"arabic": "وَأَسْقَيْنَٰكُم", "count": 1, "first": "77:27", "audio": "audio/9621c1391b8b89057a36.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["antum"]}], "gloss": {"en": "and we gave you (all) to drink", "bs": "i napojili smo vas", "tr": "ve sizi suvardık", "fr": "et nous vous avons abreuvés", "id": "dan kami telah memberi minum kalian", "ur": "اور ہم نے تم سب کو پلایا", "bn": "এবং আমরা তোমাদের পান করিয়েছি", "fa": "و شما را سیراب کردیم"}}, {"arabic": "يُسْقَوْنَ", "count": 1, "first": "83:25", "audio": "audio/5d75e10e308a29b86116.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "they are given to drink", "bs": "bivaju napojeni", "tr": "suvarılırlar", "fr": "ils sont abreuvés", "id": "mereka diberi minum", "ur": "انہیں پلایا جاتا ہے", "bn": "তারা পান করানো হয়", "fa": "سیراب می‌شوند"}}], "ayatFile": "ayat/0353.json", "ayatTranslations": {"en": "ayat/0353.en.json", "tr": "ayat/0353.tr.json", "ur": "ayat/0353.ur.json", "id": "ayat/0353.id.json"}, "sentences": [{"arabic": "أَسْقَى الْفَلَّاحُ الْأَرْضَ", "spoken": "audio/71f1f111963195684da5.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Seljak je natopio zemlju.", "en": "The farmer irrigated the land.", "bn": "কৃষক জমিতে সেচ দিল।", "fa": "کشاورز زمین را آبیاری کرد.", "fr": "L'agriculteur a irrigu