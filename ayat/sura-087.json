{"ayat":[{"ref":"87:1","number":5949,"text":"سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","hits":[0,1,2]},{"ref":"87:2","number":5950,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","hits":[0,1,2]},{"ref":"87:3","number":5951,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","hits":[1,2]},{"ref":"87:4","number":5952,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","hits":[1]},{"ref":"87:5","number":5953,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","hits":[0]},{"ref":"87:6","number":5954,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","hits":[1,2]},{"ref":"87:7","number":5955,"text":"إِلَّا مَا شَآءَ ٱللَّهُ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","hits":[0,1,2,4,5,6,8]},{"ref":"87:8","number":5956,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","hits":[0]},{"ref":"87:9","number":5957,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","hits":[0,1,2,3]},{"ref":"87:10","number":5958,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","hits":[0,1,2]},{"ref":"87:11","number":5959,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","hits":[]},{"ref":"87:12","number":5960,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","hits":[1,2]},{"ref":"87:13","number":5961,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","hits":[0,2,3,5]},{"ref":"87:14","number":5962,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","hits":[0,1,3]},{"ref":"87:15","number":5963,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","hits":[0,3]},{"ref":"87:16","number":5964,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","hits":[0,1,2]},{"ref":"87:17","number":5965,"text":"وَٱلْءَاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","hits":[1]},{"ref":"87:18","number":5966,"text":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","hits":[1]},{"ref":"87:19","number":5967,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","hits":[2]}]}