[{"id":"qadhafa-33-26-8","words":["verb:qadhafa"],"options":[{"bs":"i bacio je","en":"and he/it threw"},{"bs":"baca","en":"casts"},{"bs":"i bacaju","en":"and they throw"},{"bs":"i bivaju bačeni","en":"and they are thrown"}],"ref":"33:26","answerWord":"وَقَذَفَ","answerSound":"audio/27aa5ff0a9b1fada5b5c.m4a","quranTranslation":{"text":"And He brought those of the People of the Scripture who supported them down from their strongholds, and cast panic into their hearts. Some ye slew, and ye made captive some.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"baciti, izbaciti","en":"to throw, to cast"},"passage":["وَأَنزَلَ","ٱلَّذِينَ","ظَٰهَرُوهُم","مِّنْ","أَهْلِ","ٱلْكِتَٰبِ","مِن","صَيَاصِيهِمْ","وَقَذَفَ","فِى","قُلُوبِهِمُ","ٱلرُّعْبَ","فَرِيقًا","تَقْتُلُونَ","وَتَأْسِرُونَ","فَرِيقًا"],"marked":[8],"facts":{"verb":"قَذَفَ"}},{"id":"qadhafa-20-39-1","words":["verb:qadhafa"],"options":[{"bs":"baci ga!","en":"throw him!"},{"bs":"i bacaju","en":"and they throw"},{"bs":"i bacio je","en":"and he/it threw"},{"bs":"pa smo ih bacili","en":"so we threw them"}],"ref":"20:39","answerWord":"ٱقْذِفِيهِ","answerSound":"audio/b7bcb62a34afe5edf639.m4a","quranTranslation":{"text":"Saying: Throw him into the ark, and throw it into the river, then the river shall throw it on to the bank, and there an enemy to Me and an enemy to him shall take him. And I endued thee with love from Me that thou mightest be trained according to My will,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"baciti, izbaciti","en":"to throw, to cast"},"passage":["أَنِ","ٱقْذِفِيهِ","فِى","ٱلتَّابُوتِ","فَٱقْذِفِيهِ","فِى","ٱلْيَمِّ","فَلْيُلْقِهِ","ٱلْيَمُّ","بِٱلسَّاحِلِ","يَأْخُذْهُ","عَدُوٌّ","لِّى","وَعَدُوٌّ","لَّهُۥ","وَأَلْقَيْتُ","عَلَيْكَ","مَحَبَّةً","مِّنِّى","وَلِتُصْنَعَ","عَلَىٰ","عَيْنِىٓ"],"marked":[1],"facts":{"verb":"قَذَفَ"}},{"id":"qadhafa-20-39-4","words":["verb:qadhafa"],"options":[{"bs":"pa ga baci!","en":"so throw it!"},{"bs":"bacamo","en":"we throw"},{"bs":"i bivaju bačeni","en":"and they are thrown"},{"bs":"baca","en":"casts"}],"ref":"20:39","answerWord":"فَٱقْذِفِيهِ","answerSound":"audio/27e0055a618374f60ca8.m4a","quranTranslation":{"text":"Saying: Throw him into the ark, and throw it into the river, then the river shall throw it on to the bank, and there an enemy to Me and an enemy to him shall take him. And I endued thee with love from Me that thou mightest be trained according to My will,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"baciti, izbaciti","en":"to throw, to cast"},"passage":["أَنِ","ٱقْذِفِيهِ","فِى","ٱلتَّابُوتِ","فَٱقْذِفِيهِ","فِى","ٱلْيَمِّ","فَلْيُلْقِهِ","ٱلْيَمُّ","بِٱلسَّاحِلِ","يَأْخُذْهُ","عَدُوٌّ","لِّى","وَعَدُوٌّ","لَّهُۥ","وَأَلْقَيْتُ","عَلَيْكَ","مَحَبَّةً","مِّنِّى","وَلِتُصْنَعَ","عَلَىٰ","عَيْنِىٓ"],"marked":[4],"facts":{"verb":"قَذَفَ"}},{"id":"qadhafa-20-87-11","words":["verb:qadhafa"],"options":[{"bs":"pa smo ih bacili","en":"so we threw them"},{"bs":"baci ga!","en":"throw him!"},{"bs":"bacamo","en":"we throw"},{"bs":"baca","en":"casts"}],"ref":"20:87","answerWord":"فَقَذَفْنَٰهَا","answerSound":"audio/ecef768f33022e930f89.m4a","quranTranslation":{"text":"They said: We broke not tryst with thee of our own will, but we were laden with burdens of ornaments of the folk, then cast them (in the fire), for thus As-Samiri proposed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"baciti, izbaciti","en":"to throw, to cast"},"passage":["قَالُوا۟","مَآ","أَخْلَفْنَا","مَوْعِدَكَ","بِمَلْكِنَا","وَلَٰكِنَّا","حُمِّلْنَآ","أَوْزَارًا","مِّن","زِينَةِ","ٱلْقَوْمِ","فَقَذَفْنَٰهَا","فَكَذَٰلِكَ","أَلْقَى","ٱلسَّامِرِىُّ"],"marked":[11],"facts":{"verb":"قَذَفَ"}},{"id":"qadhafa-21-18-1","words":["verb:qadhafa"],"options":[{"bs":"bacamo","en":"we throw"},{"bs":"pa smo ih bacili","en":"so we threw them"},{"bs":"i bacaju","en":"and they throw"},{"bs":"i bivaju bačeni","en":"and they are thrown"}],"ref":"21:18","answerWord":"نَقْذِفُ","answerSound":"audio/a849f9173779d4277154.m4a","quranTranslation":{"text":"Nay, but We hurl the true against the false, and it doth break its head and lo! it vanisheth. And yours will be woe for that which ye ascribe (unto Him).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"baciti, izbaciti","en":"to throw, to cast"},"passage":["بَلْ","نَقْذِفُ","بِٱلْحَقِّ","عَلَى","ٱلْبَٰطِلِ","فَيَدْمَغُهُۥ","فَإِذَا","هُوَ","زَاهِقٌ","وَلَكُمُ","ٱلْوَيْلُ","مِمَّا","تَصِفُونَ"],"marked":[1],"facts":{"verb":"قَذَفَ"}},{"id":"qadhafa-34-48-3","words":["verb:qadhafa"],"options":[{"bs":"baca","en":"casts"},{"bs":"i bivaju bačeni","en":"and they are thrown"},{"bs":"pa ga baci!","en":"so throw it!"},{"bs":"i bacio je","en":"and he/it threw"}],"ref":"34:48","answerWord":"يَقْذِفُ","answerSound":"audio/c0489691176184e01a34.m4a","quranTranslation":{"text":"Say: Lo! my Lord hurleth the truth. (He is) the Knower of Things Hidden.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"baciti, izbaciti","en":"to throw, to cast"},"passage":["قُلْ","إِنَّ","رَبِّى","يَقْذِفُ","بِٱلْحَقِّ","عَلَّٰمُ","ٱلْغُيُوبِ"],"marked":[3],"facts":{"verb":"قَذَفَ"}},{"id":"qadhafa-34-53-5","words":["verb:qadhafa"],"options":[{"bs":"i bacaju","en":"and they throw"},{"bs":"pa smo ih bacili","en":"so we threw them"},{"bs":"baca","en":"casts"},{"bs":"i bacio je","en":"and he/it threw"}],"ref":"34:53","answerWord":"وَيَقْذِفُونَ","answerSound":"audio/a850835a660de64a48f7.m4a","quranTranslation":{"text":"When they disbelieved in it of yore. They aim at the unseen from afar off.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"baciti, izbaciti","en":"to throw, to cast"},"passage":["وَقَدْ","كَفَرُوا۟","بِهِۦ","مِن","قَبْلُ","وَيَقْذِفُونَ","بِٱلْغَيْبِ","مِن","مَّكَانٍۭ","بَعِيدٍ"],"marked":[5],"facts":{"verb":"قَذَفَ"}},{"id":"qadhafa-37-8-5","words":["verb:qadhafa"],"options":[{"bs":"i bivaju bačeni","en":"and they are thrown"},{"bs":"bacamo","en":"we throw"},{"bs":"pa smo ih bacili","en":"so we threw them"},{"bs":"pa ga baci!","en":"so throw it!"}],"ref":"37:8","answerWord":"وَيُقْذَفُونَ","answerSound":"audio/32f3934b4c009a6bbbbb.m4a","quranTranslation":{"text":"They cannot listen to the Highest Chiefs for they are pelted from every side,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"baciti, izbaciti","en":"to throw, to cast"},"passage":["لَّا","يَسَّمَّعُونَ","إِلَى","ٱلْمَلَإِ","ٱلْأَعْلَىٰ","وَيُقْذَفُونَ","مِن","كُلِّ","جَانِبٍ"],"marked":[5],"facts":{"verb":"قَذَفَ"}}]