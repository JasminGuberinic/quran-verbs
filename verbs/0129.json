م"}}, {"arabic": "وَٱرْحَمْ", "count": 1, "first": "23:118", "audio": "audio/93227c1806515549b320.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"bs": "i smiluj se", "en": "and have mercy", "tr": "ve merhamet et", "fr": "et fais miséricorde", "id": "dan kasihanilah", "ur": "اور رحم کر", "bn": "এবং দয়া করো", "fa": "و رحم کن"}}, {"arabic": "وَيَرْحَمُ", "count": 1, "first": "29:21", "audio": "audio/42135e2252049fe6a6b4.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "i smiluje se", "en": "and He has mercy", "tr": "ve merhamet eder", "fr": "et Il fait miséricorde", "id": "dan Dia mengasihi", "ur": "اور وہ رحم کرتا ہے", "bn": "এবং তিনি দয়া করেন", "fa": "و رحم می‌کند"}}, {"arabic": "رَحِمْتَهُۥ", "count": 1, "first": "40:9", "audio": "audio/68b9724f493925619a2a.m4a", "grammar": [{"tense": "past", "pronoun": "anta", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "you had mercy on him", "bs": "smilovao si mu se", "tr": "ona merhamet ettin", "fr": "tu lui as fait miséricorde", "id": "kamu telah merahmatinya", "ur": "تم نے اس پر رحم کیا", "bn": "তুমি তার প্রতি দয়া করেছিলে", "fa": "به او رحم کردی"}}, {"arabic": "رَحِمَنَا", "count": 1, "first": "67:28", "audio": "audio/e1d0c1134ca76469f5f5.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["nahnu"]}], "gloss": {"en": "he/it had mercy on us", "bs": "smilovao nam se", "tr": "bize merhamet etti", "fr": "il nous a fait miséricorde", "id": "dia telah merahmati kami", "ur": "اُس نے ہم پر رحم کیا", "bn": "সে আমাদের প্রতি দয়া করেছে", "fa": "به ما رحم کرد"}}], "ayatFile": "ayat/0129.json", "ayatTranslations": {"en": "ayat/0129.en.json", "tr": "ayat/0129.tr.json", "ur": "ayat/0129.ur.json", "id": "ayat/0129.id.json"}, "sentences": [{"arabic": "الْأَبُ يَرْحَمُ أَوْلَادَهُ", "spoken": "audio/009fa8f90ed9b6707227.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Otac je milostiv prema svojoj djeci.", "en": "The father shows mercy to his children.", "bn": "বাবা তার সন্তানদের প্রতি দয়া করেন।", "fa": "پدر به فرزندانش مهربانی می‌کند.", "fr": "Le père fait miséricorde à ses enfants.", "id": "Ayah menyayangi anak-anaknya.", "tr": "Baba çocuklarına merhamet eder.", "ur": "باپ اپنے بچوں پر رحم کرتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "الْأَبُ", "target": false, "translation": {"bs": "otac", "en": "the father", "bn": "বাবা", "fa": "پدر", "fr": "le père", "id": "ayah itu", "tr": "baba", "ur": "باپ"}}, {"arabic": "يَرْحَمُ", "target": true, "translation": {"bs": "je milostiv prema", "en": "shows mercy to", "bn": "দয়া করে", "fa": "مهربانی می‌کند", "fr": "fait miséricorde à", "id": "mengasihi", "tr": "merhamet eder", "ur": "وہ رحم کرتا ہے"}}, {"arabic": "أَوْلَادَهُ", "target": false, "translation": {"bs": "svojoj djeci", "en": "his children", "bn": "তার সন্তানেরা", "fa": "فرزندانش", "fr": "ses enfants", "id": "anak-anaknya", "tr": "çocukları", "ur": "اس کے بچے"}}]}, {"arabic": "ارْحَمْ جَارَكَ الضَّعِيفَ", "spoken": "audio/13d53c64dd878f2f12ad.m4a", "tense": "imperative", "pronoun": "anta", "translation": {"bs": "Budi milostiv prema svom slabom komšiji.", "en": "Be merciful to your weak neighbor.", "bn": "তোমার দুর্বল প্রতিবেশীর প্রতি দয়া করো।", "fa": "با همسایه ناتوانت مهربان باش.", "fr": "Sois miséricordieux envers ton voisin faible.", "id": "Kasihanilah tetanggamu yang lemah.", "tr": "Zayıf komşuna merhametli ol.", "ur": "اپنے کمزور پڑوسی پر رحم کرو۔"}, "independentlyReviewed": true, "words": [{"arabic": "ارْحَمْ", "target": true, "translation": {"bs": "budi milostiv prema", "en": "be merciful to", "bn": "দয়া করো", "fa": "مهربان باش", "fr": "sois miséricordieux envers", "id": "kasihanilah", "tr": "merhametli ol", "ur": "رحم کر"}}, {"arabic": "جَارَكَ", "target": false, "translation": {"bs": "svom komšiji", "en": "your neighbor", "bn": "তোমার প্রতিবেশী", "fa": "همسایه‌ات", "fr"