{"rank": 28, "root": "خرج", "form": 4, "lemma": "أَخْرَجَ", "count": 99, "ayahCount": 90, "share": 0.51, "meaning": {"bs": "izvesti, izvaditi", "en": "to bring out, to expel", "tr": "çıkarmak, sürmek", "fr": "faire sortir, expulser", "id": "mengeluarkan, mengusir", "ur": "نکالنا، باہر نکال دینا", "bn": "বের করা, বহিষ্কার করা", "fa": "بیرون آوردن، اخراج کردن"}, "lemmaSpoken": "audio/88407fc22f5dabc776be.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَخْرَجَ", "plain": "أَخْرَجَ", "quran": true, "notUsed": false, "spoken": "audio/88407fc22f5dabc776be.m4a", "recited": "audio/f959a9dbf806f0b06802.m4a", "recitedText": "أَخْرَجَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُخْرِجُ", "plain": "يُخْرِجُ", "quran": true, "notUsed": false, "spoken": "audio/b9907e483a788f943bc4.m4a", "recited": "audio/5379c6f3ee16ff1aef88.m4a", "recitedText": "يُخْرِجُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَخْرِجْ", "plain": "أَخْرِجْ", "quran": true, "notUsed": false, "spoken": "audio/e67e6e76ca5fb731f20a.m4a", "recited": "audio/c9f26146614f1ebe708f.m4a", "recitedText": "أَخْرِجْ"}], "nouns": {"participle": {"lemma": "مُخْرِج", "count": 3, "spoken": "audio/1cd5e871516d2f6cf00f.m4a"}, "verbal_noun": {"lemma": "إِخْراج", "count": 6, "spoken": "audio/ad6e34f4c691ec1000dd.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَخْرَجْتُ", "plain": "أَخْرَجْتُ", "quran": false, "notUsed": false, "spoken": "audio/72265b0618e3dbe29b43.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَخْرَجْنَا", "plain": "أَخْرَجْنَا", "quran": true, "notUsed": false, "spoken": "audio/0e774334507920ed3d2c.m4a", "recited": "audio/f96c10b5cbece406615f.m4a", "recitedText": "أَخْرَجْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "أَخْرَجْتَ", "plain": "أَخْرَجْتَ", "quran": false, "notUsed": false, "spoken": "audio/03bda7b1b652b124e6dd.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun"