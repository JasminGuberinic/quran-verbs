{"ayat":[{"ref":"90:1","number":6024,"text":"لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ","hits":[0,1,2,3]},{"ref":"90:2","number":6025,"text":"وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ","hits":[0]},{"ref":"90:3","number":6026,"text":"وَوَالِدٍ وَمَا وَلَدَ","hits":[0,1,2]},{"ref":"90:4","number":6027,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ","hits":[0,1,2,3]},{"ref":"90:5","number":6028,"text":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ","hits":[0,1,2,3,4]},{"ref":"90:6","number":6029,"text":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا","hits":[0,1,2]},{"ref":"90:7","number":6030,"text":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ","hits":[2,3]},{"ref":"90:8","number":6031,"text":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","hits":[1,2,3]},{"ref":"90:9","number":6032,"text":"وَلِسَانًا وَشَفَتَيْنِ","hits":[0]},{"ref":"90:10","number":6033,"text":"وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ","hits":[0]},{"ref":"90:11","number":6034,"text":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ","hits":[]},{"ref":"90:12","number":6035,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","hits":[1]},{"ref":"90:13","number":6036,"text":"فَكُّ رَقَبَةٍ","hits":[1]},{"ref":"90:14","number":6037,"text":"أَوْ إِطْعَٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ","hits":[0,1,3]},{"ref":"90:15","number":6038,"text":"يَتِيمًا ذَا مَقْرَبَةٍ","hits":[0]},{"ref":"90:16","number":6039,"text":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ","hits":[1]},{"ref":"90:17","number":6040,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ","hits":[0,1,2,3,4,5,6]},{"ref":"90:18","number":6041,"text":"أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ","hits":[0,1]},{"ref":"90:19","number":6042,"text":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","hits":[1,2,3]},{"ref":"90:20","number":6043,"text":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ","hits":[1]}]}