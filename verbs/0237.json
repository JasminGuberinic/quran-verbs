{"rank": 237, "root": "كفر", "form": 2, "lemma": "كَفَّرَ", "count": 14, "ayahCount": 14, "share": 0.07, "meaning": {"bs": "izbrisati (grijehe), iskupiti", "en": "to remove (sins), to expiate", "tr": "silmek (günahları), kefaret olmak", "fr": "effacer (les péchés), expier", "id": "menghapus (dosa), menebus", "ur": "مٹانا (گناہ)، کفارہ بنانا", "bn": "মোচন করা (গুনাহ), কাফফারা দেওয়া", "fa": "زدودن (گناهان)، کفاره دادن"}, "lemmaSpoken": "audio/1911b894dd9fbc63355d.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "كَفَّرَ", "plain": "كَفَّرَ", "quran": true, "notUsed": false, "spoken": "audio/1911b894dd9fbc63355d.m4a", "recited": "audio/587ce332c970c4279827.m4a", "recitedText": "كَفَّرَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُكَفِّرُ", "plain": "يُكَفِّرُ", "quran": true, "notUsed": false, "spoken": "audio/7b4b99ae3ce6607e30bf.m4a", "recited": "audio/3bc3d057ab3f9bfb0e85.m4a", "recitedText": "وَيُكَفِّرُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "كَفِّرْ", "plain": "كَفِّرْ", "quran": true, "notUsed": false, "spoken": "audio/23714d6c36205dc6e321.m4a", "recited": "audio/ac1cee4d693ceb7477d3.m4a", "recitedText": "وَكَفِّرْ"}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "كَفَّرْتُ", "plain": "كَفَّرْتُ", "quran": false, "notUsed": false, "spoken": "audio/9242d3eda6940bf5e620.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "كَفَّرْنَا", "plain": "كَفَّرْنَا", "quran": true, "notUsed": false, "spoken": "audio/16df606d4a0b26a2fccd.m4a", "recited": "audio/022862504a1b4b0da5a6.m4a", "recitedText": "لَكَفَّرْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "كَفَّرْتَ", "plain": "كَفَّرْتَ", "quran": false, "notUsed": false, "spoken": "audio/4128969d155dde0582fd.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "كَفَّرْتِ", "plain": "كَفَّرْتِ", "quran": false, "notUsed": false, "spoken": "audio/ed57c4153e44b301e2b3