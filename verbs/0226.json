fr": "leur voisin", "id": "tetangga mereka", "tr": "komşuları", "ur": "ان کا پڑوسی"}}]}, {"arabic": "لَا يَعْتَدُونَ عَلَى أَحَدٍ", "spoken": "audio/d550541cae83a6bafeeb.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Ne ugrožavaju nikoga.", "en": "They do not encroach on anyone.", "bn": "তারা কারও অধিকার লঙ্ঘন করে না।", "fa": "به هیچ‌کس تجاوز نمی‌کنند.", "fr": "Ils ne s'en prennent à personne.", "id": "Mereka tidak melanggar hak siapa pun.", "tr": "Hiç kimseye haddi aşmazlar.", "ur": "وہ کسی پر زیادتی نہیں کرتے۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "يَعْتَدُونَ", "target": true, "translation": {"bs": "ugrožavaju", "en": "they encroach", "bn": "তারা অনধিকার প্রবেশ করে", "fa": "دست‌درازی می‌کنند", "fr": "menacent", "id": "mereka melanggar", "tr": "tecavüz ederler", "ur": "وہ زیادتی کرتے ہیں"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "—", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "أَحَدٍ", "target": false, "translation": {"bs": "nikoga", "en": "any one", "bn": "যে কেউ", "fa": "کسی", "fr": "personne", "id": "siapa pun", "tr": "hiç kimse", "ur": "کسی"}}]}, {"arabic": "مَا اعْتَدَيْنَا عَلَى جِيرَانِنَا", "spoken": "audio/57ebc9772d5a2cb513e7.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Nismo nanijeli nepravdu svojim komšijama.", "en": "We did not wrong our neighbors.", "bn": "আমরা আমাদের প্রতিবেশীদের প্রতি অন্যায় করিনি।", "fa": "به همسایگانمان ستم نکردیم.", "fr": "Nous n'avons pas lésé nos voisins.", "id": "Kami tidak menzalimi tetangga kami.", "tr": "Komşularımıza zulmetmedik.", "ur": "ہم نے اپنے پڑوسیوں پر زیادتی نہیں کی۔"}, "independentlyReviewed": true, "words": [{"arabic": "مَا", "target": false, "translation": {"bs": "nismo", "en": "not", "bn": "না", "fa": "نه", "fr": "nous n'avons pas", "id": "tidak", "tr": "-me", "ur": "نہیں"}}, {"arabic": "اعْتَدَيْنَا", "target": true, "translation": {"bs": "nanijeli nepravdu", "en": "we encroached", "bn": "আমরা অনধিকার প্রবেশ করলাম", "fa": "تجاوز کردیم", "fr": "nous avons lésé", "id": "kami melanggar", "tr": "zulmettik", "ur": "ہم نے زیادتی کی"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "—", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "جِيرَانِنَا", "target": false, "translation": {"bs": "svojim komšijama", "en": "our neighbors", "bn": "আমাদের প্রতিবেশীরা", "fa": "همسایگانمان", "fr": "nos voisins", "id": "tetangga kami", "tr": "komşularımıza", "ur": "ہمارے پڑوسیوں"}}]}]}