ার উত্তরাধিকারী হয়", "fa": "مرا وارث می‌شود"}}, {"text": "وَيَرِثُ", "hit": true, "audio": "audio/d5b56d2c91fd69d970d4.m4a", "gloss": {"en": "and he/it inherits", "bs": "i nasljeđuje", "tr": "ve miras alır", "fr": "et il hérite", "id": "dan dia mewarisi", "ur": "اور وہ وارث ہوتا ہے", "bn": "এবং সে উত্তরাধিকারী হয়", "fa": "و وارث می‌شود"}}, {"text": "مِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَالِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْقُوبَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱجْعَلْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "رَضِيًّا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:11", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2684.mp3", "translation": {"en": {"text": "Who will inherit paradise. There they will abide.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ki, Firdevs'e varis olan bu kimseler orada ebedî kalırlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ فردوس کی میراث پائیں گے، وہ اس میں ہمیشہ رہیں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yakni) yang akan mewarisi surga Firdaus. Mereka kekal di dalamnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَرِثُونَ", "hit": true, "audio": "audio/ab4941cfcf85ed52f14d.m4a", "gloss": {"en": "they inherit", "bs": "nasljeđuju", "tr": "miras alırlar", "fr": "ils héritent", "id": "mereka mewarisi", "ur": "وہ وارث ہوتے ہیں", "bn": "তারা উত্তরাধিকারী হয়", "fa": "وارث می‌شوند"}}, {"text": "ٱلْفِرْدَوْسَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "خَٰلِدُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:80", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2330.mp3", "translation": {"en": {"text": "And We shall inherit from him that whereof he spake, and he will come unto Us, alone (without his wealth and children).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O söylediği (mal ve evlat gibi) şeyleri de hep elinden alacağız ve o, tek başına bize gelecektir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جو چیزیں کہہ رہا ہے ان کے ہمیں وارث ہوں گے اور ہمارے پاس اکیلا آئے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan Kami akan mewarisi apa yang ia katakan itu, dan ia akan datang kepada Kami dengan seorang diri.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَنَرِثُهُۥ", "hit": true, "audio": "audio/a2e6b8072ea995f77b57.m4a", "gloss": {"bs": "i naslijedit ćemo od njega", "en": "and We will inherit from him", "tr": "ve ondan miras alacağız", "fr": "et Nous hériterons de lui", "id": "dan Kami akan mewarisinya", "ur": "اور ہم اس کے وارث ہوں گے", "bn": "এবং আমরা তার উত্তরাধিকারী হব", "fa": "و از او ارث خواهیم برد"}}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُولُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَأْتِينَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَرْدًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَرِثُونَ", "count": 2, "first": "7:100", "audio": "audio/8c14e46691d79fe4928d.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they inherit", "bs": "nasljeđuju", "tr": "miras alırlar", "fr": "ils héritent", "id": "mereka mewarisi", "ur": "وہ وارث ہوتے ہیں", "bn": "তারা উত্তরাধিকারী হয়", "fa": "وارث می‌شون