{"ayat":[{"ref":"86:1","number":5932,"text":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","hits":[0]},{"ref":"86:2","number":5933,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","hits":[0,1]},{"ref":"86:3","number":5934,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ","hits":[0]},{"ref":"86:4","number":5935,"text":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","hits":[0,2,3,4]},{"ref":"86:5","number":5936,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","hits":[0,1,2,3]},{"ref":"86:6","number":5937,"text":"خُلِقَ مِن مَّآءٍ دَافِقٍ","hits":[2]},{"ref":"86:7","number":5938,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","hits":[0]},{"ref":"86:8","number":5939,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","hits":[0,3]},{"ref":"86:9","number":5940,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","hits":[0,1]},{"ref":"86:10","number":5941,"text":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","hits":[1,3,4,5]},{"ref":"86:11","number":5942,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","hits":[]},{"ref":"86:12","number":5943,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","hits":[0]},{"ref":"86:13","number":5944,"text":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","hits":[1]},{"ref":"86:14","number":5945,"text":"وَمَا هُوَ بِٱلْهَزْلِ","hits":[1]},{"ref":"86:15","number":5946,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","hits":[1,2]},{"ref":"86:16","number":5947,"text":"وَأَكِيدُ كَيْدًا","hits":[]},{"ref":"86:17","number":5948,"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","hits":[1]}]}