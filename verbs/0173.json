t": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَقْسِمِي", "plain": "أَقْسِمِي", "quran": false, "notUsed": false, "spoken": "audio/b09776efb9080e537a89.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَقْسِمَا", "plain": "أَقْسِمَا", "quran": false, "notUsed": false, "spoken": "audio/ba442e65bd33e260e9f1.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَقْسِمُوا", "plain": "أَقْسِمُوا", "quran": false, "notUsed": false, "spoken": "audio/d7667756a1a2b0b1c44e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَقْسِمْنَ", "plain": "أَقْسِمْنَ", "quran": false, "notUsed": false, "spoken": "audio/3b444c73fdca48059df4.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "81:15", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5815.mp3", "translation": {"en": {"text": "Oh, but I call to witness the planets,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Şimdi yemin ederim o sinenlere (gündüzleri gözden kaybolan yıldızlara),", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو قسم ہے ان کی جو الٹے پھریں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sungguh, Aku bersumpah dengan bintang-bintang,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أُقْسِمُ", "hit": true, "audio": "audio/b7e4b18b6bd294efc6e5.m4a", "gloss": {"bs": "kunem se", "en": "I swear", "tr": "yemin ederim", "fr": "je jure", "id": "aku bersumpah", "ur": "میں قسم کھاتا ہوں", "bn": "আমি কসম করছি", "fa": "سوگند می‌خورم"}}, {"text": "بِٱلْخُنَّسِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "68:17", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5288.mp3", "translation": {"en": {"text": "Lo! We have tried them as We tried the owners of the garden when they vowed that they would pluck its fruit next morning,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz onlara da belâ verdik, bahçe sahiplerine verdiğimiz gibi. Hani onlar sabah olunca bahçeyi mutlaka devşireceklerine yemin etmişlerdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک ہم نے انہیں جانچا جیسا اس باغ والوں کو جانچا تھا جب انہوں نے قسم کھائی کہ ضرور صبح ہوتے اس کھیت کو کاٹ لیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Kami telah mencobai mereka (musyrikin Mekah) sebagaimana Kami telah mencobai pemilik-pemilik kebun, ketika mereka bersumpah bahwa mereka sungguh-sungguh akanmemetik (hasil)nya di pagi hari,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "بَلَوْنَٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "بَلَوْنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَصْحَٰبَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْجَنَّةِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَقْسَمُوا۟", "hit": true, "audio": "audio/d4a04e7e2989c2619c80.m4a", "gloss": {"bs": "zakleli su se", "en": "they swore", "tr": "yemin ettiler", "fr": "ils jurèrent", "id": "mereka bersumpah", "ur": "انہوں نے قسم کھائی", "bn": "তারা কসম করল", "fa": "سوگند خوردند"}}, {"text": "لَيَصْرِمُنَّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "مُصْبِحِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "30:55", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3464.mp3", "translation": {"en": {"text": "And on the day when the Hour riseth the guilty will vow that they did tarry but an hour - thus were they ever deceived.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kıyamet kopacağı gün günahkarlar dünyada bir saatten fazla durmadıklarına yemin ederler. Onlar önceden de böyle haktan çevriliyorlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جس دن قیامت قائم ہوگی مجرم قسم کھائیں گے کہ نہ رہے تھے مگر ایک گھڑی وہ ایسے ہی اوندھے جاتے تھے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan pada hari terjadinya kiamat, bersumpahlah orang-orang yang berdosa; \"mereka tidak berdiam (dalam kubur) melainkan sesaat (saja)\". Seperti demikianlah mereka selalu dipalingkan (dari kebenaran).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَقُومُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّاعَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "يُقْسِمُ", "hit": true, "audio": "audio/9cd4fd35fbb12783aa26.m4a", "gloss": {"en": "he/it swears", "bs": "zaklinje se", "tr": "yemin eder", "fr": "il jure", "id": "dia bersumpah", "ur": "وہ قسم کھاتا ہے", "bn": "সে শপথ করে", "fa": "سوگند می‌خورد"}}, {"text": "ٱلْمُجْرِمُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَبِثُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "غَيْرَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَاعَةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "كَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يُؤْفَكُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أُقْسِمُ", "count": 8, "first": "56:75", "audio": "audio/b7e4b18b6bd294efc