{"ayat":[{"ref":"37:1","number":3789,"text":"وَٱلصَّٰٓفَّٰتِ صَفًّا","hits":[]},{"ref":"37:2","number":3790,"text":"فَٱلزَّٰجِرَٰتِ زَجْرًا","hits":[]},{"ref":"37:3","number":3791,"text":"فَٱلتَّٰلِيَٰتِ ذِكْرًا","hits":[1]},{"ref":"37:4","number":3792,"text":"إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌ","hits":[0]},{"ref":"37:5","number":3793,"text":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ","hits":[0,1,2,3,6]},{"ref":"37:6","number":3794,"text":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ","hits":[1,4,5]},{"ref":"37:7","number":3795,"text":"وَحِفْظًا مِّن كُلِّ شَيْطَٰنٍ مَّارِدٍ","hits":[0,1]},{"ref":"37:8","number":3796,"text":"لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ","hits":[0,2,3,5,8]},{"ref":"37:9","number":3797,"text":"دُحُورًا وَلَهُمْ عَذَابٌ وَاصِبٌ","hits":[1,2]},{"ref":"37:10","number":3798,"text":"إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ","hits":[0,1,4,5]},{"ref":"37:11","number":3799,"text":"فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ إِنَّا خَلَقْنَٰهُم مِّن طِينٍ لَّازِبٍۭ","hits":[0,1,3,4,6,10]},{"ref":"37:12","number":3800,"text":"بَلْ عَجِبْتَ وَيَسْخَرُونَ","hits":[0,1,2]},{"ref":"37:13","number":3801,"text":"وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ","hits":[0,1,3]},{"ref":"37:14","number":3802,"text":"وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ","hits":[1,2]},{"ref":"37:15","number":3803,"text":"وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌ مُّبِينٌ","hits":[0,1,2,4,5]},{"ref":"37:16","number":3804,"text":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ","hits":[1,2,3,4]},{"ref":"37:17","number":3805,"text":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","hits":[0]},{"ref":"37:18","number":3806,"text":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ","hits":[1,2]},{"ref":"37:19","number":3807,"text":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ","hits":[1,6]},{"ref":"37:20","number":3808,"text":"وَقَالُوا۟ يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ","hits":[1,3,4]},{"ref":"37:21","number":3809,"text":"هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","hits":[3,5,6]},{"ref":"37:22","number":3810,"text":"ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ","hits":[0,1,2,3,6]},{"ref":"37:23","number":3811,"text":"مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ","hits":[3,5]},{"ref":"37:24","number":3812,"text":"وَقِفُوهُمْ إِنَّهُم مَّسْـُٔولُونَ","hits":[]},{"ref":"37:25","number":3813,"text":"مَا لَكُمْ لَا تَنَاصَرُونَ","hits":[1]},{"ref":"37:26","number":3814,"text":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ","hits":[]},{"ref":"37:27","number":3815,"text":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","hits":[0,2,4]},{"ref":"37:28","number":3816,"text":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ","hits":[3,4,5]},{"ref":"37:29","number":3817,"text":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ","hits":[2,4]},{"ref":"37:30","number":3818,"text":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍۭ بَلْ كُنتُمْ قَوْمًا طَٰغِينَ","hits":[5,8]},{"ref":"37:31","number":3819,"text":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ إِنَّا لَذَآئِقُونَ","hits":[0,2]},{"ref":"37:32","number":3820,"text":"فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ","hits":[0]},{"ref":"37:33","number":3821,"text":"فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ","hits":[2]},{"ref":"37:34","number":3822,"text":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","hits":[1,2,3]},{"ref":"37:35","number":3823,"text":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ","hits":[9]},{"ref":"37:36","number":3824,"text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ","hits":[4,5]},{"ref":"37:37","number":3825,"text":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ","hits":[1,2,3,4]},{"ref":"37:38","number":3826,"text":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ","hits":[3]},{"ref":"37:39","number":3827,"text":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ","hits":[1,5]},{"ref":"37:40","number":3828,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","hits":[1]},{"ref":"37:41","number":3829,"text":"أُو۟لَٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ","hits":[0,2,3]},{"ref":"37:42","number":3830,"text":"فَوَٰكِهُ وَهُم مُّكْرَمُونَ","hits":[]},{"ref":"37:43","number":3831,"text":"فِى جَنَّٰتِ ٱلنَّعِيمِ","hits":[1,2]},{"ref":"37:44","number":3832,"text":"عَلَىٰ سُرُرٍ مُّتَقَٰبِلِينَ","hits":[]},{"ref":"37:45","number":3833,"text":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ","hits":[0,2]},{"ref":"37:46","number":3834,"text":"بَيْضَآءَ لَذَّةٍ لِّلشَّٰرِبِينَ","hits":[0]},{"ref":"37:47","number":3835,"text":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ","hits":[]},{"ref":"37:48","number":3836,"text":"وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ عِينٌ","hits":[]},{"ref":"37:49","number":3837,"text":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ","hits":[0,2]},{"ref":"37:50","number":3838,"text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","hits":[]},{"ref":"37:51","number":3839,"text":"قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ","hits":[6]},{"ref":"37:52","number":3840,"text":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ","hits":[]},{"ref":"37:53","number":3841,"text":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ","hits":[]},{"ref":"37:54","number":3842,"text":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ","hits":[1]},{"ref":"37:55","number":3843,"text":"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ","hits":[0]},{"ref":"37:56","number":3844,"text":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ","hits":[3]},{"ref":"37:57","number":3845,"text":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ","hits":[0,1]},{"ref":"37:58","number":3846,"text":"أَفَمَا نَحْنُ بِمَيِّتِينَ","hits":[1,2]},{"ref":"37:59","number":3847,"text":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ","hits":[]},{"ref":"37:60","number":3848,"text":"إِنَّ هَٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ","hits":[2,3,4]},{"ref":"37:61","number":3849,"text":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ ٱلْعَٰمِلُ