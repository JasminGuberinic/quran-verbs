"quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "كَادِي", "plain": "كَادِي", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "كَادَا", "plain": "كَادَا", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "كَادُوا", "plain": "كَادُوا", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "كِدْنَ", "plain": "كِدْنَ", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}], "ayat": [{"ref": "43:52", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4377.mp3", "translation": {"en": {"text": "I am surely better than this fellow, who is despicable and can hardly make (his meaning) plain!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yoksa ben, nerede ise meramını anlatamayan şu zavallıdan daha hayırlı değil miyim?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا میں بہتر ہوں اس سے کہ ذلیل ہے اور بات صاف کرتا معلوم نہیں ہوتا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Bukankah aku lebih baik dari orang yang hina ini dan yang hampir tidak dapat menjelaskan (perkataannya)?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَا۠", "hit": false, "audio": null, "gloss": null}, {"text": "خَيْرٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَهِينٌ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَكَادُ", "hit": true, "audio": "audio/77284bd8b511023cafd1.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}]}, {"text": "يُبِينُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "72:19", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5466.mp3", "translation": {"en": {"text": "And when the slave of Allah stood up in prayer to Him, they crowded on him, almost stifling.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah'ın kulu (Hz. Peygamber) kalkmış O'na dua ederken, neredeyse (cinler) onun etrafında keçe gibi birbirlerine geçeceklerdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ کہ جب اللہ کا بندہ اس کی بندگی کرنے کھڑا ہوا تو قریب تھا کہ وہ جن اس پر ٹھٹھ کے ٹھٹھ ہوجائیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan bahwasanya tatkala hamba Allah (Muhammad) berdiri menyembah-Nya (mengerjakan ibadat), hampir saja jin-jin itu desak mendesak mengerumuninya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "لَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "قَامَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَبْدُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَدْعُوهُ", "hit": false, "audio": null, "gloss": null}, {"text": "كَادُوا۟", "hit": true, "audio": "audio/523321c2a837be747349.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}]}, {"text": "يَكُونُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "لِبَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:90", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2340.mp3", "translation": {"en": {"text": "Whereby almost the heavens are torn, and the earth is split asunder and the mountains fall in ruins,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Az kalsın, söyledikleri sözden gökler çatlayacak, yer yarılacak ve dağlar parçalanıp dağılacaktı,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "قریب ہے کہ آسمان اس سے پھٹ پڑیں اور زمین شق ہوجائے اور پہاڑ گر جائیں ڈھ کر (مسمار ہوکر)", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "hampir-hampir langit pecah karena ucapan itu, dan bumi belah, dan gunung-gunung runtuh,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "تَكَادُ", "hit": true, "audio": "audio/1212b87e8b7e71c6bf34.m4a", "gloss": {"bs": "zamalo će", "en": "are about to", "tr": "neredeyse", "fr": "sont sur le point de", "id": "hampir", "ur": "قریب ہیں کہ", "bn": "উপক্রম হয়", "fa": "نزدیک است"}}, {"text": "ٱلسَّمَٰوَٰتُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَفَطَّرْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَنشَقُّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَخِرُّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْجِبَالُ", "hit": false, "audio": null, "gloss": null}, {"text": "هَدًّا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:56", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3844.mp3", "translation": {"en": {"text": "He saith: By Allah, thou verily didst all but cause my ruin,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ona şöyle der: \"Allah'a yemin ederim ki, doğrusu sen az daha beni helak edecektin.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہا خدا کی قسم قریب تھا کہ تو مجھے ہلاک کردے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ia berkata (pula): \"Demi Allah, sesungguhnya kamu benar-benar hampir mencelakakanku,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "كِدتَّ", "hit": true, "audio": "audio/0ecf475318c89c3b8071.m4a", "gloss": {"bs": "zamalo si", "en": "you almost", "tr": "neredeyse sen", "fr": "tu as failli", "id": "kamu hampir", "ur": "قریب تھا کہ تم", "bn": "তুমি প্রায়", "fa": "نزدیک بودی"}}, {"text": "لَتُرْدِينِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:15", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2363.mp3", "translation": {"en": {"text": "Lo! the Hour is surely coming. But I will to keep it hidden, that every soul may be rewarded for that which it striveth (to achieve).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Çünkü kıyamet muhakkak gelecektir. Onun vaktini gizli tutuyorum ki, herkes yaptığının karşılığını görsün.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک قیامت آنے والی ہے قریب تھا کہ میں اسے سب سے چھپاؤں کہ ہر جان اپنی کوشش کا بدلہ پائے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Segungguhnya hari kiamat itu akan datang Aku merahasiakan (waktunya) agar supaya tiap-tiap diri itu dibalas dengan apa yang ia usahakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّاعَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاتِيَةٌ", "hit": false, "audio": null, "gloss": null}, {"text": "أَكَادُ", "hit": true, "audio": "audio/d0e20332857d6421b3b7.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}]}, {"text": "أُخْفِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "لِتُجْزَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "كُلُّ", "hit": false, "audio": null, "gloss": null}, {"text": "نَفْسٍۭ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْعَىٰ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَكَادُ", "count": 6, "first": "2:20", "audio": "audio/325d8452a3b2101d2989.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}]}, {"arabic": "كَادُوا۟", "count": 4, "first": "2:71", "audio": "audio/e5da2364a478c2c1731a.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}]}, {"arabic": "يَكَادُونَ", "count": 3, "first": "4:78", "audio": "audio/38ed1a35a838000bda80.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}]}, {"arabic": "تَكَادُ", "count": 3, "first": "19:90", "audio": "audio/1212b87e8b7e71c6bf34.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "zamalo će", "en": "are about to", "tr": "neredeyse", "fr": "sont sur le point de", "id": "hampir", "ur": "قریب ہیں کہ", "bn": "উপক্রম হয়", "fa": "نزدیک است"}}, {"arabic": "كَادَ", "count": 2, "first": "9:117", "audio": "audio/ee989293e05c515bc13f.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive"