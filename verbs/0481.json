", "id": "lalu mereka durhaka", "ur": "پھر انہوں نے سرکشی کی", "bn": "কিন্তু তারা ঔদ্ধত্য দেখাল", "fa": "پس سرکشی کردند"}}, {"text": "عَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْرِ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَخَذَتْهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّٰعِقَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَنظُرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَعَتَوْا۟", "count": 1, "first": "7:77", "audio": "audio/caff449488fcc724f548.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "and they were insolent", "bs": "i pobunili su se", "tr": "ve isyan ettiler", "fr": "et ils se sont révoltés", "id": "dan mereka telah memberontak", "ur": "اور انہوں نے سرکشی کی", "bn": "এবং তারা বিদ্রোহ করল", "fa": "و سرکشی کردند"}}, {"arabic": "عَتَوْا۟", "count": 1, "first": "7:166", "audio": "audio/e2d6aaaa4c0373e6c9d7.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they were insolent", "bs": "pobunili su se", "tr": "isyan ettiler", "fr": "ils se sont révoltés", "id": "mereka telah memberontak", "ur": "انہوں نے سرکشی کی", "bn": "তারা বিদ্রোহ করল", "fa": "سرکشی کردند"}}, {"arabic": "وَعَتَوْ", "count": 1, "first": "25:21", "audio": "audio/6d6c01662bb35e4ed16a.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "and they were insolent", "bs": "i pobunili su se", "tr": "ve isyan ettiler", "fr": "et ils se sont révoltés", "id": "dan mereka telah memberontak", "ur": "اور انہوں نے سرکشی کی", "bn": "এবং তারা বিদ্রোহ করল", "fa": "و سرکشی کردند"}}, {"arabic": "فَعَتَوْا۟", "count": 1, "first": "51:44", "audio": "audio/e6b17b455a00ed3e5195.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "pa su se oholo suprotstavili", "en": "but they defied", "tr": "ama azgınlık edip karşı çıktılar", "fr": "mais ils se sont rebellés avec insolence", "id": "lalu mereka durhaka", "ur": "پھر انہوں نے سرکشی کی", "bn": "কিন্তু তারা ঔদ্ধত্য দেখাল", "fa": "پس سرکشی کردند"}}, {"arabic": "عَتَتْ", "count": 1, "first": "65:8", "audio": "audio/d0cdc602f44a5977d1cc.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"en": "she/it was insolent", "bs": "pobunila se", "tr": "isyan etti", "fr": "elle s'est révoltée", "id": "dia telah memberontak", "ur": "وہ سرکش ہوئی", "bn": "সে বিদ্রোহ করল", "fa": "سرکشی کرد"}}], "ayatFile": "ayat/0481.json", "ayatTranslations": {"en": "ayat/0481.en.json", "tr": "ayat/0481.tr.json", "ur": "ayat/0481.ur.json", "id": "ayat/0481.id.json"}, "sentences": [{"arabic": "عَتَتِ الْمَلِكَةُ وَتَكَبَّرَتْ", "spoken": "audio/6a306c25682b17b4fd2c.m4a", "tense": "past", "pronoun": "hiya", "translation": {"bs": "Kraljica je bila drska i ohola.", "en": "The queen was insolent and arrogant.", "bn": "রানি ছিল ঔদ্ধত্যপূর্ণ ও অহংকারী।", "fa": "ملکه سرکش و متکبر بود.", "fr": "La reine a été insolente et arrogante.", "id": "Sang ratu bersikap angkuh dan sombong.", "tr": "Kraliçe azgınlık edip kibirlendi.", "ur": "ملکہ سرکش اور متکبر تھی۔"}, "independentlyReviewed": true, "words": [{"arabic": "عَتَتِ", "target": true, "translation": {"bs": "bila je drska", "en": "was insolent", "bn": "ঔদ্ধত্য দেখাল", "fa": "سرکشی کرد", "fr": "a été insolente", "id": "bersikap angkuh", "tr": "azgınlık etti", "ur": "سرکشی کی"}}, {"arabic": "الْمَلِكَةُ", "target": false, "translation": {"bs": "kraljica", "en": "the queen", "bn": "রানি", "fa": "ملکه", "fr": "la reine", "id": "ratu", "tr": "kraliçe", "ur": "ملکہ"}}, {"arabic": "وَتَكَبَّرَتْ", "target": false, "translation": {"bs": "i bila ohola", "en": "and was arrogant", "bn": "এবং অহংকার করল", "fa": "و تکبر ورزید", "fr": "et s'est montrée arrogante", "id": "dan bersikap sombong", "tr": "ve kibirlendi", "ur": "اور تکبر کیا"}}]}, {"arabic": "عَتَوْا عَلَى شُعُوبِهِمْ", "spoken": "audio/9dcb642b12d2a8c8505c.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Oholo su se ponijeli prema svojim narodima.", "en": "They behaved with insolence toward their peoples.", "bn": "তারা তাদের জনগণের প্রতি ঔদ্ধত্যপূর্ণ আচরণ করল।", "fa": "آنان با مردمانشان با سرکشی رفتار کردند.", "fr": "Ils se sont montrés insolents envers leurs peuples.", "id": "Mereka bersikap angkuh terhadap bangsa mereka.", "tr": "Halklarına karşı azgınlık ettiler.", "ur": "انہوں نے اپنی قوموں کے ساتھ سرکشی کا برتاؤ کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "عَتَوْا", "target": true, "translation": {"bs": "oholo su se ponijeli", "en": "were insolent", "bn": "তারা ঔদ্ধত্য দেখাল", "fa": "سرکشی کردند", "fr": "ont été insolents", "id": "mereka bersikap angkuh", "tr": "azgınlık ettiler", "ur": "انہوں نے سرکشی کی"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "prema", "en": "over", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "atas", "tr": "üzerinde", "ur": "کے اوپر"}}, {"arabic": "شُعُوبِهِمْ", "target": false, "translation": {"bs": "svojim narodima", "en": "their peoples", "bn": "তাদের জনগণ", "fa": "مردمانشان", "fr": "leurs peuples", "id": "bangsa mereka", "tr": "halkları", "ur": "ان کی قومیں"}}]}]}