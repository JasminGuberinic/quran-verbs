{"rank": 83, "root": "شهد", "form": 1, "lemma": "شَهِدَ", "count": 44, "ayahCount": 38, "share": 0.23, "meaning": {"bs": "svjedočiti, prisustvovati", "en": "to witness, to testify", "tr": "şahitlik etmek, tanıklık etmek", "fr": "témoigner, être témoin", "id": "menyaksikan, bersaksi", "ur": "گواہی دینا، گواہ ہونا", "bn": "সাক্ষ্য দেওয়া, সাক্ষী হওয়া", "fa": "شهادت دادن، گواهی دادن"}, "lemmaSpoken": "audio/bd25e17182be99893f1f.m4a", "animation": "<svg class=\"va va-shahida_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes shahida_1-x{from{transform:translateX(-12px)}}@keyframes shahida_1-y{from{transform:translateY(-21px)}}@keyframes shahida_1-a{from,60%{transform:rotate(0)}}.va-shahida_1 .bx{animation:shahida_1-x 1.2s linear both}.va-shahida_1 .by{animation:shahida_1-y .6s ease-in .6s both}.va-shahida_1 .ra{transform:rotate(-165deg);animation:shahida_1-a 2.4s ease-out both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-shahida_1.off,.va-shahida_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-shahida_1,.va-shahida_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><path class=\"p\" d=\"M62 40h24M66 40v21M82 40v21\"/><g class=\"bx\"><g class=\"by\"><circle class=\"q\" cx=\"92\" cy=\"57\" r=\"3.6\"/></g></g><g transform=\"translate(36 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "شَهِدَ", "plain": "شَهِدَ", "quran": true, "notUsed": false, "spoken": "audio/bd25e17182be99893f1f.m4a", "recited": "audio/49e98d5fca9403165db9.m4a", "recitedText": "شَهِدَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَشْهَدُ", "plain": "يَشْهَدُ", "quran": true, "notUsed": false, "spoken": "audio/e7ed28d24d0f7605dd47.m4a", "recited": "audio/1e19c460e667b4782d12.m4a", "recitedText": "يَشْهَدُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱشْهَدْ", "plain": "اِشْهَدْ", "quran": true, "notUsed": false, "spoken": "audio/43fadd248456e3a9caa6.m4a", "recited": "audio/e3a5e57314c32ef11429.m4a", "recitedText": "وَٱشْهَدْ"}], "nouns": {"participle": {"lemma": "شاهِد", "count": 21, "spoken": "audio/2249de8fe4c29e480a26.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "شَهِدْتُ", "plain": "شَهِدْتُ", "quran": false, "notUsed": false, "spoken": "audio/b0fb829ce677fe7c0ecb.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "شَهِدْنَا", "plain": "شَهِدْنَا", "quran": true, "notUsed": false, "spoken": "audio/07d79feab7923f2203f1.m4a", "recited": "audio/7c73f450b4d36253f41f.m4a", "recitedText": "شَهِدْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "شَهِدْتَ", "plain": "شَهِدْتَ", "quran": false, "notUsed": false, "spoken": "audio/c52b42e355e6fd58b5cf.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "شَهِدْتِ", "plain": "شَهِدْتِ", "quran": false, "notUsed": false, "spoken": "audio/339f732e75944c1eee9b.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "شَهِدْتُمَا", "plain": "شَهِدْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/de8eed8bf01e633386ae.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "شَهِدتُّمْ", "plain": "شَهِدْتُمْ", "quran": true, "notUsed": false, "spoken": "audio/b08db25ecc3d7fc8259f.m4a", "recited": "audio/723070cb1d900dcc985f.m4a", "recitedText": "شَهِدتُّمْ"},