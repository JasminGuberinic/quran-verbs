 null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱمْنُنْ", "plain": "اُمْنُنْ", "quran": true, "notUsed": false, "spoken": "audio/5b1a35833b5cbfa00f73.m4a", "recited": "audio/317cb8961d3bb2ba5318.m4a", "recitedText": "فَٱمْنُنْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "مُنِّي", "plain": "مُنِّي", "quran": false, "notUsed": false, "spoken": "audio/3835fe1ee1f84788a670.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "مُنَّا", "plain": "مُنَّا", "quran": false, "notUsed": false, "spoken": "audio/4c739f39842db1376786.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "مُنُّوا", "plain": "مُنُّوا", "quran": false, "notUsed": false, "spoken": "audio/006c99de208820db789a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُمْنُنَّ", "plain": "اُمْنُنَّ", "quran": false, "notUsed": false, "spoken": "audio/170bb44c566806eb8b97.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "52:27", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4762.mp3", "translation": {"en": {"text": "But Allah hath been gracious unto us and hath preserved us from the torment of the breath of Fire.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Allah bize lutfetti de bizi (vücûdun) içine işleyen (kavurucu) azabdan korudu.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اللہ نے ہم پر احسان کیا اور ہمیں لُو کے عذاب سے بچالیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Allah memberikan karunia kepada kami dan memelihara kami dari azab neraka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَمَنَّ", "hit": true, "audio": "audio/8673b76ec8da91a05814.m4a", "gloss": {"en": "so he/it bestowed a favour", "bs": "pa je obdario", "tr": "böylece lütufta bulundu", "fr": "alors il a comblé de faveurs", "id": "maka dia telah memberi karunia", "ur": "پس اُس نے احسان کیا", "bn": "অতএব সে অনুগ্রহ করল", "fa": "پس عنایت کرد"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَوَقَىٰنَا", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمُومِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:37", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2385.mp3", "translation": {"en": {"text": "And indeed, another time, already We have shown thee favour,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"And olsun biz, sana diğer bir defa daha ihsan etmiştik\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے تجھ پر ایک بار اور احسان فرمایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya Kami telah memberi nikmat kepadamu pada kali yang lain,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "مَنَنَّا", "hit": true, "audio": "audio/f74b11a17fbe78e36e26.m4a", "gloss": {"bs": "ukazali smo milost", "en": "We bestowed favour", "tr": "lütufta bulunduk", "fr": "Nous avons accordé une faveur", "id": "Kami melimpahkan nikmat", "ur": "ہم نے احسان کیا", "bn": "আমরা অনুগ্রহ করেছি", "fa": "نعمت بخشیدیم"}}, {"text": "عَلَيْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَرَّةً", "hit": false, "audio": null, "gloss": null}, {"text": "أُخْرَىٰٓ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "74:6", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5501.mp3", "translation": {"en": {"text": "And show not favour, seeking wordly gain!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yaptığını çok görerek başa kakma.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور زیادہ لینے کی نیت سے کسی پر احسان نہ کرو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan janganlah kamu memberi (dengan maksud) memperoleh (balasan) yang lebih banyak.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَمْنُن", "hit": true, "audio": "audio/da6d06e0957b5b51c274.m4a", "gloss": {"bs": "čini dobročinstvo", "en": "bestow favour", "tr": "ihsan et", "fr": "ne fais pas de faveur", "id": "limpahkanlah nikmat", "ur": "احسان کر", "bn": "অনুগ্রহ করো", "fa": "منت می‌گذاری"}}, {"text": "تَسْتَكْثِرُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "28:5", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3257.mp3", "translation": {"en": {"text": "And We desired to show favour unto those who were oppressed in the earth, and to make them examples and to make them the inheritors,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz ise istiyorduk ki, o yerde güçsüz düşürülenlere lütufta bulunalım, onları önderler yapalım, onlara (ötekilerin) yerini aldıralım.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم چاہتے تھے کہ ان کمزوریوں پر احسان فرمائیں اور ان کو پیشوا بنائیں اور ان کے ملک و مال کا انہیں کو وارث بنائیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami hendak memberi karunia kepada orang-orang yang tertindas di bumi (Mesir) itu dan hendak menjadikan mereka pemimpin dan menjadikan mereka orang-orang yang mewarisi (bumi),", "by": "Kementerian Agama RI, via