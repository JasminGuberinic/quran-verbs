l, "gloss": null}, {"text": "نُسَيِّرُ", "hit": true, "audio": "audio/0c2a3d017293d4c283dc.m4a", "gloss": {"bs": "pokrenut ćemo", "en": "We set in motion", "tr": "harekete geçireceğiz", "fr": "Nous mettrons en marche", "id": "Kami akan menggerakkan", "ur": "ہم چلائیں گے", "bn": "আমরা চালিয়ে দিই", "fa": "به راه می‌اندازیم"}}, {"text": "ٱلْجِبَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَرَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضَ", "hit": false, "audio": null, "gloss": null}, {"text": "بَارِزَةً", "hit": false, "audio": null, "gloss": null}, {"text": "وَحَشَرْنَٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نُغَادِرْ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَحَدًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "سُيِّرَتْ", "count": 2, "first": "13:31", "audio": "audio/318680dd6f01d398c60e.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": true, "objects": []}], "gloss": {"en": "it was set in motion", "bs": "pokrenuta je", "tr": "harekete geçirildi", "fr": "elle a été mise en mouvement", "id": "dia telah digerakkan", "ur": "وہ چلایا گیا", "bn": "তা চালু করা হলো", "fa": "به حرکت درآمد"}}, {"arabic": "يُسَيِّرُكُمْ", "count": 1, "first": "10:22", "audio": "audio/6b7519e77c73de3fb61c.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "he/it makes you (all) travel", "bs": "omogućava vam da putujete", "tr": "seyahat etmenizi sağlar", "fr": "il vous permet de voyager", "id": "dia memungkinkan kalian bepergian", "ur": "وہ تم سب کو سفر کراتا ہے", "bn": "সে তোমাদের ভ্রমণ করার সুযোগ দেয়", "fa": "به شما امکان سفر می‌دهد"}}, {"arabic": "نُسَيِّرُ", "count": 1, "first": "18:47", "audio": "audio/0c2a3d017293d4c283dc.m4a", "grammar": [{"tense": "prese