ي", "quran": false, "notUsed": false, "spoken": "audio/5aea2979325b22294234.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "خَافَا", "plain": "خَافَا", "quran": false, "notUsed": false, "spoken": "audio/3d1e08cef388be1ff7ec.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "خَافُوا", "plain": "خَافُوا", "quran": false, "notUsed": false, "spoken": "audio/6dccd6a89f2b4f6e5e9b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "خِفْنَ", "plain": "خِفْنَ", "quran": false, "notUsed": false, "spoken": "audio/33f668ffeaef66a8b8ef.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "26:12", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2944.mp3", "translation": {"en": {"text": "He said: My Lord! Lo! I fear that they will deny me,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Musa) şöyle seslendi: \"Ya Rab! Doğrusu ben korkarım ki beni yalancı sayarlar.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "عرض کی کہ اے میرے رب میں ڈرتا ہوں کہ مجھے جھٹلا ئیں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berkata Musa: \"Ya Tuhanku, sesungguhnya aku takut bahwa mereka akan mendustakan aku.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنِّىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخَافُ", "hit": true, "audio": "audio/1c6cb4ff3e8c1631d6af.m4a", "gloss": {"en": "I fear", "bs": "bojim se", "tr": "korkarım", "fr": "je crains", "id": "aku takut", "ur": "میں ڈرتا ہوں", "bn": "আমি ভয় করি", "fa": "می‌ترسم"}}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يُكَذِّبُونِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "74:53", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5548.mp3", "translation": {"en": {"text": "Nay, verily. They fear not the Hereafter.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yok, yok onlar ahiretten korkmuyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہرگز نہیں بلکہ ان کو آخرت کا ڈر نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sekali-kali tidak. Sebenarnya mereka tidak takut kepada negeri akhirat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "بَل", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَخَافُونَ", "hit": true, "audio": "audio/fb781c548fc916d85f78.m4a", "gloss": {"en": "they fear", "bs": "boje se", "tr": "korkarlar", "fr": "ils craignent", "id": "mereka takut", "ur": "وہ ڈرتے ہیں", "bn": "তারা ভয় করে", "fa": "می‌ترسند"}}, {"text": "ٱلْءَاخِرَةَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:68", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2416.mp3", "translation": {"en": {"text": "We said: Fear not! Lo! thou art the higher.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz dedik ki: \"Korkma, çünkü sen muhakkak üstünsün (galib geleceksin) \"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہم نے فرمایا ڈر نہیں بیشک تو ہی غالب ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kami berkata: \"janganlah kamu takut, sesungguhnya kamulah yang paling unggul (menang).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَخَفْ", "hit": true, "audio": "audio/996c2099853d6467487b.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "jussive"}]}, {"text": "إِنَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَعْلَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "55:46", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4947.mp3", "translation": {"en": {"text": "But for him who feareth the standing before his Lord there are two gardens.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbinin makamından korkan kimselere iki cennet vardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جو اپنے رب کے حضور کھڑے ہونے سے ڈرے اس کے لیے دو جنتیں ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan bagi orang yang takut akan saat menghadap Tuhannya ada dua surga.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلِمَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "خَافَ", "hit": true, "audio": "audio/429dfe08d5a3809b48e5.m4a", "gloss": {"bs": "(ko) se boji", "en": "(whoever) fears", "tr": "(kim) korkarsa", "fr": "(quiconque) craint", "id": "(barang siapa) takut", "ur": "(جو) ڈرے", "bn": "(যে) ভয় করেছে", "fa": "(هر که) بترسد"}}, {"text": "مَقَامَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "جَنَّتَانِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "91:15", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6058.mp3", "translation": {"en": {"text": "He dreadeth not the sequel (of events).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Öyle ya, Allah bu işin sonundan korkacak değil ya.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اس کے پیچھا کرنے والے کا اسے خوف نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan Allah tidak takut terhadap akibat tindakan-Nya itu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَخَافُ", "hit": true, "audio": "audio/5230f7c753c6704127af.m4a", "gloss": {"bs": "(ne) boji se", "en": "He fears (not)", "tr": "korkmaz", "fr": "Il craint (pas)", "id": "Dia (tidak) takut", "ur": "وہ ڈرتا ہے (نہیں)", "bn": "তিনি ভয় করেন (না)", "fa": "می‌ترسد (نه)"}}, {"text": "عُقْبَٰهَا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:175", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/468.mp3", "translation": {"en": {"text": "It is only the devil who would make (men) fear his partisans. Fear them not; fear Me, if ye are true believers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Size o haberi getiren) ancak şeytandır, (sadece) kendi dostlarını korkutabilir. Onlardan korkmayın, eğer mümin iseniz benden korkun.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ تو شیطان ہی ہے کہ اپنے دوستوں سے دھمکاتا ہے تو ان سے نہ ڈرو اور مجھ سے ڈرو اگر ایمان رکھتے ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya mereka itu tidak lain hanyalah syaitan yang menakut-nakuti (kamu) dengan kawan-kawannya (orang-orang musyrik Quraisy), karena itu janganlah kamu takut kepada mereka, tetapi takutlah kepada-Ku, jika kamu benar-benar orang yang beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "ذَٰلِكُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلشَّيْطَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "يُخَوِّفُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْلِيَآءَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَخَافُوهُمْ", "hit": true, "audio": "audio/e6118ad301683bfe569b.m4a", "gloss": {"bs": "(ne) bojte ih se", "en": "(do not) fear them", "tr": "onlardan korkmayın", "fr": "(ne) les craignez (pas)", "id": "(jangan) takut kepada mereka", "ur": "ان سے (مت) ڈرو", "bn": "(তোমরা) তাদের ভয় করো না", "fa": "از آنان نترسید"}}, {"text": "وَخَافُونِ", "hit": true, "audio": "audio/d6aca795b45235c49eda.m4a", "gloss": {"bs": "i Mene se bojte!", "en": "and fear Me!", "tr": "ve benden korkun!", "fr": "et craignez-Moi !", "id": "dan takutlah kepada-Ku!", "ur": "اور مجھ سے ڈرو!", "bn": "এবং আমাকে ভয় করো!", "fa": "و از من بترسید!"}}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّؤْمِنِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَخَافُ", "count": 20, "first": "5:28", "audio": "audio/fd38eab6071cc74ac118.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "I fear", "bs": "bojim se", "tr": "korkarım", "fr": "je crains", "id": "aku takut", "ur": "میں ڈرتا ہوں", "bn": "আমি ভয় করি", "fa": "می‌ترسم"}}, {"arabic": "تَخَفْ", "count": 9, "first": "11:70", "audio": "audio/76327f60abf4d8ebd7c5.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "jussive"}]}, {"arabic": "يَخَافُونَ", "count": 8, "first": "5:23", "audio": "audio/1eb520b144bd4f3c78e7.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "