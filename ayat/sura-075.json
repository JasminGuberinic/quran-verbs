{"ayat":[{"ref":"75:1","number":5552,"text":"لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ","hits":[0,1,2,3]},{"ref":"75:2","number":5553,"text":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","hits":[2]},{"ref":"75:3","number":5554,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","hits":[0,1,2,3,4]},{"ref":"75:4","number":5555,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","hits":[0,1,2,4,5]},{"ref":"75:5","number":5556,"text":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ","hits":[0,1]},{"ref":"75:6","number":5557,"text":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ","hits":[0,1]},{"ref":"75:7","number":5558,"text":"فَإِذَا بَرِقَ ٱلْبَصَرُ","hits":[0,2]},{"ref":"75:8","number":5559,"text":"وَخَسَفَ ٱلْقَمَرُ","hits":[0,1]},{"ref":"75:9","number":5560,"text":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","hits":[1]},{"ref":"75:10","number":5561,"text":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","hits":[0,3]},{"ref":"75:11","number":5562,"text":"كَلَّا لَا وَزَرَ","hits":[0]},{"ref":"75:12","number":5563,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","hits":[0,1,3]},{"ref":"75:13","number":5564,"text":"يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","hits":[0,3,4,5]},{"ref":"75:14","number":5565,"text":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ","hits":[4]},{"ref":"75:15","number":5566,"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","hits":[0,1]},{"ref":"75:16","number":5567,"text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","hits":[2,3,4]},{"ref":"75:17","number":5568,"text":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","hits":[0,2]},{"ref":"75:18","number":5569,"text":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","hits":[1,2]},{"ref":"75:19","number":5570,"text":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","hits":[0,3]},{"ref":"75:20","number":5571,"text":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","hits":[2]},{"ref":"75:21","number":5572,"text":"وَتَذَرُونَ ٱلْءَاخِرَةَ","hits":[0]},{"ref":"75:22","number":5573,"text":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","hits":[0]},{"ref":"75:23","number":5574,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","hits":[]},{"ref":"75:24","number":5575,"text":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ","hits":[]},{"ref":"75:25","number":5576,"text":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","hits":[0,2]},{"ref":"75:26","number":5577,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","hits":[2]},{"ref":"75:27","number":5578,"text":"وَقِيلَ مَنْ رَاقٍ","hits":[1]},{"ref":"75:28","number":5579,"text":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","hits":[1,2]},{"ref":"75:29","number":5580,"text":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","hits":[1]},{"ref":"75:30","number":5581,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","hits":[]},{"ref":"75:31","number":5582,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","hits":[1,3]},{"ref":"75:32","number":5583,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","hits":[0,1,2]},{"ref":"75:33","number":5584,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","hits":[1,3]},{"ref":"75:34","number":5585,"text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","hits":[1]},{"ref":"75:35","number":5586,"text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","hits":[]},{"ref":"75:36","number":5587,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى","hits":[3]},{"ref":"75:37","number":5588,"text":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ","hits":[0,1,3]},{"ref":"75:38","number":5589,"text":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ","hits":[3]},{"ref":"75:39","number":5590,"text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","hits":[0,2,3,4]},{"ref":"75:40","number":5591,"text":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ","hits":[0,1,5,6]}]}