oken": "audio/f660caeda2f05b2f6e89.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِخْتَرْنَ", "plain": "اِخْتَرْنَ", "quran": false, "notUsed": false, "spoken": "audio/9a79e16c3cb58126197c.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "20:13", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2361.mp3", "translation": {"en": {"text": "And I have chosen thee, so hearken unto that which is inspired.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ben seni seçtim, şimdi (sana) vahyolunacak şeyleri dinle.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور میں نے تجھے پسند کیا اب کان لگا کر سن جو تجھے وحی ہوتی ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Aku telah memilih kamu, maka dengarkanlah apa yang akan diwahyukan (kepadamu).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱخْتَرْتُكَ", "hit": true, "audio": "audio/dbd321da1a9dd021bc93.m4a", "gloss": {"bs": "ja sam tebe izabrao", "en": "I have chosen you", "tr": "seni ben seçtim", "fr": "je t'ai choisi", "id": "aku telah memilihmu", "ur": "میں نے تجھے چن لیا ہے", "bn": "আমি তোমাকে বেছে নিয়েছি", "fa": "تو را برگزیده‌ام"}}, {"text": "فَٱسْتَمِعْ", "hit": false, "audio": null, "gloss": null}, {"text": "لِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُوحَىٰٓ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "44:32", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4446.mp3", "translation": {"en": {"text": "And We chose them, purposely, above (all) creatures.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun ki biz onları bilerek o zamanki alemlere üstün kıldık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے انہیں دانستہ چن لیا اس زمانے والوں سے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya telah Kami pilih mereka dengan pengetahuan (Kami) atas bangsa-bangsa.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱخْتَرْنَٰهُمْ", "hit": true, "audio": "audio/bcca5d73914a4dbd1515.m4a", "gloss": {"bs": "izabrali smo ih", "en": "we chose them", "tr": "onları seçtik", "fr": "nous les avons choisis", "id": "kami telah memilih mereka", "ur": "ہم نے انہیں چن لیا", "bn": "আমরা তাদেরকে বেছে নিয়েছি", "fa": "ایشان را برگزیدیم"}}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "عِلْمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَٰلَمِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَٱخْتَارَ", "count": 1, "first": "7:155", "audio": "audio/c484467031e872b8194a.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it chose", "bs": "i izabrao je", "tr": "ve seçti", "fr": "et il a choisi", "id": "dan dia telah memilih", "ur": "اور اُس نے چنا", "bn": "এবং সে মনোনীত করল", "fa": "و برگزید"}}, {"arabic": "ٱخْتَرْتُكَ", "count": 1, "first": "20:13", "audio": "audio/dbd321da1a9dd021bc93.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": false, "objects": ["anta"]}], "gloss": {"bs": "ja sam tebe izabrao", "en": "I have chosen you", "tr": "seni seçtim", "fr": "je t'ai choisi", "id": "aku telah memilihmu", "ur": "میں نے تمہیں چنا", "bn": "আমি তোমাকে মনোনীত করেছি", "fa": "من تو را برگزیده‌ام"}}, {"arabic": "وَيَخْتَارُ", "count": 1, "first": "28:68", "audio": "audio/002b3fbea559b34c0ead.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passiv