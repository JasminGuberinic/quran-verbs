t seemed alike", "bs": "pa se učinilo slično", "tr": "böylece benzer göründü", "fr": "alors il semblait pareil", "id": "maka seolah-olah menjadi serupa", "ur": "پس وہ ایک جیسے نظر آئے", "bn": "অতএব তা একইরকম মনে হলো", "fa": "پس شبیه به نظر آمد"}}], "ayatFile": "ayat/0541.json", "ayatTranslations": {"en": "ayat/0541.en.json", "tr": "ayat/0541.tr.json", "ur": "ayat/0541.ur.json", "id": "ayat/0541.id.json"}, "sentences": [{"arabic": "تَشَابَهَ التَّوْأَمَانِ", "spoken": "audio/5ca8f8b1c6abf8ccb832.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Blizanci su nalikovali jedan drugom.", "en": "The twins resembled each other.", "bn": "যমজ দু'জন একে অপরের মতো ছিল।", "fa": "دوقلوها شبیه هم بودند.", "fr": "Les jumeaux se ressemblaient.", "id": "Anak-anak kembar itu saling menyerupai.", "tr": "İkizler birbirine benziyordu.", "ur": "جڑواں بچے ایک دوسرے سے ملتے تھے۔"}, "independentlyReviewed": true, "words": [{"arabic": "تَشَابَهَ", "target": true, "translation": {"bs": "nalikovali su jedan drugom", "en": "resembled each other", "bn": "একে অপরের মতো ছিল", "fa": "شبیه یکدیگر بودند", "fr": "se ressemblaient", "id": "mereka saling menyerupai", "tr": "birbirine benzedi", "ur": "ایک دوسرے سے ملتے تھے"}}, {"arabic": "التَّوْأَمَانِ", "target": false, "translation": {"bs": "blizanci", "en": "the twins", "bn": "যমজরা", "fa": "دوقلوها", "fr": "les jumeaux", "id": "anak-anak kembar itu", "tr": "ikizler", "ur": "جڑواں"}}]}, {"arabic": "تَشَابَهَتْ بُيُوتُ الْحَيِّ", "spoken": "audio/16554e679596f420e348.m4a", "tense": "past", "pronoun": "hiya", "translation": {"bs": "Kuće u kvartu nalikovale su jedna drugoj.", "en": "The houses of the quarter resembled each other.", "bn": "মহল্লার বাড়িগুলো একে অপরের মতো ছিল।", "fa": "خانه‌های محله شبیه هم بودند.", "fr": "Les maisons du quartier se ressemblaient.", "id": "Rumah-rumah di kawasan itu saling menyerupai.", "tr": "Mahalledeki evler birbirine benziyordu.", "ur": "محلے کے گھر ایک دوسرے جیسے تھے۔"}, "independentlyReviewed": true, "words": [{"arabic": "تَشَابَهَتْ", "target": true, "translation": {"bs": "nalikovale su jedna drugoj", "en": "resembled each other", "bn": "একে অপরের মতো ছিল", "fa": "شبیه هم بودند", "fr": "se ressemblaient", "id": "mereka (perempuan) saling menyerupai", "tr": "birbirine benzediler", "ur": "ایک دوسرے سے ملتی تھیں"}}, {"arabic": "بُيُوتُ", "target": false, "translation": {"bs": "kuće", "en": "the houses of", "bn": "বাড়িগুলোর", "fa": "خانه‌های", "fr": "les maisons de", "id": "rumah-rumah", "tr": "evleri", "ur": "گھر"}}, {"arabic": "الْحَيِّ", "target": false, "translation": {"bs": "u kvartu", "en": "the quarter", "bn": "মহল্লায়", "fa": "محله", "fr": "dans le quartier", "id": "di kawasan itu", "tr": "mahallede", "ur": "محلے میں"}}]}]}