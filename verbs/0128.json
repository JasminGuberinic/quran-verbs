{"rank": 128, "root": "جوب", "form": 10, "lemma": "اسْتَجابَ", "count": 28, "ayahCount": 27, "share": 0.14, "meaning": {"bs": "odazvati se, uslišati", "en": "to answer, to respond", "tr": "icabet etmek, karşılık vermek", "fr": "répondre, exaucer", "id": "menjawab, memenuhi seruan", "ur": "جواب دینا، قبول کرنا", "bn": "উত্তর দেওয়া, সাড়া দেওয়া", "fa": "پاسخ دادن، اجابت کردن"}, "lemmaSpoken": "audio/547b84fc03d75300cf9b.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "ٱسْتَجَابَ", "plain": "اِسْتَجَابَ", "quran": true, "notUsed": false, "spoken": "audio/547b84fc03d75300cf9b.m4a", "recited": "audio/69db5ca7339fd9c2e05d.m4a", "recitedText": "فَٱسْتَجَابَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَسْتَجِيبُ", "plain": "يَسْتَجِيبُ", "quran": true, "notUsed": false, "spoken": "audio/762b1d6068efd9a72a5e.m4a", "recited": "audio/0278abdeef5a64116ac2.m4a", "recitedText": "يَسْتَجِيبُ"}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "اِسْتَجَبْتُ", "plain": "اِسْتَجَبْتُ", "quran": false, "notUsed": false, "spoken": "audio/51d4f12ae2a794a2be03.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "ٱسْتَجَبْنَا", "plain": "اِسْتَجَبْنَا", "quran": true, "notUsed": false, "spoken": "audio/dde0e2679ee7149c6770.m4a", "recited": "audio/c7e269dbff09cf976821.m4a", "recitedText": "فَٱسْتَجَبْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "اِسْتَجَبْتَ", "plain": "اِسْتَجَبْتَ", "quran": false, "notUsed": false, "spoken": "audio/765f062a324d529d9f70.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "اِسْتَجَبْتِ", "plain": "اِسْتَجَبْتِ", "quran": false, "notUsed": false, "spoken": "audio/5fe2d7402ba1be0e05e4.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "اِسْتَجَبْتُمَا", "plain": "اِسْتَجَبْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/36dcea0917f79d2bd245.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "ٱسْتَجَبْتُمْ", "plain": "اِسْتَجَبْتُمْ", "quran": true, "notUsed": false, "spoken": "audio/f3e8917a35f16c79d35d.m4a", "recited": "audio/6a6af1fdbed8e2d2130e.m4a", "recitedText": "فَٱسْتَجَبْتُمْ"}, {"tense": "past", "pronoun": "antunna", "arabic": "اِسْتَجَبْتُنَّ", "plain": "اِسْتَجَبْتُنَّ", "quran": false, "notUsed": false, "spoken": "audio/82caed8dbed286047c4c.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huwa", "arabic": "ٱسْتَجَابَ", "plain": "اِسْتَجَابَ", "quran": true, "notUsed": false, "spoken": "audio/547b84fc03d75300cf9b.m4a", "recited": "audio/69db5ca7339fd9c2e05d.m4a", "recitedText": "فَٱسْتَجَابَ"}, {"tense": "past", "pronoun": "hiya", "arabic": "اِسْتَجَابَتْ", "plain": "اِسْتَجَابَتْ", "quran": false, "notUsed": false, "spoken": "audio/6acdc07316fcf51e03b8.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huma", "arabic": "اِسْتَجَابَا", "plain": "اِسْتَجَابَا", "quran": false, "notUsed": false, "spoken": "audio/999557855dc8b543a06e.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hum", "arabic": "ٱسْتَجَابُوا۟", "plain": "اِسْتَجَابُوا", "quran": true, "notUsed": false, "spoken": "audio/7ec4cd165d3b2887b562.m4a", "recited": "audio/6a98b22273db382322a2.m4a", "recitedText": "ٱسْتَجَابُوا۟"}, {"tense": "past", "pronoun": "hunna", "arabic": "اِسْتَجَبْنَ", "plain": "اِسْتَجَبْنَ", "quran": false, "notUsed": false, "spoken": "audio/b6dc221fc1adac7bbf5c.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "ana", "arabic": "أَسْتَجِيبُ", "plain": "أَسْتَجِيبُ", "quran": false, "notUsed": false, "spoken": "audio/ced8eb57e9318daa117a.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "nahnu", "arabic": "نَسْتَجِيبُ", "plain": "نَسْتَجِيبُ", "quran": false, "notUsed": false, "spoken": "audio/46f68e162e992bc44934.m4a", "recited": null, "recitedText": null}, {"