{"ayat":[{"ref":"105:1","number":6189,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","hits":[0,1,2,3,4,5]},{"ref":"105:2","number":6190,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ","hits":[1,2,3]},{"ref":"105:3","number":6191,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","hits":[0,1,2]},{"ref":"105:4","number":6192,"text":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ","hits":[0,1,2]},{"ref":"105:5","number":6193,"text":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ","hits":[]}]}