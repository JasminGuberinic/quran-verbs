ll}, {"tense": "present", "pronoun": "hunna", "arabic": "يُقْبِلْنَ", "plain": "يُقْبِلْنَ", "quran": false, "notUsed": false, "spoken": "audio/bb10a6f0dbd0361ad30e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَقْبِلْ", "plain": "أَقْبِلْ", "quran": true, "notUsed": false, "spoken": "audio/bce8a0371edd5e87b7d5.m4a", "recited": "audio/85ab9213f7faa6493855.m4a", "recitedText": "أَقْبِلْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَقْبِلِي", "plain": "أَقْبِلِي", "quran": false, "notUsed": false, "spoken": "audio/f80cfc1e815988a562b0.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَقْبِلَا", "plain": "أَقْبِلَا", "quran": false, "notUsed": false, "spoken": "audio/2b9d42a7f1cb6d9edf5c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَقْبِلُوا", "plain": "أَقْبِلُوا", "quran": false, "notUsed": false, "spoken": "audio/df6979b9d13414ebed26.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَقْبِلْنَ", "plain": "أَقْبِلْنَ", "quran": false, "notUsed": false, "spoken": "audio/412cc898b426853bee40.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "37:27", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3815.mp3", "translation": {"en": {"text": "And some of them draw near unto others, mutually questioning.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, birbirine dönmüş soruşuyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان میں ایک نے دوسرے کی طرف منہ کیا آپس میں پوچھتے ہوئے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sebahagian dan mereka menghadap kepada sebahagian yang lain berbantah-bantahan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَقْبَلَ", "hit": true, "audio": "audio/bbf07f180846f0e3c574.m4a", "gloss": {"en": "and he/it approached", "bs": "i približio se", "tr": "ve yaklaştı", "fr": "et il s'est approché", "id": "dan dia mendekat", "ur": "اور وہ قریب ہوا", "bn": "এবং সে নিকটবর্তী হলো", "fa": "و نزدیک شد"}}, {"text": "بَعْضُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْضٍ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَسَآءَلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:94", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3882.mp3", "translation": {"en": {"text": "And (his people) came toward him, hastening.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine birbirlerine girerek ona yürüdüler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو کافر اس کی طرف جلدی کرتے آئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian kaumnya datang kepadanya dengan bergegas.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَقْبَلُوٓا۟", "hit": true, "audio": "audio/4649cd41a3c8c33b6312.m4a", "gloss": {"bs": "pa su prišli", "en": "so they came forward", "tr": "bunun üzerine yaklaştılar", "fr": "alors ils s'avancèrent", "id": "maka mereka maju", "ur": "پھر وہ آگے آئے", "bn": "তখন তারা এগিয়ে এল", "fa": "پس رو آوردند"}}, {"text": "إِلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَزِفُّونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:82", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1678.mp3", "translation": {"en": {"text": "Ask the township where we were, and the caravan with which we travelled hither. Lo! we speak the truth.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Hem orada bulunduğumuz şehir halkına, hem içinde bulunduğumuz kervana sor. Ve emin ol ki, biz kesinlikle doğru söylüyoruz.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اس بستی سے پوچھ دیکھئے جس میں ہم تھے اور اس قافلہ سے جس میں ہم آئے، اور ہم بیشک سچے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan tanyalah (penduduk) negeri yang kami berada disitu, dan kafilah yang kami datang bersamanya, dan sesungguhnya kami adalah orang-orang yang benar\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَسْـَٔلِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَرْيَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّتِى", "hit": false, "audio": null, "gloss": null}, {"text": "كُنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْعِيرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّتِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَقْبَلْنَا", "hit": true, "audio": "audio/68299509850cda885a0e.m4a", "gloss": {"en": "we approached", "bs": "približili smo se", "tr": "yaklaştık", "fr": "nous nous sommes approchés", "id": "kami telah mendekat", "ur": "ہم قریب ہوئے", "bn": "আমরা নিকটবর্তী হলাম", "fa": "نزدیک شدیم"}}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَصَٰدِقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "51:29", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4704.mp3", "translation": {"en": {"text": "Then his wife came forward, making moan, and smote her face, and cried: A barren old woman!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine karısı (Sâre) bir çığlık atarak geldi ve elini yüzüne vurarak: \"Ben kısır bir kocakarıyım, nasıl çocuğum olur?\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس پر اس کی بی بی چلاتی آئی پھر اپنا ماتھا ٹھونکا اور بولی کیا بڑھیا بانجھ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian isterinya datang memekik lalu menepuk mukanya sendiri seraya berkata: \"(Aku adalah) seorang perempuan tua yang mandul\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَقْبَلَتِ", "hit": true, "audio": "audio/352cfa080579f6f0f3b2.m4a", "gloss": {"en": "so she/it approached", "bs": "pa se približila", "tr": "böylece yaklaştı", "fr": "alors elle s'est approchée", "id": "maka dia telah mendekat", "ur": "پس وہ قریب ہوئی", "bn": "অতএব সে নিকটবর্তী হলো", "fa": "پس نزدیک شد"}}, {"text": "ٱمْرَأَتُهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "صَرَّةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "فَصَكَّتْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَجْهَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَقَالَتْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَجُوزٌ", "hit": false, "audio": null, "gloss": null}, {"text": "عَقِيمٌ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَأَقْبَلَ", "count": 2, "first": "37:27", "audio": "audio/bbf07f180846f0e3c574.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it approached", "bs": "i približio se", "tr": "ve yaklaştı", "fr": "et il s'est approché", "id": "dan dia mendekat", "ur": "اور وہ قریب ہوا", "bn": "এবং সে নিকটবর্তী হলো", "fa": "و نزدیک شد"}}, {"arabic": "فَأَقْبَلَ", "count": 2, "first": "37:50", "audio": "audio/487c3a9ea278e8e9b868.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "so he/it approach