": "budi dobar", "en": "be kind", "bn": "সদয় হও", "fa": "مهربان باش", "fr": "sois bienfaisant !", "id": "berbuat baiklah", "tr": "iyi davran", "ur": "احسان کر"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "prema", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "جَارِكَ", "target": false, "translation": {"bs": "komšiji", "en": "your neighbor", "bn": "তোমার প্রতিবেশী", "fa": "همسایه‌ات", "fr": "envers ton voisin", "id": "tetanggamu", "tr": "komşun", "ur": "تمہارا پڑوسی"}}]}, {"arabic": "يُحْسِنُونَ عَمَلَهُمْ دَائِمًا", "spoken": "audio/1c9ec2d9acc23201d1f3.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Uvijek dobro rade svoj posao.", "en": "They always do their work well.", "bn": "তারা সবসময় তাদের কাজ সুন্দরভাবে করে।", "fa": "همیشه کارشان را نیکو انجام می‌دهند.", "fr": "Ils font toujours bien leur travail.", "id": "Mereka selalu mengerjakan pekerjaan mereka dengan baik.", "tr": "İşlerini her zaman güzel yaparlar.", "ur": "وہ ہمیشہ اپنا کام اچھی طرح کرتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "يُحْسِنُونَ", "target": true, "translation": {"bs": "dobro rade", "en": "they do well", "bn": "তারা সুন্দরভাবে কাজ করে", "fa": "نیکو انجام می‌دهند", "fr": "ils font bien", "id": "mereka berbuat baik", "tr": "güzel yaparlar", "ur": "وہ اچھا کرتے ہیں"}}, {"arabic": "عَمَلَهُمْ", "target": false, "translation": {"bs": "svoj posao", "en": "their work", "bn": "তাদের কাজ", "fa": "کار آنان", "fr": "leur travail", "id": "pekerjaan mereka", "tr": "işleri", "ur": "ان کا کام"}}, {"arabic": "دَائِمًا", "target": false, "translation": {"bs": "uvijek", "en": "always", "bn": "সবসময়", "fa": "همیشه", "fr": "toujours", "id": "selalu", "tr": "her zaman", "ur": "ہمیشہ"}}]}, {"arabic": "أَحْسِنُوا إِلَى الْحَيَوَانَاتِ", "spoken": "audio/932c6b98ca8a719a4b73.m4a", "tense": "imperative", "pronoun": "antum", "translation": {"bs": "Budite dobri prema životinjama.", "en": "Be kind to