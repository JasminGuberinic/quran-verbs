َضَىٰ", "hit": true, "audio": "audio/d50dcef70d4ff353e9ac.m4a", "gloss": {"bs": "i prošao je", "en": "and has gone before", "tr": "ve geçti", "fr": "et est passé", "id": "dan telah berlalu", "ur": "اور گزر چکا ہے", "bn": "এবং অতীত হয়েছে", "fa": "و گذشته است"}}, {"text": "مَثَلُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَوَّلِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "مَضَتْ", "count": 1, "first": "8:38", "audio": "audio/f0e975686d201b48f18e.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"en": "it passed", "bs": "prošla je", "tr": "geçti", "fr": "elle est passée", "id": "dia telah berlalu", "ur": "وہ گزرا", "bn": "তা অতিবাহিত হলো", "fa": "گذشت"}}, {"arabic": "وَٱمْضُوا۟", "count": 1, "first": "15:65", "audio": "audio/b68ca5a5a19deda02f44.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) go on!", "bs": "i idite!", "tr": "ve gidin!", "fr": "et allez !", "id": "dan pergilah kalian!", "ur": "اور آگے بڑھو!", "bn": "এবং যাও!", "fa": "و بروید!"}}, {"arabic": "أَمْضِىَ", "count": 1, "first": "18:60", "audio": "audio/71769fa8a688aeb41269.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "I go on", "bs": "idem", "tr": "giderim", "fr": "j'y vais", "id": "aku pergi", "ur": "میں آگے بڑھتا ہوں", "bn": "আমি যাই", "fa": "می‌روم"}}, {"arabic": "وَمَضَىٰ", "count": 1, "first": "43:8", "audio": "audio/d50dcef70d4ff353e9ac.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "i prošao je", "en": "and has gone before", "tr": "ve önden gitti", "fr": "et il a précédé", "id": "dan dia telah lewat", "ur": "اور وہ آگے بڑھ چکا ہے", "bn": "এবং সে অগ্রগামী হয়েছে", "fa": "و پیشی گرفت"}}], "ayatFile": "ayat/0579.json", "ayatTranslations": {"en": "ayat/0579.en.json", "tr": "ayat/0579.tr.json", "ur": "ayat/0579.ur.json", "id": "ayat/0579.id.json"}, "sentences": [{"arabic": "مَضَى الْوَقْتُ سَرِيعًا", "spoken": "audio/1057d3a4ef959297ccf4.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Vrijeme je brzo prošlo.", "en": "The time passed quickly.", "bn": "সময় দ্রুত পার হয়ে গেছে।", "fa": "زمان به سرعت گذشت.", "fr": "Le temps est passé vite.", "id": "Waktu berlalu dengan cepat.", "tr": "Zaman çabuk geçti.", "ur": "وقت تیزی سے گزر گیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "مَضَى", "target": true, "translation": {"bs": "prošlo je", "en": "passed", "bn": "অতিবাহিত হয়েছে", "fa": "گذشت", "fr": "est passé", "id": "telah berlalu", "tr": "geçti", "ur": "گزرا"}}, {"arabic": "الْوَقْتُ", "target": false, "translation": {"bs": "vrijeme", "en": "the time", "bn": "সময়", "fa": "زمان", "fr": "le temps", "id": "waktu itu", "tr": "zaman", "ur": "وقت"}}, {"arabic": "سَرِيعًا", "target": false, "translation": {"bs": "brzo", "en": "quickly", "bn": "দ্রুত", "fa": "سریع", "fr": "vite", "id": "dengan cepat", "tr": "çabuk", "ur": "جلد"}}]}, {"arabic": "مَضَتْ سَنَةٌ كَامِلَةٌ", "spoken": "audio/c143850ae4576220330e.m4a", "tense": "past", "pronoun": "hiya", "translation": {"bs": "Prošla je cijela godina.", "en": "A full year passed.", "bn": "পুরো একটি বছর পার হয়ে গেছে।", "fa": "یک سال کامل گذشت.", "fr": "Une année entière est passée.", "id": "Satu tahun penuh telah berlalu.", "tr": "Bütün bir yıl geçti.", "ur": "ایک پورا سال گزر گیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "مَضَتْ", "target": true, "translation": {"bs": "prošla je", "en": "passed", "bn": "অতিবাহিত হয়েছে", "fa": "گذشت", "fr": "est passée", "id": "telah berlalu", "tr": "geçti", "ur": "گزری"}}, {"arabic": "سَنَةٌ", "target": false, "translation": {"bs": "godina", "en": "a year", "bn": "এক বছর", "fa": "سال", "fr": "une année", "id": "setahun", "tr": "yıl", "ur": "ایک سال"}}, {"arabic": "كَامِلَةٌ", "target": false, "translation": {"bs": "cijela", "en": "full", 