": "audio/47ca4c6d8fc01caf2eb8.m4a", "recitedText": "يُوَلُّونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يُوَلِّينَ", "plain": "يُوَلِّينَ", "quran": false, "notUsed": false, "spoken": "audio/e40a787589d7aeaab83a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "وَلِّ", "plain": "وَلِّ", "quran": true, "notUsed": false, "spoken": "audio/ae8343a2fd06e56e0f1a.m4a", "recited": "audio/7a5289a9fd4077c6732c.m4a", "recitedText": "فَوَلِّ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "وَلِّي", "plain": "وَلِّي", "quran": false, "notUsed": false, "spoken": "audio/569be65b530bc80743db.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "وَلِّيَا", "plain": "وَلِّيَا", "quran": false, "notUsed": false, "spoken": "audio/f8109c0fdfe3fe5ecf84.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "وَلُّوا۟", "plain": "وَلُّوا", "quran": true, "notUsed": false, "spoken": "audio/cec8503bc184c68238f8.m4a", "recited": "audio/e6b301aafe1611d7650e.m4a", "recitedText": "فَوَلُّوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "وَلِّينَ", "plain": "وَلِّينَ", "quran": false, "notUsed": false, "spoken": "audio/8ad2aa35b256d6f41a0e.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "9:57", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1292.mp3", "translation": {"en": {"text": "Had they but found a refuge, or caverns, or a place to enter, they surely had resorted thither swift as runaways.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer sığınacak bir yer veya barınacak mağaralar veyahut girilecek bir delik bulsalardı başlarını diker o tarafa doğru koşarlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اگر پائیں کوئی پناہ یا غار یا سما جانے کی جگہ تو رسیاں تڑاتے ادھر پھر جائیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Jikalau mereka memperoleh tempat perlindunganmu atau gua-gua atau lobang-lobang (dalam tanah) niscaya mereka pergi kepadanya dengan secepat-cepatnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَجِدُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَلْجَـًٔا", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "مَغَٰرَٰتٍ", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "مُدَّخَلًا", "hit": false, "audio": null, "gloss": null}, {"text": "لَّوَلَّوْا۟", "hit": true, "audio": "audio/e1791c33f2823fd870de.m4a", "gloss": {"bs": "okrenuli bi se", "en": "they would turn", "tr": "dönerlerdi", "fr": "ils se détourneraient", "id": "mereka akan berbalik", "ur": "وہ ضرور پھر جاتے", "bn": "তারা অবশ্যই ফিরে যেত", "fa": "روی می‌گرداندند"}}, {"text": "إِلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَجْمَحُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:57", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2540.mp3", "translation": {"en": {"text": "And, by Allah, I shall circumvent your idols after ye have gone away and turned your backs.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Allah'a yemin ederim ki, siz arkanızı dönüp gittikten sonra, ben putlarınıza elbette bir tuzak kuracağım.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور مجھے اللہ کی قسم ہے میں تمہارے بتوں کا برا چاہوں گا بعد اس کے کہ تم پھر جاؤ پیٹھ دے کر", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Demi Allah, sesungguhnya aku akan melakukan tipu daya terhadap berhala-berhalamu sesudah kamu pergi meninggalkannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَتَٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَأَكِيدَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَصْنَٰمَكُم", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْدَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "تُوَلُّوا۟", "hit": true, "audio": "audio/60da5cb920ced2441761.m4a", "gloss": {"en": "you (all) turn", "bs": "okrećete se", "tr": "dönersiniz", "fr": "que vous vous tourniez", "id": "kalian berpaling", "ur": "تم پھرتے ہو", "bn": "তোমরা ফিরে যাও", "fa": "روی بگردانید"}}, {"text": "مُدْبِرِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "54:45", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4891.mp3", "translation": {"en": {"text": "The hosts will all be routed and will turn and flee.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Her halde o topluluk bozulacak ve geriye dönüp kaçacaklardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اب بھگائی جاتی ہے یہ جماعت اور پیٹھیں پھیردیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Golongan itu pasti akan dikalahkan dan mereka akan mundur ke belakang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "سَيُهْزَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْجَمْعُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيُوَلُّونَ", "hit": true, "audio": "audio/6cc42fd03af96e66455f.m4a", "gloss": {"bs": "i okrenut će", "en": "and they will turn", "tr": "ve dönecekler", "fr": "et ils tourneront le dos", "id": "dan mereka akan berbalik", "ur": "اور وہ پھر جائیں گے", "bn": "এবং তারা ফিরে যাবে", "fa": "و پشت می‌کنند"}}, {"text": "ٱلدُّبُرَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "6:129", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/918.mp3", "translation": {"en": {"text": "Thus We let some of the wrong-doers have power over others because of what they are wont to earn.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte biz böylece, kazandıkları günahlardan dolayı zalimlerin bir kısmını, diğer bir kısmına dost yaparız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یونہی ہم ظالموں میں ایک کو دوسرے پر مسلط کرتے ہیں بدلہ ان کے کیے کا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan demikianlah Kami jadikan sebahagian orang-orang yang zalim itu menjadi teman bagi sebahagian yang lain disebabkan apa yang mereka usahakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَكَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نُوَلِّى", "hit": true, "audio": "audio/98bba519b5f3b8dc5a4d.m4a", "gloss": {"en": "we set over", "bs": "postavljamo", "tr": "görevlendiririz", "fr": "nous établissons", "id": "kami menetapkan", "ur": "ہم نے مقرر کیا", "bn": "আমরা নিয়োগ করি", "fa": "برمی‌گماریم"}}, {"text": "بَعْضَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلظَّٰلِمِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْضًۢا", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَكْسِبُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَلَّوْا۟", "count": 4, "first": "17:46", "audio": "audio/92722b2232eb7900b6a4.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they turned", "bs": "okrenuli su se", "tr": "döndüler", "fr": "ils se sont tournés", "id": "mereka telah berpaling", "ur": "وہ پھرے", "bn": "তারা ফিরল", "fa": "روی گرداندند"}}, {"arabic": "تُوَلُّوا۟", "count": 3, "first": "2:115", "audio": "audio/e38877c85648f52678f1.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}, {"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "you (all) turn", "bs": "okrećete se", "tr": "dönersiniz", "fr": "que vous vous tourniez", "id": "kalian berpaling", "ur": "تم پھرتے ہو", "bn": "তোমরা ফিরে যাও", "fa": "روی بگردانید"}}, {"arabic": "فَوَلِّ", "count": 3, "first": "2:144", "audio": "audio/7a5289a9fd4077c6732c.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "so turn!", "bs": "pa okreni!", "tr": "böylece dön!", "fr": "alors tourne-toi !", "id": "maka berpalinglah!", "ur": "پس پھر!", "bn": "অতএব ফেরো!", "fa": "پس روی بگردان!"}}, {"arabic": "وَلَّىٰ", "count": 3, "first": "27:10", "audio": "audio/c699ce672029ca03ac63.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it turned", "bs": "okrenuo se", "tr": "döndü", "fr": "il s'est tourné", "id": "dia telah berpaling", "ur": "وہ پھرا", "bn": "সে ফিরল", "fa": "روی گرداند"}}, {"arabic": "فَوَلُّوا۟", "count": 2, "first": "2:144", "audio": "audio/e6b301aafe1611d7650e.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) turn!", "bs": "pa okrenite!", "tr": "böylece dönün!", "fr": "alors tournez-vous !", "id": "maka berpalinglah kalian!", "ur": "پس پھرو!", "bn": "অতএব ফিরে যাও!", "fa": "پس روی بگردانید!"}}, {"arabic": "وَلَّىٰهُمْ", "count": 1, "first": "2:142", "audio": "audio/08e10a09833f403faef1.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hum"]}], "gloss": {"en": "he/it turned them", "bs": "okrenuo ih je", "tr": "onları döndürdü", "fr": "il les a tournés", "id": "dia telah memalingkan mereka", "ur": "اُس نے انہیں پھیرا", "bn": "সে তাদের ফিরিয়ে দিল", "fa": "آنان را برگرداند"}}, {"arabic": "فَلَنُوَلِّيَنَّكَ", "count": 1, "first": "2:144", "audio": "audio/a0f7d4c0b3b792158b01.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["anta"], "mood": "indicative"}]}, {"arabic": "يُوَلُّوكُمُ", "count": 1, "first": "3:111", "audio": "audio/64a95c33ce982ade9146.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["antum"], "mood": "jussive"}], "gloss": {"en": "they turn (their backs) to you (all)", "bs": "okreću vam leđa", "tr": "size sırtlarını döndürürler", "fr": "ils vous tournent le dos", "id": "mereka memalingkan punggung kepada kalian", "ur": "وہ تم سے پیٹھ پھیرتے ہیں", "bn": "তারা তোমাদের দিকে পিঠ ফিরিয়ে দেয়", "fa": "به شما پشت کنند"}}, {"arabic": "نُوَلِّهِۦ", "count": 1, "first": "4:115", "audio": "audio/25f23ba5dc96ed42cc1e.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["huwa"], "mood": "jussive"}], "gloss": {"en": "we turn him", "bs": "okrećemo ga", "tr": "onu döndürürüz", "fr": "nous le tournons", "id": "kami memalingkannya", "ur": "ہم اسے پھیرتے ہیں", "bn": "আমরা তাকে ফিরিয়ে দিই", "fa": "او را برمی‌گردانیم"}}, {"arabic": "نُوَلِّى", "count": 1, "first": "6:129", "audio": "audio/98bba519b5f3b8dc5a4d.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "we set over", "bs": "postavljamo", "tr": "görevlendiririz", "fr": "nous établissons", "id": "kami menetapkan", "ur": "ہم نے مقرر کیا", "bn": "আমরা নিয়োগ করি", "fa": "برمی‌گماریم"}}, {"arabic": "تُوَلُّوهُمُ", "count": 1, "first": "8:15", "audio": "audio/4f80fd0547f58edd5050.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": ["hum"], "mood": "jussive"}], "