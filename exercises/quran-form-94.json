[{"id":"zanna-7-171-6","words":["verb:zanna"],"options":[{"bs":"i mislili su","en":"and they thought"},{"bs":"mislimo","en":"we think"},{"bs":"zaista te smatram","en":"surely I think you"},{"bs":"(lica) očekuju","en":"(faces) expect"}],"ref":"7:171","answerWord":"وَظَنُّوٓا۟","answerSound":"audio/2f6e29d0a6d3b275bf39.m4a","quranTranslation":{"text":"And when We shook the Mount above them as it were a covering, and they supposed that it was going to fall upon them (and We said): Hold fast that which We have given you, and remember that which is therein, that ye may ward off (evil).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَإِذْ","نَتَقْنَا","ٱلْجَبَلَ","فَوْقَهُمْ","كَأَنَّهُۥ","ظُلَّةٌ","وَظَنُّوٓا۟","أَنَّهُۥ","وَاقِعٌۢ","بِهِمْ","خُذُوا۟","مَآ","ءَاتَيْنَٰكُم","بِقُوَّةٍ","وَٱذْكُرُوا۟","مَا","فِيهِ","لَعَلَّكُمْ","تَتَّقُونَ"],"marked":[6],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-2-46-1","words":["verb:zanna"],"options":[{"bs":"misle","en":"they think"},{"bs":"i on bude uvjeren","en":"and he is certain"},{"bs":"zaista te smatram","en":"surely I think you"},{"bs":"i mislili su","en":"and they thought"}],"ref":"2:46","answerWord":"يَظُنُّونَ","answerSound":"audio/6291a07a69c212a16057.m4a","quranTranslation":{"text":"Who know that they will have to meet their Lord, and that unto Him they are returning.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["ٱلَّذِينَ","يَظُنُّونَ","أَنَّهُم","مُّلَٰقُوا۟","رَبِّهِمْ","وَأَنَّهُمْ","إِلَيْهِ","رَٰجِعُونَ"],"marked":[1],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-41-22-12","words":["verb:zanna"],"options":[{"bs":"mislili ste","en":"you (all) thought"},{"bs":"misle","en":"they think"},{"bs":"bio sam siguran","en":"I was certain"},{"bs":"misli","en":"he/it thinks"}],"ref":"41:22","answerWord":"ظَنَنتُمْ","answerSound":"audio/9aad0c131732c129e24c.m4a","quranTranslation":{"text":"Ye did not hide yourselves lest your ears and your eyes and your skins should testify against you, but ye deemed that Allah knew not much of what ye did.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَمَا","كُنتُمْ","تَسْتَتِرُونَ","أَن","يَشْهَدَ","عَلَيْكُمْ","سَمْعُكُمْ","وَلَآ","أَبْصَٰرُكُمْ","وَلَا","جُلُودُكُمْ","وَلَٰكِن","ظَنَنتُمْ","أَنَّ","ٱللَّهَ","لَا","يَعْلَمُ","كَثِيرًا","مِّمَّا","تَعْمَلُونَ"],"marked":[12],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-75-28-0","words":["verb:zanna"],"options":[{"bs":"i on bude uvjeren","en":"and he is certain"},{"bs":"zaista te smatram","en":"surely I think you"},{"bs":"mislili ste","en":"you (all) thought"},{"bs":"mislili su","en":"they (two) thought"}],"ref":"75:28","answerWord":"وَظَنَّ","answerSound":"audio/88ac53dc03e2da167984.m4a","quranTranslation":{"text":"And he knoweth that it is the parting;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَظَنَّ","أَنَّهُ","ٱلْفِرَاقُ"],"marked":[0],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-12-42-2","words":["verb:zanna"],"options":[{"bs":"mislio je","en":"he/it thought"},{"bs":"bio sam siguran","en":"I was certain"},{"bs":"mislili ste","en":"you (all) thought"},{"bs":"smatramo vas","en":"we think you (all)"}],"ref":"12:42","answerWord":"ظَنَّ","answerSound":"audio/37bebd0eb747fd99c505.m4a","quranTranslation":{"text":"And he said unto him of the twain who he knew would be released: Mention me in the presence of thy lord. But Satan caused him to forget to mention it to his lord, so he (Joseph) stayed in prison for some years.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَقَالَ","لِلَّذِى","ظَنَّ","أَنَّهُۥ","نَاجٍ","مِّنْهُمَا","ٱذْكُرْنِى","عِندَ","رَبِّكَ","فَأَنسَىٰهُ","ٱلشَّيْطَٰنُ","ذِكْرَ","رَبِّهِۦ","فَلَبِثَ","فِى","ٱلسِّجْنِ","بِضْعَ","سِنِينَ"],"marked":[2],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-18-35-7","words":["verb:zanna"],"options":[{"bs":"mislim","en":"I think"},{"bs":"i bili su sigurni","en":"and they were certain"},{"bs":"zaista ga smatram","en":"surely I think him"},{"bs":"i on bude uvjeren","en":"and he is certain"}],"ref":"18:35","answerWord":"أَظُنُّ","answerSound":"audio/dd1bb37e8d3190656618.m4a","quranTranslation":{"text":"And he went into his garden, while he (thus) wronged himself. He said: I think not that all this will ever perish.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَدَخَلَ","جَنَّتَهُۥ","وَهُوَ","ظَالِمٌ","لِّنَفْسِهِۦ","قَالَ","مَآ","أَظُنُّ","أَن","تَبِيدَ","هَٰذِهِۦٓ","أَبَدًا"],"marked":[7],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-17-52-4","words":["verb:zanna"],"options":[{"bs":"i mislite","en":"and you (all) think"},{"bs":"smatramo te","en":"we think you"},{"bs":"zaista ga smatram","en":"surely I think him"},{"bs":"zaista te smatram","en":"surely I think you"}],"ref":"17:52","answerWord":"وَتَظُنُّونَ","answerSound":"audio/681799c2a66d58c7cf80.m4a","quranTranslation":{"text":"A day when He will call you and ye will answer with His praise, and ye will think that ye have tarried but a little while.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["يَوْمَ","يَدْعُوكُمْ","فَتَسْتَجِيبُونَ","بِحَمْدِهِۦ","وَتَظُنُّونَ","إِن","لَّبِثْتُمْ","إِلَّا","قَلِيلًا"],"marked":[4],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-17-101-15","words":["verb:zanna"],"options":[{"bs":"zaista te smatram","en":"surely I think you"},{"bs":"mislili su","en":"they (two) thought"},{"bs":"(lica) očekuju","en":"(faces) expect"},{"bs":"zaista te smatramo","en":"surely we think you"}],"ref":"17:101","answerWord":"لَأَظُنُّكَ","answerSound":"audio/7d35142b4cd5a3357bed.m4a","quranTranslation":{"text":"And verily We gave unto Moses nine tokens, clear proofs (of Allah's Sovereignty). Do but ask the Children of Israel how he came unto them, then Pharaoh said unto him: Lo! I deem thee one bewitched, O Moses.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَلَقَدْ","ءَاتَيْنَا","مُوسَىٰ","تِسْعَ","ءَايَٰتٍۭ","بَيِّنَٰتٍ","فَسْـَٔلْ","بَنِىٓ","إِسْرَٰٓءِيلَ","إِذْ","جَآءَهُمْ","فَقَالَ","لَهُۥ","فِرْعَوْنُ","إِنِّى","لَأَظُنُّكَ","يَٰمُوسَىٰ","مَسْحُورًا"],"marked":[15],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-22-15-2","words":["verb:zanna"],"options":[{"bs":"misli","en":"he/it thinks"},{"bs":"zaista te smatramo","en":"surely we think you"},{"bs":"mislili ste","en":"you (all) thought"},{"bs":"mislio je","en":"he/it thought"}],"ref":"22:15","answerWord":"يَظُنُّ","answerSound":"audio/9c96c35b8154bbe0e3a6.m4a","quranTranslation":{"text":"Whoso is wont to think (through envy) that Allah will not give him (Muhammad) victory in the world and the Hereafter (and is enraged at the thought of his victory), let him stretch a rope up to the roof (of his dwelling), and let him hang himself. Then let him see whether his strategy dispelleth that whereat he rageth!.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["مَن","كَانَ","يَظُنُّ","أَن","لَّن","يَنصُرَهُ","ٱللَّهُ","فِى","ٱلدُّنْيَا","وَٱلْءَاخِرَةِ","فَلْيَمْدُدْ","بِسَبَبٍ","إِلَى","ٱلسَّمَآءِ","ثُمَّ","لْيَقْطَعْ","فَلْيَنظُرْ","هَلْ","يُذْهِبَنَّ","كَيْدُهُۥ","مَا","يَغِيظُ"],"marked":[2],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-28-38-24","words":["verb:zanna"],"options":[{"bs":"zaista ga smatram","en":"surely I think him"},{"bs":"mislili smo","en":"we thought"},{"bs":"misli","en":"he/it thinks"},{"bs":"zaista te smatramo","en":"surely we think you"}],"ref":"28:38","answerWord":"لَأَظُنُّهُۥ","answerSound":"audio/d798af3171bdcfdeb3e1.m4a","quranTranslation":{"text":"And Pharaoh said: O chiefs! I know not that ye have a god other than me, so kindle for me (a fire), O Haman, to bake the mud; and set up for me a lofty tower in order that I may survey the god of Moses; and lo! I deem him of the liars.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَقَالَ","فِرْعَوْنُ","يَٰٓأَيُّهَا","ٱلْمَلَأُ","مَا","عَلِمْتُ","لَكُم","مِّنْ","إِلَٰهٍ","غَيْرِى","فَأَوْقِدْ","لِى","يَٰهَٰمَٰنُ","عَلَى","ٱلطِّينِ","فَٱجْعَل","لِّى","صَرْحًا","لَّعَلِّىٓ","أَطَّلِعُ","إِلَىٰٓ","إِلَٰهِ","مُوسَىٰ","وَإِنِّى","لَأَظُنُّهُۥ","مِنَ","ٱلْكَٰذِبِينَ"],"marked":[24],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-72-5-1","words":["verb:zanna"],"options":[{"bs":"mislili smo","en":"we thought"},{"bs":"i mislili su","en":"and they thought"},{"bs":"zaista te smatram","en":"surely I think you"},{"bs":"smatramo te","en":"we think you"}],"ref":"72:5","answerWord":"ظَنَنَّآ","answerSound":"audio/1478be51f6070848d07d.m4a","quranTranslation":{"text":"And lo! we had supposed that humankind and jinn would not speak a lie concerning Allah -","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَأَنَّا","ظَنَنَّآ","أَن","لَّن","تَقُولَ","ٱلْإِنسُ","وَٱلْجِنُّ","عَلَى","ٱللَّهِ","كَذِبًا"],"marked":[1],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-2-230-19","words":["verb:zanna"],"options":[{"bs":"mislili su","en":"they (two) thought"},{"bs":"mislili smo","en":"we thought"},{"bs":"i bili su sigurni","en":"and they were certain"},{"bs":"mislimo","en":"we think"}],"ref":"2:230","answerWord":"ظَنَّآ","answerSound":"audio/f407030fae3fe93a4f5d.m4a","quranTranslation":{"text":"And if he hath divorced her (the third time), then she is not lawful unto him thereafter until she hath wedded another husband. Then if he (the other husband) divorce her it is no sin for both of them that they come together again if they consider that they are able to observe the limits of Allah. These are the limits of Allah. He manifesteth them for people who have knowledge.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["فَإِن","طَلَّقَهَا","فَلَا","تَحِلُّ","لَهُۥ","مِنۢ","بَعْدُ","حَتَّىٰ","تَنكِحَ","زَوْجًا","غَيْرَهُۥ","فَإِن","طَلَّقَهَا","فَلَا","جُنَاحَ","عَلَيْهِمَآ","أَن","يَتَرَاجَعَآ","إِن","ظَنَّآ","أَن","يُقِيمَا","حُدُودَ","ٱللَّهِ","وَتِلْكَ","حُدُودُ","ٱللَّهِ","يُبَيِّنُهَا","لِقَوْمٍ","يَعْلَمُونَ"],"marked":[19],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-7-66-11","words":["verb:zanna"],"options":[{"bs":"zaista te smatramo","en":"surely we think you"},{"bs":"mislio je","en":"he/it thought"},{"bs":"i bili su sigurni","en":"and they were certain"},{"bs":"i mislili ste","en":"and you (all) thought"}],"ref":"7:66","answerWord":"لَنَظُنُّكَ","answerSound":"audio/538e50eacbb0b8d2d13c.m4a","quranTranslation":{"text":"The chieftains of his people, who were disbelieving, said: Lo! we surely see thee in foolishness, and lo! we deem thee of the liars.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["قَالَ","ٱلْمَلَأُ","ٱلَّذِينَ","كَفَرُوا۟","مِن","قَوْمِهِۦٓ","إِنَّا","لَنَرَىٰكَ","فِى","سَفَاهَةٍ","وَإِنَّا","لَنَظُنُّكَ","مِنَ","ٱلْكَٰذِبِينَ"],"marked":[11],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-11-27-27","words":["verb:zanna"],"options":[{"bs":"smatramo vas","en":"we think you (all)"},{"bs":"mislili smo","en":"we thought"},{"bs":"misle","en":"they think"},{"bs":"mislili su","en":"they (two) thought"}],"ref":"11:27","answerWord":"نَظُنُّكُمْ","answerSound":"audio/800beddda2a021550120.m4a","quranTranslation":{"text":"The chieftains of his folk, who disbelieved, said: We see thee but a mortal like us, and we see not that any follow thee save the most abject among us, without reflection. We behold in you no merit above us - nay, we deem you liars.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["فَقَالَ","ٱلْمَلَأُ","ٱلَّذِينَ","كَفَرُوا۟","مِن","قَوْمِهِۦ","مَا","نَرَىٰكَ","إِلَّا","بَشَرًا","مِّثْلَنَا","وَمَا","نَرَىٰكَ","ٱتَّبَعَكَ","إِلَّا","ٱلَّذِينَ","هُمْ","أَرَاذِلُنَا","بَادِىَ","ٱلرَّأْىِ","وَمَا","نَرَىٰ","لَكُمْ","عَلَيْنَا","مِن","فَضْلٍۭ","بَلْ","نَظُنُّكُمْ","كَٰذِبِينَ"],"marked":[27],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-18-53-3","words":["verb:zanna"],"options":[{"bs":"pa su bili sigurni","en":"so they were certain"},{"bs":"i mislili ste","en":"and you (all) thought"},{"bs":"mislio je","en":"he/it thought"},{"bs":"bio sam siguran","en":"I was certain"}],"ref":"18:53","answerWord":"فَظَنُّوٓا۟","answerSound":"audio/e16ab6ceb4a2c8e851dc.m4a","quranTranslation":{"text":"And the guilty behold the Fire and know that they are about to fall therein, and they find no way of escape thence.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَرَءَا","ٱلْمُجْرِمُونَ","ٱلنَّارَ","فَظَنُّوٓا۟","أَنَّهُم","مُّوَاقِعُوهَا","وَلَمْ","يَجِدُوا۟","عَنْهَا","مَصْرِفًا"],"marked":[3],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-21-87-5","words":["verb:zanna"],"options":[{"bs":"pa je mislio","en":"so he/it thought"},{"bs":"pa su bili sigurni","en":"so they were certain"},{"bs":"mislili smo","en":"we thought"},{"bs":"bio sam siguran","en":"I was certain"}],"ref":"21:87","answerWord":"فَظَنَّ","answerSound":"audio/283c5a865d218054e1cd.m4a","quranTranslation":{"text":"And (mention) Dhu'n-Nun, when he went off in anger and deemed that We had no power over him, but he cried out in the darkness, saying: There is no Allah save Thee. Be Thou Glorified! Lo! I have been a wrong-doer.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَذَا","ٱلنُّونِ","إِذ","ذَّهَبَ","مُغَٰضِبًا","فَظَنَّ","أَن","لَّن","نَّقْدِرَ","عَلَيْهِ","فَنَادَىٰ","فِى","ٱلظُّلُمَٰتِ","أَن","لَّآ","إِلَٰهَ","إِلَّآ","أَنتَ","سُبْحَٰنَكَ","إِنِّى","كُنتُ","مِنَ","ٱلظَّٰلِمِينَ"],"marked":[5],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-26-186-6","words":["verb:zanna"],"options":[{"bs":"smatramo te","en":"we think you"},{"bs":"i mislili ste","en":"and you (all) thought"},{"bs":"smatramo vas","en":"we think you (all)"},{"bs":"mislili smo","en":"we thought"}],"ref":"26:186","answerWord":"نَّظُنُّكَ","answerSound":"audio/bbbf301be59bca1f612f.m4a","quranTranslation":{"text":"Thou art but a mortal like us, and lo! we deem thee of the liars.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَمَآ","أَنتَ","إِلَّا","بَشَرٌ","مِّثْلُنَا","وَإِن","نَّظُنُّكَ","لَمِنَ","ٱلْكَٰذِبِينَ"],"marked":[6],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-41-23-3","words":["verb:zanna"],"options":[{"bs":"mislili ste","en":"you (all) thought"},{"bs":"pa su bili sigurni","en":"so they were certain"},{"bs":"mislili smo","en":"we thought"},{"bs":"mislio je","en":"he/it thought"}],"ref":"41:23","answerWord":"ظَنَنتُم","answerSound":"audio/3af519ec398f83dbfec8.m4a","quranTranslation":{"text":"That, your thought which ye did think about your Lord, hath ruined you; and ye find yourselves (this day) among the lost.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَذَٰلِكُمْ","ظَنُّكُمُ","ٱلَّذِى","ظَنَنتُم","بِرَبِّكُمْ","أَرْدَىٰكُمْ","فَأَصْبَحْتُم","مِّنَ","ٱلْخَٰسِرِينَ"],"marked":[3],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-41-48-7","words":["verb:zanna"],"options":[{"bs":"i bili su sigurni","en":"and they were certain"},{"bs":"i on bude uvjeren","en":"and he is certain"},{"bs":"i mislili ste","en":"and you (all) thought"},{"bs":"mislili su","en":"they (two) thought"}],"ref":"41:48","answerWord":"وَظَنُّوا۟","answerSound":"audio/10573503fba4b265b055.m4a","quranTranslation":{"text":"And those to whom they used to cry of old have failed them, and they perceive they have no place of refuge.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَضَلَّ","عَنْهُم","مَّا","كَانُوا۟","يَدْعُونَ","مِن","قَبْلُ","وَظَنُّوا۟","مَا","لَهُم","مِّن","مَّحِيصٍ"],"marked":[7],"facts":{"verb":"ظَنَّ"}},{"id":"zanna-45-32-16","words":["verb:zanna"],"options":[{"bs":"mislimo","en":"we think"},{"bs":"mislili su","en":"they (two) thought"},{"bs":"i mislili su","en":"and they thought"},{"bs":"zaista te smatramo","en":"surely we think you"}],"ref":"45:32","answerWord":"نَّظُنُّ","answerSound":"audio/82ab2a6da3b354add0f9.m4a","quranTranslation":{"text":"And when it was said: Lo! Allah's promise is the truth, and there is no doubt of the Hour's coming, ye said: We know not what the Hour is. We deem it naught but a conjecture, and we are by no means convinced.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to assume"},"passage":["وَإِذَا","قِيلَ","إِنَّ","وَعْدَ","ٱللَّهِ","حَقٌّ","وَٱلسَّاعَةُ","لَا","رَيْبَ","فِيهَا","قُلْتُم","مَّا","نَدْرِى","مَا","ٱلسَّاعَةُ","إِن","نَّظُنُّ","إِلَّا","ظَنًّا","وَمَا","نَحْنُ","بِمُسْتَيْقِنِينَ"],"marked":[16],"facts":{"verb":"ظَنَّ"}},{"id":"qadara-13-26-5","words":["verb:qadara"],"options":[{"bs":"i sužava","en":"and he/it restricts"},{"bs":"mogu","en":"they are able"},{"bs":"pa je suzio","en":"so he/it restricted"},{"bs":"određujemo","en":"we decree"}],"ref":"13:26","answerWord":"وَيَقْدِرُ","answerSound":"audio/659bd848557f49dd1635.m4a","quranTranslation":{"text":"Allah enlargeth livelihood for whom He will, and straiteneth (it for whom He will); and they rejoice in the life of the world, whereas the life of the world is but brief comfort as compared with the Hereafter.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"moći, odrediti","en":"to be able, to measure"},"passage":["ٱللَّهُ","يَبْسُطُ","ٱلرِّزْقَ","لِمَن","يَشَآءُ","وَيَقْدِرُ","وَفَرِحُوا۟","بِٱلْحَيَوٰةِ","ٱلدُّنْيَا","وَمَا","ٱلْحَيَوٰةُ","ٱلدُّنْيَا","فِى","ٱلْءَاخِرَةِ","إِلَّا","مَتَٰعٌ"],"marked":[5],"facts":{"verb":"قَدَرَ"}},{"id":"qadara-22-74-1","words":["verb:qadara"],"options":[{"bs":"cijenili su","en":"they appraised"},{"bs":"može","en":"he/it is able"},{"bs":"pa smo odredili","en":"so We measured"},{"bs":"pa je suzio","en":"so he/it restricted"}],"ref":"22:74","answerWord":"قَدَرُوا۟","answerSound":"audio/59a220a714e8ce458201.m4a","quranTranslation":{"text":"They measure not Allah His rightful measure. Lo! Allah is Strong, Almighty.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"moći, odrediti","en":"to be able, to measure"},"passage":["مَا","قَدَرُوا۟","ٱللَّهَ","حَقَّ","قَدْرِهِۦٓ","إِنَّ","ٱللَّهَ","لَقَوِىٌّ","عَزِيزٌ"],"marked":[1],"facts":{"verb":"قَدَرَ"}},{"id":"qadara-16-75-6","words":["verb:qadara"],"options":[{"bs":"može","en":"he/it is able"},{"bs":"određujemo","en":"we decree"},{"bs":"mogu","en":"they are able"},{"bs":"pa je suzio","en":"so he/it restricted"}],"ref":"16:75","answerWord":"يَقْدِرُ","answerSound":"audio/5c927c1f756556db7b73.m4a","quranTranslation":{"text":"Allah coineth a similitude: (on the one hand) a (mere) chattel slave, who hath control of nothing, and (on the other hand) one on whom we have bestowed a fair provision from Us, and he spendeth thereof secretly and openly. Are they equal? Praise be to Allah! But most of them know not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"moći, odrediti","en":"to be able, to measure"},"passage":["ضَرَبَ","ٱللَّهُ","مَثَلًا","عَبْدًا","مَّمْلُوكًا","لَّا","يَقْدِرُ","عَلَىٰ","شَىْءٍ","وَمَن","رَّزَقْنَٰهُ","مِنَّا","رِزْقًا","حَسَنًا","فَهُوَ","يُنفِقُ","مِنْهُ","سِرًّا","وَجَهْرًا","هَلْ","يَسْتَوُۥنَ","ٱلْحَمْدُ","لِلَّهِ","بَلْ","أَكْثَرُهُمْ","لَا","يَعْلَمُونَ"],"marked":[6],"facts":{"verb":"قَدَرَ"}},{"id":"qadara-54-12-8","words":["verb:qadara"],"options":[{"bs":"određeno je","en":"it was decreed"},{"bs":"i sužava","en":"and he/it restricts"},{"bs":"određujemo","en":"we decree"},{"bs":"mogu","en":"they are able"}],"ref":"54:12","answerWord":"قُدِرَ","answerSound":"audio/191bcc867b29c023808f.m4a","quranTranslation":{"text":"And caused the earth to gush forth springs, so that the waters met for a predestined purpose.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"moći, odrediti","en":"to be able, to measure"},"passage":["وَفَجَّرْنَا","ٱلْأَرْضَ","عُيُونًا","فَٱلْتَقَى","ٱلْمَآءُ","عَلَىٰٓ","أَمْرٍ","قَدْ","قُدِرَ"],"marked":[8],"facts":{"verb":"قَدَرَ"}},{"id":"qadara-21-87-8","words":["verb:qadara"],"options":[{"bs":"određujemo","en":"we decree"},{"bs":"određeno je","en":"it was decreed"},{"bs":"može","en":"he/it is able"},{"bs":"pa smo odredili","en":"so We measured"}],"ref":"21:87","answerWord":"نَّقْدِرَ","answerSound":"audio/b142a8cdc40c037e4546.m4a","quranTranslation":{"text":"And (mention) Dhu'n-Nun, when he went off in anger and deemed that We had no power over him, but he cried out in the darkness, saying: There is no Allah save Thee. Be Thou Glorified! Lo! I have been a wrong-doer.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"moći, odrediti","en":"to be able, to measure"},"passage":["وَذَا","ٱلنُّونِ","إِذ","ذَّهَبَ","مُغَٰضِبًا","فَظَنَّ","أَن","لَّن","نَّقْدِرَ","عَلَيْهِ","فَنَادَىٰ","فِى","ٱلظُّلُمَٰتِ","أَن","لَّآ","إِلَٰهَ","إِلَّآ","أَنتَ","سُبْحَٰنَكَ","إِنِّى","كُنتُ","مِنَ","ٱلظَّٰلِمِينَ"],"marked":[8],"facts":{"verb":"قَدَرَ"}},{"id":"qadara-77-23-0","words":["verb:qadara"],"options":[{"bs":"pa smo odredili","en":"so We measured"},{"bs":"mogu","en":"they are able"},{"bs":"može","en":"he/it is able"},{"bs":"određujemo","en":"we decree"}],"ref":"77:23","answerWord":"فَقَدَرْنَا","answerSound":"audio/ad893877dd294f4d40d6.m4a","quranTranslation":{"text":"Thus We arranged. How excellent is Our arranging!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"moći, odrediti","en":"to be able, to measure"},"passage":["فَقَدَرْنَا","فَنِعْمَ","ٱلْقَٰدِرُونَ"],"marked":[0],"facts":{"verb":"قَدَرَ"}},{"id":"qadara-89-16-4","words":["verb:qadara"],"options":[{"bs":"pa je suzio","en":"so he/it restricted"},{"bs":"cijenili su","en":"they appraised"},{"bs":"određujemo","en":"we decree"},{"bs":"i sužava","en":"and he/it restricts"}],"ref":"89:16","answerWord":"فَقَدَرَ","answerSound":"audio/d3f6269219f67b068670.m4a","quranTranslation":{"text":"But whenever He trieth him by straitening his means of life, he saith: My Lord despiseth me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"moći, odrediti","en":"to be able, to measure"},"passage":["وَأَمَّآ","إِذَا","مَا","ٱبْتَلَىٰهُ","فَقَدَرَ","عَلَيْهِ","رِزْقَهُۥ","فَيَقُولُ","رَبِّىٓ","أَهَٰنَنِ"],"marked":[4],"facts":{"verb":"قَدَرَ"}},{"id":"qadara-90-5-3","words":["verb:qadara"],"options":[{"bs":"moći će","en":"he will be able"},{"bs":"cijenili su","en":"they appraised"},{"bs":"određujemo","en":"we decree"},{"bs":"pa je suzio","en":"so he/it restricted"}],"ref":"90:5","answerWord":"يَقْدِرَ","answerSound":"audio/793351b6f64375af23ae.m4a","quranTranslation":{"text":"Thinketh he that none hath power over him?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"moći, odrediti","en":"to be able, to measure"},"passage":["أَيَحْسَبُ","أَن","لَّن","يَقْدِرَ","عَلَيْهِ","أَحَدٌ"],"marked":[3],"facts":{"verb":"قَدَرَ"}}]