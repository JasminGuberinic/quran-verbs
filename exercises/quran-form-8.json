[{"id":"tala-98-2-3","words":["verb:tala"],"options":[{"bs":"uči","en":"he recites"},{"bs":"uče","en":"they recite"},{"bs":"učimo ih","en":"we recite them"},{"bs":"učim","en":"I recite"}],"ref":"98:2","answerWord":"يَتْلُوا۟","answerSound":"audio/0ec96633f2f798ac79f7.m4a","quranTranslation":{"text":"A messenger from Allah, reading purified pages","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["رَسُولٌ","مِّنَ","ٱللَّهِ","يَتْلُوا۟","صُحُفًا","مُّطَهَّرَةً"],"marked":[3],"facts":{"verb":"تَلَا"}},{"id":"tala-26-69-0","words":["verb:tala"],"options":[{"bs":"i kazuj!","en":"and recite!"},{"bs":"učite","en":"you (all) recite"},{"bs":"učimo ih","en":"we recite them"},{"bs":"uči","en":"he recites"}],"ref":"26:69","answerWord":"وَٱتْلُ","answerSound":"audio/e10d5f30ecc95b581759.m4a","quranTranslation":{"text":"Recite unto them the story of Abraham:","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["وَٱتْلُ","عَلَيْهِمْ","نَبَأَ","إِبْرَٰهِيمَ"],"marked":[0],"facts":{"verb":"تَلَا"}},{"id":"tala-2-252-3","words":["verb:tala"],"options":[{"bs":"učimo ih","en":"we recite them"},{"bs":"i kazuj!","en":"and recite!"},{"bs":"učimo","en":"we recite"},{"bs":"učit ću","en":"I will recite"}],"ref":"2:252","answerWord":"نَتْلُوهَا","answerSound":"audio/422a484a7d996e3624c2.m4a","quranTranslation":{"text":"These are the portents of Allah which We recite unto thee (Muhammad) with truth, and lo! thou art of the number of (Our) messengers;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["تِلْكَ","ءَايَٰتُ","ٱللَّهِ","نَتْلُوهَا","عَلَيْكَ","بِٱلْحَقِّ","وَإِنَّكَ","لَمِنَ","ٱلْمُرْسَلِينَ"],"marked":[3],"facts":{"verb":"تَلَا"}},{"id":"tala-3-58-1","words":["verb:tala"],"options":[{"bs":"učimo ga","en":"we recite it"},{"bs":"i uči ga","en":"and he/it recites it"},{"bs":"učio sam ga","en":"I recited it"},{"bs":"učim","en":"I recite"}],"ref":"3:58","answerWord":"نَتْلُوهُ","answerSound":"audio/3c13349b046396e92a94.m4a","quranTranslation":{"text":"This (which) We recite unto thee is a revelation and a wise reminder.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["ذَٰلِكَ","نَتْلُوهُ","عَلَيْكَ","مِنَ","ٱلْءَايَٰتِ","وَٱلذِّكْرِ","ٱلْحَكِيمِ"],"marked":[1],"facts":{"verb":"تَلَا"}},{"id":"tala-3-93-20","words":["verb:tala"],"options":[{"bs":"pa je učite!","en":"so (you all) recite it!"},{"bs":"uče ga","en":"they recite it"},{"bs":"učeno je","en":"it was recited"},{"bs":"(kad) ga slijedi","en":"(when) it follows it"}],"ref":"3:93","answerWord":"فَٱتْلُوهَآ","answerSound":"audio/82721b13289580ca4c93.m4a","quranTranslation":{"text":"All food was lawful unto the Children of Israel, save that which Israel forbade himself, (in days) before the Torah was revealed. Say: Produce the Torah and read it (unto us) if ye are truthful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["كُلُّ","ٱلطَّعَامِ","كَانَ","حِلًّا","لِّبَنِىٓ","إِسْرَٰٓءِيلَ","إِلَّا","مَا","حَرَّمَ","إِسْرَٰٓءِيلُ","عَلَىٰ","نَفْسِهِۦ","مِن","قَبْلِ","أَن","تُنَزَّلَ","ٱلتَّوْرَىٰةُ","قُلْ","فَأْتُوا۟","بِٱلتَّوْرَىٰةِ","فَٱتْلُوهَآ","إِن","كُنتُمْ","صَٰدِقِينَ"],"marked":[20],"facts":{"verb":"تَلَا"}},{"id":"tala-8-2-9","words":["verb:tala"],"options":[{"bs":"učeno je","en":"it was recited"},{"bs":"uči!","en":"recite!"},{"bs":"uče ga","en":"they recite it"},{"bs":"učimo ih","en":"we recite them"}],"ref":"8:2","answerWord":"تُلِيَتْ","answerSound":"audio/e827725cf3f84f155dcb.m4a","quranTranslation":{"text":"They only are the (true) believers whose hearts feel fear when Allah is mentioned, and when His revelations are recited unto them they increase their faith, and who trust in their Lord;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["إِنَّمَا","ٱلْمُؤْمِنُونَ","ٱلَّذِينَ","إِذَا","ذُكِرَ","ٱللَّهُ","وَجِلَتْ","قُلُوبُهُمْ","وَإِذَا","تُلِيَتْ","عَلَيْهِمْ","ءَايَٰتُهُۥ","زَادَتْهُمْ","إِيمَٰنًا","وَعَلَىٰ","رَبِّهِمْ","يَتَوَكَّلُونَ"],"marked":[9],"facts":{"verb":"تَلَا"}},{"id":"tala-10-16-5","words":["verb:tala"],"options":[{"bs":"učio sam ga","en":"I recited it"},{"bs":"uče ga","en":"they recite it"},{"bs":"učeno je","en":"it was recited"},{"bs":"i uči ga","en":"and he/it recites it"}],"ref":"10:16","answerWord":"تَلَوْتُهُۥ","answerSound":"audio/42d35ffa5d192579ee50.m4a","quranTranslation":{"text":"Say: If Allah had so willed I should not have recited it to you nor would He have made it known to you. I dwelt among you a whole lifetime before it (came to me). Have ye then no sense?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["قُل","لَّوْ","شَآءَ","ٱللَّهُ","مَا","تَلَوْتُهُۥ","عَلَيْكُمْ","وَلَآ","أَدْرَىٰكُم","بِهِۦ","فَقَدْ","لَبِثْتُ","فِيكُمْ","عُمُرًا","مِّن","قَبْلِهِۦٓ","أَفَلَا","تَعْقِلُونَ"],"marked":[5],"facts":{"verb":"تَلَا"}},{"id":"tala-18-83-5","words":["verb:tala"],"options":[{"bs":"učit ću","en":"I will recite"},{"bs":"učimo ga","en":"we recite it"},{"bs":"i kazuj!","en":"and recite!"},{"bs":"i uči ga","en":"and he/it recites it"}],"ref":"18:83","answerWord":"سَأَتْلُوا۟","answerSound":"audio/df6b3740703e07800b04.m4a","quranTranslation":{"text":"They will ask thee of Dhu'l-Qarneyn. Say: I shall recite unto you a remembrance of him.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["وَيَسْـَٔلُونَكَ","عَن","ذِى","ٱلْقَرْنَيْنِ","قُلْ","سَأَتْلُوا۟","عَلَيْكُم","مِّنْهُ","ذِكْرًا"],"marked":[5],"facts":{"verb":"تَلَا"}},{"id":"tala-27-92-1","words":["verb:tala"],"options":[{"bs":"učim","en":"I recite"},{"bs":"uči","en":"he recites"},{"bs":"učimo","en":"we recite"},{"bs":"učimo ih","en":"we recite them"}],"ref":"27:92","answerWord":"أَتْلُوَا۟","answerSound":"audio/013327ccba4804b69bbb.m4a","quranTranslation":{"text":"And to recite the Qur'an. And whoso goeth right, goeth right only for (the good of) his own soul; and as for him who goeth astray - (Unto him) say: Lo! I am only a warner.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["وَأَنْ","أَتْلُوَا۟","ٱلْقُرْءَانَ","فَمَنِ","ٱهْتَدَىٰ","فَإِنَّمَا","يَهْتَدِى","لِنَفْسِهِۦ","وَمَن","ضَلَّ","فَقُلْ","إِنَّمَآ","أَنَا۠","مِنَ","ٱلْمُنذِرِينَ"],"marked":[1],"facts":{"verb":"تَلَا"}},{"id":"tala-28-3-0","words":["verb:tala"],"options":[{"bs":"učimo","en":"we recite"},{"bs":"učite","en":"you (all) recite"},{"bs":"i kazuj!","en":"and recite!"},{"bs":"uče","en":"they recite"}],"ref":"28:3","answerWord":"نَتْلُوا۟","answerSound":"audio/0c8f39f4d5d005fdb333.m4a","quranTranslation":{"text":"We narrate unto thee (somewhat) of the story of Moses and Pharaoh with truth, for folk who believe.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["نَتْلُوا۟","عَلَيْكَ","مِن","نَّبَإِ","مُوسَىٰ","وَفِرْعَوْنَ","بِٱلْحَقِّ","لِقَوْمٍ","يُؤْمِنُونَ"],"marked":[0],"facts":{"verb":"تَلَا"}},{"id":"tala-29-45-0","words":["verb:tala"],"options":[{"bs":"uči!","en":"recite!"},{"bs":"učimo ga","en":"we recite it"},{"bs":"uče","en":"they recite"},{"bs":"učim","en":"I recite"}],"ref":"29:45","answerWord":"ٱتْلُ","answerSound":"audio/c73727fbc2b513b29b91.m4a","quranTranslation":{"text":"Recite that which hath been inspired in thee of the Scripture, and establish worship. Lo! worship preserveth from lewdness and iniquity, but verily remembrance of Allah is more important. And Allah knoweth what ye do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["ٱتْلُ","مَآ","أُوحِىَ","إِلَيْكَ","مِنَ","ٱلْكِتَٰبِ","وَأَقِمِ","ٱلصَّلَوٰةَ","إِنَّ","ٱلصَّلَوٰةَ","تَنْهَىٰ","عَنِ","ٱلْفَحْشَآءِ","وَٱلْمُنكَرِ","وَلَذِكْرُ","ٱللَّهِ","أَكْبَرُ","وَٱللَّهُ","يَعْلَمُ","مَا","تَصْنَعُونَ"],"marked":[0],"facts":{"verb":"تَلَا"}},{"id":"tala-91-2-2","words":["verb:tala"],"options":[{"bs":"(kad) ga slijedi","en":"(when) it follows it"},{"bs":"učio sam ga","en":"I recited it"},{"bs":"učimo ih","en":"we recite them"},{"bs":"i kazuj!","en":"and recite!"}],"ref":"91:2","answerWord":"تَلَىٰهَا","answerSound":"audio/05d6f012b1a4c2770891.m4a","quranTranslation":{"text":"And the moon when she followeth him,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"učiti, čitati, slijediti","en":"to recite, to follow"},"passage":["وَٱلْقَمَرِ","إِذَا","تَلَىٰهَا"],"marked":[2],"facts":{"verb":"تَلَا"}},{"id":"arada-2-32-30-0","words":["verb:arada-2"],"options":[{"bs":"pa se okreni","en":"so turn away"},{"bs":"okrenuli ste se","en":"you (all) turned away"},{"bs":"okrećete se","en":"you (all) turn away"},{"bs":"pa su se okrenuli","en":"so they turned away"}],"ref":"32:30","answerWord":"فَأَعْرِضْ","answerSound":"audio/76c9ec6f093af680a600.m4a","quranTranslation":{"text":"So withdraw from them (O Muhammad), and await (the event). Lo! they (also) are awaiting (it).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["فَأَعْرِضْ","عَنْهُمْ","وَٱنتَظِرْ","إِنَّهُم","مُّنتَظِرُونَ"],"marked":[0],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-17-83-4","words":["verb:arada-2"],"options":[{"bs":"okrenuo se","en":"he/it turned away"},{"bs":"pa su se okrenuli","en":"so they turned away"},{"bs":"i okreni se!","en":"and turn away!"},{"bs":"da se okrenete","en":"so that you (all) may turn away"}],"ref":"17:83","answerWord":"أَعْرَضَ","answerSound":"audio/9f5758376dddd58e7027.m4a","quranTranslation":{"text":"And when We make life pleasant unto man, he turneth away and is averse; and when ill toucheth him he is in despair.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["وَإِذَآ","أَنْعَمْنَا","عَلَى","ٱلْإِنسَٰنِ","أَعْرَضَ","وَنَـَٔا","بِجَانِبِهِۦ","وَإِذَا","مَسَّهُ","ٱلشَّرُّ","كَانَ","يَـُٔوسًا"],"marked":[4],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-5-42-9","words":["verb:arada-2"],"options":[{"bs":"okreni se!","en":"turn away!"},{"bs":"okrenuo se","en":"he/it turned away"},{"bs":"da se okrenete","en":"so that you (all) may turn away"},{"bs":"okreću se","en":"they turn away"}],"ref":"5:42","answerWord":"أَعْرِضْ","answerSound":"audio/a287f5f2cd15175c391b.m4a","quranTranslation":{"text":"Listeners for the sake of falsehood! Greedy for illicit gain! If then they have recourse unto thee (Muhammad) judge between them or disclaim jurisdiction. If thou disclaimest jurisdiction, then they cannot harm thee at all. But if thou judgest, judge between them with equity. Lo! Allah loveth the equitable.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["سَمَّٰعُونَ","لِلْكَذِبِ","أَكَّٰلُونَ","لِلسُّحْتِ","فَإِن","جَآءُوكَ","فَٱحْكُم","بَيْنَهُمْ","أَوْ","أَعْرِضْ","عَنْهُمْ","وَإِن","تُعْرِضْ","عَنْهُمْ","فَلَن","يَضُرُّوكَ","شَيْـًٔا","وَإِنْ","حَكَمْتَ","فَٱحْكُم","بَيْنَهُم","بِٱلْقِسْطِ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلْمُقْسِطِينَ"],"marked":[9],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-6-106-10","words":["verb:arada-2"],"options":[{"bs":"i okreni se!","en":"and turn away!"},{"bs":"i okrenuo se","en":"and he/it turned away"},{"bs":"okrećete se","en":"you (all) turn away"},{"bs":"okrenuli ste se","en":"you (all) turned away"}],"ref":"6:106","answerWord":"وَأَعْرِضْ","answerSound":"audio/2de7351c8fa139fb1b70.m4a","quranTranslation":{"text":"Follow that which is inspired in thee from thy Lord; there is no Allah save Him; and turn away from the idolaters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["ٱتَّبِعْ","مَآ","أُوحِىَ","إِلَيْكَ","مِن","رَّبِّكَ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","وَأَعْرِضْ","عَنِ","ٱلْمُشْرِكِينَ"],"marked":[10],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-41-13-1","words":["verb:arada-2"],"options":[{"bs":"okrenuli su se","en":"they turned away"},{"bs":"pa se okrenite!","en":"so (you all) turn away!"},{"bs":"da se okrenete","en":"so that you (all) may turn away"},{"bs":"pa se okreni","en":"so turn away"}],"ref":"41:13","answerWord":"أَعْرَضُوا۟","answerSound":"audio/9eff75815f45abc1b5fd.m4a","quranTranslation":{"text":"But if they turn away, then say: I warn you of a thunderbolt like the thunderbolt (which fell of old upon the tribes) of A'ad and Thamud;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["فَإِنْ","أَعْرَضُوا۟","فَقُلْ","أَنذَرْتُكُمْ","صَٰعِقَةً","مِّثْلَ","صَٰعِقَةِ","عَادٍ","وَثَمُودَ"],"marked":[1],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-4-16-7","words":["verb:arada-2"],"options":[{"bs":"pa se okrenite!","en":"so (you all) turn away!"},{"bs":"okrenuli ste se","en":"you (all) turned away"},{"bs":"okrenuli su se","en":"they turned away"},{"bs":"okreće se","en":"he/it turns away"}],"ref":"4:16","answerWord":"فَأَعْرِضُوا۟","answerSound":"audio/016ce7245cdef92bd188.m4a","quranTranslation":{"text":"And as for the two of you who are guilty thereof, punish them both. And if they repent and improve, then let them be. Lo! Allah is ever relenting, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["وَٱلَّذَانِ","يَأْتِيَٰنِهَا","مِنكُمْ","فَـَٔاذُوهُمَا","فَإِن","تَابَا","وَأَصْلَحَا","فَأَعْرِضُوا۟","عَنْهُمَآ","إِنَّ","ٱللَّهَ","كَانَ","تَوَّابًا","رَّحِيمًا"],"marked":[7],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-41-4-2","words":["verb:arada-2"],"options":[{"bs":"pa su se okrenuli","en":"but turned away"},{"bs":"okreće se","en":"he/it turns away"},{"bs":"i okreni se!","en":"and turn away!"},{"bs":"pa se okrenite!","en":"so (you all) turn away!"}],"ref":"41:4","answerWord":"فَأَعْرَضَ","answerSound":"audio/f956e1399993e463fa41.m4a","quranTranslation":{"text":"Good tidings and a warning. But most of them turn away so that they hear not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["بَشِيرًا","وَنَذِيرًا","فَأَعْرَضَ","أَكْثَرُهُمْ","فَهُمْ","لَا","يَسْمَعُونَ"],"marked":[2],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-9-95-6","words":["verb:arada-2"],"options":[{"bs":"da se okrenete","en":"so that you (all) may turn away"},{"bs":"okrenuo se","en":"he/it turned away"},{"bs":"okrenuli su se","en":"they turned away"},{"bs":"pa se okrenite!","en":"so (you all) turn away!"}],"ref":"9:95","answerWord":"لِتُعْرِضُوا۟","answerSound":"audio/093b0944dd99a6ad0980.m4a","quranTranslation":{"text":"They will swear by Allah unto you, when ye return unto them, that ye may let them be. Let them be, for lo! they are unclean, and their abode is hell as the reward for what they used to earn.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["سَيَحْلِفُونَ","بِٱللَّهِ","لَكُمْ","إِذَا","ٱنقَلَبْتُمْ","إِلَيْهِمْ","لِتُعْرِضُوا۟","عَنْهُمْ","فَأَعْرِضُوا۟","عَنْهُمْ","إِنَّهُمْ","رِجْسٌ","وَمَأْوَىٰهُمْ","جَهَنَّمُ","جَزَآءًۢ","بِمَا","كَانُوا۟","يَكْسِبُونَ"],"marked":[6],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-17-67-14","words":["verb:arada-2"],"options":[{"bs":"okrenuli ste se","en":"you (all) turned away"},{"bs":"pa se okreni","en":"so turn away"},{"bs":"pa su se okrenuli","en":"but turned away"},{"bs":"pa se okrenite!","en":"so (you all) turn away!"}],"ref":"17:67","answerWord":"أَعْرَضْتُمْ","answerSound":"audio/19985062330b00454277.m4a","quranTranslation":{"text":"And when harm toucheth you upon the sea, all unto whom ye cry (for succour) fail save Him (alone), but when He bringeth you safe to land, ye turn away, for man was ever thankless.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["وَإِذَا","مَسَّكُمُ","ٱلضُّرُّ","فِى","ٱلْبَحْرِ","ضَلَّ","مَن","تَدْعُونَ","إِلَّآ","إِيَّاهُ","فَلَمَّا","نَجَّىٰكُمْ","إِلَى","ٱلْبَرِّ","أَعْرَضْتُمْ","وَكَانَ","ٱلْإِنسَٰنُ","كَفُورًا"],"marked":[14],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-34-16-0","words":["verb:arada-2"],"options":[{"bs":"pa su se okrenuli","en":"so they turned away"},{"bs":"okrenuli ste se","en":"you (all) turned away"},{"bs":"i okreni se!","en":"and turn away!"},{"bs":"okrećete se","en":"you (all) turn away"}],"ref":"34:16","answerWord":"فَأَعْرَضُوا۟","answerSound":"audio/8d46d8d94f82a6f4a2ba.m4a","quranTranslation":{"text":"But they were froward, so We sent on them the flood of 'Iram, and in exchange for their two gardens gave them two gardens bearing bitter fruit, the tamarisk and here and there a lote-tree.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["فَأَعْرَضُوا۟","فَأَرْسَلْنَا","عَلَيْهِمْ","سَيْلَ","ٱلْعَرِمِ","وَبَدَّلْنَٰهُم","بِجَنَّتَيْهِمْ","جَنَّتَيْنِ","ذَوَاتَىْ","أُكُلٍ","خَمْطٍ","وَأَثْلٍ","وَشَىْءٍ","مِّن","سِدْرٍ","قَلِيلٍ"],"marked":[0],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-54-2-3","words":["verb:arada-2"],"options":[{"bs":"okreću se","en":"they turn away"},{"bs":"da se okrenete","en":"so that you (all) may turn away"},{"bs":"okrenuo se","en":"he/it turned away"},{"bs":"i okreni se!","en":"and turn away!"}],"ref":"54:2","answerWord":"يُعْرِضُوا۟","answerSound":"audio/f07a226f71f6d3d46628.m4a","quranTranslation":{"text":"And if they behold a portent they turn away and say: Prolonged illusion.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["وَإِن","يَرَوْا۟","ءَايَةً","يُعْرِضُوا۟","وَيَقُولُوا۟","سِحْرٌ","مُّسْتَمِرٌّ"],"marked":[3],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-66-3-15","words":["verb:arada-2"],"options":[{"bs":"i okrenuo se","en":"and he/it turned away"},{"bs":"pa se okrenite!","en":"so (you all) turn away!"},{"bs":"da se okrenete","en":"so that you (all) may turn away"},{"bs":"i okreni se!","en":"and turn away!"}],"ref":"66:3","answerWord":"وَأَعْرَضَ","answerSound":"audio/759391eda67bd412ef65.m4a","quranTranslation":{"text":"When the Prophet confided a fact unto one of his wives and when she afterward divulged it and Allah apprised him thereof, he made known (to her) part thereof and passed over part. And when he told it her she said: Who hath told thee? He said: The Knower, the Aware hath told me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["وَإِذْ","أَسَرَّ","ٱلنَّبِىُّ","إِلَىٰ","بَعْضِ","أَزْوَٰجِهِۦ","حَدِيثًا","فَلَمَّا","نَبَّأَتْ","بِهِۦ","وَأَظْهَرَهُ","ٱللَّهُ","عَلَيْهِ","عَرَّفَ","بَعْضَهُۥ","وَأَعْرَضَ","عَنۢ","بَعْضٍ","فَلَمَّا","نَبَّأَهَا","بِهِۦ","قَالَتْ","مَنْ","أَنۢبَأَكَ","هَٰذَا","قَالَ","نَبَّأَنِىَ","ٱلْعَلِيمُ","ٱلْخَبِيرُ"],"marked":[15],"facts":{"verb":"أَعْرَضَ"}},{"id":"arada-2-72-17-3","words":["verb:arada-2"],"options":[{"bs":"okreće se","en":"he/it turns away"},{"bs":"i okrenuo se","en":"and he/it turned away"},{"bs":"i okreni se!","en":"and turn away!"},{"bs":"okrenuli su se","en":"they turned away"}],"ref":"72:17","answerWord":"يُعْرِضْ","answerSound":"audio/a2d809f21b64387a1dec.m4a","quranTranslation":{"text":"That We may test them thereby, and whoso turneth away from the remembrance of his Lord; He will thrust him into ever-growing torment.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se, odvratiti se","en":"to turn away"},"passage":["لِّنَفْتِنَهُمْ","فِيهِ","وَمَن","يُعْرِضْ","عَن","ذِكْرِ","رَبِّهِۦ","يَسْلُكْهُ","عَذَابًا","صَعَدًا"],"marked":[3],"facts":{"verb":"أَعْرَضَ"}}]