{"rank": 23, "root": "أخذ", "form": 8, "lemma": "اتَّخَذَ", "count": 124, "ayahCount": 118, "share": 0.64, "meaning": {"bs": "uzeti za sebe, prihvatiti", "en": "to take (for oneself)", "tr": "edinmek", "fr": "prendre (pour soi)", "id": "mengambil (bagi diri)", "ur": "بنا لینا، اختیار کرنا", "bn": "(নিজের জন্য) গ্রহণ করা", "fa": "(برای خود) گرفتن، برگزیدن"}, "lemmaSpoken": "audio/bf32f6f6236fbda81b81.m4a", "animation": "<svg class=\"va va-ittakhadha_8\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes ittakhadha_8-a{from{transform:rotate(-10deg)}50%{transform:rotate(-90deg)}}@keyframes ittakhadha_8-h{from,50%{opacity:0}}@keyframes ittakhadha_8-t{from,50%{opacity:1}}.va-ittakhadha_8 .ra{transform:rotate(-30deg);animation:ittakhadha_8-a 1.8s ease-in-out both}.va-ittakhadha_8 .hb{animation:ittakhadha_8-h 1.8s step-end both}.va-ittakhadha_8 .tb{opacity:0;animation:ittakhadha_8-t 1.8s step-end both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-ittakhadha_8.off,.va-ittakhadha_8.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-ittakhadha_8,.va-ittakhadha_8 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><path class=\"p\" d=\"M54 34h20M64 34v27\"/><circle class=\"q tb\" cx=\"61\" cy=\"29.5\" r=\"3.6\"/><g transform=\"translate(44 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><circle class=\"q hb\" cy=\"17\" r=\"3.6\"/><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "ٱتَّخَذَ", "plain": "اِتَّخَذَ", "quran": true, "notUsed": false, "spoken": "audio/bf32f6f6236fbda81b81.m4a", "recited": "audio/bfc129d0ab279725883b.m4a", "recitedText": "ٱتَّخَذَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَتَّخِذُ", "plain": "يَتَّخِذُ", "quran": true, "notUsed": false, "spoken": "audio/336536784a2a25da4a51.m4a", "recited": "audio/d1b99d85f693d51ef813.m4a", "recitedText": "يَتَّخِذُ"}], "nouns": {"verbal_noun": {"lemma": "اتِّخاذ", "count": 1, "spoken": "audio/d6fb8a71e2d19c3ae2c8.m4a"}, "participle": {"lemma": "مُتَّخِذ", "count": 3, "spoken": "audio/ed72d5b1f3aa2abef737.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "ٱتَّخَذْتُ", "plain": "اِتَّخَذْتُ", "quran": true, "notUsed": false, "spoken": "audio/3c8aaf6c0f8e3b8e12d2.m4a", "recited": "audio/3297bf84a1425b91c4b2.m4a", "recitedText": "ٱتَّخَذْتُ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "اِتَّخَذْنَا", "plain": "اِتَّخَذْنَا", "quran": false, "notUsed": false, "spoken": "audio/69e371f3d36d7ceb4bf5.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "تَّخَذْتَ", "plain": "اِتَّخَذْتَ", "quran": true, "notUsed": false, "spoken": "audio/75f1549186f80188e75a.m4a", "recited": "audio/6fb48c6c5876ec892175.m4a", "recitedText": "لَتَّخَذْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "اِتَّخَذْتِ", "plain": "اِتَّخَذْتِ", "quran": false, "notUsed": false, "spoken": "audio/81e1c488a28a8e2edd12.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "اِتَّخَذْتُمَا", "plain": "اِتَّخَذْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/dc0471873f72031babae.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "ٱتَّخَذْتُمُ", "plain": "اِتَّخَذْتُمْ", "quran": true, "notUsed": false, "spoken": "audio/91582c1b6b922760a616.m4a", "recited": "audio/e2412ad23c487a9e7555.m4a", "recitedText": "ٱتَّخَذْتُمُ"}, {"tense": "past", "pronoun": "antunna", "arabic": "اِتَّخَذْتُنَّ", "plain": "اِتَّخَذْتُنَّ", "quran": false, "notUsed": false, "spoken": "audio/ce426bb4c94d98daa3f4.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huwa", "arabic": "ٱتَّخَذَ", "plain": "اِتَّخَذَ", "quran": true, "notUsed": false, "spoken": "audio/bf32f6f6236fbda81b81.m4a", "recited": "audio/bfc129d0ab279725883b.m4a", "recitedText": "ٱتَّخَذَ"}, {"tense": "past", "pronoun": "hiya", "arabic": "ٱتَّخَذَتْ", "plain": "اِتَّخَذَتْ", "quran": true, "notUsed": false, "spoken": "audio/1980708d0d0f45cdf49f.m4a", "recited": "audio/ff54a73a08e0a7d6a3a6.m4a", "recitedText": "ٱتَّخَذَتْ"}, {"tense": "past", "pronoun": "huma", "arabic": "اِتَّخَذَا", "plain": "اِتَّخَذَا", "quran": false, "notUsed": false, "spoken": "audio/f8d81901d386f8365672.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hum", "arabic": "ٱتَّخَذُوا۟", "plain": "اِتَّخَذُوا", "quran": true, "notUsed": false, "spoken": "audio/25d8276a308b613cc966.m4a", "recited": "audio/0e2b45472382032b9e21.m4a", "recitedText": "ٱتَّخَذُوا۟"}, {"tense": "past", "pronoun": "hunna", "arabic": "اِتَّخَذْنَ", "plain": "اِتَّخَذْنَ", "quran": false, "notUsed": false, "spoken": "audio/49ea80e868d18b2ce809.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "ana", "arabic": "أَتَّخِذُ", "plain": "أَتَّخِذُ", "quran": true, "notUsed": false, "spoken": "audio/8acd133494e1a95d708a.m4a", "recited": "audio/f4111c70bdafba1bc7d8.m4a", "recitedText": "أَتَّخِذُ"}, {"tense": "present", "pronoun": "nahnu", "arabic": "نَتَّخِذُ", "plain": "نَتَّخِذُ", "quran": false, "notUsed": false, "spoken": "audio/d97a973b2a5f3609eeba.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "anta", "arabic": "تَتَّخِذُ", "plain": "تَتَّخِذُ", "quran": true, "notUsed": false, "spoken": "audio/30e493771993a9590486.m4a", "recited": "audio/e436d4c1b006b55c7f5c.m4a", "recitedText": "أَتَتَّخِذُ"}, {"tense": "present", "pronoun": "anti", "arabic": "تَتَّخِذِينَ", "plain": "تَتَّخِذِينَ", "quran": false, "notUsed": false, "spoken": "audio/a09c522bbf24c25ce63a.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تَتَّخِذَانِ", "plain": "تَتَّخِذَانِ", "quran": false, "notUsed": false, "spoken": "audio/f5500caa88902104b4a3.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَتَّخِذُونَ", "plain": "تَتَّخِذُونَ", "quran": true, "notUsed": false, "spoken": "audio/8410689d27cff733812e.m4a", "recited": "audio/7f238810e86716b94e51.m4a", "recitedText": "تَتَّخِذُونَ"}, {"tense": "present", "pronoun": "antunna", "arabic": "تَتَّخِذْنَ", "plain": "تَتَّخِذْنَ", "quran": false, "notUsed": false, "spoken": "audio/8b7a6119ccada8e15e76.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَتَّخِذُ", "plain": "يَتَّخِذُ", "quran": true, "notUsed": false, "spoken": "audio/336536784a2a25da4a51.m4a", "recited": "audio/d1b99d85f693d51ef813.m4a", "recitedText": "يَتَّخِذُ"}, {"tense": "present", "pronoun": "hiya", "arabic": "تَتَّخِذُ", "plain": "تَتَّخِذُ", "quran": false, "notUsed": false, "spoken": "audio/30e493771993a9590486.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يَتَّخِذَانِ", "plain": "يَتَّخِذَانِ", "quran": false, "notUsed": false, "spoken": "audio/62e354313975b4e31ccc.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَتَّخِذُونَ", "plain": "يَتَّخِذُونَ", "quran": true, "notUsed": false, "spoken": "audio/1917b8ecbb631bbe5917.m4a", "recited": "audio/6c465899cf7d1bf0c426.m4a", "recitedText": "يَتَّخِذُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَتَّخِذْنَ", "plain": "يَتَّخِذْنَ", "quran": false, "notUsed": false, "spoken": "audio/e5fbfb8e6305c33fab50.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِتَّخِذْ", "plain": "اِتَّخِذْ", "quran": false, "notUsed": false, "spoken": "audio/b97877bd0992cfef7e0b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "ٱتَّخِذِى", "plain": "اِتَّخِذِي", "quran": true, "notUsed": false, "spoken": "audio/31dc2a020cab78797425.m4a", "recited": "audio/f7c3b887df4c38702ae5.m4a", "recitedText": "ٱتَّخِذِى"}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِتَّخِذَا", "plain": "اِتَّخِذَا", "quran": false, "notUsed": false, "spoken": "audio/099d9b2dc5ca5df0345f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱتَّخِذُوا۟", "plain": "اِتَّخِذُوا", "quran": true, "notUsed": false, "spoken": "audio/6403606397acaec539c0.m4a", "recited": "audio/3bea5014751afe54d47c.m4a", "recitedText": "وَٱتَّخِذُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِتَّخِذْنَ", "plain": "اِتَّخِذْنَ", "quran": false, "notUsed": false, "spoken": "audio/7128bb3d131a2bbac605.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "21:21", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2504.mp3", "translation": {"en": {"text": "Or have they chosen gods from the earth who raise the dead?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yoksa (Mekke müşrikleri) birtakım ilâhlar edindiler de yerden ölüleri onlar mı diriltecekler?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا انہوں نے زمین میں سے کچھ ایسے خدا بنالیے ہیں کہ وہ کچھ پیدا کرتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apakah mereka mengambil tuhan-tuhan dari bumi, yang dapat menghidupkan (orang-orang mati)?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱتَّخَذُوٓا۟", "hit": true, "audio": "audio/11385fd9ba64e435d0db.m4a", "gloss": {"en": "they took (for themselves)", "bs": "uzeli su", "tr": "kendileri için aldılar", "fr": "ils ont pris (pour eux)", "id": "mereka telah mengambil", "ur": "انہوں نے (اپنے لیے) لیا", "bn": "তারা নিজেদের জন্য নিল", "fa": "گرفتند"}}, {"text": "ءَالِهَةً", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُنشِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:88", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2338.mp3", "translation": {"en": {"text": "And they say: The Beneficent hath taken unto Himself a son.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Yahudilerle hıristiyanlar) \"Rahmân, çocuk edindi\" dediler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور کافر بولے رحمن نے اولاد اختیار کی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka berkata: \"Tuhan Yang Maha Pemurah mengambil (mempunyai) anak\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱتَّخَذَ", "hit": true, "audio": "audio/bfc129d0ab279725883b.m4a", "gloss": {"bs": "uzeo je (sebi)", "en": "has taken (for Himself)", "tr": "edindi", "fr": "s'est attribué", "id": "mengambil", "ur": "بنا لیا", "bn": "(নিজের জন্য) গ্রহণ করেছেন", "fa": "(برای خود) گرفته است"}}, {"text": "ٱلرَّحْمَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:129", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3061.mp3", "translation": {"en": {"text": "And seek ye out strongholds, that haply ye may last for ever?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Temelli kalacağınızı umarak sağlam yapılar mı edinirsiniz?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور مضبوط محل چنتے ہو اس امید پر کہ تم ہمیشہ رہوگے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan kamu membuat benteng-benteng dengan maksud supaya kamu kekal (di dunia)?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَتَتَّخِذُونَ", "hit": true, "audio": "audio/00109709f23065b6f00f.m4a", "gloss": {"bs": "i pravite sebi", "en": "and you build for yourselves", "tr": "ve edinirsiniz", "fr": "et vous édifiez", "id": "dan kamu membuat", "ur": "اور بناتے ہو", "bn": "এবং তোমরা নিজেদের জন্য নির্মাণ কর", "fa": "و برای خود می‌سازید"}}, {"text": "مَصَانِعَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَخْلُدُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:92", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2342.mp3", "translation": {"en": {"text": "When it is not meet for (the Majesty of) the Beneficent that He should choose a son.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Halbuki Rahmân'a çocuk edinmek yaraşmaz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور رحمن کے لائق نہیں کہ اولاد اختیار کرے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan tidak layak bagi Tuhan Yang Maha Pemurah mengambil (mempunyai) anak.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَنۢبَغِى", "hit": false, "audio": null, "gloss": null}, {"text": "لِلرَّحْمَٰنِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَّخِذَ", "hit": true, "audio": "audio/437bd17ea30c8bfa2db5.m4a", "gloss": {"en": "he/it takes (for himself)", "bs": "uzima", "tr": "kendisi için alır", "fr": "il prend (pour lui)", "id": "dia mengambil", "ur": "وہ (اپنے لیے) لے", "bn": "সে নিজের জন্য নেয়", "fa": "بگیرد"}}, {"text": "وَلَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:110", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2783.mp3", "translation": {"en": {"text": "But ye chose them for a laughing-stock until they caused you to forget remembrance of Me, while ye laughed at them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte siz onları alaya aldınız; sonunda bu davranışınız size beni yâd etmeyi unutturdu; çünkü siz onlara gülüyordunuz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو تم نے انہیں ٹھٹھا بنالیا یہاں تک کہ انہیں بنانے کے شغل میں میری یاد بھول گئے اور تم ان سے ہنسا کرتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Lalu kamu menjadikan mereka buah ejekan, sehingga (kesibukan) kamu mengejek mereka, menjadikan kamu lupa mengingat Aku, dan adalah kamu selalu mentertawakan mereka,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱتَّخَذْتُمُوهُمْ", "hit": true, "audio": "audio/b0a66b3a90ca7a63c13e.m4a", "gloss": {"en": "so you (all) took them", "bs": "pa ste ih uzeli", "tr": "böylece onları aldınız", "fr": "alors vous les avez pris", "id": "maka kalian telah mengambil mereka", "ur": "پس تم سب نے انہیں بنا لیا", "bn": "অতএব তোমরা তাদের নিয়েছ", "fa": "پس آنان را گرفتید"}}, {"text": "سِخْرِيًّا", "hit": false, "audio": null, "gloss": null}, {"text": "حَتَّىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنسَوْكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ذِكْرِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَكُنتُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَضْحَكُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "73:9", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5484.mp3", "translation": {"en": {"text": "Lord of the East and the West; there is no Allah save Him; so choose thou Him alone for thy defender -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O, doğunun ve batının Rabbidir. Ondan başka tanrı yoktur. O halde yalnız O'nu vekil tut.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ پورب کا رب اور پچھم کا رب اس کے سوا کوئی معبود نہیں تو تم اسی کو اپنا کارساز بناؤ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Dialah) Tuhan masyrik dan maghrib, tiada Tuhan (yang berhak disembah) melainkan Dia, maka ambillah Dia sebagai pelindung.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رَّبُّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَشْرِقِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْمَغْرِبِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَٰهَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱتَّخِذْهُ", "hit": true, "audio": "audio/349f41df6f3cb9ddce90.m4a", "gloss": {"bs": "pa Njega uzmi", "en": "so take Him", "tr": "O'nu edin", "fr": "prends-Le donc", "id": "maka jadikanlah Dia", "ur": "تو اسی کو بنا", "bn": "অতএব তাঁকেই গ্রহণ কর", "fa": "پس او را بگیر"}}, {"text": "وَكِيلًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ٱتَّخَذُوا۟", "count": 17, "first": "4:153", "audio": "audio/0e2b45472382032b9e21.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they took (for themselves)", "bs": "uzeli su", "tr": "kendileri için aldılar", "fr": "ils ont pris (pour eux)", "id": "mereka telah mengambil untuk diri mereka", "ur": "انہوں نے (اپنے لیے) لیا", "bn": "তারা নিজেদের জন্য নিল", "fa": "گرفتند"}}, {"arabic": "ٱتَّخَذَ", "count": 15, "first": "2:116", "audio": "audio/bfc129d0ab279725883b.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "uzeo je (sebi)", "en": "has taken (for Himself)", "tr": "edindi", "fr": "s'est attribué", "id": "mengambil", "ur": "بنا لیا", "bn": "(নিজের জন্য) গ্রহণ করেছেন", "fa": "(برای خود) گرفته است"}}, {"arabic": "تَتَّخِذُوا۟", "count": 9, "first": "3:80", "audio": "audio/b112190d08af1864967b.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}, {"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "you (all) take (for yourselves)", "bs": "uzimate", "tr": "kendiniz için alırsınız", "fr": "vous prenez (pour vous)", "id": "kalian mengambil", "ur": "تم سب (اپنے لیے) لو", "bn": "তোমরা নিজেদের জন্য নাও", "fa": "بگیرید"}}, {"arabic": "يَتَّخِذَ", "count": 5, "first": "3:64", "audio": "audio/f7c21920c013f81f33ff.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "he/it takes (for himself)", "bs": "uzima", "tr": "kendisi için alır", "fr": "il prend (pour lui)", "id": "dia mengambil", "ur": "وہ (اپنے لیے) لے", "bn": "সে নিজের জন্য নেয়", "fa": "بگیرد"}}, {"arabic": "تَتَّخِذُوٓا۟", "count": 4, "first": "2:231", "audio": "audio/56cc8fa2a1c255ae27e7.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "you (all) take (for yourselves)", "bs": "uzimate", "tr": "kendiniz için alırsınız", "fr": "vous prenez (pour vous)", "id": "kalian mengambil", "ur": "تم سب لو", "bn": "তোমরা নিজেদের জন্য নাও", "fa": "بگیرید"}}, {"arabic": "وَٱتَّخَذَ", "count": 4, "first": "4:125", "audio": "audio/8e06ba250f25821501b5.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it took (for himself)", "bs": "i uzeo je", "tr": "ve kendisi için aldı", "fr": "et il a pris (pour lui)", "id": "dan dia telah mengambil", "ur": "اور اُس نے (اپنے لیے) لیا", "bn": "এবং সে নিজের জন্য নিল", "fa": "و گرفت"}}, {"arabic": "ٱتَّخَذُوٓا۟", "count": 4, "first": "9:31", "audio": "audio/139299a985c59ec39bef.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they took (for themselves)", "bs": "uzeli su", "tr": "kendileri için aldılar", "fr": "ils ont pris (pour eux)", "id": "mereka telah mengambil", "ur": "انہوں نے (اپنے لیے) لیا", "bn": "তারা নিজেদের জন্য নিল", "fa": "گرفتند"}}, {"arabic": "يَتَّخِذُوا۟", "count": 3, "first": "4:150", "audio": "audio/dcd06f7dbbc8de5b2c9b.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "subjunctive"}, {"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "they take (for themselves)", "bs": "uzimaju", "tr": "kendileri için alırlar", "fr": "ils prennent (pour eux)", "id": "mereka mengambil", "ur": "وہ (اپنے لیے) لیں", "bn": "তারা নিজেদের জন্য নেয়", "fa": "بگیرند"}}, {"arabic": "تَتَّخِذُونَ", "count": 3, "first": "7:74", "audio": "audio/7f238810e86716b94e51.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "you (all) take (for yourselves)", "bs": "uzimate", "tr": "kendiniz için alırsınız", "fr": "vous prenez (pour vous)", "id": "kalian mengambil", "ur": "تم سب (اپنے لیے) لیتے ہو", "bn": "তোমরা নিজেদের জন্য নাও"