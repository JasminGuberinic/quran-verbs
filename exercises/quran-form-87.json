[{"id":"daa-7-55-0","words":["verb:daa"],"options":[{"bs":"dozivajte","en":"call upon"},{"bs":"zovi!","en":"call!"},{"bs":"pripisali su","en":"they ascribed"},{"bs":"zovi ih!","en":"call them!"}],"ref":"7:55","answerWord":"ٱدْعُوا۟","answerSound":"audio/ef737b4b642bb4c36c81.m4a","quranTranslation":{"text":"(O mankind!) Call upon your Lord humbly and in secret. Lo! He loveth not aggressors.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["ٱدْعُوا۟","رَبَّكُمْ","تَضَرُّعًا","وَخُفْيَةً","إِنَّهُۥ","لَا","يُحِبُّ","ٱلْمُعْتَدِينَ"],"marked":[0],"facts":{"verb":"دَعا"}},{"id":"daa-43-49-3","words":["verb:daa"],"options":[{"bs":"zovi!","en":"call!"},{"bs":"zovem","en":"I call"},{"bs":"zvao je","en":"he/it called"},{"bs":"pripisali su","en":"they ascribed"}],"ref":"43:49","answerWord":"ٱدْعُ","answerSound":"audio/a5a6bcbf70a3841d2b35.m4a","quranTranslation":{"text":"And they said: O wizard! Entreat thy Lord for us by the pact that He hath made with thee. Lo! we verily will walk aright.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["وَقَالُوا۟","يَٰٓأَيُّهَ","ٱلسَّاحِرُ","ٱدْعُ","لَنَا","رَبَّكَ","بِمَا","عَهِدَ","عِندَكَ","إِنَّنَا","لَمُهْتَدُونَ"],"marked":[3],"facts":{"verb":"دَعا"}},{"id":"daa-84-11-1","words":["verb:daa"],"options":[{"bs":"zazivat će","en":"he will call for"},{"bs":"i zovete","en":"and you (all) call"},{"bs":"zove ih","en":"he/it calls them"},{"bs":"zovi!","en":"call!"}],"ref":"84:11","answerWord":"يَدْعُوا۟","answerSound":"audio/5963aab28ebaf33ea695.m4a","quranTranslation":{"text":"He surely will invoke destruction","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["فَسَوْفَ","يَدْعُوا۟","ثُبُورًا"],"marked":[1],"facts":{"verb":"دَعا"}},{"id":"daa-2-23-12","words":["verb:daa"],"options":[{"bs":"i zovite!","en":"and (you all) call!"},{"bs":"zvat ćemo","en":"we will call"},{"bs":"zvao nas je","en":"he/it called us"},{"bs":"zove ih","en":"he/it calls them"}],"ref":"2:23","answerWord":"وَٱدْعُوا۟","answerSound":"audio/d8144061663db788d60e.m4a","quranTranslation":{"text":"And if ye are in doubt concerning that which We reveal unto Our slave (Muhammad), then produce a surah of the like thereof, and call your witness beside Allah if ye are truthful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["وَإِن","كُنتُمْ","فِى","رَيْبٍ","مِّمَّا","نَزَّلْنَا","عَلَىٰ","عَبْدِنَا","فَأْتُوا۟","بِسُورَةٍ","مِّن","مِّثْلِهِۦ","وَٱدْعُوا۟","شُهَدَآءَكُم","مِّن","دُونِ","ٱللَّهِ","إِن","كُنتُمْ","صَٰدِقِينَ"],"marked":[12],"facts":{"verb":"دَعا"}},{"id":"daa-3-153-7","words":["verb:daa"],"options":[{"bs":"zove vas","en":"he/it calls you (all)"},{"bs":"zove ih","en":"he/it calls them"},{"bs":"pozivaju se","en":"they are called"},{"bs":"zvani su","en":"they were called"}],"ref":"3:153","answerWord":"يَدْعُوكُمْ","answerSound":"audio/6cf2ce16dd3b3ffbb6cd.m4a","quranTranslation":{"text":"When ye climbed (the hill) and paid no heed to anyone, while the messenger, in your rear, was calling you (to fight). Therefor He rewarded you grief for (his) grief, that (He might teach) you not to sorrow either for that which ye missed or for that which befell you. Allah is Informed of what ye do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["إِذْ","تُصْعِدُونَ","وَلَا","تَلْوُۥنَ","عَلَىٰٓ","أَحَدٍ","وَٱلرَّسُولُ","يَدْعُوكُمْ","فِىٓ","أُخْرَىٰكُمْ","فَأَثَٰبَكُمْ","غَمًّۢا","بِغَمٍّ","لِّكَيْلَا","تَحْزَنُوا۟","عَلَىٰ","مَا","فَاتَكُمْ","وَلَا","مَآ","أَصَٰبَكُمْ","وَٱللَّهُ","خَبِيرٌۢ","بِمَا","تَعْمَلُونَ"],"marked":[7],"facts":{"verb":"دَعا"}},{"id":"daa-19-91-1","words":["verb:daa"],"options":[{"bs":"pripisali su","en":"they ascribed"},{"bs":"zove ga","en":"he/it calls him"},{"bs":"zvao ga je","en":"he/it called him"},{"bs":"zvani ste","en":"you (all) were called"}],"ref":"19:91","answerWord":"دَعَوْا۟","answerSound":"audio/6aaaaad50f5db9b34045.m4a","quranTranslation":{"text":"That ye ascribe unto the Beneficent a son,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["أَن","دَعَوْا۟","لِلرَّحْمَٰنِ","وَلَدًا"],"marked":[1],"facts":{"verb":"دَعا"}},{"id":"daa-3-38-1","words":["verb:daa"],"options":[{"bs":"zvao je","en":"he/it called"},{"bs":"zvani su","en":"they were called"},{"bs":"zvali su","en":"they called"},{"bs":"zove ih","en":"he/it calls them"}],"ref":"3:38","answerWord":"دَعَا","answerSound":"audio/5fbce06aee5e90224bfe.m4a","quranTranslation":{"text":"Then Zachariah prayed unto his Lord and said: My Lord! Bestow upon me of Thy bounty goodly offspring. Lo! Thou art the Hearer of Prayer.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["هُنَالِكَ","دَعَا","زَكَرِيَّا","رَبَّهُۥ","قَالَ","رَبِّ","هَبْ","لِى","مِن","لَّدُنكَ","ذُرِّيَّةً","طَيِّبَةً","إِنَّكَ","سَمِيعُ","ٱلدُّعَآءِ"],"marked":[1],"facts":{"verb":"دَعا"}},{"id":"daa-7-29-9","words":["verb:daa"],"options":[{"bs":"i zovite ga!","en":"and (you all) call him!"},{"bs":"bivate zvani","en":"you (all) are called"},{"bs":"zvali su","en":"they called"},{"bs":"zovi!","en":"call!"}],"ref":"7:29","answerWord":"وَٱدْعُوهُ","answerSound":"audio/71c33c6cd1aa5dcfb763.m4a","quranTranslation":{"text":"Say: My Lord enjoineth justice. And set your faces upright (toward Him) at every place of worship and call upon Him, making religion pure for Him (only). As He brought you into being, so return ye (unto Him).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["قُلْ","أَمَرَ","رَبِّى","بِٱلْقِسْطِ","وَأَقِيمُوا۟","وُجُوهَكُمْ","عِندَ","كُلِّ","مَسْجِدٍ","وَٱدْعُوهُ","مُخْلِصِينَ","لَهُ","ٱلدِّينَ","كَمَا","بَدَأَكُمْ","تَعُودُونَ"],"marked":[9],"facts":{"verb":"دَعا"}},{"id":"daa-7-180-3","words":["verb:daa"],"options":[{"bs":"pa ga zovite!","en":"so (you all) call him!"},{"bs":"zvali su","en":"they (two) called"},{"bs":"zvao sam vas","en":"I called you (all)"},{"bs":"biva pozvan","en":"he/it is called"}],"ref":"7:180","answerWord":"فَٱدْعُوهُ","answerSound":"audio/782a8b3cff0875379d67.m4a","quranTranslation":{"text":"Allah's are the fairest names. Invoke Him by them. And leave the company of those who blaspheme His names. They will be requited what they do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["وَلِلَّهِ","ٱلْأَسْمَآءُ","ٱلْحُسْنَىٰ","فَٱدْعُوهُ","بِهَا","وَذَرُوا۟","ٱلَّذِينَ","يُلْحِدُونَ","فِىٓ","أَسْمَٰٓئِهِۦ","سَيُجْزَوْنَ","مَا","كَانُوا۟","يَعْمَلُونَ"],"marked":[3],"facts":{"verb":"دَعا"}},{"id":"daa-8-24-7","words":["verb:daa"],"options":[{"bs":"zvao vas je","en":"he/it called you (all)"},{"bs":"zar zovete?","en":"do you (all) call?"},{"bs":"zovete me","en":"you (all) call me"},{"bs":"zove vas","en":"he/it calls you (all)"}],"ref":"8:24","answerWord":"دَعَاكُمْ","answerSound":"audio/06a20ad0ce162b7e6237.m4a","quranTranslation":{"text":"O ye who believe! Obey Allah, and the messenger when He calleth you to that which quickeneth you, and know that Allah cometh in between the man and his own heart, and that He it is unto Whom ye will be gathered.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","ٱسْتَجِيبُوا۟","لِلَّهِ","وَلِلرَّسُولِ","إِذَا","دَعَاكُمْ","لِمَا","يُحْيِيكُمْ","وَٱعْلَمُوٓا۟","أَنَّ","ٱللَّهَ","يَحُولُ","بَيْنَ","ٱلْمَرْءِ","وَقَلْبِهِۦ","وَأَنَّهُۥٓ","إِلَيْهِ","تُحْشَرُونَ"],"marked":[7],"facts":{"verb":"دَعا"}},{"id":"daa-10-12-4","words":["verb:daa"],"options":[{"bs":"zvao nas je","en":"he/it called us"},{"bs":"zovete ga","en":"you (all) call him"},{"bs":"i zovem","en":"and I call"},{"bs":"zvao je","en":"he/it called"}],"ref":"10:12","answerWord":"دَعَانَا","answerSound":"audio/b6d76e9fcc6e698fc85d.m4a","quranTranslation":{"text":"And if misfortune touch a man he crieth unto Us, (while reclining) on his side, or sitting or standing, but when We have relieved him of the misfortune he goeth his way as though he had not cried unto Us because of a misfortune that afflicted him. Thus is what they do made (seeming) fair unto the prodigal.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["وَإِذَا","مَسَّ","ٱلْإِنسَٰنَ","ٱلضُّرُّ","دَعَانَا","لِجَنۢبِهِۦٓ","أَوْ","قَاعِدًا","أَوْ","قَآئِمًا","فَلَمَّا","كَشَفْنَا","عَنْهُ","ضُرَّهُۥ","مَرَّ","كَأَن","لَّمْ","يَدْعُنَآ","إِلَىٰ","ضُرٍّ","مَّسَّهُۥ","كَذَٰلِكَ","زُيِّنَ","لِلْمُسْرِفِينَ","مَا","كَانُوا۟","يَعْمَلُونَ"],"marked":[4],"facts":{"verb":"دَعا"}},{"id":"daa-13-36-22","words":["verb:daa"],"options":[{"bs":"zovem","en":"I call"},{"bs":"biva pozvan","en":"he/it is called"},{"bs":"zove nas","en":"he/it calls us"},{"bs":"zovu","en":"they call"}],"ref":"13:36","answerWord":"أَدْعُوا۟","answerSound":"audio/863edacd05a94318474d.m4a","quranTranslation":{"text":"Those unto whom We gave the Scripture rejoice in that which is revealed unto thee. And of the clans there are who deny some of it. Say: I am commanded only that I serve Allah and ascribe unto Him no partner. Unto Him I cry, and unto Him is my return.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["وَٱلَّذِينَ","ءَاتَيْنَٰهُمُ","ٱلْكِتَٰبَ","يَفْرَحُونَ","بِمَآ","أُنزِلَ","إِلَيْكَ","وَمِنَ","ٱلْأَحْزَابِ","مَن","يُنكِرُ","بَعْضَهُۥ","قُلْ","إِنَّمَآ","أُمِرْتُ","أَنْ","أَعْبُدَ","ٱللَّهَ","وَلَآ","أُشْرِكَ","بِهِۦٓ","إِلَيْهِ","أَدْعُوا۟","وَإِلَيْهِ","مَـَٔابِ"],"marked":[22],"facts":{"verb":"دَعا"}},{"id":"daa-16-86-11","words":["verb:daa"],"options":[{"bs":"zovemo","en":"we call"},{"bs":"zovete nas","en":"you (all) call us"},{"bs":"zovete me","en":"you (all) call me"},{"bs":"pripisali su","en":"they ascribed"}],"ref":"16:86","answerWord":"نَدْعُوا۟","answerSound":"audio/f52309325dc3c41b1a34.m4a","quranTranslation":{"text":"And when those who ascribed partners to Allah behold those partners of theirs, they will say: Our Lord! these are our partners unto whom we used to cry instead of Thee. But they will fling to them the saying: Lo! ye verily are liars!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["وَإِذَا","رَءَا","ٱلَّذِينَ","أَشْرَكُوا۟","شُرَكَآءَهُمْ","قَالُوا۟","رَبَّنَا","هَٰٓؤُلَآءِ","شُرَكَآؤُنَا","ٱلَّذِينَ","كُنَّا","نَدْعُوا۟","مِن","دُونِكَ","فَأَلْقَوْا۟","إِلَيْهِمُ","ٱلْقَوْلَ","إِنَّكُمْ","لَكَٰذِبُونَ"],"marked":[11],"facts":{"verb":"دَعا"}},{"id":"daa-18-52-6","words":["verb:daa"],"options":[{"bs":"pa su ih zvali","en":"so they called them"},{"bs":"i zovi!","en":"and call!"},{"bs":"dozivajte","en":"call upon"},{"bs":"zovem","en":"I call"}],"ref":"18:52","answerWord":"فَدَعَوْهُمْ","answerSound":"audio/20b62870baa94f730008.m4a","quranTranslation":{"text":"And (be mindful of) the Day when He will say: Call those partners of Mine whom ye pretended. Then they will cry unto them, but they will not hear their prayer, and We shall set a gulf of doom between them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["وَيَوْمَ","يَقُولُ","نَادُوا۟","شُرَكَآءِىَ","ٱلَّذِينَ","زَعَمْتُمْ","فَدَعَوْهُمْ","فَلَمْ","يَسْتَجِيبُوا۟","لَهُمْ","وَجَعَلْنَا","بَيْنَهُم","مَّوْبِقًا"],"marked":[6],"facts":{"verb":"دَعا"}},{"id":"daa-22-67-10","words":["verb:daa"],"options":[{"bs":"i zovi!","en":"and call!"},{"bs":"zovu me","en":"they call me"},{"bs":"pa ih zovite!","en":"so (you all) call them!"},{"bs":"zvali su","en":"they (two) called"}],"ref":"22:67","answerWord":"وَٱدْعُ","answerSound":"audio/097ab4b51dfc0faa84cf.m4a","quranTranslation":{"text":"Unto each nation have We given sacred rites which they are to perform; so let them not dispute with thee of the matter, but summon thou unto thy Lord. Lo! thou indeed followest right guidance.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["لِّكُلِّ","أُمَّةٍ","جَعَلْنَا","مَنسَكًا","هُمْ","نَاسِكُوهُ","فَلَا","يُنَٰزِعُنَّكَ","فِى","ٱلْأَمْرِ","وَٱدْعُ","إِلَىٰ","رَبِّكَ","إِنَّكَ","لَعَلَىٰ","هُدًى","مُّسْتَقِيمٍ"],"marked":[10],"facts":{"verb":"دَعا"}},{"id":"daa-24-48-1","words":["verb:daa"],"options":[{"bs":"zvani su","en":"they were called"},{"bs":"zovete","en":"you (all) call"},{"bs":"zove ga","en":"he/it calls him"},{"bs":"zovete nas","en":"you (all) call us"}],"ref":"24:48","answerWord":"دُعُوٓا۟","answerSound":"audio/495bbd7be9907649952a.m4a","quranTranslation":{"text":"And when they appeal unto Allah and His messenger to judge between them, lo! a faction of them are averse;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["وَإِذَا","دُعُوٓا۟","إِلَى","ٱللَّهِ","وَرَسُولِهِۦ","لِيَحْكُمَ","بَيْنَهُمْ","إِذَا","فَرِيقٌ","مِّنْهُم","مُّعْرِضُونَ"],"marked":[1],"facts":{"verb":"دَعا"}},{"id":"daa-40-14-0","words":["verb:daa"],"options":[{"bs":"pa zovite!","en":"so (you all) call!"},{"bs":"zovem vas","en":"I call you (all)"},{"bs":"zovemo","en":"we call"},{"bs":"zvao vas je","en":"he/it called you (all)"}],"ref":"40:14","answerWord":"فَٱدْعُوا۟","answerSound":"audio/a746377da7808bd88ccd.m4a","quranTranslation":{"text":"Therefor (O believers) pray unto Allah, making religion pure for Him (only), however much the disbelievers be averse -","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["فَٱدْعُوا۟","ٱللَّهَ","مُخْلِصِينَ","لَهُ","ٱلدِّينَ","وَلَوْ","كَرِهَ","ٱلْكَٰفِرُونَ"],"marked":[0],"facts":{"verb":"دَعا"}},{"id":"daa-40-41-3","words":["verb:daa"],"options":[{"bs":"zovem vas","en":"I call you (all)"},{"bs":"bivate zvani","en":"you (all) are called"},{"bs":"i zovem","en":"and I call"},{"bs":"zar zovemo?","en":"do we call?"}],"ref":"40:41","answerWord":"أَدْعُوكُمْ","answerSound":"audio/8268547a5bf8cf180562.m4a","quranTranslation":{"text":"And, O my people! What aileth me that I call you unto deliverance when ye call me unto the Fire?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["وَيَٰقَوْمِ","مَا","لِىٓ","أَدْعُوكُمْ","إِلَى","ٱلنَّجَوٰةِ","وَتَدْعُونَنِىٓ","إِلَى","ٱلنَّارِ"],"marked":[3],"facts":{"verb":"دَعا"}},{"id":"daa-44-22-0","words":["verb:daa"],"options":[{"bs":"pa je zvao","en":"so he/it called"},{"bs":"bivate zvani","en":"you (all) are called"},{"bs":"zvao sam","en":"I called"},{"bs":"i zovete","en":"and you (all) call"}],"ref":"44:22","answerWord":"فَدَعَا","answerSound":"audio/a2a8d755b2285c8564c0.m4a","quranTranslation":{"text":"And he cried unto his Lord, (saying): These are guilty folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["فَدَعَا","رَبَّهُۥٓ","أَنَّ","هَٰٓؤُلَآءِ","قَوْمٌ","مُّجْرِمُونَ"],"marked":[0],"facts":{"verb":"دَعا"}},{"id":"daa-71-7-2","words":["verb:daa"],"options":[{"bs":"zvao sam ih","en":"I called them"},{"bs":"zvani ste","en":"you (all) were called"},{"bs":"zovem vas","en":"I call you (all)"},{"bs":"zove te","en":"he/it calls you"}],"ref":"71:7","answerWord":"دَعَوْتُهُمْ","answerSound":"audio/2a06776c7543a9352214.m4a","quranTranslation":{"text":"And lo! whenever I call unto them that Thou mayst pardon them they thrust their fingers in their ears and cover themselves with their garments and persist (in their refusal) and magnify themselves in pride.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zvati, moliti","en":"to call, to invoke"},"passage":["وَإِنِّى","كُلَّمَا","دَعَوْتُهُمْ","لِتَغْفِرَ","لَهُمْ","جَعَلُوٓا۟","أَصَٰبِعَهُمْ","فِىٓ","ءَاذَانِهِمْ","وَٱسْتَغْشَوْا۟","ثِيَابَهُمْ","وَأَصَرُّوا۟","وَٱسْتَكْبَرُوا۟","ٱسْتِكْبَارًا"],"marked":[2],"facts":{"verb":"دَعا"}},{"id":"adalla-4-88-16","words":["verb:adalla"],"options":[{"bs":"zavodi","en":"he/it misleads"},{"bs":"zavode","en":"they mislead"},{"bs":"zavode ih","en":"they mislead them"},{"bs":"zaveli su nas","en":"misled us"}],"ref":"4:88","answerWord":"يُضْلِلِ","answerSound":"audio/09ee0aed521e43ef2b56.m4a","quranTranslation":{"text":"What aileth you that ye are become two parties regarding the hypocrites, when Allah cast them back (to disbelief) because of what they earned? Seek ye to guide him whom Allah hath sent astray? He whom Allah sendeth astray, for him thou (O MUhammad) canst not find a road.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["فَمَا","لَكُمْ","فِى","ٱلْمُنَٰفِقِينَ","فِئَتَيْنِ","وَٱللَّهُ","أَرْكَسَهُم","بِمَا","كَسَبُوٓا۟","أَتُرِيدُونَ","أَن","تَهْدُوا۟","مَنْ","أَضَلَّ","ٱللَّهُ","وَمَن","يُضْلِلِ","ٱللَّهُ","فَلَن","تَجِدَ","لَهُۥ","سَبِيلًا"],"marked":[16],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-4-88-13","words":["verb:adalla"],"options":[{"bs":"zaveo je","en":"he/it misled"},{"bs":"da zavedu","en":"so that they may mislead"},{"bs":"zavode ih","en":"they mislead them"},{"bs":"zaveo me je","en":"he/it misled me"}],"ref":"4:88","answerWord":"أَضَلَّ","answerSound":"audio/3a10c6a3acdb51ca6825.m4a","quranTranslation":{"text":"What aileth you that ye are become two parties regarding the hypocrites, when Allah cast them back (to disbelief) because of what they earned? Seek ye to guide him whom Allah hath sent astray? He whom Allah sendeth astray, for him thou (O MUhammad) canst not find a road.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["فَمَا","لَكُمْ","فِى","ٱلْمُنَٰفِقِينَ","فِئَتَيْنِ","وَٱللَّهُ","أَرْكَسَهُم","بِمَا","كَسَبُوٓا۟","أَتُرِيدُونَ","أَن","تَهْدُوا۟","مَنْ","أَضَلَّ","ٱللَّهُ","وَمَن","يُضْلِلِ","ٱللَّهُ","فَلَن","تَجِدَ","لَهُۥ","سَبِيلًا"],"marked":[13],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-7-178-6","words":["verb:adalla"],"options":[{"bs":"(koga) ostavi u zabludi","en":"(whomever) He leaves astray"},{"bs":"zaista nas zavodi","en":"surely he/it misleads us"},{"bs":"zaveli ste","en":"you (all) misled"},{"bs":"zaveo me je","en":"he/it misled me"}],"ref":"7:178","answerWord":"يُضْلِلْ","answerSound":"audio/f859330787eb65aa804b.m4a","quranTranslation":{"text":"He whom Allah leadeth, he indeed is led aright, while he whom Allah sendeth astray - they indeed are losers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["مَن","يَهْدِ","ٱللَّهُ","فَهُوَ","ٱلْمُهْتَدِى","وَمَن","يُضْلِلْ","فَأُو۟لَٰٓئِكَ","هُمُ","ٱلْخَٰسِرُونَ"],"marked":[6],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-9-115-3","words":["verb:adalla"],"options":[{"bs":"da zavede","en":"so that he/it may mislead"},{"bs":"da zavedu","en":"so that they may mislead"},{"bs":"zavode ih","en":"they mislead them"},{"bs":"zavele su","en":"they misled"}],"ref":"9:115","answerWord":"لِيُضِلَّ","answerSound":"audio/68a9024c0e12bbaeb4f4.m4a","quranTranslation":{"text":"It was never Allah's (part) that He should send a folk astray after He had guided them until He had made clear unto them what they should avoid. Lo! Allah is Aware of all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["وَمَا","كَانَ","ٱللَّهُ","لِيُضِلَّ","قَوْمًۢا","بَعْدَ","إِذْ","هَدَىٰهُمْ","حَتَّىٰ","يُبَيِّنَ","لَهُم","مَّا","يَتَّقُونَ","إِنَّ","ٱللَّهَ","بِكُلِّ","شَىْءٍ","عَلِيمٌ"],"marked":[3],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-3-69-8","words":["verb:adalla"],"options":[{"bs":"zavode","en":"they mislead"},{"bs":"pa zavodi","en":"so he/it misleads"},{"bs":"zaveli su nas","en":"they (two) misled us"},{"bs":"zavele su","en":"they misled"}],"ref":"3:69","answerWord":"يُضِلُّونَ","answerSound":"audio/b44c801643c1f25cf850.m4a","quranTranslation":{"text":"A party of the People of the Scripture long to make you go astray; and they make none to go astray except themselves, but they perceive not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["وَدَّت","طَّآئِفَةٌ","مِّنْ","أَهْلِ","ٱلْكِتَٰبِ","لَوْ","يُضِلُّونَكُمْ","وَمَا","يُضِلُّونَ","إِلَّآ","أَنفُسَهُمْ","وَمَا","يَشْعُرُونَ"],"marked":[8],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-20-79-0","words":["verb:adalla"],"options":[{"bs":"i zaveo je","en":"and he/it misled"},{"bs":"zaista zavode","en":"surely they mislead"},{"bs":"i zavodi","en":"and he/it misleads"},{"bs":"zaveli su nas","en":"they misled us"}],"ref":"20:79","answerWord":"وَأَضَلَّ","answerSound":"audio/aab050813f69ae9924e4.m4a","quranTranslation":{"text":"And Pharaoh led his folk astray, he did not guide them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["وَأَضَلَّ","فِرْعَوْنُ","قَوْمَهُۥ","وَمَا","هَدَىٰ"],"marked":[0],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-3-69-6","words":["verb:adalla"],"options":[{"bs":"zavode vas","en":"they mislead you (all)"},{"bs":"zavodi ga","en":"he/it misleads him"},{"bs":"zavode ih","en":"they mislead them"},{"bs":"i zaveo ga je","en":"and he/it misled him"}],"ref":"3:69","answerWord":"يُضِلُّونَكُمْ","answerSound":"audio/45db6da61fe6ba3dc6a0.m4a","quranTranslation":{"text":"A party of the People of the Scripture long to make you go astray; and they make none to go astray except themselves, but they perceive not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["وَدَّت","طَّآئِفَةٌ","مِّنْ","أَهْلِ","ٱلْكِتَٰبِ","لَوْ","يُضِلُّونَكُمْ","وَمَا","يُضِلُّونَ","إِلَّآ","أَنفُسَهُمْ","وَمَا","يَشْعُرُونَ"],"marked":[6],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-4-60-27","words":["verb:adalla"],"options":[{"bs":"zavodi ih","en":"he/it misleads them"},{"bs":"zavode vas","en":"they mislead you (all)"},{"bs":"zavode ih","en":"they mislead them"},{"bs":"da zavedu","en":"so that they may mislead"}],"ref":"4:60","answerWord":"يُضِلَّهُمْ","answerSound":"audio/a5c087c7e7c5efd4fa54.m4a","quranTranslation":{"text":"Hast thou not seen those who pretend that they believe in that which is revealed unto thee and that which was revealed before thee, how they would go for judgment (in their disputes) to false deities when they have been ordered to abjure them? Satan would mislead them far astray.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["أَلَمْ","تَرَ","إِلَى","ٱلَّذِينَ","يَزْعُمُونَ","أَنَّهُمْ","ءَامَنُوا۟","بِمَآ","أُنزِلَ","إِلَيْكَ","وَمَآ","أُنزِلَ","مِن","قَبْلِكَ","يُرِيدُونَ","أَن","يَتَحَاكَمُوٓا۟","إِلَى","ٱلطَّٰغُوتِ","وَقَدْ","أُمِرُوٓا۟","أَن","يَكْفُرُوا۟","بِهِۦ","وَيُرِيدُ","ٱلشَّيْطَٰنُ","أَن","يُضِلَّهُمْ","ضَلَٰلًۢا","بَعِيدًا"],"marked":[27],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-5-77-17","words":["verb:adalla"],"options":[{"bs":"i zaveli su","en":"and they misled"},{"bs":"zavodi ga","en":"he/it misleads him"},{"bs":"zaveo je","en":"he/it misled"},{"bs":"zavode ih","en":"they mislead them"}],"ref":"5:77","answerWord":"وَأَضَلُّوا۟","answerSound":"audio/25e286c4b351ee72cda7.m4a","quranTranslation":{"text":"Say: O People of the Scripture! Stress not in your religion other than the truth, and follow not the vain desires of folk who erred of old and led many astray, and erred from a plain road.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["قُلْ","يَٰٓأَهْلَ","ٱلْكِتَٰبِ","لَا","تَغْلُوا۟","فِى","دِينِكُمْ","غَيْرَ","ٱلْحَقِّ","وَلَا","تَتَّبِعُوٓا۟","أَهْوَآءَ","قَوْمٍ","قَدْ","ضَلُّوا۟","مِن","قَبْلُ","وَأَضَلُّوا۟","كَثِيرًا","وَضَلُّوا۟","عَن","سَوَآءِ","ٱلسَّبِيلِ"],"marked":[17],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-6-39-10","words":["verb:adalla"],"options":[{"bs":"zavodi ga","en":"he/it misleads him"},{"bs":"zaveo me je","en":"he/it misled me"},{"bs":"zaveli ste","en":"you (all) misled"},{"bs":"pa zavodi","en":"so he/it misleads"}],"ref":"6:39","answerWord":"يُضْلِلْهُ","answerSound":"audio/f621c46e064fa1a6416b.m4a","quranTranslation":{"text":"Those who deny Our revelations are deaf and dumb in darkness. Whom Allah will sendeth astray, and whom He will He placeth on a straight path.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["وَٱلَّذِينَ","كَذَّبُوا۟","بِـَٔايَٰتِنَا","صُمٌّ","وَبُكْمٌ","فِى","ٱلظُّلُمَٰتِ","مَن","يَشَإِ","ٱللَّهُ","يُضْلِلْهُ","وَمَن","يَشَأْ","يَجْعَلْهُ","عَلَىٰ","صِرَٰطٍ","مُّسْتَقِيمٍ"],"marked":[10],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-6-119-21","words":["verb:adalla"],"options":[{"bs":"zaista zavode","en":"surely they mislead"},{"bs":"zaveo me je","en":"he/it misled me"},{"bs":"zavode vas","en":"they mislead you (all)"},{"bs":"zavodi","en":"he/it misleads"}],"ref":"6:119","answerWord":"لَّيُضِلُّونَ","answerSound":"audio/b18e52a0b4a6ba72d335.m4a","quranTranslation":{"text":"How should ye not eat of that over which the name of Allah hath been mentioned, when He hath explained unto you that which is forbidden unto you unless ye are compelled thereto. But lo! many are led astray by their own lusts through ignorance. Lo! thy Lord, He is Best Aware of the transgressors.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["وَمَا","لَكُمْ","أَلَّا","تَأْكُلُوا۟","مِمَّا","ذُكِرَ","ٱسْمُ","ٱللَّهِ","عَلَيْهِ","وَقَدْ","فَصَّلَ","لَكُم","مَّا","حَرَّمَ","عَلَيْكُمْ","إِلَّا","مَا","ٱضْطُرِرْتُمْ","إِلَيْهِ","وَإِنَّ","كَثِيرًا","لَّيُضِلُّونَ","بِأَهْوَآئِهِم","بِغَيْرِ","عِلْمٍ","إِنَّ","رَبَّكَ","هُوَ","أَعْلَمُ","بِٱلْمُعْتَدِينَ"],"marked":[21],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-6-125-11","words":["verb:adalla"],"options":[{"bs":"zavodi ga","en":"he/it misleads him"},{"bs":"zaista nas zavodi","en":"surely he/it misleads us"},{"bs":"zaveli su nas","en":"they misled us"},{"bs":"zavodi","en":"he/it misleads"}],"ref":"6:125","answerWord":"يُضِلَّهُۥ","answerSound":"audio/6ffcf9f12e51ecb7c68f.m4a","quranTranslation":{"text":"And whomsoever it is Allah's will to guide, He expandeth his bosom unto the Surrender, and whomsoever it is His Will to send astray, He maketh his bosom close and narrow as if he were engaged in sheer ascent. Thus Allah layeth ignominy upon those who believe not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["فَمَن","يُرِدِ","ٱللَّهُ","أَن","يَهْدِيَهُۥ","يَشْرَحْ","صَدْرَهُۥ","لِلْإِسْلَٰمِ","وَمَن","يُرِدْ","أَن","يُضِلَّهُۥ","يَجْعَلْ","صَدْرَهُۥ","ضَيِّقًا","حَرَجًا","كَأَنَّمَا","يَصَّعَّدُ","فِى","ٱلسَّمَآءِ","كَذَٰلِكَ","يَجْعَلُ","ٱللَّهُ","ٱلرِّجْسَ","عَلَى","ٱلَّذِينَ","لَا","يُؤْمِنُونَ"],"marked":[11],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-10-88-13","words":["verb:adalla"],"options":[{"bs":"da zavedu","en":"so that they may mislead"},{"bs":"i zaveo ga je","en":"and he/it misled him"},{"bs":"zaveo je","en":"he/it misled"},{"bs":"zavode ih","en":"they mislead them"}],"ref":"10:88","answerWord":"لِيُضِلُّوا۟","answerSound":"audio/2e2d9c865b6b392dee33.m4a","quranTranslation":{"text":"And Moses said: Our Lord! Lo! Thou hast given Pharaoh and his chiefs splendour and riches in the life of the world, Our Lord! that they may lead men astray from Thy way. Our Lord! Destroy their riches and harden their hearts so that they believe not till they see the painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["وَقَالَ","مُوسَىٰ","رَبَّنَآ","إِنَّكَ","ءَاتَيْتَ","فِرْعَوْنَ","وَمَلَأَهُۥ","زِينَةً","وَأَمْوَٰلًا","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","رَبَّنَا","لِيُضِلُّوا۟","عَن","سَبِيلِكَ","رَبَّنَا","ٱطْمِسْ","عَلَىٰٓ","أَمْوَٰلِهِمْ","وَٱشْدُدْ","عَلَىٰ","قُلُوبِهِمْ","فَلَا","يُؤْمِنُوا۟","حَتَّىٰ","يَرَوُا۟","ٱلْعَذَابَ","ٱلْأَلِيمَ"],"marked":[13],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-14-4-9","words":["verb:adalla"],"options":[{"bs":"pa zavodi","en":"so he/it misleads"},{"bs":"zavodi ih","en":"he/it misleads them"},{"bs":"zavodi ga","en":"he/it misleads him"},{"bs":"i zaveo ih je","en":"and he/it misled them"}],"ref":"14:4","answerWord":"فَيُضِلُّ","answerSound":"audio/c1fbce670f2325a0ba9a.m4a","quranTranslation":{"text":"And We never sent a messenger save with the language of his folk, that he might make (the message) clear for them. Then Allah sendeth whom He will astray, and guideth whom He will. He is the Mighty, the Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["وَمَآ","أَرْسَلْنَا","مِن","رَّسُولٍ","إِلَّا","بِلِسَانِ","قَوْمِهِۦ","لِيُبَيِّنَ","لَهُمْ","فَيُضِلُّ","ٱللَّهُ","مَن","يَشَآءُ","وَيَهْدِى","مَن","يَشَآءُ","وَهُوَ","ٱلْعَزِيزُ","ٱلْحَكِيمُ"],"marked":[9],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-14-27-11","words":["verb:adalla"],"options":[{"bs":"i zavodi","en":"and he/it misleads"},{"bs":"zaveo me je","en":"he/it misled me"},{"bs":"zavode vas","en":"they mislead you (all)"},{"bs":"i zaveo ga je","en":"and he/it misled him"}],"ref":"14:27","answerWord":"وَيُضِلُّ","answerSound":"audio/4621657ec068e58d8c86.m4a","quranTranslation":{"text":"Allah confirmeth those who believe by a firm saying in the life of the world and in the Hereafter, and Allah sendeth wrong-doers astray. And Allah doeth what He will.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["يُثَبِّتُ","ٱللَّهُ","ٱلَّذِينَ","ءَامَنُوا۟","بِٱلْقَوْلِ","ٱلثَّابِتِ","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","وَفِى","ٱلْءَاخِرَةِ","وَيُضِلُّ","ٱللَّهُ","ٱلظَّٰلِمِينَ","وَيَفْعَلُ","ٱللَّهُ","مَا","يَشَآءُ"],"marked":[11],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-14-30-3","words":["verb:adalla"],"options":[{"bs":"da zavedu","en":"so that they may mislead"},{"bs":"zaveli su nas","en":"they misled us"},{"bs":"zavodi ga","en":"he/it misleads him"},{"bs":"pa zavodi","en":"so he/it misleads"}],"ref":"14:30","answerWord":"لِّيُضِلُّوا۟","answerSound":"audio/abd3623ebeb4973e601e.m4a","quranTranslation":{"text":"And they set up rivals to Allah that they may mislead (men) from His way. Say: Enjoy life (while ye may) for lo! your journey's end will be the Fire.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["وَجَعَلُوا۟","لِلَّهِ","أَندَادًا","لِّيُضِلُّوا۟","عَن","سَبِيلِهِۦ","قُلْ","تَمَتَّعُوا۟","فَإِنَّ","مَصِيرَكُمْ","إِلَى","ٱلنَّارِ"],"marked":[3],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-14-36-2","words":["verb:adalla"],"options":[{"bs":"zavele su","en":"they misled"},{"bs":"da zavede","en":"so that he/it may mislead"},{"bs":"zaista nas zavodi","en":"surely he/it misleads us"},{"bs":"zavodi ga","en":"he/it misleads him"}],"ref":"14:36","answerWord":"أَضْلَلْنَ","answerSound":"audio/108d859791ce3ea3d4b4.m4a","quranTranslation":{"text":"My Lord! Lo! they have led many of mankind astray. But whoso followeth me, he verily is of me. And whoso disobeyeth me - Still Thou art Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["رَبِّ","إِنَّهُنَّ","أَضْلَلْنَ","كَثِيرًا","مِّنَ","ٱلنَّاسِ","فَمَن","تَبِعَنِى","فَإِنَّهُۥ","مِنِّى","وَمَنْ","عَصَانِى","فَإِنَّكَ","غَفُورٌ","رَّحِيمٌ"],"marked":[2],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-16-25-8","words":["verb:adalla"],"options":[{"bs":"zavode ih","en":"they mislead them"},{"bs":"i zaveo ga je","en":"and he/it misled him"},{"bs":"zaveli su nas","en":"misled us"},{"bs":"zaveli ste","en":"you (all) misled"}],"ref":"16:25","answerWord":"يُضِلُّونَهُم","answerSound":"audio/7b6383a5d46ca528f505.m4a","quranTranslation":{"text":"That they may bear their burdens undiminished on the Day of Resurrection, with somewhat of the burdens of those whom they mislead without knowledge. Ah! evil is that which they bear!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["لِيَحْمِلُوٓا۟","أَوْزَارَهُمْ","كَامِلَةً","يَوْمَ","ٱلْقِيَٰمَةِ","وَمِنْ","أَوْزَارِ","ٱلَّذِينَ","يُضِلُّونَهُم","بِغَيْرِ","عِلْمٍ","أَلَا","سَآءَ","مَا","يَزِرُونَ"],"marked":[8],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-20-85-7","words":["verb:adalla"],"options":[{"bs":"i zaveo ih je","en":"and he/it misled them"},{"bs":"(koga) ostavi u zabludi","en":"(whomever) He leaves astray"},{"bs":"zaista zavode","en":"surely they mislead"},{"bs":"zaveli su","en":"they misled"}],"ref":"20:85","answerWord":"وَأَضَلَّهُمُ","answerSound":"audio/fabad7dc9b7ccdb57f20.m4a","quranTranslation":{"text":"He said: Lo! We have tried thy folk in thine absence, and As-Samiri hath misled them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["قَالَ","فَإِنَّا","قَدْ","فَتَنَّا","قَوْمَكَ","مِنۢ","بَعْدِكَ","وَأَضَلَّهُمُ","ٱلسَّامِرِىُّ"],"marked":[7],"facts":{"verb":"أَضَلَّ"}},{"id":"adalla-22-4-6","words":["verb:adalla"],"options":[{"bs":"zavodi ga","en":"he/it misleads him"},{"bs":"da zavedu","en":"so that they may mislead"},{"bs":"zavodi ih","en":"he/it misleads them"},{"bs":"i zaveo ih je","en":"and he/it misled them"}],"ref":"22:4","answerWord":"يُضِلُّهُۥ","answerSound":"audio/8d9493a59d84e62e19f3.m4a","quranTranslation":{"text":"For him it is decreed that whoso taketh him for friend, he verily will mislead him and will guide him to the punishment of the Flame.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zavesti, odvesti u zabludu","en":"to mislead, to lead astray"},"passage":["كُتِبَ","عَلَيْهِ","أَنَّهُۥ","مَن","تَوَلَّاهُ","فَأَنَّهُۥ","يُضِلُّهُۥ","وَيَهْدِيهِ","إِلَىٰ","عَذَابِ","ٱلسَّعِيرِ"],"marked":[6],"facts":{"verb":"أَضَلَّ"}}]