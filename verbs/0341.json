blessed", "tr": "mübarek kıldık", "fr": "Nous avons béni", "id": "Kami memberkahi", "ur": "ہم نے برکت دی", "bn": "আমরা বরকত দিয়েছি", "fa": "برکت دادیم"}}, {"arabic": "بُورِكَ", "count": 1, "first": "27:8", "audio": "audio/a5076376e72b06d4e92b.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "he/it was blessed", "bs": "blagoslovljen je", "tr": "bereketlendi", "fr": "il a été béni", "id": "dia telah diberkahi", "ur": "وہ برکت دیا گیا", "bn": "সে বরকতপ্রাপ্ত হয়েছে", "fa": "برکت داده شد"}}, {"arabic": "وَبَٰرَكْنَا", "count": 1, "first": "37:113", "audio": "audio/0f07ba3d7fd8b9608271.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "and we blessed", "bs": "i blagoslovili smo", "tr": "ve bereketlendirdik", "fr": "et nous avons béni", "id": "dan kami telah memberkahi", "ur": "اور ہم نے برکت دی", "bn": "এবং আমরা বরকত দিয়েছি", "fa": "و برکت دادیم"}}, {"arabic": "وَبَٰرَكَ", "count": 1, "first": "41:10", "audio": "audio/7173d569147e1c68db91.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it blessed", "bs": "i blagoslovio je", "tr": "ve bereketlendirdi", "fr": "et il a béni", "id": "dan dia telah memberkahi", "ur": "اور اُس نے برکت دی", "bn": "এবং সে বরকত দিয়েছে", "fa": "و برکت داد"}}], "ayatFile": "ayat/0341.json", "ayatTranslations": {"en": "ayat/0341.en.json", "tr": "ayat/0341.tr.json", "ur": "ayat/0341.ur.json", "id": "ayat/0341.id.json"}, "sentences": [{"arabic": "بَارَكَ لَنَا جَارُنَا", "spoken": "audio/7f62c576f2c9699234d6.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Komšija nam je čestitao.", "en": "Our neighbour congratulated us.", "bn": "আমাদের প্রতিবেশী আমাদের অভিনন্দন জানালেন।", "fa": "همسایه‌مان به ما تبریک گفت.", "fr": "Notre voisin nous a félicités.", "id": "Tetangga kami mengucapkan selamat kepada kami.", "tr": "Komşumuz bizi tebrik etti.", "ur": "ہمارے پڑوسی نے ہمیں مبارکباد دی۔"}, "independentlyReviewed": true, "words": [{"arabic": "بَارَكَ", "target": true, "translation": {"bs": "čestitao je", "en": "congratulated", "bn": "অভিনন্দন জানাল", "fa": "تبریک گفت", "fr": "a félicité", "id": "mengucapkan selamat", "tr": "tebrik etti", "ur": "اس نے مبارکباد دی"}}, {"arabic": "لَنَا", "target": false, "translation": {"bs": "nam", "en": "us", "bn": "আমাদের", "fa": "به ما", "fr": "nous", "id": "kepada kami", "tr": "bizi", "ur": "ہمیں"}}, {"arabic": "جَارُنَا", "target": false, "translation": {"bs": "naš komšija", "en": "our neighbor", "bn": "আমাদের প্রতিবেশী", "fa": "همسایه ما", "fr": "notre voisin", "id": "tetangga kami", "tr": "komşumuz", "ur": "ہمارا پڑوسی"}}]}, {"arabic": "بَارَكْنَا لِلْعَرُوسَيْنِ", "spoken": "audio/b79cea237fda0fc2e705.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Čestitali smo mladencima.", "en": "We congratulated the newlyweds.", "bn": "আমরা নবদম্পতিকে অভিনন্দন জানালাম।", "fa": "به تازه‌عروس و داماد تبریک گفتیم.", "fr": "Nous avons félicité les jeunes mariés.", "id": "Kami mengucapkan selamat kepada pengantin baru.", "tr": "Yeni evlileri tebrik ettik.", "ur": "ہم نے نوبیاہتا جوڑے کو مبارکباد دی۔"}, "independentlyReviewed": true, "words": [{"arabic": "بَارَكْنَا", "target": true, "translation": {"bs": "čestitali smo", "en": "congratulated", "bn": "অভিনন্দন জানাল", "fa": "تبریک گفتیم", "fr": "nous avons félicité", "id": "mengucapkan selamat", "tr": "tebrik ettik", "ur": "ہم نے مبارکباد دی"}}, {"arabic": "لِلْعَرُوسَيْنِ", "target": false, "translation": {"bs": "mladencima", "en": "the newlyweds", "bn": "নবদম্পতিকে", "fa": "به تازه‌عروس و داماد", "fr": "les jeunes mariés", "id": "pengantin baru", "tr": "yeni evlileri", "ur": "نوبیاہتا جوڑے کو"}}]}]}