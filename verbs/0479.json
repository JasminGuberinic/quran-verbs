ْ", "plain": "اِطْمِسْ", "quran": true, "notUsed": false, "spoken": "audio/d2641e0ba2314f0b8bad.m4a", "recited": "audio/40f470319f3c87c20ff8.m4a", "recitedText": "ٱطْمِسْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِطْمِسِي", "plain": "اِطْمِسِي", "quran": false, "notUsed": false, "spoken": "audio/1b7b1c113d39a69b2339.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِطْمِسَا", "plain": "اِطْمِسَا", "quran": false, "notUsed": false, "spoken": "audio/132570befe905f611fe9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِطْمِسُوا", "plain": "اِطْمِسُوا", "quran": false, "notUsed": false, "spoken": "audio/b3adcb88d236f936d5be.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِطْمِسْنَ", "plain": "اِطْمِسْنَ", "quran": false, "notUsed": false, "spoken": "audio/07057e944aefc4fdd6a2.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "36:66", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3771.mp3", "translation": {"en": {"text": "And had We willed, We verily could have quenched their eyesight so that they should struggle for the way. Then how could they have seen?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hem dileseydik gözlerini üzerinden silme kör ediverirdik de yola dökülürlerdi. Fakat nereden görecekler?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر ہم چاہتے تو ان کی آنکھیں مٹادیتے پھر لپک کر رستہ کی طرف جاتے تو انہیں کچھ نہ سوجھتا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan jikalau Kami menghendaki pastilah Kami hapuskan penglihatan mata mereka; lalu mereka berlomba-lomba (mencari) jalan, Maka betapakah mereka dapat melihat(nya).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَشَآءُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَطَمَسْنَا", "hit": true, "audio": "audio/68b40db9bf9c8cbde5b0.m4a", "gloss": {"bs": "izbrisali bismo", "en": "We would have blotted out", "tr": "silerdik", "fr": "Nous aurions effacé", "id": "Kami pasti telah melenyapkan", "ur": "ہم ضرور مٹا دیتے", "bn": "আমি অবশ্যই মুছে দিতাম", "fa": "هر آینه محو می‌کردیم"}}, {"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْيُنِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱسْتَبَقُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصِّرَٰطَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَنَّىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "يُبْصِرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "نَّطْمِسَ", "count": 1, "first": "4:47", "audio": "audio/6992607417a97bcbf7b8.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "we efface", "bs": "brišemo", "tr": "siliriz", "fr": "nous effaçons", "id": "kami menghapus", "ur": "ہم مٹاتے ہیں", "bn": "আমরা মুছে ফেলি", "fa": "محو می‌کنیم"}}, {"arabic": "ٱطْمِسْ", "count": 1, "first": "10:88", "audio": "audio/40f470319f3c87c20ff8.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "efface!", "bs": "izbriši!", "tr": "sil!", "fr": "efface !", "id": "hapuslah!", "ur": "مٹا دو!", "bn": "মুছে ফেল!", "fa": "محو کن!"}}, {"arabic": "لَطَمَسْنَا", "count": 1, "first": "36:66", "audio": "audio/68b40db9bf9c8cbde5b0.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"bs": "izbrisali bismo", "en": "We would have blotted out", "tr": "silerdik", "fr": "Nous aurions effacé", "id": "Kami pasti telah melenyapkan", "ur": "ہم ضرور مٹا دیتے", "bn": "আমি অবশ্যই মুছে দিতাম", "fa": "هر آینه محو می‌کردیم"}}, {"arabic": "فَطَمَسْنَآ", "count": 1, "first": "54:37", "audio": "audio/6cbb1712d74605dd0b2d.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "so we effaced", "bs": "pa smo izbrisali", "tr": "böylece sildik", "fr": "alors nous avons effacé", "id": "maka kami telah menghapus", "ur": "پس ہم نے مٹایا", "bn": "অতএব আমরা মুছে ফেললাম", "fa": "پس محو کردیم"}}, {"arabic": "طُمِسَتْ", "count": 1, "first": "77:8", "audio": "audio/b50ab0f048e15d8470bf.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": true, "objects": []}], "gloss": {"en": "she/it was effaced", "bs": "izbrisana je", "tr": "silindi", "fr": "elle a été effacée", "id": "dia telah dihapus", "ur": "وہ مٹائی گئی", "bn": "তা মুছে ফেলা হলো", "fa": "محو شد"}}], "ayatFile": "ayat/0479.json", "ayatTranslations": {"en": "ayat/0479.en.json", "tr": "ayat/0479.tr.json", "ur": "ayat/0479.ur.json", "id": "ayat/0479.id.json"}, "sentences": [{"arabic": "اِطْمِسْ هَذِهِ الْكِتَابَةَ", "spoken": "audio/cfd5fa812909f9c24c93.m4a", "tense": "imperative", "pronoun": "anta", "translation": {"bs": "Izbriši ovaj natpis.", "en": "Obliterate this writing.", "bn": "এই লেখাটি মুছে ফেলো।", "fa": "این نوشته را محو کن.", "fr": "Efface cette écriture.", "id": "Hapuslah tulisan ini.", "tr": "Bu yazıyı sil.", "ur": "اس تحریر کو مٹا دو۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِطْمِسْ", "target": true, "translation": {"bs": "izbriši", "en": "obliterate", "bn": "মুছে ফেলো", "fa": "محو کن", "fr": "efface", "id": "hapuslah", "tr": "sil", "ur": "مٹا دو"}}, {"arabic": "هَذِهِ", "target": false, "translation": {"bs": "ovaj", "en": "this", "bn": "এই", "fa": "این", "fr": "ce", "id": "ini", "tr": "bu", "ur": "یہ"}}, {"arabic": "الْكِتَابَةَ", "target": false, "translation": {"bs": "natpis", "en": "the writing", "bn": "লেখা", "fa": "نوشته", "fr": "l'écriture", "id": "tulisan", "tr": "yazı", "ur": "تحریر"}}]}, {"arabic": "طَمَسْنَا الْكِتَابَةَ عَلَى الْجِدَارِ", "spoken": "audio/f65e6ab841f798e53aa2.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Izbrisali smo natpis na zidu.", "en": "We obliterated the writing on the wall.", "bn": "আমরা দেয়ালের লেখাটি মুছে ফেললাম।", "fa": "ما نوشته‌ی روی دیوار را محو کردیم.", "fr": "Nous avons effacé l'écriture sur le mur.", "id": "Kami menghapus tulisan di dinding itu.", "tr": "Duvardaki yazıyı sildik.", "ur": "ہم نے دیوار پر لکھی ہوئی تحریر مٹا دی۔"}, "independentlyReviewed": true, "words": [{"arabic": "طَمَسْنَا", "target": true, "translation": {"bs": "izbrisali smo", "en": "obliterated", "bn": "আমরা মুছে ফেললাম", "fa": "محو کردیم", "fr": "avons effacé", "id": "kami menghapus", "tr": "sildik", "ur": "ہم نے مٹا دیا"}}, {"arabic": "الْكِتَابَةَ", "target": false, "translation": {"bs": "natpis", "en": "the writing", "bn": "লেখা", "fa": "نوشته", "fr": "l'écriture", "id": "tulisan", "tr": "yazı", "ur": "تحریر"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "na", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "الْجِدَارِ", "target": false, "translation": {"bs": "zidu", "en": "the wall", "bn": "দেয়ালের", "fa": "دیوار", "fr": "le mur", "id": "dinding itu", "tr": "duvar", "ur": "دیوار"}}]}]}