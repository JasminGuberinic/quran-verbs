 {"tense": "present", "pronoun": "hunna", "arabic": "يَنْهَيْنَ", "plain": "يَنْهَيْنَ", "quran": false, "notUsed": false, "spoken": "audio/cfdfacfcf8d70183cec9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱنْهَ", "plain": "اِنْهَ", "quran": true, "notUsed": false, "spoken": "audio/c2dfee2dc17bf6755069.m4a", "recited": "audio/5e04bc1ade3e03a5ee3c.m4a", "recitedText": "وَٱنْهَ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِنْهَيْ", "plain": "اِنْهَيْ", "quran": false, "notUsed": false, "spoken": "audio/715106de920affac4d00.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِنْهَيَا", "plain": "اِنْهَيَا", "quran": false, "notUsed": false, "spoken": "audio/626495d8efc5a7bad8d4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِنْهَوْا", "plain": "اِنْهَوْا", "quran": false, "notUsed": false, "spoken": "audio/7488bc8b91c32f400c3c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِنْهَيْنَ", "plain": "اِنْهَيْنَ", "quran": false, "notUsed": false, "spoken": "audio/b3e901316d08212f01e7.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "6:26", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/815.mp3", "translation": {"en": {"text": "And they forbid (men) from it and avoid it, and they ruin none save themselves, though they perceive not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, insanları Kur'ân'a iman etmekten menederler, hem de kendileri ondan uzak dururlar. Böylece yalnız kendilerini mahvediyorlar ama farkında değiller.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ اس سے روکتے اور اس سے دور بھاگتے ہیں اور بلاک نہیں کرتے مگر اپنی جانیں اور انہیں شعور نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka melarang (orang lain) mendengarkan Al-Quran dan mereka sendiri menjauhkan diri daripadanya, dan mereka hanyalah membinasakan diri mereka sendiri, sedang mereka tidak menyadari.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَنْهَوْنَ", "hit": true, "audio": "audio/eeaf618cb616877d9f50.m4a", "gloss": {"en": "they forbid", "bs": "zabranjuju", "tr": "yasaklarlar", "fr": "ils interdisent", "id": "mereka melarang", "ur": "وہ حرام کرتے ہیں", "bn": "তারা নিষেধ করে", "fa": "منع می‌کنند"}}, {"text": "عَنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَنْـَٔوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِن", "hit": false, "audio": null, "gloss": null}, {"text": "يُهْلِكُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنفُسَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَشْعُرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "96:9", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6115.mp3", "translation": {"en": {"text": "Hast thou seen him who dissuadeth", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Namaz kıldığı zaman, bir kulu engelleyeni gördün mü?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بھلا دیکھو تو جو منع کرتا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Bagaimana pendapatmu tentang orang yang melarang,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَرَءَيْتَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "يَنْهَىٰ", "hit": true, "audio": "audio/18872a7a3ce349d1d9ab.m4a", "gloss": {"bs": "zabranjuje", "en": "forbids", "tr": "yasaklar", "fr": "interdit", "id": "melarang", "ur": "وہ منع کرتا ہے", "bn": "নিষেধ করেন", "fa": "باز می‌دارد"}}]}, {"ref": "79:40", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5752.mp3", "translation": {"en": {"text": "But as for him who feared to stand before his Lord and restrained his soul from lust,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kim de Rabbinin divanında durmaktan korkmuş, nefsini boş heveslerden menetmiş ise,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جو اپنے رب کے حضور کھڑے ہونے سے ڈرا اور نفس کو خواہش سے روکا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan adapun orang-orang yang takut kepada kebesaran Tuhannya dan menahan diri dari keinginan hawa nafsunya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "خَافَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَقَامَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَهَى", "hit": true, "audio": "audio/8e1e10b150b142fb1b87.m4a", "gloss": {"bs": "i suzdržao je", "en": "and restrained", "tr": "ve alıkoydu", "fr": "et a retenu", "id": "dan menahan", "ur": "اور اس نے منع کیا", "bn": "এবং নিষেধ করল", "fa": "و بازداشت"}}, {"text": "ٱلنَّفْسَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْهَوَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:70", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1872.mp3", "translation": {"en": {"text": "They said; Have we not forbidden you from (entertaining) anyone?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Lût kavmi şöyle dedi: \"Biz sana kimsenin koruyuculuğunu yapmamanı söylememiş miydik?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے کیا ہم نے تمہیں منع نہ کیا تھا کہ اوروں کے معاملہ میں دخل نہ دو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka berkata: \"Dan bukankah kami telah melarangmu dari (melindungi) manusia?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "أَوَلَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَنْهَكَ", "hit": true, "audio": "audio/2cbe167fd6b98896b84e.m4a", "gloss": {"en": "we forbid you", "bs": "zabranjujemo ti", "tr": "sana yasaklarız", "fr": "nous te l'interdisons", "id": "kami melarangmu", "ur": "ہم تم پر حرام کرتے ہیں", "bn": "আমরা তোমাকে নিষেধ করি", "fa": "به تو منع کنیم"}}, {"text": "عَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَٰلَمِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "نُهُوا۟", "count": 5, "first": "4:161", "audio": "audio/3f570ebd6dd986f52175.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": true, "objects": []}], "gloss": {"en": "they were forbidden", "bs": "zabranjeni su", "tr": "yasaklandılar", "fr": "ils ont été interdits", "id": "mereka telah dilarang", "ur": "ان پر حرام کیا گیا", "bn": "তারা নিষিদ্ধ ছিল", "fa": "منع شدند"}}, {"arabic": "وَيَنْهَوْنَ", "count": 4, "first": "3:104", "audio": "audio/5c0affe3a218ee1b9866.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and they forbid", "bs": "i zabranjuju", "tr": "ve yasaklarlar", "fr": "et ils interdisent", "id": "dan mereka melarang", "ur": "اور وہ حرام کرتے ہیں", "bn": "এবং তারা নিষেধ করে", "fa": "و منع می‌کنند"}}, {"arabic": "يَنْهَوْنَ", "count": 3, "first": "6:26", "audio": "audio/eeaf618cb616877d9f50.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they forbid", "bs": "zabranjuju", "tr": "yasaklarlar", "fr": "ils interdisent", "id": "mereka melarang", "ur": "وہ حرام کرتے ہیں", "bn": "তারা নিষেধ করে", "fa": "منع می‌کنند"}}, {"arabic": "نُهِيتُ", "count": 2, "first": "6:56", "audio": "audio/3ca8300b17efb9bfd162.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": true, "objects": []}], "gloss": {"en": "I was forbidden", "bs": "bilo mi je zabranjeno", "tr": "bana yasaklandı", "fr": "il m'a été interdit", "id": "aku telah dilarang", "ur": "مجھ پر حرام کیا گیا", "bn": "আমার জন্য নিষিদ্ধ ছিল", "fa": "منع شده بودم"}}, {"arabic": "يَنْهَىٰكُمُ", "count": 2, "first": "60:8", "audio": "audio/e8a5d68723134058f3f8.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "he/it forbids you (all)", "bs": "zabranjuje vam", "tr": "size yasaklar", "fr": "il vous interdit", "id": "dia melarang kalian", "ur": "وہ تم پر حرام کرتا ہے", "bn": "সে তোমাদের নিষেধ করে", "fa": "به شما منع می‌کند"}}, {"arabic": "وَتَنْهَوْنَ", "count": 1, "first": "3:110", "audio": "audio/b4407fb37c5db4ca47e8.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and you (all) forbid", "bs": "i zabranjujete", "tr": "ve yasaklarsınız", "fr": "et vous interdisez", "id": "dan kalian melarang", "ur": "اور تم حرام کرتے ہو", "bn": "এবং তোমরা নিষেধ কর", "fa": "و منع می‌کنید"}}, {"arabic": "تُنْهَوْنَ", "count": 1, "first": "4:31", "audio": "audio/a355f3a44ac75bade9ee.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": true, "objects": [], "mood": "indicative"}], 