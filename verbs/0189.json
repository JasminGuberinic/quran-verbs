uran": false, "notUsed": false, "spoken": "audio/a4025052d30e2e24018e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَمْسِكُوا", "plain": "أَمْسِكُوا", "quran": false, "notUsed": false, "spoken": "audio/4f605ee10444e47c376f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَمْسِكْنَ", "plain": "أَمْسِكْنَ", "quran": false, "notUsed": false, "spoken": "audio/0095538335dc73692e22.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "38:39", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4009.mp3", "translation": {"en": {"text": "(Saying): This is Our gift, so bestow thou, or withhold, without reckoning.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"İşte bu, bizim ihsanımızdır. Artık sen dilersen başkalarına ver veya verme. Bundan hesaba çekilmeyeceksin\" dedik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یہ ہماری عطا ہے اب تو چاہے تو احسان کر یا روک رکھ تجھ پر کچھ حساب نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Inilah anugerah Kami; maka berikanlah (kepada orang lain) atau tahanlah (untuk dirimu sendiri) dengan tiada pertanggungan jawab.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "هَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "عَطَآؤُنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱمْنُنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْسِكْ", "hit": true, "audio": "audio/614d896867095da76c7e.m4a", "gloss": {"bs": "zadrži", "en": "withhold", "tr": "esirge", "fr": "retiens", "id": "tahanlah", "ur": "روک رکھو", "bn": "আটকে রাখো", "fa": "نگه دار"}}, {"text": "بِغَيْرِ", "hit": false, "audio": null, "gloss": null}, {"text": "حِسَابٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "67:21", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5262.mp3", "translation": {"en": {"text": "Or who is he that will provide for you if He should withhold His providence? Nay, but they are set in pride and frowardness.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah size verdiği rızkı kesiverse, size rızık verecek olabilen kimdir? Hayır, onlar azgınlık ve nefrette direnip durmaktadırlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا کونسا ایسا ہے جو تمہیں روزی دے اگر وہ اپنی روزی روک لے بلکہ وہ سرکش اور نفرت میں ڈھیٹ بنے ہوئے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Atau siapakah dia yang memberi kamu rezeki jika Allah menahan rezeki-Nya? Sebenarnya mereka terus menerus dalam kesombongan dan menjauhkan diri?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمَّنْ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "يَرْزُقُكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْسَكَ", "hit": true, "audio": "audio/bfe4d3d1d1f980f0f492.m4a", "gloss": {"bs": "uskrati", "en": "He withheld", "tr": "esirgedi", "fr": "Il a retenu", "id": "Dia menahan", "ur": "اس نے روک لیا", "bn": "তিনি আটকে রাখলেন", "fa": "دریغ کرد"}}, {"text": "رِزْقَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "بَل", "hit": false, "audio": null, "gloss": null}, {"text": "لَّجُّوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "عُتُوٍّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنُفُورٍ", "hit": false, "audio": null, "gloss":