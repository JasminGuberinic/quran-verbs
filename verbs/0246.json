ull, "gloss": null}, {"text": "وَأَسِيرًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَأَطْعِمُوا۟", "count": 2, "first": "22:28", "audio": "audio/7d2fb9aca6ae2e8be1ee.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) feed!", "bs": "i nahranite!", "tr": "ve doyurun!", "fr": "et nourrissez !", "id": "dan berilah makan!", "ur": "اور تم سب کھلاؤ!", "bn": "এবং খাওয়াও!", "fa": "و اطعام کنید!"}}, {"arabic": "تُطْعِمُونَ", "count": 1, "first": "5:89", "audio": "audio/40b950e86803e0930823.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "you (all) feed", "bs": "hranite", "tr": "doyurursunuz", "fr": "vous nourrissez", "id": "kalian memberi makan", "ur": "تم سب کھلاتے ہو", "bn": "তোমরা খাওয়াও", "fa": "اطعام می‌کنید"}}, {"arabic": "يُطْعِمُ", "count": 1, "first": "6:14", "audio": "audio/10a03c7d4bf7e5588dc0.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it feeds", "bs": "hrani", "tr": "doyurur", "fr": "il nourrit", "id": "dia memberi makan", "ur": "وہ کھلاتا ہے", "bn": "সে খাওয়ায়", "fa": "اطعام می‌کند"}}, {"arabic": "يُطْعَمُ", "count": 1, "first": "6:14", "audio": "audio/d9f895d7bf28457c0c30.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it is fed", "bs": "biva nahranjen", "tr": "doyurulur", "fr": "il est nourri", "id": "dia diberi makan", "ur": "اسے کھلایا جاتا ہے", "bn": "তাকে খাওয়ানো হয়", "fa": "اطعام داده می‌شود"}}, {"arabic": "يُطْعِمُنِى", "count": 1, "first": "26:79", "audio": "audio/eff76cfd871d18bcf6b9.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["ana"], "mood": "indicative"}], "gloss": {"bs": "hrani me", "en": "He feeds me", "tr": "beni yedirir", "fr": "me nou