r", "fr": "(ta poitrine) se serre", "id": "(dadamu) menjadi sempit", "ur": "(تمہارا سینہ) تنگ ہوتا ہے", "bn": "(তোমার বক্ষ) সংকুচিত হয়", "fa": "تنگ می‌شود"}}, {"text": "صَدْرُكَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُولُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَضَاقَتْ", "count": 2, "first": "9:25", "audio": "audio/44f206b009c811e49aca.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"en": "and she/it was narrow", "bs": "i bila je tijesna", "tr": "daraldı", "fr": "et elle était à l'étroit", "id": "dan dia telah sempit", "ur": "اور وہ تنگ ہوئی", "bn": "এবং তা সংকীর্ণ ছিল", "fa": "و تنگ بود"}}, {"arabic": "وَضَاقَ", "count": 2, "first": "11:77", "audio": "audio/40f0aae22ab5007d8c77.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it was distressed", "bs": "i bio je potišten", "tr": "sıkıldı", "fr": "et il était affligé", "id": "dan dia telah gundah", "ur": "اور وہ تنگ دل ہوا", "bn": "এবং সে বিষণ্ণ ছিল", "fa": "و اندوهگین بود"}}, {"arabic": "ضَاقَتْ", "count": 1, "first": "9:118", "audio": "audio/6c3c78e4ddda709de673.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"en": "she/it was narrow", "bs": "bila je tijesna", "tr": "daraldı", "fr": "elle était à l'étroit", "id": "dia telah sempit", "ur": "وہ تنگ ہوئی", "bn": "তা সংকীর্ণ ছিল", "fa": "تنگ بود"}}, {"arabic": "يَضِيقُ", "count": 1, "first": "15:97", "audio": "audio/7da3abe0ca9d096b74ae.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "steže se", "en": "(your breast) is constricted", "tr": "(göğsün) daralır", "fr": "(ta poitrine) se serre", "id": "(dadamu) menjadi sempit", "ur": "(تمہارا سینہ) تنگ ہوتا ہے", "bn": "(তোমার বক্ষ) সংকুচিত হয়", "fa": "تنگ می‌شود"}}, {"arabic": "وَيَضِيقُ", "count": 1, "first": "26:13", "audio": "audio/645b5ce723a43decf3ae.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and he/it is constricted", "bs": "i steže se", "tr": "daralır", "fr": "et il se resserre", "id": "dan dia merasa sempit", "ur": "اور وہ تنگ کیا جاتا ہے", "bn": "এবং সে সংকুচিত হয়", "fa": "و تنگ می‌شود"}}], "ayatFile": "ayat/0383.json", "ayatTranslations": {"en": "ayat/0383.en.json", "tr": "ayat/0383.tr.json", "ur": "ayat/0383.ur.json", "id": "ayat/0383.id.json"}, "sentences": [{"arabic": "ضَاقَ الطَّرِيقُ", "spoken": "audio/420a16e4cb7fcb35be3f.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Put se suzio.", "en": "The road narrowed.", "bn": "রাস্তাটি সংকীর্ণ হয়ে গেল।", "fa": "جاده تنگ شد.", "fr": "La route s'est rétrécie.", "id": "Jalan itu menyempit.", "tr": "Yol daraldı.", "ur": "راستہ تنگ ہو گیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "ضَاقَ", "target": true, "translation": {"bs": "suzio se", "en": "narrowed", "bn": "সংকীর্ণ হল", "fa": "تنگ شد", "fr": "s'est rétréci", "id": "menyempit", "tr": "daraldı", "ur": "تنگ ہو گیا"}}, {"arabic": "الطَّرِيقُ", "target": false, "translation": {"bs": "put", "en": "the road", "bn": "রাস্তা", "fa": "جاده", "fr": "la route", "id": "jalan itu", "tr": "yol", "ur": "راستہ"}}]}, {"arabic": "يَضِيقُ الْقَمِيصُ عَلَيْهِ", "spoken": "audio/851d500814c128a0b463.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Košulja mu je tijesna.", "en": "The shirt is tight on him.", "bn": "জামাটি তার গায়ে আঁট।", "fa": "پیراهن بر او تنگ است.", "fr": "La chemise est serrée sur lui.", "id": "Baju itu sempit di badannya.", "tr": "Gömlek ona dar geliyor.", "ur": "قمیص اسے تنگ ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَضِيقُ", "target": true, "translation": {"bs": "tijesna je", "en": "is tight", "bn": "সংকীর্ণ হয়", "fa": "تنگ است", "fr": "est serré", "id": "sempit", "tr": "dardır", "ur": "تنگ ہے"}}, {"arabic": "الْقَمِيصُ", "target": false, "translation": {"bs": "košulja", "en": "the shirt", "bn": "জামা", "fa": "پیراهن", "fr": "la chemise", "id": "baju itu", "tr": "gömlek", "ur": "قمیص"}}, {"arabic": "عَلَيْهِ", "target": false, "translation": {"bs": "mu", "en": "on him", "bn": "তার উপর", "fa": "بر او", "fr": "sur lui", "id": "atasnya", "tr": "onun üzerinde", "ur": "اس پر"}}]}, {"arabic": "ضَاقَتِ الْغُرْفَةُ بِالضُّيُوفِ", "spoken": "audio/26d11d0dbfe06549581b.m4a", "tense": "past", "pronoun": "hiya", "translation": {"bs": "Soba je bila pretijesna za goste.", "en": "The room was too small for the guests.", "bn": "অতিথিদের জন্য ঘরটি সংকীর্ণ হয়ে গেল।", "fa": "اتاق برای مهمانان تنگ شد.", "fr": "La chambre était trop petite pour les invités.", "id": "Kamar itu terlalu sempit untuk para tamu.", "tr": "Oda misafirler için fazla dar geldi.", "ur": "کمرہ مہمانوں کے لیے تنگ پڑ گیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "ضَاقَتِ", "target": true, "translation": {"bs": "bila je pretijesna", "en": "was too small", "bn": "সংকীর্ণ হল", "fa": "تنگ شد", "fr": "a été trop petite", "id": "terlalu sempit", "tr": "fazla dar geldi", "ur": "تنگ پڑ گئی"}}, {"arabic": "الْغُرْفَةُ", "target": false, "translation": {"bs": "soba", "en": "the room", "bn": "ঘরটি", "fa": "اتاق", "fr": "la chambre", "id": "kamar itu", "tr": "oda", "ur": "کمرہ"}}, {"arabic": "بِالضُّيُوفِ", "target": false, "translation": {"bs": "za goste", "en": "for the guests", "bn": "অতিথিদের জন্য", "fa": "برای مهمانان", "fr": "pour les invités", "id": "untuk para tamu", "tr": "misafirler için", "ur": "مہمانوں کے لیے"}}]}]}