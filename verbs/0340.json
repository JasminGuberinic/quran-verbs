lse, "notUsed": false, "spoken": "audio/380943530791d26ac99d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "لِدُوا", "plain": "لِدُوا", "quran": false, "notUsed": false, "spoken": "audio/aae4f0d803b2b8795309.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "لِدْنَ", "plain": "لِدْنَ", "quran": false, "notUsed": false, "spoken": "audio/56e1a46b7aa6b6f78803.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "90:3", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6026.mp3", "translation": {"en": {"text": "And the begetter and that which he begat,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve and olsun baba ve çocuğuna.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور تمہارے باپ ابراہیم کی قسم اور اس کی اولاد کی کہ تم ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan demi bapak dan anaknya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَوَالِدٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَدَ", "hit": true, "audio": "audio/b9f5d732d1ff1366c68d.m4a", "gloss": {"bs": "rodio je", "en": "he begot", "tr": "doğurdu", "fr": "il a engendré", "id": "dia memperanakkan", "ur": "اس نے جنا", "bn": "সে জন্ম দিয়েছে", "fa": "زایید"}}]}, {"ref": "11:72", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1545.mp3", "translation": {"en": {"text": "She said: Oh woe is me! Shall I bear a child when I am an old woman, and this my husband is an old man? Lo! this is a strange thing!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Vay başıma gelene!\" dedi, \"Ben bir kocakarıyım, kocam da yaşlı bir adam. Bu gerçekten çok tuhaf bir şey!\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولی ہائے خرابی کیا میرے بچہ ہوگا اور میں بوڑھی ہوں اور یہ ہیں میرے شوہر بوڑھے بیشک یہ تو اچنبھے کی بات ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Isterinya berkata: \"Sungguh mengherankan, apakah aku akan melahirkan anak padahal aku adalah seorang perempuan tua, dan ini suamikupun dalam keadaan yang sudah tua pula?. Sesungguhnya ini benar-benar suatu yang sangat aneh\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَتْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰوَيْلَتَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَأَلِدُ", "hit": true, "audio": "audio/370a32596a4c79d3648c.m4a", "gloss": {"en": "do I give birth?", "bs": "zar rađam?", "tr": "doğurur muyum?", "fr": "vais-je enfanter ?", "id": "apakah aku melahirkan?", "ur": "کیا میں جنم دوں؟", "bn": "আমি কি প্রসব করি?", "fa": "آیا می‌زایم؟"}}, {"text": "وَأَنَا۠", "hit": false, "audio": null, "gloss": null}, {"text": "عَجُوزٌ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْلِى", "hit": false, "audio": null, "gloss": null}, {"text": "شَيْخًا", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَشَىْءٌ", "hit": false, "audio": null, "gloss": null}, {"text": "عَجِيبٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "71:27", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5446.mp3", "translation": {"en": {"text": "If Thou shouldst leave them, they will mislead Thy slaves and will beget none save lewd ingrates.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Zira sen onları bırakırsan kullarını yoldan çıkarırlar ve sadece ahlâksız ve kâfir çocuklar doğururlar.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک اگر تو انہیں رہنے دے گا تو تیرے بندوں کو گمراہ کردیں گے اور ان کے اولاد ہوگی تو وہ بھی نہ ہوگی مگر بدکار بڑی ناشکر", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya jika Engkau biarkan mereka tinggal, niscaya mereka akan menyesatkan hamba-hamba-Mu, dan mereka tidak akan melahirkan selain anak yang berbuat maksiat lagi sangat kafir.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَذَرْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُضِلُّوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "عِبَادَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَلِدُوٓا۟", "hit": true, "audio": "audio/752318c140cc46b7b142.m4a", "gloss": {"en": "they give birth", "bs": "rađaju", "tr": "doğururlar", "fr": "qu'ils enfantent", "id": "mereka melahirkan", "ur": "وہ جنم دیتے ہیں", "bn": "তারা জন্ম দেয়", "fa": "بزایند"}}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "فَاجِرًا", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَّارًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "112:3", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6224.mp3", "translation": {"en": {"text": "He begetteth not nor was begotten.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Doğurmadı ve doğurulmadı", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "نہ اس کی کوئی اولاد اور نہ وہ کسی سے پیدا ہوا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dia tiada beranak dan tidak pula diperanakkan,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَلِدْ", "hit": true, "audio": "audio/034a5fbb3e78a009bc82.m4a", "gloss": {"bs": "(nije) rodio", "en": "He (did not) beget", "tr": "doğurmadı", "fr": "Il n'a (pas) engendré", "id": "Dia (tidak) beranak", "ur": "اس نے (نہیں) جنا", "bn": "তিনি জন্ম দেননি", "fa": "نزایید"}}, {"text": "وَلَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُولَدْ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَلَدَ", "count": 2, "first": "37:152", "audio": "audio/b9f5d732d1ff1366c68d.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "rodio je", "en": "he begot", "tr": "doğurdu", "fr": "il a engendré", "id": "dia memperanakkan", "ur": "اس نے جنا", "bn": "সে জন্ম দিয়েছে", "fa": "زایید"}}, {"arabic": "ءَأَلِدُ", "count": 1, "first": "11:72", "audio": "audio/370a32596a4c79d3648c.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "do I give birth?", "bs": "zar rađam?", "tr": "doğurur muyum?", "fr": "vais-je enfanter ?", "id": "apakah aku melahirkan?", "ur": "کیا میں جنم دوں؟", "bn": "আমি কি প্রসব করি?", "fa": "آیا می‌زایم؟"}}, {"arabic": "وُلِدَ", "count": 1, "first": "19:15", "audio": "audio/c0e9be72c2e8d4c97d8c.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "he/it was born", "bs": "rođen je", "tr": "doğdu", "fr": "il est né", "id": "dia telah dilahirkan", "ur": "وہ پیدا ہوا", "bn": "সে জন্মগ্রহণ করেছে", "fa": "زاده شد"}}, {"arabic": "وُلِدتُّ", "count": 1, "first": "19:33", "audio": "audio/17292e15a707a71e8d5c.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": true, "objects": []}], "gloss": {"en": "I was born", "bs": "rođen sam", "tr": "doğdum", "fr": "je s