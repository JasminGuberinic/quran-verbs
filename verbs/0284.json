{"rank": 284, "root": "عهد", "form": 3, "lemma": "عاهَدَ", "count": 11, "ayahCount": 11, "share": 0.06, "meaning": {"bs": "sklopiti savez, obavezati se", "en": "to make a covenant with, to pledge", "tr": "ahitleşmek, söz vermek", "fr": "conclure un pacte avec, s'engager auprès de", "id": "mengikat perjanjian dengan, berikrar", "ur": "عہد لینا، تاکید کرنا", "bn": "অঙ্গীকার করা, প্রতিজ্ঞা করা", "fa": "پیمان بستن با، عهد کردن"}, "lemmaSpoken": "audio/6d01f69eb7d23e85669d.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "عَٰهَدَ", "plain": "عَاهَدَ", "quran": true, "notUsed": false, "spoken": "audio/6d01f69eb7d23e85669d.m4a", "recited": "audio/8b95f4cd77b5e40e02d1.m4a", "recitedText": "عَٰهَدَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُعَاهِدُ", "plain": "يُعَاهِدُ", "quran": false, "notUsed": false, "spoken": "audio/8ba166842e193e108e1a.m4a", "recited": null, "recitedText": null}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "عَاهَدْتُ", "plain": "عَاهَدْتُ", "quran": false, "notUsed": false, "spoken": "audio/0f96f80dccbf3f0674da.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "عَاهَدْنَا", "plain": "عَاهَدْنَا", "quran": false, "notUsed": false, "spoken": "audio/b698825d5232baa7d604.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "عَٰهَدتَّ", "plain": "عَاهَدْتَ", "quran": true, "notUsed": false, "spoken": "audio/49008e986caf273ed671.m4a", "recited": "audio/59b257bf440553a87bb4.m4a", "recitedText": "عَٰهَدتَّ"}, {"tense": "past", "pronoun": "anti", "arabic": "عَاهَدْتِ", "plain": "عَاهَدْتِ", "quran": false, "notUsed": false, "spoken": "audio/e9807e4645f978555e29.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "عَاهَدْتُمَا", "plain": "عَاهَدْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/bb1304321734b3cfc26e.m4a", "recited": null, "recitedText": null}, {"tense": "past