4d2f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِفْتِنِي", "plain": "اِفْتِنِي", "quran": false, "notUsed": false, "spoken": "audio/3d011bc0055606aca9dc.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِفْتِنَا", "plain": "اِفْتِنَا", "quran": false, "notUsed": false, "spoken": "audio/80ab5c9bf4464f7155cc.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِفْتِنُوا", "plain": "اِفْتِنُوا", "quran": false, "notUsed": false, "spoken": "audio/da952522fd24f37a1919.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِفْتِنَّ", "plain": "اِفْتِنَّ", "quran": false, "notUsed": false, "spoken": "audio/285e215675deebdb69ae.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "44:17", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4431.mp3", "translation": {"en": {"text": "And verily We tried before them Pharaoh's folk, when there came unto them a noble messenger,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun ki, biz onlardan önce Firavun kavmini de denemiştik. Onlara çok kıymetli bir peygamber gelmişti.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے ان سے پہلے فرعون کی قوم کو جانچا اور ان کے پاس ایک معزز رسول تشریف لایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya sebelum mereka telah Kami uji kaum Fir'aun dan telah datang kepada mereka seorang rasul yang mulia,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَنَّا", "hit": true, "audio": "audio/ab8bc6c1073ce0b8369f.m4a", "gloss": {"bs": "iskušali smo", "en": "We tested", "tr": "denedik", "fr": "Nous avons mis à l'épreuve", "id": "Kami menguji", "ur": "ہم نے آزمایا", "bn": "আমরা পরীক্ষা করেছি", "fa": "آزمودیم"}}, {"text": "قَبْلَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِرْعَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَجَآءَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "رَسُولٌ", "hit": false, "audio": null, "gloss": null}, {"text": "كَرِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "72:17", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5464.mp3", "translation": {"en": {"text": "That We may test them thereby, and whoso turneth away from the remembrance of his Lord; He will thrust him into ever-growing torment.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ki onları onunla sınayalım. Kim Rabbini anmaktan yüz çevirirse, Rabbi onu gittikçe yükselen bir azaba sokar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ اس پر انہیں جانچیں اور جو اپنے رب کی یاد سے منہ پھیرے وہ اسے چڑھتے عذاب میں ڈالے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Untuk Kami beri cobaan kepada mereka padanya. Dan barangsiapa yang berpaling dari peringatan Tuhannya, niscaya akan dimasukkan-Nya ke dalam azab yang amat berat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لِّنَفْتِنَهُمْ", "hit": true, "audio": "audio/0e99e972bb15920a2306.m4a", "gloss": {"bs": "da ih iskušamo", "en": "that We may test them", "tr": "onları deneyelim diye", "fr": "afin que Nous les éprouvions", "id": "agar Kami menguji mereka", "ur": "تاکہ ہم انہیں آزمائیں", "bn": "যাতে আমরা তাদের পরীক্ষা করি", "fa": "تا آنان را بیازماییم"}}, {"text": "فِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "يُعْرِضْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَن", "hit": false, "audio": null, "gloss": null}, {"text": "ذِكْرِ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْلُكْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابًا", "hit": false, "audio": null, "gloss": null}, {"text": "صَعَدًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "فَتَنَّا", "count": 5, "first": "6:53", "audio": "audio/ab8bc6c1073ce0b8369f.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"bs": "iskušali smo", "en": "We tested", "tr": "denedik", "fr": "Nous avons mis à l'épreuve", "id": "Kami menguji", "ur": "ہم نے آزمایا", "bn": "আমরা পরীক্ষা করেছি", "fa": "آزمودیم"}}, {"arabic": "يُفْتَنُونَ", "count": 3, "first": "9:126", "audio": "audio/192fd68074d6e04cb5da.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "they are tested; they are tormented", "bs": "iskušavani su; mučeni su", "tr": "imtihan edilirler; eziyet görürler", "fr": "ils sont mis à l'épreuve ; ils sont tourmentés", "id": "mereka diuji; mereka disiksa", "ur": "انہیں آزمایا جاتا ہے", "bn": "তারা পরীক্ষিত হয়; তারা নির্যাতিত হয়", "fa": "آزموده می‌شوند؛ شکنجه می‌شوند"}}, {"arabic": "يَفْتِنَكُمُ", "count": 1, "first": "4:101", "audio": "audio/654318b4a7b53975ac5d.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "subjunctive"}], "gloss": {"en": "he/it persecutes you (all)", "bs": "progoni vas", "tr": "sizi eziyet eder", "fr": "il vous persécute", "id": "dia menganiaya kalian", "ur": "وہ تمہیں آزمائش میں ڈالتا ہے", "bn": "সে তোমাদের নির্যাতন করে", "fa": "شما را آزار دهد"}}, {"arabic": "يَفْتِنُوكَ", "count": 1, "first": "5:49", "audio": "audio/6f503e839ce610ed8e8d.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "