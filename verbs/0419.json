noun": "anta", "arabic": "تَصَدَّقْ", "plain": "تَصَدَّقْ", "quran": true, "notUsed": false, "spoken": "audio/70f02aec18114381e5a4.m4a", "recited": "audio/0a35aac98f5611b3a782.m4a", "recitedText": "وَتَصَدَّقْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "تَصَدَّقِي", "plain": "تَصَدَّقِي", "quran": false, "notUsed": false, "spoken": "audio/7ef7ee65cba63cbc0be9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "تَصَدَّقَا", "plain": "تَصَدَّقَا", "quran": false, "notUsed": false, "spoken": "audio/2b834a19bbbc7f1efedd.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "تَصَدَّقُوا", "plain": "تَصَدَّقُوا", "quran": false, "notUsed": false, "spoken": "audio/fbf92918503ec1e6e1c7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "تَصَدَّقْنَ", "plain": "تَصَدَّقْنَ", "quran": false, "notUsed": false, "spoken": "audio/c976dbcadad30e31cf35.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "9:75", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1310.mp3", "translation": {"en": {"text": "And of them is he who made a covenant with Allah (saying): If He give us of His bounty we will give alms and become of the righteous.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yine onlardan kimi de Allah'a şöyle ahdetmişlerdi: \"Eğer bize lütuf ve kereminden ihsan ederse biz de elbette zekâtı veririz ve kesinlikle salihlerden oluruz.\" diye söz vermişlerdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان میں کوئی وہ ہیں جنہوں نے اللہ سے عہد کیا تھا کہ اگر ہمیں اپنے فضل سے دے تو ہم ضرور خیرات کریں گے اور ہم ضرور بھلے آدمی ہوجائیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan diantara mereka ada orang yang telah berikrar kepada Allah: \"Sesungguhnya jika Allah memberikan sebahagian karunia-Nya kepada kami, pastilah kami akan bersedekah dan pastilah kami termasuk orang-orang yang saleh.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمِنْهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَٰهَدَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَئِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاتَىٰنَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "فَضْلِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَصَّدَّقَنَّ", "hit": true, "audio": "audio/b28c35016765ef02c27b.m4a", "gloss": {"bs": "sigurno ćemo dijeliti sadaku", "en": "we will surely give charity", "tr": "mutlaka sadaka vereceğiz", "fr": "nous ferons sûrement l'aumône", "id": "kami pasti akan bersedekah", "ur": "ہم ضرور صدقہ دیں گے", "bn": "আমরা অবশ্যই সদকা দেব", "fa": "حتماً صدقه خواهیم داد"}}, {"text": "وَلَنَكُونَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّٰلِحِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تَصَدَّقُوا۟", "count": 1, "first": "2:280", "audio": "audio/fd6cd321d1e30426f687.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "you (all) give alms", "bs": "udjeljujete sadaku", "tr": "sadaka verirsiniz", "fr": "que vous fassiez l'aumône", "id": "kalian bersedekah", "ur": "تم سب صدقہ دیتے ہو", "bn": "তোমরা দান কর", "fa": "صدقه می‌دهید"}}, {"arabic": "يَصَّدَّقُوا۟", "count": 1, "first": "4:92", "audio": "audio/08c3d09b46978f3f28a8.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "they give alms", "bs": "udjeljuju sadaku", "tr": "sadaka verirler", "fr": "qu'ils fassent l'aumône", "id": "mereka bersedekah", "ur": "وہ صدقہ دیتے ہیں", "bn": "তারা দান করে", "fa": "صدقه دهند"}}, {"arabic": "تَصَدَّقَ", "count": 1, "first": "5:45", "audio": "audio/ec255d589755398aa61f.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it gave alms", "bs": "udijelio je sadaku", "tr": "sadaka verdi", "fr": "il a fait l'aumône", "id": "dia telah bersedekah", "ur": "اُس نے صدقہ دیا", "bn": "সে দান করল", "fa": "صدقه داد"}}, {"arabic": "لَنَصَّدَّقَنَّ", "count": 1, "first": "9:75", "audio": "audio/b28c35016765ef02c27b.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "sigurno ćemo dijeliti sadaku", "en": "we will surely give charity", "tr": "mutlaka sadaka vereceğiz", "fr": "nous ferons sûrement l'aumône", "id": "kami pasti akan bersedekah", "ur": "ہم ضرور صدقہ دیں گے", "bn": "আমরা অবশ্যই সদকা দেব", "fa": "حتماً صدقه خواهیم داد"}}, {"arabic": "وَتَصَدَّقْ", "count": 1, "first": "12:88", "audio": "audio/0a35aac98f5611b3a782.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "and give alms!", "bs": "i udijeli sadaku!", "tr": "ve sadaka ver!", "fr": "et fais l'aumône !", "id": "dan bersedekahlah!", "ur": "اور صدقہ دو!", "bn": "এবং দান কর!", "fa": "و صدقه بده!"}}, {"arabic": "فَأَصَّدَّقَ", "count": 1, "first": "63:10", "audio": "audio/cf73b86577e23589e59f.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "subjunctive"}]}], "ayatFile": "ayat/0419.json", "ayatTranslations": {"en": "ayat/0419.en.json", "tr": "ayat/0419.tr.json", "ur": "ayat/0419.ur.json", "id": "ayat/0419.id.json"}, "sentences": [{"arabic": "تَصَدَّقَ الرَّجُلُ بِمَالِهِ", "spoken": "audio/51ea1ad632f77a526803.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Čovjek je udijelio svoj imetak kao sadaku.", "en": "The man gave his money as alms.", "bn": "লোকটি তার সম্পদ সদকা করল।", "fa": "مرد از مالش صدقه داد.", "fr": "L'homme a fait l'aumône de son argent.", "id": "Laki-laki itu bersedekah dengan hartanya.", "tr": "Adam parasını sadaka olarak verdi.", "ur": "آدمی نے اپنا مال صدقہ کر دیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "تَصَدَّقَ", "target": true, "translation": {"bs": "udijelio je", "en": "gave alms", "bn": "সদকা দিল", "fa": "صدقه داد", "fr": "a fait l'aumône", "id": "bersedekah", "tr": "sadaka verdi", "ur": "صدقہ دیا"}}, {"arabic": "الرَّجُلُ", "target": false, "translation": {"bs": "čovjek", "en": "the man", "bn": "লোকটি", "fa": "مرد", "fr": "l'homme", "id": "laki-laki itu", "tr": "adam", "ur": "آدمی"}}, {"arabic": "بِمَالِهِ", "target": false, "translation": {"bs": "svoj imetak", "en": "with his money", "bn": "নিজের সম্পদ দিয়ে", "fa": "با مالش", "fr": "avec son argent", "id": "dengan hartanya", "tr": "parasıyla", "ur": "اپنے مال سے"}}]}, {"arabic": "تَصَدَّقْ عَلَى الْفَقِيرِ", "spoken": "audio/8d829242e680c30a95fb.m4a", "tense": "imperative", "pronoun": "anta", "translation": {"bs": "Udijeli sadaku siromahu.", "en": "Give alms to the poor man.", "bn": "গরিব মানুষকে সদকা দাও।", "fa": "به فقیر صدقه بده.", "fr": "Fais l'aumône au pauvre.", "id": "Bersedekahlah kepada orang miskin.", "tr": "Fakire sadaka ver.", "ur": "غریب کو صدقہ دو۔"}, "independentlyReviewed": true, "words": [{"arabic": "تَصَدَّقْ", "target": true, "translation": {"bs": "udijeli sadaku", "en": "give alms", "bn": "সদকা দাও", "fa": "صدقه بده", "fr": "fais l'aumône", "id": "bersedekahlah", "tr": "sadaka ver", "ur": "صدقہ دو"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "-", "en": "to", "bn": "প্রতি", "fa": "به", "fr": "à", "id": "untuk", "tr": "-mek için", "ur": "کو"}}, {"arabic": "الْفَقِيرِ", "target": false, "translation": {"bs": "siromahu", "en": "the poor man", "bn": "গরিব মানুষ", "fa": "فقیر", "fr": "le pauvre", "id": "orang miskin itu", "tr": "fakir", "ur": "غریب"}}]}]}