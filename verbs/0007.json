quran": false, "notUsed": false, "spoken": "audio/d9524795398989a9a1ed.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "جِيئَا", "plain": "جِيئَا", "quran": false, "notUsed": false, "spoken": "audio/bc850cc157f5e6289d9d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "جِيئُوا", "plain": "جِيئُوا", "quran": false, "notUsed": false, "spoken": "audio/d29574340bf92bd6b30a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "جِئْنَ", "plain": "جِئْنَ", "quran": false, "notUsed": false, "spoken": "audio/a43736beb3c51145edea.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "80:2", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5760.mp3", "translation": {"en": {"text": "Because the blind man came unto him.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kendisine âmâ geldi, diye.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس پر کہ اس کے پاس وہ نابینا حاضر ہوا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "karena telah datang seorang buta kepadanya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "جَآءَهُ", "hit": true, "audio": "audio/a2f01269e3160b70e584.m4a", "gloss": {"bs": "došao mu je", "en": "came to him", "tr": "ona geldi", "fr": "est venu à lui", "id": "datang kepadanya", "ur": "اس کے پاس آیا", "bn": "তার কাছে এল", "fa": "نزد او آمد"}}, {"text": "ٱلْأَعْمَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "80:33", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5791.mp3", "translation": {"en": {"text": "But when the Shout cometh", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kulakları sağır eden o gürültü geldiğinde,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر جب آئے گی وہ کان پھاڑنے والی چنگھاڑ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan apabila datang suara yang memekakkan (tiupan sangkakala yang kedua),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "جَآءَتِ", "hit": true, "audio": "audio/2369a385d410ea924690.m4a", "gloss": {"en": "she/it came", "bs": "došla je", "tr": "geldi", "fr": "elle est venue", "id": "dia telah datang", "ur": "وہ آئی", "bn": "সে এল", "fa": "آمد"}}, {"text": "ٱلصَّآخَّةُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:16", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1612.mp3", "translation": {"en": {"text": "And they came weeping to their father in the evening.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve yatsı vakti, ağlayarak babalarına geldiler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور رات ہوئے اپنے باپ کے پاس روتے ہوئے آئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian mereka datang kepada ayah mereka di sore hari sambil menangis.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَجَآءُوٓ", "hit": true, "audio": "audio/913e7613c60c1c492e92.m4a", "gloss": {"en": "and they came", "bs": "i došli su", "tr": "ve geldiler", "fr": "et ils sont venus", "id": "dan mereka telah datang", "ur": "اور وہ آئے", "bn": "এবং তারা এল", "fa": "و آمدند"}}, {"text": "أَبَاهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عِشَآءً", "hit": false, "audio": null, "gloss": null}, {"text": "يَبْكُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:57", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2405.mp3", "translation": {"en": {"text": "He said: Hast come to drive us out from our land by thy magic, O Moses?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Firavun Musa'ya şöyle) dedi: \"Ey Musa! Sen sihrinle bizi yerimizden çıkarmak için mi geldin bize?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولا کیا تم ہمارے پاس اس لیے آئے ہو کہ ہمیں اپنے جادو کے سبب ہماری زمین سے نکال دو اے موسیٰ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berkata Fir'aun: \"Adakah kamu datang kepada kami untuk mengusir kami dari negeri kami (ini) dengan sihirmu, hai Musa?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجِئْتَنَا", "hit": true, "audio": "audio/169ed56de7130d9290ec.m4a", "gloss": {"en": "did you come to us?", "bs": "zar si nam došao?", "tr": "bize mi geldin?", "fr": "es-tu venu vers nous ?", "id": "apakah kamu telah datang kepada kami?", "ur": "کیا تم ہمارے پاس آئے؟", "bn": "তুমি কি আমাদের কাছে এসেছ?", "fa": "آیا نزد ما آمدی؟"}}, {"text": "لِتُخْرِجَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْضِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "بِسِحْرِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰمُوسَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:63", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1865.mp3", "translation": {"en": {"text": "They said: Nay, but we bring thee that concerning which they keep disputing,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Elçiler dediler ki: \"Bilakis biz sana onların şüphe ettiği azabı getirdik.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہا بلکہ ہم تو آپ کے پاس وہ لائے ہیں جس میں یہ لوگ شک کرتے تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Para utusan menjawab: \"Sebenarnya kami ini datang kepadamu dengan membawa azab yang selalu mereka dustakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "بَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "جِئْنَٰكَ", "hit": true, "audio": "audio/29f8867a8a3926d76d5f.m4a", "gloss": {"en": "we came to you", "bs": "došli smo ti", "tr": "sana geldik", "fr": "nous sommes venus vers toi", "id": "kami telah datang kepadamu", "ur": "ہم تمہارے پاس آئے", "bn": "আমরা তোমার কাছে এলাম", "fa": "نزد تو آمدیم"}}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَمْتَرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:30", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2962.mp3", "translation": {"en": {"text": "He said: Even though I show thee something plain?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa sordu: \"Sana apaçık bir şey getirmiş olsam da mı?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "فرمایا کیا اگرچہ میں تیرے پاس کوئی روشن چیز لاؤں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Musa berkata: \"Dan apakah (kamu akan melakukan itu) kendatipun aku tunjukkan kepadamu sesuatu (keterangan) yang nyata?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَوَلَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "جِئْتُكَ"