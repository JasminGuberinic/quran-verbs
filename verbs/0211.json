"notUsed": false, "spoken": "audio/8afd7fec5f94cbcc4447.m4a", "recited": "audio/25b977ad1e937434f698.m4a", "recitedText": "ٱقْرَءُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِقْرَأْنَ", "plain": "اِقْرَأْنَ", "quran": false, "notUsed": false, "spoken": "audio/5c7c2cbd576343627304.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "96:3", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6109.mp3", "translation": {"en": {"text": "Read: And thy Lord is the Most Bounteous,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Oku! Rabbin sonsuz kerem sahibidir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور تمہارا رب ہی سب سے بڑا کریم،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Bacalah, dan Tuhanmulah Yang Maha Pemurah,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱقْرَأْ", "hit": true, "audio": "audio/b08220e8de30bf45c3c4.m4a", "gloss": {"bs": "čitaj", "en": "read", "tr": "oku", "fr": "lis", "id": "bacalah", "ur": "پڑھو", "bn": "পাঠ করো", "fa": "بخوان"}}, {"text": "وَرَبُّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَكْرَمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "69:19", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5342.mp3", "translation": {"en": {"text": "Then, as for him who is given his record in his right hand, he will say: Take, read my book!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kitabı sağından verilen, \"alın okuyun kitabımı..\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو وہ جو اپنا نامہٴ اعمال دہنے ہاتھ میں دیا جائے گا کہے گا لو میرے نامہٴ اعمال پڑھو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Adapun orang-orang yang diberikan kepadanya kitabnya dari sebelah kanannya, maka dia berkata: \"Ambillah, bacalah kitabku (ini)\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أُوتِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "كِتَٰبَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "بِيَمِينِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "فَيَقُولُ", "hit": false, "audio": null, "gloss": null}, {"text": "هَآؤُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱقْرَءُوا۟", "hit": true, "audio": "audio/25b977ad1e937434f698.m4a", "gloss": {"en": "(you all) read!", "bs": "čitajte!", "tr": "okuyun!", "fr": "lisez !", "id": "bacalah kalian!", "ur": "پڑھو!", "bn": "পাঠ কর!", "fa": "بخوانید!"}}, {"text": "كِتَٰبِيَهْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "16:98", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1999.mp3", "translation": {"en": {"text": "And when thou recitest the Qur'an, seek refuge in Allah from Satan the outcast.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Şimdi Kur'ân okumak istediğin zaman önce o kovulmuş şeytandan Allah'a sığın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو جب تم قرآن پڑھو تو اللہ کی پناہ مانگو شیطان مردود سے،،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apabila kamu membaca Al Quran hendaklah kamu meminta perlindungan kepada Allah dari syaitan yang terkutuk.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "قَرَأْتَ", "hit": true, "audio": "audio/1a81c563ff9a8d7ae47f.m4a", "gloss": {"en": "you read", "bs": "čitao si", "tr": "okudun", "fr": "tu as lu", "id": "kamu telah membaca", "ur": "تم پڑھتے ہو", "bn": "তুমি পাঠ করেছ", "fa": "خواندی"}}, {"text": "ٱلْقُرْءَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱسْتَعِذْ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلشَّيْطَٰنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّجِيمِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "17:106", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2135.mp3", "translation": {"en": {"text": "And (it is) a Qur'an that We have divided, that thou mayst recite it unto mankind at intervals, and We have revealed it by (successive) revelation.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sana Kur'ân'ı verdik ve onu insanlara sindire sindire okuyasın diye (kısımlara) ayırdık ve biz onu yavaş yavaş indirdik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور قرآن ہم نے جدا جدا کرکے اتارا کہ تم اسے لوگوں پر ٹھہر ٹھہر کر پڑھو اور ہم نے اسے بتدریج رہ رہ کر اتارا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Al Quran itu telah Kami turunkan dengan berangsur-angsur agar kamu membacakannya perlahan-lahan kepada manusia dan Kami menurunkannya bagian demi bagian.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقُرْءَانًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَرَقْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "لِتَقْرَأَهُۥ", "hit": true, "audio": "audio/c98be90c25c8284e1725.m4a", "gloss": {"bs": "da ga učiš", "en": "so that you recite it", "tr": "onu okuman için", "fr": "afin que tu le récites", "id": "agar kamu membacakannya", "ur": "تاکہ تم اسے پڑھو", "bn": "যাতে তুমি তা পাঠ করো", "fa": "تا آن را بخوانی"}}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلنَّاسِ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "مُكْثٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَزَّلْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "تَنزِيلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:199", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3131.mp3", "translation": {"en": {"text": "And he had read it unto them, they would not have believed in it.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz onu Arapça bilmeyenlerden birine indirseydik de, bunu o okusaydı, yine de ona iman etmezlerdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ وہ انہیں پڑھ کر سناتا جب بھی اس پر ایمان نہ لاتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "lalu ia membacakannya kepada mereka (orang-orang kafir); niscaya mereka tidak akan beriman kepadanya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَقَرَأَهُۥ", "hit": true, "audio": "audio/ecb777e4482c59e1d425.m4a", "gloss": {"en": "so he/it read it", "bs": "pa ga je čitao", "tr": "böylece onu okudu", "fr": "alors il l'a lu", "id": "maka dia telah membacanya", "ur": "پس اُس نے اسے پڑھا", "bn": "অতএব সে তা পাঠ করল", "fa": "پس آن را خواند"}}, {"text": "عَلَيْهِم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "مُؤْمِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "75:18", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5569.mp3", "translation": {"en": {"text": "And when We read it, follow thou the reading;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O halde biz onu okuduğumuz zaman sen onun okunuşunu takip et.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو جب ہم اسے پڑھ چکیں اس وقت اس پڑھے ہوئے کی اتباع کرو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apabila Kami telah selesai membacakannya maka ikutilah bacaannya itu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "قَرَأْنَٰهُ", "hit": true, "audio": "audio/fb9b56208a9cb0c1b861.m4a", "gloss": {"bs": "učimo ga", "en": "We have recited it", "tr": "onu okuyoruz", "fr": "Nous l'avons récité", "id": "Kami telah membacakannya", "ur": "ہم نے اسے پڑھا", "bn": "আমরা তা পাঠ করেছি", "fa": "آن را قرائت کرده‌ایم"}}, {"text": "فَٱتَّبِعْ", "hit": false, "audio": null, "gloss": null}, {"text": "قُرْءَانَهُۥ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ٱقْرَأْ", "count": 3, "first": "17:14", "audio": "audio/b08220e8de30bf45c3c4.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"bs": "čitaj", "en": "read", "tr": "oku", "fr": "lis", "id": "bacalah", "ur": "پڑھو", "bn": "পাঠ করো", "fa": "بخوان"}}, {"arabic": "قُرِئَ", "count": 2, "first": "7:204", "audio": "audio/60a7002a714585b2c2d5.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "he/it was read", "bs": "pročitan je", "tr": "okundu", "fr": "il a été lu", "id": "telah dibacakan", "ur": "اسے پڑھا گیا", "bn": "তা পাঠ করা হয়েছে", "fa": "خوانده شد"}}, {"arabic": "يَقْرَءُونَ", "count": 2, "first": "10:94", "audio": "audio/53dc97fb2cc3ac0f545e.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they read", "bs": "čitaju", "tr":