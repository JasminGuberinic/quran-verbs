lse, "notUsed": false, "spoken": "audio/955a751012186962fe05.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "بَدِّلْ", "plain": "بَدِّلْ", "quran": false, "notUsed": false, "spoken": "audio/a53723c5b1debb3d9e01.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "بَدِّلِي", "plain": "بَدِّلِي", "quran": false, "notUsed": false, "spoken": "audio/57c33e901408fa4ecda2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "بَدِّلَا", "plain": "بَدِّلَا", "quran": false, "notUsed": false, "spoken": "audio/69c1c116ab603c9500a5.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "بَدِّلُوا", "plain": "بَدِّلُوا", "quran": false, "notUsed": false, "spoken": "audio/993a35a0a21943b4f10a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "بَدِّلْنَ", "plain": "بَدِّلْنَ", "quran": false, "notUsed": false, "spoken": "audio/5a3208dcd882be4abadc.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "76:28", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5619.mp3", "translation": {"en": {"text": "We, even We, created them, and strengthened their frame. And when We will, We can replace them, bringing others like them in their stead.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onları biz yarattık ve mafsallarını sımsıkı bağladık. Dilediğimiz vakit de kılıklarını değiştiririz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہم نے انہیں پیدا کیا اور ان کے جوڑ بند مضبوط کیے اور ہم جب چاہیں ان جیسے اور بدل دیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kami telah menciptakan mereka dan menguatkan persendian tubuh mereka, apabila Kami menghendaki, Kami sungguh-sungguh mengganti (mereka) dengan orang-orang yang serupa dengan mereka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "نَّحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقْنَٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَشَدَدْنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَسْرَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "شِئْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "بَدَّلْنَآ", "hit": true, "audio": "audio/1d63aabe5fda94ad5e12.m4a", "gloss": {"bs": "zamijenili bismo", "en": "We would replace", "tr": "değiştirirdik", "fr": "Nous aurions remplacé", "id": "Kami akan mengganti", "ur": "ہم بدل دیتے", "bn": "আমরা বদলে দিতাম", "fa": "جایگزین می‌کردیم"}}, {"text": "أَمْثَٰلَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَبْدِيلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "27:11", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3170.mp3", "translation": {"en": {"text": "Save him who hath done wrong and afterward hath changed evil for good. And lo! I am Forgiving, Merciful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ancak, kim haksızlık yapar, sonra yaptığı kötülüğü iyiliğe çevirirse, bilsin ki ben (ona karşı da) çok bağışlayıcıyım, çok merhamet sahibiyim.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہاں جو کوئی ز یادتی کرے پھر برائی کے بعد بھلائی سے بدلے تو بیشک میں بخشنے والا مہربان ہوں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "tetapi orang yang berlaku zalim, kemudian ditukarnya kezalimannya dengan kebaikan (Allah akan mengampuninya); maka seaungguhnya Aku Maha Pangampun lagi Maha Penyayang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "ظَلَمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "بَدَّلَ", "hit": true, "audio": "audio/407d4d4fcab3139b7247.m4a", "gloss": {"en": "he/it changed", "bs": "promijenio je", "tr": "değiştirdi", "fr": "il a changé", "id": "dia telah mengubah", "ur": "اُس نے بدلا", "bn": "সে পরিবর্তন করেছে", "fa": "تغییر داد"}}, {"text": "حُسْنًۢا", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْدَ", "hit": false, "audio": null, "gloss": null}, {"text": "سُوٓءٍ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "غَفُورٌ", "hit": false, "audio": null, "gloss": null}, {"text": "رَّحِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "14:28", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1778.mp3", "translation": {"en": {"text": "Hast thou not seen those who gave the grace of Allah in exchange for thanklessness and led their people down to the Abode of Loss,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah'ın nimetlerine nankörlükle karşılık veren ve sonunda milletlerini helak yurduna konduranları görmedin mi?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا تم نے انہیں نہ دیکھا جنہوں نے اللہ کی نعمت ناشکری سے بدل دی اور اپنی قوم کو تباہی کے گھر لا اتار،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tidakkah kamu perhatikan orang-orang yang telah menukar nikmat Allah dengan kekafiran dan menjatuhkan kaumnya ke lembah kebinasaan?,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَلَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَرَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "بَدَّلُوا۟", "hit": true, "audio": "audio/e2513bacb41120056c9c.m4a", "gloss": {"en": "they changed", "bs": "promijenili su", "tr": "değiştirdiler", "fr": "ils ont changé", "id": "mereka telah mengubah", "ur": "انہوں نے بدلا", "bn": "তারা পরিবর্তন করল", "fa": "تغییر دادند"}}, {"text": "نِعْمَتَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "كُفْرًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَحَلُّوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْمَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "دَارَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبَوَارِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "70:41", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5416.mp3", "translation": {"en": {"text": "To replace them by (others) better than them. And we are not to be outrun.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onları kendilerinden daha hayırlı olanlarla değiştirebiliriz ve bizim önümüze geçilmez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ ان سے اچھے بدل دیں اور ہم سے کوئی نکل کر نہیں جاسکتا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Untuk mengganti (mereka) dengan kaum yang lebih baik dari mereka, dan Kami sekali-kali tidak dapat dikalahkan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "نُّبَدِّلَ", "hit": true, "audio": "audio/50d9f92a24968d4de1c5.m4a", "gloss": {"bs": "zamijenimo", "en": "We replace", "tr": "değiştiririz", "fr": "Nous remplaçons", "id": "Kami mengganti", "ur": "ہم بدل دیں", "bn": "আমরা বদলে দিই", "fa": "جایگزین می‌کنیم"}}, {"text": "خَيْرًا", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "نَحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَسْبُوقِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "فَبَدَّلَ", "count": 2, "first": "2:59", "audio": "audio/d287e5d089d626f1f55f.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "so he/it changed", "bs": "pa je promijenio", "tr": "böylece değiştirdi", "fr": "alors il a changé", "id": "maka dia telah mengubah", "ur": "پس اُس نے بدلا", "bn": "অতএব সে পরিবর্তন করল", "fa": "پس تغییر داد"}}, {"arabic": "بَدَّلُوا۟", "count": 2, "first": "14:28", "audio": "audio/e2513bacb41120056c9c.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they changed", "bs": "promijenili su", "tr": "değiştirdiler", "fr": "ils ont changé", "id": "mereka telah mengubah", "ur": "انہوں نے بدلا", "bn": "তারা পরিবর্তন করল", "fa": "تغییر دادند"}}, {"arabic": "بَدَّلْنَآ", "count": 2, "first": "16:101", "audio": "audio/42737622fa0fc8e45b95.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"bs": "zamijenili bismo", "en": "We would replace", "tr": "değiştirirdik", "fr": "Nous aurions remplacé", "id": "Kami akan mengganti", "ur": "ہم بدل دیتے", "bn": "আমরা বদলে দিতাম", "fa": "جایگزین می‌کردیم"}}, {"arabic": "نُّبَدِّلَ", "count": 2, "first": "56:61", "audio": "audio/dc25b8dd142e919fc5d2.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"bs": "zamijenimo", "en": "We replace", "tr": "değiştiririz", "fr": "Nous remplaçons", "id": "Kami mengganti", "ur": "ہم بدل دیں", "bn": "আমরা বদলে দিই", "fa": "جایگزین می