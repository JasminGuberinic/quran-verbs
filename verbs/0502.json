 [{"text": "أُبَلِّغُكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "رِسَٰلَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّى", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنصَحُ", "hit": true, "audio": "audio/bd90534610e8308e8ab6.m4a", "gloss": {"bs": "i savjetujem", "en": "and I advise", "tr": "ve öğüt veriyorum", "fr": "et je conseille", "id": "dan aku menasihati", "ur": "اور میں خیرخواہی سے نصیحت کرتا ہوں", "bn": "এবং আমি উপদেশ দিই", "fa": "و خیرخواهانه اندرز می‌دهم"}}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَعْلَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْلَمُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَنَصَحْتُ", "count": 2, "first": "7:79", "audio": "audio/1b071c2fe86be32a9f2d.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": false, "objects": []}], "gloss": {"en": "and I advised", "bs": "i savjetovao sam", "tr": "ve öğüt verdim", "fr": "et je conseillai", "id": "dan aku menasihati", "ur": "اور میں نے نصیحت کی", "bn": "এবং আমি উপদেশ দিয়েছি", "fa": "و نصیحت کردم"}}, {"arabic": "وَأَنصَحُ", "count": 1, "first": "7:62", "audio": "audio/bd90534610e8308e8ab6.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "i savjetujem", "en": "and I advise", "tr": "ve öğüt veririm", "fr": "et je conseille", "id": "dan aku menasihati", "ur": "اور میں نصیحت کرتا ہوں", "bn": "এবং আমি উপদেশ দিই", "fa": "و نصیحت می‌کنم"}}, {"arabic": "نَصَحُوا۟", "count": 1, "first": "9:91", "audio": "audio/45c9620a953e4f3815ca.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they advised", "bs": "savjetovali su", "tr": "öğüt verdiler", "fr": "ils ont conseillé", "id": "mereka menasihati", "ur": "انہوں نے نصیحت کی", "bn": "তারা উপদেশ দিয়েছে", "fa": "نصیحت کردند"}}, {"arabic": "أَنصَحَ", "count": 1, "first": "11:34", "audio": "audio/51a1eafb6200290d3e85.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "I advise", "bs": "savjetujem", "tr": "öğüt veririm", "fr": "je conseille", "id": "aku menasihati", "ur": "میں نصیحت کرتا ہوں", "bn": "আমি উপদেশ দিই", "fa": "نصیحت کنم"}}], "ayatFile": "ayat/0502.json", "ayatTranslations": {"en": "ayat/0502.en.json", "tr": "ayat/0502.tr.json", "ur": "ayat/0502.ur.json", "id": "ayat/0502.id.json"}, "sentences": [{"arabic": "أَنْصَحُ صَدِيقِي بِالصَّبْرِ", "spoken": "audio/4f4bd7de3e42a1d4917b.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Savjetujem prijatelju strpljenje.", "en": "I advise my friend to be patient.", "bn": "আমি বন্ধুকে ধৈর্য ধরার উপদেশ দিই।", "fa": "به دوستم توصیه می‌کنم صبور باشد.", "fr": "Je conseille à mon ami d'être patient.", "id": "Aku menasihati temanku agar bersabar.", "tr": "Arkadaşıma sabretmesini öğütlerim.", "ur": "میں اپنے دوست کو صبر کی نصیحت کرتا ہوں۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَنْصَحُ", "target": true, "translation": {"bs": "savjetujem", "en": "advise", "bn": "উপদেশ দিই", "fa": "پند می‌دهم", "fr": "je conseille", "id": "aku menasihati", "tr": "öğüt veririm", "ur": "نصیحت کرتا ہوں"}}, {"arabic": "صَدِيقِي", "target": false, "translation": {"bs": "prijatelju", "en": "my friend", "bn": "আমার বন্ধু", "fa": "دوستم", "fr": "mon ami", "id": "temanku", "tr": "arkadaşım", "ur": "میرا دوست"}}, {"arabic": "بِالصَّبْرِ", "target": false, "translation": {"bs": "strpljenje", "en": "patience", "bn": "ধৈর্য", "fa": "صبر", "fr": "patience", "id": "kesabaran", "tr": "sabır", "ur": "صبر"}}]}, {"arabic": "نَصَحُوا الشَّابَّ بِالْعَمَلِ", "spoken": "audio/a6c7035db2a68514f760.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Savjetovali su mladiću da radi.", "en": "They advised the young man to work.", "bn": "তারা যুবকটিকে কাজ করার উপদেশ দিয়েছিল।", "fa": "به جوان توصیه کردند که کار کند.", "fr": "Ils ont conseillé au jeune homme de travailler.", "id": "Mereka menasihati pemuda itu agar bekerja.", "tr": "Gence çalışmasını öğütlediler.", "ur": "انہوں نے نوجوان کو کام کرنے کی نصیحت کی۔"}, "independentlyReviewed": true, "words": [{"arabic": "نَصَحُوا", "target": true, "translation": {"bs": "savjetovali su", "en": "advised", "bn": "উপদেশ দিয়েছে", "fa": "پند دادند", "fr": "ont conseillé", "id": "mereka menasihati", "tr": "öğüt verdiler", "ur": "نصیحت کی"}}, {"arabic": "الشَّابَّ", "target": false, "translation": {"bs": "mladiću", "en": "the young man", "bn": "যুবককে", "fa": "جوان", "fr": "au jeune homme", "id": "pemuda itu", "tr": "genç", "ur": "نوجوان"}}, {"arabic": "بِالْعَمَلِ", "target": false, "translation": {"bs": "da radi", "en": "to work", "bn": "কাজে", "fa": "به کار", "fr": "de travailler", "id": "untuk bekerja", "tr": "çalışması için", "ur": "کام کرنے کی"}}]}, {"arabic": "نَصَحْتُ أَخِي بِالرِّيَاضَةِ", "spoken": "audio/7e3d458c418a56dad61f.m4a", "tense": "past", "pronoun": "ana", "translation": {"bs": "Savjetovao sam bratu da vježba.", "en": "I advised my brother to exercise.", "bn": "আমি ভাইকে ব্যায়াম করার উপদেশ দিয়েছিলাম।", "fa": "به برادرم توصیه کردم که ورزش کند.", "fr": "J'ai conseillé à mon frère de s'entraîner.", "id": "Aku menasihati saudaraku agar berolahraga.", "tr": "Kardeşime egzersiz yapmasını öğütledim.", "ur": "میں نے اپنے بھائی کو ورزش کی نصیحت کی۔"}, "independentlyReviewed": true, "words": [{"arabic": "نَصَحْتُ", "target": true, "translation": {"bs": "savjetovao sam", "en": "advised", "bn": "উপদেশ দিলাম", "fa": "پند دادم", "fr": "j'ai conseillé", "id": "aku menasihati", "tr": "öğüt verdim", "ur": "نصیحت کی"}}, {"arabic": "أَخِي", "target": false, "translation": {"bs": "bratu", "en": "my brother", "bn": "আমার ভাই", "fa": "برادرم", "fr": "mon frère", "id": "saudaraku", "tr": "kardeşim", "ur": "میرا بھائی"}}, {"arabic": "بِالرِّيَاضَةِ", "target": false, "translation": {"bs": "da vježba", "en": "to exercise", "bn": "ব্যায়াম", "fa": "به ورزش", "fr": "de s'entraîner", "id": "untuk berolahraga", "tr": "egzersiz yapması için", "ur": "ورزش"}}]}]}