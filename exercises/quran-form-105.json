[{"id":"allama-2-129-8","words":["verb:allama"],"options":[{"bs":"i poučava ih","en":"and he/it teaches them"},{"bs":"naučio si nas","en":"you taught us"},{"bs":"naučio me je","en":"he/it taught me"},{"bs":"i poučit će ga","en":"and He will teach him"}],"ref":"2:129","answerWord":"وَيُعَلِّمُهُمُ","answerSound":"audio/9e61ffa396475a6039b7.m4a","quranTranslation":{"text":"Our Lord! And raise up in their midst a messenger from among them who shall recite unto them Thy revelations, and shall instruct them in the Scripture and in wisdom and shall make them grow. Lo! Thou, only Thou, art the Mighty, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["رَبَّنَا","وَٱبْعَثْ","فِيهِمْ","رَسُولًا","مِّنْهُمْ","يَتْلُوا۟","عَلَيْهِمْ","ءَايَٰتِكَ","وَيُعَلِّمُهُمُ","ٱلْكِتَٰبَ","وَٱلْحِكْمَةَ","وَيُزَكِّيهِمْ","إِنَّكَ","أَنتَ","ٱلْعَزِيزُ","ٱلْحَكِيمُ"],"marked":[8],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-55-2-0","words":["verb:allama"],"options":[{"bs":"naučio je","en":"he/it taught"},{"bs":"poučio ga je","en":"taught him"},{"bs":"i poučava vas","en":"and he/it teaches you (all)"},{"bs":"poučava ga","en":"he/it teaches him"}],"ref":"55:2","answerWord":"عَلَّمَ","answerSound":"audio/fb1a42475abce7bd9120.m4a","quranTranslation":{"text":"Hath made known the Qur'an.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["عَلَّمَ","ٱلْقُرْءَانَ"],"marked":[0],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-2-151-9","words":["verb:allama"],"options":[{"bs":"i poučava vas","en":"and he/it teaches you (all)"},{"bs":"naučio vas je","en":"he/it taught you (all)"},{"bs":"i naučio je","en":"and he/it taught"},{"bs":"zar poučavate?","en":"do you (all) teach?"}],"ref":"2:151","answerWord":"وَيُعَلِّمُكُمُ","answerSound":"audio/96c6878c7fabb0a81035.m4a","quranTranslation":{"text":"Even as We have sent unto you a messenger from among you, who reciteth unto you Our revelations and causeth you to grow, and teacheth you the Scripture and wisdom, and teacheth you that which ye knew not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["كَمَآ","أَرْسَلْنَا","فِيكُمْ","رَسُولًا","مِّنكُمْ","يَتْلُوا۟","عَلَيْكُمْ","ءَايَٰتِنَا","وَيُزَكِّيكُمْ","وَيُعَلِّمُكُمُ","ٱلْكِتَٰبَ","وَٱلْحِكْمَةَ","وَيُعَلِّمُكُم","مَّا","لَمْ","تَكُونُوا۟","تَعْلَمُونَ"],"marked":[9],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-12-68-24","words":["verb:allama"],"options":[{"bs":"naučili smo ga","en":"we taught him"},{"bs":"poučio ga je","en":"taught him"},{"bs":"poučavaju","en":"they (two) teach"},{"bs":"naučio vas je","en":"he/it taught you (all)"}],"ref":"12:68","answerWord":"عَلَّمْنَٰهُ","answerSound":"audio/d0311497273fcab7bb64.m4a","quranTranslation":{"text":"And when they entered in the manner which their father had enjoined, it would have naught availed them as against Allah; it was but a need of Jacob's soul which he thus satisfied; and lo! he was a lord of knowledge because We had taught him; but most of mankind know not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["وَلَمَّا","دَخَلُوا۟","مِنْ","حَيْثُ","أَمَرَهُمْ","أَبُوهُم","مَّا","كَانَ","يُغْنِى","عَنْهُم","مِّنَ","ٱللَّهِ","مِن","شَىْءٍ","إِلَّا","حَاجَةً","فِى","نَفْسِ","يَعْقُوبَ","قَضَىٰهَا","وَإِنَّهُۥ","لَذُو","عِلْمٍ","لِّمَا","عَلَّمْنَٰهُ","وَلَٰكِنَّ","أَكْثَرَ","ٱلنَّاسِ","لَا","يَعْلَمُونَ"],"marked":[24],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-21-80-0","words":["verb:allama"],"options":[{"bs":"i naučili smo ga","en":"and we taught him"},{"bs":"i naučio si me","en":"and you taught me"},{"bs":"naučen si","en":"you were taught"},{"bs":"i naučeni ste","en":"and you (all) were taught"}],"ref":"21:80","answerWord":"وَعَلَّمْنَٰهُ","answerSound":"audio/ec2c30256ba222febf17.m4a","quranTranslation":{"text":"And We taught him the art of making garments (of mail) to protect you in your daring. Are ye then thankful?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["وَعَلَّمْنَٰهُ","صَنْعَةَ","لَبُوسٍ","لَّكُمْ","لِتُحْصِنَكُم","مِّنۢ","بَأْسِكُمْ","فَهَلْ","أَنتُمْ","شَٰكِرُونَ"],"marked":[0],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-2-31-0","words":["verb:allama"],"options":[{"bs":"i naučio je","en":"and he/it taught"},{"bs":"i naučio te je","en":"and he/it taught you"},{"bs":"naučen si","en":"you were taught"},{"bs":"i poučava vas","en":"and he/it teaches you (all)"}],"ref":"2:31","answerWord":"وَعَلَّمَ","answerSound":"audio/94bc39deeddbd07950aa.m4a","quranTranslation":{"text":"And He taught Adam all the names, then showed them to the angels, saying: Inform Me of the names of these, if ye are truthful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["وَعَلَّمَ","ءَادَمَ","ٱلْأَسْمَآءَ","كُلَّهَا","ثُمَّ","عَرَضَهُمْ","عَلَى","ٱلْمَلَٰٓئِكَةِ","فَقَالَ","أَنۢبِـُٔونِى","بِأَسْمَآءِ","هَٰٓؤُلَآءِ","إِن","كُنتُمْ","صَٰدِقِينَ"],"marked":[0],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-2-32-7","words":["verb:allama"],"options":[{"bs":"naučio si nas","en":"you taught us"},{"bs":"i poučava vas","en":"and he/it teaches you (all)"},{"bs":"naučio je","en":"he/it taught"},{"bs":"i naučio si me","en":"and you taught me"}],"ref":"2:32","answerWord":"عَلَّمْتَنَآ","answerSound":"audio/d7deffb572c7e72fae5f.m4a","quranTranslation":{"text":"They said: Be glorified! We have no knowledge saving that which Thou hast taught us. Lo! Thou, only Thou, art the Knower, the Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["قَالُوا۟","سُبْحَٰنَكَ","لَا","عِلْمَ","لَنَآ","إِلَّا","مَا","عَلَّمْتَنَآ","إِنَّكَ","أَنتَ","ٱلْعَلِيمُ","ٱلْحَكِيمُ"],"marked":[7],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-2-151-12","words":["verb:allama"],"options":[{"bs":"i poučava vas","en":"and he/it teaches you (all)"},{"bs":"poučavaju","en":"they teach"},{"bs":"naučili ste","en":"you (all) taught"},{"bs":"i naučeni ste","en":"and you (all) were taught"}],"ref":"2:151","answerWord":"وَيُعَلِّمُكُم","answerSound":"audio/6145532ead07394b8ed0.m4a","quranTranslation":{"text":"Even as We have sent unto you a messenger from among you, who reciteth unto you Our revelations and causeth you to grow, and teacheth you the Scripture and wisdom, and teacheth you that which ye knew not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["كَمَآ","أَرْسَلْنَا","فِيكُمْ","رَسُولًا","مِّنكُمْ","يَتْلُوا۟","عَلَيْكُمْ","ءَايَٰتِنَا","وَيُزَكِّيكُمْ","وَيُعَلِّمُكُمُ","ٱلْكِتَٰبَ","وَٱلْحِكْمَةَ","وَيُعَلِّمُكُم","مَّا","لَمْ","تَكُونُوا۟","تَعْلَمُونَ"],"marked":[12],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-2-239-10","words":["verb:allama"],"options":[{"bs":"naučio vas je","en":"he/it taught you (all)"},{"bs":"zar poučavate?","en":"do you (all) teach?"},{"bs":"naučili ste","en":"you (all) taught"},{"bs":"i naučio te je","en":"and he/it taught you"}],"ref":"2:239","answerWord":"عَلَّمَكُم","answerSound":"audio/307ee9960d5a0bfb0da1.m4a","quranTranslation":{"text":"And if ye go in fear, then (pray) standing or on horseback. And when ye are again in safety, remember Allah, as He hath taught you that which (heretofore) ye knew not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["فَإِنْ","خِفْتُمْ","فَرِجَالًا","أَوْ","رُكْبَانًا","فَإِذَآ","أَمِنتُمْ","فَٱذْكُرُوا۟","ٱللَّهَ","كَمَا","عَلَّمَكُم","مَّا","لَمْ","تَكُونُوا۟","تَعْلَمُونَ"],"marked":[10],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-2-251-10","words":["verb:allama"],"options":[{"bs":"i naučio ga je","en":"and he/it taught him"},{"bs":"naučeni smo","en":"we were taught"},{"bs":"naučio me je","en":"he/it taught me"},{"bs":"poučava ga","en":"he/it teaches him"}],"ref":"2:251","answerWord":"وَعَلَّمَهُۥ","answerSound":"audio/1919d66bc0da4021bb20.m4a","quranTranslation":{"text":"So they routed them by Allah's leave and David slew Goliath; and Allah gave him the kingdom and wisdom, and taught him of that which He willeth. And if Allah had not repelled some men by others the earth would have been corrupted. But Allah is a Lord of Kindness to (His) creatures.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["فَهَزَمُوهُم","بِإِذْنِ","ٱللَّهِ","وَقَتَلَ","دَاوُۥدُ","جَالُوتَ","وَءَاتَىٰهُ","ٱللَّهُ","ٱلْمُلْكَ","وَٱلْحِكْمَةَ","وَعَلَّمَهُۥ","مِمَّا","يَشَآءُ","وَلَوْلَا","دَفْعُ","ٱللَّهِ","ٱلنَّاسَ","بَعْضَهُم","بِبَعْضٍ","لَّفَسَدَتِ","ٱلْأَرْضُ","وَلَٰكِنَّ","ٱللَّهَ","ذُو","فَضْلٍ","عَلَى","ٱلْعَٰلَمِينَ"],"marked":[10],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-3-48-0","words":["verb:allama"],"options":[{"bs":"i poučit će ga","en":"and He will teach him"},{"bs":"i naučeni ste","en":"and you (all) were taught"},{"bs":"i naučio si me","en":"and you taught me"},{"bs":"i poučava ih","en":"and he/it teaches them"}],"ref":"3:48","answerWord":"وَيُعَلِّمُهُ","answerSound":"audio/925a4f3448712de9fbdb.m4a","quranTranslation":{"text":"And He will teach him the Scripture and wisdom, and the Torah and the Gospel,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["وَيُعَلِّمُهُ","ٱلْكِتَٰبَ","وَٱلْحِكْمَةَ","وَٱلتَّوْرَىٰةَ","وَٱلْإِنجِيلَ"],"marked":[0],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-3-79-23","words":["verb:allama"],"options":[{"bs":"poučavate","en":"you (all) teach"},{"bs":"naučio me je","en":"he/it taught me"},{"bs":"i naučeni ste","en":"and you (all) were taught"},{"bs":"i naučio te je","en":"and he/it taught you"}],"ref":"3:79","answerWord":"تُعَلِّمُونَ","answerSound":"audio/5e0ab04803eaf8a57863.m4a","quranTranslation":{"text":"It is not (possible) for any human being unto whom Allah had given the Scripture and wisdom and the prophethood that he should afterwards have said unto mankind: Be slaves of me instead of Allah; but (what he said was): Be ye faithful servants of the Lord by virtue of your constant teaching of the Scripture and of your constant study thereof.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["مَا","كَانَ","لِبَشَرٍ","أَن","يُؤْتِيَهُ","ٱللَّهُ","ٱلْكِتَٰبَ","وَٱلْحُكْمَ","وَٱلنُّبُوَّةَ","ثُمَّ","يَقُولَ","لِلنَّاسِ","كُونُوا۟","عِبَادًا","لِّى","مِن","دُونِ","ٱللَّهِ","وَلَٰكِن","كُونُوا۟","رَبَّٰنِيِّۦنَ","بِمَا","كُنتُمْ","تُعَلِّمُونَ","ٱلْكِتَٰبَ","وَبِمَا","كُنتُمْ","تَدْرُسُونَ"],"marked":[23],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-12-6-3","words":["verb:allama"],"options":[{"bs":"i poučava te","en":"and he/it teaches you"},{"bs":"naučio vas je","en":"he/it taught you (all)"},{"bs":"poučavaju","en":"they (two) teach"},{"bs":"naučili smo ga","en":"we taught him"}],"ref":"12:6","answerWord":"وَيُعَلِّمُكَ","answerSound":"audio/911d9b27aab45a4779c9.m4a","quranTranslation":{"text":"Thus thy Lord will prefer thee and will teach thee the interpretation of events, and will perfect His grace upon thee and upon the family of Jacob as He perfected it upon thy forefathers, Abraham and Isaac. Lo! thy Lord is Knower, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["وَكَذَٰلِكَ","يَجْتَبِيكَ","رَبُّكَ","وَيُعَلِّمُكَ","مِن","تَأْوِيلِ","ٱلْأَحَادِيثِ","وَيُتِمُّ","نِعْمَتَهُۥ","عَلَيْكَ","وَعَلَىٰٓ","ءَالِ","يَعْقُوبَ","كَمَآ","أَتَمَّهَا","عَلَىٰٓ","أَبَوَيْكَ","مِن","قَبْلُ","إِبْرَٰهِيمَ","وَإِسْحَٰقَ","إِنَّ","رَبَّكَ","عَلِيمٌ","حَكِيمٌ"],"marked":[3],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-12-37-13","words":["verb:allama"],"options":[{"bs":"naučio me je","en":"he/it taught me"},{"bs":"i poučava ih","en":"and he/it teaches them"},{"bs":"naučili ste","en":"you (all) taught"},{"bs":"poučio ga je","en":"taught him"}],"ref":"12:37","answerWord":"عَلَّمَنِى","answerSound":"audio/16987a8e6d27afe78ce8.m4a","quranTranslation":{"text":"He said: The food which ye are given (daily) shall not come unto you but I shall tell you the interpretation ere it cometh unto you. This is of that which my Lord hath taught me. Lo! I have forsaken the religion of folk who believe not in Allah and are disbelievers in the Hereafter.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["قَالَ","لَا","يَأْتِيكُمَا","طَعَامٌ","تُرْزَقَانِهِۦٓ","إِلَّا","نَبَّأْتُكُمَا","بِتَأْوِيلِهِۦ","قَبْلَ","أَن","يَأْتِيَكُمَا","ذَٰلِكُمَا","مِمَّا","عَلَّمَنِى","رَبِّىٓ","إِنِّى","تَرَكْتُ","مِلَّةَ","قَوْمٍ","لَّا","يُؤْمِنُونَ","بِٱللَّهِ","وَهُم","بِٱلْءَاخِرَةِ","هُمْ","كَٰفِرُونَ"],"marked":[13],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-12-101-5","words":["verb:allama"],"options":[{"bs":"i naučio si me","en":"and you taught me"},{"bs":"naučili smo ga","en":"we taught him"},{"bs":"i poučava vas","en":"and he/it teaches you (all)"},{"bs":"naučio je","en":"he/it taught"}],"ref":"12:101","answerWord":"وَعَلَّمْتَنِى","answerSound":"audio/9d4e28fbc03598e97503.m4a","quranTranslation":{"text":"O my Lord! Thou hast given me (something) of sovereignty and hast taught me (something) of the interpretation of events - Creator of the heavens and the earth! Thou art my Protecting Guardian in the world and the Hereafter. Make me to die muslim (unto Thee), and join me to the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["رَبِّ","قَدْ","ءَاتَيْتَنِى","مِنَ","ٱلْمُلْكِ","وَعَلَّمْتَنِى","مِن","تَأْوِيلِ","ٱلْأَحَادِيثِ","فَاطِرَ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","أَنتَ","وَلِىِّۦ","فِى","ٱلدُّنْيَا","وَٱلْءَاخِرَةِ","تَوَفَّنِى","مُسْلِمًا","وَأَلْحِقْنِى","بِٱلصَّٰلِحِينَ"],"marked":[5],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-16-103-5","words":["verb:allama"],"options":[{"bs":"poučava ga","en":"he/it teaches him"},{"bs":"i naučio si me","en":"and you taught me"},{"bs":"i poučava ih","en":"and he/it teaches them"},{"bs":"naučio vas je","en":"he/it taught you (all)"}],"ref":"16:103","answerWord":"يُعَلِّمُهُۥ","answerSound":"audio/87ccd188aaa3dffade17.m4a","quranTranslation":{"text":"And We know well that they say: Only a man teacheth him. The speech of him at whom they falsely hint is outlandish, and this is clear Arabic speech.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["وَلَقَدْ","نَعْلَمُ","أَنَّهُمْ","يَقُولُونَ","إِنَّمَا","يُعَلِّمُهُۥ","بَشَرٌ","لِّسَانُ","ٱلَّذِى","يُلْحِدُونَ","إِلَيْهِ","أَعْجَمِىٌّ","وَهَٰذَا","لِسَانٌ","عَرَبِىٌّ","مُّبِينٌ"],"marked":[5],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-18-66-9","words":["verb:allama"],"options":[{"bs":"naučen si","en":"you were taught"},{"bs":"naučili ste","en":"you (all) taught"},{"bs":"poučio ga je","en":"taught him"},{"bs":"i poučit će ga","en":"and He will teach him"}],"ref":"18:66","answerWord":"عُلِّمْتَ","answerSound":"audio/1c87504c328a4112036e.m4a","quranTranslation":{"text":"Moses said unto him: May I follow thee, to the end that thou mayst teach me right conduct of that which thou hast been taught?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["قَالَ","لَهُۥ","مُوسَىٰ","هَلْ","أَتَّبِعُكَ","عَلَىٰٓ","أَن","تُعَلِّمَنِ","مِمَّا","عُلِّمْتَ","رُشْدًا"],"marked":[9],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-27-16-6","words":["verb:allama"],"options":[{"bs":"naučeni smo","en":"we were taught"},{"bs":"i poučava ih","en":"and he/it teaches them"},{"bs":"poučavaju","en":"they (two) teach"},{"bs":"naučio si nas","en":"you taught us"}],"ref":"27:16","answerWord":"عُلِّمْنَا","answerSound":"audio/2284a9c14bfa1ae14f59.m4a","quranTranslation":{"text":"And Solomon was David's heir. And he said: O mankind! Lo! we have been taught the language of birds, and have been given (abundance) of all things. This surely is evident favour.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["وَوَرِثَ","سُلَيْمَٰنُ","دَاوُۥدَ","وَقَالَ","يَٰٓأَيُّهَا","ٱلنَّاسُ","عُلِّمْنَا","مَنطِقَ","ٱلطَّيْرِ","وَأُوتِينَا","مِن","كُلِّ","شَىْءٍ","إِنَّ","هَٰذَا","لَهُوَ","ٱلْفَضْلُ","ٱلْمُبِينُ"],"marked":[6],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-49-16-1","words":["verb:allama"],"options":[{"bs":"zar poučavate?","en":"do you (all) teach?"},{"bs":"naučio vas je","en":"he/it taught you (all)"},{"bs":"naučio je","en":"he/it taught"},{"bs":"naučio si nas","en":"you taught us"}],"ref":"49:16","answerWord":"أَتُعَلِّمُونَ","answerSound":"audio/7534ac0c937b4f68d60a.m4a","quranTranslation":{"text":"Say (unto them, O Muhammad): Would ye teach Allah your religion, when Allah knoweth all that is in the heavens and all that is in the earth, and Allah is Aware of all things?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["قُلْ","أَتُعَلِّمُونَ","ٱللَّهَ","بِدِينِكُمْ","وَٱللَّهُ","يَعْلَمُ","مَا","فِى","ٱلسَّمَٰوَٰتِ","وَمَا","فِى","ٱلْأَرْضِ","وَٱللَّهُ","بِكُلِّ","شَىْءٍ","عَلِيمٌ"],"marked":[1],"facts":{"verb":"عَلَّمَ"}},{"id":"allama-53-5-0","words":["verb:allama"],"options":[{"bs":"poučio ga je","en":"taught him"},{"bs":"naučio vas je","en":"he/it taught you (all)"},{"bs":"zar poučavate?","en":"do you (all) teach?"},{"bs":"naučen si","en":"you were taught"}],"ref":"53:5","answerWord":"عَلَّمَهُۥ","answerSound":"audio/b1adc8a22a46fab0fd96.m4a","quranTranslation":{"text":"Which one of mighty powers hath taught him,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"poučiti, naučiti","en":"to teach"},"passage":["عَلَّمَهُۥ","شَدِيدُ","ٱلْقُوَىٰ"],"marked":[0],"facts":{"verb":"عَلَّمَ"}},{"id":"qama-83-6-1","words":["verb:qama"],"options":[{"bs":"stoji","en":"he/it stands"},{"bs":"ustani","en":"stand"},{"bs":"stanu","en":"they (two) stand"},{"bs":"ustali su","en":"they stood"}],"ref":"83:6","answerWord":"يَقُومُ","answerSound":"audio/9d7e9b95113838f32cf5.m4a","quranTranslation":{"text":"The day when (all) mankind stand before the Lord of the Worlds?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustati, stajati","en":"to stand, to rise"},"passage":["يَوْمَ","يَقُومُ","ٱلنَّاسُ","لِرَبِّ","ٱلْعَٰلَمِينَ"],"marked":[1],"facts":{"verb":"قامَ"}},{"id":"qama-2-20-12","words":["verb:qama"],"options":[{"bs":"ustali su","en":"they stood"},{"bs":"stani!","en":"stand!"},{"bs":"stoji","en":"he/it stands"},{"bs":"stojite","en":"you (all) stand"}],"ref":"2:20","answerWord":"قَامُوا۟","answerSound":"audio/9ff9bec7ac7f460bdea6.m4a","quranTranslation":{"text":"The lightning almost snatcheth away their sight from them. As often as it flasheth forth for them they walk therein, and when it darkeneth against them they stand still. If Allah willed, He could destroy their hearing and their sight. Lo! Allah is able to do all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustati, stajati","en":"to stand, to rise"},"passage":["يَكَادُ","ٱلْبَرْقُ","يَخْطَفُ","أَبْصَٰرَهُمْ","كُلَّمَآ","أَضَآءَ","لَهُم","مَّشَوْا۟","فِيهِ","وَإِذَآ","أَظْلَمَ","عَلَيْهِمْ","قَامُوا۟","وَلَوْ","شَآءَ","ٱللَّهُ","لَذَهَبَ","بِسَمْعِهِمْ","وَأَبْصَٰرِهِمْ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَىْءٍ","قَدِيرٌ"],"marked":[12],"facts":{"verb":"قامَ"}},{"id":"qama-2-238-5","words":["verb:qama"],"options":[{"bs":"i stanite!","en":"and (you all) stand!"},{"bs":"stojite","en":"you (all) stand"},{"bs":"ustao je","en":"stood"},{"bs":"stani!","en":"stand!"}],"ref":"2:238","answerWord":"وَقُومُوا۟","answerSound":"audio/c2ef2411bb7c39aa1174.m4a","quranTranslation":{"text":"Be guardians of your prayers, and of the midmost prayer, and stand up with devotion to Allah.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustati, stajati","en":"to stand, to rise"},"passage":["حَٰفِظُوا۟","عَلَى","ٱلصَّلَوَٰتِ","وَٱلصَّلَوٰةِ","ٱلْوُسْطَىٰ","وَقُومُوا۟","لِلَّهِ","قَٰنِتِينَ"],"marked":[5],"facts":{"verb":"قامَ"}},{"id":"qama-4-142-7","words":["verb:qama"],"options":[{"bs":"ustali su","en":"they stood"},{"bs":"ustao je","en":"stood"},{"bs":"stoji","en":"he/it stands"},{"bs":"ustaju","en":"they rise"}],"ref":"4:142","answerWord":"قَامُوٓا۟","answerSound":"audio/a40f4b891f79f0e5f5d1.m4a","quranTranslation":{"text":"Lo! the hypocrites seek to beguile Allah, but it is He Who beguileth them. When they stand up to worship they perform it languidly and to be seen of men, and are mindful of Allah but little;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustati, stajati","en":"to stand, to rise"},"passage":["إِنَّ","ٱلْمُنَٰفِقِينَ","يُخَٰدِعُونَ","ٱللَّهَ","وَهُوَ","خَٰدِعُهُمْ","وَإِذَا","قَامُوٓا۟","إِلَى","ٱلصَّلَوٰةِ","قَامُوا۟","كُسَالَىٰ","يُرَآءُونَ","ٱلنَّاسَ","وَلَا","يَذْكُرُونَ","ٱللَّهَ","إِلَّا","قَلِيلًا"],"marked":[7],"facts":{"verb":"قامَ"}},{"id":"qama-57-25-8","words":["verb:qama"],"options":[{"bs":"da ustane","en":"so that he/it may stand"},{"bs":"stanu","en":"they (two) stand"},{"bs":"ustani","en":"stand"},{"bs":"i stanite!","en":"and (you all) stand!"}],"ref":"57:25","answerWord":"لِيَقُومَ","answerSound":"audio/92edffa4f9c91fe6fee0.m4a","quranTranslation":{"text":"We verily sent Our messengers with clear proofs, and revealed with them the Scripture and the Balance, that mankind may observe right measure; and He revealed iron, wherein is mighty power and (many) uses for mankind, and that Allah may know him who helpeth Him and His messengers, though unseen. Lo! Allah is Strong, Almighty.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustati, stajati","en":"to stand, to rise"},"passage":["لَقَدْ","أَرْسَلْنَا","رُسُلَنَا","بِٱلْبَيِّنَٰتِ","وَأَنزَلْنَا","مَعَهُمُ","ٱلْكِتَٰبَ","وَٱلْمِيزَانَ","لِيَقُومَ","ٱلنَّاسُ","بِٱلْقِسْطِ","وَأَنزَلْنَا","ٱلْحَدِيدَ","فِيهِ","بَأْسٌ","شَدِيدٌ","وَمَنَٰفِعُ","لِلنَّاسِ","وَلِيَعْلَمَ","ٱللَّهُ","مَن","يَنصُرُهُۥ","وَرُسُلَهُۥ","بِٱلْغَيْبِ","إِنَّ","ٱللَّهَ","قَوِىٌّ","عَزِيزٌ"],"marked":[8],"facts":{"verb":"قامَ"}},{"id":"qama-72-19-2","words":["verb:qama"],"options":[{"bs":"ustao je","en":"stood"},{"bs":"ustali su","en":"they stood"},{"bs":"da ustane","en":"so that he/it may stand"},{"bs":"stani!","en":"stand!"}],"ref":"72:19","answerWord":"قَامَ","answerSound":"audio/f2567b20498da3393ee1.m4a","quranTranslation":{"text":"And when the slave of Allah stood up in prayer to Him, they crowded on him, almost stifling.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustati, stajati","en":"to stand, to rise"},"passage":["وَأَنَّهُۥ","لَمَّا","قَامَ","عَبْدُ","ٱللَّهِ","يَدْعُوهُ","كَادُوا۟","يَكُونُونَ","عَلَيْهِ","لِبَدًا"],"marked":[2],"facts":{"verb":"قامَ"}},{"id":"qama-73-2-0","words":["verb:qama"],"options":[{"bs":"ustani","en":"stand"},{"bs":"ustaju","en":"they rise"},{"bs":"i stanite!","en":"and (you all) stand!"},{"bs":"stoji","en":"he/it stands"}],"ref":"73:2","answerWord":"قُمِ","answerSound":"audio/33a076aebd73b7c0ec96.m4a","quranTranslation":{"text":"Keep vigil the night long, save a little -","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustati, stajati","en":"to stand, to rise"},"passage":["قُمِ","ٱلَّيْلَ","إِلَّا","قَلِيلًا"],"marked":[0],"facts":{"verb":"قامَ"}},{"id":"qama-74-2-0","words":["verb:qama"],"options":[{"bs":"stani!","en":"stand!"},{"bs":"ustali su","en":"they stood"},{"bs":"stanu","en":"they (two) stand"},{"bs":"stojite","en":"you (all) stand"}],"ref":"74:2","answerWord":"قُمْ","answerSound":"audio/575b49292e42539ed3ff.m4a","quranTranslation":{"text":"Arise and warn!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustati, stajati","en":"to stand, to rise"},"passage":["قُمْ","فَأَنذِرْ"],"marked":[0],"facts":{"verb":"قامَ"}},{"id":"abda-5-99-8","words":["verb:abda"],"options":[{"bs":"pokazujete","en":"you reveal"},{"bs":"pokazujete ga","en":"you (all) show it"},{"bs":"da pokaže","en":"so that he/it may show"},{"bs":"pokazuju","en":"they show"}],"ref":"5:99","answerWord":"تُبْدُونَ","answerSound":"audio/298ff99be5a1892801b0.m4a","quranTranslation":{"text":"The duty of the messenger is only to convey (the message). Allah knoweth what ye proclaim and what ye hide.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pokazati, otkriti","en":"to show, to reveal"},"passage":["مَّا","عَلَى","ٱلرَّسُولِ","إِلَّا","ٱلْبَلَٰغُ","وَٱللَّهُ","يَعْلَمُ","مَا","تُبْدُونَ","وَمَا","تَكْتُمُونَ"],"marked":[8],"facts":{"verb":"أَبْدَى"}},{"id":"abda-3-29-7","words":["verb:abda"],"options":[{"bs":"pokazujete ga","en":"you (all) show it"},{"bs":"da pokaže","en":"so that he/it may show"},{"bs":"pokazuju","en":"they show"},{"bs":"pokazujete","en":"you reveal"}],"ref":"3:29","answerWord":"تُبْدُوهُ","answerSound":"audio/1c676d3f8102802f47cf.m4a","quranTranslation":{"text":"Say, (O Muhammad): Whether ye hide that which is in your breasts or reveal it, Allah knoweth it. He knoweth that which is in the heavens and that which is in the earth, and Allah is Able to do all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pokazati, otkriti","en":"to show, to reveal"},"passage":["قُلْ","إِن","تُخْفُوا۟","مَا","فِى","صُدُورِكُمْ","أَوْ","تُبْدُوهُ","يَعْلَمْهُ","ٱللَّهُ","وَيَعْلَمُ","مَا","فِى","ٱلسَّمَٰوَٰتِ","وَمَا","فِى","ٱلْأَرْضِ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَىْءٍ","قَدِيرٌ"],"marked":[7],"facts":{"verb":"أَبْدَى"}},{"id":"abda-7-20-3","words":["verb:abda"],"options":[{"bs":"da pokaže","en":"so that he/it may show"},{"bs":"pokazuje je","en":"he/it shows it"},{"bs":"pokazuju","en":"they show"},{"bs":"pokazujete ga","en":"you (all) show it"}],"ref":"7:20","answerWord":"لِيُبْدِىَ","answerSound":"audio/49926f70c35fc9e61030.m4a","quranTranslation":{"text":"Then Satan whispered to them that he might manifest unto them that which was hidden from them of their shame, and he said: Your Lord forbade you from this tree only lest ye should become angels or become of the immortals.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pokazati, otkriti","en":"to show, to reveal"},"passage":["فَوَسْوَسَ","لَهُمَا","ٱلشَّيْطَٰنُ","لِيُبْدِىَ","لَهُمَا","مَا","وُۥرِىَ","عَنْهُمَا","مِن","سَوْءَٰتِهِمَا","وَقَالَ","مَا","نَهَىٰكُمَا","رَبُّكُمَا","عَنْ","هَٰذِهِ","ٱلشَّجَرَةِ","إِلَّآ","أَن","تَكُونَا","مَلَكَيْنِ","أَوْ","تَكُونَا","مِنَ","ٱلْخَٰلِدِينَ"],"marked":[3],"facts":{"verb":"أَبْدَى"}},{"id":"abda-12-77-14","words":["verb:abda"],"options":[{"bs":"pokazuje je","en":"he/it shows it"},{"bs":"pokazujete","en":"you reveal"},{"bs":"pokazujete ga","en":"you (all) show it"},{"bs":"pokazuju","en":"they show"}],"ref":"12:77","answerWord":"يُبْدِهَا","answerSound":"audio/6d59d26e1fcdd508534f.m4a","quranTranslation":{"text":"They said: If he stealeth, a brother of his stole before. But Joseph kept it secret in his soul and revealed it not unto them. He said (within himself): Ye are in worse case, and Allah knoweth best (the truth of) that which ye allege.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pokazati, otkriti","en":"to show, to reveal"},"passage":["قَالُوٓا۟","إِن","يَسْرِقْ","فَقَدْ","سَرَقَ","أَخٌ","لَّهُۥ","مِن","قَبْلُ","فَأَسَرَّهَا","يُوسُفُ","فِى","نَفْسِهِۦ","وَلَمْ","يُبْدِهَا","لَهُمْ","قَالَ","أَنتُمْ","شَرٌّ","مَّكَانًا","وَٱللَّهُ","أَعْلَمُ","بِمَا","تَصِفُونَ"],"marked":[14],"facts":{"verb":"أَبْدَى"}},{"id":"dammara-26-172-1","words":["verb:dammara"],"options":[{"bs":"uništili smo","en":"We destroyed"},{"bs":"pa smo je uništili","en":"so we destroyed it"},{"bs":"uništili smo ih","en":"we destroyed them"},{"bs":"uništio je","en":"he/it destroyed"}],"ref":"26:172","answerWord":"دَمَّرْنَا","answerSound":"audio/228c93f646d386820634.m4a","quranTranslation":{"text":"Then afterward We destroyed the others.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["ثُمَّ","دَمَّرْنَا","ٱلْءَاخَرِينَ"],"marked":[1],"facts":{"verb":"دَمَّرَ"}},{"id":"dammara-7-137-20","words":["verb:dammara"],"options":[{"bs":"i uništili smo","en":"and we destroyed"},{"bs":"uništio je","en":"he/it destroyed"},{"bs":"uništili smo ih","en":"we destroyed them"},{"bs":"pa smo je uništili","en":"so we destroyed it"}],"ref":"7:137","answerWord":"وَدَمَّرْنَا","answerSound":"audio/bc68bcb8dfd352af44f3.m4a","quranTranslation":{"text":"And We caused the folk who were despised to inherit the eastern parts of the land and the western parts thereof which We had blessed. And the fair word of thy Lord was fulfilled for the Children of Israel because of their endurance; and We annihilated (all) that Pharaoh and his folk had done and that they had contrived.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَأَوْرَثْنَا","ٱلْقَوْمَ","ٱلَّذِينَ","كَانُوا۟","يُسْتَضْعَفُونَ","مَشَٰرِقَ","ٱلْأَرْضِ","وَمَغَٰرِبَهَا","ٱلَّتِى","بَٰرَكْنَا","فِيهَا","وَتَمَّتْ","كَلِمَتُ","رَبِّكَ","ٱلْحُسْنَىٰ","عَلَىٰ","بَنِىٓ","إِسْرَٰٓءِيلَ","بِمَا","صَبَرُوا۟","وَدَمَّرْنَا","مَا","كَانَ","يَصْنَعُ","فِرْعَوْنُ","وَقَوْمُهُۥ","وَمَا","كَانُوا۟","يَعْرِشُونَ"],"marked":[20],"facts":{"verb":"دَمَّرَ"}},{"id":"dammara-17-16-12","words":["verb:dammara"],"options":[{"bs":"pa smo je uništili","en":"so we destroyed it"},{"bs":"uništili smo ih","en":"we destroyed them"},{"bs":"i uništili smo","en":"and we destroyed"},{"bs":"uništio je","en":"he/it destroyed"}],"ref":"17:16","answerWord":"فَدَمَّرْنَٰهَا","answerSound":"audio/7b57d6b28b2a2ff4586d.m4a","quranTranslation":{"text":"And when We would destroy a township We send commandment to its folk who live at ease, and afterward they commit abomination therein, and so the Word (of doom) hath effect for it, and we annihilate it with complete annihilation.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَإِذَآ","أَرَدْنَآ","أَن","نُّهْلِكَ","قَرْيَةً","أَمَرْنَا","مُتْرَفِيهَا","فَفَسَقُوا۟","فِيهَا","فَحَقَّ","عَلَيْهَا","ٱلْقَوْلُ","فَدَمَّرْنَٰهَا","تَدْمِيرًا"],"marked":[12],"facts":{"verb":"دَمَّرَ"}},{"id":"dammara-25-36-7","words":["verb:dammara"],"options":[{"bs":"pa smo ih uništili","en":"so we destroyed them"},{"bs":"uništili smo","en":"We destroyed"},{"bs":"pa smo je uništili","en":"so we destroyed it"},{"bs":"uništio je","en":"he/it destroyed"}],"ref":"25:36","answerWord":"فَدَمَّرْنَٰهُمْ","answerSound":"audio/fb8d8853000f57f7d8ae.m4a","quranTranslation":{"text":"Then We said: Go together unto the folk who have denied Our revelations. Then We destroyed them, a complete destruction.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["فَقُلْنَا","ٱذْهَبَآ","إِلَى","ٱلْقَوْمِ","ٱلَّذِينَ","كَذَّبُوا۟","بِـَٔايَٰتِنَا","فَدَمَّرْنَٰهُمْ","تَدْمِيرًا"],"marked":[7],"facts":{"verb":"دَمَّرَ"}},{"id":"dammara-27-51-6","words":["verb:dammara"],"options":[{"bs":"uništili smo ih","en":"we destroyed them"},{"bs":"pa smo je uništili","en":"so we destroyed it"},{"bs":"uništio je","en":"he/it destroyed"},{"bs":"i uništili smo","en":"and we destroyed"}],"ref":"27:51","answerWord":"دَمَّرْنَٰهُمْ","answerSound":"audio/82338baea660c3409647.m4a","quranTranslation":{"text":"Then see the nature of the consequence of their plotting, for lo! We destroyed them and their people, every one.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["فَٱنظُرْ","كَيْفَ","كَانَ","عَٰقِبَةُ","مَكْرِهِمْ","أَنَّا","دَمَّرْنَٰهُمْ","وَقَوْمَهُمْ","أَجْمَعِينَ"],"marked":[6],"facts":{"verb":"دَمَّرَ"}},{"id":"dammara-47-10-11","words":["verb:dammara"],"options":[{"bs":"uništio je","en":"he/it destroyed"},{"bs":"i uništili smo","en":"and we destroyed"},{"bs":"pa smo je uništili","en":"so we destroyed it"},{"bs":"uništili smo ih","en":"we destroyed them"}],"ref":"47:10","answerWord":"دَمَّرَ","answerSound":"audio/027d48a765c0c0ada5fe.m4a","quranTranslation":{"text":"Have they not travelled in the land to see the nature of the consequence for those who were before them? Allah wiped them out. And for the disbelievers there will be the like thereof.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["أَفَلَمْ","يَسِيرُوا۟","فِى","ٱلْأَرْضِ","فَيَنظُرُوا۟","كَيْفَ","كَانَ","عَٰقِبَةُ","ٱلَّذِينَ","مِن","قَبْلِهِمْ","دَمَّرَ","ٱللَّهُ","عَلَيْهِمْ","وَلِلْكَٰفِرِينَ","أَمْثَٰلُهَا"],"marked":[11],"facts":{"verb":"دَمَّرَ"}},{"id":"ajiba-11-73-1","words":["verb:ajiba"],"options":[{"bs":"zar se čudiš?","en":"are you amazed?"},{"bs":"začudili su se","en":"they were amazed"},{"bs":"čudite se","en":"you wonder"},{"bs":"začudio si se","en":"you wondered"}],"ref":"11:73","answerWord":"أَتَعْجَبِينَ","answerSound":"audio/8498464d5844db36b988.m4a","quranTranslation":{"text":"They said: Wonderest thou at the commandment of Allah? The mercy of Allah and His blessings be upon you, O people of the house! Lo! He is Owner of Praise, Owner of Glory!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuditi se, diviti se","en":"to be amazed, to wonder"},"passage":["قَالُوٓا۟","أَتَعْجَبِينَ","مِنْ","أَمْرِ","ٱللَّهِ","رَحْمَتُ","ٱللَّهِ","وَبَرَكَٰتُهُۥ","عَلَيْكُمْ","أَهْلَ","ٱلْبَيْتِ","إِنَّهُۥ","حَمِيدٌ","مَّجِيدٌ"],"marked":[1],"facts":{"verb":"عَجِبَ"}},{"id":"ajiba-37-12-1","words":["verb:ajiba"],"options":[{"bs":"začudio si se","en":"you wondered"},{"bs":"čudite se","en":"you wonder"},{"bs":"zar se čudiš?","en":"are you amazed?"},{"bs":"začudili su se","en":"they were amazed"}],"ref":"37:12","answerWord":"عَجِبْتَ","answerSound":"audio/9d2a73df93e58b0900e1.m4a","quranTranslation":{"text":"Nay, but thou dost marvel when they mock","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuditi se, diviti se","en":"to be amazed, to wonder"},"passage":["بَلْ","عَجِبْتَ","وَيَسْخَرُونَ"],"marked":[1],"facts":{"verb":"عَجِبَ"}},{"id":"ajiba-38-4-0","words":["verb:ajiba"],"options":[{"bs":"i začudili su se","en":"and they were amazed"},{"bs":"zar se čudiš?","en":"are you amazed?"},{"bs":"začudio si se","en":"you wondered"},{"bs":"čudite se","en":"you wonder"}],"ref":"38:4","answerWord":"وَعَجِبُوٓا۟","answerSound":"audio/f6b474fac15928ba53cb.m4a","quranTranslation":{"text":"And they marvel that a warner from among themselves hath come unto them, and the disbelievers say: This is a wizard, a charlatan.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuditi se, diviti se","en":"to be amazed, to wonder"},"passage":["وَعَجِبُوٓا۟","أَن","جَآءَهُم","مُّنذِرٌ","مِّنْهُمْ","وَقَالَ","ٱلْكَٰفِرُونَ","هَٰذَا","سَٰحِرٌ","كَذَّابٌ"],"marked":[0],"facts":{"verb":"عَجِبَ"}},{"id":"ajiba-50-2-1","words":["verb:ajiba"],"options":[{"bs":"začudili su se","en":"they were amazed"},{"bs":"začudio si se","en":"you wondered"},{"bs":"zar se čudiš?","en":"are you amazed?"},{"bs":"čudite se","en":"you wonder"}],"ref":"50:2","answerWord":"عَجِبُوٓا۟","answerSound":"audio/21c931ee4904326bfa05.m4a","quranTranslation":{"text":"Nay, but they marvel that a warner of their own hath come unto them; and the disbelievers say: This is a strange thing:","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuditi se, diviti se","en":"to be amazed, to wonder"},"passage":["بَلْ","عَجِبُوٓا۟","أَن","جَآءَهُم","مُّنذِرٌ","مِّنْهُمْ","فَقَالَ","ٱلْكَٰفِرُونَ","هَٰذَا","شَىْءٌ","عَجِيبٌ"],"marked":[1],"facts":{"verb":"عَجِبَ"}},{"id":"ajiba-53-59-3","words":["verb:ajiba"],"options":[{"bs":"čudite se","en":"you wonder"},{"bs":"začudili su se","en":"they were amazed"},{"bs":"zar se čudiš?","en":"are you amazed?"},{"bs":"začudio si se","en":"you wondered"}],"ref":"53:59","answerWord":"تَعْجَبُونَ","answerSound":"audio/d831738b7164ae433f99.m4a","quranTranslation":{"text":"Marvel ye then at this statement,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuditi se, diviti se","en":"to be amazed, to wonder"},"passage":["أَفَمِنْ","هَٰذَا","ٱلْحَدِيثِ","تَعْجَبُونَ"],"marked":[3],"facts":{"verb":"عَجِبَ"}},{"id":"qabada-2-245-12","words":["verb:qabada"],"options":[{"bs":"uskraćuje","en":"he/it withholds"},{"bs":"i stišću","en":"and they close"},{"bs":"pa sam uzeo","en":"so I seized"},{"bs":"i uskraćuju","en":"and they withhold"}],"ref":"2:245","answerWord":"يَقْبِضُ","answerSound":"audio/4ff06a3e712b2fa06400.m4a","quranTranslation":{"text":"Who is it that will lend unto Allah a goodly loan, so that He may give it increase manifold? Allah straiteneth and enlargeth. Unto Him ye will return.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti, zgrabiti, stegnuti","en":"to seize, to grasp, to withdraw"},"passage":["مَّن","ذَا","ٱلَّذِى","يُقْرِضُ","ٱللَّهَ","قَرْضًا","حَسَنًا","فَيُضَٰعِفَهُۥ","لَهُۥٓ","أَضْعَافًا","كَثِيرَةً","وَٱللَّهُ","يَقْبِضُ","وَيَبْصُۜطُ","وَإِلَيْهِ","تُرْجَعُونَ"],"marked":[12],"facts":{"verb":"قَبَضَ"}},{"id":"qabada-9-67-10","words":["verb:qabada"],"options":[{"bs":"i uskraćuju","en":"and they withhold"},{"bs":"pa sam uzeo","en":"so I seized"},{"bs":"povlačimo ga","en":"We withdraw it"},{"bs":"uskraćuje","en":"he/it withholds"}],"ref":"9:67","answerWord":"وَيَقْبِضُونَ","answerSound":"audio/19661029dcc3a0226034.m4a","quranTranslation":{"text":"The hypocrites, both men and women, proceed one from another. They enjoin the wrong, and they forbid the right, and they withhold their hands (from spending for the cause of Allah). They forget Allah, so He hath forgotten them. Lo! the hypocrites, they are the transgressors.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti, zgrabiti, stegnuti","en":"to seize, to grasp, to withdraw"},"passage":["ٱلْمُنَٰفِقُونَ","وَٱلْمُنَٰفِقَٰتُ","بَعْضُهُم","مِّنۢ","بَعْضٍ","يَأْمُرُونَ","بِٱلْمُنكَرِ","وَيَنْهَوْنَ","عَنِ","ٱلْمَعْرُوفِ","وَيَقْبِضُونَ","أَيْدِيَهُمْ","نَسُوا۟","ٱللَّهَ","فَنَسِيَهُمْ","إِنَّ","ٱلْمُنَٰفِقِينَ","هُمُ","ٱلْفَٰسِقُونَ"],"marked":[10],"facts":{"verb":"قَبَضَ"}},{"id":"qabada-20-96-6","words":["verb:qabada"],"options":[{"bs":"pa sam uzeo","en":"so I seized"},{"bs":"povlačimo ga","en":"We withdraw it"},{"bs":"uskraćuje","en":"he/it withholds"},{"bs":"i uskraćuju","en":"and they withhold"}],"ref":"20:96","answerWord":"فَقَبَضْتُ","answerSound":"audio/e24df29759d98f268c7c.m4a","quranTranslation":{"text":"He said: I perceived what they perceive not, so I seized a handful from the footsteps of the messenger, and then threw it in. Thus my soul commended to me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti, zgrabiti, stegnuti","en":"to seize, to grasp, to withdraw"},"passage":["قَالَ","بَصُرْتُ","بِمَا","لَمْ","يَبْصُرُوا۟","بِهِۦ","فَقَبَضْتُ","قَبْضَةً","مِّنْ","أَثَرِ","ٱلرَّسُولِ","فَنَبَذْتُهَا","وَكَذَٰلِكَ","سَوَّلَتْ","لِى","نَفْسِى"],"marked":[6],"facts":{"verb":"قَبَضَ"}},{"id":"qabada-25-46-1","words":["verb:qabada"],"options":[{"bs":"povlačimo ga","en":"We withdraw it"},{"bs":"pa sam uzeo","en":"so I seized"},{"bs":"i uskraćuju","en":"and they withhold"},{"bs":"uskraćuje","en":"he/it withholds"}],"ref":"25:46","answerWord":"قَبَضْنَٰهُ","answerSound":"audio/8a9857c39bafdd50d9cc.m4a","quranTranslation":{"text":"Then We withdraw it unto Us, a gradual withdrawal?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti, zgrabiti, stegnuti","en":"to seize, to grasp, to withdraw"},"passage":["ثُمَّ","قَبَضْنَٰهُ","إِلَيْنَا","قَبْضًا","يَسِيرًا"],"marked":[1],"facts":{"verb":"قَبَضَ"}},{"id":"qabada-67-19-6","words":["verb:qabada"],"options":[{"bs":"i stišću","en":"and they close"},{"bs":"povlačimo ga","en":"We withdraw it"},{"bs":"i uskraćuju","en":"and they withhold"},{"bs":"pa sam uzeo","en":"so I seized"}],"ref":"67:19","answerWord":"وَيَقْبِضْنَ","answerSound":"audio/bdabb564dcb0cf5d3a2d.m4a","quranTranslation":{"text":"Have they not seen the birds above them spreading out their wings and closing them? Naught upholdeth them save the Beneficent. Lo! He is Seer of all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti, zgrabiti, stegnuti","en":"to seize, to grasp, to withdraw"},"passage":["أَوَلَمْ","يَرَوْا۟","إِلَى","ٱلطَّيْرِ","فَوْقَهُمْ","صَٰٓفَّٰتٍ","وَيَقْبِضْنَ","مَا","يُمْسِكُهُنَّ","إِلَّا","ٱلرَّحْمَٰنُ","إِنَّهُۥ","بِكُلِّ","شَىْءٍۭ","بَصِيرٌ"],"marked":[6],"facts":{"verb":"قَبَضَ"}}]