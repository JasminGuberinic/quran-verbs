dText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَذِيقَا", "plain": "أَذِيقَا", "quran": false, "notUsed": false, "spoken": "audio/efcf6d45ec9304b46b69.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَذِيقُوا", "plain": "أَذِيقُوا", "quran": false, "notUsed": false, "spoken": "audio/a1febfcb2249a20030b5.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَذِقْنَ", "plain": "أَذِقْنَ", "quran": false, "notUsed": false, "spoken": "audio/ddd4f575466c20ceafc1.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "32:21", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3524.mp3", "translation": {"en": {"text": "And verily We make them taste the lower punishment before the greater, that haply they may return.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Şu bir gerçek ki, onlara o en büyük azabdan önce yakın azabdan (dünyada) da tattıracağız. Umulur ki, (kötülükten) dönerler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ضرور ہم انہیں چکھائیں گے کچھ نزدیک کا عذاب اس بڑے عذاب سے پہلے جسے دیکھنے والا امید کرے کہ ابھی باز آئیں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Sesungguhnya Kami merasakan kepada mereka sebahagian azab yang dekat (di dunia) sebelum azab yang lebih besar (di akhirat), mudah-mudahan mereka kembali (ke jalan yang benar).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَنُذِيقَنَّهُم", "hit": true, "audio": "audio/0f84a6be444a199e8aa2.m4a", "gloss": {"bs": "i sigurno ćemo im dati da okuse", "en": "and We will surely make them taste", "tr": "ve onlara mutlaka tattıracağız", "fr": "et Nous leur ferons certes goûter", "id": "dan sungguh Kami akan membuat mereka merasakan", "ur": "اور ہم ضرور انہیں چکھائیں گے", "bn": "এবং আমরা অবশ্যই তাদের আস্বাদন করাব", "fa": "و قطعاً به آنان خواهیم چشاند"}}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَذَابِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَدْنَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "دُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَذَابِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَكْبَرِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَرْجِعُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "11:9", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1482.mp3", "translation": {"en": {"text": "And if we cause man to taste some mercy from Us and afterward withdraw it from him, lo! he is despairing, thankless.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve şayet insana tarafımızdan bir rahmet tattırır, sonra da onu kendisinden geri alırsak, şüphesiz o ümitsiz ve nankör bir kimse olur.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر ہم آدمی کو اپنی کسی رحمت کا مزہ دیں پھر اسے اس سے چھین لیں ضرور وہ بڑا ناامید ناشکرا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan jika Kami rasakan kepada manusia suatu rahmat (nikmat) dari Kami, kemudian rahmat itu Kami cabut daripadanya, pastilah dia menjadi putus asa lagi tidak berterima kasih.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَئِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَذَقْنَا", "hit": true, "audio": "audio/c3e663ec3533080aaede.m4a", "gloss": {"bs": "damo da okusi", "en": "We let taste", "tr": "tattırırız", "fr": "Nous avons fait goûter", "id": "Kami memberi merasakan", "ur": "ہم نے چکھایا", "bn": "আমরা আস্বাদন করিয়েছি", "fa": "چشاندیم"}}, {"text": "ٱلْإِنسَٰنَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "رَحْمَةً", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "نَزَعْنَٰهَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "لَيَـُٔوسٌ", "hit": false, "audio": null, "gloss": null}, {"text": "كَفُورٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "39:26", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4084.mp3", "translation": {"en": {"text": "Thus Allah made them taste humiliation in the life of the world, and verily the doom of the Hereafter will be greater if they did but know.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah, onlara dünya hayatında zilleti tattırdı. Ahiret azabı ise elbette daha büyüktür. Keşke bilselerdi!", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اللہ نے انہیں دنیا کی زندگی میں رسوائی کا مز ہ چکھایا اور بیشک آخرت کا عذاب سب سے بڑا، کیا اچھا تھا اگر وہ جانتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Allah merasakan kepada mereka kehinaan pada kehidupan dunia. Dan sesungguhnya azab pada hari akhirat lebih besar kalau mereka mengetahui.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَذَاقَهُمُ", "hit": true, "audio": "audio/e933386a8cae171a6fbe.m4a", "gloss": {"en": "so he/it made them taste", "bs": "pa im je dao da okuse", "tr": "böylece onlara tattırdı", "fr": "alors il leur a fait goûter", "id": "maka dia telah membuat mereka merasakan", "ur": "پس اُس نے انہیں چکھایا", "bn": "অতএব সে তাদের আস্বাদন করাল", "fa": "پس آنان را چشاند"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "glos