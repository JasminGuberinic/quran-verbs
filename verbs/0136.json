ull}, {"tense": "imperative", "pronoun": "anti", "arabic": "قَدِّمِي", "plain": "قَدِّمِي", "quran": false, "notUsed": false, "spoken": "audio/75e4c7702514d45f087b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "قَدِّمَا", "plain": "قَدِّمَا", "quran": false, "notUsed": false, "spoken": "audio/7a35d88fe292fc5fa1c3.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "قَدِّمُوا۟", "plain": "قَدِّمُوا", "quran": true, "notUsed": false, "spoken": "audio/b98f1f2977d64bf0a631.m4a", "recited": "audio/158cb254357d1c23db9b.m4a", "recitedText": "وَقَدِّمُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "قَدِّمْنَ", "plain": "قَدِّمْنَ", "quran": false, "notUsed": false, "spoken": "audio/a2890a1290d464b30d53.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "82:5", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5834.mp3", "translation": {"en": {"text": "A soul will know what it hath sent before (it) and what left behind.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Herkes neyi önünden gönderdiğini ve neyi geri bıraktığını bilir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہر جان، جان لے گی جو اس نے آگے بھیجا اور جو پیچھے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "maka tiap-tiap jiwa akan mengetahui apa yang telah dikerjakan dan yang dilalaikannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "عَلِمَتْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَفْسٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مَّا", "hit": false, "audio": null, "gloss": null}, {"text": "قَدَّمَتْ", "hit": true, "audio": "audio/eb3bd890774f9ba17556.m4a", "gloss": {"en": "she/it sent forward", "bs": "poslala je unaprijed", "tr": "önceden gönderdi", "fr": "elle a envoyé d'avance", "id": "dia telah mengirim lebih dahulu", "ur": "اُس نے آگے بھیجا", "bn": "সে আগে পাঠাল", "fa": "پیشاپیش فرستاد"}}, {"text": "وَأَخَّرَتْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "38:60", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4030.mp3", "translation": {"en": {"text": "They say: Nay, but you (misleaders), for you there is no word of welcome. Ye prepared this for us (by your misleading). Now hapless is the plight.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Arkadan gelenler öncekilere:) Derler ki: \"Hayır, asıl size merhaba yok. Çünkü cehennemi bize siz takdim ettiniz. Bakın o ne kötü yatak!\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہاں بھی تنگ جگہ میں رہیں تابع بولے بلکہ تمہیں کھلی جگہ نہ ملیو، یہ مصیبت تم ہمارے آگے لائے تو کیا ہی برا ٹھکانا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Pengikut-pengikut mereka menjawab: \"Sebenarnya kamulah. Tiada ucapan selamat datang bagimu, karena kamulah yang menjerumuskan kami ke dalam azab, maka amat buruklah Jahannam itu sebagai tempat menetap\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "بَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَرْحَبًۢا", "hit": false, "audio": null, "gloss": null}, {"text": "بِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "قَدَّمْتُمُوهُ", "hit": true, "audio": "audio/be33a84361e1103e6f7c.m4a", "gloss": {"en": "you (all) prepared it", "bs": "pripremili ste to", "tr": "onu hazırladınız", "fr": "vous l'avez préparé", "id": "kalian telah menyiapkannya", "ur": "تم نے اسے تیار کیا", "bn": "তোমরা তা প্রস্তুত করেছিলে", "fa": "آن را آماده کردید"}}, {"text": "لَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَبِئْسَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَرَارُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "75:13", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5564.mp3", "translation": {"en": {"text": "On that day man is told the tale of that which he hath sent before and left behind.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O gün insana, yapıp öne sürdüğü ve geri bıraktığı ne varsa bildirilir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس دن آدمی کو اس کا سب اگلا پچھلا جتادیا جائے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Pada hari itu diberitakan kepada manusia apa yang telah dikerjakannya dan apa yang dilalaikannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يُنَبَّؤُا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْإِنسَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَئِذٍۭ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "قَدَّمَ", "hit": true, "audio": "audio/8f265bc1753009a0db1b.m4a", "gloss": {"en": "he/it prepared", "bs": "pripremio je", "tr": "hazırladı", "fr": "il a préparé", "id": "dia telah menyiapkan", "ur": "اُس نے تیار کیا", "bn": "সে প্রস্তুত করল", "fa": "آماده کرد"}}, {"text": "وَأَخَّرَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "89:24", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6017.mp3", "translation": {"en": {"text": "He will say: Ah, would that I had sent before me (some provision) for my life!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Keşke hayatım için bir şeyler yapıp gönderseydim.\" der.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہے گا ہائے کسی طرح میں نے جیتے جی نیکی آگے بھیجی ہوتی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dia mengatakan: \"Alangkah baiknya kiranya aku dahulu mengerjakan (amal saleh) untuk hidupku ini\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَقُولُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰلَيْتَنِى", "hit": false, "audio": null, "gloss": null}, {"text": "قَدَّمْتُ", "hit": true, "audio": "audio/3b96a08d634bf13b7311.m4a", "gloss": {"bs": "unaprijed sam poslao", "en": "I had sent forward", "tr": "önceden göndermiştim", "fr": "j'avais envoyé d'avance", "id": "aku telah mengirimkan lebih dahulu", "ur": "میں نے آگے بھیجا تھا", "bn": "আমি আগে পাঠিয়েছিলাম", "fa": "پیش فرستاده بودم"}}, {"text": "لِحَيَاتِى", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "قَدَّمَتْ", "count": 14, "first": "2:95", "audio": "audio/e778ba33f61f704898c9.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"en": "she/it sent forward", "bs": "poslala je unaprijed", "tr": "önceden gönderdi", "fr": "elle a envoyé d'avance", "id": "dia telah mengirim lebih dahulu", "ur": "اُس نے آگے بھیجا", "bn": "সে আগে পাঠাল", "fa": "پیشاپیش فرستاد"}}, {"arabic": "تُقَدِّمُوا۟", "count": 4, "first": "2:110", "audio": "audio/3bbde3b5391f13d957d6.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}, {"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "you (all) send forward", "bs": "šaljete unaprijed", "tr": "önceden gönderirsiniz", "fr": "que vous envoyiez d'avance", "id": "kalian mengirim lebih dahulu", "ur": "تم آگے بھیجتے ہو", "bn": "তোমরা আগে পাঠাও", "fa": "پیشاپیش بفرستید"}}, {"ara