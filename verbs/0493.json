": "audio/43f362ae5cd63cca2673.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِفْصِلْ", "plain": "اِفْصِلْ", "quran": false, "notUsed": false, "spoken": "audio/123f85f6d8be023f5fdb.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِفْصِلِي", "plain": "اِفْصِلِي", "quran": false, "notUsed": false, "spoken": "audio/d32ee1b0dda402159112.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِفْصِلَا", "plain": "اِفْصِلَا", "quran": false, "notUsed": false, "spoken": "audio/51674b0d7a55e9551f1c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِفْصِلُوا", "plain": "اِفْصِلُوا", "quran": false, "notUsed": false, "spoken": "audio/3527463508682f16e1be.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِفْصِلْنَ", "plain": "اِفْصِلْنَ", "quran": false, "notUsed": false, "spoken": "audio/6feb50309068b3016a56.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "32:25", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3528.mp3", "translation": {"en": {"text": "Lo! thy Lord will judge between them on the Day of Resurrection concerning that wherein they used to differ.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Şimdi ihtilafa düştükleri şeyler hakkında şüphesiz ki Rabbin kıyamet günü aralarında ayırıcı hükmü verecektir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک تمہارا رب ان میں فیصلہ کردے گا قیامت کے دن جس بات میں اختلاف کرتے تھے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Tuhanmu Dialah yang memberikan keputusan di antara mereka pada hari kiamat tentang apa yang selalu mereka perselisihkan padanya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَفْصِلُ", "hit": true, "audio": "audio/b541f9ce49fdb8c1c528.m4a", "gloss": {"bs": "će presuditi", "en": "will judge", "tr": "hükmedecek", "fr": "jugera", "id": "akan memutuskan", "ur": "فیصلہ کرے گا", "bn": "ফয়সালা করবেন", "fa": "داوری خواهد کرد"}}, {"text": "بَيْنَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقِيَٰمَةِ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَخْتَلِفُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:94", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1690.mp3", "translation": {"en": {"text": "When the caravan departed their father had said: Truly I am conscious of the breath of Joseph, though ye call me dotard.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ne zaman ki, kafile (Mısır'dan) ayrıldı, öteden babaları dedi ki: \"Eğer bana bunak demezseniz, doğrusu ben Yusuf'un kokusunu alıyorum.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جب قافلہ مصر سے جدا ہوا یہاں ان کے باپ نے کہا بیشک میں یوسف کی خوشبو پا تا ہوں اگر مجھے یہ نہ کہو کہ سٹھ (بہک) گیا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tatkala kafilah itu telah ke luar (dari negeri Mesir) berkata ayah mereka: \"Sesungguhnya aku mencium bau Yusuf, sekiranya kamu tidak menuduhku lemah akal (tentu kamu membenarkan aku)\".", "by": "Kementerian Agama RI, via tanzil.net"}