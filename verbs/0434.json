}, {"tense": "imperative", "pronoun": "anti", "arabic": "تَمَنَّيْ", "plain": "تَمَنَّيْ", "quran": false, "notUsed": false, "spoken": "audio/c960216502d37388b286.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "تَمَنَّيَا", "plain": "تَمَنَّيَا", "quran": false, "notUsed": false, "spoken": "audio/785942da628cb39decb9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "تَمَنَّوُا۟", "plain": "تَمَنَّوْا", "quran": true, "notUsed": false, "spoken": "audio/6800638d86427994dc50.m4a", "recited": "audio/6a0cac8c86b8e664e1f2.m4a", "recitedText": "فَتَمَنَّوُا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "تَمَنَّيْنَ", "plain": "تَمَنَّيْنَ", "quran": false, "notUsed": false, "spoken": "audio/851a677855adc7c980aa.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "2:95", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/102.mp3", "translation": {"en": {"text": "But they will never long for it, because of that which their own hands have sent before them. Allah is aware of evil-doers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Fakat elleriyle işledikleri yüzünden onu hiçbir zaman temenni edemiyecekler. Allah o zâlimleri bilir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہرگز کبھی اس کی آرزو نہ کریں گے ان بداعمالیوں کے سبب جو آگے کرچکے اور اللہ خوب جانتا ہے ظالموں کو-", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sekali-kali mereka tidak akan mengingini kematian itu selama-lamanya, karena kesalahan-kesalahan yang telah diperbuat oleh tangan mereka (sendiri), dan Allah Maha Mengetahui siapa orang-orang yang aniaya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَمَنَّوْهُ", "hit": true, "audio": "audio/c364626ca1d02c3e991c.m4a", "gloss": {"bs": "(nikad ga) neće poželjeti", "en": "they (will never) wish for it", "tr": "onu (asla) temenni etmeyecekler", "fr": "ils (ne) le souhaiteront (jamais)", "id": "mereka (tidak akan pernah) mengharapkannya", "ur": "وہ (کبھی) اس کی تمنا نہیں کریں گے", "bn": "তারা (কখনো) তা কামনা করবে না", "fa": "(هرگز) آرزویش را نخواهند کرد"}}, {"text": "أَبَدًۢا", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "قَدَّمَتْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَيْدِيهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلِيمٌۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلظَّٰلِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:143", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/436.mp3", "translation": {"en": {"text": "And verily ye used to wish for death before ye met it (in the field). Now ye have seen it with your eyes!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun ki siz ölümle karşılaşmadan önce onu arzuluyordunuz. İşte onu gördünüz, ama bakıp duruyorsunuz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور تم تو موت کی تمنا کیا کرتے تھے اس کے ملنے سے پہلے تو اب وہ تمہیں نظر آئی آنکھوں کے سامنے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya kamu mengharapkan mati (syahid) sebelum kamu menghadapinya; (sekarang) sungguh kamu telah melihatnya dan kamu menyaksikannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَمَنَّوْنَ", "hit": true, "audio": "audio/69686c9f4f2e455ec201.m4a", "gloss": {"en": "you (all) wish", "bs": "želite", "tr": "dilersiniz", "fr": "vous souhaitez", "id": "kalian menginginkan", "ur": "تم سب تمنا کرتے ہو", "bn": "তোমরা কামনা কর", "fa": "می‌خواهید"}}, {"text": "ٱلْمَوْتَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "قَبْلِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَلْقَوْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "فَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "رَأَيْتُمُوهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَنظُرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "فَتَمَنَّوُا۟", "count": 2, "first": "2:94", "audio": "audio/6a0cac8c86b8e664e1f2.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) wish!", "bs": "pa poželite!", "tr": "böylece dilek tutun!", "fr": "alors souhaitez !", "id": "maka inginkanlah!", "ur": "پس تم سب تمنا کرو!", "bn": "অতএব তোমরা কামনা কর!", "fa": "پس آرزو کنید!"}}, {"arabic": "يَتَمَنَّوْهُ", "count": 1, "first": "2:95", "audio": "audio/c364626ca1d02c3e991c.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["huwa"], "mood": "subjunctive"}], "gloss": {"bs": "(nikad ga) neće poželjeti", "en": "they (will never) wish for it", "tr": "onu (asla) temenni etmeyecekler", "fr": "ils (ne) le souhaiteront (jamais)", "id": "mereka (tidak akan pernah) mengharapkannya", "ur": "وہ (کبھی) اس کی تمنا نہیں کریں گے", "bn": "তারা (কখনো) তা কামনা করবে না", "fa": "(هرگز) آرزویش را نخواهند کرد"}}, {"arabic": "تَمَنَّوْنَ", "count": 1, "first": "3:143", "audio": "audio/69686c9f4f2e455ec201.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "glo