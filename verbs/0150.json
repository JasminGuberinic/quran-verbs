{"rank": 150, "root": "جمع", "form": 1, "lemma": "جَمَعَ", "count": 22, "ayahCount": 22, "share": 0.11, "meaning": {"bs": "sakupiti, okupiti", "en": "to gather, to collect", "tr": "toplamak, bir araya getirmek", "fr": "rassembler, réunir", "id": "mengumpulkan", "ur": "جمع کرنا، اکٹھا کرنا", "bn": "একত্র করা, সমবেত করা", "fa": "جمع کردن، گرد آوردن"}, "lemmaSpoken": "audio/175639eeb28206870997.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "جَمَعَ", "plain": "جَمَعَ", "quran": true, "notUsed": false, "spoken": "audio/175639eeb28206870997.m4a", "recited": "audio/2fa9b3a7fcec7c936ea2.m4a", "recitedText": "جَمَعَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَجْمَعُ", "plain": "يَجْمَعُ", "quran": true, "notUsed": false, "spoken": "audio/88da880b22b450ebe40f.m4a", "recited": "audio/aaec9285e530e9799c01.m4a", "recitedText": "يَجْمَعُ"}], "nouns": {"participle": {"lemma": "جامِع", "count": 3, "spoken": "audio/549dffd1f2d4ba8926ab.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "جَمَعْتُ", "plain": "جَمَعْتُ", "quran": false, "notUsed": false, "spoken": "audio/c22aa4e1401ad6aea9e2.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "جَمَعْنَا", "plain": "جَمَعْنَا", "quran": false, "notUsed": false, "spoken": "audio/418b084ff8137051dba3.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "جَمَعْتَ", "plain": "جَمَعْتَ", "quran": false, "notUsed": false, "spoken": "audio/0ceca9cd783bc9225048.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "جَمَعْتِ", "plain": "جَمَعْتِ", "quran": false, "notUsed": false, "spoken": "audio/7c46ca7e761f3ce3baa3.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "جَمَعْتُمَا", "plain": "جَمَعْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/ca24f89aacf431cb5c2a.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pr