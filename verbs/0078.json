{"rank": 78, "root": "حكم", "form": 1, "lemma": "حَكَمَ", "count": 45, "ayahCount": 40, "share": 0.23, "meaning": {"bs": "suditi, presuditi", "en": "to judge, to rule", "tr": "hükmetmek, yargılamak", "fr": "juger, trancher", "id": "memutuskan, menghukumi", "ur": "فیصلہ کرنا، حکم چلانا", "bn": "বিচার করা, শাসন করা", "fa": "داوری کردن، حکم راندن"}, "lemmaSpoken": "audio/5d833ecd67f8d815e8a0.m4a", "animation": "<svg class=\"va va-hakama_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes hakama_1-g{from{transform:rotate(-50deg)}}@keyframes hakama_1-k{from{opacity:1}}.va-hakama_1 .gv{transform-origin:96px 52px;animation:hakama_1-g .4s ease-in .6s 3 alternate both}.va-hakama_1 .kk{opacity:0;animation:hakama_1-k .4s step-end .6s 3 alternate both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-hakama_1.off,.va-hakama_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-hakama_1,.va-hakama_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><path class=\"p\" d=\"M36 61V22M28 61h16\"/><g class=\"bm\"><path class=\"p\" d=\"M16 22h40M16 22l-5 10h10zM56 22l-5 10h10z\"/></g><rect class=\"q\" x=\"66\" y=\"54\" width=\"16\" height=\"7\" rx=\"1\"/><g class=\"gv\"><path class=\"p\" d=\"M96 52L78 52\"/><rect class=\"q\" x=\"70\" y=\"46\" width=\"8\" height=\"12\" rx=\"1.5\"/></g><path class=\"p kk\" d=\"M64 48l-3-3M72 43v-4\"/></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "حَكَمَ", "plain": "حَكَمَ", "quran": true, "notUsed": false, "spoken": "audio/5d833ecd67f8d815e8a0.m4a", "recited": "audio/c0eb7cb54816a60e6a87.m4a", "recitedText": "حَكَمَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَحْكُمُ", "plain": "يَحْكُمُ", "quran": true, "notUsed": false, "spoken": "audio/c2b0e4c1f5e8cd0348a1.m4a", "recited": "audio/3405227a8fe01534