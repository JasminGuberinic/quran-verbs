", "recitedText": "ٱرْجِعْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "ٱرْجِعِىٓ", "plain": "اِرْجِعِي", "quran": true, "notUsed": false, "spoken": "audio/9847bd9fa374d7f8ee23.m4a", "recited": "audio/68b32bb71cf7556b135e.m4a", "recitedText": "ٱرْجِعِىٓ"}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِرْجِعَا", "plain": "اِرْجِعَا", "quran": false, "notUsed": false, "spoken": "audio/d062f77694f5fb1af0dc.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱرْجِعُوا۟", "plain": "اِرْجِعُوا", "quran": true, "notUsed": false, "spoken": "audio/11384a185b93544021d5.m4a", "recited": "audio/f4a6ae06e05c81a77a4e.m4a", "recitedText": "ٱرْجِعُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِرْجِعْنَ", "plain": "اِرْجِعْنَ", "quran": false, "notUsed": false, "spoken": "audio/588d746857344cfd31b1.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "7:174", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1128.mp3", "translation": {"en": {"text": "Thus we detail the revelations, that haply they may return.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve işte biz, âyetleri böyle ayrıntılı olarak açıklıyoruz ki, belki dönerler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم اسی طرح آیتیں رنگ رنگ سے بیان کرتے ہیں اور اس لیے کہ کہیں وہ پھر آئیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan demikianlah Kami menjelaskan ayat-ayat itu, agar mereka kembali (kepada kebenaran).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَكَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نُفَصِّلُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْءَايَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَعَلَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَرْجِعُونَ", "hit": true, "audio": "audio/0415c3119e835a216eee.m4a", "gloss": {"en": "they return", "bs": "vraćaju se", "tr": "dönerler", "fr": "ils se retournent", "id": "mereka kembali", "ur": "وہ لوٹتے ہیں", "bn": "তারা ফিরে যায়", "fa": "بازمی‌گردند"}}]}, {"ref": "23:99", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2772.mp3", "translation": {"en": {"text": "Until, when death cometh unto one of them, he saith: My Lord! Send me back,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Nihayet onlardan (müşriklerden) birine ölüm gelip çattığında, \"Rabbim, der, lütfen beni (dünyaya) geri gönder,\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یہاں تک کہ جب ان میں کسی کو موت آئے تو کہتا ہے کہ اے میرے رب مجھے واپس پھر دیجئے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Demikianlah keadaan orang-orang kafir itu), hingga apabila datang kematian kepada seseorang dari mereka, dia berkata: \"Ya Tuhanku kembalikanlah aku (ke dunia),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "حَتَّىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "جَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَحَدَهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَوْتُ", "hit": false, "audio": null, "gloss": null}, {"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱرْجِعُونِ", "hit": true, "audio": "audio/5e32c743df13ad237845.m4a", "gloss": {"en": "(you all) return me!", "bs": "vratite me!", "tr": "beni geri çevirin!", "fr": "ramenez-moi !", "id": "kembalikanlah aku!", "ur": "مجھے لوٹاؤ!", "bn": "তোমরা আমাকে ফিরিয়ে দাও!", "fa": "مرا بازگردانید!"}}]}, {"ref": "67:4", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5245.mp3", "translation": {"en": {"text": "Then look again and yet again, thy sight will return unto thee weakened and made dim.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra gözünü tekrar tekrar döndür (bak). Göz (aradığı bozukluğu bulmaktan) âciz ve bitkin halde sana dönecektir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر دوبارہ نگاہ اٹھا نظر تیری طرف ناکام پلٹ آئے گی تھکی ماندی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian pandanglah sekali lagi niscaya penglihatanmu akan kembali kepadamu dengan tidak menemukan sesuatu cacat dan penglihatanmu itupun dalam keadaan payah.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱرْجِعِ", "hit": true, "audio": "audio/5bf98d048ee6806b8652.m4a", "gloss": {"en": "return (your vision)!", "bs": "vrati pogled!", "tr": "bakışını geri çevir!", "fr": "retourne la vue !", "id": "kembalikanlah penglihatanmu!", "ur": "نظر لوٹا!", "bn": "দৃষ্টি ফিরিয়ে দাও!", "fa": "نگاهت را بازگردان!"}}, {"text": "ٱلْبَصَرَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَرَّتَيْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَنقَلِبْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبَصَرُ", "hit": false, "audio": null, "gloss": null}, {"text": "خَاسِئًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "حَسِيرٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:64", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2547.mp3", "translation": {"en": {"text": "Then gathered they apart and said: Lo! ye yourselves are the wrong-doers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine vicdanlarına dönüp (kendi kendilerine) dediler ki: \"Doğrusu siz haksızsınız.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اپنے جی کی طرف پلٹے اور بولے بیشک تمہیں ستمگار ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka mereka telah kembali kepada kesadaran dan lalu berkata: \"Sesungguhnya kamu sekalian adalah orang-orang yang menganiaya (diri sendiri)\",", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَرَجَعُوٓا۟", "hit": true, "audio": "audio/ab0183203722ecc5b92e.m4a", "gloss": {"bs": "pa su se vratili", "en": "so they turned (back)", "tr": "bunun üzerine geri döndüler", "fr": "alors ils revinrent (à eux-mêmes)", "id": "lalu mereka berbalik", "ur": "پھر وہ لوٹ آئے", "bn": "তখন তারা ফিরে এল", "fa": "پس بازگشتند"}}, {"text": "إِلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنفُسِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَقَالُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلظَّٰلِمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "56:87", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5066.mp3", "translation": {"en": {"text": "Do ye not force it back, if ye are truthful?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onu geri çevirsenize; şayet iddianızda doğru iseniz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ اسے لوٹا لاتے اگر تم سچے ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kamu tidak mengembalikan nyawa itu (kepada tempatnya) jika kamu adalah orang-orang yang benar?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "تَرْجِعُونَهَآ", "hit": true, "audio": "audio/17f332defca973a91d50.m4a", "gloss": {"bs": "vratite je", "en": "you bring it back", "tr": "onu geri getirirsiniz", "fr": "vous le faites revenir", "id": "kamu mengembalikannya", "ur": "تم اسے لوٹاتے ہو", "bn": "তোমরা তা ফিরিয়ে আনো", "fa": "آن را بازمی‌گردانید"}}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "صَٰدِقِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "89:28", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anti", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6021.mp3", "translation": {"en": {"text": "Return unto thy Lord, content in His good pleasure!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hem hoşnut edici, hem de hoşnut edilmiş olarak Rabbine dön.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اپنے رب کی طرف واپس ہو یوں کہ تو اس سے راضی وہ تجھ سے راضی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kembalilah kepada Tuhanmu dengan hati yang puas lagi diridhai-Nya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱرْجِعِىٓ", "hit": true, "audio": "audio/68b32bb71cf7556b135e.m4a", "gloss": {"bs": "vrati se!", "en": "return!", "tr": "dön!", "fr": "retourne !", "id": "kembalilah!", "ur": "لوٹ آ!", "bn": "ফিরে এসো! (স্ত্রীলিঙ্গ)", "fa": "بازگرد!"}}, {"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّكِ", "hit": false, "audio": null, "gloss": null}, {"text": "رَاضِيَةً", "hit": false, "audio": null, "gloss": null}, {"text": "مَّرْضِيَّةً", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تُرْجَعُونَ", "count": 19, "first": "2:28", "audio": "audio/13668d8526c496504558.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "you (all) are returned", "bs": "bivate vraćeni", "tr": "geri çevrilirsiniz", "fr": "vous êtes ramenés", "id": "kalian dikembalikan", "ur": "تم سب لوٹائے جاتے ہو", "bn": "তোমাদের ফিরিয়ে আনা হয়", "fa": "بازگردانده می‌شوید"}}, {"arabic": "يَرْجِعُونَ", "count": 16, "first": "2:18", "audio": "audio/4c5f3a7ed5834d48b228.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they return", "bs": "vraćaju se", "tr": "dönerler", "fr": "ils se retournent", "id": "mereka kembali", "ur": "وہ لوٹتے ہیں", "bn": "তারা ফিরে যায়", "fa": "بازمی‌گردند"}}, {"arabic": "تُرْجَعُ", "count": 6, "first": "2:210", "audio": "audio/9cfde86178a1aff14c3a.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": true, "objects": [], "mood": "indicative"}]}, {"arabic": "يُرْجَعُونَ", "count": 6, "first": "3:83", "audio": "audio/cb17c55443ecb69136fb.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "they are returned", "bs": "bivaju vraćeni", "tr": "geri çevrilirler", "fr": "ils sont ramenés", "id": "mereka dikembalikan", "ur": "وہ لوٹائے جاتے ہیں", "bn": "তাদের ফিরিয়ে আনা হয়", "fa": "بازگردانده می‌شوند"}}, {"arabic": "يَرْجِعُ", "count": 3, "first": "20:89", "audio": "audio/240c0cb72be6e36e9066.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it returns", "bs": "vraća se", "tr": "döner", "fr": "il se retourne", "id": "dia kembali", "ur": "وہ لوٹتا ہے", "bn": "সে ফিরে যায়", "fa": "بازمی‌گردد"}}, {"arabic": "رَجَعْتُمْ", "count": 2, "first": "2:196", "audio": "audio/869dcb8c0a4a6ad9920a.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) returned", "bs": "vratili ste se", "tr": "döndünüz", "fr": "vous vous êtes retournés", "id": "kalian telah kembali", "ur": "تم سب لوٹے", "bn": "তোমরা ফিরে গিয়েছ", "fa": "بازگشتید"}}, {"arabic": "رَجَعُوٓا۟", "count": 2, "first": "9:122", "audio": "audio/ee65c054a45780eea9cb.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they returned", "bs": "vratili su se", "tr": "döndüler", "fr": "ils se sont retournés", "id": "mereka telah kembali", "ur": "وہ لوٹے", "bn": "তারা ফিরে গেছে", "fa": "بازگشتند"}}, {"arabic": "ٱرْجِعْ", "count": 2, "first": "12:50", "audio": "audio/a14f6d60fb3d21f7dcb9.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "return!", "bs": "vrati se!", "tr": "dön!", "fr": "retourne-toi !", "id": "kembalilah!", "ur": "لوٹ!", "bn": "ফিরে যাও!", "fa": "بازگرد!"}}, {"arabic": "ٱرْجِعُوا۟", "count": 2, "first": "24:28", "audio": "audio/f4a6ae06e05c81a77a4e.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "(you all) return!", "bs": "vratite se!", "tr": "dönün!", "fr": "retournez-vous !", "id": "kembalilah kalian!", "ur": "لوٹو!", "bn": "তোমরা ফিরে যাও!", "fa": "بازگردید!"}}, {"arabic": "فَٱرْجِعُوا۟", "count": 2, "first": "24:28", "audio": "audio/2fbb8eaaf1a41d25c5a9.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) return!", "bs": "pa se vratite!", "tr": "böylece dönün!", "fr": "alors retournez-vous !", "id": "maka kembalilah kalian!", "ur": "پس تم سب لوٹو!", "bn": "অতএব তোমরা ফিরে যাও!", "fa": "پس بازگردید!"}}, {"arabic": "رَجَعَ", "count": 1, "first": "7:150", "audio": "audio/54774f7c16df688f0e75.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it returned", "bs": "vratio se", "tr": "döndü", "fr": "il s'est retourné", "id": "dia telah kembali", "ur": "وہ لوٹا", "bn": "সে ফিরে গেল", "fa": "بازگشت"}}, {"arabic": "رَّجَعَكَ", "count": 1, "first": "9:83", "audio": "audio/34081d09001fb91e2fb4.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["anta"]}], "gloss": {"en": "he/it returned you", "bs": "vratio te je", "tr": "seni geri çevirdi", "fr": "il t'a ramené", "id": "dia telah mengembalikanmu", "ur": "اُس نے تمہیں لوٹایا", "bn": "সে তোমাকে ফিরিয়ে দিল", "fa": "تو را بازگرداند"}}, {"arabic": "يُرْجَعُ", "count": 1, "first": "11:123", "audio": "audio/046c9539dde56a842e71.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it is returned", "bs": "biva vraćen", "tr": "geri çevrilir", "fr": "il est ramené", "id": "dia dikembalikan", "ur": "وہ لوٹایا جاتا ہے", "bn": "তাকে ফিরিয়ে দেওয়া হয়", "fa": "بازگردانده می‌شود"}}, {"arabic": "أَرْجِعُ", "count": 1, "first": "12:46", "audio": "audio/6c2eb9d506208181291b.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "I return", "bs": "vraćam se", "tr": "dönerim", "fr": "je me retourne", "id": "aku kembali", "ur": "میں لوٹتا ہوں", "bn": "আমি ফিরে যাই", "fa": "بازمی‌گردم"}}, {"arabic": "ٱرْجِعُوٓا۟", "count": 1, "first": "12:81", "audio": "audio/72bf62ffac8699777bf1.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "(you all) return!", "bs": "vratite se!", "tr": "dönün!", "fr": "retournez-vous !", "id": "kembalilah kalian!", "ur": "لوٹو!", "bn": "তোমরা ফিরে যাও!", "fa": "بازگردید!"}}, {"arabic": "فَرَجَعْنَٰكَ", "count": 1, "first": "20:40", "audio": "audio/0a6c7d2f27f034399ca6.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["anta"]}], "gloss": {"en": "so we returned you", "bs": "pa smo te vratili", "tr": "böylece seni geri çevirdik", "fr": "alors nous t'avons ramené", "id": "maka kami telah mengembalikanmu", "ur": "پس ہم نے تمہیں لوٹایا", "bn": "অতএব আমরা তোমাকে ফিরিয়ে দিলাম", "fa": "پس تو را بازگرداندیم"}}, {"arabic": "فَرَجَعَ", "count": 1, "first": "20:86", "audio": "audio/3126c2d4b0d6471633da.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "so he/it returned", "bs": "pa se vratio", "tr": "böylece döndü", "fr": "alors il s'est retourné", "id": "maka dia kembali", "ur": "پس وہ لوٹا", "bn": "অতএব সে ফিরে গেল", "fa": "پس بازگشت"}}, {"arabic": "يَرْجِعَ", "count": 1, "first": "20:91", "audio": "audio/b914904594b79cbcd035.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "he/it returns", "bs": "vraća se", "tr": "döner", "fr": "qu'il se retourne", "id": "dia kembali", "ur": "وہ لوٹے", "bn": "সে ফিরে যায়", "fa": "بازگردد"}}, {"arabic": "وَٱرْجِعُوٓا۟", "count": 1, "first": "21:13", "audio": "audio/da9294663be6107e1e87.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) return!", "bs": "i vratite se!", "tr": "ve dönün!", "fr": "et retournez-vous !", "id": "dan kembalilah kalian!", "ur": "اور تم سب لوٹو!", "bn": "এবং তোমরা ফিরে যাও!", "fa": "و بازگردید!"}}, {"arabic": "فَرَجَعُوٓا۟", "count": 1, "first": "21:64", "audio": "audio/ab0183203722ecc5b92e.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "pa su se vratili", "en": "so they turned (back)", "tr": "bunun üzerine geri döndüler", "fr": "alors ils revinrent (à eux-mêmes)", "id": "lalu mereka berbalik", "ur": "پھر وہ لوٹ آئے", "bn": "তখন তারা ফিরে এল", "fa": "پس بازگشتند"}}, {"arabic": "ٱرْجِعُونِ", "count": 1, "first": "23:99", "audio": "audio/5e32c743df13ad237845.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["ana"]}], "gloss": {"en": "(you all) return me!", "bs": "vratite me!", "tr": "beni geri çevirin!", "fr": "ramenez-moi !", "id": "k