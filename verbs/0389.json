 "imperative", "pronoun": "anti", "arabic": "اِعْمَيْ", "plain": "اِعْمَيْ", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِعْمَيَا", "plain": "اِعْمَيَا", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِعْمَوْا", "plain": "اِعْمَوْا", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِعْمَيْنَ", "plain": "اِعْمَيْنَ", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}], "ayat": [{"ref": "47:23", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4568.mp3", "translation": {"en": {"text": "Such are they whom Allah curseth so that He deafeneth them and maketh blind their eyes.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte onlar, Allah'ın lanetlediği, kulaklarını sağır, gözlerini kör ettiği kimselerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یہ ہیں وہ لوگ جن پر اللہ نے لعنت کی اور انہیں حق سے بہرا کردیا اور ان کی آنکھیں پھوڑ دیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka itulah orang-orang yang dilaknati Allah dan ditulikan-Nya telinga mereka dan dibutakan-Nya penglihatan mereka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَنَهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَصَمَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَعْمَىٰٓ", "hit": true, "audio": "audio/bf9fcc5335ce39c12210.m4a", "gloss": {"en": "and he/it blinded", "bs": "i oslijepio je", "tr": "ve kör oldu", "fr": "et il devint aveugle", "id": "dan dia menjadi buta", "ur": "اور اُس نے اندھا کیا", "bn": "এবং সে অন্ধ হলো", "fa": "و کور شد"}}, {"text": "أَبْصَٰرَهُمْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "28:66", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3318.mp3", "translation": {"en": {"text": "On that day (all) tidings will be dimmed for them, nor will they ask one of another,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte o gün onlara bütün haberler kapkaranlık olmuştur; onlar birbirlerine de soramayacaklardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اس دن ان پر خبریں اندھی ہوجائیں گی تو وہ کچھ پوجھ گچھ نہ کریں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka gelaplah bagi mereka segala macam alasan pada hari itu, karena itu mereka tidak saling tanya menanya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَعَمِيَتْ", "hit": true, "audio": "audio/c204fdf0f5fb88daacd0.m4a", "gloss": {"bs": "pa će biti nejasne", "en": "then (the news) will be obscure", "tr": "kapanıp anlaşılmaz olacak", "fr": "alors (les nouvelles) leur seront obscures", "id": "lalu (berita itu) menjadi gelap", "ur": "تو (خبریں) ان پر اندھی ہو جائیں گی", "bn": "তখন (সংবাদগুলো) অস্পষ্ট হয়ে যাবে", "fa": "پس پوشیده ماند"}}, {"text": "عَلَيْهِمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَنۢبَآءُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَئِذٍ", "hit": false, "audio": null, "gloss": null}, {"text": "فَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَسَآءَلُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تَعْمَى", "count": 2, "first": "22:46", "audio": "audio/42d6ff40480ca6c62666.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "jussive"}, {"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}, {"arabic": "فَعَمُوا۟", "count": 1, "first": "5:71", "audio": "audio/73411b2e1654b6672d93.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}]}, {"arabic": "عَمُوا۟", "count": 1, "first": "5:71", "audio": "audio/b6a467eadebd4bb0f5bd.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they were blind", "bs": "bili su slijepi", "tr": "kördüler", "fr": "ils étaient aveugles", "id": "mereka buta", "ur": "وہ اندھے تھے", "bn": "তারা অন্ধ ছিল", "fa": "کور بودند"}}, {"arabic": "عَمِىَ", "count": 1, "first": "6:104", "audio": "audio/7bb584a801e0d5b7c542.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it was blind", "bs": "bio je slijep", "tr": "kördü", "fr": "il était aveugle", "id": "dia buta", "ur": "وہ اندھا تھا", "bn": "সে অন্ধ ছিল", "fa": "کور بود"}}, {"arabic": "فَعَمِيَتْ", "count": 1, "first": "28:66", "audio": "audio/c204fdf0f5fb88daacd0.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"bs": "pa će biti nejasne", "en": "then (the news) will be obscure", "tr": "kapanıp anlaşılmaz olacak", "fr": "alors (les nouvelles) leur seront obscures", "id": "lalu (berita itu) menjadi gelap", "ur": "تو (خبریں) ان پر اندھی ہو جائیں گی", "bn": "তখন (সংবাদগুলো) অস্পষ্ট হয়ে যাবে", "fa": "پس پوشیده ماند"}}, {"arabic": "وَأَعْمَىٰٓ", "count": 1, "first": "47:23", "audio": "audio/bf9fcc5335ce39c12210.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it blinded", "bs": "i oslijepio je", "tr": "ve kör oldu", "fr": "et il devint aveugle", "id": "dan dia menjadi buta", "ur": "اور اُس نے اندھا