1c3a95d.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they strive", "bs": "trude se", "tr": "çabalarlar", "fr": "ils s'efforcent", "id": "mereka berjuang keras", "ur": "وہ کوشش کرتے ہیں", "bn": "তারা চেষ্টা করে", "fa": "می‌کوشند"}}, {"arabic": "فَٱسْعَوْا۟", "count": 1, "first": "62:9", "audio": "audio/59e1d2bc3a0c82d3cd71.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) hasten!", "bs": "pa požurite!", "tr": "böylece acele edin!", "fr": "alors hâtez-vous !", "id": "maka bersegeralah kalian!", "ur": "پس جلدی کرو!", "bn": "অতএব তোমরা দ্রুত এসো!", "fa": "پس بشتابید!"}}], "ayatFile": "ayat/0170.json", "ayatTranslations": {"en": "ayat/0170.en.json", "tr": "ayat/0170.tr.json", "ur": "ayat/0170.ur.json", "id": "ayat/0170.id.json"}, "sentences": [{"arabic": "سَعَى الْأَبُ لِرِزْقِ أَوْلَادِهِ", "spoken": "audio/ba16b79591ec85354590.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Otac se trudio da prehrani svoju djecu.", "en": "The father strove for his children's livelihood.", "bn": "বাবা তার সন্তানদের জীবিকার জন্য চেষ্টা করলেন।", "fa": "پدر برای روزی فرزندانش کوشید.", "fr": "Le père s'est efforcé de subvenir aux besoins de ses enfants.", "id": "Ayah berusaha mencari nafkah untuk anak-anaknya.", "tr": "Baba çocuklarının geçimi için çabaladı.", "ur": "باپ نے اپنے بچوں کی روزی کے لیے کوشش کی۔"}, "independentlyReviewed": true, "words": [{"arabic": "سَعَى", "target": true, "translation": {"bs": "trudio se", "en": "strove", "bn": "চেষ্টা করল", "fa": "کوشید", "fr": "s'est efforcé", "id": "berusaha", "tr": "çabaladı", "ur": "اس نے کوشش کی"}}, {"arabic": "الْأَبُ", "target": false, "translation": {"bs": "otac", "en": "the father", "bn": "বাবা", "fa": "پدر", "fr": "le père", "id": "ayah itu", "tr": "baba", "ur": "باپ"}}, {"arabic": "لِرِزْقِ", "target": false, "translation": {"bs": "za opskrbu", "en": "for the livelihood", "bn": "জীবিকার জন্য", "fa": "برای روزی", "fr": "pour la subsistance", "id": "untuk mencari nafkah", "tr": "geçimi için", "ur": "روزی کے لیے"}}, {"arabic": "أَوْلَادِهِ", "target": false, "translation": {"bs": "svoje djece", "en": "of his children", "bn": "তার সন্তানদের", "fa": "فرزندانش", "fr": "de ses enfants", "id": "anak-anaknya", "tr": "çocuklarının", "ur": "اپنے بچوں کی"}}]}, {"arabic": "الطَّالِبُ يَسْعَى لِلنَّجَاحِ", "spoken": "audio/d89bafa16ae4693a3764.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Učenik teži uspjehu.", "en": "The student strives for success.", "bn": "ছাত্রটি সাফল্যের জন্য চেষ্টা করে।", "fa": "دانش‌آموز برای موفقیت می‌کوشد.", "fr": "L'étudiant aspire à la réussite.", "id": "Siswa itu berusaha untuk berhasil.", "tr": "Öğrenci başarı için çabalar.", "ur": "طالب علم کامیابی کے لیے کوشش کرتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "الطَّالِبُ", "target": false, "translation": {"bs": "učenik", "en": "the student", "bn": "ছাত্রটি", "fa": "دانشجو", "fr": "l'étudiant", "id": "siswa itu", "tr": "öğrenci", "ur": "طالب علم"}}, {"arabic": "يَسْعَى", "target": true, "translation": {"bs": "teži", "en": "strives", "bn": "চেষ্টা করে", "fa": "می‌کوشد", "fr": "aspire", "id": "berusaha", "tr": "çabalar", "ur": "وہ کوشش کرتا ہے"}}, {"arabic": "لِلنَّجَاحِ", "target": false, "translation": {"bs": "uspjehu", "en": "for success", "bn": "সাফল্যের জন্য", "fa": "برای موفقیت", "fr": "à la réussite", "id": "untuk berhasil", "tr": "başarı için", "ur": "کامیابی کے لیے"}}]}, {"arabic": "سَعَوْا فِي الْخَيْرِ", "spoken": "audio/e910b176e8a0436a0a12.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Trudili su se činiti dobro.", "en": "They strove to do good.", "bn": "তারা ভালো কাজ করার চেষ্টা করল।", "fa": "برای کار نیک کوشیدند.", "fr": "Ils se sont efforcés de faire le bien.", "id": "Mereka berusaha berbuat baik.", "tr": "İyilik yapmaya çabaladılar.", "ur": "انہوں نے نیکی کرنے کی کوشش کی۔"}, "indepen