{"rank": 211, "root": "قرأ", "form": 1, "lemma": "قَرَأَ", "count": 16, "ayahCount": 15, "share": 0.08, "meaning": {"bs": "čitati, učiti", "en": "to read, to recite", "tr": "okumak", "fr": "lire, réciter", "id": "membaca, melafalkan", "ur": "پڑھنا، تلاوت کرنا", "bn": "পাঠ করা, তিলাওয়াত করা", "fa": "خواندن، قرائت کردن"}, "lemmaSpoken": "audio/be9e5ed298521396538e.m4a", "animation": "<svg class=\"va va-vqra_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes vqra_1-0{from{transform:rotate(0deg)}}@keyframes vqra_1-1{50%{transform:rotate(-64deg)}}.va-vqra_1 .ra{transform:rotate(-60deg);animation:vqra_1-1 1s ease-in-out 0.8s 2 both}.va-vqra_1 .la{transform:rotate(-50deg)}.va-vqra_1 .tr{transform:rotate(10deg);animation:vqra_1-0 0.8s ease-in-out both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-vqra_1.off,.va-vqra_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-vqra_1,.va-vqra_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><g transform=\"translate(50 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"p\" d=\"M-5 13q2.5-2 5 0q2.5-2 5 0v6q-2.5-2-5 0q-2.5-2-5 0z\"/><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "قَرَأَ", "plain": "قَرَأَ", "quran": false, "notUsed": false, "spoken": "audio/be9e5ed298521396538e.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَقْرَأُ", "plain": "يَقْرَأُ", "quran