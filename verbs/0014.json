{"rank": 14, "root": "نزل", "form": 4, "lemma": "أَنزَلَ", "count": 183, "ayahCount": 162, "share": 0.95, "meaning": {"bs": "spustiti, objaviti", "en": "to send down, to reveal", "tr": "indirmek", "fr": "faire descendre, révéler", "id": "menurunkan", "ur": "نازل کرنا", "bn": "নাযিল করা, অবতীর্ণ করা", "fa": "فرو فرستادن، نازل کردن"}, "lemmaSpoken": "audio/79939babe033b80e2865.m4a", "animation": "<svg class=\"va va-vnzl_4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes vnzl_4-0{from{transform:translateY(-34px)}}@keyframes vnzl_4-1{from{opacity:0}}.va-vnzl_4 .sc{animation:vnzl_4-0 2s ease-out both}.va-vnzl_4 .ry{animation:vnzl_4-1 0.5s ease-out 2s both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-vnzl_4.off,.va-vnzl_4.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-vnzl_4,.va-vnzl_4 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><path class=\"p\" d=\"M60 61V44M50 44h20\"/><rect class=\"q sc\" x=\"52\" y=\"34\" width=\"16\" height=\"9\" rx=\"3\"/><path class=\"p ry\" d=\"M48 28l-4-4M72 28l4-4M60 26v-6\"/></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَنزَلَ", "plain": "أَنْزَلَ", "quran": true, "notUsed": false, "spoken": "audio/79939babe033b80e2865.m4a", "recited": "audio/9b281584009494e73b4c.m4a", "recitedText": "أَنزَلَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُنْزِلُ", "plain": "يُنْزِلُ", "quran": false, "notUsed": false, "spoken": "audio/5d5b09c40488038052df.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَنزِلْ", "plain": "أَنْزِلْ", "quran": true, "notUsed": false, "spoken": "audio/773105365b9fb36b1fe5.m4a", "recited": "audio/72c077ddb7d24cf924d9.m4a", "recitedText": "أَنزِلْ"}], "nouns": {"participle": {"lemma": "مُنزِل", "count": 5, "spoken": "audio/45f5b5468d01ee0125ff.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَنزَلْتُ", "plain": "أَنْزَلْتُ", "quran": true, "notUsed": false, "spoken": "audio/d16c9e82b06bded8e386.m4a", "recited": "audio/5c1619e41a500ed2af55.m4a", "recitedText": "أَنزَلْتُ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَنزَلْنَا", "plain": "أَنْزَلْنَا", "quran": true, "notUsed": false, "spoken": "audio/a1be6ce437c2b33d538f.m4a", "recited": "audio/d5c7a8a0b72e31fc1ae1.m4a", "recitedText": "أَنزَلْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "أَنزَلْتَ", "plain": "أَنْزَلْتَ", "quran": true, "notUsed": false, "spoken": "audio/7c7801667e5a3c972b0d.m4a", "recited": "audio/a868aa130c7775305705.m4a", "recitedText": "أَنزَلْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "أَنْزَلْتِ", "plain": "أَنْزَلْتِ", "quran": false, "notUsed": false, "spoken": "audio/22bd151897cda819dbb6.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "أَنْزَلْتُمَا", "plain": "أَنْزَلْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/9ab428e0b824c8bcf2ef.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "أَنْزَلْتُمْ", "plain": "أَنْزَلْتُمْ", "quran": false, "notUsed": false, "spoken": "audio/ba198d9093432db8ddab.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antunna", "arabic": "أَنْزَلْتُنَّ", "plain": "أَنْزَلْتُنَّ", "quran": false, "notUsed": false, "spoken": "audio/d584b305dba0cba7acd8.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huwa", "arabic": "أَنزَلَ", "plain": "أَنْزَلَ", "quran": true, "notUsed": false, "spoken": "audio/79939babe033b80e2865.m4a", "recited": "audio/9b281584009494e73b4c.m4a", "recitedText": "أَنزَلَ"}, {"tense": "past", "pronoun": "hiya", "arabic": "أَنْزَلَتْ", "plain": "أَنْزَلَتْ", "quran": false, "notUsed": false, "spoken": "audio/666a01b1089dda801813.m4a", "recited": null, "recitedT