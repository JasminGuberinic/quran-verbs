َبِثَ"}, {"tense": "past", "pronoun": "hiya", "arabic": "لَبِثَتْ", "plain": "لَبِثَتْ", "quran": false, "notUsed": false, "spoken": "audio/15a4f0a352a02f90c418.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huma", "arabic": "لَبِثَا", "plain": "لَبِثَا", "quran": false, "notUsed": false, "spoken": "audio/2d761c97c505a435365a.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hum", "arabic": "لَبِثُوا۟", "plain": "لَبِثُوا", "quran": true, "notUsed": false, "spoken": "audio/b9faac2441fcebb1e298.m4a", "recited": "audio/f27bae5fb1499cb77849.m4a", "recitedText": "لَبِثُوا۟"}, {"tense": "past", "pronoun": "hunna", "arabic": "لَبِثْنَ", "plain": "لَبِثْنَ", "quran": false, "notUsed": false, "spoken": "audio/2b5635287a1d571cad02.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "ana", "arabic": "أَلْبَثُ", "plain": "أَلْبَثُ", "quran": false, "notUsed": false, "spoken": "audio/3a7b8d84a8610a67fe4a.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "nahnu", "arabic": "نَلْبَثُ", "plain": "نَلْبَثُ", "quran": false, "notUsed": false, "spoken": "audio/234d9077de8e24b7fd51.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "anta", "arabic": "تَلْبَثُ", "plain": "تَلْبَثُ", "quran": false, "notUsed": false, "spoken": "audio/6120f636982950105bae.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "anti", "arabic": "تَلْبَثِينَ", "plain": "تَلْبَثِينَ", "quran": false, "notUsed": false, "spoken": "audio/d52917efd321211845d4.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تَلْبَثَانِ", "plain": "تَلْبَثَانِ", "quran": false, "notUsed": false, "spoken": "audio/5e6ed9935d90c546dbd2.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَلْبَثُونَ", "plain": "تَلْبَثُونَ", "quran": false, "notUsed": false, "spoken": "audio/6aaba03738ebc45e5657.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antunna", "arabic": "تَلْبَثْنَ", "plain": "تَلْبَثْنَ", "quran": false, "notUsed": false, "spoken": "audio/a1e660ceb6e867c30e5d.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَلْبَثُ", "plain": "يَلْبَثُ", "quran": false, "notUsed": false, "spoken": "audio/bc27c9c9f3725f443b4e.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hiya", "arabic": "تَلْبَثُ", "plain": "تَلْبَثُ", "quran": false, "notUsed": false, "spoken": "audio/6120f636982950105bae.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يَلْبَثَانِ", "plain": "يَلْبَثَانِ", "quran": false, "notUsed": false, "spoken": "audio/93fd4821d0f76b99bb4e.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَلْبَثُونَ", "plain": "يَلْبَثُونَ", "quran": true, "notUsed": false, "spoken": "audio/6e04480fe4f4f09727eb.m4a", "recited": "audio/d0d4a983a6aa7eef7340.m4a", "recitedText": "يَلْبَثُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَلْبَثْنَ", "plain": "يَلْبَثْنَ", "quran": false, "notUsed": false, "spoken": "audio/989bdafb193de86a4b15.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِلْبَثْ", "plain": "اِلْبَثْ", "quran": false, "notUsed": false, "spoken": "audio/33d37b040f91aaac8dee.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِلْبَثِي", "plain": "اِلْبَثِي", "quran": false, "notUsed": false, "spoken": "audio/f185c72d1db1c1951951.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِلْبَثَا", "plain": "اِلْبَثَا", "quran": false, "notUsed": false, "spoken": "audio/16aa96f9bf0a1e35dee8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِلْبَثُوا", "plain": "اِلْبَثُوا", "quran": false, "notUsed": false, "spoken": "audio/ade110cd14142b7a6e2b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِلْبَثْنَ", "plain": "اِلْبَثْنَ", "quran": false, "notUsed": false, "spoken": "audio/ef4316f0835e8e38a5ca.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "20:103", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2451.mp3", "translation": {"en": {"text": "Murmuring among themselves: Ye have tarried but ten (days).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Siz dünyada sadece on(gün) kaldınız\" diye kendi aralarında gizli gizli konuşurlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "آپس میں چپکے چپکے کہتے ہوں گے کہ تم دنیا میں نہ رہے مگر دس رات", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka berbisik-bisik di antara mereka: \"Kamu tidak berdiam (di dunia) melainkan hanyalah sepuluh (hari)\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَتَخَٰفَتُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "بَيْنَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّبِثْتُمْ", "hit": true, "audio": "audio/ad05f0d9ff143a6e44eb.m4a", "gloss": {"bs": "ostali ste", "en": "you stayed", "tr": "kaldınız", "fr": "vous êtes restés", "id": "kamu tinggal", "ur": "تم ٹھہرے", "bn": "তোমরা অবস্থান করেছিলে", "fa": "ماندید"}}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "عَشْرًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:25", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2165.mp3", "translation": {"en": {"text": "And (it is said) they tarried in their Cave three hundred years and add nine.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, mağaralarında üçyüz yıl kadar kaldılar ve dokuz yıl da buna ilave etmişlerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ اپنے غار میں تین سو برس ٹھہرے نو اوپر، ف۵۲)", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka tinggal dalam gua mereka tiga ratus tahun dan ditambah sembilan tahun (lagi).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَبِثُوا۟", "hit": true, "audio": "audio/109b7765b14911034127.m4a", "gloss": {"en": "and they stayed", "bs": "i ostali su", "tr": "ve kaldılar", "fr": "et ils sont restés", "id": "dan mereka telah tinggal", "ur": "اور وہ ٹھہرے", "bn": "এবং তারা অবস্থান করল", "fa": "و ماندند"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "كَهْفِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ثَلَٰثَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِا۟ئَةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "سِنِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱزْدَادُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "تِسْعًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:18", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2950.mp3", "translation": {"en": {"text": "(Pharaoh) said (unto Moses): Did we not rear thee among us as a child? And thou didst dwell many years of thy life among us,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Â, dedi, biz seni çocukken himayemize alıp büyütmedik mi? Hayatının bir çok yıllarını aramızda geçirmedin mi?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بو لا کیا ہم نے تمھیں اپنے یہاں بچپن میں نہ پالا اور تم نے ہما رے یہا ں اپنی عمر کے کئی برس گزارے، ف۲۰)", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Fir'aun menjawab: \"Bukankah kami telah mengasuhmu di antara (keluarga) kami, waktu kamu masih kanak-kanak dan kamu tinggal bersama kami beberapa tahun dari umurmu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نُرَبِّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِينَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلِيدًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَبِثْتَ", "hit": true, "audio": "audio/4e78c4731bcacce00d54.m4a", "gloss": {"en": "and you stayed", "bs": "i ostao si", "tr": "ve kaldın", "fr": "et tu es resté", "id": "dan kamu telah tinggal", "ur": "اور تم ٹھہرے", "bn": "এবং তুমি অবস্থান করলে", "fa": "و ماندی"}}, {"text": "فِينَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عُمُرِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "سِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "79:46", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5758.mp3", "translation": {"en": {"text": "On the day when they behold it, it will be as if they had but tarried for an evening or the morn thereof.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar o kıyameti görecekleri gün sanki dünyada bir akşam veya kuşluğundan başka durmamışa dönecekler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "گویا جس دن وہ اسے دیکھیں گے دنیا میں نہ رہے تھے مگر ایک شام یا اس کے دن چڑھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Pada hari mereka melihat hari berbangkit itu, mereka merasa seakan-akan tidak tinggal (di dunia) melainkan (sebentar saja) di waktu sore atau pagi hari.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَأَنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَرَوْنَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَلْبَثُوٓا۟", "hit": true, "audio": "audio/4f3731f8a579611a3f80.m4a", "gloss": {"bs": "(nisu) boravili", "en": "they (had not) stayed", "tr": "(kalmadılar)", "fr": "ils (n')étaient (restés)", "id": "mereka (tidak) tinggal", "ur": "وہ (نہیں) ٹھہرے", "bn": "তারা (অবস্থান) করেনি", "fa": "(نمانده بودند)"}}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "عَشِيَّةً", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "ضُحَىٰهَا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:144", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3932.mp3", "translation": {"en": {"text": "He would have tarried in its belly till the day when they are raised;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer çok tesbih edenlerden olmasaydı, yeniden dirilecekleri güne kadar onun karnında kalırdı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ضرور اس کے پیٹ میں رہتا جس دن تک لوگ اٹھائے جائیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "niscaya ia akan tetap tinggal di perut ikan itu sampai hari berbangkit.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَلَبِثَ", "hit": true, "audio": "audio/5c6e52e00743f19455ae.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}]}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "بَطْنِهِۦٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "يُبْعَثُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:113", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2786.mp3", "translation": {"en": {"text": "They will say: We tarried by a day or part of a day. Ask of those who keep count!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Bir gün veya günün bir kısmı kadar kaldık. İşte bilenlere sor.\" derler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "، بولے ہم ایک دن رہے یا دن کا حصہ تو گننے والوں سے دریافت فرما", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka menjawab: \"Kami tinggal (di bumi) sehari atau setengah hari, maka tanyakanlah kepada orang-orang yang menghitung\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَبِثْنَا", "hit": true, "audio": "audio/77724f39506bb4b70833.m4a", "gloss": {"en": "we stayed", "bs": "ostali smo", "tr": "kaldık", "fr": "nous sommes restés", "id": "kami telah tinggal", "ur": "ہم ٹھہرے", "bn": "আমরা অবস্থান করেছিলাম", "fa": "ماندیم"}}, {"text": "يَوْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْضَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "فَسْـَٔلِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَآدِّينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "لَّبِثْتُمْ", "count": 4, "first": "17:52", "audio": "audio/ad05f0d9ff143a6e44eb.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"bs": "ostali ste", "en": "you stayed", "tr": "k