[{"id":"adhina-20-109-6","words":["verb:adhina"],"options":[{"bs":"dozvolio je","en":"he/it permitted"},{"bs":"pa znajte!","en":"so (you all) be informed!"},{"bs":"dozvoljava se","en":"it is permitted"},{"bs":"dozvoljavam","en":"I permit"}],"ref":"20:109","answerWord":"أَذِنَ","answerSound":"audio/0086adf9f19993348e33.m4a","quranTranslation":{"text":"On that day no intercession availeth save (that of) him unto whom the Beneficent hath given leave and whose word He accepteth.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dozvoliti, odobriti","en":"to permit, to allow"},"passage":["يَوْمَئِذٍ","لَّا","تَنفَعُ","ٱلشَّفَٰعَةُ","إِلَّا","مَنْ","أَذِنَ","لَهُ","ٱلرَّحْمَٰنُ","وَرَضِىَ","لَهُۥ","قَوْلًا"],"marked":[6],"facts":{"verb":"أَذِنَ"}},{"id":"adhina-7-123-6","words":["verb:adhina"],"options":[{"bs":"dozvoljavam","en":"I permit"},{"bs":"i posluša","en":"and it listens (obeys)"},{"bs":"dozvoljava se","en":"it is permitted"},{"bs":"dozvoli!","en":"permit!"}],"ref":"7:123","answerWord":"ءَاذَنَ","answerSound":"audio/6cbede93b93b7eb3ea70.m4a","quranTranslation":{"text":"Pharaoh said: Ye believe in Him before I give you leave! Lo! this is the plot that ye have plotted in the city that ye may drive its people hence. But ye shall come to know!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dozvoliti, odobriti","en":"to permit, to allow"},"passage":["قَالَ","فِرْعَوْنُ","ءَامَنتُم","بِهِۦ","قَبْلَ","أَنْ","ءَاذَنَ","لَكُمْ","إِنَّ","هَٰذَا","لَمَكْرٌ","مَّكَرْتُمُوهُ","فِى","ٱلْمَدِينَةِ","لِتُخْرِجُوا۟","مِنْهَآ","أَهْلَهَا","فَسَوْفَ","تَعْلَمُونَ"],"marked":[6],"facts":{"verb":"أَذِنَ"}},{"id":"adhina-16-84-8","words":["verb:adhina"],"options":[{"bs":"dozvoljava se","en":"it is permitted"},{"bs":"dozvoli!","en":"permit!"},{"bs":"pa znajte!","en":"so (you all) be informed!"},{"bs":"dozvoljeno je","en":"it was permitted"}],"ref":"16:84","answerWord":"يُؤْذَنُ","answerSound":"audio/df24f8a7dedeb97d7175.m4a","quranTranslation":{"text":"And (bethink you of) the day when we raise up of every nation a witness, then there is no leave for disbelievers, nor are they allowed to make amends.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dozvoliti, odobriti","en":"to permit, to allow"},"passage":["وَيَوْمَ","نَبْعَثُ","مِن","كُلِّ","أُمَّةٍ","شَهِيدًا","ثُمَّ","لَا","يُؤْذَنُ","لِلَّذِينَ","كَفَرُوا۟","وَلَا","هُمْ","يُسْتَعْتَبُونَ"],"marked":[8],"facts":{"verb":"أَذِنَ"}},{"id":"adhina-24-28-8","words":["verb:adhina"],"options":[{"bs":"dozvoljava se","en":"it is permitted"},{"bs":"dozvolio je","en":"he/it permitted"},{"bs":"i posluša","en":"and it listens (obeys)"},{"bs":"pa dozvoli!","en":"so permit!"}],"ref":"24:28","answerWord":"يُؤْذَنَ","answerSound":"audio/c2aa9a33c590f2a7dd62.m4a","quranTranslation":{"text":"And if ye find no-one therein, still enter not until permission hath been given. And if it be said unto you: Go away again, then go away, for it is purer for you. Allah knoweth what ye do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dozvoliti, odobriti","en":"to permit, to allow"},"passage":["فَإِن","لَّمْ","تَجِدُوا۟","فِيهَآ","أَحَدًا","فَلَا","تَدْخُلُوهَا","حَتَّىٰ","يُؤْذَنَ","لَكُمْ","وَإِن","قِيلَ","لَكُمُ","ٱرْجِعُوا۟","فَٱرْجِعُوا۟","هُوَ","أَزْكَىٰ","لَكُمْ","وَٱللَّهُ","بِمَا","تَعْمَلُونَ","عَلِيمٌ"],"marked":[8],"facts":{"verb":"أَذِنَ"}},{"id":"adhina-84-2-0","words":["verb:adhina"],"options":[{"bs":"i posluša","en":"and it listens (obeys)"},{"bs":"dozvoljeno je","en":"it was permitted"},{"bs":"dozvoljava se","en":"it is permitted"},{"bs":"dozvoljavam","en":"I permit"}],"ref":"84:2","answerWord":"وَأَذِنَتْ","answerSound":"audio/10663beb14243ff2b6e7.m4a","quranTranslation":{"text":"And attentive to her Lord in fear,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dozvoliti, odobriti","en":"to permit, to allow"},"passage":["وَأَذِنَتْ","لِرَبِّهَا","وَحُقَّتْ"],"marked":[0],"facts":{"verb":"أَذِنَ"}},{"id":"adhina-2-279-3","words":["verb:adhina"],"options":[{"bs":"pa znajte!","en":"so (you all) be informed!"},{"bs":"dozvoljavam","en":"I permit"},{"bs":"pa dozvoli!","en":"so permit!"},{"bs":"dozvolio je","en":"he/it permitted"}],"ref":"2:279","answerWord":"فَأْذَنُوا۟","answerSound":"audio/87486caa0593bad0887f.m4a","quranTranslation":{"text":"And if ye do not, then be warned of war (against you) from Allah and His messenger. And if ye repent, then ye have your principal (without interest). Wrong not, and ye shall not be wronged.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dozvoliti, odobriti","en":"to permit, to allow"},"passage":["فَإِن","لَّمْ","تَفْعَلُوا۟","فَأْذَنُوا۟","بِحَرْبٍ","مِّنَ","ٱللَّهِ","وَرَسُولِهِۦ","وَإِن","تُبْتُمْ","فَلَكُمْ","رُءُوسُ","أَمْوَٰلِكُمْ","لَا","تَظْلِمُونَ","وَلَا","تُظْلَمُونَ"],"marked":[3],"facts":{"verb":"أَذِنَ"}},{"id":"adhina-9-43-4","words":["verb:adhina"],"options":[{"bs":"dozvolio si","en":"you permitted"},{"bs":"dozvoljavam","en":"I permit"},{"bs":"dozvoljava","en":"he/it permits"},{"bs":"dozvoljeno je","en":"it was permitted"}],"ref":"9:43","answerWord":"أَذِنتَ","answerSound":"audio/9a4e4b8c47d0db6fe934.m4a","quranTranslation":{"text":"Allah forgive thee (O Muhammad)! Wherefor didst thou grant them leave ere those who told the truth were manifest to thee and thou didst know the liars?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dozvoliti, odobriti","en":"to permit, to allow"},"passage":["عَفَا","ٱللَّهُ","عَنكَ","لِمَ","أَذِنتَ","لَهُمْ","حَتَّىٰ","يَتَبَيَّنَ","لَكَ","ٱلَّذِينَ","صَدَقُوا۟","وَتَعْلَمَ","ٱلْكَٰذِبِينَ"],"marked":[4],"facts":{"verb":"أَذِنَ"}},{"id":"adhina-9-49-3","words":["verb:adhina"],"options":[{"bs":"dozvoli!","en":"permit!"},{"bs":"dozvolio je","en":"he/it permitted"},{"bs":"dozvoljava","en":"he/it permits"},{"bs":"i posluša","en":"and it listens (obeys)"}],"ref":"9:49","answerWord":"ٱئْذَن","answerSound":"audio/15ee689726e82aa1d8f6.m4a","quranTranslation":{"text":"Of them is he who saith: Grant me leave (to stay at home) and tempt me not. Surely it is into temptation that they (thus) have fallen. Lo! hell verily is all around the disbelievers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dozvoliti, odobriti","en":"to permit, to allow"},"passage":["وَمِنْهُم","مَّن","يَقُولُ","ٱئْذَن","لِّى","وَلَا","تَفْتِنِّىٓ","أَلَا","فِى","ٱلْفِتْنَةِ","سَقَطُوا۟","وَإِنَّ","جَهَنَّمَ","لَمُحِيطَةٌۢ","بِٱلْكَٰفِرِينَ"],"marked":[3],"facts":{"verb":"أَذِنَ"}},{"id":"adhina-9-90-4","words":["verb:adhina"],"options":[{"bs":"da se dozvoli","en":"so that it may be permitted"},{"bs":"pa dozvoli!","en":"so permit!"},{"bs":"dozvolio je","en":"he/it permitted"},{"bs":"i posluša","en":"and it listens (obeys)"}],"ref":"9:90","answerWord":"لِيُؤْذَنَ","answerSound":"audio/00f2755a05b86b5120cc.m4a","quranTranslation":{"text":"And those among the wandering Arabs who had an excuse came in order that permission might be granted them. And those who lied to Allah and His messenger sat at home. A painful doom will fall on those of them who disbelieve.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dozvoliti, odobriti","en":"to permit, to allow"},"passage":["وَجَآءَ","ٱلْمُعَذِّرُونَ","مِنَ","ٱلْأَعْرَابِ","لِيُؤْذَنَ","لَهُمْ","وَقَعَدَ","ٱلَّذِينَ","كَذَبُوا۟","ٱللَّهَ","وَرَسُولَهُۥ","سَيُصِيبُ","ٱلَّذِينَ","كَفَرُوا۟","مِنْهُمْ","عَذَابٌ","أَلِيمٌ"],"marked":[4],"facts":{"verb":"أَذِنَ"}},{"id":"adhina-22-39-0","words":["verb:adhina"],"options":[{"bs":"dozvoljeno je","en":"it was permitted"},{"bs":"da se dozvoli","en":"so that it may be permitted"},{"bs":"dozvoljava","en":"he/it permits"},{"bs":"dozvolio si","en":"you permitted"}],"ref":"22:39","answerWord":"أُذِنَ","answerSound":"audio/6e90d78195a023cfcbc2.m4a","quranTranslation":{"text":"Sanction is given unto those who fight because they have been wronged; and Allah is indeed Able to give them victory;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dozvoliti, odobriti","en":"to permit, to allow"},"passage":["أُذِنَ","لِلَّذِينَ","يُقَٰتَلُونَ","بِأَنَّهُمْ","ظُلِمُوا۟","وَإِنَّ","ٱللَّهَ","عَلَىٰ","نَصْرِهِمْ","لَقَدِيرٌ"],"marked":[0],"facts":{"verb":"أَذِنَ"}},{"id":"adhina-42-21-9","words":["verb:adhina"],"options":[{"bs":"dozvoljava","en":"he/it permits"},{"bs":"pa znajte!","en":"so (you all) be informed!"},{"bs":"dozvoljavam","en":"I permit"},{"bs":"dozvolio si","en":"you permitted"}],"ref":"42:21","answerWord":"يَأْذَنۢ","answerSound":"audio/17ee52acb3a8393a70bc.m4a","quranTranslation":{"text":"Or have they partners (of Allah) who have made lawful for them in religion that which Allah allowed not? And but for a decisive word (gone forth already), it would have been judged between them. Lo! for wrong-doers is a painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dozvoliti, odobriti","en":"to permit, to allow"},"passage":["أَمْ","لَهُمْ","شُرَكَٰٓؤُا۟","شَرَعُوا۟","لَهُم","مِّنَ","ٱلدِّينِ","مَا","لَمْ","يَأْذَنۢ","بِهِ","ٱللَّهُ","وَلَوْلَا","كَلِمَةُ","ٱلْفَصْلِ","لَقُضِىَ","بَيْنَهُمْ","وَإِنَّ","ٱلظَّٰلِمِينَ","لَهُمْ","عَذَابٌ","أَلِيمٌ"],"marked":[9],"facts":{"verb":"أَذِنَ"}},{"id":"madda-13-3-2","words":["verb:madda"],"options":[{"bs":"pružio je","en":"he/it extended"},{"bs":"i pružamo","en":"and we extend"},{"bs":"i produžava im","en":"and He prolongs [for] them"},{"bs":"dopunjava ga","en":"he/it replenishes it"}],"ref":"13:3","answerWord":"مَدَّ","answerSound":"audio/b0f520a1f5907a90e783.m4a","quranTranslation":{"text":"And He it is Who spread out the earth and placed therein firm hills and flowing streams, and of all fruits He placed therein two spouses (male and female). He covereth the night with the day. Lo! herein verily are portents for people who take thought.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pružiti, protegnuti","en":"to extend, to stretch"},"passage":["وَهُوَ","ٱلَّذِى","مَدَّ","ٱلْأَرْضَ","وَجَعَلَ","فِيهَا","رَوَٰسِىَ","وَأَنْهَٰرًا","وَمِن","كُلِّ","ٱلثَّمَرَٰتِ","جَعَلَ","فِيهَا","زَوْجَيْنِ","ٱثْنَيْنِ","يُغْشِى","ٱلَّيْلَ","ٱلنَّهَارَ","إِنَّ","فِى","ذَٰلِكَ","لَءَايَٰتٍ","لِّقَوْمٍ","يَتَفَكَّرُونَ"],"marked":[2],"facts":{"verb":"مَدَّ"}},{"id":"madda-19-75-5","words":["verb:madda"],"options":[{"bs":"pa neka pruži","en":"so let him extend"},{"bs":"navode ih","en":"they draw them on"},{"bs":"i pružamo","en":"and we extend"},{"bs":"dopunjava ga","en":"he/it replenishes it"}],"ref":"19:75","answerWord":"فَلْيَمْدُدْ","answerSound":"audio/0f2fef928d7ba4b805b3.m4a","quranTranslation":{"text":"Say: As for him who is in error, the Beneficent will verily prolong his span of life until, when they behold that which they were promised, whether it be punishment (in the world), or the Hour (of doom), they will know who is worse in position and who is weaker as an army.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pružiti, protegnuti","en":"to extend, to stretch"},"passage":["قُلْ","مَن","كَانَ","فِى","ٱلضَّلَٰلَةِ","فَلْيَمْدُدْ","لَهُ","ٱلرَّحْمَٰنُ","مَدًّا","حَتَّىٰٓ","إِذَا","رَأَوْا۟","مَا","يُوعَدُونَ","إِمَّا","ٱلْعَذَابَ","وَإِمَّا","ٱلسَّاعَةَ","فَسَيَعْلَمُونَ","مَنْ","هُوَ","شَرٌّ","مَّكَانًا","وَأَضْعَفُ","جُندًا"],"marked":[5],"facts":{"verb":"مَدَّ"}},{"id":"madda-2-15-3","words":["verb:madda"],"options":[{"bs":"i produžava im","en":"and He prolongs [for] them"},{"bs":"i pružamo","en":"and we extend"},{"bs":"pa neka pruži","en":"so let him extend"},{"bs":"dopunjava ga","en":"he/it replenishes it"}],"ref":"2:15","answerWord":"وَيَمُدُّهُمْ","answerSound":"audio/b857bfb6a1c2db046833.m4a","quranTranslation":{"text":"Allah (Himself) doth mock them, leaving them to wander blindly on in their contumacy.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pružiti, protegnuti","en":"to extend, to stretch"},"passage":["ٱللَّهُ","يَسْتَهْزِئُ","بِهِمْ","وَيَمُدُّهُمْ","فِى","طُغْيَٰنِهِمْ","يَعْمَهُونَ"],"marked":[3],"facts":{"verb":"مَدَّ"}},{"id":"madda-7-202-1","words":["verb:madda"],"options":[{"bs":"navode ih","en":"they draw them on"},{"bs":"pružio je","en":"he/it extended"},{"bs":"i produžava im","en":"and He prolongs [for] them"},{"bs":"pružena je","en":"she/it was extended"}],"ref":"7:202","answerWord":"يَمُدُّونَهُمْ","answerSound":"audio/030e52d64fd5915b4918.m4a","quranTranslation":{"text":"Their brethren plunge them further into error and cease not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pružiti, protegnuti","en":"to extend, to stretch"},"passage":["وَإِخْوَٰنُهُمْ","يَمُدُّونَهُمْ","فِى","ٱلْغَىِّ","ثُمَّ","لَا","يُقْصِرُونَ"],"marked":[1],"facts":{"verb":"مَدَّ"}},{"id":"madda-19-79-4","words":["verb:madda"],"options":[{"bs":"i pružamo","en":"and we extend"},{"bs":"pa neka pruži","en":"so let him extend"},{"bs":"dopunjava ga","en":"he/it replenishes it"},{"bs":"pružio je","en":"he/it extended"}],"ref":"19:79","answerWord":"وَنَمُدُّ","answerSound":"audio/4128a78421f6cb72cf75.m4a","quranTranslation":{"text":"Nay, but We shall record that which he saith and prolong for him a span of torment.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pružiti, protegnuti","en":"to extend, to stretch"},"passage":["كَلَّا","سَنَكْتُبُ","مَا","يَقُولُ","وَنَمُدُّ","لَهُۥ","مِنَ","ٱلْعَذَابِ","مَدًّا"],"marked":[4],"facts":{"verb":"مَدَّ"}},{"id":"madda-31-27-8","words":["verb:madda"],"options":[{"bs":"dopunjava ga","en":"he/it replenishes it"},{"bs":"navode ih","en":"they draw them on"},{"bs":"i pružamo","en":"and we extend"},{"bs":"i produžava im","en":"and He prolongs [for] them"}],"ref":"31:27","answerWord":"يَمُدُّهُۥ","answerSound":"audio/8ac6c9365ba5dda89250.m4a","quranTranslation":{"text":"And if all the trees in the earth were pens, and the sea, with seven more seas to help it, (were ink), the words of Allah could not be exhausted. Lo! Allah is Mighty, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pružiti, protegnuti","en":"to extend, to stretch"},"passage":["وَلَوْ","أَنَّمَا","فِى","ٱلْأَرْضِ","مِن","شَجَرَةٍ","أَقْلَٰمٌ","وَٱلْبَحْرُ","يَمُدُّهُۥ","مِنۢ","بَعْدِهِۦ","سَبْعَةُ","أَبْحُرٍ","مَّا","نَفِدَتْ","كَلِمَٰتُ","ٱللَّهِ","إِنَّ","ٱللَّهَ","عَزِيزٌ","حَكِيمٌ"],"marked":[8],"facts":{"verb":"مَدَّ"}},{"id":"madda-84-3-2","words":["verb:madda"],"options":[{"bs":"pružena je","en":"she/it was extended"},{"bs":"i produžava im","en":"and He prolongs [for] them"},{"bs":"pa neka pruži","en":"so let him extend"},{"bs":"i pružamo","en":"and we extend"}],"ref":"84:3","answerWord":"مُدَّتْ","answerSound":"audio/908254f40be09be79e3d.m4a","quranTranslation":{"text":"And when the earth is spread out","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pružiti, protegnuti","en":"to extend, to stretch"},"passage":["وَإِذَا","ٱلْأَرْضُ","مُدَّتْ"],"marked":[2],"facts":{"verb":"مَدَّ"}},{"id":"qariba-17-32-1","words":["verb:qariba"],"options":[{"bs":"približavajte se","en":"approach"},{"bs":"prilazite im","en":"you (all) approach them"},{"bs":"prilazite mi","en":"you (all) approach me"},{"bs":"prilaze","en":"they approach"}],"ref":"17:32","answerWord":"تَقْرَبُوا۟","answerSound":"audio/9e7ab161d9e446b0ce0d.m4a","quranTranslation":{"text":"And come not near unto adultery. Lo! it is an abomination and an evil way.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"približiti se, prići","en":"to approach, to draw near"},"passage":["وَلَا","تَقْرَبُوا۟","ٱلزِّنَىٰٓ","إِنَّهُۥ","كَانَ","فَٰحِشَةً","وَسَآءَ","سَبِيلًا"],"marked":[1],"facts":{"verb":"قَرِبَ"}},{"id":"qariba-2-222-11","words":["verb:qariba"],"options":[{"bs":"prilazite im","en":"you (all) approach them"},{"bs":"prilazite mi","en":"you (all) approach me"},{"bs":"približavajte se","en":"approach"},{"bs":"prilaze","en":"they approach"}],"ref":"2:222","answerWord":"تَقْرَبُوهُنَّ","answerSound":"audio/d7dc4d094eb6a87affd0.m4a","quranTranslation":{"text":"They question thee (O Muhammad) concerning menstruation. Say: It is an illness, so let women alone at such times and go not in unto them till they are cleansed. And when they have purified themselves, then go in unto them as Allah hath enjoined upon you. Truly Allah loveth those who turn unto Him, and loveth those who have a care for cleanness.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"približiti se, prići","en":"to approach, to draw near"},"passage":["وَيَسْـَٔلُونَكَ","عَنِ","ٱلْمَحِيضِ","قُلْ","هُوَ","أَذًى","فَٱعْتَزِلُوا۟","ٱلنِّسَآءَ","فِى","ٱلْمَحِيضِ","وَلَا","تَقْرَبُوهُنَّ","حَتَّىٰ","يَطْهُرْنَ","فَإِذَا","تَطَهَّرْنَ","فَأْتُوهُنَّ","مِنْ","حَيْثُ","أَمَرَكُمُ","ٱللَّهُ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلتَّوَّٰبِينَ","وَيُحِبُّ","ٱلْمُتَطَهِّرِينَ"],"marked":[11],"facts":{"verb":"قَرِبَ"}},{"id":"qariba-9-28-7","words":["verb:qariba"],"options":[{"bs":"prilaze","en":"they approach"},{"bs":"prilazite mi","en":"you (all) approach me"},{"bs":"približavajte se","en":"approach"},{"bs":"prilazite im","en":"you (all) approach them"}],"ref":"9:28","answerWord":"يَقْرَبُوا۟","answerSound":"audio/d39866f0f89bc7f06aa6.m4a","quranTranslation":{"text":"O ye who believe! The idolaters only are unclean. So let them not come near the Inviolable Place of Worship after this their year. If ye fear poverty (from the loss of their merchandise) Allah shall preserve you of His bounty if He will. Lo! Allah is Knower, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"približiti se, prići","en":"to approach, to draw near"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓا۟","إِنَّمَا","ٱلْمُشْرِكُونَ","نَجَسٌ","فَلَا","يَقْرَبُوا۟","ٱلْمَسْجِدَ","ٱلْحَرَامَ","بَعْدَ","عَامِهِمْ","هَٰذَا","وَإِنْ","خِفْتُمْ","عَيْلَةً","فَسَوْفَ","يُغْنِيكُمُ","ٱللَّهُ","مِن","فَضْلِهِۦٓ","إِن","شَآءَ","إِنَّ","ٱللَّهَ","عَلِيمٌ","حَكِيمٌ"],"marked":[7],"facts":{"verb":"قَرِبَ"}},{"id":"qariba-12-60-9","words":["verb:qariba"],"options":[{"bs":"prilazite mi","en":"you (all) approach me"},{"bs":"približavajte se","en":"approach"},{"bs":"prilazite im","en":"you (all) approach them"},{"bs":"prilaze","en":"they approach"}],"ref":"12:60","answerWord":"تَقْرَبُونِ","answerSound":"audio/7bce4ae12084be04d1fd.m4a","quranTranslation":{"text":"And if ye bring him not unto me, then there shall be no measure for you with me, nor shall ye draw near.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"približiti se, prići","en":"to approach, to draw near"},"passage":["فَإِن","لَّمْ","تَأْتُونِى","بِهِۦ","فَلَا","كَيْلَ","لَكُمْ","عِندِى","وَلَا","تَقْرَبُونِ"],"marked":[9],"facts":{"verb":"قَرِبَ"}},{"id":"awa-12-69-4","words":["verb:awa"],"options":[{"bs":"sklonio je","en":"he/it sheltered"},{"bs":"koja ga je štitila","en":"that sheltered him"},{"bs":"i sklonili smo ih","en":"and we sheltered them (two)"},{"bs":"pa vas je sklonio","en":"so he/it sheltered you (all)"}],"ref":"12:69","answerWord":"ءَاوَىٰٓ","answerSound":"audio/ddad3f417eb38e41f05c.m4a","quranTranslation":{"text":"And when they went in before Joseph, he took his brother unto him, saying: Lo! I, even I, am thy brother, therefore sorrow not for what they did.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"skloniti, pružiti utočište","en":"to shelter, to give refuge"},"passage":["وَلَمَّا","دَخَلُوا۟","عَلَىٰ","يُوسُفَ","ءَاوَىٰٓ","إِلَيْهِ","أَخَاهُ","قَالَ","إِنِّىٓ","أَنَا۠","أَخُوكَ","فَلَا","تَبْتَئِسْ","بِمَا","كَانُوا۟","يَعْمَلُونَ"],"marked":[4],"facts":{"verb":"آوَى"}},{"id":"awa-8-26-11","words":["verb:awa"],"options":[{"bs":"pa vas je sklonio","en":"so he/it sheltered you (all)"},{"bs":"pa te je zaklonio","en":"and He sheltered (you)"},{"bs":"i sklonili smo ih","en":"and we sheltered them (two)"},{"bs":"sklonili su","en":"they sheltered"}],"ref":"8:26","answerWord":"فَـَٔاوَىٰكُمْ","answerSound":"audio/184023ee922112631989.m4a","quranTranslation":{"text":"And remember, when ye were few and reckoned feeble in the land, and were in fear lest men should extirpate you, how He gave you refuge, and strengthened you with His help, and made provision of good things for you, that haply ye might be thankful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"skloniti, pružiti utočište","en":"to shelter, to give refuge"},"passage":["وَٱذْكُرُوٓا۟","إِذْ","أَنتُمْ","قَلِيلٌ","مُّسْتَضْعَفُونَ","فِى","ٱلْأَرْضِ","تَخَافُونَ","أَن","يَتَخَطَّفَكُمُ","ٱلنَّاسُ","فَـَٔاوَىٰكُمْ","وَأَيَّدَكُم","بِنَصْرِهِۦ","وَرَزَقَكُم","مِّنَ","ٱلطَّيِّبَٰتِ","لَعَلَّكُمْ","تَشْكُرُونَ"],"marked":[11],"facts":{"verb":"آوَى"}},{"id":"awa-23-50-5","words":["verb:awa"],"options":[{"bs":"i sklonili smo ih","en":"and we sheltered them (two)"},{"bs":"pa te je zaklonio","en":"and He sheltered (you)"},{"bs":"koja ga je štitila","en":"that sheltered him"},{"bs":"pa vas je sklonio","en":"so he/it sheltered you (all)"}],"ref":"23:50","answerWord":"وَءَاوَيْنَٰهُمَآ","answerSound":"audio/21480c6cd22cd7b41422.m4a","quranTranslation":{"text":"And We made the son of Mary and his mother a portent, and We gave them refuge on a height, a place of flocks and watersprings.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"skloniti, pružiti utočište","en":"to shelter, to give refuge"},"passage":["وَجَعَلْنَا","ٱبْنَ","مَرْيَمَ","وَأُمَّهُۥٓ","ءَايَةً","وَءَاوَيْنَٰهُمَآ","إِلَىٰ","رَبْوَةٍ","ذَاتِ","قَرَارٍ","وَمَعِينٍ"],"marked":[5],"facts":{"verb":"آوَى"}},{"id":"awa-93-6-3","words":["verb:awa"],"options":[{"bs":"pa te je zaklonio","en":"and He sheltered (you)"},{"bs":"koja ga je štitila","en":"that sheltered him"},{"bs":"i sklonili smo ih","en":"and we sheltered them (two)"},{"bs":"pa vas je sklonio","en":"so he/it sheltered you (all)"}],"ref":"93:6","answerWord":"فَـَٔاوَىٰ","answerSound":"audio/4ad3aee75dfe3dc100bd.m4a","quranTranslation":{"text":"Did He not find thee an orphan and protect (thee)?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"skloniti, pružiti utočište","en":"to shelter, to give refuge"},"passage":["أَلَمْ","يَجِدْكَ","يَتِيمًا","فَـَٔاوَىٰ"],"marked":[3],"facts":{"verb":"آوَى"}},{"id":"ata-3-20-50-3","words":["verb:ata-3"],"options":[{"bs":"dao je","en":"he/it gave"},{"bs":"dali smo ti","en":"we gave you"},{"bs":"bivaju dati","en":"they are given"},{"bs":"dat će ti","en":"he will give you"}],"ref":"20:50","answerWord":"أَعْطَىٰ","answerSound":"audio/93567efe78db69a46c63.m4a","quranTranslation":{"text":"He said: Our Lord is He Who gave unto everything its nature, then guided it aright.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati, darovati","en":"to give"},"passage":["قَالَ","رَبُّنَا","ٱلَّذِىٓ","أَعْطَىٰ","كُلَّ","شَىْءٍ","خَلْقَهُۥ","ثُمَّ","هَدَىٰ"],"marked":[3],"facts":{"verb":"أَعْطَى"}},{"id":"ata-3-9-29-23","words":["verb:ata-3"],"options":[{"bs":"daju","en":"they give"},{"bs":"dat će ti","en":"he will give you"},{"bs":"dao je","en":"he/it gave"},{"bs":"dati su","en":"they were given"}],"ref":"9:29","answerWord":"يُعْطُوا۟","answerSound":"audio/ddc9d3a2ade787e74b6a.m4a","quranTranslation":{"text":"Fight against such of those who have been given the Scripture as believe not in Allah nor the Last Day, and forbid not that which Allah hath forbidden by His messenger, and follow not the Religion of Truth, until they pay the tribute readily, being brought low.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati, darovati","en":"to give"},"passage":["قَٰتِلُوا۟","ٱلَّذِينَ","لَا","يُؤْمِنُونَ","بِٱللَّهِ","وَلَا","بِٱلْيَوْمِ","ٱلْءَاخِرِ","وَلَا","يُحَرِّمُونَ","مَا","حَرَّمَ","ٱللَّهُ","وَرَسُولُهُۥ","وَلَا","يَدِينُونَ","دِينَ","ٱلْحَقِّ","مِنَ","ٱلَّذِينَ","أُوتُوا۟","ٱلْكِتَٰبَ","حَتَّىٰ","يُعْطُوا۟","ٱلْجِزْيَةَ","عَن","يَدٍ","وَهُمْ","صَٰغِرُونَ"],"marked":[23],"facts":{"verb":"أَعْطَى"}},{"id":"ata-3-9-58-6","words":["verb:ata-3"],"options":[{"bs":"dati su","en":"they were given"},{"bs":"i dao je","en":"and he gave"},{"bs":"daju","en":"they give"},{"bs":"dat će ti","en":"he will give you"}],"ref":"9:58","answerWord":"أُعْطُوا۟","answerSound":"audio/354003d7b65b6cda3339.m4a","quranTranslation":{"text":"And of them is he who defameth thee in the matter of the alms. If they are given thereof they are content, and if they are not given thereof, behold! they are enraged.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati, darovati","en":"to give"},"passage":["وَمِنْهُم","مَّن","يَلْمِزُكَ","فِى","ٱلصَّدَقَٰتِ","فَإِنْ","أُعْطُوا۟","مِنْهَا","رَضُوا۟","وَإِن","لَّمْ","يُعْطَوْا۟","مِنْهَآ","إِذَا","هُمْ","يَسْخَطُونَ"],"marked":[6],"facts":{"verb":"أَعْطَى"}},{"id":"ata-3-9-58-11","words":["verb:ata-3"],"options":[{"bs":"bivaju dati","en":"they are given"},{"bs":"dali smo ti","en":"we gave you"},{"bs":"dati su","en":"they were given"},{"bs":"i dao je","en":"and he gave"}],"ref":"9:58","answerWord":"يُعْطَوْا۟","answerSound":"audio/f5a83811eeb92c2a8195.m4a","quranTranslation":{"text":"And of them is he who defameth thee in the matter of the alms. If they are given thereof they are content, and if they are not given thereof, behold! they are enraged.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati, darovati","en":"to give"},"passage":["وَمِنْهُم","مَّن","يَلْمِزُكَ","فِى","ٱلصَّدَقَٰتِ","فَإِنْ","أُعْطُوا۟","مِنْهَا","رَضُوا۟","وَإِن","لَّمْ","يُعْطَوْا۟","مِنْهَآ","إِذَا","هُمْ","يَسْخَطُونَ"],"marked":[11],"facts":{"verb":"أَعْطَى"}},{"id":"ata-3-53-34-0","words":["verb:ata-3"],"options":[{"bs":"i dao je","en":"and he gave"},{"bs":"dali smo ti","en":"we gave you"},{"bs":"daju","en":"they give"},{"bs":"bivaju dati","en":"they are given"}],"ref":"53:34","answerWord":"وَأَعْطَىٰ","answerSound":"audio/f98c5ba90fc233872ae6.m4a","quranTranslation":{"text":"And gave a little, then was grudging?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati, darovati","en":"to give"},"passage":["وَأَعْطَىٰ","قَلِيلًا","وَأَكْدَىٰٓ"],"marked":[0],"facts":{"verb":"أَعْطَى"}},{"id":"ata-3-93-5-1","words":["verb:ata-3"],"options":[{"bs":"dat će ti","en":"he will give you"},{"bs":"dao je","en":"he/it gave"},{"bs":"dali smo ti","en":"we gave you"},{"bs":"dati su","en":"they were given"}],"ref":"93:5","answerWord":"يُعْطِيكَ","answerSound":"audio/ec2a452091e9adee5f3c.m4a","quranTranslation":{"text":"And verily thy Lord will give unto thee so that thou wilt be content.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati, darovati","en":"to give"},"passage":["وَلَسَوْفَ","يُعْطِيكَ","رَبُّكَ","فَتَرْضَىٰٓ"],"marked":[1],"facts":{"verb":"أَعْطَى"}},{"id":"ata-3-108-1-1","words":["verb:ata-3"],"options":[{"bs":"dali smo ti","en":"we gave you"},{"bs":"dao je","en":"he/it gave"},{"bs":"dat će ti","en":"he will give you"},{"bs":"dati su","en":"they were given"}],"ref":"108:1","answerWord":"أَعْطَيْنَٰكَ","answerSound":"audio/047ac24b2039a8e6cb73.m4a","quranTranslation":{"text":"Lo! We have given thee Abundance;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati, darovati","en":"to give"},"passage":["إِنَّآ","أَعْطَيْنَٰكَ","ٱلْكَوْثَرَ"],"marked":[1],"facts":{"verb":"أَعْطَى"}},{"id":"sallama-4-65-17","words":["verb:sallama"],"options":[{"bs":"i pokoravaju se","en":"and they submit"},{"bs":"pa pozdravite!","en":"so (you all) greet!"},{"bs":"i pozdravljate","en":"and you (all) greet"},{"bs":"predali ste","en":"you (all) delivered"}],"ref":"4:65","answerWord":"وَيُسَلِّمُوا۟","answerSound":"audio/65950ee7b6fe1c218255.m4a","quranTranslation":{"text":"But nay, by thy Lord, they will not believe (in truth) until they make thee judge of what is in dispute between them and find within themselves no dislike of that which thou decidest, and submit with full submission.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozdraviti, predati, pokoriti se","en":"to greet, to hand over, to submit"},"passage":["فَلَا","وَرَبِّكَ","لَا","يُؤْمِنُونَ","حَتَّىٰ","يُحَكِّمُوكَ","فِيمَا","شَجَرَ","بَيْنَهُمْ","ثُمَّ","لَا","يَجِدُوا۟","فِىٓ","أَنفُسِهِمْ","حَرَجًا","مِّمَّا","قَضَيْتَ","وَيُسَلِّمُوا۟","تَسْلِيمًا"],"marked":[17],"facts":{"verb":"سَلَّمَ"}},{"id":"sallama-8-43-15","words":["verb:sallama"],"options":[{"bs":"spasio je","en":"he/it saved"},{"bs":"i pokoravaju se","en":"and they submit"},{"bs":"i pozdravite!","en":"and (you all) greet!"},{"bs":"i pozdravljate","en":"and you (all) greet"}],"ref":"8:43","answerWord":"سَلَّمَ","answerSound":"audio/8e89c161e88729615c4d.m4a","quranTranslation":{"text":"When Allah showed them unto thee (O Muhammad) in thy dream as few in number, and if He had shown them to thee as many, ye (Muslims) would have faltered and would have quarrelled over the affair. But Allah saved (you). Lo! He knoweth what is in the breasts (of men).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozdraviti, predati, pokoriti se","en":"to greet, to hand over, to submit"},"passage":["إِذْ","يُرِيكَهُمُ","ٱللَّهُ","فِى","مَنَامِكَ","قَلِيلًا","وَلَوْ","أَرَىٰكَهُمْ","كَثِيرًا","لَّفَشِلْتُمْ","وَلَتَنَٰزَعْتُمْ","فِى","ٱلْأَمْرِ","وَلَٰكِنَّ","ٱللَّهَ","سَلَّمَ","إِنَّهُۥ","عَلِيمٌۢ","بِذَاتِ","ٱلصُّدُورِ"],"marked":[15],"facts":{"verb":"سَلَّمَ"}},{"id":"sallama-24-27-10","words":["verb:sallama"],"options":[{"bs":"i pozdravljate","en":"and you (all) greet"},{"bs":"i pokoravaju se","en":"and they submit"},{"bs":"spasio je","en":"he/it saved"},{"bs":"predali ste","en":"you (all) delivered"}],"ref":"24:27","answerWord":"وَتُسَلِّمُوا۟","answerSound":"audio/b3ffcb5307960af49d26.m4a","quranTranslation":{"text":"O ye who believe! Enter not houses other than your own without first announcing your presence and invoking peace upon the folk thereof. That is better for you, that ye may be heedful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozdraviti, predati, pokoriti se","en":"to greet, to hand over, to submit"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","لَا","تَدْخُلُوا۟","بُيُوتًا","غَيْرَ","بُيُوتِكُمْ","حَتَّىٰ","تَسْتَأْنِسُوا۟","وَتُسَلِّمُوا۟","عَلَىٰٓ","أَهْلِهَا","ذَٰلِكُمْ","خَيْرٌ","لَّكُمْ","لَعَلَّكُمْ","تَذَكَّرُونَ"],"marked":[10],"facts":{"verb":"سَلَّمَ"}},{"id":"sallama-33-56-11","words":["verb:sallama"],"options":[{"bs":"i pozdravite!","en":"and (you all) greet!"},{"bs":"spasio je","en":"he/it saved"},{"bs":"i pokoravaju se","en":"and they submit"},{"bs":"i pozdravljate","en":"and you (all) greet"}],"ref":"33:56","answerWord":"وَسَلِّمُوا۟","answerSound":"audio/f40ca3a4decd69867df4.m4a","quranTranslation":{"text":"Lo! Allah and His angels shower blessings on the Prophet. O ye who believe! Ask blessings on him and salute him with a worthy salutation.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozdraviti, predati, pokoriti se","en":"to greet, to hand over, to submit"},"passage":["إِنَّ","ٱللَّهَ","وَمَلَٰٓئِكَتَهُۥ","يُصَلُّونَ","عَلَى","ٱلنَّبِىِّ","يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","صَلُّوا۟","عَلَيْهِ","وَسَلِّمُوا۟","تَسْلِيمًا"],"marked":[11],"facts":{"verb":"سَلَّمَ"}}]