ide for", "bn": "রিযিক দাও", "fa": "روزی بده", "fr": "pourvois", "id": "berilah rezeki", "tr": "rızık ver", "ur": "رزق دے"}}, {"arabic": "أَهْلَنَا", "target": false, "translation": {"bs": "našu porodicu", "en": "our family", "bn": "আমাদের পরিবার", "fa": "خانواده‌مان", "fr": "notre famille", "id": "keluarga kami", "tr": "ailemiz", "ur": "ہمارے گھر والے"}}]}, {"arabic": "يَا رَبِّ أَنْتَ تَرْزُقُ مَنْ تَشَاءُ", "spoken": "audio/be108b9e3a215ad24d24.m4a", "tense": "present", "pronoun": "anta", "translation": {"bs": "Gospodaru moj, Ti opskrbljuješ koga hoćeš.", "en": "O my Lord, You provide for whom You will.", "bn": "হে আমার রব, আপনি যাকে চান তাকে রিযিক দেন।", "fa": "پروردگارا، تو هر که را بخواهی روزی می‌دهی.", "fr": "Ô mon Seigneur, Tu pourvois à qui Tu veux.", "id": "Ya Tuhanku, Engkau memberi rezeki kepada siapa yang Engkau kehendaki.", "tr": "Ey Rabbim, dilediğine rızık verirsin.", "ur": "اے میرے رب، تو جسے چاہتا ہے رزق دیتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَا", "target": false, "translation": {"bs": "-", "en": "O, oh", "bn": "হে", "fa": "ای", "fr": "ô", "id": "wahai", "tr": "ey", "ur": "اے"}}, {"arabic": "رَبِّ", "target": false, "translation": {"bs": "Gospodaru moj", "en": "my Lord", "bn": "আমার রব", "fa": "پروردگارم", "fr": "mon Seigneur", "id": "Tuhanku", "tr": "Rabbim", "ur": "میرے رب"}}, {"arabic": "أَنْتَ", "target": false, "translation": {"bs": "Ti", "en": "You", "bn": "আপনি", "fa": "تو", "fr": "Toi", "id": "Engkau", "tr": "Sen", "ur": "تو"}}, {"arabic": "تَرْزُقُ", "target": true, "translation": {"bs": "opskrbljuješ", "en": "provide for", "bn": "রিযিক দেন", "fa": "روزی می‌دهی", "fr": "Tu pourvois", "id": "berilah rezeki", "tr": "rızık verirsin", "ur": "تو رزق دیتا ہے"}}, {"arabic": "مَنْ", "target": false, "translation": {"bs": "koga", "en": "whom", "bn": "যাকে", "fa": "هر که را", "fr": "à qui", "id": "siapa", "tr": "kime", "ur": "جسے"}}, {"arabic": "تَشَاءُ", "target": false, "translation": {"bs": "hoćeš", "en": "You will, wish", "bn": "আপনি চান", "fa": "بخواهی", "fr": "Tu veux", "id": "Engkau kehendaki", "tr": "dilersin", "ur": "تو چاہتا ہے"}}]}]}