 "anta", "arabic": "كَلِّمْ", "plain": "كَلِّمْ", "quran": false, "notUsed": false, "spoken": "audio/47749975c2d5de0e8433.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "كَلِّمِي", "plain": "كَلِّمِي", "quran": false, "notUsed": false, "spoken": "audio/acd280ea73c59acb733c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "كَلِّمَا", "plain": "كَلِّمَا", "quran": false, "notUsed": false, "spoken": "audio/ee7174644b7ae297dd0e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "كَلِّمُوا", "plain": "كَلِّمُوا", "quran": false, "notUsed": false, "spoken": "audio/199af94eed894e3146a9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "كَلِّمْنَ", "plain": "كَلِّمْنَ", "quran": false, "notUsed": false, "spoken": "audio/3733c14695b9b68b27e5.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "3:46", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/339.mp3", "translation": {"en": {"text": "He will speak unto mankind in his cradle and in his manhood, and he is of the righteous.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Beşikte de, yetişkin çağında da insanlarla konuşacak ve iyilerden olacaktır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور لوگوں سے بات کرے گا پالنے میں اور پکی عمر میں اور خاصوں میں ہوگا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan dia berbicara dengan manusia dalam buaian dan ketika sudah dewasa dan dia adalah termasuk orang-orang yang saleh\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيُكَلِّمُ", "hit": true, "audio": "audio/49b6a33586e6c14818e7.m4a", "gloss": {"en": "and he/it speaks", "bs": "i govori", "tr": "ve konuşur", "fr": "et il parle", "id": "dan dia berbicara", "ur": "اور وہ کلام کرتا ہے", "bn": "এবং সে কথা বলে", "fa": "و سخن می‌گوید"}}, {"text": "ٱلنَّاسَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَهْدِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَكَهْلًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَمِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّٰلِحِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:65", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3770.mp3", "translation": {"en": {"text": "This day We seal up their mouths, and their hands speak out to Us and their feet bear witness as to what they used to earn.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bugün biz onların ağızlarını mühürleriz de neler kazandıklarını bize elleri söyler, ayakları da şahitlik eder.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "آج ہم ان کے مونھوں پر مہر کردیں گے اور ان کے ہاتھ ہم سے بات کریں گے اور ان پاؤں ان کے کئے کی گواہی دیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Pada hari ini Kami tutup mulut mereka; dan berkatalah kepada Kami tangan mereka dan memberi kesaksianlah kaki mereka terhadap apa yang dahulu mereka usahakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلْيَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَخْتِمُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَفْوَٰهِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتُكَلِّمُنَآ", "hit": true, "audio": "audio/0fe0817fbf32e4ec9d58.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": ["nahnu"], "mood": "indicative"}]}, {"text": "أَيْدِيهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَشْهَدُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْجُلُهُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَكْسِبُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:29", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2279.mp3", "translation": {"en": {"text": "Then she pointed to him. They said: How can we talk to one who is in the cradle, a young boy?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine Meryem çocuğu gösterdi. Onlar; \"Biz beşikteki bir çocukla nasıl konuşuruz?\" dediler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس پر مریم نے بچے کی طرف اشارہ کیا وہ بولے ہم کیسے بات کریں اس سے جو پالنے میں بچہ ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "maka Maryam menunjuk kepada anaknya. Mereka berkata: \"Bagaimana kami akan berbicara dengan anak kecil yang masih di dalam ayunan?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَشَارَتْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "كَيْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "نُكَلِّمُ", "hit": true, "audio": "audio/14ffc25483bce3499234.m4a", "gloss": {"en": "we speak", "bs": "govorimo", "tr": "konuşuruz", "fr": "nous parlons", "id": "kami berbicara", "ur": "ہم کلام کرتے ہیں", "bn": "আমরা কথা বলি", "fa": "سخن می‌گوییم"}}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَهْدِ", "hit": false, "audio": null, "gloss": null}, {"text": "صَبِيًّا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:108", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2781.mp3", "translation": {"en": {"text": "He saith: Begone therein, and speak not unto Me.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Allah) buyurur ki: Alçaldıkça alçalın orada! Bana konuşmayın artık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "رب فرمائے گا دھتکارے (خائب و خاسر) پڑے رہو اس میں اور مجھ سے بات نہ کرو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah berfirman: \"Tinggallah dengan hina di dalamnya, dan janganlah kamu berbicara dengan Aku.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱخْسَـُٔوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُكَلِّمُونِ", "hit": true, "audio": "audio/c6e5698d5d7e6d5e36dd.m4a", "gloss": {"bs": "obraćajte Mi se", "en": "speak to Me", "tr": "benimle konuşun", "fr": "parlez-Moi", "id": "berbicaralah kepada-Ku", "ur": "مجھ سے بات کرو", "bn": "তোমরা আমার সাথে কথা বলো", "fa": "با من سخن می‌گویید"}}]}], "forms": [{"arabic": "يُكَلِّمُهُمُ", "count": 2, "first": "2:174", "audio": "audio/6a090e7ee27e70fcb5e1.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"en": "he/it speaks to them", "bs": "govori im", "tr": "onlara söyler", "fr": "il leur parle", "id": "dia berbicara kepada mereka", "ur": "وہ ان سے کلام کرتا ہے", "bn": "সে তাদের সাথে কথা বলে", "fa": "با آنان سخن می‌گوید"}}, {"arabic": "تُكَلِّمَ", "count": 2, "first": "3:41