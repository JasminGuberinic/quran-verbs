{"rank": 51, "root": "ضلل", "form": 4, "lemma": "أَضَلَّ", "count": 64, "ayahCount": 60, "share": 0.33, "meaning": {"bs": "zavesti, odvesti u zabludu", "en": "to mislead, to lead astray", "tr": "saptırmak, yoldan çıkarmak", "fr": "égarer, induire en erreur", "id": "menyesatkan", "ur": "گمراہ کرنا", "bn": "পথভ্রষ্ট করা, বিভ্রান্ত করা", "fa": "گمراه کردن"}, "lemmaSpoken": "audio/da2033c0223574629f13.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَضَلَّ", "plain": "أَضَلَّ", "quran": true, "notUsed": false, "spoken": "audio/da2033c0223574629f13.m4a", "recited": "audio/3a10c6a3acdb51ca6825.m4a", "recitedText": "أَضَلَّ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُضِلُّ", "plain": "يُضِلُّ", "quran": true, "notUsed": false, "spoken": "audio/6003a80e6fb8f3d00d27.m4a", "recited": "audio/1762f1718141962e4f80.m4a", "recitedText": "يُضِلُّ"}], "nouns": {"participle": {"lemma": "مُضِلّ", "count": 3, "spoken": "audio/e7982da2bb782b190f93.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَضْلَلْتُ", "plain": "أَضْلَلْتُ", "quran": false, "notUsed": false, "spoken": "audio/f05021c7c62df11890b6.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَضْلَلْنَا", "plain": "أَضْلَلْنَا", "quran": false, "notUsed": false, "spoken": "audio/f6dce104650c36eb08dd.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "أَضْلَلْتَ", "plain": "أَضْلَلْتَ", "quran": false, "notUsed": false, "spoken": "audio/4cb7a4819c3ced193fd6.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "أَضْلَلْتِ", "plain": "أَضْلَلْتِ", "quran": false, "notUsed": false, "spoken": "audio/2e2a7562fdb862616747.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "أَضْلَلْتُمَا", "plain": "أَضْلَلْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/986f4724568388802b25.m4a", "recited": null, "recitedText": n