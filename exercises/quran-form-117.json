[{"id":"ihtada-16-16-3","words":["verb:ihtada"],"options":[{"bs":"nalaze put","en":"they are guided"},{"bs":"bili ste upućeni","en":"you (all) were guided"},{"bs":"bili su upućeni","en":"they were guided"},{"bs":"upućeni ste","en":"you (all) are guided"}],"ref":"16:16","answerWord":"يَهْتَدُونَ","answerSound":"audio/e01e100fe7ff1f6f4a5c.m4a","quranTranslation":{"text":"And landmarks (too), and by the star they find a way.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["وَعَلَٰمَٰتٍ","وَبِٱلنَّجْمِ","هُمْ","يَهْتَدُونَ"],"marked":[3],"facts":{"verb":"اهْتَدَى"}},{"id":"ihtada-20-82-8","words":["verb:ihtada"],"options":[{"bs":"bio je upućen","en":"he/it was guided"},{"bs":"bili ste upućeni","en":"you (all) were guided"},{"bs":"nalaze put","en":"they are guided"},{"bs":"da se uputimo","en":"so that we may be guided"}],"ref":"20:82","answerWord":"ٱهْتَدَىٰ","answerSound":"audio/5cd6e46202220ca614a4.m4a","quranTranslation":{"text":"And lo! verily I am Forgiving toward him who repenteth and believeth and doeth good, and afterward walketh aright.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["وَإِنِّى","لَغَفَّارٌ","لِّمَن","تَابَ","وَءَامَنَ","وَعَمِلَ","صَٰلِحًا","ثُمَّ","ٱهْتَدَىٰ"],"marked":[8],"facts":{"verb":"اهْتَدَى"}},{"id":"ihtada-2-53-6","words":["verb:ihtada"],"options":[{"bs":"upućeni ste","en":"you (all) are guided"},{"bs":"bili ste upućeni","en":"you (all) were guided"},{"bs":"bio sam upućen","en":"I was guided"},{"bs":"bio je upućen","en":"he/it was guided"}],"ref":"2:53","answerWord":"تَهْتَدُونَ","answerSound":"audio/563e9ec04688f73697ce.m4a","quranTranslation":{"text":"And when We gave unto Moses the Scripture and the criterion (of right and wrong), that ye might be led aright.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["وَإِذْ","ءَاتَيْنَا","مُوسَى","ٱلْكِتَٰبَ","وَٱلْفُرْقَانَ","لَعَلَّكُمْ","تَهْتَدُونَ"],"marked":[6],"facts":{"verb":"اهْتَدَى"}},{"id":"ihtada-10-108-11","words":["verb:ihtada"],"options":[{"bs":"upućen je","en":"he/it is guided"},{"bs":"bili su upućeni","en":"they were guided"},{"bs":"bio je upućen","en":"he/it was guided"},{"bs":"upućeni ste","en":"you (all) are guided"}],"ref":"10:108","answerWord":"يَهْتَدِى","answerSound":"audio/6e3462d6c1cb56d82243.m4a","quranTranslation":{"text":"Say: O mankind! Now hath the Truth from your Lord come unto you. So whosoever is guided, is guided only for (the good of) his soul, and whosoever erreth erreth only against it. And I am not a warder over you.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["قُلْ","يَٰٓأَيُّهَا","ٱلنَّاسُ","قَدْ","جَآءَكُمُ","ٱلْحَقُّ","مِن","رَّبِّكُمْ","فَمَنِ","ٱهْتَدَىٰ","فَإِنَّمَا","يَهْتَدِى","لِنَفْسِهِۦ","وَمَن","ضَلَّ","فَإِنَّمَا","يَضِلُّ","عَلَيْهَا","وَمَآ","أَنَا۠","عَلَيْكُم","بِوَكِيلٍ"],"marked":[11],"facts":{"verb":"اهْتَدَى"}},{"id":"ihtada-2-137-7","words":["verb:ihtada"],"options":[{"bs":"bili su upućeni","en":"they were guided"},{"bs":"upućeni su","en":"they are guided"},{"bs":"bio sam upućen","en":"I was guided"},{"bs":"bili ste upućeni","en":"you (all) were guided"}],"ref":"2:137","answerWord":"ٱهْتَدَوا۟","answerSound":"audio/1c43772e00756de214bc.m4a","quranTranslation":{"text":"And if they believe in the like of that which ye believe, then are they rightly guided. But if they turn away, then are they in schism, and Allah will suffice thee (for defence) against them. He is the Hearer, the Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["فَإِنْ","ءَامَنُوا۟","بِمِثْلِ","مَآ","ءَامَنتُم","بِهِۦ","فَقَدِ","ٱهْتَدَوا۟","وَّإِن","تَوَلَّوْا۟","فَإِنَّمَا","هُمْ","فِى","شِقَاقٍ","فَسَيَكْفِيكَهُمُ","ٱللَّهُ","وَهُوَ","ٱلسَّمِيعُ","ٱلْعَلِيمُ"],"marked":[7],"facts":{"verb":"اهْتَدَى"}},{"id":"ihtada-47-17-1","words":["verb:ihtada"],"options":[{"bs":"upućeni su","en":"were guided"},{"bs":"da se uputite","en":"so that you (all) may be guided"},{"bs":"bio sam upućen","en":"I was guided"},{"bs":"nalaze put","en":"they are guided"}],"ref":"47:17","answerWord":"ٱهْتَدَوْا۟","answerSound":"audio/9f88d5f061063aa38717.m4a","quranTranslation":{"text":"While as for those who walk aright, He addeth to their guidance, and giveth them their protection (against evil).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["وَٱلَّذِينَ","ٱهْتَدَوْا۟","زَادَهُمْ","هُدًى","وَءَاتَىٰهُمْ","تَقْوَىٰهُمْ"],"marked":[1],"facts":{"verb":"اهْتَدَى"}},{"id":"ihtada-5-105-10","words":["verb:ihtada"],"options":[{"bs":"bili ste upućeni","en":"you (all) were guided"},{"bs":"bio sam upućen","en":"I was guided"},{"bs":"nalaze put","en":"they are guided"},{"bs":"da se uputimo","en":"so that we may be guided"}],"ref":"5:105","answerWord":"ٱهْتَدَيْتُمْ","answerSound":"audio/0a23825f0d79b3816738.m4a","quranTranslation":{"text":"O ye who believe! Ye have charge of your own souls. He who erreth cannot injure you if ye are rightly guided. Unto Allah ye will all return; and then He will inform you of what ye used to do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","عَلَيْكُمْ","أَنفُسَكُمْ","لَا","يَضُرُّكُم","مَّن","ضَلَّ","إِذَا","ٱهْتَدَيْتُمْ","إِلَى","ٱللَّهِ","مَرْجِعُكُمْ","جَمِيعًا","فَيُنَبِّئُكُم","بِمَا","كُنتُمْ","تَعْمَلُونَ"],"marked":[10],"facts":{"verb":"اهْتَدَى"}},{"id":"ihtada-6-97-5","words":["verb:ihtada"],"options":[{"bs":"da se uputite","en":"so that you (all) may be guided"},{"bs":"upućen je","en":"he/it is guided"},{"bs":"nalaze put","en":"they are guided"},{"bs":"bili su upućeni","en":"they were guided"}],"ref":"6:97","answerWord":"لِتَهْتَدُوا۟","answerSound":"audio/c1e9649732f0558660a5.m4a","quranTranslation":{"text":"And He it is Who hath set for you the stars that ye may guide your course by them amid the darkness of the land and the sea. We have detailed Our revelations for a people who have knowledge.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["وَهُوَ","ٱلَّذِى","جَعَلَ","لَكُمُ","ٱلنُّجُومَ","لِتَهْتَدُوا۟","بِهَا","فِى","ظُلُمَٰتِ","ٱلْبَرِّ","وَٱلْبَحْرِ","قَدْ","فَصَّلْنَا","ٱلْءَايَٰتِ","لِقَوْمٍ","يَعْلَمُونَ"],"marked":[5],"facts":{"verb":"اهْتَدَى"}},{"id":"ihtada-10-35-21","words":["verb:ihtada"],"options":[{"bs":"upućen je","en":"he/it is guided"},{"bs":"upućeni su","en":"they are guided"},{"bs":"bio sam upućen","en":"I was guided"},{"bs":"bio je upućen","en":"he/it was guided"}],"ref":"10:35","answerWord":"يَهِدِّىٓ","answerSound":"audio/704b481f73643991fcc9.m4a","quranTranslation":{"text":"Say: Is there of your partners (whom ye ascribe unto Allah) one that leadeth to the Truth? Say: Allah leadeth to the Truth. Is He Who leadeth to the Truth more deserving that He should be followed, or he who findeth not the way unless he (himself) be guided. What aileth you? How judge ye?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["قُلْ","هَلْ","مِن","شُرَكَآئِكُم","مَّن","يَهْدِىٓ","إِلَى","ٱلْحَقِّ","قُلِ","ٱللَّهُ","يَهْدِى","لِلْحَقِّ","أَفَمَن","يَهْدِىٓ","إِلَى","ٱلْحَقِّ","أَحَقُّ","أَن","يُتَّبَعَ","أَمَّن","لَّا","يَهِدِّىٓ","إِلَّآ","أَن","يُهْدَىٰ","فَمَا","لَكُمْ","كَيْفَ","تَحْكُمُونَ"],"marked":[21],"facts":{"verb":"اهْتَدَى"}},{"id":"ihtada-18-57-27","words":["verb:ihtada"],"options":[{"bs":"upućeni su","en":"they are guided"},{"bs":"upućeni ste","en":"you (all) are guided"},{"bs":"bili su upućeni","en":"they were guided"},{"bs":"da se uputimo","en":"so that we may be guided"}],"ref":"18:57","answerWord":"يَهْتَدُوٓا۟","answerSound":"audio/e6b3666cb17ebd05c91e.m4a","quranTranslation":{"text":"And who doth greater wrong than he who hath been reminded of the revelations of his Lord, yet turneth away from them and forgetteth what his hands send forward (to the Judgment)? Lo! on their hearts We have placed coverings so that they understand not, and in their ears a deafness. And though thou call them to the guidance, in that case they can never be led aright.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["وَمَنْ","أَظْلَمُ","مِمَّن","ذُكِّرَ","بِـَٔايَٰتِ","رَبِّهِۦ","فَأَعْرَضَ","عَنْهَا","وَنَسِىَ","مَا","قَدَّمَتْ","يَدَاهُ","إِنَّا","جَعَلْنَا","عَلَىٰ","قُلُوبِهِمْ","أَكِنَّةً","أَن","يَفْقَهُوهُ","وَفِىٓ","ءَاذَانِهِمْ","وَقْرًا","وَإِن","تَدْعُهُمْ","إِلَى","ٱلْهُدَىٰ","فَلَن","يَهْتَدُوٓا۟","إِذًا","أَبَدًا"],"marked":[27],"facts":{"verb":"اهْتَدَى"}},{"id":"ihtada-34-50-8","words":["verb:ihtada"],"options":[{"bs":"bio sam upućen","en":"I was guided"},{"bs":"upućeni su","en":"they are guided"},{"bs":"bili su upućeni","en":"they were guided"},{"bs":"upućeni ste","en":"you (all) are guided"}],"ref":"34:50","answerWord":"ٱهْتَدَيْتُ","answerSound":"audio/540d2db5a42ee90528a9.m4a","quranTranslation":{"text":"Say: If I err, I err only to my own loss, and if I am rightly guided it is because of that which my Lord hath revealed unto me. Lo! He is Hearer, Nigh.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["قُلْ","إِن","ضَلَلْتُ","فَإِنَّمَآ","أَضِلُّ","عَلَىٰ","نَفْسِى","وَإِنِ","ٱهْتَدَيْتُ","فَبِمَا","يُوحِىٓ","إِلَىَّ","رَبِّىٓ","إِنَّهُۥ","سَمِيعٌ","قَرِيبٌ"],"marked":[8],"facts":{"verb":"اهْتَدَى"}},{"id":"ihtada-46-11-13","words":["verb:ihtada"],"options":[{"bs":"upućeni su","en":"they are guided"},{"bs":"da se uputimo","en":"so that we may be guided"},{"bs":"bili su upućeni","en":"they were guided"},{"bs":"upućen je","en":"he/it is guided"}],"ref":"46:11","answerWord":"يَهْتَدُوا۟","answerSound":"audio/7349660d7a18f2628c03.m4a","quranTranslation":{"text":"And those who disbelieve say of those who believe: If it had been (any) good, they would not have been before us in attaining it. And since they will not be guided by it, they say: This is an ancient lie;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti upućen, naći put","en":"to be guided, to find the way"},"passage":["وَقَالَ","ٱلَّذِينَ","كَفَرُوا۟","لِلَّذِينَ","ءَامَنُوا۟","لَوْ","كَانَ","خَيْرًا","مَّا","سَبَقُونَآ","إِلَيْهِ","وَإِذْ","لَمْ","يَهْتَدُوا۟","بِهِۦ","فَسَيَقُولُونَ","هَٰذَآ","إِفْكٌ","قَدِيمٌ"],"marked":[13],"facts":{"verb":"اهْتَدَى"}},{"id":"istajaba-42-38-1","words":["verb:istajaba"],"options":[{"bs":"odazvali su se","en":"they answered"},{"bs":"pa neka se odazovu","en":"so let them answer"},{"bs":"pa ste se odazvali","en":"so you (all) answered"},{"bs":"i vi ćete se odazvati","en":"and you will respond"}],"ref":"42:38","answerWord":"ٱسْتَجَابُوا۟","answerSound":"audio/6a98b22273db382322a2.m4a","quranTranslation":{"text":"And those who answer the call of their Lord and establish worship, and whose affairs are a matter of counsel, and who spend of what We have bestowed on them,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odazvati se, uslišati","en":"to answer, to respond"},"passage":["وَٱلَّذِينَ","ٱسْتَجَابُوا۟","لِرَبِّهِمْ","وَأَقَامُوا۟","ٱلصَّلَوٰةَ","وَأَمْرُهُمْ","شُورَىٰ","بَيْنَهُمْ","وَمِمَّا","رَزَقْنَٰهُمْ","يُنفِقُونَ"],"marked":[1],"facts":{"verb":"اسْتَجابَ"}},{"id":"istajaba-21-88-0","words":["verb:istajaba"],"options":[{"bs":"pa smo se odazvali","en":"so We answered"},{"bs":"odazivam se","en":"I answer"},{"bs":"pa neka se odazovu","en":"so let them answer"},{"bs":"odaziva se","en":"he/it answers"}],"ref":"21:88","answerWord":"فَٱسْتَجَبْنَا","answerSound":"audio/c7e269dbff09cf976821.m4a","quranTranslation":{"text":"Then we heard his prayer and saved him from the anguish. Thus we save believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odazvati se, uslišati","en":"to answer, to respond"},"passage":["فَٱسْتَجَبْنَا","لَهُۥ","وَنَجَّيْنَٰهُ","مِنَ","ٱلْغَمِّ","وَكَذَٰلِكَ","نُۨجِى","ٱلْمُؤْمِنِينَ"],"marked":[0],"facts":{"verb":"اسْتَجابَ"}},{"id":"istajaba-2-186-11","words":["verb:istajaba"],"options":[{"bs":"pa neka se odazovu","en":"so let them answer"},{"bs":"odazivam se","en":"I answer"},{"bs":"odazvali su se","en":"they answered"},{"bs":"i odaziva se","en":"and he/it answers"}],"ref":"2:186","answerWord":"فَلْيَسْتَجِيبُوا۟","answerSound":"audio/3dce5353a6365edf0b9a.m4a","quranTranslation":{"text":"And when My servants question thee concerning Me, then surely I am nigh. I answer the prayer of the suppliant when he crieth unto Me. So let them hear My call and let them trust in Me, in order that they may be led aright.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odazvati se, uslišati","en":"to answer, to respond"},"passage":["وَإِذَا","سَأَلَكَ","عِبَادِى","عَنِّى","فَإِنِّى","قَرِيبٌ","أُجِيبُ","دَعْوَةَ","ٱلدَّاعِ","إِذَا","دَعَانِ","فَلْيَسْتَجِيبُوا۟","لِى","وَلْيُؤْمِنُوا۟","بِى","لَعَلَّهُمْ","يَرْشُدُونَ"],"marked":[11],"facts":{"verb":"اسْتَجابَ"}},{"id":"istajaba-6-36-1","words":["verb:istajaba"],"options":[{"bs":"odaziva se","en":"he/it answers"},{"bs":"odazovite se!","en":"(you all) answer!"},{"bs":"pa neka se odazovu","en":"so let them answer"},{"bs":"odazivam se","en":"I answer"}],"ref":"6:36","answerWord":"يَسْتَجِيبُ","answerSound":"audio/0278abdeef5a64116ac2.m4a","quranTranslation":{"text":"Only those can accept who hear. As for the dead, Allah will raise them up; then unto Him they will be returned.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odazvati se, uslišati","en":"to answer, to respond"},"passage":["إِنَّمَا","يَسْتَجِيبُ","ٱلَّذِينَ","يَسْمَعُونَ","وَٱلْمَوْتَىٰ","يَبْعَثُهُمُ","ٱللَّهُ","ثُمَّ","إِلَيْهِ","يُرْجَعُونَ"],"marked":[1],"facts":{"verb":"اسْتَجابَ"}},{"id":"istajaba-8-24-3","words":["verb:istajaba"],"options":[{"bs":"odazovite se!","en":"(you all) answer!"},{"bs":"pa smo se odazvali","en":"so We answered"},{"bs":"uslišan je","en":"he/it was answered"},{"bs":"odazivaju se","en":"they answer"}],"ref":"8:24","answerWord":"ٱسْتَجِيبُوا۟","answerSound":"audio/ea493f2af110e1534288.m4a","quranTranslation":{"text":"O ye who believe! Obey Allah, and the messenger when He calleth you to that which quickeneth you, and know that Allah cometh in between the man and his own heart, and that He it is unto Whom ye will be gathered.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odazvati se, uslišati","en":"to answer, to respond"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","ٱسْتَجِيبُوا۟","لِلَّهِ","وَلِلرَّسُولِ","إِذَا","دَعَاكُمْ","لِمَا","يُحْيِيكُمْ","وَٱعْلَمُوٓا۟","أَنَّ","ٱللَّهَ","يَحُولُ","بَيْنَ","ٱلْمَرْءِ","وَقَلْبِهِۦ","وَأَنَّهُۥٓ","إِلَيْهِ","تُحْشَرُونَ"],"marked":[3],"facts":{"verb":"اسْتَجابَ"}},{"id":"istajaba-13-14-8","words":["verb:istajaba"],"options":[{"bs":"odazivaju se","en":"they answer"},{"bs":"odazovite se!","en":"(you all) answer!"},{"bs":"i odaziva se","en":"and he/it answers"},{"bs":"odazvali su se","en":"they answered"}],"ref":"13:14","answerWord":"يَسْتَجِيبُونَ","answerSound":"audio/9d56532a33f984246f65.m4a","quranTranslation":{"text":"Unto Him is the real prayer. Those unto whom they pray beside Allah respond to them not at all, save as (is the response to) one who stretcheth forth his hands toward water (asking) that it may come unto his mouth, and it will never reach it. The prayer of disbelievers goeth (far) astray.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odazvati se, uslišati","en":"to answer, to respond"},"passage":["لَهُۥ","دَعْوَةُ","ٱلْحَقِّ","وَٱلَّذِينَ","يَدْعُونَ","مِن","دُونِهِۦ","لَا","يَسْتَجِيبُونَ","لَهُم","بِشَىْءٍ","إِلَّا","كَبَٰسِطِ","كَفَّيْهِ","إِلَى","ٱلْمَآءِ","لِيَبْلُغَ","فَاهُ","وَمَا","هُوَ","بِبَٰلِغِهِۦ","وَمَا","دُعَآءُ","ٱلْكَٰفِرِينَ","إِلَّا","فِى","ضَلَٰلٍ"],"marked":[8],"facts":{"verb":"اسْتَجابَ"}},{"id":"istajaba-17-52-2","words":["verb:istajaba"],"options":[{"bs":"i vi ćete se odazvati","en":"and you will respond"},{"bs":"pa ste se odazvali","en":"so you (all) answered"},{"bs":"pa smo se odazvali","en":"so We answered"},{"bs":"odazivaju se","en":"they answer"}],"ref":"17:52","answerWord":"فَتَسْتَجِيبُونَ","answerSound":"audio/b533c3182f4b2de35a81.m4a","quranTranslation":{"text":"A day when He will call you and ye will answer with His praise, and ye will think that ye have tarried but a little while.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odazvati se, uslišati","en":"to answer, to respond"},"passage":["يَوْمَ","يَدْعُوكُمْ","فَتَسْتَجِيبُونَ","بِحَمْدِهِۦ","وَتَظُنُّونَ","إِن","لَّبِثْتُمْ","إِلَّا","قَلِيلًا"],"marked":[2],"facts":{"verb":"اسْتَجابَ"}},{"id":"istajaba-40-60-3","words":["verb:istajaba"],"options":[{"bs":"odazivam se","en":"I answer"},{"bs":"i odaziva se","en":"and he/it answers"},{"bs":"uslišan je","en":"he/it was answered"},{"bs":"odazivaju se","en":"they answer"}],"ref":"40:60","answerWord":"أَسْتَجِبْ","answerSound":"audio/4e8aa1fc6697dc627af7.m4a","quranTranslation":{"text":"And your Lord hath said: Pray unto Me and I will hear your prayer. Lo! those who scorn My service, they will enter hell, disgraced.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odazvati se, uslišati","en":"to answer, to respond"},"passage":["وَقَالَ","رَبُّكُمُ","ٱدْعُونِىٓ","أَسْتَجِبْ","لَكُمْ","إِنَّ","ٱلَّذِينَ","يَسْتَكْبِرُونَ","عَنْ","عِبَادَتِى","سَيَدْخُلُونَ","جَهَنَّمَ","دَاخِرِينَ"],"marked":[3],"facts":{"verb":"اسْتَجابَ"}},{"id":"istajaba-42-16-7","words":["verb:istajaba"],"options":[{"bs":"uslišan je","en":"he/it was answered"},{"bs":"pa smo se odazvali","en":"so We answered"},{"bs":"pa ste se odazvali","en":"so you (all) answered"},{"bs":"odazvali su se","en":"they answered"}],"ref":"42:16","answerWord":"ٱسْتُجِيبَ","answerSound":"audio/3b868326271f1fbb46b9.m4a","quranTranslation":{"text":"And those who argue concerning Allah after He hath been acknowledged, their argument hath no weight with their Lord, and wrath is upon them and theirs will be an awful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odazvati se, uslišati","en":"to answer, to respond"},"passage":["وَٱلَّذِينَ","يُحَآجُّونَ","فِى","ٱللَّهِ","مِنۢ","بَعْدِ","مَا","ٱسْتُجِيبَ","لَهُۥ","حُجَّتُهُمْ","دَاحِضَةٌ","عِندَ","رَبِّهِمْ","وَعَلَيْهِمْ","غَضَبٌ","وَلَهُمْ","عَذَابٌ","شَدِيدٌ"],"marked":[7],"facts":{"verb":"اسْتَجابَ"}},{"id":"istajaba-42-26-0","words":["verb:istajaba"],"options":[{"bs":"i odaziva se","en":"and he/it answers"},{"bs":"uslišan je","en":"he/it was answered"},{"bs":"odazivam se","en":"I answer"},{"bs":"pa ste se odazvali","en":"so you (all) answered"}],"ref":"42:26","answerWord":"وَيَسْتَجِيبُ","answerSound":"audio/db553f954b0a323b7765.m4a","quranTranslation":{"text":"And accepteth those who do good works, and giveth increase unto them of His bounty. And as for disbelievers, theirs will be an awful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odazvati se, uslišati","en":"to answer, to respond"},"passage":["وَيَسْتَجِيبُ","ٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","وَيَزِيدُهُم","مِّن","فَضْلِهِۦ","وَٱلْكَٰفِرُونَ","لَهُمْ","عَذَابٌ","شَدِيدٌ"],"marked":[0],"facts":{"verb":"اسْتَجابَ"}},{"id":"khana-8-27-4","words":["verb:khana"],"options":[{"bs":"iznevjerite","en":"you (all) betray"},{"bs":"izdali su","en":"they betrayed"},{"bs":"pa su ih izdale","en":"so they (two) betrayed them (two)"},{"bs":"izdajem ga","en":"I betray him"}],"ref":"8:27","answerWord":"تَخُونُوا۟","answerSound":"audio/386b28f6b490b1f67a04.m4a","quranTranslation":{"text":"O ye who believe! Betray not Allah and His messenger, nor knowingly betray your trusts.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izdati, iznevjeriti","en":"to betray"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","لَا","تَخُونُوا۟","ٱللَّهَ","وَٱلرَّسُولَ","وَتَخُونُوٓا۟","أَمَٰنَٰتِكُمْ","وَأَنتُمْ","تَعْلَمُونَ"],"marked":[4],"facts":{"verb":"خَانَ"}},{"id":"khana-8-27-7","words":["verb:khana"],"options":[{"bs":"i iznevjerite","en":"and you (all) betray"},{"bs":"izdali su","en":"they betrayed"},{"bs":"pa su ih izdale","en":"so they (two) betrayed them (two)"},{"bs":"izdajem ga","en":"I betray him"}],"ref":"8:27","answerWord":"وَتَخُونُوٓا۟","answerSound":"audio/e5361521bcb60f794156.m4a","quranTranslation":{"text":"O ye who believe! Betray not Allah and His messenger, nor knowingly betray your trusts.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izdati, iznevjeriti","en":"to betray"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","لَا","تَخُونُوا۟","ٱللَّهَ","وَٱلرَّسُولَ","وَتَخُونُوٓا۟","أَمَٰنَٰتِكُمْ","وَأَنتُمْ","تَعْلَمُونَ"],"marked":[7],"facts":{"verb":"خَانَ"}},{"id":"khana-8-71-4","words":["verb:khana"],"options":[{"bs":"izdali su","en":"they betrayed"},{"bs":"i iznevjerite","en":"and you (all) betray"},{"bs":"pa su ih izdale","en":"so they (two) betrayed them (two)"},{"bs":"izdajem ga","en":"I betray him"}],"ref":"8:71","answerWord":"خَانُوا۟","answerSound":"audio/c50321dbef9a6d7b57d0.m4a","quranTranslation":{"text":"And if they would betray thee, they betrayed Allah before, and He gave (thee) power over them. Allah is Knower, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izdati, iznevjeriti","en":"to betray"},"passage":["وَإِن","يُرِيدُوا۟","خِيَانَتَكَ","فَقَدْ","خَانُوا۟","ٱللَّهَ","مِن","قَبْلُ","فَأَمْكَنَ","مِنْهُمْ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"marked":[4],"facts":{"verb":"خَانَ"}},{"id":"khana-12-52-4","words":["verb:khana"],"options":[{"bs":"izdajem ga","en":"I betray him"},{"bs":"i iznevjerite","en":"and you (all) betray"},{"bs":"pa su ih izdale","en":"so they (two) betrayed them (two)"},{"bs":"izdali su","en":"they betrayed"}],"ref":"12:52","answerWord":"أَخُنْهُ","answerSound":"audio/ccbbb7a437068ab64f04.m4a","quranTranslation":{"text":"(Then Joseph said: I asked for) this, that he (my lord) may know that I betrayed him not in secret, and that surely Allah guideth not the snare of the betrayers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izdati, iznevjeriti","en":"to betray"},"passage":["ذَٰلِكَ","لِيَعْلَمَ","أَنِّى","لَمْ","أَخُنْهُ","بِٱلْغَيْبِ","وَأَنَّ","ٱللَّهَ","لَا","يَهْدِى","كَيْدَ","ٱلْخَآئِنِينَ"],"marked":[4],"facts":{"verb":"خَانَ"}},{"id":"khana-66-10-15","words":["verb:khana"],"options":[{"bs":"pa su ih izdale","en":"so they (two) betrayed them (two)"},{"bs":"i iznevjerite","en":"and you (all) betray"},{"bs":"izdajem ga","en":"I betray him"},{"bs":"izdali su","en":"they betrayed"}],"ref":"66:10","answerWord":"فَخَانَتَاهُمَا","answerSound":"audio/4b5318a5fe9a5b25434c.m4a","quranTranslation":{"text":"Allah citeth an example for those who disbelieve: the wife of Noah and the wife of Lot, who were under two of Our righteous slaves yet betrayed them so that they (the husbands) availed them naught against Allah and it was said (unto them): Enter the Fire along with those who enter.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izdati, iznevjeriti","en":"to betray"},"passage":["ضَرَبَ","ٱللَّهُ","مَثَلًا","لِّلَّذِينَ","كَفَرُوا۟","ٱمْرَأَتَ","نُوحٍ","وَٱمْرَأَتَ","لُوطٍ","كَانَتَا","تَحْتَ","عَبْدَيْنِ","مِنْ","عِبَادِنَا","صَٰلِحَيْنِ","فَخَانَتَاهُمَا","فَلَمْ","يُغْنِيَا","عَنْهُمَا","مِنَ","ٱللَّهِ","شَيْـًٔا","وَقِيلَ","ٱدْخُلَا","ٱلنَّارَ","مَعَ","ٱلدَّٰخِلِينَ"],"marked":[15],"facts":{"verb":"خَانَ"}},{"id":"raghiba-2-130-1","words":["verb:raghiba"],"options":[{"bs":"odvraća se","en":"he/it turns away"},{"bs":"i želite","en":"and you (all) desire"},{"bs":"pa se usmjeri sa žudnjom","en":"so turn with longing"},{"bs":"daju prednost","en":"they prefer"}],"ref":"2:130","answerWord":"يَرْغَبُ","answerSound":"audio/e958374e345657f99959.m4a","quranTranslation":{"text":"And who forsaketh the religion of Abraham save him who befooleth himself? Verily We chose him in the world, and lo! in the Hereafter he is among the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"željeti, žudjeti","en":"to desire, to long for"},"passage":["وَمَن","يَرْغَبُ","عَن","مِّلَّةِ","إِبْرَٰهِۦمَ","إِلَّا","مَن","سَفِهَ","نَفْسَهُۥ","وَلَقَدِ","ٱصْطَفَيْنَٰهُ","فِى","ٱلدُّنْيَا","وَإِنَّهُۥ","فِى","ٱلْءَاخِرَةِ","لَمِنَ","ٱلصَّٰلِحِينَ"],"marked":[1],"facts":{"verb":"رَغِبَ"}},{"id":"raghiba-94-8-2","words":["verb:raghiba"],"options":[{"bs":"pa se usmjeri sa žudnjom","en":"so turn with longing"},{"bs":"daju prednost","en":"they prefer"},{"bs":"i želite","en":"and you (all) desire"},{"bs":"odvraća se","en":"he/it turns away"}],"ref":"94:8","answerWord":"فَٱرْغَب","answerSound":"audio/739b6d73018975d924b7.m4a","quranTranslation":{"text":"And strive to please thy Lord.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"željeti, žudjeti","en":"to desire, to long for"},"passage":["وَإِلَىٰ","رَبِّكَ","فَٱرْغَب"],"marked":[2],"facts":{"verb":"رَغِبَ"}}]