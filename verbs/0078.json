 "quran": true, "notUsed": false, "spoken": "audio/4fb26dd149835158d9f5.m4a", "recited": "audio/f8ec676b3ec717171f2c.m4a", "recitedText": "تَحْكُمُونَ"}, {"tense": "present", "pronoun": "antunna", "arabic": "تَحْكُمْنَ", "plain": "تَحْكُمْنَ", "quran": false, "notUsed": false, "spoken": "audio/03b0fffdda292f6c48e9.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَحْكُمُ", "plain": "يَحْكُمُ", "quran": true, "notUsed": false, "spoken": "audio/c2b0e4c1f5e8cd0348a1.m4a", "recited": "audio/3405227a8fe01534a43d.m4a", "recitedText": "يَحْكُمُ"}, {"tense": "present", "pronoun": "hiya", "arabic": "تَحْكُمُ", "plain": "تَحْكُمُ", "quran": true, "notUsed": false, "spoken": "audio/e2fd59870741490fc13b.m4a", "recited": "audio/6243a54b1005b6c874b1.m4a", "recitedText": "تَحْكُمُ"}, {"tense": "present", "pronoun": "huma", "arabic": "يَحْكُمَانِ", "plain": "يَحْكُمَانِ", "quran": false, "notUsed": false, "spoken": "audio/4ba49e0c91a7d2962d70.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَحْكُمُونَ", "plain": "يَحْكُمُونَ", "quran": true, "notUsed": false, "spoken": "audio/06b0ee7dfd7058b33c05.m4a", "recited": "audio/35e420eb5d6096a60e55.m4a", "recitedText": "يَحْكُمُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَحْكُمْنَ", "plain": "يَحْكُمْنَ", "quran": false, "notUsed": false, "spoken": "audio/123b5191320d7a1f9b8a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱحْكُم", "plain": "اُحْكُمْ", "quran": true, "notUsed": false, "spoken": "audio/66c05c76ba8cdd40a8b1.m4a", "recited": "audio/28207764a7dec7054809.m4a", "recitedText": "ٱحْكُم"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُحْكُمِي", "plain": "اُحْكُمِي", "quran": false, "notUsed": false, "spoken": "audio/ef875626f970c675faca.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُحْكُمَا", "plain": "اُحْكُمَا", "quran": false, "notUsed": false, "spoken": "audio/7bbb596d59fa1e86cf1c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُحْكُمُوا", "plain": "اُحْكُمُوا", "quran": false, "notUsed": false, "spoken": "audio/cfeb023ab245f0836f10.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُحْكُمْنَ", "plain": "اُحْكُمْنَ", "quran": false, "notUsed": false, "spoken": "audio/f542c6c76fba379b418a.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "22:69", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2664.mp3", "translation": {"en": {"text": "Allah will judge between you on the Day of Resurrection concerning that wherein ye used to differ.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ayrılığa düştüğünüz şeyler hakkında kıyamet günü Allah aranızda hükmünü verecektir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ تم پر فیصلہ کردے گا قیامت کے دن جس بات میں اختلاف کرتے ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah akan mengadili di antara kamu pada hari kiamat tentang apa yang kamu dahulu selalu berselisih padanya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَحْكُمُ", "hit": true, "audio": "audio/805d28ec32d77ebec587.m4a", "gloss": {"en": "he/it judges", "bs": "sudi", "tr": "hükmeder", "fr": "il juge", "id": "dia menghakimi", "ur": "وہ فیصلہ کرتا ہے", "bn": "সে বিচার করে", "fa": "داوری می‌کند"}}, {"text": "بَيْنَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقِيَٰمَةِ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "تَخْتَلِفُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:112", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2595.mp3", "translation": {"en": {"text": "He saith: My Lord! Judge Thou with truth. Our Lord is the Beneficent, Whose help is to be implored against that which ye ascribe (unto Him).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Hz. Peygamber şöyle) dedi: \"Ey Rabbim! Aramızda gerçekle hükmet ve Rabbimiz O Rahmân'dır ki, isnad ettiğiniz (yalan) vasıflarınıza karşı yardımına sığınılacak olan ancak O'dur. \"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "نبی نے عرض کی کہ اے میرے رب حق فیصلہ فرمادے اور ہمارے رب رحمنٰ ہی کی مدد درکار ہے ان باتوں پر جو تم بتاتے ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Muhammad) berkata: \"Ya Tuhanku, berilah keputusan dengan adil. Dan Tuhan kami ialah Tuhan Yang Maha Pemurah lagi Yang dimohonkan pertolongan-Nya terhadap apa yang kamu katakan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَٰلَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱحْكُم", "hit": true, "audio": "audio/28207764a7dec7054809.m4a", "gloss": {"bs": "sudi!", "en": "judge!", "tr": "hükmet!", "fr": "juge !", "id": "putuskanlah!", "ur": "فیصلہ کر!", "bn": "বিচার করো!", "fa": "داوری کن!"}}, {"text": "بِٱلْحَقِّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَرَبُّنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّحْمَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُسْتَعَانُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَصِفُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:154", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3942.mp3", "translation": {"en": {"text": "What aileth you? How judge ye?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Size ne oldu? Nasıl hükmediyorsunuz?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تمہیں کیا ہے، کیسا حکم لگاتے ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apakah yang terjadi padamu? Bagaimana (caranya) kamu menetapkan?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَيْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَحْكُمُونَ", "hit": true, "audio": "audio/f8ec676b3ec717171f2c.m4a", "gloss": {"bs": "sudite", "en": "you judge", "tr": "hükmedersiniz", "fr": "vous jugez", "id": "kamu memutuskan", "ur": "تم فیصلہ کرتے ہو", "bn": "তোমরা বিচার করো", "fa": "داوری می‌کنید"}}]}, {"ref": "29:4", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3344.mp3", "translation": {"en": {"text": "Or do those who do ill-deeds imagine that they can outstrip Us? Evil (for them) is that which they decide.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yoksa kötülükleri yapanlar bizden kaçabileceklerini mi sandılar? Ne kadar kötü (ve yanlış) hüküm veriyorlar!", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا یہ سمجھے ہوئے ہیں وہ جو برے کام کرتے ہیں کہ ہم سے کہیں نکل جائیں گے کیا ہی برا حکم لگاتے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ataukah orang-orang yang mengerjakan kejahatan itu mengira bahwa mereka akan luput (dari azab) Kami? Amatlah buruk apa yang mereka tetapkan itu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "حَسِبَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْمَلُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّيِّـَٔاتِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْبِقُونَا", "hit": false, "audio": null, "gloss": null}, {"text": "سَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَحْكُمُونَ", "hit": true, "audio": "audio/6a8c7095a403ed9dd153.m4a", "gloss": {"en": "they judge", "bs": "sude", "tr": "hükmederler", "fr": "ils jugent", "id": "mereka menghakimi", "ur": "وہ فیصلہ کرتے ہیں", "bn": "তারা বিচার করে", "fa": "داوری می‌کنند"}}]}, {"ref": "40:48", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4181.mp3", "translation": {"en": {"text": "Those who were proud say: Lo! we are all (together) herein. Lo! Allah hath judged between (His) slaves.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Büyüklük taslayanlar da şöyle derler: \"Evet, hepimiz onun içindeyiz. Allah kulları arasında hükmünü vermiştir.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ تکبر والے بولے ہم سب آگ میں ہیں بیشک اللہ بندوں میں فیصلہ فرماچکا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Orang-orang yang menyombongkan diri menjawab: \"Sesungguhnya kita semua sama-sama dalam neraka karena sesungguhnya Allah telah menetapkan keputusan antara hamba-hamba-(Nya)\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَا