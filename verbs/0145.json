erative", "pronoun": "anta", "arabic": "ٱئْذَن", "plain": "اِئْذَنْ", "quran": true, "notUsed": false, "spoken": "audio/a4b3220d80e99c9ed4e0.m4a", "recited": "audio/15ee689726e82aa1d8f6.m4a", "recitedText": "ٱئْذَن"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِئْذَنِي", "plain": "اِئْذَنِي", "quran": false, "notUsed": false, "spoken": "audio/0193069d2e2052b503b3.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِئْذَنَا", "plain": "اِئْذَنَا", "quran": false, "notUsed": false, "spoken": "audio/9fd6619a6dd3f233a6d9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أْذَنُوا۟", "plain": "اِئْذَنُوا", "quran": true, "notUsed": false, "spoken": "audio/8ea7a2b7ea5a8cbc9f58.m4a", "recited": "audio/87486caa0593bad0887f.m4a", "recitedText": "فَأْذَنُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِئْذَنَّ", "plain": "اِئْذَنَّ", "quran": false, "notUsed": false, "spoken": "audio/27e66c26e3845b90ee17.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "20:109", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2457.mp3", "translation": {"en": {"text": "On that day no intercession availeth save (that of) him unto whom the Beneficent hath given leave and whose word He accepteth.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O gün, Rahmân'ın kendisine izin verdiği ve sözünden hoşnud olduğu kimselerden başkasının şefaatı fayda vermez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس دن کسی کی شفاعت کام نہ دے گی، مگر اس کی جسے رحمن نے اذن دے دیا ہے اور اس کی بات پسند فرمائی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Pada hari itu tidak berguna syafa'at, kecuali (syafa'at) orang yang Allah Maha Pemurah telah memberi izin kepadanya, dan Dia telah meridhai perkataannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَوْمَئِذٍ", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تَنفَعُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلشَّفَٰعَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَذِنَ", "hit": true, "audio": "audio/b48634cfbb59dcecf0d4.m4a", "gloss": {"en": "he/it permitted", "bs": "dozvolio je", "tr": "izin verdi", "fr": "il a permis", "id": "dia telah mengizinkan", "ur": "اُس نے اجازت دی", "bn": "সে অনুমতি দিল", "fa": "اجازه داد"}}, {"text": "لَهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّحْمَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَرَضِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "84:2", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5886.mp3", "translation": {"en": {"text": "And attentive to her Lord in fear,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbini dinleyip kendisine yaraşır şekilde boyun eğdiği vakit,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اپنے رب کا حکم سنے اور اسے سزاوار ہی یہ ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan patuh kepada Tuhannya, dan sudah semestinya langit itu patuh,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَذِنَتْ", "hit": true, "audio": "audio/10663beb14243ff2b6e7.m4a", "gloss": {"bs": "i posluša", "en": "and it listens (obeys)", "tr": "ve (kulak) verir", "fr": "et il écoute (obéit)", "id": "dan ia mendengarkan (menaati)", "ur": "اور اس نے کان لگایا (اطاعت کی)", "bn": "এবং তা শোনে (মেনে চলে)", "fa": "و (گوش) فرا داد"}}, {"text": "لِرَبِّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَحُقَّتْ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَذِنَ", "count": 5, "first": "10:59", "audio": "audio/0086adf9f19993348e33.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it permitted", "bs": "dozvolio je", "tr": "izin verdi", "fr": "il a permis", "id": "dia telah mengizinkan", "ur": "اُس نے اجازت دی", "bn": "সে অনুমতি দিল", "fa": "اجازه داد"}}, {"arabic": "ءَاذَنَ", "count": 3, "first": "7:123", "audio": "audio/6cbede93b93b7eb3ea70.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "I permit", "bs": "dozvoljavam", "tr": "izin veririm", "fr": "je permets", "id": "aku mengizinkan", "ur": "میں اجازت دیتا ہوں", "bn": "আমি অনুমতি দিই", "fa": "اجازه می‌دهم"}}, {"arabic": "يَأْذَنَ", "count": 2, "first": "12:80", "audio": "audio/6c57b6abc63b8b19c1c0.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "he/it permits", "bs": "dozvoljava", "tr": "izin verir", "fr": "il permet", "id": "dia mengizinkan", "ur": "وہ اجازت دیتا ہے", "bn": "সে অনুমতি দেয়", "fa": "اجازه می‌دهد"}}, {"arabic": "يُؤْذَنُ", "count": 2, "first": "16:84", "audio": "audio/df24f8a7dedeb97d7175.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "it is permitted", "bs": "dozvoljava se", "tr": "izin verilir", "fr": "il est permis", "id": "diizinkan", "ur": "اجازت دی جاتی ہے", "bn": "অনুমোদিত করা হয়", "fa": "اجازه داده می‌شود"}}, {"arabic": "يُؤْذَنَ", "count": 2, "first": "24:28", "audio": "audio/c2aa9a33c590f2a7dd62.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "it is permitted", "bs": "dozvoljava se", "tr": "izin verilir", "fr": "qu'il soit permis", "id": "diizinkan", "ur": "اجازت دی جاتی ہے", "bn": "অনুমোদিত করা হয়", "fa": "اجازه داده شود"}}, {"arabic": "وَأَذِنَتْ", "count": 2, "first": "84:2", "audio": "audio/10663beb14243ff2b6e7.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"bs": "i posluša", "en": "and it listens (obeys)", "tr": "ve (kulak) verir", "fr": "et il écoute (obéit)", "id": "dan ia mendengarkan (menaati)", "ur": "اور اس نے کان لگایا (اطاعت کی)", "bn": "এবং তা শোনে (মেনে চলে)", "fa": "و (گوش) فرا داد"}}, {"arabic": "فَأْذَنُوا۟", "count": 1, "first": "2:279", "audio": "audio/87486caa0593bad0887f.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) be informed!", "bs": "pa znajte!", "tr": "böylece bilin!", "fr": "sachez donc !", "id": "maka ketahuilah kalian!", "ur": "پس جان لو!", "bn": "অতএব জেনে রাখো!", "fa": "پس بدانید!"}}, {"arabic": "أَذِنتَ", "count": 1, "first": "9:43", "audio": "audio/9a4e4b8c47d0db6fe934.m4a", "grammar": [{"tense": "past", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "you permitted", "bs": "dozvolio si", "tr": "izin verdin", "fr": "tu as permis", "id": "kamu telah mengizinkan", "ur": "تم نے اجازت دی", "bn": "তুমি অনুমতি দিয়েছ", "fa": "اجازه دادی"}}, {"arabic": "ٱئْذَن", "count": 1, "first": "9:49", "audio": "audio/15ee689726e82aa1d8f6.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "permit!", "bs": "dozvoli!", "tr": "izin ver!", "fr": "permets !", "id": "izinkanlah!", "ur": "اجازت دے!", "bn": "অনুমতি দাও!", "fa": "اجازه بده!"}}, {"arabic": "لِيُؤْذَنَ", "count": 1, "first": "9:90", "audio": "audio/00f2755a05b86b5120cc.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "subjunctive"}], "gloss": {"e