angga mereka", "tr": "komşuları", "ur": "اپنے پڑوسی کے ساتھ"}}, {"arabic": "فَنَدِمُوا", "target": false, "translation": {"bs": "pa su se pokajali", "en": "and they repented", "bn": "এবং তারা তাওবা করল", "fa": "پس توبه کردند", "fr": "et ils se sont repentis", "id": "dan mereka bertobat", "tr": "ve tövbe ettiler", "ur": "پھر وہ پشیمان ہوئے"}}]}, {"arabic": "اللُّصُوصُ يَمْكُرُونَ بِالنَّاسِ", "spoken": "audio/3ee6a4411601dc56e97a.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Lopovi varaju ljude.", "en": "Thieves deceive people.", "bn": "চোরেরা মানুষকে ঠকায়।", "fa": "دزدان مردم را فریب می‌دهند.", "fr": "Les voleurs trompent les gens.", "id": "Pencuri menipu orang-orang.", "tr": "Hırsızlar insanları aldatır.", "ur": "چور لوگوں کو دھوکا دیتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "اللُّصُوصُ", "target": false, "translation": {"bs": "lopovi", "en": "the thieves", "bn": "চোরেরা", "fa": "دزدان", "fr": "les voleurs", "id": "para pencuri", "tr": "hırsızlar", "ur": "چور"}}, {"arabic": "يَمْكُرُونَ", "target": true, "translation": {"bs": "varaju", "en": "deceive", "bn": "প্রতারণা করে", "fa": "فریب می‌دهند", "fr": "trompent", "id": "menipu", "tr": "kandırır", "ur": "وہ فریب دیتے ہیں"}}, {"arabic": "بِالنَّاسِ", "target": false, "translation": {"bs": "ljude", "en": "people", "bn": "মানুষকে", "fa": "مردم را", "fr": "les gens", "id": "orang-orang", "tr": "insanlar", "ur": "لوگوں کو"}}]}, {"arabic": "مَكَرْنَا بِأَخِينَا فِي اللُّعْبَةِ", "spoken": "audio/5af13a156d08a343f42d.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Prevarili smo brata u igri.", "en": "We deceived our brother in the game.", "bn": "আমরা খেলায় আমাদের ভাইকে ঠকালাম।", "fa": "برادرمان را در بازی فریب دادیم.", "fr": "Nous avons trompé notre frère au jeu.", "id": "Kami mengecoh saudara kami dalam permainan.", "tr": "Oyunda kardeşimizi kandırdık.", "ur": "ہم نے کھیل میں اپنے بھائی کو چکمہ دیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "مَكَرْ