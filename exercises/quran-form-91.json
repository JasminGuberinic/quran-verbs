[{"id":"ikhtara-20-13-1","words":["verb:ikhtara"],"options":[{"bs":"ja sam tebe izabrao","en":"I have chosen you"},{"bs":"i izabrao je","en":"and he/it chose"},{"bs":"izabrali smo ih","en":"we chose them"},{"bs":"i bira","en":"and he/it chooses"}],"ref":"20:13","answerWord":"ٱخْتَرْتُكَ","answerSound":"audio/dbd321da1a9dd021bc93.m4a","quranTranslation":{"text":"And I have chosen thee, so hearken unto that which is inspired.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izabrati, odabrati","en":"to choose"},"passage":["وَأَنَا","ٱخْتَرْتُكَ","فَٱسْتَمِعْ","لِمَا","يُوحَىٰٓ"],"marked":[1],"facts":{"verb":"اخْتارَ"}},{"id":"ikhtara-28-68-4","words":["verb:ikhtara"],"options":[{"bs":"i bira","en":"and he/it chooses"},{"bs":"izabrali smo ih","en":"we chose them"},{"bs":"i izabrao je","en":"and he/it chose"},{"bs":"ja sam tebe izabrao","en":"I have chosen you"}],"ref":"28:68","answerWord":"وَيَخْتَارُ","answerSound":"audio/002b3fbea559b34c0ead.m4a","quranTranslation":{"text":"Thy Lord bringeth to pass what He willeth and chooseth. They have never any choice. Glorified be Allah and Exalted above all that they associate (with Him)!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izabrati, odabrati","en":"to choose"},"passage":["وَرَبُّكَ","يَخْلُقُ","مَا","يَشَآءُ","وَيَخْتَارُ","مَا","كَانَ","لَهُمُ","ٱلْخِيَرَةُ","سُبْحَٰنَ","ٱللَّهِ","وَتَعَٰلَىٰ","عَمَّا","يُشْرِكُونَ"],"marked":[4],"facts":{"verb":"اخْتارَ"}},{"id":"ikhtara-44-32-1","words":["verb:ikhtara"],"options":[{"bs":"izabrali smo ih","en":"we chose them"},{"bs":"i izabrao je","en":"and he/it chose"},{"bs":"ja sam tebe izabrao","en":"I have chosen you"},{"bs":"i bira","en":"and he/it chooses"}],"ref":"44:32","answerWord":"ٱخْتَرْنَٰهُمْ","answerSound":"audio/bcca5d73914a4dbd1515.m4a","quranTranslation":{"text":"And We chose them, purposely, above (all) creatures.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izabrati, odabrati","en":"to choose"},"passage":["وَلَقَدِ","ٱخْتَرْنَٰهُمْ","عَلَىٰ","عِلْمٍ","عَلَى","ٱلْعَٰلَمِينَ"],"marked":[1],"facts":{"verb":"اخْتارَ"}}]