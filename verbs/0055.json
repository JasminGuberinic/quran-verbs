{"rank": 55, "root": "تلو", "form": 1, "lemma": "تَلَا", "count": 61, "ayahCount": 60, "share": 0.32, "meaning": {"bs": "učiti, čitati, slijediti", "en": "to recite, to follow", "tr": "okumak, uymak", "fr": "réciter, suivre", "id": "membaca, mengikuti", "ur": "تلاوت کرنا، پیچھے چلنا", "bn": "তিলাওয়াত করা, অনুসরণ করা", "fa": "تلاوت کردن، پیروی کردن"}, "lemmaSpoken": "audio/b2d99f4add2c8c99ec01.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "تَلَا", "plain": "تَلَا", "quran": false, "notUsed": false, "spoken": "audio/b2d99f4add2c8c99ec01.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَتْلُوا۟", "plain": "يَتْلُو", "quran": true, "notUsed": false, "spoken": "audio/4d1bdb642bc52a4fa6e8.m4a", "recited": "audio/0ec96633f2f798ac79f7.m4a", "recitedText": "يَتْلُوا۟"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱتْلُ", "plain": "اُتْلُ", "quran": true, "notUsed": false, "spoken": "audio/b89a43d600e5f15ea6b8.m4a", "recited": "audio/c73727fbc2b513b29b91.m4a", "recitedText": "ٱتْلُ"}], "nouns": {"participle": {"lemma": "تالِيَة", "count": 1, "spoken": "audio/5a0eafd897ee97d898f7.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "تَلَوْتُ", "plain": "تَلَوْتُ", "quran": false, "notUsed": false, "spoken": "audio/a916161927d08e670ac6.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "تَلَوْنَا", "plain": "تَلَوْنَا", "quran": false, "notUsed": false, "spoken": "audio/b284abc657c0c0b4bb6c.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "تَلَوْتَ", "plain": "تَلَوْتَ", "quran": false, "notUsed": false, "spoken": "audio/bc59d0035d06a07da184.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "تَلَوْتِ", "plain": "تَلَوْتِ", "quran": false, "notUsed": false, "spoken": "audio/bb3e7dff9b49a6daab50.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun