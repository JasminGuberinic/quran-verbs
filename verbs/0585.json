ا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَنْفَدُ", "target": true, "translation": {"bs": "nestane", "en": "runs out", "bn": "ফুরিয়ে যায়", "fa": "تمام می‌شود", "fr": "vient à manquer", "id": "habis", "tr": "tükenir", "ur": "ختم ہو جاتا ہے"}}, {"arabic": "الْمَاءُ", "target": false, "translation": {"bs": "voda", "en": "the water", "bn": "পানি", "fa": "آب", "fr": "l'eau", "id": "air itu", "tr": "su", "ur": "پانی"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "u", "en": "in", "bn": "মধ্যে", "fa": "در", "fr": "dans", "id": "di", "tr": "içinde", "ur": "میں"}}, {"arabic": "الصَّيْفِ", "target": false, "translation": {"bs": "ljeto", "en": "the summer", "bn": "গ্রীষ্মের", "fa": "تابستان", "fr": "l'été", "id": "musim panas", "tr": "yaz", "ur": "گرمی"}}]}, {"arabic": "نَفِدَتْ نُقُودُهُ", "spoken": "audio/9b9d3c79e07adf57eb4a.m4a", "tense": "past", "pronoun": "hiya", "translation": {"bs": "Ponestalo mu je novca.", "en": "His money ran out.", "bn": "তার টাকা ফুরিয়ে গেছে।", "fa": "پولش تمام شد.", "fr": "Il n'avait plus d'argent.", "id": "Uangnya habis.", "tr": "Parası tükendi.", "ur": "اس کے پیسے ختم ہو گئے۔"}, "independentlyReviewed": true, "words": [{"arabic": "نَفِدَتْ", "target": true, "translation": {"bs": "ponestalo je", "en": "ran out", "bn": "ফুরিয়ে গেছে", "fa": "تمام شد", "fr": "est venu à manquer", "id": "telah habis", "tr": "tükendi", "ur": "ختم ہو گئی"}}, {"arabic": "نُقُودُهُ", "target": false, "translation": {"bs": "mu novca", "en": "his money", "bn": "তার টাকা", "fa": "پولش", "fr": "son argent", "id": "uangnya", "tr": "parası", "ur": "اس کے پیسے"}}]}]}