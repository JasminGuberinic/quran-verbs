"tr": "üzerinde", "ur": "پر"}}, {"arabic": "رَبِّهِ", "target": false, "translation": {"bs": "svog Gospodara", "en": "his Lord", "bn": "তার রব", "fa": "پروردگارش", "fr": "à son Seigneur", "id": "kepada Tuhannya", "tr": "Rabbine", "ur": "اپنے رب"}}]}, {"arabic": "تَوَكَّلْ عَلَى رَبِّكَ وَاجْتَهِدْ", "spoken": "audio/f97e54dc00beb6942bf4.m4a", "tense": "imperative", "pronoun": "anta", "translation": {"bs": "Osloni se na svog Gospodara i trudi se.", "en": "Put your trust in your Lord and work hard.", "bn": "তোমার রবের ওপর ভরসা করো এবং কঠোর পরিশ্রম করো।", "fa": "بر پروردگارت توکل کن و تلاش کن.", "fr": "Remets-toi à ton Seigneur et travaille dur.", "id": "Bertawakallah kepada Tuhanmu dan bekerja keraslah.", "tr": "Rabbine güven ve çalış.", "ur": "اپنے رب پر بھروسا کرو اور محنت کرو۔"}, "independentlyReviewed": true, "words": [{"arabic": "تَوَكَّلْ", "target": true, "translation": {"bs": "osloni se", "en": "trust", "bn": "ভরসা করো", "fa": "توکل کن", "fr": "remets-t'en à Dieu !", "id": "bertawakallah", "tr": "güven", "ur": "بھروسا کر"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "na", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "رَبِّكَ", "target": false, "translation": {"bs": "svog Gospodara", "en": "your Lord", "bn": "তোমার রব", "fa": "پروردگارت", "fr": "ton Seigneur", "id": "kepada Tuhanmu", "tr": "Rabbine", "ur": "تمہارا رب"}}, {"arabic": "وَاجْتَهِدْ", "target": false, "translation": {"bs": "i trudi se", "en": "and work hard", "bn": "এবং কঠোর পরিশ্রম করো", "fa": "و تلاش کن", "fr": "et travaille dur", "id": "dan bekerja keras", "tr": "ve çalış", "ur": "اور محنت کر"}}]}, {"arabic": "تَوَكَّلْتُ عَلَى رَبِّي وَسَافَرْتُ", "spoken": "audio/bbeffd67bc5933a18790.m4a", "tense": "past", "pronoun": "ana", "translation": {"bs": "Oslonio sam se na svog Gospodara i otputovao.", "en": "I put my trust in my Lord and traveled.", "bn": "আমি আমার রবের ওপর ভরসা করলাম এবং সফরে বের হলাম।", "fa": "بر پروردگ