9c52d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "دَّْنَ", "plain": "دَّْنَ", "quran": false, "notUsed": false, "spoken": "audio/36807692e4c5a2c210fb.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "15:2", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1804.mp3", "translation": {"en": {"text": "It may be that those who disbelieve wish ardently that they were Muslims.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bir zaman gelecek ki inkâr edenler, keşke müslüman olsaydık temennisinde bulunacaklardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بہت آرزوئیں کریں گے کافر کاش مسلمان ہوتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Orang-orang yang kafir itu seringkali (nanti di akhirat) menginginkan, kiranya mereka dahulu (di dunia) menjadi orang-orang muslim.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رُّبَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَوَدُّ", "hit": true, "audio": "audio/6fc21ebd664b79320884.m4a", "gloss": {"bs": "će poželjeti", "en": "will wish", "tr": "isteyecek", "fr": "souhaitera", "id": "akan menginginkan", "ur": "وہ چاہے گا", "bn": "কামনা করবে", "fa": "آرزو خواهد کرد"}}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "مُسْلِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "68:9", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5280.mp3", "translation": {"en": {"text": "Who would have had thee compromise, that they may compromise.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar istediler ki yumuşak davranasın da onlar da sana yumuşak davransınlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ تو اس آرزو میں ہیں کہ کسی طرح تم نرمی کرو تو وہ بھی نرم پڑجائیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka mereka menginginkan supaya kamu bersikap lunak lalu mereka bersikap lunak (pula kepadamu).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَدُّوا۟", "hit": true, "audio": "audio/d21008fea631e44114fb.m4a", "gloss": {"bs": "žele", "en": "they wish", "tr": "isterler", "fr": "ils souhaitent", "id": "mereka menginginkan", "ur": "وہ چاہتے ہیں", "bn": "তারা কামনা করে", "fa": "آرزو کردند"}}, {"text": "لَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "تُدْهِنُ", "hit": false, "audio": null, "gloss": null}, {"text": "فَيُدْهِنُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَوَدُّ", "count": 5, "first": "2:96", "audio": "audio/6fc21ebd664b79320884.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "će poželjeti", "en": "will wish", "tr": "isteyecek", "fr": "souhaitera", "id": "akan menginginkan", "ur": "وہ چاہے گا", "bn": "কামনা করবে", "fa": "آرزو خواهد کرد"}}, {"arabic": "وَدُّوا۟", "count": 3, "first": "3:118", "audio": "audio/d21008fea631e44114fb.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "žele", "en": "they wish", "tr": "isterler", "fr": "ils souhaitent", "id": "mereka menginginkan", "ur": "وہ چاہتے ہیں", "bn": "তারা কামনা করে", "fa": "آرزو کردند"}}, {"arabic": "وَدَّ", "count": 2, "first": "2:109", "audio": "audio/e0a80a0458f4bcb72cea.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it wished", "bs": "poželio je", "tr": "istedi", "fr": 