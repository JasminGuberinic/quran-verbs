 "imperative", "pronoun": "anti", "arabic": "اُخْرُجِي", "plain": "اُخْرُجِي", "quran": false, "notUsed": false, "spoken": "audio/15f19e9bf933e0d72e82.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُخْرُجَا", "plain": "اُخْرُجَا", "quran": false, "notUsed": false, "spoken": "audio/c68dfed028ca81dc618d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱخْرُجُوا۟", "plain": "اُخْرُجُوا", "quran": true, "notUsed": false, "spoken": "audio/b3d472bac36de87d17ee.m4a", "recited": "audio/7ebdb8493ee5fdc8273c.m4a", "recitedText": "ٱخْرُجُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُخْرُجْنَ", "plain": "اُخْرُجْنَ", "quran": false, "notUsed": false, "spoken": "audio/902ac09b3a3aab8c4641.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "55:22", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4923.mp3", "translation": {"en": {"text": "There cometh forth from both of them the pearl and coral-stone.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İkisinden de inci ve mercan çıkar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ان میں سے موتی اور مونگا نکلتا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dari keduanya keluar mutiara dan marjan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَخْرُجُ", "hit": true, "audio": "audio/e7914582f17b73344066.m4a", "gloss": {"bs": "izlaze", "en": "come out", "tr": "çıkarlar", "fr": "sortent", "id": "keluarlah", "ur": "وہ نکلتے ہیں", "bn": "বের হয়ে আসে", "fa": "بیرون می‌آید"}}, {"text": "مِنْهُمَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللُّؤْلُؤُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْمَرْجَانُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "54:7", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4853.mp3", "translation": {"en": {"text": "With downcast eyes, they come forth from the graves as they were locusts spread abroad,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Gözleri düşkün düşkün (zelil ve hakir) kabirlerinden çıkarlar, sanki yayılan çekirgeler gibidirler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "نیچی آنکھیں کیے ہوئے قبروں سے نکلیں گے گویا وہ ٹڈی ہیں پھیلی ہوئی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "sambil menundukkan pandangan-pandangan mereka keluar dari kuburan seakan-akan mereka belalang yang beterbangan", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "خُشَّعًا", "hit": false, "audio": null, "gloss": null}, {"text": "أَبْصَٰرُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَخْرُجُونَ", "hit": true, "audio": "audio/9af84f35f0c045d13c23.m4a", "gloss": {"en": "they go out", "bs": "izlaze", "tr": "çıkarlar", "fr": "ils sortent", "id": "mereka keluar", "ur": "وہ نکلتے ہیں", "bn": "তারা বের হয়", "fa": "بیرون می‌آیند"}}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَجْدَاثِ", "hit": false, "audio": null, "gloss": null}, {"text": "كَأَنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "جَرَادٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مُّنتَشِرٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:64", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3852.mp3", "translation": {"en": {"text": "Lo! it is a tree that springeth in the heart of hell.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O bir ağaçtır ki cehennemin dibinde çıkar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک وہ ایک پیڑ ہے کہ جہنم کی جڑ میں نکلتا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya dia adalah sebatang pohon yang ke luar dan dasar neraka yang menyala.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "شَجَرَةٌ", "hit": false, "audio": null, "gloss": null}, {"text": "تَخْرُجُ", "hit": true, "audio": "audio/529e2fb594e75c3ea96d.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}, {"text": "فِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَصْلِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْجَحِيمِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:34", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1836.mp3", "translation": {"en": {"text": "He said: Then go thou forth from hence, for lo! thou art outcast.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah şöyle buyurdu: \"Öyle ise oradan çık! Sen, artık kovulmuş birisin.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "فرمایا تو جنت سے نکل جا کہ تو مردود ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah berfirman: \"Keluarlah dari surga, karena sesungguhnya kamu terkutuk,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱخْرُجْ", "hit": true, "audio": "audio/1d27d95e509ca29fb397.m4a", "gloss": {"bs": "pa izlazi!", "en": "so get out!", "tr": "öyleyse çık!", "fr": "sors donc !", "id": "maka keluarlah!", "ur": "پس نکل جا!", "bn": "অতএব বের হও!", "fa": "پس بیرون برو!"}}, {"text": "مِنْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَجِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "28:21", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3273.mp3", "translation": {"en": {"text": "So he escaped from thence, fearing, vigilant. He said: My Lord! Deliver me from the wrongdoing folk.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa korka korka, (etrafı) gözetleyerek oradan çıktı. \"Rabbim! Beni zalimler güruhundan kurtar\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اس شہر سے نکلا ڈرتا ہوا اس انتظار میں کہ اب کیا ہوتا ہے عرض کی، اے میرے رب! مجھے ستمگاروں سے بچالے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka keluarlah Musa dari kota itu dengan rasa takut menunggu-nunggu dengan khawatir, dia berdoa: \"Ya Tuhanku, selamatkanlah aku dari orang-orang yang zalim itu\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَخَرَجَ", "hit": true, "audio": "audio/7c5ddda1d47390771960.m4a", "gloss": {"bs": "pa je izašao", "en": "so he went out", "tr": "bunun üzerine çıktı", "fr": "alors il sortit", "id": "lalu dia keluar", "ur": "پھر وہ نکلا", "bn": "তখন সে বের হয়ে গেল", "fa": "پس بیرون رفت"}}, {"text": "مِنْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "خَآئِفًا", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَرَقَّبُ", "hit": false, "audio": null, "gloss": null}, {"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "نَجِّنِى", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَوْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلظَّٰلِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "49:5", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4617.mp3", "translation": {"en": {"text": "And if they had had patience till thou camest forth unto them, it had been better for them. And Allah is Forgiving, Merciful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer onlar, sen yanlarına çıkıncaya kadar sabretselerdi, elbette kendileri için daha iyi olurdu. Bununla beraber Allah çok bağışlayan, çok merhamet edendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر وہ صبر کرتے یہاں تک کہ تم آپ ان کے پاس تشریف لاتے تو یہ ان کے لیے بہتر تھا، اور اللہ بخشنے والا مہربان ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan kalau sekiranya mereka bersabar sampai kamu keluar menemui mereka sesungguhnya itu lebih baik bagi mereka, dan Allah Maha Pengampun lagi Maha Penyayang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "صَبَرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "حَتَّىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "تَخْرُجَ", "hit": true, "audio": "audio/872547d8251a6e397567.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "subjunctive"}]}, {"text": "إِلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَكَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "خَيْرًا", "hit": false, "audio": null, "gloss": null}, {"text": "لَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "غَفُورٌ", "hit": false, "audio": null, "gloss": null}, {"text": "رَّحِيمٌ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَخْرُجُ", "count": 9, "first": "7:58", "audio": "audio/e7914582f17b73344066.m4a",