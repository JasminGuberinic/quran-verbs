{"ayat":[{"ref":"89:1","number":5994,"text":"وَٱلْفَجْرِ","hits":[0]},{"ref":"89:2","number":5995,"text":"وَلَيَالٍ عَشْرٍ","hits":[0]},{"ref":"89:3","number":5996,"text":"وَٱلشَّفْعِ وَٱلْوَتْرِ","hits":[]},{"ref":"89:4","number":5997,"text":"وَٱلَّيْلِ إِذَا يَسْرِ","hits":[1]},{"ref":"89:5","number":5998,"text":"هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ","hits":[0,1,2,3,4]},{"ref":"89:6","number":5999,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ","hits":[0,1,2,3,4]},{"ref":"89:7","number":6000,"text":"إِرَمَ ذَاتِ ٱلْعِمَادِ","hits":[]},{"ref":"89:8","number":6001,"text":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ","hits":[0,2,5]},{"ref":"89:9","number":6002,"text":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ","hits":[0,1,4]},{"ref":"89:10","number":6003,"text":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ","hits":[2]},{"ref":"89:11","number":6004,"text":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ","hits":[1]},{"ref":"89:12","number":6005,"text":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ","hits":[2]},{"ref":"89:13","number":6006,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","hits":[0,1,4]},{"ref":"89:14","number":6007,"text":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ","hits":[0]},{"ref":"89:15","number":6008,"text":"فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ","hits":[0,1,3,4,6,8]},{"ref":"89:16","number":6009,"text":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ","hits":[4,6]},{"ref":"89:17","number":6010,"text":"كَلَّا بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ","hits":[0,1,2,4]},{"ref":"89:18","number":6011,"text":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","hits":[3,4]},{"ref":"89:19","number":6012,"text":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا","hits":[0,2]},{"ref":"89:20","number":6013,"text":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا","hits":[0,1,2]},{"ref":"89:21","number":6014,"text":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا","hits":[3]},{"ref":"89:22","number":6015,"text":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا","hits":[0,2]},{"ref":"89:23","number":6016,"text":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ","hits":[1,2,4,6,8]},{"ref":"89:24","number":6017,"text":"يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","hits":[1,2,3]},{"ref":"89:25","number":6018,"text":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ","hits":[2]},{"ref":"89:26","number":6019,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ","hits":[]},{"ref":"89:27","number":6020,"text":"يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","hits":[1]},{"ref":"89:28","number":6021,"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً","hits":[0,1]},{"ref":"89:29","number":6022,"text":"فَٱدْخُلِى فِى عِبَٰدِى","hits":[0,2]},{"ref":"89:30","number":6023,"text":"وَٱدْخُلِى جَنَّتِى","hits":[1]}]}