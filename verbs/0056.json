Used": false, "spoken": "audio/91397016e275c3b4e1d7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱرْزُقْ", "plain": "اُرْزُقْ", "quran": true, "notUsed": false, "spoken": "audio/d9de4c42a9fbf40eb36d.m4a", "recited": "audio/5bb631c3e5fc6720d0a5.m4a", "recitedText": "وَٱرْزُقْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُرْزُقِي", "plain": "اُرْزُقِي", "quran": false, "notUsed": false, "spoken": "audio/0cc51f5a4ab9116e4c39.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُرْزُقَا", "plain": "اُرْزُقَا", "quran": false, "notUsed": false, "spoken": "audio/9ea874841d918683f997.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُرْزُقُوا", "plain": "اُرْزُقُوا", "quran": false, "notUsed": false, "spoken": "audio/0e5dad5ef7eff35776af.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُرْزُقْنَ", "plain": "اُرْزُقْنَ", "quran": false, "notUsed": false, "spoken": "audio/b684fe10ff8d93a89f65.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "8:3", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1163.mp3", "translation": {"en": {"text": "Who establish worship and spend of that We have bestowed on them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar ki, namazı gereği gibi kılarlar ve kendilerine rızık olarak verdiğimiz şeylerden Allah yoluna harcarlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ جو نماز قائم رکھیں اور ہمارے دیے سے کچھ ہماری راہ میں خرچ کریں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yaitu) orang-orang yang mendirikan shalat dan yang menafkahkan sebagian dari rezeki yang Kami berikan kepada mereka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُقِيمُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّلَوٰةَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمِمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "رَزَقْنَٰهُمْ", "hit": true, "audio": "audio/835e0a2d07d2c889e2bb.m4a", "gloss": {"bs": "smo ih opskrbili", "en": "We have provided them", "tr": "onları rızıklandırdık", "fr": "Nous leur avons accordé", "id": "Kami telah memberi mereka rezeki", "ur": "ہم نے انہیں رزق دیا", "bn": "আমরা তাদের রিযিক দিয়েছি", "fa": "به آنان روزی داده‌ایم"}}, {"text": "يُنفِقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "5:88", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/757.mp3", "translation": {"en": {"text": "Eat of that which Allah hath bestowed on you as food lawful and good, and keep your duty to Allah in Whom ye are believers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah'ın size verdiği rızıklardan helal ve temiz olarak yeyin ve inandığınız Allah'tan korkun.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور کھاؤ جو کچھ تمہیں اللہ نے روزی دی حلال پاکیزہ او ر ڈرو اللہ سے جس پر تمہیں ایمان ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan makanlah makanan yang halal lagi baik dari apa yang Allah telah rezekikan kepadamu, dan bertakwalah kepada Allah yang kamu beriman kepada-Nya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَكُلُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "مِمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "رَزَقَكُمُ", "hit": true, "audio": "audio/5c3f20e3da9b17b26e27.m4a", "gloss": {"en": "he/it provided you (all)", "bs": "opskrbio vas je", "tr": "sizi rızıklandırdı", "fr": "il vous a pourvus", "id": "dia telah memberi rezeki kepada kalian", "ur": "اُس نے تمہیں روزی دی", "bn": "সে তোমাদের রিযিক দিয়েছে", "fa": "به شما روزی داد"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "حَلَٰلًا", "hit": false, "audio": null, "gloss": null}, {"text": "طَيِّبًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱتَّقُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "مُؤْمِنُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "42:19", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4291.mp3", "translation": {"en": {"text": "Allah is gracious unto His slaves. He provideth for whom He will. And He is the Strong, the Mighty.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah kullarına çok lütufkârdır. Dilediğine rızık verir. O çok kuvvetlidir, çok güçlüdür.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ اپنے بندوں پر لطف فرماتا ہے جسے چاہے روزی دیتا ہے اور وہی قوت و عزت والا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah Maha lembut terhadap hamba-hamba-Nya; Dia memberi rezeki kepada yang di kehendaki-Nya dan Dialah Yang Maha Kuat lagi Maha Perkasa.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَطِيفٌۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بِعِبَادِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "يَرْزُقُ", "hit": true, "audio": "audio/0c672990dbde0c4e9194.m4a", "gloss": {"bs": "opskrbljuje", "en": "He provides (for)", "tr": "rızık verir", "fr": "Il pourvoit (à)", "id": "Dia memberi rezeki", "ur": "وہ رزق دیتا ہے", "bn": "তিনি রিযিক দেন", "fa": "روزی می‌دهد"}}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَشَآءُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَوِىُّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَزِيزُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:132", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2480.mp3", "translation": {"en": {"text": "And enjoin upon thy people worship, and be constant therein. We ask not of thee a provision: We provided for thee. And the sequel is for righteousness.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Ey Muhammed!) Ehline namaz kılmalarını emret, kendin de ona sabırla devam et. Biz senden bir rızık istemiyoruz. Seni biz rızıklandırırız. Güzel akibet takva sahiplerinindir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اپنے گھر والوں کو نماز کا حکم دے اور خود اس پر ثابت رہ، کچھ ہم تجھ سے روزی نہیں مانگتے ہم تجھے روزی دیں گے اور انجام کا بھلا پرہیزگاری کے لیے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan perintahkanlah kepada keluargamu mendirikan shalat dan bersabarlah kamu dalam mengerjakannya. Kami tidak meminta rezeki kepadamu, Kamilah yang memberi rezeki kepadamu. Dan akibat (yang baik) itu adalah bagi orang yang bertakwa.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأْمُرْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَهْلَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلصَّلَوٰةِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱصْطَبِرْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "نَسْـَٔلُكَ", "hit": false, "audio": null, "gloss": null}, {"text": "رِزْقًا", "hit": false, "audio": null, "gloss": null}, {"text": "نَّحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "نَرْزُقُكَ", "hit": true, "audio": "audio/4a57b3c6b533c60088a4.m4a", "gloss": {"en": "we provide you", "bs": "opskrbljujemo te", "tr": "seni rızıklandırırız", "fr": "nous te pourvoyons", "id": "kami memberi rezeki kepadamu", "ur": "ہم تمہیں روزی دیتے ہیں", "bn": "আমরা তোমাকে রিযিক দিই", "fa": "به تو روزی می‌دهیم"}}, {"text": "وَٱلْعَٰقِبَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلتَّقْوَىٰ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "رَزَقْنَٰهُمْ", "count": 10, "first": "2:3", "audio": "audio/9517339f9cd9a83669b6.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["hum"]}], "gloss": {"bs": "smo ih opskrbili", "en": "We have provided them", "tr": "onları rızıklandırdık", "fr": "Nous leur avons accordé", "id": "Kami telah memberi mereka rezeki", "ur": "ہم نے انہیں رزق دیا", "bn": "আমরা তাদের রিযিক দিয়েছি", "fa": "به آنان روزی داده‌ایم"}}, {"arabic": "رَزَقْنَٰكُمْ", "count": 5, "first": "2:57", "audio": "audio/f3a52b3d61c99d112b24.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["antum"]}], "gloss": {"en": "we provided you (all)", "bs": "opskrbili smo vas", "tr": "sizi rızıklandırdık", "fr": "nous vous avons pourvus", "id": "kami telah memberi rezeki kepada kalian", "ur": "ہم نے تمہیں روزی دی", "bn": "আমরা তোমাদের রিযিক দিয়েছি", "fa": "به شما روزی دادیم"}}, {"arabic": "رَزَقَكُمُ", "count": 5, "first": "5:88", "audio": "audio/5c3f20e3da9b17b26e27.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["antum"]}], "gloss": {"en": "he/it provided you (all)", "bs": "opskrbio vas je", "tr": "sizi rızıklandırdı", "fr": "il vous a pourvus", "id": "dia telah memberi rezeki kepada kalian", "ur": "اُس نے تمہ