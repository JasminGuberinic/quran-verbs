, "plain": "أَحْبِبْنَ", "quran": false, "notUsed": false, "spoken": "audio/355d50d8a52765f22e06.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "7:55", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1009.mp3", "translation": {"en": {"text": "(O mankind!) Call upon your Lord humbly and in secret. Lo! He loveth not aggressors.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbinize yalvara yalvara ve gizlice dua edin. Çünkü O, haddi aşanları sevmez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اپنے رب سے دعا کرو گڑگڑاتے اور آہستہ، بیشک حد سے بڑھنے والے اسے پسند نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berdoalah kepada Tuhanmu dengan berendah diri dan suara yang lembut. Sesungguhnya Allah tidak menyukai orang-orang yang melampaui batas.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱدْعُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَضَرُّعًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَخُفْيَةً", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُحِبُّ", "hit": true, "audio": "audio/23e4bdb2b8d6738e98c4.m4a", "gloss": {"en": "he/it loves", "bs": "voli", "tr": "sever", "fr": "il aime", "id": "dia mencintai", "ur": "وہ محبت کرتا ہے", "bn": "সে ভালোবাসে", "fa": "دوست دارد"}}, {"text": "ٱلْمُعْتَدِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "75:20", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5571.mp3", "translation": {"en": {"text": "Nay, but ye do love the fleeting Now", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hayır, siz peşin olanı (dünyayı) seviyorsunuz da", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کوئی نہیں بلکہ اے کافرو! تم پاؤں تلے کی (دنیاوی فائدے کو) عزیز دوست رکھتے ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sekali-kali janganlah demikian. Sebenarnya kamu (hai manusia) mencintai kehidupan dunia,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "بَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "تُحِبُّونَ", "hit": true, "audio": "audio/741af5a94fef8eb881c4.m4a", "gloss": {"bs": "volite", "en": "you love", "tr": "seversiniz", "fr": "vous aimez", "id": "kamu mencintai", "ur": "تم محبت کرتے ہو", "bn": "তোমরা ভালোবাসো", "fa": "دوست دارید"}}, {"text": "ٱلْعَاجِلَةَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "76:27", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5618.mp3", "translation": {"en": {"text": "Lo! these love fleeting life, and put behind them (the remembrance of) a grievous day.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Çünkü onlar bu dünyayı seviyorlar ve önlerindeki ağır bir günü arkaya atıyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک یہ لوگ پاؤں تلے کی (دنیاوی فائدے کو) عزیز رکھتے ہیں اور اپنے پیچھے ایک بھاری دن کو چھوڑ بیٹھے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya mereka (orang kafir) menyukai kehidupan dunia dan mereka tidak memperdulikan kesudahan mereka, pada hari yang berat (hari akhirat).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰٓؤُلَآءِ", "hit": false, "audio": null, "gloss": null}, {"text": "يُحِبُّونَ", "hit": true, 