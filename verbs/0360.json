bjects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6084.mp3", "translation": {"en": {"text": "And verily thy Lord will give unto thee so that thou wilt be content.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbın sana verecek ve sen hoşnut olacaksın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک قریب ہے کہ تمہارا رب تمہیں اتنا دے گا کہ تم راضی ہوجاؤ گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan kelak Tuhanmu pasti memberikan karunia-Nya kepadamu, lalu (hati) kamu menjadi puas.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَسَوْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُعْطِيكَ", "hit": true, "audio": "audio/ec2a452091e9adee5f3c.m4a", "gloss": {"bs": "dat će ti", "en": "he will give you", "tr": "sana verecek", "fr": "il te donnera", "id": "dia akan memberimu", "ur": "وہ تمہیں دے گا", "bn": "সে তোমাকে দেবেন", "fa": "به تو عطا خواهد کرد"}}, {"text": "رَبُّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَرْضَىٰٓ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "108:1", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6205.mp3", "translation": {"en": {"text": "Lo! We have given thee Abundance;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Muhakkak biz sana Kevser'i verdik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے محبوب! بیشک ہم نے تمہیں بے شمار خوبیاں عطا فرمائیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Kami telah memberikan kepadamu nikmat yang banyak.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْطَيْنَٰكَ", "hit": true, "audio": "audio/047ac24b2039a8e6cb73.m4a", "gloss": {"en": "we gave you", "bs": "dali