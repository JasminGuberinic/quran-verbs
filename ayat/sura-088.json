{"ayat":[{"ref":"88:1","number":5968,"text":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","hits":[0,1,2]},{"ref":"88:2","number":5969,"text":"وُجُوهٌ يَوْمَئِذٍ خَٰشِعَةٌ","hits":[0,1]},{"ref":"88:3","number":5970,"text":"عَامِلَةٌ نَّاصِبَةٌ","hits":[]},{"ref":"88:4","number":5971,"text":"تَصْلَىٰ نَارًا حَامِيَةً","hits":[0,1]},{"ref":"88:5","number":5972,"text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","hits":[0,1,2]},{"ref":"88:6","number":5973,"text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ","hits":[0,1,2,3]},{"ref":"88:7","number":5974,"text":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ","hits":[0,3,5]},{"ref":"88:8","number":5975,"text":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ","hits":[]},{"ref":"88:9","number":5976,"text":"لِّسَعْيِهَا رَاضِيَةٌ","hits":[0]},{"ref":"88:10","number":5977,"text":"فِى جَنَّةٍ عَالِيَةٍ","hits":[0,1]},{"ref":"88:11","number":5978,"text":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةً","hits":[1]},{"ref":"88:12","number":5979,"text":"فِيهَا عَيْنٌ جَارِيَةٌ","hits":[]},{"ref":"88:13","number":5980,"text":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ","hits":[]},{"ref":"88:14","number":5981,"text":"وَأَكْوَابٌ مَّوْضُوعَةٌ","hits":[0]},{"ref":"88:15","number":5982,"text":"وَنَمَارِقُ مَصْفُوفَةٌ","hits":[]},{"ref":"88:16","number":5983,"text":"وَزَرَابِىُّ مَبْثُوثَةٌ","hits":[]},{"ref":"88:17","number":5984,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","hits":[1,2,3,4,5]},{"ref":"88:18","number":5985,"text":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","hits":[1,3]},{"ref":"88:19","number":5986,"text":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","hits":[1]},{"ref":"88:20","number":5987,"text":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","hits":[1]},{"ref":"88:21","number":5988,"text":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ","hits":[0,1,2]},{"ref":"88:22","number":5989,"text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","hits":[1]},{"ref":"88:23","number":5990,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","hits":[1,2,3]},{"ref":"88:24","number":5991,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","hits":[0,2]},{"ref":"88:25","number":5992,"text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","hits":[]},{"ref":"88:26","number":5993,"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","hits":[0,3]}]}