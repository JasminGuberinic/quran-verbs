ull, "recitedText": null}], "ayat": [{"ref": "26:157", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3089.mp3", "translation": {"en": {"text": "But they hamstrung her, and then were penitent.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Derken onu kestiler; fakat pişman da oldular.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس پر انہوں نے اس کی کونچیں کاٹ دیں پھر صبح کو پچھتاتے رہ گئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian mereka membunuhnya, lalu mereka menjadi menyesal,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَعَقَرُوهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَصْبَحُوا۟", "hit": true, "audio": "audio/04c80b10688e4ef30816.m4a", "gloss": {"bs": "pa su postali", "en": "so they became", "tr": "bunun üzerine oldular", "fr": "alors ils devinrent", "id": "maka mereka menjadi", "ur": "پھر وہ ہو گئے", "bn": "তখন তারা হয়ে গেল", "fa": "پس شدند"}}, {"text": "نَٰدِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "5:30", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/699.mp3", "translation": {"en": {"text": "But (the other's) mind imposed on him the killing of his brother, so he slew him and became one of the losers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine kurbanı kabul edilmeyenin nefsi kendisini, kardeşini öldürmeye teşvik etti ve onu öldürdü. Böylece zarara uğrayanlardan oldu.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اسکے نفس نے اسے بھائی کے قتل کا چاؤ دلایا تو اسے قتل کردیا تو رہ گیا نقصان میں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka hawa nafsu Qabil menjadikannya menganggap mudah membunuh saudaranya, sebab itu dibunuhnyalah, maka jadilah ia seorang diantara orang-orang yang merugi.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَطَوَّعَتْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "نَفْسُهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "قَتْلَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَقَتَلَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَصْبَحَ", "hit": true, "audio": "audio/1466159fdac5c7131c56.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}]}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَٰسِرِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "41:23", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4241.mp3", "translation": {"en": {"text": "That, your thought which ye did think about your Lord, hath ruined you; and ye find yourselves (this day) among the lost.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte Rabbiniz hakkında beslediğiniz bu zannınız sizi helak etti de zarara uğrayanlardan oldunuz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ ہے تمہارا وہ گمان جو تم نے اپنے رب کے ساتھ کیا اور اس نے تمہیں ہلاک کردیا تو اب رہ گئے ہارے ہوؤں میں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan yang demikian itu adalah prasangkamu yang telah kamu sangka kepada Tuhanmu, Dia telah membinasakan kamu, maka jadilah kamu termasuk orang-orang yang merugi.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَذَٰلِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ظَنُّكُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "ظَنَنتُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِرَبِّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْدَىٰكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَصْبَحْتُم", "hit": true, "audio": "audio/620d2fef4f933804baa7.m4a", "gloss": {"en": "so you (all) became", "bs": "pa ste postali", "tr": "böylece oldunuz", "fr": "alors vous êtes devenus", "id": "maka kalian telah menjadi", "ur": "پس تم ہو گئے", "bn": "অতএব তোমরা হয়েছ", "fa": "پس شدید"}}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَٰسِرِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:40", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2713.mp3", "translation": {"en": {"text": "He said: In a little while they surely will become repentant.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah şöyle buyurdu: \"Pek yakında onlar pişman olacaklar!\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ نے فرمایا کچھ دیر جاتی ہے کہ یہ صبح کریں گے پچھتاتے ہوئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah berfirman: \"Dalam sedikit waktu lagi pasti mereka akan menjadi orang-orang yang menyesal\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "قَلِيلٍ", "hit": false, "audio": null, "gloss": null}, {"text": "لَّيُصْبِحُنَّ", "hit": true, "audio": "audio/122f011a6aa909a10a39.m4a", "gloss": {"bs": "sigurno će postati", "en": "they will surely become", "tr": "mutlaka olacaklar", "fr": "ils deviendront certes", "id": "sungguh mereka akan menjadi", "ur": "وہ ضرور ہو جائیں گے", "bn": "অবশ্যই তারা হয়ে যাবে", "fa": "قطعاً خواهند شد"}}, {"text": "نَٰدِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "30:17", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3426.mp3", "translation": {"en": {"text": "So glory be to Allah when ye enter the night and when ye enter the morning -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O halde akşama girdiğiniz zaman da, sabaha girdiğiniz zaman da tesbih Allah'ındır. (daima O, tesbih edilir).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اللہ کی پاکی بولو جب شام کرو اور جب صبح ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka bertasbihlah kepada Allah di waktu kamu berada di petang hari dan waktu kamu berada di waktu subuh,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَسُبْحَٰنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "حِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "تُمْسُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَحِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "تُصْبِحُونَ", "hit": true, "audio": "audio/5bd0ae8e8328a59093f2.m4a", "gloss": {"en": "you (all) enter the morning", "bs": "osvanjujete", "tr": "sabah olursunuz", "fr": "vous atteignez le matin", "id": "kalian memasuki pagi", "ur": "تم صبح کرتے ہو", "bn": "তোমরা সকালে উপনীত হও", "fa": "صبح می‌کنید"}}]}, {"ref": "18:41", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2181.mp3", "translation": {"en": {"text": "Or some morning the water thereof will be lost in the earth so that thou canst not make search for it.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Yahut, bağının suyu yerin dibine çekilir de bir daha suyunu çıkarıp bağını sulayam