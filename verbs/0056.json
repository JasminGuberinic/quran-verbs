{"rank": 56, "root": "رزق", "form": 1, "lemma": "رَزَقَ", "count": 61, "ayahCount": 60, "share": 0.32, "meaning": {"bs": "opskrbiti, darovati", "en": "to provide, to bestow", "tr": "rızık vermek, bahşetmek", "fr": "pourvoir, accorder", "id": "memberi rezeki, menganugerahkan", "ur": "رزق دینا، عطا کرنا", "bn": "রিযিক দেওয়া, দান করা", "fa": "روزی دادن، عطا کردن"}, "lemmaSpoken": "audio/e85f93aec2d831832e11.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "رَزَقَ", "plain": "رَزَقَ", "quran": false, "notUsed": false, "spoken": "audio/e85f93aec2d831832e11.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَرْزُقُ", "plain": "يَرْزُقُ", "quran": true, "notUsed": false, "spoken": "audio/455cf7dfbee4f48dd2cf.m4a", "recited": "audio/0c672990dbde0c4e9194.m4a", "recitedText": "يَرْزُقُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱرْزُقْ", "plain": "اُرْزُقْ", "quran": true, "notUsed": false, "spoken": "audio/d9de4c42a9fbf40eb36d.m4a", "recited": "audio/5bb631c3e5fc6720d0a5.m4a", "recitedText": "وَٱرْزُقْ"}], "nouns": {"participle": {"lemma": "رازِق", "count": 6, "spoken": "audio/f1b21f5ea5048800dd78.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "رَزَقْتُ", "plain": "رَزَقْتُ", "quran": false, "notUsed": false, "spoken": "audio/3572aa41333c043c3ebe.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "رَزَقْنَا", "plain": "رَزَقْنَا", "quran": false, "notUsed": false, "spoken": "audio/b1aee0ba394595920e07.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "رَزَقْتَ", "plain": "رَزَقْتَ", "quran": false, "notUsed": false, "spoken": "audio/eca50505ec64c6238946.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "رَزَقْتِ", "plain": "رَزَقْتِ", "quran": false, "notUsed": false, "spoken": "audio/0a30b890eafe715b6437.m4a", "recited": null, "recitedText": null}, {"tense