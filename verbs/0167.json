t": "عَلَيْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْلُ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَذَآئِقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "10:96", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1460.mp3", "translation": {"en": {"text": "Lo! those for whom the word of thy Lord (concerning sinners) hath effect will not believe,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Doğrusu, aleyhlerinde Rabbinin hükmü kesinleşmiş olanlar imana gelmezler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک وہ جن پر تیرے رب کی بات ٹھیک پڑچکی ہے ایمان نہ لائیں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya orang-orang yang telah pasti terhadap mereka kalimat Tuhanmu, tidaklah akan beriman,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "حَقَّتْ", "hit": true, "audio": "audio/00bc4b802611f5a51f69.m4a", "gloss": {"en": "she/it came true", "bs": "obistinila se", "tr": "gerçekleşti", "fr": "elle s'est réalisée", "id": "dia telah terwujud", "ur": "وہ سچ ثابت ہوئی", "bn": "সে সত্য প্রমাণিত হলো", "fa": "تحقق یافت"}}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَلِمَتُ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُؤْمِنُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:70", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3775.mp3", "translation": {"en": {"text": "To warn whosoever liveth, and that the word may be fulfilled against the disbelievers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Bu), diri olanları uyarmak ve kâfirlere de azab sözünün hak olması içindir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ اسے ڈرائے جو زندہ ہو اور کافروں پر بات ثابت ہوجائے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "supaya dia (Muhammad) memberi peringatan kepada orang-orang yang hidup (hatinya) dan supaya pastilah (ketetapan azab) terhadap orang-orang kafir.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لِّيُنذِرَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "حَيًّا", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَحِقَّ", "hit": true, "audio": "audio/639f4734c47b63c0cb68.m4a", "gloss": {"bs": "i da se obistini", "en": "and that it comes true", "tr": "ve gerçekleşmesi için", "fr": "et que se réalise", "id": "dan agar terbukti", "ur": "اور سچ ثابت ہو جائے", "bn": "এবং যাতে তা সত্য প্রমাণিত হয়", "fa": "و (تا) محقق شود"}}, {"text": "ٱلْقَوْلُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكَٰفِرِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "حَقَّ", "count": 7, "first": "7:30", "audio": "audio/ccfda916b63530ef3936.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it came true", "bs": "obistinio se", "tr": "gerçekleşti", "fr": "il s'est réalisé", "id": "dia telah terwujud", "ur": "وہ سچ ثابت ہوا", "bn": "সে সত্য প্রমাণিত হলো", "fa": "تحقق یافت"}}, {"arabic": "حَقَّتْ", "count": 5, "first": "10:33", "audio": "audio/a61c0642d433