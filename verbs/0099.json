recited": "audio/847fc5e8425d951c6d04.m4a", "recitedText": "فَتَوَكَّلْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "تَوَكَّلِي", "plain": "تَوَكَّلِي", "quran": false, "notUsed": false, "spoken": "audio/7f0f342dafee18a2a025.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "تَوَكَّلَا", "plain": "تَوَكَّلَا", "quran": false, "notUsed": false, "spoken": "audio/653ec0edf22e49a72646.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "تَوَكَّلُوٓا۟", "plain": "تَوَكَّلُوا", "quran": true, "notUsed": false, "spoken": "audio/3517bb0ad420fc52573d.m4a", "recited": "audio/93fe5b0f54bd29476b0d.m4a", "recitedText": "تَوَكَّلُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "تَوَكَّلْنَ", "plain": "تَوَكَّلْنَ", "quran": false, "notUsed": false, "spoken": "audio/c9577d42d01b4bdb0a60.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "64:13", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5212.mp3", "translation": {"en": {"text": "Allah! There is no Allah save Him. In Allah, therefore, let believers put their trust.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah ki O'ndan başka tanrı yoktur. Müminler Allah'a dayansınlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ ہے جس کے سوا کسی کی بندگی نہیں اور اللہ ہی پر ایمان والے بھروسہ کریں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Dialah) Allah tidak ada Tuhan selain Dia. Dan hendaklah orang-orang mukmin bertawakkal kepada Allah saja.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَٰهَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَعَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلْيَتَوَكَّلِ", "hit": true, "audio": "audio/02b9441f9183fb62ff68.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "jussive"}]}, {"text": "ٱلْمُؤْمِنُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:217", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3149.mp3", "translation": {"en": {"text": "And put thy trust in the Mighty, the Merciful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sen O, mutlak galip ve engin merhamet sahibine güvenip dayan.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اس پر بھروسہ کرو جو عزت والا مہر والا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan bertawakkallah kepada (Allah) Yang Maha Perkasa lagi Maha Penyayang,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَتَوَكَّلْ", "hit": true, "audio": "audio/29c6dffd9c7f4a6a4e1a.m4a", "gloss": {"bs": "i osloni se!", "en": "and rely!", "tr": "ve dayan!", "fr": "et remets-t'en !", "id": "dan bertawakallah!", "ur": "اور بھروسا کر!", "bn": "এবং ভরসা করো!", "fa": "و توکل کن!"}}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَزِيزِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّحِيمِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "16:42", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1943.mp3", "translation": {"en": {"text": "Such as are steadfast and put their trust in Allah.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O Muhacirler, müşriklerin eziyetlerine sabredenler ve Rablerine tevekkül edenlerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ جنہوں نے صبر کیا اور اپنے رب ہی پر بھروسہ کرتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yaitu) orang-orang yang sabar dan hanya kepada Tuhan saja mereka bertawakkal.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "صَبَرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَعَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَوَكَّلُونَ", "hit": true, "audio": "audio/e9eb227e7bd5056bcbef.m4a", "gloss": {"bs": "oslanjaju se", "en": "they rely", "tr": "dayanırlar", "fr": "ils s'en remettent", "id": "mereka bertawakal", "ur": "وہ بھروسا کرتے ہیں", "bn": "তারা ভরসা করে", "fa": "توکل می‌کنند"}}]}, {"ref": "10:85", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1449.mp3", "translation": {"en": {"text": "They said: In Allah we put trust. Our Lord! Oh, make us not a lure for the wrongdoing folk;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar da: \"Biz Allah'a güvendik. Ey Rabbimiz, bizi o zalim kavmin fitnesine uğratma!\" dediler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے ہم نے اللہ پر بھروسہ کیا الہٰی ہم کو ظالم لوگوں کے لیے آزمائش نہ بنا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Lalu mereka berkata: \"Kepada Allahlah kami bertawakkal! Ya Tuhan kami; janganlah Engkau jadikan kami sasaran fitnah bagi kaum yang'zalim,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَقَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "تَوَكَّلْنَا", "hit": true, "audio": "audio/1b09761146bed7a58940.m4a", "gloss": {"bs": "oslonili smo se", "en": "we relied", "tr": "dayandık", "fr": "nous nous sommes remis", "id": "kami bertawakal", "ur": "ہم نے بھروسا کیا", "bn": "আমরা ভরসা করেছি", "fa": "توکل کردیم"}}, {"text": "رَبَّنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَجْعَلْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فِتْنَةً", "hit": false, "audio": null, "gloss": null}, {"text": "لِّلْقَوْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلظَّٰلِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "10:84", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1448.mp3", "translation": {"en": {"text": "And Moses said: O my people! If ye have believed in Allah then put trust in Him, if ye have indeed surrendered (unto Him)!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa dedi ki: \"Ey kavmim! Siz gerçekten Allah'a iman ettinizse, O'na samimiyetle teslim olan müslümanlardan oldunuzsa artık O'na güvenin!\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور موسیٰ نے کہا اے میری قوم اگر تم اللہ پر ایمان لائے تو اسی پر بھروسہ کرو اگر تم اسلام رکھتے ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berkata Musa: \"Hai kaumku, jika kamu beriman kepada Allah, maka bertawakkallah kepada-Nya saja, jika kamu benar-benar orang yang berserah diri\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "مُوسَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰقَوْمِ", "hit": false, "audio": null, "gloss": null}, {"tex