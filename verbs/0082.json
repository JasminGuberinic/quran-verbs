e, "notUsed": false, "spoken": "audio/42d6244fe22303e86b3d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَرُوا", "plain": "أَرُوا", "quran": false, "notUsed": false, "spoken": "audio/efdc22ffe3b173705beb.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَرِينَ", "plain": "أَرِينَ", "quran": false, "notUsed": false, "spoken": "audio/702bbe201f5ec9767f3c.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "20:23", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2371.mp3", "translation": {"en": {"text": "That We may show thee (some) of Our greater portents,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Bunları sana en büyük mucizelerimizden (bir kısmını) gösterelim diye yaptık.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ ہم تجھے اپنی بڑی بڑی نشانیاں دکھائیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "untuk Kami perlihatkan kepadamu sebahagian dari tanda-tanda kekuasaan Kami yang sangat besar,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لِنُرِيَكَ", "hit": true, "audio": "audio/fba82da81ed0785c799d.m4a", "gloss": {"bs": "da ti pokažemo", "en": "that We may show you", "tr": "sana gösterelim diye", "fr": "afin que Nous te montrions", "id": "agar Kami perlihatkan kepadamu", "ur": "تاکہ ہم تمہیں دکھائیں", "bn": "যাতে আমরা তোমাকে দেখাই", "fa": "تا به تو نشان دهیم"}}, {"text": "مِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكُبْرَى", "hit": false, "audio": null, "gloss": null}]}, {"ref": "40:81", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4214.mp3", "translation": {"en": {"text": "And He showeth you His tokens. Which, then, of the tokens of Allah do ye deny?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah size âyetlerini gösteriyor. Şimdi Allah'ın âyetlerinin hangisini inkâr edersiniz?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ تمہیں اپنی نشانیاں دکھاتا ہے تو اللہ کی کونسی نشانی کا انکار کرو گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Dia memperlihatkan kepada kamu tanda-tanda (kekuasaan-Nya); maka tanda-tanda (kekuasaan) Allah yang manakah yang kamu ingkari?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيُرِيكُمْ", "hit": true, "audio": "audio/638370427c03ae99bcb2.m4a", "gloss": {"en": "and he/it shows you (all)", "bs": "i pokazuje vam", "tr": "ve size gösterir", "fr": "et il vous montre", "id": "dan dia menunjukkan kepada kalian", "ur": "اور وہ تمہیں دکھاتا ہے", "bn": "এবং সে তোমাদের দেখায়", "fa": "و به شما نشان می‌دهد"}}, {"text": "ءَايَٰتِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَىَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "تُنكِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "79:20", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5732.mp3", "translation": {"en": {"text": "And he showed him the tremendous token.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa Firavun'a o büyük mucizeyi gösterdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر موسیٰ نے اسے بہت بڑی نشانی دکھائی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Lalu Musa memperlihatkan kepadanya mukjizat yang besar.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَرَىٰهُ", "hit": true, "audio": "audio/38bde56a7ba383d75d50.m4a", "gloss": {"en": "so he showed him", "bs": "pa mu je pokazao"}}, {"text": "ٱلْءَايَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكُبْرَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "34:27", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3633.mp3", "translation": {"en": {"text": "Say: Show me those whom ye have joined unto Him as partners. Nay (ye dare not)! For He is Allah, the Mighty, the Wise.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki: \"O'na ortak diye takıştırdıklarınızı bana gösterin bakayım! Hayır, öyle şey yoktur, doğrusu güçlü ve hikmet sahibi olan ancak Allah'tır.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ مجھے دکھاؤ تو وہ شریک جو تم نے اس سے ملائے ہیں ہشت، بلکہ وہی ہے اللہ عزت والا حکمت والا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah: \"Perlihatkanlah kepadaku sembah-sembahan yang kamu hubungkan dengan Dia sebagai sekutu-sekutu-Nya, sekali-kali tidak mungkin! Sebenarnya Dialah Allah Yang Maha Perkasa lagi Maha Bijaksana.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرُونِىَ", "hit": true, "audio": "audio/831e21a764bb6d6162c5.m4a", "gloss": {"bs": "pokažite mi!", "en": "show me!", "tr": "bana gösterin!", "fr": "montrez-moi !", "id": "perlihatkanlah kepadaku!", "ur": "مجھے دکھاؤ!", "bn": "আমাকে দেখাও!", "fa": "به من نشان بده!"}}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلْحَقْتُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "شُرَكَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "بَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَزِيزُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَكِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:37", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2520.mp3", "translation": {"en": {"text": "Man is made of haste. I shall show you My portents, but ask Me not to hasten.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İnsan aceleci olarak yaratılmıştır. Size yakında (azaba dair) alametlerimi göstereceğim. Şimdi siz acele etmeyin.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "آدمی جلد باز بنایا گیا، اب میں تمہیں اپنی نشانیاں دکھاؤں گا مجھ سے جلدی نہ کرو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Manusia telah dijadikan (bertabiat) tergesa-gesa. Kelak akan Aku perIihatkan kepadamu tanda-tanda azab-Ku. Maka janganlah kamu minta kepada-Ku mendatangkannya dengan segera.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "خُلِقَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْإِنسَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَجَلٍ", "hit": false, "audio": null, "gloss": null}, {"text": "سَأُو۟رِيكُمْ", "hit": true, "audio": "audio/e84faba194400bd66ab4.m4a", "gloss": {"en": "I will show you (all)", "bs": "pokazat ću vam", "tr": "size göstereceğim", "fr": "je vous montrerai", "id": "aku akan menunjukkan kepada kalian", "ur": "میں تم سب کو دکھاؤں گا", "bn": "আমি তোমাদের দেখাব", "fa": "به شما نشان خواهم داد"}}, {"text": "ءَايَٰتِى", "hit": false, "audio": null, "gloss": null}, {"text": "فَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْتَعْجِلُونِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:56", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2404.mp3", "translation": {"en": {"text": "And We verily did show him all Our tokens, but he denied them and refused.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "And olsun ki, biz, Firavun'a mucizelerimizin hepsini gösterdik. Böyle iken o yine onları yalan sayıp kabulden çekindi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے اسے اپنی سب نشانیاں دکھائیں تو اس نے جھٹلایا اور نہ مانا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya Kami telah perlihatkan kepadanya (Fir'aun) tanda-tanda kekuasaan Kami semuanya maka ia mendustakan dan enggan (menerima kebenaran).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرَيْنَٰهُ", "hit": true, "audio": "audio/5f318feedb318535e819.m4a", "gloss": {"bs": "pokazali smo mu", "en": "We showed him", "tr": "ona gösterdik", "fr": "Nous lui avons montré", "id": "Kami memperlihatkan kepadanya", "ur": "ہم نے اسے دکھایا", "bn": "আমরা তাকে দেখিয়েছি", "fa": "به او نشان دادیم"}}, {"text": "ءَايَٰتِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُلَّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَكَذَّبَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَبَىٰ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "نُرِيَنَّكَ", "count": 4, "first": "10:46", "audio": "audio/5ab231d7383e05598901.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["anta"], "mood": "indicative"}]}, {"arabic": "وَيُرِيكُمْ", "count": 2, "first": "2:73", "audio": "audio/e9b15311e1b0e2839416.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "and he/it shows you (all)", "bs": "i pokazuje vam", "tr": "ve size gösterir", "fr": "et il vous montre", "id": "dan dia menunjukkan kepada kalian", "ur": "اور وہ تمہیں دکھاتا ہے", "bn": "এবং সে তোমাদের দেখায়", "fa": "و به شما نشان می‌دهد"}}, {"arabic": "أَرِنَا", "count": 2, "first": "4:153", "audio": "audio/6469c257045a00206240.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": ["nahnu"]}], "gloss": {"en": "show us!", "bs": "pokaži nam!", "tr": "bize göster!", "fr": "montre-nous !", "id": "tunjukkanlah kami!", "ur": "ہمیں دکھا!", "bn": "আমাদের দেখাও!", "fa": "به ما نشان بده!"}}, {"arabic": "سَأُو۟رِيكُمْ", "count": 2, "first": "7:145", "audio": "audio/e54676070731914282bf.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "I will show you (all)", "bs": "pokazat ću vam", "tr": "size göstereceğim", "fr": "je vous montrerai", "id": "aku akan menunjukkan kepada kalian", "ur": "میں تم سب کو دکھاؤں گا", "bn": "আমি তোমাদের দেখাব", "fa": "به شما نشان خواهم داد"}}, {"arabic": "يُرِيكُمُ", "count": 2, "first": "13:12", "audio": "audio/b3a7afaf652ddc608599.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "he/it shows you (all)", "bs": "pokazuje vam", "tr": "size gösterir", "fr": "il vous montre", "id": "dia menunjukkan kepada kalian", "ur": "وہ تمہیں دکھاتا ہے", "bn": "সে তোমাদের দেখায়", "fa": "به شما نشان می‌دهد"}}, {"arabic": "أَرُونِى", "count": 2, "first": "35:40", "audio": "audio/ad4c6f8714919f38c85c.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["ana"]}], "gloss": {"en": "(you all) show me!", "bs": "pokažite mi!", "tr": "bana gösterin!", "fr": "montrez-moi !", "id": "tunjukkanlah kepadaku!", "ur": "مجھے دکھاؤ!", "b