[{"id":"qassa-7-101-2","words":["verb:qassa"],"options":[{"bs":"kazujemo","en":"we narrate"},{"bs":"kazuje","en":"he/it narrates"},{"bs":"kazuju","en":"they narrate"},{"bs":"kazujemo ih","en":"we narrate them"}],"ref":"7:101","answerWord":"نَقُصُّ","answerSound":"audio/1b10acb893fbe35f843c.m4a","quranTranslation":{"text":"Such were the townships. We relate some tidings of them unto thee (Muhammad). Their messengers verily came unto them with clear proofs (of Allah's Sovereignty), but they could not believe because they had before denied. Thus doth Allah print upon the hearts of disbelievers (that they hear not).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["تِلْكَ","ٱلْقُرَىٰ","نَقُصُّ","عَلَيْكَ","مِنْ","أَنۢبَآئِهَا","وَلَقَدْ","جَآءَتْهُمْ","رُسُلُهُم","بِٱلْبَيِّنَٰتِ","فَمَا","كَانُوا۟","لِيُؤْمِنُوا۟","بِمَا","كَذَّبُوا۟","مِن","قَبْلُ","كَذَٰلِكَ","يَطْبَعُ","ٱللَّهُ","عَلَىٰ","قُلُوبِ","ٱلْكَٰفِرِينَ"],"marked":[2],"facts":{"verb":"قَصَّ"}},{"id":"qassa-27-76-3","words":["verb:qassa"],"options":[{"bs":"kazuje","en":"he/it narrates"},{"bs":"kazujemo","en":"we narrate"},{"bs":"kazuju","en":"they narrate"},{"bs":"prati ga","en":"follow him"}],"ref":"27:76","answerWord":"يَقُصُّ","answerSound":"audio/5d7b25cda14db41d3e5f.m4a","quranTranslation":{"text":"Lo! this Qur'an narrateth unto the Children of Israel most of that concerning which they differ.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["إِنَّ","هَٰذَا","ٱلْقُرْءَانَ","يَقُصُّ","عَلَىٰ","بَنِىٓ","إِسْرَٰٓءِيلَ","أَكْثَرَ","ٱلَّذِى","هُمْ","فِيهِ","يَخْتَلِفُونَ"],"marked":[3],"facts":{"verb":"قَصَّ"}},{"id":"qassa-6-130-7","words":["verb:qassa"],"options":[{"bs":"kazuju","en":"they narrate"},{"bs":"prati ga","en":"follow him"},{"bs":"kazuje","en":"he/it narrates"},{"bs":"kazivali smo","en":"we narrated"}],"ref":"6:130","answerWord":"يَقُصُّونَ","answerSound":"audio/4910a889b040a80256ce.m4a","quranTranslation":{"text":"O ye assembly of the jinn and humankind! Came there not unto you messengers of your own who recounted unto you My tokens and warned you of the meeting of this your Day? They will say: We testify against ourselves. And the life of the world beguiled them. And they testify against themselves that they were disbelievers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["يَٰمَعْشَرَ","ٱلْجِنِّ","وَٱلْإِنسِ","أَلَمْ","يَأْتِكُمْ","رُسُلٌ","مِّنكُمْ","يَقُصُّونَ","عَلَيْكُمْ","ءَايَٰتِى","وَيُنذِرُونَكُمْ","لِقَآءَ","يَوْمِكُمْ","هَٰذَا","قَالُوا۟","شَهِدْنَا","عَلَىٰٓ","أَنفُسِنَا","وَغَرَّتْهُمُ","ٱلْحَيَوٰةُ","ٱلدُّنْيَا","وَشَهِدُوا۟","عَلَىٰٓ","أَنفُسِهِمْ","أَنَّهُمْ","كَانُوا۟","كَٰفِرِينَ"],"marked":[7],"facts":{"verb":"قَصَّ"}},{"id":"qassa-16-118-5","words":["verb:qassa"],"options":[{"bs":"kazivali smo","en":"we narrated"},{"bs":"prati ga","en":"follow him"},{"bs":"kazujemo ih","en":"we narrate them"},{"bs":"i kazivao je","en":"and he/it narrated"}],"ref":"16:118","answerWord":"قَصَصْنَا","answerSound":"audio/24b1497351f9aa5a048a.m4a","quranTranslation":{"text":"And unto those who are Jews We have forbidden that which We have already related unto thee. And We wronged them not, but they were wont to wrong themselves.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["وَعَلَى","ٱلَّذِينَ","هَادُوا۟","حَرَّمْنَا","مَا","قَصَصْنَا","عَلَيْكَ","مِن","قَبْلُ","وَمَا","ظَلَمْنَٰهُمْ","وَلَٰكِن","كَانُوٓا۟","أَنفُسَهُمْ","يَظْلِمُونَ"],"marked":[5],"facts":{"verb":"قَصَّ"}},{"id":"qassa-4-164-2","words":["verb:qassa"],"options":[{"bs":"kazivali smo ih","en":"we narrated them"},{"bs":"kazuju","en":"they narrate"},{"bs":"kazivali smo","en":"we narrated"},{"bs":"kazujemo","en":"we narrate"}],"ref":"4:164","answerWord":"قَصَصْنَٰهُمْ","answerSound":"audio/b1e1e6088aa6057cb548.m4a","quranTranslation":{"text":"And messengers We have mentioned unto thee before and messengers We have not mentioned unto thee; and Allah spake directly unto Moses;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["وَرُسُلًا","قَدْ","قَصَصْنَٰهُمْ","عَلَيْكَ","مِن","قَبْلُ","وَرُسُلًا","لَّمْ","نَقْصُصْهُمْ","عَلَيْكَ","وَكَلَّمَ","ٱللَّهُ","مُوسَىٰ","تَكْلِيمًا"],"marked":[2],"facts":{"verb":"قَصَّ"}},{"id":"qassa-4-164-8","words":["verb:qassa"],"options":[{"bs":"kazujemo ih","en":"we narrate them"},{"bs":"kazuju","en":"they narrate"},{"bs":"pa ćemo sigurno kazivati","en":"then We will surely narrate"},{"bs":"prati ga","en":"follow him"}],"ref":"4:164","answerWord":"نَقْصُصْهُمْ","answerSound":"audio/7e2ede139d354fa80f1a.m4a","quranTranslation":{"text":"And messengers We have mentioned unto thee before and messengers We have not mentioned unto thee; and Allah spake directly unto Moses;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["وَرُسُلًا","قَدْ","قَصَصْنَٰهُمْ","عَلَيْكَ","مِن","قَبْلُ","وَرُسُلًا","لَّمْ","نَقْصُصْهُمْ","عَلَيْكَ","وَكَلَّمَ","ٱللَّهُ","مُوسَىٰ","تَكْلِيمًا"],"marked":[8],"facts":{"verb":"قَصَّ"}},{"id":"qassa-7-7-0","words":["verb:qassa"],"options":[{"bs":"pa ćemo sigurno kazivati","en":"then We will surely narrate"},{"bs":"kazujemo ih","en":"we narrate them"},{"bs":"kazujemo ga","en":"we narrate it"},{"bs":"kazivali smo","en":"we narrated"}],"ref":"7:7","answerWord":"فَلَنَقُصَّنَّ","answerSound":"audio/d6fb8f3031c0540b0c45.m4a","quranTranslation":{"text":"Then verily We shall narrate unto them (the event) with knowledge, for We were not absent (when it came to pass).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["فَلَنَقُصَّنَّ","عَلَيْهِم","بِعِلْمٍ","وَمَا","كُنَّا","غَآئِبِينَ"],"marked":[0],"facts":{"verb":"قَصَّ"}},{"id":"qassa-7-176-26","words":["verb:qassa"],"options":[{"bs":"pa kazuj!","en":"so narrate!"},{"bs":"kazujemo ga","en":"we narrate it"},{"bs":"i kazivao je","en":"and he/it narrated"},{"bs":"kazuje","en":"he/it narrates"}],"ref":"7:176","answerWord":"فَٱقْصُصِ","answerSound":"audio/ee54a30b2d2c30bc6081.m4a","quranTranslation":{"text":"And had We willed We could have raised him by their means, but he clung to the earth and followed his own lust. Therefor his likeness is as the likeness of a dog: if thou attackest him he panteth with his tongue out, and if thou leavest him he panteth with his tongue out. Such is the likeness of the people who deny Our revelations. Narrate unto them the history (of the men of old), that haply they may take thought.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["وَلَوْ","شِئْنَا","لَرَفَعْنَٰهُ","بِهَا","وَلَٰكِنَّهُۥٓ","أَخْلَدَ","إِلَى","ٱلْأَرْضِ","وَٱتَّبَعَ","هَوَىٰهُ","فَمَثَلُهُۥ","كَمَثَلِ","ٱلْكَلْبِ","إِن","تَحْمِلْ","عَلَيْهِ","يَلْهَثْ","أَوْ","تَتْرُكْهُ","يَلْهَث","ذَّٰلِكَ","مَثَلُ","ٱلْقَوْمِ","ٱلَّذِينَ","كَذَّبُوا۟","بِـَٔايَٰتِنَا","فَٱقْصُصِ","ٱلْقَصَصَ","لَعَلَّهُمْ","يَتَفَكَّرُونَ"],"marked":[26],"facts":{"verb":"قَصَّ"}},{"id":"qassa-11-100-4","words":["verb:qassa"],"options":[{"bs":"kazujemo ga","en":"we narrate it"},{"bs":"kazivali smo","en":"we narrated"},{"bs":"kazujemo","en":"we narrate"},{"bs":"kazuju","en":"they narrate"}],"ref":"11:100","answerWord":"نَقُصُّهُۥ","answerSound":"audio/ab1b22971558d0f7fbdb.m4a","quranTranslation":{"text":"That is (something) of the tidings of the townships (which were destroyed of old). We relate it unto thee (Muhammad). Some of them are standing and some (already) reaped.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["ذَٰلِكَ","مِنْ","أَنۢبَآءِ","ٱلْقُرَىٰ","نَقُصُّهُۥ","عَلَيْكَ","مِنْهَا","قَآئِمٌ","وَحَصِيدٌ"],"marked":[4],"facts":{"verb":"قَصَّ"}},{"id":"qassa-11-120-1","words":["verb:qassa"],"options":[{"bs":"kazujemo","en":"we narrate"},{"bs":"i kazivao je","en":"and he/it narrated"},{"bs":"pa kazuj!","en":"so narrate!"},{"bs":"kazuju","en":"they narrate"}],"ref":"11:120","answerWord":"نَّقُصُّ","answerSound":"audio/468462b03ebd59fe2db1.m4a","quranTranslation":{"text":"And all that We relate unto thee of the story of the messengers is in order that thereby We may make firm thy heart. And herein hath come unto thee the Truth and an exhortation and a reminder for believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["وَكُلًّا","نَّقُصُّ","عَلَيْكَ","مِنْ","أَنۢبَآءِ","ٱلرُّسُلِ","مَا","نُثَبِّتُ","بِهِۦ","فُؤَادَكَ","وَجَآءَكَ","فِى","هَٰذِهِ","ٱلْحَقُّ","وَمَوْعِظَةٌ","وَذِكْرَىٰ","لِلْمُؤْمِنِينَ"],"marked":[1],"facts":{"verb":"قَصَّ"}},{"id":"qassa-28-11-2","words":["verb:qassa"],"options":[{"bs":"prati ga","en":"follow him"},{"bs":"i kazivao je","en":"and he/it narrated"},{"bs":"kazujemo","en":"we narrate"},{"bs":"pa kazuj!","en":"so narrate!"}],"ref":"28:11","answerWord":"قُصِّيهِ","answerSound":"audio/757d2143c3c85951e56a.m4a","quranTranslation":{"text":"And she said unto his sister: Trace him. So she observed him from afar, and they perceived not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["وَقَالَتْ","لِأُخْتِهِۦ","قُصِّيهِ","فَبَصُرَتْ","بِهِۦ","عَن","جُنُبٍ","وَهُمْ","لَا","يَشْعُرُونَ"],"marked":[2],"facts":{"verb":"قَصَّ"}},{"id":"qassa-28-25-16","words":["verb:qassa"],"options":[{"bs":"i kazivao je","en":"and he/it narrated"},{"bs":"kazuju","en":"they narrate"},{"bs":"kazivali smo ih","en":"we narrated them"},{"bs":"pa kazuj!","en":"so narrate!"}],"ref":"28:25","answerWord":"وَقَصَّ","answerSound":"audio/a04db3463034bcd62769.m4a","quranTranslation":{"text":"Then there came unto him one of the two women, walking shyly. She said: Lo! my father biddeth thee, that he may reward thee with a payment for that thou didst water (the flock) for us. Then, when he came unto him and told him the (whole) story, he said: Fear not! Thou hast escaped from the wrongdoing folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazivati, pripovijedati","en":"to narrate, to tell"},"passage":["فَجَآءَتْهُ","إِحْدَىٰهُمَا","تَمْشِى","عَلَى","ٱسْتِحْيَآءٍ","قَالَتْ","إِنَّ","أَبِى","يَدْعُوكَ","لِيَجْزِيَكَ","أَجْرَ","مَا","سَقَيْتَ","لَنَا","فَلَمَّا","جَآءَهُۥ","وَقَصَّ","عَلَيْهِ","ٱلْقَصَصَ","قَالَ","لَا","تَخَفْ","نَجَوْتَ","مِنَ","ٱلْقَوْمِ","ٱلظَّٰلِمِينَ"],"marked":[16],"facts":{"verb":"قَصَّ"}},{"id":"hadhira-9-64-0","words":["verb:hadhira"],"options":[{"bs":"čuva se","en":"he/it bewares"},{"bs":"pa ih se čuvaj!","en":"so beware of them!"},{"bs":"pa ga se čuvajte!","en":"so (you all) beware of him!"},{"bs":"pribojavali su se","en":"they feared"}],"ref":"9:64","answerWord":"يَحْذَرُ","answerSound":"audio/e67f4d92251f8aff6655.m4a","quranTranslation":{"text":"The hypocrites fear lest a surah should be revealed concerning them, proclaiming what is in their hearts. Say: Scoff (your fill)! Lo! Allah is disclosing what ye fear.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuvati se, paziti se","en":"to beware, to be cautious"},"passage":["يَحْذَرُ","ٱلْمُنَٰفِقُونَ","أَن","تُنَزَّلَ","عَلَيْهِمْ","سُورَةٌ","تُنَبِّئُهُم","بِمَا","فِى","قُلُوبِهِمْ","قُلِ","ٱسْتَهْزِءُوٓا۟","إِنَّ","ٱللَّهَ","مُخْرِجٌ","مَّا","تَحْذَرُونَ"],"marked":[0],"facts":{"verb":"حَذِرَ"}},{"id":"hadhira-28-6-11","words":["verb:hadhira"],"options":[{"bs":"pribojavali su se","en":"they feared"},{"bs":"pa ga se čuvajte!","en":"so (you all) beware of him!"},{"bs":"čuvate se","en":"you (all) beware"},{"bs":"pa neka se čuva","en":"so let him beware"}],"ref":"28:6","answerWord":"يَحْذَرُونَ","answerSound":"audio/eda9626f6fc330021c0a.m4a","quranTranslation":{"text":"And to establish them in the earth, and to show Pharaoh and Haman and their hosts that which they feared from them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuvati se, paziti se","en":"to beware, to be cautious"},"passage":["وَنُمَكِّنَ","لَهُمْ","فِى","ٱلْأَرْضِ","وَنُرِىَ","فِرْعَوْنَ","وَهَٰمَٰنَ","وَجُنُودَهُمَا","مِنْهُم","مَّا","كَانُوا۟","يَحْذَرُونَ"],"marked":[11],"facts":{"verb":"حَذِرَ"}},{"id":"hadhira-5-92-4","words":["verb:hadhira"],"options":[{"bs":"i čuvajte se!","en":"and (you all) beware!"},{"bs":"pa ga se čuvajte!","en":"so (you all) beware of him!"},{"bs":"i čuvaj ih se!","en":"and beware of them!"},{"bs":"čuva se","en":"he/it bewares"}],"ref":"5:92","answerWord":"وَٱحْذَرُوا۟","answerSound":"audio/d1ef620f66c629dba06f.m4a","quranTranslation":{"text":"Obey Allah and obey the messenger, and beware! But if ye turn away, then know that the duty of Our messenger is only plain conveyance (of the message).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuvati se, paziti se","en":"to beware, to be cautious"},"passage":["وَأَطِيعُوا۟","ٱللَّهَ","وَأَطِيعُوا۟","ٱلرَّسُولَ","وَٱحْذَرُوا۟","فَإِن","تَوَلَّيْتُمْ","فَٱعْلَمُوٓا۟","أَنَّمَا","عَلَىٰ","رَسُولِنَا","ٱلْبَلَٰغُ","ٱلْمُبِينُ"],"marked":[4],"facts":{"verb":"حَذِرَ"}},{"id":"hadhira-9-64-16","words":["verb:hadhira"],"options":[{"bs":"čuvate se","en":"you (all) beware"},{"bs":"i čuvaj ih se!","en":"and beware of them!"},{"bs":"čuva se","en":"he/it bewares"},{"bs":"i čuvajte se!","en":"and (you all) beware!"}],"ref":"9:64","answerWord":"تَحْذَرُونَ","answerSound":"audio/e623bd0152058f45c341.m4a","quranTranslation":{"text":"The hypocrites fear lest a surah should be revealed concerning them, proclaiming what is in their hearts. Say: Scoff (your fill)! Lo! Allah is disclosing what ye fear.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuvati se, paziti se","en":"to beware, to be cautious"},"passage":["يَحْذَرُ","ٱلْمُنَٰفِقُونَ","أَن","تُنَزَّلَ","عَلَيْهِمْ","سُورَةٌ","تُنَبِّئُهُم","بِمَا","فِى","قُلُوبِهِمْ","قُلِ","ٱسْتَهْزِءُوٓا۟","إِنَّ","ٱللَّهَ","مُخْرِجٌ","مَّا","تَحْذَرُونَ"],"marked":[16],"facts":{"verb":"حَذِرَ"}},{"id":"hadhira-24-63-15","words":["verb:hadhira"],"options":[{"bs":"pa neka se čuva","en":"so let him beware"},{"bs":"pa se čuvajte!","en":"so (you all) beware!"},{"bs":"pribojavali su se","en":"they feared"},{"bs":"čuvate se","en":"you (all) beware"}],"ref":"24:63","answerWord":"فَلْيَحْذَرِ","answerSound":"audio/d921b516e3f028bdb259.m4a","quranTranslation":{"text":"Make not the calling of the messenger among you as your calling one of another. Allah knoweth those of you who steal away, hiding themselves. And let those who conspire to evade orders beware lest grief or painful punishment befall them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuvati se, paziti se","en":"to beware, to be cautious"},"passage":["لَّا","تَجْعَلُوا۟","دُعَآءَ","ٱلرَّسُولِ","بَيْنَكُمْ","كَدُعَآءِ","بَعْضِكُم","بَعْضًا","قَدْ","يَعْلَمُ","ٱللَّهُ","ٱلَّذِينَ","يَتَسَلَّلُونَ","مِنكُمْ","لِوَاذًا","فَلْيَحْذَرِ","ٱلَّذِينَ","يُخَالِفُونَ","عَنْ","أَمْرِهِۦٓ","أَن","تُصِيبَهُمْ","فِتْنَةٌ","أَوْ","يُصِيبَهُمْ","عَذَابٌ","أَلِيمٌ"],"marked":[15],"facts":{"verb":"حَذِرَ"}},{"id":"hadhira-63-4-17","words":["verb:hadhira"],"options":[{"bs":"pa ih se čuvaj!","en":"so beware of them!"},{"bs":"čuvate se","en":"you (all) beware"},{"bs":"čuva se","en":"he/it bewares"},{"bs":"pribojavali su se","en":"they feared"}],"ref":"63:4","answerWord":"فَٱحْذَرْهُمْ","answerSound":"audio/a63048a96a12cea40480.m4a","quranTranslation":{"text":"And when thou seest them their figures please thee; and if they speak thou givest ear unto their speech. (They are) as though they were blocks of wood in striped cloaks. They deem every shout to be against them. They are the enemy, so beware of them. Allah confound them! How they are perverted!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuvati se, paziti se","en":"to beware, to be cautious"},"passage":["وَإِذَا","رَأَيْتَهُمْ","تُعْجِبُكَ","أَجْسَامُهُمْ","وَإِن","يَقُولُوا۟","تَسْمَعْ","لِقَوْلِهِمْ","كَأَنَّهُمْ","خُشُبٌ","مُّسَنَّدَةٌ","يَحْسَبُونَ","كُلَّ","صَيْحَةٍ","عَلَيْهِمْ","هُمُ","ٱلْعَدُوُّ","فَٱحْذَرْهُمْ","قَٰتَلَهُمُ","ٱللَّهُ","أَنَّىٰ","يُؤْفَكُونَ"],"marked":[17],"facts":{"verb":"حَذِرَ"}},{"id":"istahya-2-49-10","words":["verb:istahya"],"options":[{"bs":"i ostavljaju u životu","en":"and they keep alive"},{"bs":"stidi se","en":"he/it is ashamed"},{"bs":"i ostavite u životu!","en":"and (you all) keep alive!"},{"bs":"i ostavljamo u životu","en":"and we keep alive"}],"ref":"2:49","answerWord":"وَيَسْتَحْيُونَ","answerSound":"audio/cf6c563c728977440adc.m4a","quranTranslation":{"text":"And (remember) when We did deliver you from Pharaoh's folk, who were afflicting you with dreadful torment, slaying your sons and sparing your women: that was a tremendous trial from your Lord.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stidjeti se","en":"to be ashamed, to be shy"},"passage":["وَإِذْ","نَجَّيْنَٰكُم","مِّنْ","ءَالِ","فِرْعَوْنَ","يَسُومُونَكُمْ","سُوٓءَ","ٱلْعَذَابِ","يُذَبِّحُونَ","أَبْنَآءَكُمْ","وَيَسْتَحْيُونَ","نِسَآءَكُمْ","وَفِى","ذَٰلِكُم","بَلَآءٌ","مِّن","رَّبِّكُمْ","عَظِيمٌ"],"marked":[10],"facts":{"verb":"اسْتَحْيَا"}},{"id":"istahya-7-127-16","words":["verb:istahya"],"options":[{"bs":"i ostavljamo u životu","en":"and we keep alive"},{"bs":"i ostavlja u životu","en":"and he/it keeps alive"},{"bs":"i ostavite u životu!","en":"and (you all) keep alive!"},{"bs":"i ostavljaju u životu","en":"and they keep alive"}],"ref":"7:127","answerWord":"وَنَسْتَحْىِۦ","answerSound":"audio/41e8a8c2b5f87d88bacd.m4a","quranTranslation":{"text":"The chiefs of Pharaoh's people said: (O King), wilt thou suffer Moses and his people to make mischief in the land, and flout thee and thy gods? He said: We will slay their sons and spare their women, for lo! we are in power over them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stidjeti se","en":"to be ashamed, to be shy"},"passage":["وَقَالَ","ٱلْمَلَأُ","مِن","قَوْمِ","فِرْعَوْنَ","أَتَذَرُ","مُوسَىٰ","وَقَوْمَهُۥ","لِيُفْسِدُوا۟","فِى","ٱلْأَرْضِ","وَيَذَرَكَ","وَءَالِهَتَكَ","قَالَ","سَنُقَتِّلُ","أَبْنَآءَهُمْ","وَنَسْتَحْىِۦ","نِسَآءَهُمْ","وَإِنَّا","فَوْقَهُمْ","قَٰهِرُونَ"],"marked":[16],"facts":{"verb":"اسْتَحْيَا"}},{"id":"istahya-28-4-13","words":["verb:istahya"],"options":[{"bs":"i ostavlja u životu","en":"and he/it keeps alive"},{"bs":"i ostavljaju u životu","en":"and they keep alive"},{"bs":"i ostavite u životu!","en":"and (you all) keep alive!"},{"bs":"i ostavljamo u životu","en":"and we keep alive"}],"ref":"28:4","answerWord":"وَيَسْتَحْىِۦ","answerSound":"audio/4f3ea9d33cf2573a9f02.m4a","quranTranslation":{"text":"Lo! Pharaoh exalted himself in the earth and made its people castes. A tribe among them he oppressed, killing their sons and sparing their women. Lo! he was of those who work corruption.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stidjeti se","en":"to be ashamed, to be shy"},"passage":["إِنَّ","فِرْعَوْنَ","عَلَا","فِى","ٱلْأَرْضِ","وَجَعَلَ","أَهْلَهَا","شِيَعًا","يَسْتَضْعِفُ","طَآئِفَةً","مِّنْهُمْ","يُذَبِّحُ","أَبْنَآءَهُمْ","وَيَسْتَحْىِۦ","نِسَآءَهُمْ","إِنَّهُۥ","كَانَ","مِنَ","ٱلْمُفْسِدِينَ"],"marked":[13],"facts":{"verb":"اسْتَحْيَا"}},{"id":"istahya-40-25-11","words":["verb:istahya"],"options":[{"bs":"i ostavite u životu!","en":"and (you all) keep alive!"},{"bs":"i ostavlja u životu","en":"and he/it keeps alive"},{"bs":"i ostavljamo u životu","en":"and we keep alive"},{"bs":"i ostavljaju u životu","en":"and they keep alive"}],"ref":"40:25","answerWord":"وَٱسْتَحْيُوا۟","answerSound":"audio/2bd69401d56fbe248860.m4a","quranTranslation":{"text":"And when he brought them the Truth from Our presence, they said: Slay the sons of those who believe with him, and spare their women. But the plot of disbelievers is in naught but error.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stidjeti se","en":"to be ashamed, to be shy"},"passage":["فَلَمَّا","جَآءَهُم","بِٱلْحَقِّ","مِنْ","عِندِنَا","قَالُوا۟","ٱقْتُلُوٓا۟","أَبْنَآءَ","ٱلَّذِينَ","ءَامَنُوا۟","مَعَهُۥ","وَٱسْتَحْيُوا۟","نِسَآءَهُمْ","وَمَا","كَيْدُ","ٱلْكَٰفِرِينَ","إِلَّا","فِى","ضَلَٰلٍ"],"marked":[11],"facts":{"verb":"اسْتَحْيَا"}},{"id":"tasaddaqa-2-280-8","words":["verb:tasaddaqa"],"options":[{"bs":"udjeljujete sadaku","en":"you (all) give alms"},{"bs":"sigurno ćemo dijeliti sadaku","en":"we will surely give charity"},{"bs":"udijelio je sadaku","en":"he/it gave alms"},{"bs":"udjeljuju sadaku","en":"they give alms"}],"ref":"2:280","answerWord":"تَصَدَّقُوا۟","answerSound":"audio/fd6cd321d1e30426f687.m4a","quranTranslation":{"text":"And if the debtor is in straitened circumstances, then (let there be) postponement to (the time of) ease; and that ye remit the debt as almsgiving would be better for you if ye did but know.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati sadaku, udijeliti","en":"to give alms, to give charity"},"passage":["وَإِن","كَانَ","ذُو","عُسْرَةٍ","فَنَظِرَةٌ","إِلَىٰ","مَيْسَرَةٍ","وَأَن","تَصَدَّقُوا۟","خَيْرٌ","لَّكُمْ","إِن","كُنتُمْ","تَعْلَمُونَ"],"marked":[8],"facts":{"verb":"تَصَدَّقَ"}},{"id":"tasaddaqa-9-75-8","words":["verb:tasaddaqa"],"options":[{"bs":"sigurno ćemo dijeliti sadaku","en":"we will surely give charity"},{"bs":"udjeljujete sadaku","en":"you (all) give alms"},{"bs":"i udijeli sadaku!","en":"and give alms!"},{"bs":"udjeljuju sadaku","en":"they give alms"}],"ref":"9:75","answerWord":"لَنَصَّدَّقَنَّ","answerSound":"audio/b28c35016765ef02c27b.m4a","quranTranslation":{"text":"And of them is he who made a covenant with Allah (saying): If He give us of His bounty we will give alms and become of the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati sadaku, udijeliti","en":"to give alms, to give charity"},"passage":["وَمِنْهُم","مَّنْ","عَٰهَدَ","ٱللَّهَ","لَئِنْ","ءَاتَىٰنَا","مِن","فَضْلِهِۦ","لَنَصَّدَّقَنَّ","وَلَنَكُونَنَّ","مِنَ","ٱلصَّٰلِحِينَ"],"marked":[8],"facts":{"verb":"تَصَدَّقَ"}},{"id":"tasaddaqa-12-88-15","words":["verb:tasaddaqa"],"options":[{"bs":"i udijeli sadaku!","en":"and give alms!"},{"bs":"udjeljujete sadaku","en":"you (all) give alms"},{"bs":"sigurno ćemo dijeliti sadaku","en":"we will surely give charity"},{"bs":"udjeljuju sadaku","en":"they give alms"}],"ref":"12:88","answerWord":"وَتَصَدَّقْ","answerSound":"audio/0a35aac98f5611b3a782.m4a","quranTranslation":{"text":"And when they came (again) before him (Joseph) they said: O ruler! Misfortune hath touched us and our folk, and we bring but poor merchandise, so fill for us the measure and be charitable unto us. Lo! Allah will requite the charitable,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati sadaku, udijeliti","en":"to give alms, to give charity"},"passage":["فَلَمَّا","دَخَلُوا۟","عَلَيْهِ","قَالُوا۟","يَٰٓأَيُّهَا","ٱلْعَزِيزُ","مَسَّنَا","وَأَهْلَنَا","ٱلضُّرُّ","وَجِئْنَا","بِبِضَٰعَةٍ","مُّزْجَىٰةٍ","فَأَوْفِ","لَنَا","ٱلْكَيْلَ","وَتَصَدَّقْ","عَلَيْنَآ","إِنَّ","ٱللَّهَ","يَجْزِى","ٱلْمُتَصَدِّقِينَ"],"marked":[15],"facts":{"verb":"تَصَدَّقَ"}},{"id":"aqrada-57-11-3","words":["verb:aqrada"],"options":[{"bs":"daje zajam","en":"(he) lends"},{"bs":"posuđujete","en":"you (all) lend"},{"bs":"i posudili ste","en":"and you (all) lent"},{"bs":"i dali su zajam","en":"and (they) lent"}],"ref":"57:11","answerWord":"يُقْرِضُ","answerSound":"audio/3163efd0abbc228d188e.m4a","quranTranslation":{"text":"Who is he that will lend unto Allah a goodly loan, that He may double it for him and his may be a rich reward?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"posuditi (dati zajam)","en":"to lend"},"passage":["مَّن","ذَا","ٱلَّذِى","يُقْرِضُ","ٱللَّهَ","قَرْضًا","حَسَنًا","فَيُضَٰعِفَهُۥ","لَهُۥ","وَلَهُۥٓ","أَجْرٌ","كَرِيمٌ"],"marked":[3],"facts":{"verb":"أَقْرَضَ"}},{"id":"aqrada-57-18-3","words":["verb:aqrada"],"options":[{"bs":"i dali su zajam","en":"and (they) lent"},{"bs":"i posudite!","en":"and (you all) lend!"},{"bs":"i posudili ste","en":"and you (all) lent"},{"bs":"daje zajam","en":"(he) lends"}],"ref":"57:18","answerWord":"وَأَقْرَضُوا۟","answerSound":"audio/3a8729c7b6ff44a4dcc4.m4a","quranTranslation":{"text":"Lo! those who give alms, both men and women, and lend unto Allah a goodly loan, it will be doubled for them, and theirs will be a rich reward.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"posuditi (dati zajam)","en":"to lend"},"passage":["إِنَّ","ٱلْمُصَّدِّقِينَ","وَٱلْمُصَّدِّقَٰتِ","وَأَقْرَضُوا۟","ٱللَّهَ","قَرْضًا","حَسَنًا","يُضَٰعَفُ","لَهُمْ","وَلَهُمْ","أَجْرٌ","كَرِيمٌ"],"marked":[3],"facts":{"verb":"أَقْرَضَ"}},{"id":"aqrada-64-17-1","words":["verb:aqrada"],"options":[{"bs":"posuđujete","en":"you (all) lend"},{"bs":"i posudili ste","en":"and you (all) lent"},{"bs":"i posudite!","en":"and (you all) lend!"},{"bs":"daje zajam","en":"(he) lends"}],"ref":"64:17","answerWord":"تُقْرِضُوا۟","answerSound":"audio/5e8c7d541d87f1f59ac2.m4a","quranTranslation":{"text":"If ye lend unto Allah a goodly loan, He will double it for you and will forgive you, for Allah is Responsive, Clement,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"posuditi (dati zajam)","en":"to lend"},"passage":["إِن","تُقْرِضُوا۟","ٱللَّهَ","قَرْضًا","حَسَنًا","يُضَٰعِفْهُ","لَكُمْ","وَيَغْفِرْ","لَكُمْ","وَٱللَّهُ","شَكُورٌ","حَلِيمٌ"],"marked":[1],"facts":{"verb":"أَقْرَضَ"}}]