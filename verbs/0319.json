dio/b55d77e15837695f9dbd.m4a", "gloss": {"bs": "se klone", "en": "avoid", "tr": "kaçınırlar", "fr": "ils évitent", "id": "jauhilah", "ur": "وہ بچتے ہیں", "bn": "এড়িয়ে চলে", "fa": "دوری می‌کنند"}}, {"text": "كَبَٰٓئِرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْإِثْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْفَوَٰحِشَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "غَضِبُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "هُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَغْفِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "4:31", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/524.mp3", "translation": {"en": {"text": "If ye avoid the great (things) which ye are forbidden, We will remit from you your evil deeds and make you enter at a noble gate.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer siz, yasaklandığınız büyük günahlardan sakınırsanız, diğer kusurlarınızı örter, sizi güzel bir makama koyarız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اگر بچتے رہو کبیرہ گناہوں سے جن کی تمہیں ممانعت ہے تو تمہارے اور گناہ ہم بخش دیں گے اور تمہیں عزت کی جگہ داخل کریں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Jika kamu menjauhi dosa-dosa besar di antara dosa-dosa yang dilarang kamu mengerjakannya, niscaya Kami hapus kesalahan-kesalahanmu (dosa-dosamu yang kecil) dan Kami masukkan kamu ke tempat yang mulia (surga).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَجْتَنِبُوا۟", "hit": true, "audio": "audio/7cf4cf90331467000fce.m4a", "gloss": {"en": "you (all) avoid", "bs": "izbjegavate", "tr": "