{"rank": 502, "root": "نصح", "form": 1, "lemma": "نَصَحَ", "count": 5, "ayahCount": 5, "share": 0.03, "meaning": {"bs": "savjetovati, iskreno savjetovati", "en": "to advise, to counsel sincerely", "tr": "öğüt vermek, samimiyetle nasihat etmek", "fr": "conseiller, conseiller sincèrement", "id": "menasihati, menasihati dengan tulus", "ur": "نصیحت کرنا، خیرخواہی سے مشورہ دینا", "bn": "উপদেশ দেওয়া, আন্তরিকভাবে পরামর্শ দেওয়া", "fa": "پند دادن، خیرخواهانه نصیحت کردن"}, "lemmaSpoken": "audio/ca16a6668088e2058342.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "نَصَحَ", "plain": "نَصَحَ", "quran": false, "notUsed": false, "spoken": "audio/ca16a6668088e2058342.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَنْصَحُ", "plain": "يَنْصَحُ", "quran": false, "notUsed": false, "spoken": "audio/fcb6a09016e78f73bef2.m4a", "recited": null, "recitedText": null}], "nouns": {"participle": {"lemma": "ناصِح", "count": 6, "spoken": "audio/8d3e7df605c170c686eb.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "نَصَحْتُ", "plain": "نَصَحْتُ", "quran": true, "notUsed": false, "spoken": "audio/a18087c1f9e339686950.m4a", "recited": "audio/1b071c2fe86be32a9f2d.m4a", "recitedText": "وَنَصَحْتُ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "نَصَحْنَا", "plain": "نَصَحْنَا", "quran": false, "notUsed": false, "spoken": "audio/077432a59d2cbe6f4fed.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "نَصَحْتَ", "plain": "نَصَحْتَ", "quran": false, "notUsed": false, "spoken": "audio/4eb97a333e70393569fb.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "نَصَحْتِ", "plain": "نَصَحْتِ", "quran": false, "notUsed": false, "spoken": "audio/5d1a2d2739f459b5e055.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "نَصَحْتُمَا", "plain": "نَصَحْتُمَا", "quran": false, "notUsed": false, "spoken": "audi