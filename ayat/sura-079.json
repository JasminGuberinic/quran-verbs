{"ayat":[{"ref":"79:1","number":5713,"text":"وَٱلنَّٰزِعَٰتِ غَرْقًا","hits":[]},{"ref":"79:2","number":5714,"text":"وَٱلنَّٰشِطَٰتِ نَشْطًا","hits":[]},{"ref":"79:3","number":5715,"text":"وَٱلسَّٰبِحَٰتِ سَبْحًا","hits":[]},{"ref":"79:4","number":5716,"text":"فَٱلسَّٰبِقَٰتِ سَبْقًا","hits":[]},{"ref":"79:5","number":5717,"text":"فَٱلْمُدَبِّرَٰتِ أَمْرًا","hits":[1]},{"ref":"79:6","number":5718,"text":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","hits":[0]},{"ref":"79:7","number":5719,"text":"تَتْبَعُهَا ٱلرَّادِفَةُ","hits":[0]},{"ref":"79:8","number":5720,"text":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","hits":[0]},{"ref":"79:9","number":5721,"text":"أَبْصَٰرُهَا خَٰشِعَةٌ","hits":[0]},{"ref":"79:10","number":5722,"text":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","hits":[0,1,3]},{"ref":"79:11","number":5723,"text":"أَءِذَا كُنَّا عِظَٰمًا نَّخِرَةً","hits":[0,1,2]},{"ref":"79:12","number":5724,"text":"قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ","hits":[1,2]},{"ref":"79:13","number":5725,"text":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ","hits":[1]},{"ref":"79:14","number":5726,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ","hits":[1]},{"ref":"79:15","number":5727,"text":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","hits":[0,1,2]},{"ref":"79:16","number":5728,"text":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","hits":[0,1,2,3]},{"ref":"79:17","number":5729,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","hits":[0,1,4]},{"ref":"79:18","number":5730,"text":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","hits":[2,4,5]},{"ref":"79:19","number":5731,"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","hits":[0,3]},{"ref":"79:20","number":5732,"text":"فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ","hits":[0,1]},{"ref":"79:21","number":5733,"text":"فَكَذَّبَ وَعَصَىٰ","hits":[0,1]},{"ref":"79:22","number":5734,"text":"ثُمَّ أَدْبَرَ يَسْعَىٰ","hits":[0,1,2]},{"ref":"79:23","number":5735,"text":"فَحَشَرَ فَنَادَىٰ","hits":[0]},{"ref":"79:24","number":5736,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","hits":[1]},{"ref":"79:25","number":5737,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ","hits":[0]},{"ref":"79:26","number":5738,"text":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ","hits":[2,3,4]},{"ref":"79:27","number":5739,"text":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ بَنَىٰهَا","hits":[0,2,3,4,5]},{"ref":"79:28","number":5740,"text":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","hits":[0,2]},{"ref":"79:29","number":5741,"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","hits":[1,2,3]},{"ref":"79:30","number":5742,"text":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","hits":[0]},{"ref":"79:31","number":5743,"text":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","hits":[1,2]},{"ref":"79:32","number":5744,"text":"وَٱلْجِبَالَ أَرْسَىٰهَا","hits":[0]},{"ref":"79:33","number":5745,"text":"مَتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ","hits":[0,2]},{"ref":"79:34","number":5746,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","hits":[1]},{"ref":"79:35","number":5747,"text":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ","hits":[1,2,3]},{"ref":"79:36","number":5748,"text":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","hits":[3]},{"ref":"79:37","number":5749,"text":"فَأَمَّا مَن طَغَىٰ","hits":[0]},{"ref":"79:38","number":5750,"text":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","hits":[0,1]},{"ref":"79:39","number":5751,"text":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","hits":[3]},{"ref":"79:40","number":5752,"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","hits":[2,3,5,6,7]},{"ref":"79:41","number":5753,"text":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","hits":[1]},{"ref":"79:42","number":5754,"text":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","hits":[0,2,3]},{"ref":"79:43","number":5755,"text":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","hits":[1,3]},{"ref":"79:44","number":5756,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","hits":[]},{"ref":"79:45","number":5757,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","hits":[2]},{"ref":"79:46","number":5758,"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","hits":[0,3,4,5,7]}]}