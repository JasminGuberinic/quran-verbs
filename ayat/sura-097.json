{"ayat":[{"ref":"97:1","number":6126,"text":"إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ","hits":[0,1,2,3]},{"ref":"97:2","number":6127,"text":"وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ","hits":[0,1]},{"ref":"97:3","number":6128,"text":"لَيْلَةُ ٱلْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ","hits":[2,3,5]},{"ref":"97:4","number":6129,"text":"تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ","hits":[0,1,2,4,5,8]},{"ref":"97:5","number":6130,"text":"سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ","hits":[0,1,2,4]}]}