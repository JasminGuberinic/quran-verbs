 التَّاجِرُ الزَّبُونَ حَقَّهُ", "spoken": "audio/8eb08f4592188130701d.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Trgovac je zakinuo kupca.", "en": "The merchant cheated the customer of his due.", "bn": "ব্যবসায়ী ক্রেতাকে তার প্রাপ্য কম দিল।", "fa": "تاجر حق مشتری را کم داد.", "fr": "Le commerçant a lésé le client de son dû.", "id": "Pedagang itu merugikan pelanggan dari haknya.", "tr": "Tüccar müşterinin hakkını yedi.", "ur": "تاجر نے گاہک کا حق مارا۔"}, "independentlyReviewed": true, "words": [{"arabic": "بَخَسَ", "target": true, "translation": {"bs": "zakinuo je", "en": "cheated", "bn": "ঠকাল", "fa": "کم داد", "fr": "a lésé", "id": "merugikan", "tr": "hakkını yedi", "ur": "حق مارا"}}, {"arabic": "التَّاجِرُ", "target": false, "translation": {"bs": "trgovac", "en": "the merchant", "bn": "ব্যবসায়ী", "fa": "بازرگان", "fr": "le commerçant", "id": "pedagang itu", "tr": "tüccar", "ur": "تاجر"}}, {"arabic": "الزَّبُونَ", "target": false, "translation": {"bs": "kupca", "en": "the customer", "bn": "ক্রেতা", "fa": "مشتری", "fr": "le client", "id": "pelanggan", "tr": "müşteri", "ur": "گاہک"}}, {"arabic": "حَقَّهُ", "target": false, "translation": {"bs": "za njegovo pravo", "en": "his due", "bn": "তার প্রাপ্য", "fa": "حقش", "fr": "son dû", "id": "haknya", "tr": "hakkını", "ur": "اس کا حق"}}]}, {"arabic": "لَا يَبْخَسُ الْمُدِيرُ الْعُمَّالَ أُجُورَهُمْ", "spoken": "audio/adf4e578ae65b6b1500e.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Direktor ne zakida radnike u platama.", "en": "The manager does not cheat the workers of their wages.", "bn": "ম্যানেজার শ্রমিকদের মজুরি কম দেন না।", "fa": "مدیر دستمزد کارگران را کم نمی‌دهد.", "fr": "Le directeur ne lèse pas les ouvriers de leurs salaires.", "id": "Direktur tidak merugikan para pekerja dari upah mereka.", "tr": "Müdür işçilerin ücretini eksik vermez.", "ur": "مینیجر مزدوروں کی اجرتوں میں کمی نہیں کرتا۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "يَبْخَسُ", "target": true, "translation": {"bs": "zakida", "en": "cheats", "bn": "ঠকায়", "fa": "کم می‌دهد", "fr": "lèse", "id": "merugikan", "tr": "hakkını yer", "ur": "حق مارتا ہے"}}, {"arabic": "الْمُدِيرُ", "target": false, "translation": {"bs": "direktor", "en": "the manager", "bn": "পরিচালক", "fa": "مدیر", "fr": "le directeur", "id": "direktur itu", "tr": "müdür", "ur": "منیجر"}}, {"arabic": "الْعُمَّالَ", "target": false, "translation": {"bs": "radnike", "en": "the workers", "bn": "শ্রমিকদের", "fa": "کارگران را", "fr": "les ouvriers", "id": "para pekerja", "tr": "işçiler", "ur": "مزدوروں کو"}}, {"arabic": "أُجُورَهُمْ", "target": false, "translation": {"bs": "u platama", "en": "their wages", "bn": "তাদের মজুরি", "fa": "دستمزدشان", "fr": "leurs salaires", "id": "upah mereka", "tr": "ücretleri", "ur": "ان کی اجرتیں"}}]}, {"arabic": "لَا أَبْخَسُ أَحَدًا حَقَّهُ", "spoken": "audio/5a98180555ed4900e3fa.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Ne zakidam nikoga.", "en": "I do not cheat anyone of his due.", "bn": "আমি কারও প্রাপ্য কম দিই না।", "fa": "من حق هیچ‌کس را کم نمی‌دهم.", "fr": "Je ne lèse personne de son dû.", "id": "Aku tidak merugikan siapa pun dari haknya.", "tr": "Ben kimsenin hakkını yemem.", "ur": "میں کسی کا حق نہیں مارتا۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "أَبْخَسُ", "target": true, "translation": {"bs": "zakidam", "en": "I cheat", "bn": "আমি ঠকাই", "fa": "من کم می‌دهم", "fr": "je lèse", "id": "aku merugikan", "tr": "hakkını yerim", "ur": "میں حق مارتا ہوں"}}, {"arabic": "أَحَدًا", "target": false, "translation": {"bs": "nikoga", "en": "any one", "bn": "কাউকে", "fa": "کسی را", "fr": "quiconque", "id": "siapa pun", "tr": "hiç kimse", "ur": "کسی کو"}}, {"arabic": "حَقَّهُ", "target": false, "translation": {"bs": "za njegovo pravo", "en": "his due", "bn": "তার প্রাপ্য", "fa": "حقش", "fr": "son dû", "id": "haknya", "tr": "hakkını", "ur": "اس کا حق"}}]}, {"arabic": "بَخَسُوا الْعَامِلَ أَجْرَهُ", "spoken": "audio/477a4ee3abece0ce43f1.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Zakinuli su radnika za platu.", "en": "They cheated the worker of his wage.", "bn": "তারা শ্রমিকের মজুরি কম দিল।", "fa": "آنان دستمزد کارگر را کم دادند.", "fr": "Ils ont lésé l'ouvrier de son salaire.", "id": "Mereka merugikan pekerja dari upahnya.", "tr": "İşçinin ücretini yediler.", "ur": "انہوں نے مزدور کی اجرت میں کمی کی۔"}, "independentlyReviewed": true, "words": [{"arabic": "بَخَسُوا", "target": true, "translation": {"bs": "zakinuli su", "en": "they cheated", "bn": "তারা ঠকাল", "fa": "آنان کم دادند", "fr": "ils ont lésé", "id": "mereka merugikan", "tr": "hakkını yediler", "ur": "انہوں نے حق مارا"}}, {"arabic": "الْعَامِلَ", "target": false, "translation": {"bs": "radnika", "en": "the worker", "bn": "শ্রমিক", "fa": "کارگر", "fr": "l'ouvrier", "id": "pekerja", "tr": "işçi", "ur": "مزدور"}}, {"arabic": "أَجْرَهُ", "target": false, "translation": {"bs": "za platu", "en": "his wage", "bn": "তার মজুরি", "fa": "دستمزدش", "fr": "son salaire", "id": "upahnya", "tr": "ücreti", "ur": "اس کی اجرت"}}]}]}