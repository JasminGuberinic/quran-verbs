{"ayat":[{"ref":"56:1","number":4980,"text":"إِذَا وَقَعَتِ ٱلْوَاقِعَةُ","hits":[0,1]},{"ref":"56:2","number":4981,"text":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ","hits":[0,2]},{"ref":"56:3","number":4982,"text":"خَافِضَةٌ رَّافِعَةٌ","hits":[]},{"ref":"56:4","number":4983,"text":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا","hits":[2]},{"ref":"56:5","number":4984,"text":"وَبُسَّتِ ٱلْجِبَالُ بَسًّا","hits":[1]},{"ref":"56:6","number":4985,"text":"فَكَانَتْ هَبَآءً مُّنۢبَثًّا","hits":[0]},{"ref":"56:7","number":4986,"text":"وَكُنتُمْ أَزْوَٰجًا ثَلَٰثَةً","hits":[1]},{"ref":"56:8","number":4987,"text":"فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ","hits":[0,2]},{"ref":"56:9","number":4988,"text":"وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","hits":[]},{"ref":"56:10","number":4989,"text":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ","hits":[]},{"ref":"56:11","number":4990,"text":"أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ","hits":[0]},{"ref":"56:12","number":4991,"text":"فِى جَنَّٰتِ ٱلنَّعِيمِ","hits":[0,1,2]},{"ref":"56:13","number":4992,"text":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ","hits":[0,1]},{"ref":"56:14","number":4993,"text":"وَقَلِيلٌ مِّنَ ٱلْءَاخِرِينَ","hits":[0]},{"ref":"56:15","number":4994,"text":"عَلَىٰ سُرُرٍ مَّوْضُونَةٍ","hits":[0]},{"ref":"56:16","number":4995,"text":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ","hits":[]},{"ref":"56:17","number":4996,"text":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ","hits":[0,2]},{"ref":"56:18","number":4997,"text":"بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ","hits":[0,2]},{"ref":"56:19","number":4998,"text":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","hits":[0,2]},{"ref":"56:20","number":4999,"text":"وَفَٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ","hits":[0]},{"ref":"56:21","number":5000,"text":"وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ","hits":[0,1,3]},{"ref":"56:22","number":5001,"text":"وَحُورٌ عِينٌ","hits":[]},{"ref":"56:23","number":5002,"text":"كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","hits":[0,1,2]},{"ref":"56:24","number":5003,"text":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","hits":[0,3]},{"ref":"56:25","number":5004,"text":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا","hits":[1,3]},{"ref":"56:26","number":5005,"text":"إِلَّا قِيلًا سَلَٰمًا سَلَٰمًا","hits":[0,2]},{"ref":"56:27","number":5006,"text":"وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ","hits":[1]},{"ref":"56:28","number":5007,"text":"فِى سِدْرٍ مَّخْضُودٍ","hits":[1]},{"ref":"56:29","number":5008,"text":"وَطَلْحٍ مَّنضُودٍ","hits":[]},{"ref":"56:30","number":5009,"text":"وَظِلٍّ مَّمْدُودٍ","hits":[0]},{"ref":"56:31","number":5010,"text":"وَمَآءٍ مَّسْكُوبٍ","hits":[0]},{"ref":"56:32","number":5011,"text":"وَفَٰكِهَةٍ كَثِيرَةٍ","hits":[]},{"ref":"56:33","number":5012,"text":"لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ","hits":[]},{"ref":"56:34","number":5013,"text":"وَفُرُشٍ مَّرْفُوعَةٍ","hits":[0]},{"ref":"56:35","number":5014,"text":"إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءً","hits":[0,1]},{"ref":"56:36","number":5015,"text":"فَجَعَلْنَٰهُنَّ أَبْكَارًا","hits":[0]},{"ref":"56:37","number":5016,"text":"عُرُبًا أَتْرَابًا","hits":[]},{"ref":"56:38","number":5017,"text":"لِّأَصْحَٰبِ ٱلْيَمِينِ","hits":[]},{"ref":"56:39","number":5018,"text":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ","hits":[]},{"ref":"56:40","number":5019,"text":"وَثُلَّةٌ مِّنَ ٱلْءَاخِرِينَ","hits":[]},{"ref":"56:41","number":5020,"text":"وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ","hits":[]},{"ref":"56:42","number":5021,"text":"فِى سَمُومٍ وَحَمِيمٍ","hits":[]},{"ref":"56:43","number":5022,"text":"وَظِلٍّ مِّن يَحْمُومٍ","hits":[]},{"ref":"56:44","number":5023,"text":"لَّا بَارِدٍ وَلَا كَرِيمٍ","hits":[3]},{"ref":"56:45","number":5024,"text":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ","hits":[3]},{"ref":"56:46","number":5025,"text":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ","hits":[1,4]},{"ref":"56:47","number":5026,"text":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ","hits":[1,3,5,6]},{"ref":"56:48","number":5027,"text":"أَوَءَابَآؤُنَ