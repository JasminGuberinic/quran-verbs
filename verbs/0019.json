"pronoun": "anta", "arabic": "تُرِيدُ", "plain": "تُرِيدُ", "quran": true, "notUsed": false, "spoken": "audio/e020912feba968bb1506.m4a", "recited": "audio/ecc5caa9da8921b86581.m4a", "recitedText": "تُرِيدُ"}, {"tense": "present", "pronoun": "anti", "arabic": "تُرِيدِينَ", "plain": "تُرِيدِينَ", "quran": false, "notUsed": false, "spoken": "audio/6edaf22cd16717d25a09.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تُرِيدَانِ", "plain": "تُرِيدَانِ", "quran": false, "notUsed": false, "spoken": "audio/544e44a159a189ac949f.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تُرِيدُونَ", "plain": "تُرِيدُونَ", "quran": true, "notUsed": false, "spoken": "audio/2163b6ef4fc969ff4783.m4a", "recited": "audio/93c40ed41d714a6e8094.m4a", "recitedText": "تُرِيدُونَ"}, {"tense": "present", "pronoun": "antunna", "arabic": "تُرِدْنَ", "plain": "تُرِدْنَ", "quran": true, "notUsed": false, "spoken": "audio/b80d926bc2f2aafed3a4.m4a", "recited": "audio/758f4c0a00276ed05d4e.m4a", "recitedText": "تُرِدْنَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُرِيدُ", "plain": "يُرِيدُ", "quran": true, "notUsed": false, "spoken": "audio/1e18ac17adafafc391b3.m4a", "recited": "audio/8edc0144f4c589eefcee.m4a", "recitedText": "يُرِيدُ"}, {"tense": "present", "pronoun": "hiya", "arabic": "تُرِيدُ", "plain": "تُرِيدُ", "quran": false, "notUsed": false, "spoken": "audio/e020912feba968bb1506.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يُرِيدَانِ", "plain": "يُرِيدَانِ", "quran": false, "notUsed": false, "spoken": "audio/46c3326d7241efb6a3fb.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يُرِيدُونَ", "plain": "يُرِيدُونَ", "quran": true, "notUsed": false, "spoken": "audio/5230018c0061e8104b8f.m4a", "recited": "audio/64acf5e36a9a68a1003a.m4a", "recitedText": "يُرِيدُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يُرِدْنَ", "plain": "يُرِدْنَ", "quran": false, "notUsed": false, "spoken": "audio/7fa0855055244ecc2e20.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَرِدْ", "plain": "أَرِدْ", "quran": false, "notUsed": false, "spoken": "audio/d6fbb4f3e5dc553e3bff.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَرِيدِي", "plain": "أَرِيدِي", "quran": false, "notUsed": false, "spoken": "audio/a87594b86f3d47ee09e3.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَرِيدَا", "plain": "أَرِيدَا", "quran": false, "notUsed": false, "spoken": "audio/f2527e1bab9d3064b49e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَرِيدُوا", "plain": "أَرِيدُوا", "quran": false, "notUsed": false, "spoken": "audio/735ef2a8dec578a88dde.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَرِدْنَ", "plain": "أَرِدْنَ", "quran": false, "notUsed": false, "spoken": "audio/742abef6bb04ee4cb906.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "85:16", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5925.mp3", "translation": {"en": {"text": "Doer of what He will.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Dilediğini yapandır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہمیشہ جو چاہے کہ لینے والا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maha Kuasa berbuat apa yang dikehendaki-Nya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَعَّالٌ", "hit": false, "audio": null, "gloss": null}, {"text": "لِّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُرِيدُ", "hit": true, "audio": "audio/8edc0144f4c589eefcee.m4a", "gloss": {"bs": "hoće", "en": "He wills", "tr": "diler", "fr": "Il veut", "id": "Dia kehendaki", "ur": "چاہے", "bn": "তিনি ইচ্ছা করেন", "fa": "می‌خواهد"}}]}, {"ref": "17:103", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2132.mp3", "translation": {"en": {"text": "And he wished to scare them from the land, but We drowned him and those with him, all together.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Derken Firavun, Musa'yı ve İsrailoğullarını Mısır'dan sürmek istedi. Biz de onu ve beraberindekilerin hepsini suda boğduk.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اس نے چاہا کہ ان کو زمین سے نکال دے تو ہم نے اسے اور اس کے ساتھیوں کو سب کو ڈبو دیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian (Fir'aun) hendak mengusir mereka (Musa dan pengikut-pengikutnya) dari bumi (Mesir) itu, maka Kami tenggelamkan dia (Fir'aun) serta orang-orang yang bersama-sama dia seluruhnya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَرَادَ", "hit": true, "audio": "audio/4a5126fbb4662b9ab430.m4a", "gloss": {"en": "so he/it wanted", "bs": "pa je htio", "tr": "böylece istedi", "fr": "alors il a voulu", "id": "maka dia telah menghendaki", "ur": "پس اُس نے چاہا", "bn": "অতঃপর সে চাইল", "fa": "پس خواست"}}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَفِزَّهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَغْرَقْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "مَّعَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "جَمِيعًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "52:42", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4777.mp3", "translation": {"en": {"text": "Or seek they to ensnare (the messenger)? But those who disbelieve, they are the ensnared!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yoksa bir tuzak mı kurmak istiyorlar? Fakat o küfredenlerin kendileri tuzağa düşeceklerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا کسی داؤ ں (فریب) کے ارادہ میں ہیں تو کافروں پر ہی داؤں (فریب) پڑنا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ataukah mereka hendak melakukan tipu daya? Maka orang-orang yang kafir itu merekalah yang kena tipu daya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُرِيدُونَ", "hit": true, "audio": "audio/52394ee785feb40ff351.m4a", "gloss": {"en": "they want", "bs": "hoće", "tr": "isterler", "fr": "ils veulent", "id": "mereka menghendaki", "ur": "وہ چاہتے ہیں", "bn": "তারা চায়", "fa": "می‌خواهند"}}, {"text": "كَيْدًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "هُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَكِيدُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:86", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3874.mp3", "translation": {"en": {"text": "Is it a falsehood - gods beside Allah - that ye desire?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Yalancılık etmek için mi Allah'tan başka ilâhlar istiyorsunuz?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا بہتان سے اللہ کے سوا اور خدا چاہتے ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apakah kamu menghendaki sembahan-sembahan selain Allah dengan jalan berbohong?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَئِفْكًا", "hit": false, "audio": null, "gloss": null}, {"text": "ءَالِهَةً", "hit": false, "audio": null, "gloss": null}, {"text": "دُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "تُرِيدُونَ", "hit": true, "audio": "audio/98d7b555f414ab14ac7d.m4a", "gloss": {"en": "you (all) want", "bs": "hoćete", "tr": "istersiniz", "fr": "vous voulez", "id": "kalian menghendaki", "ur": "تم سب چاہتے ہو", "bn": "তোমরা চাও", "fa": "می‌خواهید"}}]}, {"ref": "51:57", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4732.mp3", "translation": {"en": {"text": "I seek no livelihood from them, nor do I ask that they should feed Me.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ben onlardan herhangi bir rızık istemiyorum. Beni yedirmelerini de istemiyorum.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "میں ان سے کچھ رزق نہیں مانگتا اور نہ یہ چاہتا ہوں کہ وہ مجھے کھانا دیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Aku tidak menghendaki rezeki sedikitpun dari mereka dan Aku tidak menghendaki supaya mereka memberi-Ku makan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أُرِيدُ", "hit": true, "audio": "audio/cdbc59e082065aa9978b.m4a", "gloss": {"en": "I want", "bs": "hoću", "tr": "isterim", "fr": "je veux", "id": "aku menghendaki", "ur": "میں چاہتا ہوں", "bn": "আমি চাই", "fa": "می‌خواهم"}}, {"text": "مِنْهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "رِّزْقٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أُرِيدُ", "hit": true, "audio": "audio/effa6291e8c16f8e2bc1.m4a", "gloss": {"en": "I want", "bs": "hoću", "tr": "isterim", "fr": "je veux", "id": "aku menghendaki", "ur": "میں چاہتا ہوں", "bn": "আমি চাই", "fa": "می‌خواهم"}}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يُطْعِمُونِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:70", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2553.mp3", "translation": {"en": {"text": "And they wished to set a snare for him, but We made them the greater losers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ona düzen kurmak istediler, fakat biz kendilerini daha fazla hüsrana uğrattık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور انہوں نے اس کا برا چاہا تو ہم نے انہیں سب سے بڑھ کر زیاں کار کردیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka hendak berbuat makar terhadap Ibrahim, maka Kami menjadikan mereka itu orang-orang yang paling merugi.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَرَادُوا۟", "hit": true, "audio": "audio/b72572e805c3cdd5c68e.m4a", "gloss": {"bs": "i htjeli su", "en": "and they wanted", "tr": "ve istediler", "fr": "et ils voulurent", "id": "dan mereka hendak", "ur": "اور انہوں نے چاہا", "bn": "এবং তারা চেয়েছিল", "fa": "و خواستند"}}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "كَيْدًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَجَعَلْنَٰهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَخْسَرِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُرِيدُ", "count": 38, "first": "2:185", "audio": "audio/8edc0144f4c589eefcee.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "p