t": false, "audio": null, "gloss": null}, {"text": "بِـَٔايَٰتِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَمَسُّهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَذَابُ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَفْسُقُونَ", "hit": true, "audio": "audio/da105de57c9803e94de7.m4a", "gloss": {"bs": "su griješili", "en": "they used to transgress", "tr": "haddi aşıyorlardı", "fr": "ils étaient pervers", "id": "mereka dahulu melampaui batas", "ur": "وہ نافرمانی کرتے تھے", "bn": "তারা পাপ করত", "fa": "نافرمانی می‌کردند"}}]}, {"ref": "10:33", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1397.mp3", "translation": {"en": {"text": "Thus is the Word of thy Lord justified concerning those who do wrong: that they believe not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hak dinden çıkmış fasıklara Rabbinin kelimesi şöyle gerçekleşti: Onlar artık imana gelmezler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یونہی ثابت ہوچکی ہے تیرے رب کی بات فاسقوں پر تو وہ ایمان نہیں لائیں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Demikianlah telah tetap hukuman Tuhanmu terhadap orang-orang yang fasik, karena sesungguhnya mereka tidak beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "حَقَّتْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَلِمَتُ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَسَقُوٓا۟", "hit": true, "audio": "au