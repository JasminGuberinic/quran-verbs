amaz.", "en": "Call the adhan for the prayer.", "bn": "নামাযের জন্য আযান দাও।", "fa": "برای نماز اذان بگو.", "fr": "Fais l'appel à la prière.", "id": "Kumandangkanlah azan untuk salat.", "tr": "Namaz için ezan oku.", "ur": "نماز کے لیے اذان دو۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَذِّنْ", "target": true, "translation": {"bs": "prouči ezan", "en": "call the adhan", "bn": "আযান দাও", "fa": "اذان بگو", "fr": "fais l'appel à la prière", "id": "kumandangkanlah azan", "tr": "ezan oku", "ur": "اذان دو"}}, {"arabic": "لِلصَّلَاةِ", "target": false, "translation": {"bs": "za namaz", "en": "for the prayer", "bn": "নামাযের জন্য", "fa": "برای نماز", "fr": "pour la prière", "id": "untuk salat", "tr": "namaz için", "ur": "نماز کے لیے"}}]}]}