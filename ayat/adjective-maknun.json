{"ayat":[{"ref":"37:49","number":3837,"text":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ","hits":[2]},{"ref":"52:24","number":4759,"text":"وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌ لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٌ مَّكْنُونٌ","hits":[6]},{"ref":"56:23","number":5002,"text":"كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","hits":[2]},{"ref":"56:78","number":5057,"text":"فِى كِتَٰبٍ مَّكْنُونٍ","hits":[2]}]}