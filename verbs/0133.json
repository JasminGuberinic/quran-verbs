ll}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِعْصِ", "plain": "اِعْصِ", "quran": false, "notUsed": false, "spoken": "audio/ef349bac1ff99b4ffae8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِعْصِي", "plain": "اِعْصِي", "quran": false, "notUsed": false, "spoken": "audio/f5b76630f0d21dc555df.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِعْصِيَا", "plain": "اِعْصِيَا", "quran": false, "notUsed": false, "spoken": "audio/37543e17f5100ecd2ec0.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِعْصُوا", "plain": "اِعْصُوا", "quran": false, "notUsed": false, "spoken": "audio/13c35e959688a2214d0f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِعْصِينَ", "plain": "اِعْصِينَ", "quran": false, "notUsed": false, "spoken": "audio/957aec7ac3b940b87cd5.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "69:10", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5333.mp3", "translation": {"en": {"text": "And they disobeyed the messenger of their Lord, therefor did He grip them with a tightening grip.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hep Rablerinin elçilerine karşı geldiler. O da onları pek şiddetli bir şekilde yakalayıverdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو انہوں نے اپنے رب کے رسولوں کا حکم نہ مانا تو اس نے انہیں بڑھی چڑھی گرفت سے پکڑا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka (masing-masing) mereka mendurhakai rasul Tuhan mereka, lalu Allah menyiksa mereka dengan siksaan yang sangat keras.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَعَصَوْا۟", "hit": true, "audio": "audio/3c659f0c5c3f9e02219f.m4a", "gloss": {"en": "so they disobeyed", "bs": "pa nisu poslušali", "tr": "böylece itaat etmediler", "fr": "alors ils n'ont pas obéi", "id": "maka mereka tidak taat", "ur": "پس انہوں نے نافرمانی کی", "bn": "অতএব তারা অবাধ্য হলো", "fa": "پس نافرمانی کردند"}}, {"text": "رَسُولَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَخَذَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخْذَةً", "hit": false, "audio": null, "gloss": null}, {"text": "رَّابِيَةً", "hit": false, "audio": null, "gloss": null}]}, {"ref": "6:15", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/804.mp3", "translation": {"en": {"text": "Say: I fear, if I rebel against my Lord, the retribution of an Awful Day.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki: \"Eğer Rabbime isyan edersem, büyük bir günün azabından korkarım\".", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ اگر میں اپنے رب کی نافرمانی کروں تو مجھے بڑے دن کے عذاب کا ڈر ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah: \"Sesungguhnya aku takut akan azab hari yang besar (hari kiamat), jika aku mendurhakai Tuhanku\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنِّىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخَافُ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَصَيْتُ", "hit": true, "audio": "audio/a0571f4c8fb88959169c.m4a", "gloss": {"en": "I disobeyed", "bs": "nisam poslušao", "tr": "itaat etmedim", "fr": "je n'ai pas obéi", "id": "aku tidak taat", "ur": "میں نے نافرمانی کی", "bn": "আমি অবাধ্য হয়েছি", "fa": "نافرمانی کردم"}}, {"text": "رَبِّى", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "عَظِيمٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "73:16", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5491.mp3", "translation": {"en": {"text": "But Pharaoh rebelled against the messenger, whereupon We seized him with no gentle grip.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Firavun o elçiye isyan etmişti. Biz de onu ağır bir yakalayışla yakaladık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو فرعون نے اس رسول کا حکم نہ مانا تو ہم نے اسے سخت گرفت سے پکڑا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Fir'aun mendurhakai Rasul itu, lalu Kami siksa dia dengan siksaan yang berat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَعَصَىٰ", "hit": true, "audio": "audio/f6fd188e38927b67aece.m4a", "gloss": {"en": "so he/it disobeyed", "bs": "pa nije poslušao", "tr": "böylece itaat etmedi", "fr": "alors il n'a pas obéi", "id": "maka dia tidak taat", "ur": "پس اُس نے نافرمانی کی", "bn": "অতএব সে অবাধ্য হলো", "fa": "پس نافرمانی کرد"}}, {"text": "فِرْعَوْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّسُولَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَخَذْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخْذًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَبِيلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:93", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2441.mp3", "translation": {"en": {"text": "That thou followedst me not? Hast thou then disobeyed my order?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"(Neden) benim yolumu takip etmedin, benim emrime karşı mı geldin?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو کیا تم نے میرا حکم نہ مانا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(sehingga) kamu tidak mengikuti aku? Maka apakah kamu telah (sengaja) mendurhakai perintahku?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تَتَّبِعَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَفَعَصَيْتَ", "hit": true, "audio": "audio/bcb869e88711cec6b11b.m4a", "gloss": {"bs": "zar si onda ne poslušao", "en": "so did you disobey", "tr": "yoksa isyan mı ettin", "fr": "as-tu donc désobéi", "id": "maka apakah kamu durhaka", "ur": "کیا تم نے نافرمانی کی", "bn": "তাহলে কি তুমি অবাধ্য হয়েছ", "fa": "آیا پس نافرمانی کردی"}}, {"text": "أَمْرِى", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:69", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2209.mp3", "translation": {"en": {"text": "He said: Allah willing, thou shalt find me patient and I shall not in aught gainsay thee.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa: \"İnşaallah beni sabırlı bulacaksın ve senin hiçbir işine karşı gelmeyeceğim\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہا عنقریب اللہ چاہے تو تم مجھے صابر پاؤ گے اور میں تمہارے کسی حکم کے خلاف نہ کروں گا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Musa berkata: \"Insya Allah kamu akan mendapati aku sebagai orang yang sabar, dan aku tidak akan menentangmu dalam sesuatu urusanpun\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَتَجِدُنِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "شَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "صَابِرًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْصِى", "hit": true, "audio": "audio/d276aeea6a4827b5a43b.m4a", "gloss": {"bs": "oglušim se", "en": "I disobey", "tr": "isyan edersem", "fr": "je désobéis", "id": "aku durhaka", "ur": "میں نافرمانی کروں", "bn": "আমি অবাধ্য হই", "fa": "نافرمانی می‌کنم"}}, {"text": "لَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْرًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "عَصَوا۟", "count": 3, "first": "2:61", "audio": "audio/3a3f035e427521fd1308.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they disobeyed", "bs": "nisu poslušali", "tr": "itaat etmediler", "fr": "ils ont désobéi", "id": "mereka tidak taat", "ur": "انہوں نے نافرمانی کی", "bn": "তারা অবাধ্য হলো", "fa": "نافرمانی کردند"}}, {"arabic": "يَعْصِ", "count": 3, "first": "4:14", "audio": "audio/9499f68d3144bda67d2e.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "he/it disobeys", "bs": "ne sluša", "tr": "itaat etmez", "fr": "il désobéit", "id": "dia tidak taat", "ur": "وہ نافرمانی کرتا ہے", "bn": "সে অবাধ্য হয়", "fa": "نافرمانی کند"}}, {"arabic": "عَصَيْتُ", "count": 3, "first": "6:15", "audio": "audio/a0571f4c8fb88959169c.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": false, "objects": []}], "gloss": {"en": "I disobeyed", "bs": "nisam poslušao", "tr": "itaat etmedim", "fr": "je n'ai pas obéi", "id": "aku tidak taat", "ur": "میں نے نافرمانی کی", "bn": "আমি অবাধ্য হয়েছি", "fa": "نافرمانی کردم"}}, {"arabic": "وَعَصَيْنَا", "count": 2, "first": "2:93", "audio": "audio/9353fdb2c0cac1ebb61c.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "and we disobeyed", "bs": "i nismo poslušali", "tr": "ve itaat etmedik", "fr": "et nous n'avons pas obéi", "id": "dan kami tidak taat", "ur": "اور ہم نے نافرمانی کی", "bn": "এবং আমরা অবাধ্য হয়েছি", "fa": "و نافرمانی کردیم"}}, {"arabic": "وَعَصَيْتُم", "count": 1, "first": "3:152", "audio": "audio/1322f7992fbbcdf8a40c.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and you (all) disobeyed", "bs": "i niste poslušali", "tr": "ve itaat etmediniz", "fr": "et vous n'avez pas obéi", "id": "dan kalian tidak taat", "ur": "اور تم نے نافرمانی کی", "bn": "এবং তোমরা অবাধ্য হয়েছ", "fa": "و نافرمانی کردید"}}, {"arabic": "وَعَصَوُا۟", "count": 1, "first": "4:42", "audio": "audio/0968374f369d4d0a915f.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "and they disobeyed", "bs": "i nisu poslušali", "tr": "ve itaat etmediler", "fr": "et ils n'ont pas obéi", "id": "dan mereka tidak taat", "ur": "اور انہوں نے نافرمانی کی", "bn": "এবং তারা অবাধ্য হলো", "fa": "و نافرمانی کردند"}}, {"arabic": "عَصَيْتَ", "count": 1, "first": "10:91", "audio": "audio/e6b7b16622fcaecbba47.m4a", "grammar": [{"tense": "past", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "you disobeyed", "bs": "nisi poslušao", "tr": "itaat etmedin", "fr": "tu n'as pas obéi", "id": "kamu tidak taat", "ur": "تم نے نافرمانی کی", "bn": "তুমি অবাধ্য হয়েছ", "fa": "نافرمانی کردی"}}, {"arabic": "وَعَصَوْا۟", "count": 1, "first": "11:59", "audio": "audio/08b7025d2f0c2c58f7bb.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "and they disobeyed", "bs": "i nisu poslušali", "tr": "ve itaat etmediler", "fr": "et ils n'ont pas obéi", "id": "dan mereka tidak taat", "ur": "اور انہوں نے نافرمانی کی", "bn": "এবং তারা অবাধ্য হলো", "fa": "و نافرمانی کردند"}}, {"arabic": "عَصَيْتُهُۥ", "count": 