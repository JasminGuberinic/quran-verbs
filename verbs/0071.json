{"rank": 71, "root": "فري", "form": 8, "lemma": "افْتَرَى", "count": 50, "ayahCount": 46, "share": 0.26, "meaning": {"bs": "izmisliti laž", "en": "to fabricate, to invent a lie", "tr": "iftira etmek, yalan uydurmak", "fr": "inventer, forger un mensonge", "id": "mengada-adakan, membuat kedustaan", "ur": "جھوٹ گھڑنا، بہتان باندھنا", "bn": "মিথ্যা রচনা করা, মিথ্যা উদ্ভাবন করা", "fa": "افترا بستن، دروغ ساختن"}, "lemmaSpoken": "audio/e7e857d76ba1e3d70e05.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "ٱفْتَرَىٰ", "plain": "اِفْتَرَى", "quran": true, "notUsed": false, "spoken": "audio/e7e857d76ba1e3d70e05.m4a", "recited": "audio/a40b825a14e57d0e0fea.m4a", "recitedText": "ٱفْتَرَىٰ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَفْتَرِى", "plain": "يَفْتَرِي", "quran": true, "notUsed": false, "spoken": "audio/cd7bbf55b0df9aabc29a.m4a", "recited": "audio/8130d4a93d2f4e9cc869.m4a", "recitedText": "يَفْتَرِى"}], "nouns": {"verbal_noun": {"lemma": "افْتِراء", "count": 2, "spoken": "audio/b6b1ad116a3fba97b25f.m4a"}, "participle": {"lemma": "مُفْتَري", "count": 2, "spoken": "audio/227ff23519a2e98d8757.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "اِفْتَرَيْتُ", "plain": "اِفْتَرَيْتُ", "quran": false, "notUsed": false, "spoken": "audio/ab045d926332b12cd16e.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "ٱفْتَرَيْنَا", "plain": "اِفْتَرَيْنَا", "quran": true, "notUsed": false, "spoken": "audio/94f0dce49848400bde0f.m4a", "recited": "audio/49dc9ad0b423b3bc57ac.m4a", "recitedText": "ٱفْتَرَيْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "اِفْتَرَيْتَ", "plain": "اِفْتَرَيْتَ", "quran": false, "notUsed": false, "spoken": "audio/0154d374045d7f27b0a9.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "اِفْتَرَيْتِ", "plain": "اِفْتَرَيْتِ", "quran": false, "notUsed": false, "spoken": "audio/35c8eccb64cb663c2ef5.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "اِفْتَرَيْتُمَا", "plain": "اِفْتَرَيْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/25ebef3701307ec40df7.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "اِفْتَرَيْتُمْ", "plain": "اِفْتَرَيْتُمْ", "quran": false, "notUsed": false, "spoken": "audio/f316de1d3c53ca9fbef3.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antunna", "arabic": "اِفْتَرَيْتُنَّ", "plain": "اِفْتَرَيْتُنَّ", "quran": false, "notUsed": false, "spoken": "audio/ac769aa0046f289de476.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huwa", "arabic": "ٱفْتَرَىٰ", "plain": "اِفْتَرَى", "quran": true, "notUsed": false, "spoken": "audio/e7e857d76ba1e3d70e05.m4a", "recited": "audio/a40b825a14e57d0e0fea.m4a", "recitedText": "ٱفْتَرَىٰ"}, {"tense": "past", "pronoun": "hiya", "arabic": "اِفْتَرَتْ", "plain": "اِفْتَرَتْ", "quran": false, "notUsed": false, "spoken": "audio/3ec3b98061fbbe637978.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huma", "arabic": "اِفْتَرَيَا", "plain": "اِفْتَرَيَا", "quran": false, "notUsed": false, "spoken": "audio/e85b3758819292f17264.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hum", "arabic": "اِفْتَرَوْا", "plain": "اِفْتَرَوْا", "quran": false, "notUsed": false, "spoken": "audio/a545066a0b1eaf0ac38f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hunna", "arabic": "اِفْتَرَيْنَ", "plain": "اِفْتَرَيْنَ", "quran": false, "notUsed": false, "spoken": "audio/1944f358afa75169693b.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "ana", "arabic": "أَفْتَرِي", "plain": "أَفْتَرِي", "quran": false, "notUsed": false, "spoken": "audio/20689b0dde934762e772.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "nahnu", "arabic": "نَفْتَرِي", "plain": "نَفْتَرِي", "quran": false, "notU