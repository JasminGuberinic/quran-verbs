": {"bs": "nakon", "en": "after", "bn": "পরে", "fa": "بعد از", "fr": "après", "id": "setelah", "tr": "sonra", "ur": "کے بعد"}}, {"arabic": "الرِّيَاضَةِ", "target": false, "translation": {"bs": "sporta", "en": "sport", "bn": "খেলাধুলা", "fa": "ورزش", "fr": "du sport", "id": "olahraga", "tr": "spor", "ur": "کھیل"}}]}, {"arabic": "بَدَّلُوا عَجَلَةَ السَّيَّارَةِ", "spoken": "audio/d72dbfa38f4af02cb596.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Zamijenili su točak na autu.", "en": "They changed the car wheel.", "bn": "তারা গাড়ির চাকা বদলাল।", "fa": "چرخ ماشین را عوض کردند.", "fr": "Ils ont changé la roue de la voiture.", "id": "Mereka mengganti roda mobil.", "tr": "Arabanın tekerini değiştirdiler.", "ur": "انہوں نے گاڑی کا پہیہ بدلا۔"}, "independentlyReviewed": true, "words": [{"arabic": "بَدَّلُوا", "target": true, "translation": {"bs": "zamijenili su", "en": "they changed", "bn": "তারা বদলাল", "fa": "عوض کردند", "fr": "ont remplacé", "id": "mereka mengganti", "tr": "değiştirdiler", "ur": "انہوں نے بدل دیا"}}, {"arabic": "عَجَلَةَ", "target": false, "translation": {"bs": "točak", "en": "the wheel", "bn": "চাকা", "fa": "چرخ", "fr": "la roue", "id": "roda", "tr": "teker", "ur": "پہیہ"}}, {"arabic": "السَّيَّارَةِ", "target": false, "translation": {"bs": "na autu", "en": "of the car", "bn": "গাড়ির", "fa": "ماشین", "fr": "de la voiture", "id": "mobil", "tr": "arabanın", "ur": "گاڑی کا"}}]}, {"arabic": "بَدَّلْنَا الْأَثَاثَ الْقَدِيمَ", "spoken": "audio/1d9d42f5739ace327352.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Zamijenili smo stari namještaj.", "en": "We replaced the old furniture.", "bn": "আমরা পুরোনো আসবাবপত্র বদলালাম।", "fa": "مبلمان کهنه را عوض کردیم.", "fr": "Nous avons remplacé les vieux meubles.", "id": "Kami mengganti perabot yang lama.", "tr": "Eski mobilyaları değiştirdik.", "ur": "ہم نے پرانا فرنیچر بدل دیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "بَدَّلْنَا", "target": true, "translation": {"b