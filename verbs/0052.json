bjects": []}], "gloss": {"en": "you (all) repented", "bs": "pokajali ste se", "tr": "tövbe ettiniz", "fr": "vous vous êtes repentis", "id": "kalian telah bertobat", "ur": "تم سب نے توبہ کی", "bn": "তোমরা তাওবা করেছ", "fa": "توبه کردید"}}, {"arabic": "وَيَتُوبَ", "count": 2, "first": "4:26", "audio": "audio/50b8179c8ecde2c5867e.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "and he/it accepts repentance", "bs": "i prima pokajanje", "tr": "ve tövbeyi kabul eder", "fr": "et il accepte le repentir", "id": "dan dia menerima tobat", "ur": "اور وہ توبہ قبول کرتا ہے", "bn": "এবং সে তাওবা কবুল করে", "fa": "و توبه را می‌پذیرد"}}, {"arabic": "يَتُوبُوا۟", "count": 2, "first": "9:74", "audio": "audio/11037508e02b480fe075.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "subjunctive"}, {"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "they repent", "bs": "kaju se", "tr": "tövbe ederler", "fr": "qu'ils se repentent", "id": "mereka bertobat", "ur": "وہ توبہ کرتے ہیں", "bn": "তারা তাওবা করে", "fa": "توبه می‌کنند"}}, {"arabic": "فَتُوبُوٓا۟", "count": 1, "first": "2:54", "audio": "audio/302b2fd91678a651c662.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}]}, {"arabic": "وَتُبْ", "count": 1, "first": "2:128", "audio": "audio/1082ea5cf43eb70c1884.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "and accept repentance!", "bs": "i primi pokajanje!", "tr": "ve tövbeyi kabul et!", "fr": "et accepte le repentir !", "id": "dan terimalah tobat!", "ur": "اور توبہ قبول کر!", "bn": "এবং তাওবা কবুল কর!", "fa": "و توبه را بپذیر!"}}, {"arabic": "أَتُوبُ", "count": 1, "first": "2:160", "audio": "audio/23156cec7ef62da609c2.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "obje