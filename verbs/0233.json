.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱصْرِفْ", "plain": "اِصْرِفْ", "quran": true, "notUsed": false, "spoken": "audio/eb6d4831f19a27ad5182.m4a", "recited": "audio/ad13401d703ca7b2c1b8.m4a", "recitedText": "ٱصْرِفْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِصْرِفِي", "plain": "اِصْرِفِي", "quran": false, "notUsed": false, "spoken": "audio/e7d73f1cd4aa276e3790.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِصْرِفَا", "plain": "اِصْرِفَا", "quran": false, "notUsed": false, "spoken": "audio/8008d11c8aabad68cbb1.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِصْرِفُوا", "plain": "اِصْرِفُوا", "quran": false, "notUsed": false, "spoken": "audio/f49991ce07d6f905fd27.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِصْرِفْنَ", "plain": "اِصْرِفْنَ", "quran": false, "notUsed": false, "spoken": "audio/175b7c9211d60656b6db.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "12:34", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1630.mp3", "translation": {"en": {"text": "So his Lord heard his prayer and fended off their wiles from him. Lo! He is Hearer, Knower.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine Rabbi, onun duasını kabul buyurdu da ondan onların tuzaklarını bertaraf etti. Muhakkak ki O, evet O, hakkiyle işiten, hakkiyle bilendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اس کے رب نے اس کی سن لی اور اس سے عورتوں کا مکر پھیردیا، بیشک وہی سنتا جانتا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Tuhannya memperkenankan doa Yusuf dan Dia menghindarkan Yusuf dari tipu daya mereka. Sesungguhnya Dialah Yang Maha Mendengar lagi Maha Mengetahui.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱسْتَجَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فَصَرَفَ", "hit": true, "audio": "audio/dd08e341981fc60651f1.m4a", "gloss": {"bs": "pa je odvratio", "en": "so He turned away", "tr": "böylece çevirdi", "fr": "alors Il détourna", "id": "maka Dia memalingkan", "ur": "پھر اس نے پھیر دیا", "bn": "তখন তিনি ফিরিয়ে দিলেন", "fa": "پس بازگرداند"}}, {"text": "عَنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "كَيْدَهُنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمِيعُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَلِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "25:65", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2920.mp3", "translation": {"en": {"text": "And who say: Our Lord! Avert from us the doom of hell; lo! the doom thereof is anguish;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar ki, şöyle derler: Cehennem azabını üzerimizden sav! Doğrusu onun azabı geçici bir şey değildir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جو عرض کرتے ہیں اے ہمارے رب! ہم سے پھیر دے جہنم کا عذاب، بیشک اس کا عذاب گلے کا غل (پھندا) ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang berkata: \"Ya Tuhan kami, jauhkan azab jahannam dari kami, sesungguhnya azabnya itu adalah kebinasaan yang kekal\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُولُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱصْرِفْ", "hit": true, "audio": "audio/ad13401d703ca7b2c1b8.m4a", "gloss": {"bs": "odvrati", "en": "turn away", "tr": "çevir", "fr": "détourne", "id": "berpalinglah", "ur": "پھیر دے", "bn": "ফিরিয়ে দাও", "fa": "بازگردان"}}, {"text": "عَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "جَهَنَّمَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "غَرَامًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تُصْرَفُونَ", "count": 2, "first": "10:32", "audio": "audio/80f59a4d3fa5732cc937.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": true, "objects": [], "mood": "indicative"}]}, {"arabic": "صَرَفَكُمْ", "count": 1, "first": "3:152", "audio": "audio/0deb3454e5bc3e4bf887.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["antum"]}], "gloss": {"en": "he/it turned you (all) away", "bs": "odvratio vas je", "tr": "sizi çevirdi", "fr": "il vous a détournés", "id": "dia telah memalingkan kalian", "ur": "وہ تم سب کو پھیرتا ہے", "bn": "সে তোমাদের ফিরিয়ে দিল", "fa": "شما را بازداشت"}}, {"arabic": "يُصْرَفْ", "count": 1, "first": "6:16", "audio": "audio/5e97558e4b1432f97f07.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "jussive"}]}, {"arabic": "صُرِفَتْ", "count": 1, "first": "7:47", "audio": "audio/1cfe1574cec4b25a14a1.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": true, "objects": []}]}, {"arabic": "سَأَصْرِفُ", "count": 1, "first": "7:146", "audio": "audio/081fc349ad43f6ce94a0.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive":