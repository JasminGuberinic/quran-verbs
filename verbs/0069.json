": "remembers", "bn": "স্মরণ করে", "fa": "به یاد می‌آورد", "fr": "se souvient", "id": "mengingat", "tr": "hatırlıyor", "ur": "وہ یاد کرتا ہے"}}, {"arabic": "الطِّفْلُ", "target": false, "translation": {"bs": "dijete", "en": "the child", "bn": "শিশুটি", "fa": "کودک", "fr": "l'enfant", "id": "anak itu", "tr": "çocuk", "ur": "بچہ"}}, {"arabic": "أُمَّهُ", "target": false, "translation": {"bs": "svoje majke", "en": "his mother", "bn": "তার মা", "fa": "مادرش", "fr": "sa mère", "id": "ibunya", "tr": "annesi", "ur": "اپنی ماں"}}]}, {"arabic": "تَذَكَّرُوا رَبَّهُمْ", "spoken": "audio/e6ab3c7bbfbfc1f97098.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Sjetili su se svog Gospodara.", "en": "They remembered their Lord.", "bn": "তারা তাদের রবকে স্মরণ করল।", "fa": "پروردگارشان را به یاد آوردند.", "fr": "Ils se sont souvenus de leur Seigneur.", "id": "Mereka mengingat Tuhan mereka.", "tr": "Rablerini andılar.", "ur": "انہوں نے اپنے رب کو یاد کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "تَذَكَّرُوا", "target": true, "translation": {"bs": "sjetili su se", "en": "remembered", "bn": "স্মরণ করল", "fa": "به یاد آوردند", "fr": "se sont souvenus", "id": "mengingat", "tr": "andılar", "ur": "انہوں نے یاد کیا"}}, {"arabic": "رَبَّهُمْ", "target": false, "translation": {"bs": "svog Gospodara", "en": "their Lord", "bn": "তাদের রব", "fa": "پروردگارشان", "fr": "leur Seigneur", "id": "Tuhan mereka", "tr": "Rableri", "ur": "اپنا رب"}}]}, {"arabic": "يَتَذَكَّرُونَ اسْمَ الْمُعَلِّمِ", "spoken": "audio/cb41dca63f8b2a04050c.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Sjećaju se učiteljevog imena.", "en": "They remember the teacher's name.", "bn": "তারা শিক্ষকের নাম মনে রাখে।", "fa": "نام معلم را به یاد می‌آورند.", "fr": "Ils se souviennent du nom de l'enseignant.", "id": "Mereka ingat nama guru.", "tr": "Öğretmenin adını hatırlıyorlar.", "ur": "انہیں استاد کا نام یاد ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَتَذَكَّرُونَ",