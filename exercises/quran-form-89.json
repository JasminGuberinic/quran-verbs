[{"id":"nafaa-26-88-2","words":["verb:nafaa"],"options":[{"bs":"koristi","en":"he/it benefits"},{"bs":"koristi mu","en":"he/it benefits him"},{"bs":"koristi ti","en":"he/it benefits you"},{"bs":"pa mu je koristio","en":"so he/it benefited it"}],"ref":"26:88","answerWord":"يَنفَعُ","answerSound":"audio/e3f676ae59e628a4d923.m4a","quranTranslation":{"text":"The day when wealth and sons avail not (any man)","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"koristiti","en":"to benefit, to be useful"},"passage":["يَوْمَ","لَا","يَنفَعُ","مَالٌ","وَلَا","بَنُونَ"],"marked":[2],"facts":{"verb":"نَفَعَ"}},{"id":"nafaa-11-34-1","words":["verb:nafaa"],"options":[{"bs":"koristi vam","en":"he/it benefits you (all)"},{"bs":"pa mu je koristio","en":"so he/it benefited it"},{"bs":"koristi nam","en":"he/it benefits us"},{"bs":"koristi","en":"benefits"}],"ref":"11:34","answerWord":"يَنفَعُكُمْ","answerSound":"audio/7c643ea78d562818e22a.m4a","quranTranslation":{"text":"My counsel will not profit you if I were minded to advise you, if Allah's will is to keep you astray. He is your Lord and unto Him ye will be brought back.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"koristiti","en":"to benefit, to be useful"},"passage":["وَلَا","يَنفَعُكُمْ","نُصْحِىٓ","إِنْ","أَرَدتُّ","أَنْ","أَنصَحَ","لَكُمْ","إِن","كَانَ","ٱللَّهُ","يُرِيدُ","أَن","يُغْوِيَكُمْ","هُوَ","رَبُّكُمْ","وَإِلَيْهِ","تُرْجَعُونَ"],"marked":[1],"facts":{"verb":"نَفَعَ"}},{"id":"nafaa-33-16-2","words":["verb:nafaa"],"options":[{"bs":"koristi vam","en":"he/it benefits you (all)"},{"bs":"koristi nam","en":"he/it benefits us"},{"bs":"koristi","en":"benefits"},{"bs":"koristi ti","en":"he/it benefits you"}],"ref":"33:16","answerWord":"يَنفَعَكُمُ","answerSound":"audio/19b998b1c4bab05ceffe.m4a","quranTranslation":{"text":"Say: Flight will not avail you if ye flee from death or killing, and then ye dwell in comfort but a little while.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"koristiti","en":"to benefit, to be useful"},"passage":["قُل","لَّن","يَنفَعَكُمُ","ٱلْفِرَارُ","إِن","فَرَرْتُم","مِّنَ","ٱلْمَوْتِ","أَوِ","ٱلْقَتْلِ","وَإِذًا","لَّا","تُمَتَّعُونَ","إِلَّا","قَلِيلًا"],"marked":[2],"facts":{"verb":"نَفَعَ"}},{"id":"nafaa-10-98-4","words":["verb:nafaa"],"options":[{"bs":"pa mu je koristio","en":"so he/it benefited it"},{"bs":"koristi vam","en":"he/it benefits you (all)"},{"bs":"koristi ti","en":"he/it benefits you"},{"bs":"koristi mu","en":"he/it benefits him"}],"ref":"10:98","answerWord":"فَنَفَعَهَآ","answerSound":"audio/7c5e5aaa4b3ef42bb696.m4a","quranTranslation":{"text":"If only there had been a community (of all those that were destroyed of old) that believed and profited by its belief as did the folk of Jonah! When they believed We drew off from them the torment of disgrace in the life of the world and gave them comfort for a while.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"koristiti","en":"to benefit, to be useful"},"passage":["فَلَوْلَا","كَانَتْ","قَرْيَةٌ","ءَامَنَتْ","فَنَفَعَهَآ","إِيمَٰنُهَآ","إِلَّا","قَوْمَ","يُونُسَ","لَمَّآ","ءَامَنُوا۟","كَشَفْنَا","عَنْهُمْ","عَذَابَ","ٱلْخِزْىِ","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","وَمَتَّعْنَٰهُمْ","إِلَىٰ","حِينٍ"],"marked":[4],"facts":{"verb":"نَفَعَ"}},{"id":"nafaa-10-106-7","words":["verb:nafaa"],"options":[{"bs":"koristi ti","en":"he/it benefits you"},{"bs":"koristi vam","en":"he/it benefits you (all)"},{"bs":"koristi mu","en":"he/it benefits him"},{"bs":"koristi","en":"he/it benefits"}],"ref":"10:106","answerWord":"يَنفَعُكَ","answerSound":"audio/32713653d9ba58fbb994.m4a","quranTranslation":{"text":"And cry not, beside Allah, unto that which cannot profit thee nor hurt thee, for if thou didst so then wert thou of the wrong-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"koristiti","en":"to benefit, to be useful"},"passage":["وَلَا","تَدْعُ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُكَ","وَلَا","يَضُرُّكَ","فَإِن","فَعَلْتَ","فَإِنَّكَ","إِذًا","مِّنَ","ٱلظَّٰلِمِينَ"],"marked":[7],"facts":{"verb":"نَفَعَ"}},{"id":"nafaa-22-12-9","words":["verb:nafaa"],"options":[{"bs":"koristi mu","en":"he/it benefits him"},{"bs":"koristi ti","en":"he/it benefits you"},{"bs":"koriste vam","en":"they benefit you"},{"bs":"koristi vam","en":"he/it benefits you (all)"}],"ref":"22:12","answerWord":"يَنفَعُهُۥ","answerSound":"audio/f6f863877d19a12169f0.m4a","quranTranslation":{"text":"He calleth, beside Allah, unto that which hurteth him not nor benefiteth him. That is the far error.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"koristiti","en":"to benefit, to be useful"},"passage":["يَدْعُوا۟","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَضُرُّهُۥ","وَمَا","لَا","يَنفَعُهُۥ","ذَٰلِكَ","هُوَ","ٱلضَّلَٰلُ","ٱلْبَعِيدُ"],"marked":[9],"facts":{"verb":"نَفَعَ"}},{"id":"nafaa-26-73-1","words":["verb:nafaa"],"options":[{"bs":"koriste vam","en":"they benefit you"},{"bs":"koristi nam","en":"he/it benefits us"},{"bs":"koristi vam","en":"he/it benefits you (all)"},{"bs":"koristi ti","en":"he/it benefits you"}],"ref":"26:73","answerWord":"يَنفَعُونَكُمْ","answerSound":"audio/1af4d4143b01a68878d4.m4a","quranTranslation":{"text":"Or do they benefit or harm you?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"koristiti","en":"to benefit, to be useful"},"passage":["أَوْ","يَنفَعُونَكُمْ","أَوْ","يَضُرُّونَ"],"marked":[1],"facts":{"verb":"نَفَعَ"}},{"id":"nafaa-87-9-2","words":["verb:nafaa"],"options":[{"bs":"koristi","en":"benefits"},{"bs":"koristi nam","en":"he/it benefits us"},{"bs":"koristi vam","en":"he/it benefits you (all)"},{"bs":"koristi im","en":"he/it benefits them"}],"ref":"87:9","answerWord":"نَّفَعَتِ","answerSound":"audio/8e00da732d5e5f91203b.m4a","quranTranslation":{"text":"Therefor remind (men), for of use is the reminder.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"koristiti","en":"to benefit, to be useful"},"passage":["فَذَكِّرْ","إِن","نَّفَعَتِ","ٱلذِّكْرَىٰ"],"marked":[2],"facts":{"verb":"نَفَعَ"}},{"id":"jadala-4-109-8","words":["verb:jadala"],"options":[{"bs":"raspravlja se","en":"he/it argues"},{"bs":"raspravljali ste se","en":"you (all) argued"},{"bs":"raspravljate se","en":"you (all) argue"},{"bs":"i raspravljaj se s njima!","en":"and argue with them!"}],"ref":"4:109","answerWord":"يُجَٰدِلُ","answerSound":"audio/ec7d927247236f10671a.m4a","quranTranslation":{"text":"Ho! ye are they who pleaded for them in the life of the world. But who will plead with Allah for them on the Day of Resurrection, or who will then be their defender?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["هَٰٓأَنتُمْ","هَٰٓؤُلَآءِ","جَٰدَلْتُمْ","عَنْهُمْ","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","فَمَن","يُجَٰدِلُ","ٱللَّهَ","عَنْهُمْ","يَوْمَ","ٱلْقِيَٰمَةِ","أَم","مَّن","يَكُونُ","عَلَيْهِمْ","وَكِيلًا"],"marked":[8],"facts":{"verb":"جادَلَ"}},{"id":"jadala-42-35-2","words":["verb:jadala"],"options":[{"bs":"raspravljaju se","en":"they dispute"},{"bs":"raspravljali ste se","en":"you (all) argued"},{"bs":"i raspravlja se","en":"and he/it argues"},{"bs":"raspravljaju se s tobom","en":"they argue with you"}],"ref":"42:35","answerWord":"يُجَٰدِلُونَ","answerSound":"audio/b6f5f02f518c1e21e6fe.m4a","quranTranslation":{"text":"And that those who argue concerning Our revelations may know they have no refuge.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["وَيَعْلَمَ","ٱلَّذِينَ","يُجَٰدِلُونَ","فِىٓ","ءَايَٰتِنَا","مَا","لَهُم","مِّن","مَّحِيصٍ"],"marked":[2],"facts":{"verb":"جادَلَ"}},{"id":"jadala-4-109-2","words":["verb:jadala"],"options":[{"bs":"raspravljali ste se","en":"you (all) argued"},{"bs":"raspravljaju se","en":"they dispute"},{"bs":"raspravlja se s nama","en":"he/it argues with us"},{"bs":"raspravljao si se s nama","en":"you argued with us"}],"ref":"4:109","answerWord":"جَٰدَلْتُمْ","answerSound":"audio/779fcccff352472ccf23.m4a","quranTranslation":{"text":"Ho! ye are they who pleaded for them in the life of the world. But who will plead with Allah for them on the Day of Resurrection, or who will then be their defender?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["هَٰٓأَنتُمْ","هَٰٓؤُلَآءِ","جَٰدَلْتُمْ","عَنْهُمْ","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","فَمَن","يُجَٰدِلُ","ٱللَّهَ","عَنْهُمْ","يَوْمَ","ٱلْقِيَٰمَةِ","أَم","مَّن","يَكُونُ","عَلَيْهِمْ","وَكِيلًا"],"marked":[2],"facts":{"verb":"جادَلَ"}},{"id":"jadala-6-121-15","words":["verb:jadala"],"options":[{"bs":"da se raspravljaju s vama","en":"so that they may argue with you (all)"},{"bs":"raspravljate se","en":"you (all) argue"},{"bs":"raspravljao si se s nama","en":"you argued with us"},{"bs":"raspravlja se s nama","en":"he/it argues with us"}],"ref":"6:121","answerWord":"لِيُجَٰدِلُوكُمْ","answerSound":"audio/a5c9f70f86892e89e18a.m4a","quranTranslation":{"text":"And eat not of that whereon Allah's name hath not been mentioned, for lo! it is abomination. Lo! the devils do inspire their minions to dispute with you. But if ye obey them, ye will be in truth idolaters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["وَلَا","تَأْكُلُوا۟","مِمَّا","لَمْ","يُذْكَرِ","ٱسْمُ","ٱللَّهِ","عَلَيْهِ","وَإِنَّهُۥ","لَفِسْقٌ","وَإِنَّ","ٱلشَّيَٰطِينَ","لَيُوحُونَ","إِلَىٰٓ","أَوْلِيَآئِهِمْ","لِيُجَٰدِلُوكُمْ","وَإِنْ","أَطَعْتُمُوهُمْ","إِنَّكُمْ","لَمُشْرِكُونَ"],"marked":[15],"facts":{"verb":"جادَلَ"}},{"id":"jadala-7-71-8","words":["verb:jadala"],"options":[{"bs":"zar se raspravljate sa mnom?","en":"do you (all) argue with me?"},{"bs":"raspravlja se","en":"he/it argues"},{"bs":"raspravljao si se s nama","en":"you argued with us"},{"bs":"raspravljaju se","en":"they dispute"}],"ref":"7:71","answerWord":"أَتُجَٰدِلُونَنِى","answerSound":"audio/8ac0267c0672cb3306a1.m4a","quranTranslation":{"text":"He said: Terror and wrath from your Lord have already fallen on you. Would ye wrangle with me over names which ye have named, ye and your fathers, for which no warrant from Allah hath been revealed? Then await (the consequence), lo! I (also) am of those awaiting (it).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["قَالَ","قَدْ","وَقَعَ","عَلَيْكُم","مِّن","رَّبِّكُمْ","رِجْسٌ","وَغَضَبٌ","أَتُجَٰدِلُونَنِى","فِىٓ","أَسْمَآءٍ","سَمَّيْتُمُوهَآ","أَنتُمْ","وَءَابَآؤُكُم","مَّا","نَزَّلَ","ٱللَّهُ","بِهَا","مِن","سُلْطَٰنٍ","فَٱنتَظِرُوٓا۟","إِنِّى","مَعَكُم","مِّنَ","ٱلْمُنتَظِرِينَ"],"marked":[8],"facts":{"verb":"جادَلَ"}},{"id":"jadala-11-32-3","words":["verb:jadala"],"options":[{"bs":"raspravljao si se s nama","en":"you argued with us"},{"bs":"raspravlja se","en":"he/it argues"},{"bs":"raspravljaju se s tobom","en":"they argue with you"},{"bs":"raspravljali ste se","en":"you (all) argued"}],"ref":"11:32","answerWord":"جَٰدَلْتَنَا","answerSound":"audio/624a1e7e953cfd854260.m4a","quranTranslation":{"text":"They said: O Noah! Thou hast disputed with us and multiplied disputation with us; now bring upon us that wherewith thou threatenest us, if thou art of the truthful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["قَالُوا۟","يَٰنُوحُ","قَدْ","جَٰدَلْتَنَا","فَأَكْثَرْتَ","جِدَٰلَنَا","فَأْتِنَا","بِمَا","تَعِدُنَآ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"marked":[3],"facts":{"verb":"جادَلَ"}},{"id":"jadala-11-74-7","words":["verb:jadala"],"options":[{"bs":"raspravlja se s nama","en":"he/it argues with us"},{"bs":"raspravljali ste se","en":"you (all) argued"},{"bs":"raspravljate se","en":"you (all) argue"},{"bs":"i raspravljali su se","en":"and they argued"}],"ref":"11:74","answerWord":"يُجَٰدِلُنَا","answerSound":"audio/565f38ddfe7d9e3588fc.m4a","quranTranslation":{"text":"And when the awe departed from Abraham, and the glad news reached him, he pleaded with Us on behalf of the folk of Lot.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["فَلَمَّا","ذَهَبَ","عَنْ","إِبْرَٰهِيمَ","ٱلرَّوْعُ","وَجَآءَتْهُ","ٱلْبُشْرَىٰ","يُجَٰدِلُنَا","فِى","قَوْمِ","لُوطٍ"],"marked":[7],"facts":{"verb":"جادَلَ"}},{"id":"jadala-16-125-7","words":["verb:jadala"],"options":[{"bs":"i raspravljaj se s njima!","en":"and argue with them!"},{"bs":"raspravljali ste se","en":"you (all) argued"},{"bs":"da se raspravljaju s vama","en":"so that they may argue with you (all)"},{"bs":"raspravljao si se s nama","en":"you argued with us"}],"ref":"16:125","answerWord":"وَجَٰدِلْهُم","answerSound":"audio/80f4ae0720f65cc508f7.m4a","quranTranslation":{"text":"Call unto the way of thy Lord with wisdom and fair exhortation, and reason with them in the better way. Lo! thy Lord is Best Aware of him who strayeth from His way, and He is Best Aware of those who go aright.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["ٱدْعُ","إِلَىٰ","سَبِيلِ","رَبِّكَ","بِٱلْحِكْمَةِ","وَٱلْمَوْعِظَةِ","ٱلْحَسَنَةِ","وَجَٰدِلْهُم","بِٱلَّتِى","هِىَ","أَحْسَنُ","إِنَّ","رَبَّكَ","هُوَ","أَعْلَمُ","بِمَن","ضَلَّ","عَن","سَبِيلِهِۦ","وَهُوَ","أَعْلَمُ","بِٱلْمُهْتَدِينَ"],"marked":[7],"facts":{"verb":"جادَلَ"}},{"id":"jadala-18-56-6","words":["verb:jadala"],"options":[{"bs":"i raspravlja se","en":"and he/it argues"},{"bs":"raspravljali ste se","en":"you (all) argued"},{"bs":"raspravljaju se s tobom","en":"they argue with you"},{"bs":"i raspravljali su se","en":"and they argued"}],"ref":"18:56","answerWord":"وَيُجَٰدِلُ","answerSound":"audio/465e173905cf8f4e3770.m4a","quranTranslation":{"text":"We send not the messengers save as bearers of good news and warners. Those who disbelieve contend with falsehood in order to refute the Truth thereby. And they take Our revelations and that wherewith they are threatened as a jest.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["وَمَا","نُرْسِلُ","ٱلْمُرْسَلِينَ","إِلَّا","مُبَشِّرِينَ","وَمُنذِرِينَ","وَيُجَٰدِلُ","ٱلَّذِينَ","كَفَرُوا۟","بِٱلْبَٰطِلِ","لِيُدْحِضُوا۟","بِهِ","ٱلْحَقَّ","وَٱتَّخَذُوٓا۟","ءَايَٰتِى","وَمَآ","أُنذِرُوا۟","هُزُوًا"],"marked":[6],"facts":{"verb":"جادَلَ"}},{"id":"jadala-22-68-1","words":["verb:jadala"],"options":[{"bs":"raspravljaju se s tobom","en":"they argue with you"},{"bs":"i raspravljaj se s njima!","en":"and argue with them!"},{"bs":"raspravljao si se s nama","en":"you argued with us"},{"bs":"i raspravlja se","en":"and he/it argues"}],"ref":"22:68","answerWord":"جَٰدَلُوكَ","answerSound":"audio/dfeadae70af128c99c0f.m4a","quranTranslation":{"text":"And if they wrangle with thee, say: Allah is Best Aware of what ye do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["وَإِن","جَٰدَلُوكَ","فَقُلِ","ٱللَّهُ","أَعْلَمُ","بِمَا","تَعْمَلُونَ"],"marked":[1],"facts":{"verb":"جادَلَ"}},{"id":"jadala-29-46-1","words":["verb:jadala"],"options":[{"bs":"raspravljate se","en":"you (all) argue"},{"bs":"zar se raspravljate sa mnom?","en":"do you (all) argue with me?"},{"bs":"raspravljaju se s tobom","en":"they argue with you"},{"bs":"raspravljaju se","en":"they dispute"}],"ref":"29:46","answerWord":"تُجَٰدِلُوٓا۟","answerSound":"audio/2aff9052c48588ef1a3a.m4a","quranTranslation":{"text":"And argue not with the People of the Scripture unless it be in (a way) that is better, save with such of them as do wrong; and say: We believe in that which hath been revealed unto us and revealed unto you; our Allah and your Allah is One, and unto Him we surrender.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["وَلَا","تُجَٰدِلُوٓا۟","أَهْلَ","ٱلْكِتَٰبِ","إِلَّا","بِٱلَّتِى","هِىَ","أَحْسَنُ","إِلَّا","ٱلَّذِينَ","ظَلَمُوا۟","مِنْهُمْ","وَقُولُوٓا۟","ءَامَنَّا","بِٱلَّذِىٓ","أُنزِلَ","إِلَيْنَا","وَأُنزِلَ","إِلَيْكُمْ","وَإِلَٰهُنَا","وَإِلَٰهُكُمْ","وَٰحِدٌ","وَنَحْنُ","لَهُۥ","مُسْلِمُونَ"],"marked":[1],"facts":{"verb":"جادَلَ"}},{"id":"jadala-40-5-12","words":["verb:jadala"],"options":[{"bs":"i raspravljali su se","en":"and they argued"},{"bs":"raspravljate se","en":"you (all) argue"},{"bs":"i raspravlja se","en":"and he/it argues"},{"bs":"raspravljaju se s tobom","en":"they argue with you"}],"ref":"40:5","answerWord":"وَجَٰدَلُوا۟","answerSound":"audio/3c2f92847e360d849337.m4a","quranTranslation":{"text":"The folk of Noah and the factions after them denied (their messengers) before these, and every nation purposed to seize their messenger and argued falsely, (thinking) thereby to refute the Truth. Then I seized them, and how (awful) was My punishment.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"raspravljati se, prepirati se","en":"to argue, to dispute"},"passage":["كَذَّبَتْ","قَبْلَهُمْ","قَوْمُ","نُوحٍ","وَٱلْأَحْزَابُ","مِنۢ","بَعْدِهِمْ","وَهَمَّتْ","كُلُّ","أُمَّةٍۭ","بِرَسُولِهِمْ","لِيَأْخُذُوهُ","وَجَٰدَلُوا۟","بِٱلْبَٰطِلِ","لِيُدْحِضُوا۟","بِهِ","ٱلْحَقَّ","فَأَخَذْتُهُمْ","فَكَيْفَ","كَانَ","عِقَابِ"],"marked":[12],"facts":{"verb":"جادَلَ"}},{"id":"baddala-2-59-0","words":["verb:baddala"],"options":[{"bs":"pa je promijenio","en":"so he/it changed"},{"bs":"promijenio ju je","en":"he/it changed it"},{"bs":"zamijenimo","en":"We replace"},{"bs":"mijenja","en":"he/it changes"}],"ref":"2:59","answerWord":"فَبَدَّلَ","answerSound":"audio/d287e5d089d626f1f55f.m4a","quranTranslation":{"text":"But those who did wrong changed the word which had been told them for another saying, and We sent down upon the evil-doers wrath from heaven for their evil-doing.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["فَبَدَّلَ","ٱلَّذِينَ","ظَلَمُوا۟","قَوْلًا","غَيْرَ","ٱلَّذِى","قِيلَ","لَهُمْ","فَأَنزَلْنَا","عَلَى","ٱلَّذِينَ","ظَلَمُوا۟","رِجْزًا","مِّنَ","ٱلسَّمَآءِ","بِمَا","كَانُوا۟","يَفْسُقُونَ"],"marked":[0],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-14-28-4","words":["verb:baddala"],"options":[{"bs":"promijenili su","en":"they changed"},{"bs":"promijenili smo ih","en":"we changed them"},{"bs":"zamijenili bismo","en":"We would replace"},{"bs":"promijenio ju je","en":"he/it changed it"}],"ref":"14:28","answerWord":"بَدَّلُوا۟","answerSound":"audio/e2513bacb41120056c9c.m4a","quranTranslation":{"text":"Hast thou not seen those who gave the grace of Allah in exchange for thanklessness and led their people down to the Abode of Loss,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["أَلَمْ","تَرَ","إِلَى","ٱلَّذِينَ","بَدَّلُوا۟","نِعْمَتَ","ٱللَّهِ","كُفْرًا","وَأَحَلُّوا۟","قَوْمَهُمْ","دَارَ","ٱلْبَوَارِ"],"marked":[4],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-76-28-6","words":["verb:baddala"],"options":[{"bs":"zamijenili bismo","en":"We would replace"},{"bs":"promijenili smo ih","en":"we changed them"},{"bs":"zamijenimo","en":"We replace"},{"bs":"mijenja","en":"he/it changes"}],"ref":"76:28","answerWord":"بَدَّلْنَآ","answerSound":"audio/42737622fa0fc8e45b95.m4a","quranTranslation":{"text":"We, even We, created them, and strengthened their frame. And when We will, We can replace them, bringing others like them in their stead.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["نَّحْنُ","خَلَقْنَٰهُمْ","وَشَدَدْنَآ","أَسْرَهُمْ","وَإِذَا","شِئْنَا","بَدَّلْنَآ","أَمْثَٰلَهُمْ","تَبْدِيلًا"],"marked":[6],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-70-41-2","words":["verb:baddala"],"options":[{"bs":"zamijenimo","en":"We replace"},{"bs":"promijenili smo ih","en":"we changed them"},{"bs":"mijenja","en":"he/it changes"},{"bs":"biva promijenjen","en":"he/it is changed"}],"ref":"70:41","answerWord":"نُّبَدِّلَ","answerSound":"audio/dc25b8dd142e919fc5d2.m4a","quranTranslation":{"text":"To replace them by (others) better than them. And we are not to be outrun.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["عَلَىٰٓ","أَن","نُّبَدِّلَ","خَيْرًا","مِّنْهُمْ","وَمَا","نَحْنُ","بِمَسْبُوقِينَ"],"marked":[2],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-2-181-1","words":["verb:baddala"],"options":[{"bs":"promijenio ju je","en":"he/it changed it"},{"bs":"promijenio je","en":"he/it changed"},{"bs":"promijeni ga!","en":"change it!"},{"bs":"mijenjaju","en":"they change"}],"ref":"2:181","answerWord":"بَدَّلَهُۥ","answerSound":"audio/6a846644c27c56d250cc.m4a","quranTranslation":{"text":"And whoso changeth (the will) after he hath heard it - the sin thereof is only upon those who change it. Lo! Allah is Hearer, Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["فَمَنۢ","بَدَّلَهُۥ","بَعْدَمَا","سَمِعَهُۥ","فَإِنَّمَآ","إِثْمُهُۥ","عَلَى","ٱلَّذِينَ","يُبَدِّلُونَهُۥٓ","إِنَّ","ٱللَّهَ","سَمِيعٌ","عَلِيمٌ"],"marked":[1],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-2-181-8","words":["verb:baddala"],"options":[{"bs":"mijenjaju je","en":"they change it"},{"bs":"mijenjam ga","en":"I change it"},{"bs":"mijenjaju","en":"they change"},{"bs":"promijeni ga!","en":"change it!"}],"ref":"2:181","answerWord":"يُبَدِّلُونَهُۥٓ","answerSound":"audio/1ed4b872bd09adacca85.m4a","quranTranslation":{"text":"And whoso changeth (the will) after he hath heard it - the sin thereof is only upon those who change it. Lo! Allah is Hearer, Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["فَمَنۢ","بَدَّلَهُۥ","بَعْدَمَا","سَمِعَهُۥ","فَإِنَّمَآ","إِثْمُهُۥ","عَلَى","ٱلَّذِينَ","يُبَدِّلُونَهُۥٓ","إِنَّ","ٱللَّهَ","سَمِيعٌ","عَلِيمٌ"],"marked":[8],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-2-211-9","words":["verb:baddala"],"options":[{"bs":"mijenja","en":"he/it changes"},{"bs":"promijenili su","en":"they changed"},{"bs":"promijeni ga!","en":"change it!"},{"bs":"promijenili smo","en":"we changed"}],"ref":"2:211","answerWord":"يُبَدِّلْ","answerSound":"audio/53973adb10f0cdfcc684.m4a","quranTranslation":{"text":"Ask of the Children of Israel how many a clear revelation We gave them! He who altereth the grace of Allah after it hath come unto him (for him), lo! Allah is severe in punishment.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["سَلْ","بَنِىٓ","إِسْرَٰٓءِيلَ","كَمْ","ءَاتَيْنَٰهُم","مِّنْ","ءَايَةٍۭ","بَيِّنَةٍ","وَمَن","يُبَدِّلْ","نِعْمَةَ","ٱللَّهِ","مِنۢ","بَعْدِ","مَا","جَآءَتْهُ","فَإِنَّ","ٱللَّهَ","شَدِيدُ","ٱلْعِقَابِ"],"marked":[9],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-4-56-10","words":["verb:baddala"],"options":[{"bs":"promijenili smo ih","en":"we changed them"},{"bs":"biva promijenjen","en":"he/it is changed"},{"bs":"zamijenili bismo","en":"We would replace"},{"bs":"promijenio ju je","en":"he/it changed it"}],"ref":"4:56","answerWord":"بَدَّلْنَٰهُمْ","answerSound":"audio/a3238cfd3dd51dbd05d7.m4a","quranTranslation":{"text":"Lo! Those who disbelieve Our revelations, We shall expose them to the Fire. As often as their skins are consumed We shall exchange them for fresh skins that they may taste the torment. Lo! Allah is ever Mighty, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["إِنَّ","ٱلَّذِينَ","كَفَرُوا۟","بِـَٔايَٰتِنَا","سَوْفَ","نُصْلِيهِمْ","نَارًا","كُلَّمَا","نَضِجَتْ","جُلُودُهُم","بَدَّلْنَٰهُمْ","جُلُودًا","غَيْرَهَا","لِيَذُوقُوا۟","ٱلْعَذَابَ","إِنَّ","ٱللَّهَ","كَانَ","عَزِيزًا","حَكِيمًا"],"marked":[10],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-7-95-1","words":["verb:baddala"],"options":[{"bs":"promijenili smo","en":"we changed"},{"bs":"biva promijenjen","en":"he/it is changed"},{"bs":"mijenjam ga","en":"I change it"},{"bs":"promijeni ga!","en":"change it!"}],"ref":"7:95","answerWord":"بَدَّلْنَا","answerSound":"audio/0ff534ad0203a8912754.m4a","quranTranslation":{"text":"Then changed We the evil plight for good till they grew affluent and said: Tribulation and distress did touch our fathers. Then We seized them unawares, when they perceived not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["ثُمَّ","بَدَّلْنَا","مَكَانَ","ٱلسَّيِّئَةِ","ٱلْحَسَنَةَ","حَتَّىٰ","عَفَوا۟","وَّقَالُوا۟","قَدْ","مَسَّ","ءَابَآءَنَا","ٱلضَّرَّآءُ","وَٱلسَّرَّآءُ","فَأَخَذْنَٰهُم","بَغْتَةً","وَهُمْ","لَا","يَشْعُرُونَ"],"marked":[1],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-25-70-8","words":["verb:baddala"],"options":[{"bs":"mijenja","en":"he/it changes"},{"bs":"promijenio je","en":"he/it changed"},{"bs":"zamijenili bismo","en":"We would replace"},{"bs":"mijenjaju je","en":"they change it"}],"ref":"25:70","answerWord":"يُبَدِّلُ","answerSound":"audio/25f6f5504b6b6a0a70b9.m4a","quranTranslation":{"text":"Save him who repenteth and believeth and doth righteous work; as for such, Allah will change their evil deeds to good deeds. Allah is ever Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["إِلَّا","مَن","تَابَ","وَءَامَنَ","وَعَمِلَ","عَمَلًا","صَٰلِحًا","فَأُو۟لَٰٓئِكَ","يُبَدِّلُ","ٱللَّهُ","سَيِّـَٔاتِهِمْ","حَسَنَٰتٍ","وَكَانَ","ٱللَّهُ","غَفُورًا","رَّحِيمًا"],"marked":[8],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-27-11-4","words":["verb:baddala"],"options":[{"bs":"promijenio je","en":"he/it changed"},{"bs":"promijenili smo ih","en":"we changed them"},{"bs":"mijenjam ga","en":"I change it"},{"bs":"mijenja","en":"he/it changes"}],"ref":"27:11","answerWord":"بَدَّلَ","answerSound":"audio/407d4d4fcab3139b7247.m4a","quranTranslation":{"text":"Save him who hath done wrong and afterward hath changed evil for good. And lo! I am Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["إِلَّا","مَن","ظَلَمَ","ثُمَّ","بَدَّلَ","حُسْنًۢا","بَعْدَ","سُوٓءٍ","فَإِنِّى","غَفُورٌ","رَّحِيمٌ"],"marked":[4],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-34-16-5","words":["verb:baddala"],"options":[{"bs":"i promijenili smo ih","en":"and we changed them"},{"bs":"promijenio je","en":"he/it changed"},{"bs":"mijenjam ga","en":"I change it"},{"bs":"mijenjaju","en":"they change"}],"ref":"34:16","answerWord":"وَبَدَّلْنَٰهُم","answerSound":"audio/7cc7e4ae9a5eb8bd938e.m4a","quranTranslation":{"text":"But they were froward, so We sent on them the flood of 'Iram, and in exchange for their two gardens gave them two gardens bearing bitter fruit, the tamarisk and here and there a lote-tree.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["فَأَعْرَضُوا۟","فَأَرْسَلْنَا","عَلَيْهِمْ","سَيْلَ","ٱلْعَرِمِ","وَبَدَّلْنَٰهُم","بِجَنَّتَيْهِمْ","جَنَّتَيْنِ","ذَوَاتَىْ","أُكُلٍ","خَمْطٍ","وَأَثْلٍ","وَشَىْءٍ","مِّن","سِدْرٍ","قَلِيلٍ"],"marked":[5],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-40-26-10","words":["verb:baddala"],"options":[{"bs":"mijenja","en":"he/it changes"},{"bs":"zamijenili bismo","en":"We would replace"},{"bs":"promijenili smo ih","en":"we changed them"},{"bs":"promijenio je","en":"he/it changed"}],"ref":"40:26","answerWord":"يُبَدِّلَ","answerSound":"audio/00ff9b397cd6d7a8f693.m4a","quranTranslation":{"text":"And Pharaoh said: Suffer me to kill Moses, and let him cry unto his Lord. Lo! I fear that he will alter your religion or that he will cause confusion in the land.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["وَقَالَ","فِرْعَوْنُ","ذَرُونِىٓ","أَقْتُلْ","مُوسَىٰ","وَلْيَدْعُ","رَبَّهُۥٓ","إِنِّىٓ","أَخَافُ","أَن","يُبَدِّلَ","دِينَكُمْ","أَوْ","أَن","يُظْهِرَ","فِى","ٱلْأَرْضِ","ٱلْفَسَادَ"],"marked":[10],"facts":{"verb":"بَدَّلَ"}},{"id":"baddala-50-29-1","words":["verb:baddala"],"options":[{"bs":"biva promijenjen","en":"he/it is changed"},{"bs":"zamijenili bismo","en":"We would replace"},{"bs":"promijenio je","en":"he/it changed"},{"bs":"promijeni ga!","en":"change it!"}],"ref":"50:29","answerWord":"يُبَدَّلُ","answerSound":"audio/a4b33e86bf1c32691b48.m4a","quranTranslation":{"text":"The sentence that cometh from Me cannot be changed, and I am in no wise a tyrant unto the slaves.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"promijeniti, zamijeniti","en":"to change, to exchange"},"passage":["مَا","يُبَدَّلُ","ٱلْقَوْلُ","لَدَىَّ","وَمَآ","أَنَا۠","بِظَلَّٰمٍ","لِّلْعَبِيدِ"],"marked":[1],"facts":{"verb":"بَدَّلَ"}},{"id":"adhhaba-35-16-2","words":["verb:adhhaba"],"options":[{"bs":"uklonio bi vas","en":"He would remove you"},{"bs":"uklanjaju","en":"they remove"},{"bs":"protratili ste","en":"you (all) squandered"},{"bs":"da ukloni","en":"so that he/it may remove"}],"ref":"35:16","answerWord":"يُذْهِبْكُمْ","answerSound":"audio/b400c4f9a89e96c97512.m4a","quranTranslation":{"text":"If He will, He can be rid of you and bring (instead of you) some new creation.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukloniti, odnijeti","en":"to remove, to take away"},"passage":["إِن","يَشَأْ","يُذْهِبْكُمْ","وَيَأْتِ","بِخَلْقٍ","جَدِيدٍ"],"marked":[2],"facts":{"verb":"أَذْهَبَ"}},{"id":"adhhaba-8-11-12","words":["verb:adhhaba"],"options":[{"bs":"i uklanja","en":"and he/it removes"},{"bs":"uklonio bi vas","en":"He would remove you"},{"bs":"protratili ste","en":"you (all) squandered"},{"bs":"uklanjaju","en":"they remove"}],"ref":"8:11","answerWord":"وَيُذْهِبَ","answerSound":"audio/76fd4e7993393ca04fd5.m4a","quranTranslation":{"text":"When He made the slumber fall upon you as a reassurance from him and sent down water from the sky upon you, that thereby He might purify you, and remove from you the fear of Satan, and make strong your hearts and firm (your) feet thereby.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukloniti, odnijeti","en":"to remove, to take away"},"passage":["إِذْ","يُغَشِّيكُمُ","ٱلنُّعَاسَ","أَمَنَةً","مِّنْهُ","وَيُنَزِّلُ","عَلَيْكُم","مِّنَ","ٱلسَّمَآءِ","مَآءً","لِّيُطَهِّرَكُم","بِهِۦ","وَيُذْهِبَ","عَنكُمْ","رِجْزَ","ٱلشَّيْطَٰنِ","وَلِيَرْبِطَ","عَلَىٰ","قُلُوبِكُمْ","وَيُثَبِّتَ","بِهِ","ٱلْأَقْدَامَ"],"marked":[12],"facts":{"verb":"أَذْهَبَ"}},{"id":"adhhaba-9-15-0","words":["verb:adhhaba"],"options":[{"bs":"i uklanja","en":"and he/it removes"},{"bs":"protratili ste","en":"you (all) squandered"},{"bs":"uklonio bi vas","en":"He would remove you"},{"bs":"uklanjaju","en":"they remove"}],"ref":"9:15","answerWord":"وَيُذْهِبْ","answerSound":"audio/93c6b944551c5f04325a.m4a","quranTranslation":{"text":"And He will remove the anger of their hearts. Allah relenteth toward whom He will. Allah is Knower, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukloniti, odnijeti","en":"to remove, to take away"},"passage":["وَيُذْهِبْ","غَيْظَ","قُلُوبِهِمْ","وَيَتُوبُ","ٱللَّهُ","عَلَىٰ","مَن","يَشَآءُ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"marked":[0],"facts":{"verb":"أَذْهَبَ"}},{"id":"adhhaba-11-114-9","words":["verb:adhhaba"],"options":[{"bs":"uklanjaju","en":"they remove"},{"bs":"i uklanja","en":"and he/it removes"},{"bs":"protratili ste","en":"you (all) squandered"},{"bs":"uklonio bi vas","en":"He would remove you"}],"ref":"11:114","answerWord":"يُذْهِبْنَ","answerSound":"audio/36655a655ac70e383932.m4a","quranTranslation":{"text":"Establish worship at the two ends of the day and in some watches of the night. Lo! good deeds annul ill-deeds. This is reminder for the mindful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukloniti, odnijeti","en":"to remove, to take away"},"passage":["وَأَقِمِ","ٱلصَّلَوٰةَ","طَرَفَىِ","ٱلنَّهَارِ","وَزُلَفًا","مِّنَ","ٱلَّيْلِ","إِنَّ","ٱلْحَسَنَٰتِ","يُذْهِبْنَ","ٱلسَّيِّـَٔاتِ","ذَٰلِكَ","ذِكْرَىٰ","لِلذَّٰكِرِينَ"],"marked":[9],"facts":{"verb":"أَذْهَبَ"}},{"id":"adhhaba-33-33-18","words":["verb:adhhaba"],"options":[{"bs":"da ukloni","en":"so that he/it may remove"},{"bs":"uklonio bi vas","en":"He would remove you"},{"bs":"protratili ste","en":"you (all) squandered"},{"bs":"uklanjaju","en":"they remove"}],"ref":"33:33","answerWord":"لِيُذْهِبَ","answerSound":"audio/b45b3c84af844c95a8f2.m4a","quranTranslation":{"text":"And stay in your houses. Bedizen not yourselves with the bedizenment of the Time of Ignorance. Be regular in prayer, and pay the poor-due, and obey Allah and His messenger. Allah's wish is but to remove uncleanness far from you, O Folk of the Household, and cleanse you with a thorough cleansing.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukloniti, odnijeti","en":"to remove, to take away"},"passage":["وَقَرْنَ","فِى","بُيُوتِكُنَّ","وَلَا","تَبَرَّجْنَ","تَبَرُّجَ","ٱلْجَٰهِلِيَّةِ","ٱلْأُولَىٰ","وَأَقِمْنَ","ٱلصَّلَوٰةَ","وَءَاتِينَ","ٱلزَّكَوٰةَ","وَأَطِعْنَ","ٱللَّهَ","وَرَسُولَهُۥٓ","إِنَّمَا","يُرِيدُ","ٱللَّهُ","لِيُذْهِبَ","عَنكُمُ","ٱلرِّجْسَ","أَهْلَ","ٱلْبَيْتِ","وَيُطَهِّرَكُمْ","تَطْهِيرًا"],"marked":[18],"facts":{"verb":"أَذْهَبَ"}},{"id":"adhhaba-46-20-6","words":["verb:adhhaba"],"options":[{"bs":"protratili ste","en":"you (all) squandered"},{"bs":"i uklanja","en":"and he/it removes"},{"bs":"uklanjaju","en":"they remove"},{"bs":"uklonio bi vas","en":"He would remove you"}],"ref":"46:20","answerWord":"أَذْهَبْتُمْ","answerSound":"audio/da432dbd79bea5be2eac.m4a","quranTranslation":{"text":"And on the day when those who disbelieve are exposed to the Fire (it will be said): Ye squandered your good things in the life of the world and sought comfort therein. Now this day ye are rewarded with the doom of ignominy because ye were disdainful in the land without a right, and because ye used to transgress.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukloniti, odnijeti","en":"to remove, to take away"},"passage":["وَيَوْمَ","يُعْرَضُ","ٱلَّذِينَ","كَفَرُوا۟","عَلَى","ٱلنَّارِ","أَذْهَبْتُمْ","طَيِّبَٰتِكُمْ","فِى","حَيَاتِكُمُ","ٱلدُّنْيَا","وَٱسْتَمْتَعْتُم","بِهَا","فَٱلْيَوْمَ","تُجْزَوْنَ","عَذَابَ","ٱلْهُونِ","بِمَا","كُنتُمْ","تَسْتَكْبِرُونَ","فِى","ٱلْأَرْضِ","بِغَيْرِ","ٱلْحَقِّ","وَبِمَا","كُنتُمْ","تَفْسُقُونَ"],"marked":[6],"facts":{"verb":"أَذْهَبَ"}},{"id":"azhara-9-33-7","words":["verb:azhara"],"options":[{"bs":"da ga učini nadmoćnim","en":"so that he/it may make it prevail"},{"bs":"otkriva","en":"He reveals"},{"bs":"i obznanio mu je","en":"and he/it made it known to him"},{"bs":"ulazite u podne","en":"you (all) reach noon"}],"ref":"9:33","answerWord":"لِيُظْهِرَهُۥ","answerSound":"audio/d95a6192642acad34d96.m4a","quranTranslation":{"text":"He it is Who hath sent His messenger with the guidance and the Religion of Truth, that He may cause it to prevail over all religion, however much the idolaters may be averse.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pokazati, otkriti","en":"to show, to reveal"},"passage":["هُوَ","ٱلَّذِىٓ","أَرْسَلَ","رَسُولَهُۥ","بِٱلْهُدَىٰ","وَدِينِ","ٱلْحَقِّ","لِيُظْهِرَهُۥ","عَلَى","ٱلدِّينِ","كُلِّهِۦ","وَلَوْ","كَرِهَ","ٱلْمُشْرِكُونَ"],"marked":[7],"facts":{"verb":"أَظْهَرَ"}},{"id":"azhara-30-18-7","words":["verb:azhara"],"options":[{"bs":"ulazite u podne","en":"you (all) reach noon"},{"bs":"otkriva","en":"He reveals"},{"bs":"da ga učini nadmoćnim","en":"so that he/it may make it prevail"},{"bs":"i obznanio mu je","en":"and he/it made it known to him"}],"ref":"30:18","answerWord":"تُظْهِرُونَ","answerSound":"audio/bcce63326ff18fe98abb.m4a","quranTranslation":{"text":"Unto Him be praise in the heavens and the earth! - and at the sun's decline and in the noonday.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pokazati, otkriti","en":"to show, to reveal"},"passage":["وَلَهُ","ٱلْحَمْدُ","فِى","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","وَعَشِيًّا","وَحِينَ","تُظْهِرُونَ"],"marked":[7],"facts":{"verb":"أَظْهَرَ"}},{"id":"azhara-40-26-14","words":["verb:azhara"],"options":[{"bs":"pokazuje","en":"he/it shows"},{"bs":"da ga učini nadmoćnim","en":"so that he/it may make it prevail"},{"bs":"ulazite u podne","en":"you (all) reach noon"},{"bs":"i obznanio mu je","en":"and he/it made it known to him"}],"ref":"40:26","answerWord":"يُظْهِرَ","answerSound":"audio/0b66930a91716e8c31ff.m4a","quranTranslation":{"text":"And Pharaoh said: Suffer me to kill Moses, and let him cry unto his Lord. Lo! I fear that he will alter your religion or that he will cause confusion in the land.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pokazati, otkriti","en":"to show, to reveal"},"passage":["وَقَالَ","فِرْعَوْنُ","ذَرُونِىٓ","أَقْتُلْ","مُوسَىٰ","وَلْيَدْعُ","رَبَّهُۥٓ","إِنِّىٓ","أَخَافُ","أَن","يُبَدِّلَ","دِينَكُمْ","أَوْ","أَن","يُظْهِرَ","فِى","ٱلْأَرْضِ","ٱلْفَسَادَ"],"marked":[14],"facts":{"verb":"أَظْهَرَ"}},{"id":"azhara-66-3-10","words":["verb:azhara"],"options":[{"bs":"i obznanio mu je","en":"and he/it made it known to him"},{"bs":"ulazite u podne","en":"you (all) reach noon"},{"bs":"otkriva","en":"He reveals"},{"bs":"da ga učini nadmoćnim","en":"so that he/it may make it prevail"}],"ref":"66:3","answerWord":"وَأَظْهَرَهُ","answerSound":"audio/bd9a522c980a7fed4d7f.m4a","quranTranslation":{"text":"When the Prophet confided a fact unto one of his wives and when she afterward divulged it and Allah apprised him thereof, he made known (to her) part thereof and passed over part. And when he told it her she said: Who hath told thee? He said: The Knower, the Aware hath told me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pokazati, otkriti","en":"to show, to reveal"},"passage":["وَإِذْ","أَسَرَّ","ٱلنَّبِىُّ","إِلَىٰ","بَعْضِ","أَزْوَٰجِهِۦ","حَدِيثًا","فَلَمَّا","نَبَّأَتْ","بِهِۦ","وَأَظْهَرَهُ","ٱللَّهُ","عَلَيْهِ","عَرَّفَ","بَعْضَهُۥ","وَأَعْرَضَ","عَنۢ","بَعْضٍ","فَلَمَّا","نَبَّأَهَا","بِهِۦ","قَالَتْ","مَنْ","أَنۢبَأَكَ","هَٰذَا","قَالَ","نَبَّأَنِىَ","ٱلْعَلِيمُ","ٱلْخَبِيرُ"],"marked":[10],"facts":{"verb":"أَظْهَرَ"}},{"id":"azhara-72-26-3","words":["verb:azhara"],"options":[{"bs":"otkriva","en":"He reveals"},{"bs":"da ga učini nadmoćnim","en":"so that he/it may make it prevail"},{"bs":"i obznanio mu je","en":"and he/it made it known to him"},{"bs":"ulazite u podne","en":"you (all) reach noon"}],"ref":"72:26","answerWord":"يُظْهِرُ","answerSound":"audio/0de7f26f602086728cfb.m4a","quranTranslation":{"text":"(He is) the Knower of the Unseen, and He revealeth unto none His secret,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pokazati, otkriti","en":"to show, to reveal"},"passage":["عَٰلِمُ","ٱلْغَيْبِ","فَلَا","يُظْهِرُ","عَلَىٰ","غَيْبِهِۦٓ","أَحَدًا"],"marked":[3],"facts":{"verb":"أَظْهَرَ"}}]