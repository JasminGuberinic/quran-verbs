": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they intercede", "bs": "zauzimaju se", "tr": "şefaat ederler", "fr": "ils intercèdent", "id": "mereka memberi syafaat", "ur": "وہ سفارش کرتے ہیں", "bn": "তারা সুপারিশ করে", "fa": "شفاعت می‌کنند"}}], "ayatFile": "ayat/0476.json", "ayatTranslations": {"en": "ayat/0476.en.json", "tr": "ayat/0476.tr.json", "ur": "ayat/0476.ur.json", "id": "ayat/0476.id.json"}, "sentences": [{"arabic": "يَشْفَعُ الْأَخُ لِأَخِيهِ", "spoken": "audio/c4ff0d23a42ad9e3cfae.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Brat se zauzima za svog brata.", "en": "The brother intercedes for his brother.", "bn": "ভাই তার ভাইয়ের জন্য সুপারিশ করে।", "fa": "برادر برای برادرش شفاعت می‌کند.", "fr": "Le frère intercède pour son frère.", "id": "Saudara itu memberi syafaat untuk saudaranya.", "tr": "Kardeş, kardeşi için şefaat eder.", "ur": "بھائی اپنے بھائی کی شفاعت کرتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَشْفَعُ", "target": true, "translation": {"bs": "zauzima se", "en": "intercedes", "bn": "সুপারিশ করে", "fa": "شفاعت می‌کند", "fr": "intercède", "id": "memberi syafaat", "tr": "şefaat eder", "ur": "شفاعت کرتا ہے"}}, {"arabic": "الْأَخُ", "target": false, "translation": {"bs": "brat", "en": "the brother", "bn": "ভাই", "fa": "برادر", "fr": "le frère", "id": "saudara", "tr": "kardeş", "ur": "بھائی"}}, {"arabic": "لِأَخِيهِ", "target": false, "translation": {"bs": "za svog brata", "en": "for his brother", "bn": "তার ভাইয়ের জন্য", "fa": "برای برادرش", "fr": "pour son frère", "id": "untuk saudaranya", "tr": "kardeşi için", "ur": "اپنے بھائی کے لیے"}}]}, {"arabic": "يَشْفَعُونَ لِصَدِيقِهِمْ عِنْدَ الْمُدِيرِ", "spoken": "audio/31a46ccb138878d83677.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Zauzimaju se za svog prijatelja kod direktora.", "en": "They intercede for their friend with the director.", "bn": "তারা তাদের বন্ধুর জন্য পরিচালকের কাছে সুপারিশ করে।", "fa": "آنان برای دوستشان نزد مدیر شفاعت می‌کنند.", "fr": "Ils intercèdent pour leur ami auprès du directeur.", "id": "Mereka memberi syafaat untuk teman mereka kepada direktur.", "tr": "Arkadaşları için müdürün yanında şefaat ederler.", "ur": "وہ اپنے دوست کے لیے مدیر کے پاس شفاعت کرتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَشْفَعُونَ", "target": true, "translation": {"bs": "zauzimaju se", "en": "intercede", "bn": "সুপারিশ করে", "fa": "شفاعت می‌کنند", "fr": "intercèdent", "id": "memberi syafaat", "tr": "şefaat ederler", "ur": "شفاعت کرتے ہیں"}}, {"arabic": "لِصَدِيقِهِمْ", "target": false, "translation": {"bs": "za svog prijatelja", "en": "for their friend", "bn": "তাদের বন্ধুর জন্য", "fa": "برای دوستشان", "fr": "pour leur ami", "id": "untuk teman mereka", "tr": "arkadaşları için", "ur": "اپنے دوست کے لیے"}}, {"arabic": "عِنْدَ", "target": false, "translation": {"bs": "kod", "en": "with", "bn": "কাছে", "fa": "نزد", "fr": "auprès de", "id": "di sisi", "tr": "yanında", "ur": "کے پاس"}}, {"arabic": "الْمُدِيرِ", "target": false, "translation": {"bs": "direktora", "en": "the director", "bn": "পরিচালক", "fa": "مدیر", "fr": "le directeur", "id": "direktur", "tr": "müdür", "ur": "مدیر"}}]}]}