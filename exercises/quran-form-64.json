[{"id":"dhakara-19-16-0","words":["verb:dhakara"],"options":[{"bs":"i spomeni!","en":"and mention!"},{"bs":"i sjetite se!","en":"and (you all) remember!"},{"bs":"i biva spomenut","en":"and he/it is mentioned"},{"bs":"sjeti ga se","en":"remembers it"}],"ref":"19:16","answerWord":"وَٱذْكُرْ","answerSound":"audio/5dca3929395297ecbd7e.m4a","quranTranslation":{"text":"And make mention of Mary in the Scripture, when she had withdrawn from her people to a chamber looking East,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["وَٱذْكُرْ","فِى","ٱلْكِتَٰبِ","مَرْيَمَ","إِذِ","ٱنتَبَذَتْ","مِنْ","أَهْلِهَا","مَكَانًا","شَرْقِيًّا"],"marked":[0],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-2-40-2","words":["verb:dhakara"],"options":[{"bs":"sjetite se!","en":"(you all) remember!"},{"bs":"sjeća se","en":"he/it remembers"},{"bs":"spomeni me!","en":"mention me!"},{"bs":"i sjetite se!","en":"and (you all) remember!"}],"ref":"2:40","answerWord":"ٱذْكُرُوا۟","answerSound":"audio/8bc561e1733b20c55cb6.m4a","quranTranslation":{"text":"O Children of Israel! Remember My favour wherewith I favoured you, and fulfil your (part of the) covenant, I shall fulfil My (part of the) covenant, and fear Me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["يَٰبَنِىٓ","إِسْرَٰٓءِيلَ","ٱذْكُرُوا۟","نِعْمَتِىَ","ٱلَّتِىٓ","أَنْعَمْتُ","عَلَيْكُمْ","وَأَوْفُوا۟","بِعَهْدِىٓ","أُوفِ","بِعَهْدِكُمْ","وَإِيَّٰىَ","فَٱرْهَبُونِ"],"marked":[2],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-2-63-10","words":["verb:dhakara"],"options":[{"bs":"i sjetite se!","en":"and (you all) remember!"},{"bs":"sjećate se","en":"you (all) remember"},{"bs":"i spomenut je","en":"and he/it was mentioned"},{"bs":"pa me spomenite!","en":"so (you all) remember me!"}],"ref":"2:63","answerWord":"وَٱذْكُرُوا۟","answerSound":"audio/898f9532e30780188525.m4a","quranTranslation":{"text":"And (remember, O Children of Israel) when We made a covenant with you and caused the mount to tower above you, (saying): Hold fast that which We have given you, and remember that which is therein, that ye may ward off (evil).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["وَإِذْ","أَخَذْنَا","مِيثَٰقَكُمْ","وَرَفَعْنَا","فَوْقَكُمُ","ٱلطُّورَ","خُذُوا۟","مَآ","ءَاتَيْنَٰكُم","بِقُوَّةٍ","وَٱذْكُرُوا۟","مَا","فِيهِ","لَعَلَّكُمْ","تَتَّقُونَ"],"marked":[10],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-6-118-2","words":["verb:dhakara"],"options":[{"bs":"spomenut je","en":"he/it was mentioned"},{"bs":"i sjetite se!","en":"and (you all) remember!"},{"bs":"spomenut ćete ih","en":"you (all) will remember them"},{"bs":"pa me spomenite!","en":"so (you all) remember me!"}],"ref":"6:118","answerWord":"ذُكِرَ","answerSound":"audio/eb7e37989020fda1c8d4.m4a","quranTranslation":{"text":"Eat of that over which the name of Allah hath been mentioned, if ye are believers in His revelations.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["فَكُلُوا۟","مِمَّا","ذُكِرَ","ٱسْمُ","ٱللَّهِ","عَلَيْهِ","إِن","كُنتُم","بِـَٔايَٰتِهِۦ","مُؤْمِنِينَ"],"marked":[2],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-2-198-12","words":["verb:dhakara"],"options":[{"bs":"pa se sjetite!","en":"so (you all) remember!"},{"bs":"biva spomenut","en":"he/it is mentioned"},{"bs":"i sjetite se!","en":"and (you all) remember!"},{"bs":"sjetili su se","en":"they remembered"}],"ref":"2:198","answerWord":"فَٱذْكُرُوا۟","answerSound":"audio/3d3e911343c5ffe2b3f0.m4a","quranTranslation":{"text":"It is no sin for you that ye seek the bounty of your Lord (by trading). But, when ye press on in the multitude from 'Arafat, remember Allah by the sacred monument. Remember Him as He hath guided you, although before ye were of those astray.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["لَيْسَ","عَلَيْكُمْ","جُنَاحٌ","أَن","تَبْتَغُوا۟","فَضْلًا","مِّن","رَّبِّكُمْ","فَإِذَآ","أَفَضْتُم","مِّنْ","عَرَفَٰتٍ","فَٱذْكُرُوا۟","ٱللَّهَ","عِندَ","ٱلْمَشْعَرِ","ٱلْحَرَامِ","وَٱذْكُرُوهُ","كَمَا","هَدَىٰكُمْ","وَإِن","كُنتُم","مِّن","قَبْلِهِۦ","لَمِنَ","ٱلضَّآلِّينَ"],"marked":[12],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-37-13-3","words":["verb:dhakara"],"options":[{"bs":"(ne) opamete se","en":"they (do not) take heed"},{"bs":"i spominji!","en":"and remember!"},{"bs":"spominjem je","en":"I mention it"},{"bs":"sjećate se","en":"you (all) remember"}],"ref":"37:13","answerWord":"يَذْكُرُونَ","answerSound":"audio/367f96d81f55aee31f06.m4a","quranTranslation":{"text":"And heed not when they are reminded,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["وَإِذَا","ذُكِّرُوا۟","لَا","يَذْكُرُونَ"],"marked":[3],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-7-69-10","words":["verb:dhakara"],"options":[{"bs":"i sjetite se!","en":"and (you all) remember!"},{"bs":"spominje ih","en":"he/it mentions them"},{"bs":"sjetili su se","en":"they remembered"},{"bs":"sjećate se","en":"you (all) remember"}],"ref":"7:69","answerWord":"وَٱذْكُرُوٓا۟","answerSound":"audio/6385b007c75b2535a84d.m4a","quranTranslation":{"text":"Marvel ye that there should come unto you a Reminder from your Lord by means of a man among you, that he may warn you? Remember how He made you viceroys after Noah's folk, and gave you growth of stature. Remember (all) the bounties of your Lord, that haply ye may be successful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["أَوَعَجِبْتُمْ","أَن","جَآءَكُمْ","ذِكْرٌ","مِّن","رَّبِّكُمْ","عَلَىٰ","رَجُلٍ","مِّنكُمْ","لِيُنذِرَكُمْ","وَٱذْكُرُوٓا۟","إِذْ","جَعَلَكُمْ","خُلَفَآءَ","مِنۢ","بَعْدِ","قَوْمِ","نُوحٍ","وَزَادَكُمْ","فِى","ٱلْخَلْقِ","بَصْۜطَةً","فَٱذْكُرُوٓا۟","ءَالَآءَ","ٱللَّهِ","لَعَلَّكُمْ","تُفْلِحُونَ"],"marked":[10],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-3-41-14","words":["verb:dhakara"],"options":[{"bs":"i sjeti se!","en":"and remember!"},{"bs":"biva spomenut","en":"he/it is mentioned"},{"bs":"i sjetili su se","en":"and they remembered"},{"bs":"spomenut je","en":"he/it was mentioned"}],"ref":"3:41","answerWord":"وَٱذْكُر","answerSound":"audio/4773713312812e0097c2.m4a","quranTranslation":{"text":"He said: My Lord! Appoint a token for me. (The angel) said: The token unto thee (shall be) that thou shalt not speak unto mankind three days except by signs. Remember thy Lord much, and praise (Him) in the early hours of night and morning.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["قَالَ","رَبِّ","ٱجْعَل","لِّىٓ","ءَايَةً","قَالَ","ءَايَتُكَ","أَلَّا","تُكَلِّمَ","ٱلنَّاسَ","ثَلَٰثَةَ","أَيَّامٍ","إِلَّا","رَمْزًا","وَٱذْكُر","رَّبَّكَ","كَثِيرًا","وَسَبِّحْ","بِٱلْعَشِىِّ","وَٱلْإِبْكَٰرِ"],"marked":[14],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-7-69-22","words":["verb:dhakara"],"options":[{"bs":"pa se sjetite!","en":"so (you all) remember!"},{"bs":"spomenut je","en":"he/it was mentioned"},{"bs":"i sjeti se!","en":"and remember!"},{"bs":"i sjetili su se","en":"and they remembered"}],"ref":"7:69","answerWord":"فَٱذْكُرُوٓا۟","answerSound":"audio/9af37517651b2bea64b7.m4a","quranTranslation":{"text":"Marvel ye that there should come unto you a Reminder from your Lord by means of a man among you, that he may warn you? Remember how He made you viceroys after Noah's folk, and gave you growth of stature. Remember (all) the bounties of your Lord, that haply ye may be successful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["أَوَعَجِبْتُمْ","أَن","جَآءَكُمْ","ذِكْرٌ","مِّن","رَّبِّكُمْ","عَلَىٰ","رَجُلٍ","مِّنكُمْ","لِيُنذِرَكُمْ","وَٱذْكُرُوٓا۟","إِذْ","جَعَلَكُمْ","خُلَفَآءَ","مِنۢ","بَعْدِ","قَوْمِ","نُوحٍ","وَزَادَكُمْ","فِى","ٱلْخَلْقِ","بَصْۜطَةً","فَٱذْكُرُوٓا۟","ءَالَآءَ","ٱللَّهِ","لَعَلَّكُمْ","تُفْلِحُونَ"],"marked":[22],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-19-67-1","words":["verb:dhakara"],"options":[{"bs":"sjeća se","en":"he/it remembers"},{"bs":"i sjetite se!","en":"and (you all) remember!"},{"bs":"spominje ih","en":"he/it mentions them"},{"bs":"sjeti se!","en":"remember!"}],"ref":"19:67","answerWord":"يَذْكُرُ","answerSound":"audio/8892d7ae4c863001931e.m4a","quranTranslation":{"text":"Doth not man remember that We created him before, when he was naught?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["أَوَلَا","يَذْكُرُ","ٱلْإِنسَٰنُ","أَنَّا","خَلَقْنَٰهُ","مِن","قَبْلُ","وَلَمْ","يَكُ","شَيْـًٔا"],"marked":[1],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-33-21-14","words":["verb:dhakara"],"options":[{"bs":"i sjetio se","en":"and he/it remembered"},{"bs":"i spominju","en":"and they mention"},{"bs":"i spomeni!","en":"and mention!"},{"bs":"spomenuo si","en":"you mentioned"}],"ref":"33:21","answerWord":"وَذَكَرَ","answerSound":"audio/72fb10925018dbeeb67e.m4a","quranTranslation":{"text":"Verily in the messenger of Allah ye have a good example for him who looketh unto Allah and the Last Day, and remembereth Allah much.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["لَّقَدْ","كَانَ","لَكُمْ","فِى","رَسُولِ","ٱللَّهِ","أُسْوَةٌ","حَسَنَةٌ","لِّمَن","كَانَ","يَرْجُوا۟","ٱللَّهَ","وَٱلْيَوْمَ","ٱلْءَاخِرَ","وَذَكَرَ","ٱللَّهَ","كَثِيرًا"],"marked":[14],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-76-25-0","words":["verb:dhakara"],"options":[{"bs":"i spominji!","en":"and remember!"},{"bs":"i spomenut je","en":"and he/it was mentioned"},{"bs":"i sjetite se!","en":"and (you all) remember!"},{"bs":"spominjem vas","en":"I remember you (all)"}],"ref":"76:25","answerWord":"وَٱذْكُرِ","answerSound":"audio/8fd864552db3a948f901.m4a","quranTranslation":{"text":"Remember the name of thy Lord at morn and evening.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["وَٱذْكُرِ","ٱسْمَ","رَبِّكَ","بُكْرَةً","وَأَصِيلًا"],"marked":[0],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-74-55-2","words":["verb:dhakara"],"options":[{"bs":"sjeti ga se","en":"remembers it"},{"bs":"i spominju","en":"and they mention"},{"bs":"spomeni me!","en":"mention me!"},{"bs":"sjećate se","en":"you (all) remember"}],"ref":"74:55","answerWord":"ذَكَرَهُۥ","answerSound":"audio/54d08306f14e7a7e8864.m4a","quranTranslation":{"text":"So whosoever will may heed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["فَمَن","شَآءَ","ذَكَرَهُۥ"],"marked":[2],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-2-114-7","words":["verb:dhakara"],"options":[{"bs":"biva spomenut","en":"he/it is mentioned"},{"bs":"i sjetili su se","en":"and they remembered"},{"bs":"i sjetio se","en":"and he/it remembered"},{"bs":"(ne) opamete se","en":"they (do not) take heed"}],"ref":"2:114","answerWord":"يُذْكَرَ","answerSound":"audio/3a3aa8f0fdc34d809b48.m4a","quranTranslation":{"text":"And who doth greater wrong than he who forbiddeth the approach to the sanctuaries of Allah lest His name should be mentioned therein, and striveth for their ruin. As for such, it was never meant that they should enter them except in fear. Theirs in the world is ignominy and theirs in the Hereafter is an awful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["وَمَنْ","أَظْلَمُ","مِمَّن","مَّنَعَ","مَسَٰجِدَ","ٱللَّهِ","أَن","يُذْكَرَ","فِيهَا","ٱسْمُهُۥ","وَسَعَىٰ","فِى","خَرَابِهَآ","أُو۟لَٰٓئِكَ","مَا","كَانَ","لَهُمْ","أَن","يَدْخُلُوهَآ","إِلَّا","خَآئِفِينَ","لَهُمْ","فِى","ٱلدُّنْيَا","خِزْىٌ","وَلَهُمْ","فِى","ٱلْءَاخِرَةِ","عَذَابٌ","عَظِيمٌ"],"marked":[7],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-2-152-0","words":["verb:dhakara"],"options":[{"bs":"pa me spomenite!","en":"so (you all) remember me!"},{"bs":"i spominji!","en":"and remember!"},{"bs":"pa ćete se sjetiti","en":"so you (all) will remember"},{"bs":"spominje ih","en":"he/it mentions them"}],"ref":"2:152","answerWord":"فَٱذْكُرُونِىٓ","answerSound":"audio/0d88e741a3d61fa3a766.m4a","quranTranslation":{"text":"Therefore remember Me, I will remember you. Give thanks to Me, and reject not Me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["فَٱذْكُرُونِىٓ","أَذْكُرْكُمْ","وَٱشْكُرُوا۟","لِى","وَلَا","تَكْفُرُونِ"],"marked":[0],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-2-152-1","words":["verb:dhakara"],"options":[{"bs":"spominjem vas","en":"I remember you (all)"},{"bs":"pa me spomenite!","en":"so (you all) remember me!"},{"bs":"i sjetili su se","en":"and they remembered"},{"bs":"i spomeni!","en":"and mention!"}],"ref":"2:152","answerWord":"أَذْكُرْكُمْ","answerSound":"audio/774beb242e0ee0e735b6.m4a","quranTranslation":{"text":"Therefore remember Me, I will remember you. Give thanks to Me, and reject not Me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["فَٱذْكُرُونِىٓ","أَذْكُرْكُمْ","وَٱشْكُرُوا۟","لِى","وَلَا","تَكْفُرُونِ"],"marked":[1],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-2-198-17","words":["verb:dhakara"],"options":[{"bs":"i spominjite ga!","en":"and (you all) remember him!"},{"bs":"i sjetite se!","en":"and (you all) remember!"},{"bs":"spomenut ćete ih","en":"you (all) will remember them"},{"bs":"sjeti ga se","en":"remembers it"}],"ref":"2:198","answerWord":"وَٱذْكُرُوهُ","answerSound":"audio/f437235ec1bc51eaad8c.m4a","quranTranslation":{"text":"It is no sin for you that ye seek the bounty of your Lord (by trading). But, when ye press on in the multitude from 'Arafat, remember Allah by the sacred monument. Remember Him as He hath guided you, although before ye were of those astray.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["لَيْسَ","عَلَيْكُمْ","جُنَاحٌ","أَن","تَبْتَغُوا۟","فَضْلًا","مِّن","رَّبِّكُمْ","فَإِذَآ","أَفَضْتُم","مِّنْ","عَرَفَٰتٍ","فَٱذْكُرُوا۟","ٱللَّهَ","عِندَ","ٱلْمَشْعَرِ","ٱلْحَرَامِ","وَٱذْكُرُوهُ","كَمَا","هَدَىٰكُمْ","وَإِن","كُنتُم","مِّن","قَبْلِهِۦ","لَمِنَ","ٱلضَّآلِّينَ"],"marked":[17],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-3-135-7","words":["verb:dhakara"],"options":[{"bs":"sjetili su se","en":"they remembered"},{"bs":"i spomeni!","en":"and mention!"},{"bs":"sjeća se","en":"he/it remembers"},{"bs":"i spominju","en":"and they mention"}],"ref":"3:135","answerWord":"ذَكَرُوا۟","answerSound":"audio/8a6a18a0a3dd797eed04.m4a","quranTranslation":{"text":"And those who, when they do an evil thing or wrong themselves, remember Allah and implore forgiveness for their sins - Who forgiveth sins save Allah only? - and will not knowingly repeat (the wrong) they did.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["وَٱلَّذِينَ","إِذَا","فَعَلُوا۟","فَٰحِشَةً","أَوْ","ظَلَمُوٓا۟","أَنفُسَهُمْ","ذَكَرُوا۟","ٱللَّهَ","فَٱسْتَغْفَرُوا۟","لِذُنُوبِهِمْ","وَمَن","يَغْفِرُ","ٱلذُّنُوبَ","إِلَّا","ٱللَّهُ","وَلَمْ","يُصِرُّوا۟","عَلَىٰ","مَا","فَعَلُوا۟","وَهُمْ","يَعْلَمُونَ"],"marked":[7],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-6-121-4","words":["verb:dhakara"],"options":[{"bs":"biva spomenut","en":"he/it is mentioned"},{"bs":"(ne) opamete se","en":"they (do not) take heed"},{"bs":"i sjeti se!","en":"and remember!"},{"bs":"spomeni me!","en":"mention me!"}],"ref":"6:121","answerWord":"يُذْكَرِ","answerSound":"audio/a67044ae1eac3e61708f.m4a","quranTranslation":{"text":"And eat not of that whereon Allah's name hath not been mentioned, for lo! it is abomination. Lo! the devils do inspire their minions to dispute with you. But if ye obey them, ye will be in truth idolaters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["وَلَا","تَأْكُلُوا۟","مِمَّا","لَمْ","يُذْكَرِ","ٱسْمُ","ٱللَّهِ","عَلَيْهِ","وَإِنَّهُۥ","لَفِسْقٌ","وَإِنَّ","ٱلشَّيَٰطِينَ","لَيُوحُونَ","إِلَىٰٓ","أَوْلِيَآئِهِمْ","لِيُجَٰدِلُوكُمْ","وَإِنْ","أَطَعْتُمُوهُمْ","إِنَّكُمْ","لَمُشْرِكُونَ"],"marked":[4],"facts":{"verb":"ذَكَرَ"}},{"id":"dhakara-12-42-6","words":["verb:dhakara"],"options":[{"bs":"spomeni me!","en":"mention me!"},{"bs":"i sjetite se!","en":"and (you all) remember!"},{"bs":"i spominjite ga!","en":"and (you all) remember him!"},{"bs":"spominjem vas","en":"I remember you (all)"}],"ref":"12:42","answerWord":"ٱذْكُرْنِى","answerSound":"audio/2dbcd7f131908b35d9b6.m4a","quranTranslation":{"text":"And he said unto him of the twain who he knew would be released: Mention me in the presence of thy lord. But Satan caused him to forget to mention it to his lord, so he (Joseph) stayed in prison for some years.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjećati se, spominjati","en":"to remember, to mention"},"passage":["وَقَالَ","لِلَّذِى","ظَنَّ","أَنَّهُۥ","نَاجٍ","مِّنْهُمَا","ٱذْكُرْنِى","عِندَ","رَبِّكَ","فَأَنسَىٰهُ","ٱلشَّيْطَٰنُ","ذِكْرَ","رَبِّهِۦ","فَلَبِثَ","فِى","ٱلسِّجْنِ","بِضْعَ","سِنِينَ"],"marked":[6],"facts":{"verb":"ذَكَرَ"}},{"id":"adkhala-22-14-2","words":["verb:adkhala"],"options":[{"bs":"uvodi","en":"he/it admits"},{"bs":"i zavuci!","en":"and put in!"},{"bs":"uvedi me!","en":"admit me!"},{"bs":"i uvedi nas!","en":"and admit us!"}],"ref":"22:14","answerWord":"يُدْخِلُ","answerSound":"audio/a2361be7143f4c6bb714.m4a","quranTranslation":{"text":"Lo! Allah causeth those who believe and do good works to enter Gardens underneath which rivers flow. Lo! Allah doth what He intendeth.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["إِنَّ","ٱللَّهَ","يُدْخِلُ","ٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","جَنَّٰتٍ","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَٰرُ","إِنَّ","ٱللَّهَ","يَفْعَلُ","مَا","يُرِيدُ"],"marked":[2],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-4-13-7","words":["verb:adkhala"],"options":[{"bs":"uvodi ga","en":"he/it admits him"},{"bs":"pa ih uvodi","en":"so he/it admits them"},{"bs":"i uvodi vas","en":"and he/it admits you (all)"},{"bs":"i uvodimo ih","en":"and we admit them"}],"ref":"4:13","answerWord":"يُدْخِلْهُ","answerSound":"audio/74248f23de028f2df252.m4a","quranTranslation":{"text":"These are the limits (imposed by) Allah. Whoso obeyeth Allah and His messenger, He will make him enter Gardens underneath which rivers flow, where such will dwell for ever. That will be the great success.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["تِلْكَ","حُدُودُ","ٱللَّهِ","وَمَن","يُطِعِ","ٱللَّهَ","وَرَسُولَهُۥ","يُدْخِلْهُ","جَنَّٰتٍ","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَٰرُ","خَٰلِدِينَ","فِيهَا","وَذَٰلِكَ","ٱلْفَوْزُ","ٱلْعَظِيمُ"],"marked":[7],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-3-185-13","words":["verb:adkhala"],"options":[{"bs":"i uveden je","en":"and he/it was admitted"},{"bs":"da uvede","en":"so that he/it may admit"},{"bs":"pa ih uvodi","en":"so he/it admits them"},{"bs":"uvodi ga","en":"he/it admits him"}],"ref":"3:185","answerWord":"وَأُدْخِلَ","answerSound":"audio/9e166c24a67a5f9d2cb7.m4a","quranTranslation":{"text":"Every soul will taste of death. And ye will be paid on the Day of Resurrection only that which ye have fairly earned. Whoso is removed from the Fire and is made to enter paradise, he indeed is triumphant. The life of this world is but comfort of illusion.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["كُلُّ","نَفْسٍ","ذَآئِقَةُ","ٱلْمَوْتِ","وَإِنَّمَا","تُوَفَّوْنَ","أُجُورَكُمْ","يَوْمَ","ٱلْقِيَٰمَةِ","فَمَن","زُحْزِحَ","عَنِ","ٱلنَّارِ","وَأُدْخِلَ","ٱلْجَنَّةَ","فَقَدْ","فَازَ","وَمَا","ٱلْحَيَوٰةُ","ٱلدُّنْيَآ","إِلَّا","مَتَٰعُ","ٱلْغُرُورِ"],"marked":[13],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-4-57-4","words":["verb:adkhala"],"options":[{"bs":"uvest ćemo ih","en":"we will admit them"},{"bs":"pa će ih uvesti","en":"so he/it will admit them"},{"bs":"i uvedi me!","en":"and admit me!"},{"bs":"pa su uvedeni","en":"so they were admitted"}],"ref":"4:57","answerWord":"سَنُدْخِلُهُمْ","answerSound":"audio/3bb9df9e26d8a47564c7.m4a","quranTranslation":{"text":"And as for those who believe and do good works, We shall make them enter Gardens underneath which rivers flow - to dwell therein for ever; there for them are pure companions - and We shall make them enter plenteous shade.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["وَٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","سَنُدْخِلُهُمْ","جَنَّٰتٍ","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدًا","لَّهُمْ","فِيهَآ","أَزْوَٰجٌ","مُّطَهَّرَةٌ","وَنُدْخِلُهُمْ","ظِلًّا","ظَلِيلًا"],"marked":[4],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-48-5-0","words":["verb:adkhala"],"options":[{"bs":"da uvede","en":"so that he/it may admit"},{"bs":"uvedi me!","en":"admit me!"},{"bs":"i uvodimo ih","en":"and we admit them"},{"bs":"i uvedi nas!","en":"and admit us!"}],"ref":"48:5","answerWord":"لِّيُدْخِلَ","answerSound":"audio/e6cbc5fa097f7b5d7e77.m4a","quranTranslation":{"text":"That He may bring the believing men and the believing women into Gardens underneath which rivers flow, wherein they will abide, and may remit from them their evil deeds - That, in the sight of Allah, is the supreme triumph -","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["لِّيُدْخِلَ","ٱلْمُؤْمِنِينَ","وَٱلْمُؤْمِنَٰتِ","جَنَّٰتٍ","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَٰرُ","خَٰلِدِينَ","فِيهَا","وَيُكَفِّرَ","عَنْهُمْ","سَيِّـَٔاتِهِمْ","وَكَانَ","ذَٰلِكَ","عِندَ","ٱللَّهِ","فَوْزًا","عَظِيمًا"],"marked":[0],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-4-31-9","words":["verb:adkhala"],"options":[{"bs":"i uvodimo vas","en":"and we admit you (all)"},{"bs":"i uveden je","en":"and he/it was admitted"},{"bs":"i uvodimo ih","en":"and we admit them"},{"bs":"i uvodi vas","en":"and he/it admits you (all)"}],"ref":"4:31","answerWord":"وَنُدْخِلْكُم","answerSound":"audio/6f843d74c3fecfd07825.m4a","quranTranslation":{"text":"If ye avoid the great (things) which ye are forbidden, We will remit from you your evil deeds and make you enter at a noble gate.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["إِن","تَجْتَنِبُوا۟","كَبَآئِرَ","مَا","تُنْهَوْنَ","عَنْهُ","نُكَفِّرْ","عَنكُمْ","سَيِّـَٔاتِكُمْ","وَنُدْخِلْكُم","مُّدْخَلًا","كَرِيمًا"],"marked":[9],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-4-57-17","words":["verb:adkhala"],"options":[{"bs":"i uvodimo ih","en":"and we admit them"},{"bs":"uvest će ih","en":"he/it will admit them"},{"bs":"i uvedi ih!","en":"and admit them!"},{"bs":"uvodi","en":"he/it admits"}],"ref":"4:57","answerWord":"وَنُدْخِلُهُمْ","answerSound":"audio/e6f012b24b148d5d5b9c.m4a","quranTranslation":{"text":"And as for those who believe and do good works, We shall make them enter Gardens underneath which rivers flow - to dwell therein for ever; there for them are pure companions - and We shall make them enter plenteous shade.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["وَٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","سَنُدْخِلُهُمْ","جَنَّٰتٍ","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدًا","لَّهُمْ","فِيهَآ","أَزْوَٰجٌ","مُّطَهَّرَةٌ","وَنُدْخِلُهُمْ","ظِلًّا","ظَلِيلًا"],"marked":[17],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-4-175-6","words":["verb:adkhala"],"options":[{"bs":"pa će ih uvesti","en":"so he/it will admit them"},{"bs":"i uveli smo ga","en":"and We admitted him"},{"bs":"uvedite!","en":"(you all) admit!"},{"bs":"i uveli smo ih","en":"and we admitted them"}],"ref":"4:175","answerWord":"فَسَيُدْخِلُهُمْ","answerSound":"audio/01bccef47e27e1e0c036.m4a","quranTranslation":{"text":"As for those who believe in Allah, and hold fast unto Him, them He will cause to enter into His mercy and grace, and will guide them unto Him by a straight road.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["فَأَمَّا","ٱلَّذِينَ","ءَامَنُوا۟","بِٱللَّهِ","وَٱعْتَصَمُوا۟","بِهِۦ","فَسَيُدْخِلُهُمْ","فِى","رَحْمَةٍ","مِّنْهُ","وَفَضْلٍ","وَيَهْدِيهِمْ","إِلَيْهِ","صِرَٰطًا","مُّسْتَقِيمًا"],"marked":[6],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-5-84-11","words":["verb:adkhala"],"options":[{"bs":"uvodi nas","en":"he/it admits us"},{"bs":"i uveden je","en":"and he/it was admitted"},{"bs":"i uvedi ih!","en":"and admit them!"},{"bs":"uvedi me!","en":"admit me!"}],"ref":"5:84","answerWord":"يُدْخِلَنَا","answerSound":"audio/80f82ad01e1be07bc6a2.m4a","quranTranslation":{"text":"How should we not believe in Allah and that which hath come unto us of the Truth. And (how should we not) hope that our Lord will bring us in along with righteous folk?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["وَمَا","لَنَا","لَا","نُؤْمِنُ","بِٱللَّهِ","وَمَا","جَآءَنَا","مِنَ","ٱلْحَقِّ","وَنَطْمَعُ","أَن","يُدْخِلَنَا","رَبُّنَا","مَعَ","ٱلْقَوْمِ","ٱلصَّٰلِحِينَ"],"marked":[11],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-7-151-5","words":["verb:adkhala"],"options":[{"bs":"i uvedi nas!","en":"and admit us!"},{"bs":"i uvodi vas","en":"and he/it admits you (all)"},{"bs":"i uvodi ih","en":"and he/it admits them"},{"bs":"biva uveden","en":"he/it is admitted"}],"ref":"7:151","answerWord":"وَأَدْخِلْنَا","answerSound":"audio/99115d1e467cd4ea0b49.m4a","quranTranslation":{"text":"He said: My Lord! Have mercy on me and on my brother; bring us into Thy mercy, Thou the Most Merciful of all who show mercy.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["قَالَ","رَبِّ","ٱغْفِرْ","لِى","وَلِأَخِى","وَأَدْخِلْنَا","فِى","رَحْمَتِكَ","وَأَنتَ","أَرْحَمُ","ٱلرَّٰحِمِينَ"],"marked":[5],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-9-99-19","words":["verb:adkhala"],"options":[{"bs":"uvest će ih","en":"he/it will admit them"},{"bs":"i uveli smo ih","en":"and we admitted them"},{"bs":"uvedi me!","en":"admit me!"},{"bs":"pa su uvedeni","en":"so they were admitted"}],"ref":"9:99","answerWord":"سَيُدْخِلُهُمُ","answerSound":"audio/b6625d127d71bd58f39b.m4a","quranTranslation":{"text":"And of the wandering Arabs there is he who believeth in Allah and the Last Day, and taketh that which he expendeth and also the prayers of the messenger as acceptable offerings in the sight of Allah. Lo! verily it is an acceptable offering for them. Allah will bring them into His mercy. Lo! Allah is Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["وَمِنَ","ٱلْأَعْرَابِ","مَن","يُؤْمِنُ","بِٱللَّهِ","وَٱلْيَوْمِ","ٱلْءَاخِرِ","وَيَتَّخِذُ","مَا","يُنفِقُ","قُرُبَٰتٍ","عِندَ","ٱللَّهِ","وَصَلَوَٰتِ","ٱلرَّسُولِ","أَلَآ","إِنَّهَا","قُرْبَةٌ","لَّهُمْ","سَيُدْخِلُهُمُ","ٱللَّهُ","فِى","رَحْمَتِهِۦٓ","إِنَّ","ٱللَّهَ","غَفُورٌ","رَّحِيمٌ"],"marked":[19],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-17-80-2","words":["verb:adkhala"],"options":[{"bs":"uvedi me!","en":"admit me!"},{"bs":"uvodi nas","en":"he/it admits us"},{"bs":"biva uveden","en":"he/it is admitted"},{"bs":"da uvede","en":"so that he/it may admit"}],"ref":"17:80","answerWord":"أَدْخِلْنِى","answerSound":"audio/9c8bbe384fbf09d9dc3c.m4a","quranTranslation":{"text":"And say: My Lord! Cause me to come in with a firm incoming and to go out with a firm outgoing. And give me from Thy presence a sustaining Power.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["وَقُل","رَّبِّ","أَدْخِلْنِى","مُدْخَلَ","صِدْقٍ","وَأَخْرِجْنِى","مُخْرَجَ","صِدْقٍ","وَٱجْعَل","لِّى","مِن","لَّدُنكَ","سُلْطَٰنًا","نَّصِيرًا"],"marked":[2],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-21-75-0","words":["verb:adkhala"],"options":[{"bs":"i uveli smo ga","en":"and We admitted him"},{"bs":"i uvodi ga","en":"and he admits him"},{"bs":"i uvedi ih!","en":"and admit them!"},{"bs":"uvodi nas","en":"he/it admits us"}],"ref":"21:75","answerWord":"وَأَدْخَلْنَٰهُ","answerSound":"audio/c4ae6639c52c2c89a310.m4a","quranTranslation":{"text":"And We brought him in unto Our mercy. Lo! he was of the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["وَأَدْخَلْنَٰهُ","فِى","رَحْمَتِنَآ","إِنَّهُۥ","مِنَ","ٱلصَّٰلِحِينَ"],"marked":[0],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-21-86-0","words":["verb:adkhala"],"options":[{"bs":"i uveli smo ih","en":"and we admitted them"},{"bs":"pa će ih uvesti","en":"so he/it will admit them"},{"bs":"zaista ćemo ih uvesti","en":"surely we will admit them"},{"bs":"uvodi","en":"he/it admits"}],"ref":"21:86","answerWord":"وَأَدْخَلْنَٰهُمْ","answerSound":"audio/4480e74c73da4532ce7a.m4a","quranTranslation":{"text":"And We brought them in unto Our mercy. Lo! they are among the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["وَأَدْخَلْنَٰهُمْ","فِى","رَحْمَتِنَآ","إِنَّهُم","مِّنَ","ٱلصَّٰلِحِينَ"],"marked":[0],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-22-59-0","words":["verb:adkhala"],"options":[{"bs":"zaista će ih uvesti","en":"surely he/it will admit them"},{"bs":"pa su uvedeni","en":"so they were admitted"},{"bs":"uvodi","en":"he/it admits"},{"bs":"i uvedi nas!","en":"and admit us!"}],"ref":"22:59","answerWord":"لَيُدْخِلَنَّهُم","answerSound":"audio/4bea2d2ba864fbb8a84d.m4a","quranTranslation":{"text":"Assuredly He will cause them to enter by an entry that they will love. Lo! Allah verily is Knower, Indulgent.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["لَيُدْخِلَنَّهُم","مُّدْخَلًا","يَرْضَوْنَهُۥ","وَإِنَّ","ٱللَّهَ","لَعَلِيمٌ","حَلِيمٌ"],"marked":[0],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-27-12-0","words":["verb:adkhala"],"options":[{"bs":"i zavuci!","en":"and put in!"},{"bs":"pa su uvedeni","en":"so they were admitted"},{"bs":"zaista će ih uvesti","en":"surely he/it will admit them"},{"bs":"i uveden je","en":"and he/it was admitted"}],"ref":"27:12","answerWord":"وَأَدْخِلْ","answerSound":"audio/6db8100d031f7a6a5d5c.m4a","quranTranslation":{"text":"And put thy hand into the bosom of thy robe, it will come forth white but unhurt. (This will be one) among nine tokens unto Pharaoh and his people Lo! they were ever evil-living folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["وَأَدْخِلْ","يَدَكَ","فِى","جَيْبِكَ","تَخْرُجْ","بَيْضَآءَ","مِنْ","غَيْرِ","سُوٓءٍ","فِى","تِسْعِ","ءَايَٰتٍ","إِلَىٰ","فِرْعَوْنَ","وَقَوْمِهِۦٓ","إِنَّهُمْ","كَانُوا۟","قَوْمًا","فَٰسِقِينَ"],"marked":[0],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-27-19-19","words":["verb:adkhala"],"options":[{"bs":"i uvedi me!","en":"and admit me!"},{"bs":"zaista će ih uvesti","en":"surely he/it will admit them"},{"bs":"i uveden je","en":"and he/it was admitted"},{"bs":"uvedite!","en":"(you all) admit!"}],"ref":"27:19","answerWord":"وَأَدْخِلْنِى","answerSound":"audio/4fc57e82a9c9eca74ad8.m4a","quranTranslation":{"text":"And (Solomon) smiled, laughing at her speech, and said: My Lord, arouse me to be thankful for Thy favour wherewith Thou hast favoured me and my parents, and to do good that shall be pleasing unto Thee, and include me in (the number of) Thy righteous slaves.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["فَتَبَسَّمَ","ضَاحِكًا","مِّن","قَوْلِهَا","وَقَالَ","رَبِّ","أَوْزِعْنِىٓ","أَنْ","أَشْكُرَ","نِعْمَتَكَ","ٱلَّتِىٓ","أَنْعَمْتَ","عَلَىَّ","وَعَلَىٰ","وَٰلِدَىَّ","وَأَنْ","أَعْمَلَ","صَٰلِحًا","تَرْضَىٰهُ","وَأَدْخِلْنِى","بِرَحْمَتِكَ","فِى","عِبَادِكَ","ٱلصَّٰلِحِينَ"],"marked":[19],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-29-9-4","words":["verb:adkhala"],"options":[{"bs":"zaista ćemo ih uvesti","en":"surely we will admit them"},{"bs":"i uvedi ih!","en":"and admit them!"},{"bs":"uvodi ga","en":"he/it admits him"},{"bs":"uvedite!","en":"(you all) admit!"}],"ref":"29:9","answerWord":"لَنُدْخِلَنَّهُمْ","answerSound":"audio/ddfafa08e166f9fd8ebf.m4a","quranTranslation":{"text":"And as for those who believe and do good works, We verily shall make them enter in among the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["وَٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","لَنُدْخِلَنَّهُمْ","فِى","ٱلصَّٰلِحِينَ"],"marked":[4],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-40-8-1","words":["verb:adkhala"],"options":[{"bs":"i uvedi ih!","en":"and admit them!"},{"bs":"zaista ćemo ih uvesti","en":"surely we will admit them"},{"bs":"i uvodi vas","en":"and he/it admits you (all)"},{"bs":"pa su uvedeni","en":"so they were admitted"}],"ref":"40:8","answerWord":"وَأَدْخِلْهُمْ","answerSound":"audio/1c47c9bddbdcee279998.m4a","quranTranslation":{"text":"Our Lord! And make them enter the Gardens of Eden which thou hast promised them, with such of their fathers and their wives and their descendants as do right. Lo! Thou, only Thou, art the Mighty, the Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["رَبَّنَا","وَأَدْخِلْهُمْ","جَنَّٰتِ","عَدْنٍ","ٱلَّتِى","وَعَدتَّهُمْ","وَمَن","صَلَحَ","مِنْ","ءَابَآئِهِمْ","وَأَزْوَٰجِهِمْ","وَذُرِّيَّٰتِهِمْ","إِنَّكَ","أَنتَ","ٱلْعَزِيزُ","ٱلْحَكِيمُ"],"marked":[1],"facts":{"verb":"أَدْخَلَ"}},{"id":"adkhala-40-46-8","words":["verb:adkhala"],"options":[{"bs":"uvedite!","en":"(you all) admit!"},{"bs":"i uvodimo ih","en":"and we admit them"},{"bs":"uvodi nas","en":"he/it admits us"},{"bs":"uvedi me!","en":"admit me!"}],"ref":"40:46","answerWord":"أَدْخِلُوٓا۟","answerSound":"audio/d8a3596ffc0d9cf3c65a.m4a","quranTranslation":{"text":"The Fire; they are exposed to it morning and evening; and on the day when the Hour upriseth (it is said): Cause Pharaoh's folk to enter the most awful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uvesti","en":"to admit, to make enter"},"passage":["ٱلنَّارُ","يُعْرَضُونَ","عَلَيْهَا","غُدُوًّا","وَعَشِيًّا","وَيَوْمَ","تَقُومُ","ٱلسَّاعَةُ","أَدْخِلُوٓا۟","ءَالَ","فِرْعَوْنَ","أَشَدَّ","ٱلْعَذَابِ"],"marked":[8],"facts":{"verb":"أَدْخَلَ"}},{"id":"waritha-23-11-1","words":["verb:waritha"],"options":[{"bs":"nasljeđuju","en":"they inherit"},{"bs":"i naslijedio je","en":"and he/it inherited"},{"bs":"nasljeđuje je","en":"he/it inherits her"},{"bs":"nasljeđuje me","en":"he/it inherits me"}],"ref":"23:11","answerWord":"يَرِثُونَ","answerSound":"audio/8c14e46691d79fe4928d.m4a","quranTranslation":{"text":"Who will inherit paradise. There they will abide.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"naslijediti","en":"to inherit"},"passage":["ٱلَّذِينَ","يَرِثُونَ","ٱلْفِرْدَوْسَ","هُمْ","فِيهَا","خَٰلِدُونَ"],"marked":[1],"facts":{"verb":"وَرِثَ"}},{"id":"waritha-19-6-0","words":["verb:waritha"],"options":[{"bs":"nasljeđuje me","en":"he/it inherits me"},{"bs":"nasljeđuje je","en":"he/it inherits it"},{"bs":"nasljeđujete","en":"you (all) inherit"},{"bs":"naslijedili su","en":"they inherited"}],"ref":"19:6","answerWord":"يَرِثُنِى","answerSound":"audio/8a88598669f0908f4f38.m4a","quranTranslation":{"text":"Who shall inherit of me and inherit (also) of the house of Jacob. And make him, my Lord, acceptable (unto Thee).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"naslijediti","en":"to inherit"},"passage":["يَرِثُنِى","وَيَرِثُ","مِنْ","ءَالِ","يَعْقُوبَ","وَٱجْعَلْهُ","رَبِّ","رَضِيًّا"],"marked":[0],"facts":{"verb":"وَرِثَ"}},{"id":"waritha-19-6-1","words":["verb:waritha"],"options":[{"bs":"i nasljeđuje","en":"and he/it inherits"},{"bs":"naslijedili su","en":"they inherited"},{"bs":"i naslijedit ćemo od njega","en":"and We will inherit from him"},{"bs":"nasljeđuju","en":"they inherit"}],"ref":"19:6","answerWord":"وَيَرِثُ","answerSound":"audio/d5b56d2c91fd69d970d4.m4a","quranTranslation":{"text":"Who shall inherit of me and inherit (also) of the house of Jacob. And make him, my Lord, acceptable (unto Thee).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"naslijediti","en":"to inherit"},"passage":["يَرِثُنِى","وَيَرِثُ","مِنْ","ءَالِ","يَعْقُوبَ","وَٱجْعَلْهُ","رَبِّ","رَضِيًّا"],"marked":[1],"facts":{"verb":"وَرِثَ"}},{"id":"waritha-19-40-2","words":["verb:waritha"],"options":[{"bs":"nasljeđujemo","en":"we inherit"},{"bs":"nasljeđuje me","en":"he/it inherits me"},{"bs":"nasljeđuje je","en":"he/it inherits it"},{"bs":"i naslijedit ćemo od njega","en":"and We will inherit from him"}],"ref":"19:40","answerWord":"نَرِثُ","answerSound":"audio/ed8e8546d857f56da19b.m4a","quranTranslation":{"text":"Lo! We, only We, inherit the earth and all who are thereon, and unto Us they are returned.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"naslijediti","en":"to inherit"},"passage":["إِنَّا","نَحْنُ","نَرِثُ","ٱلْأَرْضَ","وَمَنْ","عَلَيْهَا","وَإِلَيْنَا","يُرْجَعُونَ"],"marked":[2],"facts":{"verb":"وَرِثَ"}},{"id":"waritha-19-80-0","words":["verb:waritha"],"options":[{"bs":"i naslijedit ćemo od njega","en":"and We will inherit from him"},{"bs":"naslijedili su","en":"they inherited"},{"bs":"nasljeđuju","en":"they inherit"},{"bs":"i nasljeđuje","en":"and he/it inherits"}],"ref":"19:80","answerWord":"وَنَرِثُهُۥ","answerSound":"audio/a2e6b8072ea995f77b57.m4a","quranTranslation":{"text":"And We shall inherit from him that whereof he spake, and he will come unto Us, alone (without his wealth and children).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"naslijediti","en":"to inherit"},"passage":["وَنَرِثُهُۥ","مَا","يَقُولُ","وَيَأْتِينَا","فَرْدًا"],"marked":[0],"facts":{"verb":"وَرِثَ"}},{"id":"waritha-21-105-9","words":["verb:waritha"],"options":[{"bs":"nasljeđuje je","en":"he/it inherits it"},{"bs":"i nasljeđuje","en":"and he/it inherits"},{"bs":"i naslijedio je","en":"and he/it inherited"},{"bs":"nasljeđuje me","en":"he/it inherits me"}],"ref":"21:105","answerWord":"يَرِثُهَا","answerSound":"audio/27ba37ddce29219a9dd1.m4a","quranTranslation":{"text":"And verily we have written in the Scripture, after the Reminder: My righteous slaves will inherit the earth:","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"naslijediti","en":"to inherit"},"passage":["وَلَقَدْ","كَتَبْنَا","فِى","ٱلزَّبُورِ","مِنۢ","بَعْدِ","ٱلذِّكْرِ","أَنَّ","ٱلْأَرْضَ","يَرِثُهَا","عِبَادِىَ","ٱلصَّٰلِحُونَ"],"marked":[9],"facts":{"verb":"وَرِثَ"}},{"id":"waritha-27-16-0","words":["verb:waritha"],"options":[{"bs":"i naslijedio je","en":"and he/it inherited"},{"bs":"nasljeđuju","en":"they inherit"},{"bs":"naslijedili su","en":"they inherited"},{"bs":"nasljeđuje je","en":"he/it inherits it"}],"ref":"27:16","answerWord":"وَوَرِثَ","answerSound":"audio/2291cde50bad57128b8f.m4a","quranTranslation":{"text":"And Solomon was David's heir. And he said: O mankind! Lo! we have been taught the language of birds, and have been given (abundance) of all things. This surely is evident favour.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"naslijediti","en":"to inherit"},"passage":["وَوَرِثَ","سُلَيْمَٰنُ","دَاوُۥدَ","وَقَالَ","يَٰٓأَيُّهَا","ٱلنَّاسُ","عُلِّمْنَا","مَنطِقَ","ٱلطَّيْرِ","وَأُوتِينَا","مِن","كُلِّ","شَىْءٍ","إِنَّ","هَٰذَا","لَهُوَ","ٱلْفَضْلُ","ٱلْمُبِينُ"],"marked":[0],"facts":{"verb":"وَرِثَ"}},{"id":"akhza-39-40-3","words":["verb:akhza"],"options":[{"bs":"sramoti ga","en":"he/it disgraces him"},{"bs":"osramotio si ga","en":"You have disgraced him"},{"bs":"i sramoti ih","en":"and he/it disgraces them"},{"bs":"i da osramoti","en":"and so that he/it may disgrace"}],"ref":"39:40","answerWord":"يُخْزِيهِ","answerSound":"audio/3552ef8fec3a85dd041b.m4a","quranTranslation":{"text":"Who it is unto whom cometh a doom that will abase him, and on whom there falleth everlasting doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osramotiti, poniziti","en":"to disgrace, to humiliate"},"passage":["مَن","يَأْتِيهِ","عَذَابٌ","يُخْزِيهِ","وَيَحِلُّ","عَلَيْهِ","عَذَابٌ","مُّقِيمٌ"],"marked":[3],"facts":{"verb":"أَخْزَى"}},{"id":"akhza-15-69-3","words":["verb:akhza"],"options":[{"bs":"sramotite me","en":"disgrace me"},{"bs":"i sramoti ih","en":"and he/it disgraces them"},{"bs":"i da osramoti","en":"and so that he/it may disgrace"},{"bs":"osramotio si ga","en":"You have disgraced him"}],"ref":"15:69","answerWord":"تُخْزُونِ","answerSound":"audio/99a9cdb41997c87bf0e2.m4a","quranTranslation":{"text":"And keep your duty to Allah, and shame me not!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osramotiti, poniziti","en":"to disgrace, to humiliate"},"passage":["وَٱتَّقُوا۟","ٱللَّهَ","وَلَا","تُخْزُونِ"],"marked":[3],"facts":{"verb":"أَخْزَى"}},{"id":"akhza-3-192-6","words":["verb:akhza"],"options":[{"bs":"osramotio si ga","en":"You have disgraced him"},{"bs":"sramoti ih","en":"he/it disgraces them"},{"bs":"sramoti","en":"he/it disgraces"},{"bs":"sramoti ga","en":"he/it disgraces him"}],"ref":"3:192","answerWord":"أَخْزَيْتَهُۥ","answerSound":"audio/ab95b3e46c5256d5fda5.m4a","quranTranslation":{"text":"Our Lord! Whom Thou causest to enter the Fire: him indeed Thou hast confounded. For evil-doers there will be no helpers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osramotiti, poniziti","en":"to disgrace, to humiliate"},"passage":["رَبَّنَآ","إِنَّكَ","مَن","تُدْخِلِ","ٱلنَّارَ","فَقَدْ","أَخْزَيْتَهُۥ","وَمَا","لِلظَّٰلِمِينَ","مِنْ","أَنصَارٍ"],"marked":[6],"facts":{"verb":"أَخْزَى"}},{"id":"akhza-9-14-4","words":["verb:akhza"],"options":[{"bs":"i sramoti ih","en":"and he/it disgraces them"},{"bs":"sramotite me","en":"disgrace me"},{"bs":"osramotio si ga","en":"You have disgraced him"},{"bs":"i da osramoti","en":"and so that he/it may disgrace"}],"ref":"9:14","answerWord":"وَيُخْزِهِمْ","answerSound":"audio/b7ecf6f954d13d5bdc61.m4a","quranTranslation":{"text":"Fight them! Allah will chastise them at your hands, and He will lay them low and give you victory over them, and He will heal the breasts of folk who are believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osramotiti, poniziti","en":"to disgrace, to humiliate"},"passage":["قَٰتِلُوهُمْ","يُعَذِّبْهُمُ","ٱللَّهُ","بِأَيْدِيكُمْ","وَيُخْزِهِمْ","وَيَنصُرْكُمْ","عَلَيْهِمْ","وَيَشْفِ","صُدُورَ","قَوْمٍ","مُّؤْمِنِينَ"],"marked":[4],"facts":{"verb":"أَخْزَى"}},{"id":"akhza-16-27-3","words":["verb:akhza"],"options":[{"bs":"sramoti ih","en":"he/it disgraces them"},{"bs":"sramotite me","en":"disgrace me"},{"bs":"sramoti ga","en":"he/it disgraces him"},{"bs":"osramotio si ga","en":"You have disgraced him"}],"ref":"16:27","answerWord":"يُخْزِيهِمْ","answerSound":"audio/50f80eaf7619d6b9a2d2.m4a","quranTranslation":{"text":"Then on the Day of Resurrection He will disgrace them and will say: Where are My partners, for whose sake ye opposed (My guidance)? Those who have been given knowledge will say: Disgrace this day and evil are upon the disbelievers,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osramotiti, poniziti","en":"to disgrace, to humiliate"},"passage":["ثُمَّ","يَوْمَ","ٱلْقِيَٰمَةِ","يُخْزِيهِمْ","وَيَقُولُ","أَيْنَ","شُرَكَآءِىَ","ٱلَّذِينَ","كُنتُمْ","تُشَٰٓقُّونَ","فِيهِمْ","قَالَ","ٱلَّذِينَ","أُوتُوا۟","ٱلْعِلْمَ","إِنَّ","ٱلْخِزْىَ","ٱلْيَوْمَ","وَٱلسُّوٓءَ","عَلَى","ٱلْكَٰفِرِينَ"],"marked":[3],"facts":{"verb":"أَخْزَى"}},{"id":"akhza-59-5-11","words":["verb:akhza"],"options":[{"bs":"i da osramoti","en":"and so that he/it may disgrace"},{"bs":"sramoti ih","en":"he/it disgraces them"},{"bs":"sramotite me","en":"disgrace me"},{"bs":"sramoti ga","en":"he/it disgraces him"}],"ref":"59:5","answerWord":"وَلِيُخْزِىَ","answerSound":"audio/93db2ed8f88dc108f824.m4a","quranTranslation":{"text":"Whatsoever palm-trees ye cut down or left standing on their roots, it was by Allah's leave, in order that He might confound the evil-livers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osramotiti, poniziti","en":"to disgrace, to humiliate"},"passage":["مَا","قَطَعْتُم","مِّن","لِّينَةٍ","أَوْ","تَرَكْتُمُوهَا","قَآئِمَةً","عَلَىٰٓ","أُصُولِهَا","فَبِإِذْنِ","ٱللَّهِ","وَلِيُخْزِىَ","ٱلْفَٰسِقِينَ"],"marked":[11],"facts":{"verb":"أَخْزَى"}},{"id":"rajama-18-20-4","words":["verb:rajama"],"options":[{"bs":"kamenuju vas","en":"they stone you (all)"},{"bs":"zaista ću te kamenovati","en":"surely I will stone you"},{"bs":"da me (svi) kamenujete","en":"you (all) stone me"},{"bs":"zaista ćemo vas kamenovati","en":"surely we will stone you (all)"}],"ref":"18:20","answerWord":"يَرْجُمُوكُمْ","answerSound":"audio/22c2adee35b62239e3b4.m4a","quranTranslation":{"text":"For they, if they should come to know of you, will stone you or turn you back to their religion; then ye will never prosper.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kamenovati","en":"to stone"},"passage":["إِنَّهُمْ","إِن","يَظْهَرُوا۟","عَلَيْكُمْ","يَرْجُمُوكُمْ","أَوْ","يُعِيدُوكُمْ","فِى","مِلَّتِهِمْ","وَلَن","تُفْلِحُوٓا۟","إِذًا","أَبَدًا"],"marked":[4],"facts":{"verb":"رَجَمَ"}},{"id":"rajama-19-46-9","words":["verb:rajama"],"options":[{"bs":"zaista ću te kamenovati","en":"surely I will stone you"},{"bs":"kamenuju vas","en":"they stone you (all)"},{"bs":"da me (svi) kamenujete","en":"you (all) stone me"},{"bs":"zaista ćemo vas kamenovati","en":"surely we will stone you (all)"}],"ref":"19:46","answerWord":"لَأَرْجُمَنَّكَ","answerSound":"audio/add55ef2a4b663657ccd.m4a","quranTranslation":{"text":"He said: Rejectest thou my gods, O Abraham? If thou cease not, I shall surely stone thee. Depart from me a long while!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kamenovati","en":"to stone"},"passage":["قَالَ","أَرَاغِبٌ","أَنتَ","عَنْ","ءَالِهَتِى","يَٰٓإِبْرَٰهِيمُ","لَئِن","لَّمْ","تَنتَهِ","لَأَرْجُمَنَّكَ","وَٱهْجُرْنِى","مَلِيًّا"],"marked":[9],"facts":{"verb":"رَجَمَ"}},{"id":"rajama-36-18-7","words":["verb:rajama"],"options":[{"bs":"zaista ćemo vas kamenovati","en":"surely we will stone you (all)"},{"bs":"kamenuju vas","en":"they stone you (all)"},{"bs":"da me (svi) kamenujete","en":"you (all) stone me"},{"bs":"zaista ću te kamenovati","en":"surely I will stone you"}],"ref":"36:18","answerWord":"لَنَرْجُمَنَّكُمْ","answerSound":"audio/f0464fa0ae3247f28a80.m4a","quranTranslation":{"text":"(The people of the city) said: We augur ill of you. If ye desist not, we shall surely stone you, and grievous torture will befall you at our hands.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kamenovati","en":"to stone"},"passage":["قَالُوٓا۟","إِنَّا","تَطَيَّرْنَا","بِكُمْ","لَئِن","لَّمْ","تَنتَهُوا۟","لَنَرْجُمَنَّكُمْ","وَلَيَمَسَّنَّكُم","مِّنَّا","عَذَابٌ","أَلِيمٌ"],"marked":[7],"facts":{"verb":"رَجَمَ"}},{"id":"rajama-44-20-5","words":["verb:rajama"],"options":[{"bs":"da me (svi) kamenujete","en":"you (all) stone me"},{"bs":"zaista ćemo vas kamenovati","en":"surely we will stone you (all)"},{"bs":"kamenuju vas","en":"they stone you (all)"},{"bs":"zaista ću te kamenovati","en":"surely I will stone you"}],"ref":"44:20","answerWord":"تَرْجُمُونِ","answerSound":"audio/6ec2ea70b6b4d7148410.m4a","quranTranslation":{"text":"And lo! I have sought refuge in my Lord and your Lord lest ye stone me to death.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kamenovati","en":"to stone"},"passage":["وَإِنِّى","عُذْتُ","بِرَبِّى","وَرَبِّكُمْ","أَن","تَرْجُمُونِ"],"marked":[5],"facts":{"verb":"رَجَمَ"}}]