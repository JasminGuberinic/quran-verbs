ative", "pronoun": "anta", "translation": {"bs": "Siđi polako.", "en": "Come down slowly.", "bn": "ধীরে নেমে এসো।", "fa": "آرام فرود بیا.", "fr": "Descends doucement.", "id": "Turunlah dengan perlahan.", "tr": "Yavaşça in.", "ur": "آہستگی سے اترو۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِهْبِطْ", "target": true, "translation": {"bs": "siđi", "en": "descend", "bn": "তুমি নেমে যাও", "fa": "فرود بیا", "fr": "descends", "id": "turunlah", "tr": "in", "ur": "اترو"}}, {"arabic": "بِهُدُوءٍ", "target": false, "translation": {"bs": "polako", "en": "with calm", "bn": "শান্তভাবে", "fa": "با آرامش", "fr": "avec calme", "id": "dengan tenang", "tr": "sükûnetle", "ur": "سکون سے"}}]}, {"arabic": "اِهْبِطُوا إِلَى الْوَادِي", "spoken": "audio/217fded4e1ee4669955c.m4a", "tense": "imperative", "pronoun": "antum", "translation": {"bs": "Siđite u dolinu.", "en": "Go down to the valley.", "bn": "তোমরা উপত্যকায় নেমে যাও।", "fa": "شما به دره پایین بروید.", "fr": "Descendez dans la vallée.", "id": "Turunlah ke lembah, kalian semua.", "tr": "Vadiye inin.", "ur": "تم سب وادی میں اتر جاؤ۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِهْبِطُوا", "target": true, "translation": {"bs": "siđite", "en": "descend", "bn": "তোমরা নেমে যাও", "fa": "فرود بیایید", "fr": "descendez", "id": "turunlah", "tr": "inin", "ur": "تم سب اترو"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "u", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "الْوَادِي", "target": false, "translation": {"bs": "dolinu", "en": "the valley", "bn": "উপত্যকা", "fa": "دره", "fr": "la vallée", "id": "lembah", "tr": "vadi", "ur": "وادی"}}]}]}