250b52f0de187c39acd.m4a", "recitedText": "يَفْتَرُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَفْتَرِينَ", "plain": "يَفْتَرِينَ", "quran": false, "notUsed": false, "spoken": "audio/30fa3c29302cad1d5a10.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِفْتَرِ", "plain": "اِفْتَرِ", "quran": false, "notUsed": false, "spoken": "audio/c295e8d055362bc70a19.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِفْتَرِي", "plain": "اِفْتَرِي", "quran": false, "notUsed": false, "spoken": "audio/ee8c2d2328f80e5a2dd0.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِفْتَرِيَا", "plain": "اِفْتَرِيَا", "quran": false, "notUsed": false, "spoken": "audio/b2c6b12ff1afae54f6c2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِفْتَرُوا", "plain": "اِفْتَرُوا", "quran": false, "notUsed": false, "spoken": "audio/4bc699adb934f0c4b664.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِفْتَرِينَ", "plain": "اِفْتَرِينَ", "quran": false, "notUsed": false, "spoken": "audio/ec2b8b808cc8efaab6b3.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "3:94", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/387.mp3", "translation": {"en": {"text": "And whoever shall invent a falsehood after that concerning Allah, such will be wrong-doers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kim bundan sonra Allah'a karşı yalan uydurursa, işte onlar zalimlerin ta kendileridir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اس کے بعد جو اللہ پر جھوٹ باندھے تو وہی ظالم ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka barangsiapa mengada-adakan dusta terhadap Allah sesudah itu, maka merekalah orang-orang yang zalim.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَمَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱفْتَرَىٰ", "hit": true, "audio": "audio/a40b825a14e57d0e0fea.m4a", "gloss": {"bs": "(ko) izmisli", "en": "(whoever) fabricates", "tr": "(kim) iftira ederse", "fr": "(quiconque) invente", "id": "(barang siapa) mengada-adakan", "ur": "(جو) گھڑ لے", "bn": "(যে) মিথ্যা রচনা করে", "fa": "(هر که) افترا ببندد"}}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكَذِبَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْدِ", "hit": false, "audio": null, "gloss": null}, {"text": "ذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلظَّٰلِمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "10:69", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1433.mp3", "translation": {"en": {"text": "Say: Verily those who invent a lie concerning Allah will not succeed.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki: Allah'a iftira edenler elbette felah bulmazlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ وہ جو اللہ پر جھوٹ باندھتے ہیں ان کا بھلا نہ ہوگا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah: \"Sesungguhnya orang-orang yang mengada-adakan kebohongan terhadap Allah tidak beruntung\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَفْتَرُونَ", "hit": true, "audio": "audio/0250b52f0de187c39acd.m4a", "gloss": {"bs": "izmišljaju", "en": "(they) fabricate", "tr": "iftira ederler", "fr": "(ils) inventent", "id": "(mereka) mengada-adakan", "ur": "وہ گھڑتے ہیں", "bn": "(তারা) মিথ্যা রচনা করে", "fa": "(آنان) افترا می‌بندند"}}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكَذِبَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُفْلِحُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "16:56", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1957.mp3", "translation": {"en": {"text": "And they assign a portion of that which We have given them unto what they know not. By Allah! but ye will indeed be asked concerning (all) that ye used to invent.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bir de müşrikler kendilerine rızık olarak verdiğimiz şeylerden tutuyorlar mahiyetini bilmedikleri şeylere (putlara) pay ayırıyorlar. Allah'a andolsun ki, siz bu yaptığınız iftiralardan mutlaka hesaba çekileceksiniz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور انجانی چیزوں کے لیے ہماری دی ہوئی روزی میں سے حصہ مقرر کرتے ہیں خدا کی قسم تم سے ضرور سوال ہونا ہے جو کچھ جھوٹ باندھتے تھے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka sediakan untuk berhala-berhala yang mereka tiada mengetahui (kekuasaannya), satu bahagian dari rezeki yang telah Kami berikan kepada mereka. Demi Allah, sesungguhnya kamu akan ditanyai tentang apa yang telah kamu ada-adakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَجْعَلُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْلَمُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَصِيبًا", "hit": false, "audio": null, "gloss": null}, {"text": "مِّمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "رَزَقْنَٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَتُسْـَٔلُنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "عَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَفْتَرُونَ", "hit": true, "audio": "audio/9bc5a06d21cb347c0588.m4a", "gloss": {"en": "you (all) fabricate", "bs": "izmišljate laž", "tr": "yalan uyduruyorsunuz", "fr": "vous inventez des mensonges", "id": "kalian mengada-adakan dusta", "ur": "تم سب افترا باندھتے ہو", "bn": "তোমরা মিথ্যা রচনা কর", "fa": "دروغ جعل می‌کنید"}}]}, {"ref": "11:35", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1508.mp3", "translation": {"en": {"text": "Or say they (again): He hath invented it? Say: If I have invented it, upon me be my crimes, but I am innocent of (all) that ye commit.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yoksa \"Onu uydurdu\" mu diyorlar? De ki; \"Eğer uydurdumsa vebali benim boynumadır. Bense sizin yüklendiğiniz vebalden uzağım\".", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا یہ کہتے ہیں کہ انہوں نے اپنے جی سے بنالیا تم فرماؤ اگر میں نے بنالیا ہوگا تو میرا گناہ مجھ پر ہے اور میں تمہارے گناہ سے الگ ہوں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Malahan kaum Nuh itu berkata: \"Dia cuma membuat-buat nasihatnya saja\". Katakanlah: \"Jika aku membuat-buat nasihat itu, maka hanya akulah yang memikul dosaku, dan aku berlepas diri dari dosa yang kamu perbuat\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُولُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱفْتَرَىٰهُ", "hit": true, "audio": "audio/db5f82bd2382b636e27d.m4a", "gloss": {"en": "he/it fabricated it", "bs": "izmislio ga je", "tr": "onu uydurdu", "fr": "il l'a inventé", "id": "dia telah mengada-adakannya", "ur": "اُس نے افترا باندھا", "bn": "সে তা রচনা করেছে", "fa": "آن را جعل کرد"}}, {"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱفْتَرَيْتُهُۥ", "hit": true, "audio": "audio/02be770e2a784348e3d3.m4a", "gloss": {"en": "I fabricated it", "bs": "izmislio sam ga", "tr": "onu uydurdum", "fr": "je l'ai inventé", "id": "aku telah mengada-adakannya", "ur": "میں نے اسے افترا باندھا", "bn": "আমি তা রচনা করেছি", "fa": "آن را جعل کردم"}}, {"text": "فَعَلَىَّ", "hit": false, "audio": null, "gloss": null}, {"text": "إِجْرَامِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنَا۠", "hit": false, "audio": null, "gloss": null}, {"text": "بَرِىٓءٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تُجْرِمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "16:105", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2006.mp3", "translation": {"en": {"text": "Only they invent falsehood who believe not Allah's revelations, and (only) they are the liars.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yalanı ancak Allah'ın âyetlerine inanmayanlar uydurur. İşte onlar yalancıların ta kendileridir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جھوٹ بہتان دہی باندھتے ہین جو اللہ کی آیتوں پر ایمان نہیں رکھتے اور دہی جھوٹے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya yang mengada-adakan kebohongan, hanyalah orang-orang yang tidak beriman kepada ayat-ayat Allah, dan mereka itulah orang-orang pendusta.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَفْتَرِى", "hit": true, "audio": "audio/8130d4a93d2f4e9cc869.m4a", "gloss": {"en": "he/it fabricates", "bs": "izmišlja laž", "tr": "yalan uydurur", "fr": "il invente un mensonge", "id": "dia mengada-adakan dusta", "ur": "وہ افترا باندھتا ہے", "bn": "সে মিথ্যা রচনা করে", "fa": "دروغ جعل می‌کند"}}, {"text": "ٱلْكَذِبَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُؤْمِنُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِـَٔايَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكَٰذِبُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَفْتَرُونَ", "count": 17, "first": "3:24", "audio": "audio/0250b52f0de187c39acd.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "izmišljaju", "en": "(they) fabricate", "tr": "iftira ederler", "fr": "(ils) inventent", "id": "(mereka) mengada-adakan", "ur": "وہ گھڑتے ہیں", "bn": "(তারা) মিথ্যা রচনা করে", "fa": "(آنان) افترا می‌بندند"}}, {"arabic": "ٱفْتَرَىٰ", "count": 13, "first": "3:94", "audio": "audio/a40b825a14e57d0e0fea.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "(ko) izmisli", "en": "(whoever) fabricates", "tr": "(kim) iftira ederse", "fr": "(qu