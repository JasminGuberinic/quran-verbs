rue, "translation": {"bs": "uspijeva", "en": "succeeds", "bn": "সফল হয়", "fa": "کامیاب می‌شود", "fr": "réussit", "id": "berhasil", "tr": "başarır", "ur": "وہ کامیاب ہوتا ہے"}}]}, {"arabic": "يُفْلِحُونَ فِي عَمَلِهِمْ", "spoken": "audio/72f12996222b2da2d8cd.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Uspijevaju u svom poslu.", "en": "They succeed in their work.", "bn": "তারা তাদের কাজে সফল হয়।", "fa": "در کارشان موفق می‌شوند.", "fr": "Ils réussissent dans leur travail.", "id": "Mereka berhasil dalam pekerjaan mereka.", "tr": "İşlerinde başarılı olurlar.", "ur": "وہ اپنے کام میں کامیاب ہوتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "يُفْلِحُونَ", "target": true, "translation": {"bs": "uspijevaju", "en": "they succeed", "bn": "তারা সফল হয়", "fa": "کامیاب می‌شوند", "fr": "ils réussissent", "id": "mereka berhasil", "tr": "başarırlar", "ur": "وہ کامیاب ہوتے ہیں"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "u", "en": "in", "bn": "মধ্যে", "fa": "در", "fr": "dans", "id": "di", "tr": "içinde", "ur": "میں"}}, {"arabic": "عَمَلِهِمْ", "target": false, "translation": {"bs": "svom poslu", "en": "their work", "bn": "তাদের কাজ", "fa": "کارشان", "fr": "à leur travail", "id": "pekerjaan mereka", "tr": "işlerinde", "ur": "ان کا کام"}}]}, {"arabic": "تُفْلِحُونَ بِالصَّبْرِ", "spoken": "audio/d4bfc5a64979f62b571d.m4a", "tense": "present", "pronoun": "antum", "translation": {"bs": "Uspijevate strpljenjem.", "en": "You succeed through patience.", "bn": "তোমরা ধৈর্যের মাধ্যমে সফল হও।", "fa": "با صبر موفق می‌شوید.", "fr": "Vous réussissez par la patience.", "id": "Kalian berhasil dengan kesabaran.", "tr": "Sabırla başarırsınız.", "ur": "تم صبر سے کامیاب ہوتے ہو۔"}, "independentlyReviewed": true, "words": [{"arabic": "تُفْلِحُونَ", "target": true, "translation": {"bs": "uspijevate", "en": "you succeed", "bn": "তোমরা সফল হও", "fa": "کامیاب می‌شوید", "fr": "vous réussissez", "id": "kalian berhasil", "tr": "başarırsınız", "ur": "تم کامیاب ہوتے ہو"}}, {"arabic": "بِالصَّبْرِ", "target": false, "translation": {"bs": "strpljenjem", "en": "through patience", "bn": "ধৈর্যের মাধ্যমে", "fa": "با صبر", "fr": "par la patience", "id": "dengan kesabaran", "tr": "sabırla", "ur": "صبر سے"}}]}]}