{"rank": 172, "root": "عرف", "form": 1, "lemma": "عَرَفَ", "count": 20, "ayahCount": 17, "share": 0.1, "meaning": {"bs": "znati, prepoznati", "en": "to know, to recognize", "tr": "bilmek, tanımak", "fr": "connaître, reconnaître", "id": "mengetahui, mengenal", "ur": "جاننا، پہچاننا", "bn": "জানা, চিনতে পারা", "fa": "دانستن، شناختن"}, "lemmaSpoken": "audio/1e5546f14134d7eaf5bc.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "عَرَفَ", "plain": "عَرَفَ", "quran": false, "notUsed": false, "spoken": "audio/1e5546f14134d7eaf5bc.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَعْرِفُ", "plain": "يَعْرِفُ", "quran": false, "notUsed": false, "spoken": "audio/a25e1310a99bf5ff25c6.m4a", "recited": null, "recitedText": null}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "عَرَفْتُ", "plain": "عَرَفْتُ", "quran": false, "notUsed": false, "spoken": "audio/63ccac889c99d0c7e3d2.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "عَرَفْنَا", "plain": "عَرَفْنَا", "quran": false, "notUsed": false, "spoken": "audio/c7302c458fcadc8f922b.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "عَرَفْتَ", "plain": "عَرَفْتَ", "quran": false, "notUsed": false, "spoken": "audio/557939b8db06399ccfd6.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "عَرَفْتِ", "plain": "عَرَفْتِ", "quran": false, "notUsed": false, "spoken": "audio/04e9f2598887a96792d5.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "عَرَفْتُمَا", "plain": "عَرَفْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/c3ee1b7ccdec0a5c8931.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "عَرَفْتُمْ", "plain": "عَرَفْتُمْ", "quran": false, "notUsed": false, "spoken": "audio/1fbf2bcfdaa4913c0ae6.m4a", "recited": null, "recitedTe