, {"tense": "present", "pronoun": "nahnu", "arabic": "نَقْضِي", "plain": "نَقْضِي", "quran": false, "notUsed": false, "spoken": "audio/735ed4c94adbba06bb33.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "anta", "arabic": "تَقْضِى", "plain": "تَقْضِي", "quran": true, "notUsed": false, "spoken": "audio/6bb6ad6cc84c2bc5da53.m4a", "recited": "audio/5e6246955fcf3b402bd7.m4a", "recitedText": "تَقْضِى"}, {"tense": "present", "pronoun": "anti", "arabic": "تَقْضِينَ", "plain": "تَقْضِينَ", "quran": false, "notUsed": false, "spoken": "audio/02edc1ad66e7abd13d30.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تَقْضِيَانِ", "plain": "تَقْضِيَانِ", "quran": false, "notUsed": false, "spoken": "audio/b1ba978894e1e9572d38.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَقْضُونَ", "plain": "تَقْضُونَ", "quran": false, "notUsed": false, "spoken": "audio/033198e6b8b4cc8cdc24.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antunna", "arabic": "تَقْضِينَ", "plain": "تَقْضِينَ", "quran": false, "notUsed": false, "spoken": "audio/02edc1ad66e7abd13d30.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَقْضِى", "plain": "يَقْضِي", "quran": true, "notUsed": false, "spoken": "audio/2e587eb593de817ae744.m4a", "recited": "audio/9a5cea9e4c06430128c6.m4a", "recitedText": "يَقْضِى"}, {"tense": "present", "pronoun": "hiya", "arabic": "تَقْضِي", "plain": "تَقْضِي", "quran": false, "notUsed": false, "spoken": "audio/6bb6ad6cc84c2bc5da53.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يَقْضِيَانِ", "plain": "يَقْضِيَانِ", "quran": false, "notUsed": false, "spoken": "audio/07688127962a56ec93f6.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَقْضُونَ", "plain": "يَقْضُونَ", "quran": true, "notUsed": false, "spoken": "audio/937457f1ac6019865e1d.m4a", "recited": "audio/c62a68478442edd25dd7.m4a", "recitedText": "يَقْضُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَقْضِينَ", "plain": "يَقْضِينَ", "quran": false, "notUsed": false, "spoken": "audio/33f0003422ec35d085ad.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱقْضِ", "plain": "اِقْضِ", "quran": true, "notUsed": false, "spoken": "audio/d3b4cd1bdcd4c21de17d.m4a", "recited": "audio/63f5320ba8b958fe58b9.m4a", "recitedText": "فَٱقْضِ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِقْضِي", "plain": "اِقْضِي", "quran": false, "notUsed": false, "spoken": "audio/17607f6b7820eb0c1f5d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِقْضِيَا", "plain": "اِقْضِيَا", "quran": false, "notUsed": false, "spoken": "audio/2a6aa1d10ee6607af51e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱقْضُوٓا۟", "plain": "اِقْضُوا", "quran": true, "notUsed": false, "spoken": "audio/df5da0901b492ba8133b.m4a", "recited": "audio/f310c2cc2238598cb53f.m4a", "recitedText": "ٱقْضُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِقْضِينَ", "plain": "اِقْضِينَ", "quran": false, "notUsed": false, "spoken": "audio/64eea0d5ce959dc3cd63.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "2:117", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/124.mp3", "translation": {"en": {"text": "The Originator of the heavens and the earth! When He decreeth a thing, He saith unto it only: Be! and it is.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O, göklerin ve yerin yoktan var edicisidir ve O, bir işin olmasını murad edince, ona yalnızca \"ol!\" der, o da hemen oluverir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "نیا پیدا کرنے والا آسمانوں اور زمین کا اور جب کسی بات کا حکم فرمائے تو اس سے یہی فرماتا ہے کہ ہو جا وہ فورا ً ہوجاتی ہے-", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah Pencipta langit dan bumi, dan bila Dia berkehendak (untuk menciptakan) sesuatu, maka (cukuplah) Dia hanya mengatakan kepadanya: \"Jadilah!\" Lalu jadilah ia.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "بَدِيعُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمَٰوَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "قَضَىٰٓ", "hit": true, "audio": "audio/26f15297e62667fa8b55.m4a", "gloss": {"en": "he/it decreed", "bs": "odredio je", "tr": "takdir etti", "fr": "il a décrété", "id": "dia telah menetapkan", "ur": "اُس نے فیصلہ کیا", "bn": "সে নির্ধারণ করল", "fa": "مقدر کرد"}}, {"text": "أَمْرًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُولُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "كُن", "hit": false, "audio": null, "gloss": null}, {"text": "فَيَكُونُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "80:23", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5781.mp3", "translation": {"en": {"text": "Nay, but (man) hath not done what He commanded him.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hayır hayır, doğrusu o, hiç Allah'ın emrini tam yerine getirmedi,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کوئی نہیں، اس نے اب تک پورا نہ کیا جو اسے حکم ہوا تھا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sekali-kali jangan; manusia itu belum melaksanakan apa yang diperintahkan Allah kepadanya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَقْضِ", "hit": true, "audio": "audio/8d952f7c13f61496ecd2.m4a", "gloss": {"bs": "(još nije) izvršio", "en": "(he has not yet) carried out", "tr": "(henüz) yerine getirmedi", "fr": "(il n'a pas encore) accompli", "id": "(dia belum) melaksanakan", "ur": "(ابھی) پورا نہیں کیا", "bn": "(সে এখনও) সম্পন্ন করেনি", "fa": "(هنوز) به انجام نرسانده است"}}, {"text": "مَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمَرَهُۥ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:66", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1868.mp3", "translation": {"en": {"text": "And We made plain the case to him, that the root of them (who did wrong) was to be cut at early morn.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz, Lût'a şu kesin emri vahyettik: \"Bu kâfirler sabaha çıkarken muhakkak kökleri kesilmiş olacaktır.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے اسے اس حکم کا فیصلہ سنادیا کہ صبح ہوتے ان کافروں کی جڑ کٹ جائے گی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan telah Kami wahyukan kepadanya (Luth) perkara itu, yaitu bahwa mereka akan ditumpas habis di waktu subuh.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَضَيْنَآ", "hit": true, "audio": "audio/9fe18ff13e74156d7ff7.m4a", "gloss": {"bs": "i obznanili smo (odluku)", "en": "and We decreed", "tr": "ve hükmettik", "fr": "et Nous avons décrété", "id": "dan Kami menetapkan", "ur": "اور ہم نے فیصلہ کر دیا", "bn": "এবং আমরা ফয়সালা করেছিলাম", "fa": "و حکم کردیم"}}, {"text": "إِلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "ذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَمْرَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "دَابِرَ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰٓؤُلَآءِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَقْطُوعٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مُّصْبِحِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "22:29", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2624.mp3", "translation": {"en": {"text": "Then let them make an end of their unkemptness and pay their vows and go around the ancient House.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra kirlerini giderip temizlensinler. Adaklarını yerine getirsinler. Kâbeyi tavaf etsinler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر اپنا میل کچیل اتاریں اور اپنی منتیں پوری کریں اور اس آزاد گھر کا طواف کریں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian, hendaklah mereka menghilangkan kotoran yang ada pada badan mereka dan hendaklah mereka menyempurnakan nazar-nazar mereka dan hendaklah mereka melakukan melakukan thawaf sekeliling rumah yang tua itu (Baitullah).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "لْيَقْضُوا۟", "hit": true, "audio": "audio/a1049a0e921ea1d828c0.m4a", "gloss": {"en": "so that they may finish", "bs": "da završe", "tr": "tamamlasınlar diye", "fr": "qu'ils achèvent", "id": "agar mereka menyelesaikan", "ur": "تاکہ وہ پورا کریں", "bn": "যাতে তারা সম্পন্ন করে", "fa": "تا به پایان برسانند"}}, {"text": "تَفَثَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلْيُوفُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "نُذُورَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلْيَطَّوَّفُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْبَيْتِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَتِيقِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "لَقُضِىَ", "count": 6, "first": "6:58", "audio": "audio/48c2acc2b10b4208c31d.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}]}, {"arabic": "قُضِىَ", "count": 6, "first": "10:47", "audio": "audio/833edda98f434c8bf70f.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "it was decreed; it was judged; it was finished", "bs": "određeno je; presuđeno je; završeno je", "tr": "takdir edildi; hükme bağlandı", "fr": "il a été décrété ; il a été jugé ; il a été accompli", "id": "telah ditetapkan; telah diputuskan; telah diselesaikan", "ur": "فیصلہ کیا گیا", "bn": "নির্ধারিত হয়েছে; মীমাংসা হয়েছে; সম্পন্ন হয়েছে", "fa": "مقدر شد؛ حکم شد؛ به انجام رسید"}}, {"arabic": "قَضَىٰٓ", "count": 5, "first": "2:117", "audio": "audio/26f15297e62667fa8b55.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it decreed", "bs": "odredio je", "tr": "takdir etti", "fr": "il a décrété", "id": "dia telah menetapkan", "ur": "اُس نے فیصلہ کیا", "bn": "সে নির্ধারণ করল", "fa": "مقدر کرد"}}, {"arabic": "وَقُضِىَ", "count": 5, "first": "2:210", "audio": "audio/46040dcbdd358be47aff.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "and it was judged; and it was decreed", "bs": "i presuđeno je; i određeno je", "tr": "ve hükme bağlandı", "fr": "et il a été décidé", "id": "dan telah diputuskan; dan telah ditetapkan", "ur": "اور فیصلہ کیا گیا", "bn": "এবং মীমাংসা হয়েছে; এবং নির্ধারিত হয়েছে", "fa": "و حکم شد؛ و مقدر شد"}}, {"arabic": "يَقْضِى", "count": 4, "first": "10:93", "audio": "audio/9a5cea9e4c06430128c6.m4a", "grammar": [{"tense": "prese