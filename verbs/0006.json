{"rank": 6, "root": "كفر", "form": 1, "lemma": "كَفَرَ", "count": 289, "ayahCount": 269, "share": 1.49, "meaning": {"bs": "ne vjerovati, poricati", "en": "to disbelieve", "tr": "inkâr etmek", "fr": "mécroire, renier", "id": "mengingkari, kafir", "ur": "کفر کرنا", "bn": "কুফরি করা, অবিশ্বাস করা", "fa": "کفر ورزیدن، ایمان نیاوردن"}, "lemmaSpoken": "audio/0f91282dc0f9cc32fe5f.m4a", "animation": "", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "كَفَرَ", "plain": "كَفَرَ", "quran": true, "notUsed": false, "spoken": "audio/0f91282dc0f9cc32fe5f.m4a", "recited": "audio/754e7bb34fd75e092a02.m4a", "recitedText": "كَفَرَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَكْفُرُ", "plain": "يَكْفُرُ", "quran": true, "notUsed": false, "spoken": "audio/5894a292e03d3f64a791.m4a", "recited": "audio/f6172a4879e1fadaadcc.m4a", "recitedText": "يَكْفُرُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱكْفُرْ", "plain": "اُكْفُرْ", "quran": true, "notUsed": false, "spoken": "audio/4f59a5f2f1e785f4a1c7.m4a", "recited": "audio/675a21fc4b32b1e46edc.m4a", "recitedText": "ٱكْفُرْ"}], "nouns": {"participle": {"lemma": "كافِر", "count": 129, "spoken": "audio/a15ff85ca9725c6c4e31.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "كَفَرْتُ", "plain": "كَفَرْتُ", "quran": true, "notUsed": false, "spoken": "audio/bd5e27d80396f0df7b05.m4a", "recited": "audio/f5370d4881c7cf51527c.m4a", "recitedText": "كَفَرْتُ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "كَفَرْنَا", "plain": "كَفَرْنَا", "quran": true, "notUsed": false, "spoken": "audio/f2aa7acdf0a175532ed7.m4a", "recited": "audio/5620ddac0fc1db6161db.m4a", "recitedText": "كَفَرْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "كَفَرْتَ", "plain": "كَفَرْتَ", "quran": true, "notUsed": false, "spoken": "audio/a95628c5ed75fc791283.m4a", "recited": "audio/0392af8feb2523f4544c.m4a", "recitedText": "أَكَفَرْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "كَفَرْتِ", "plain": "كَفَرْتِ", "quran"