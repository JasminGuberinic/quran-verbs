d": false, "spoken": "audio/9c71e7242c3419805dc2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِحْلِفَا", "plain": "اِحْلِفَا", "quran": false, "notUsed": false, "spoken": "audio/aa8da3006ff958c4469c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِحْلِفُوا", "plain": "اِحْلِفُوا", "quran": false, "notUsed": false, "spoken": "audio/cd9073721e15a308d573.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِحْلِفْنَ", "plain": "اِحْلِفْنَ", "quran": false, "notUsed": false, "spoken": "audio/dbdf07cf83c60558f30a.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "9:56", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1291.mp3", "translation": {"en": {"text": "And they swear by Allah that they are in truth of you, when they are not of you, but they are folk who are afraid.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hiç şüphesiz onlar, sizden olduklarına dair yemin de ederler. Halbuki sizden değildirler. Fakat onlar öyle bir kavimdirler ki, korkudan ödleri patlıyor.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اللہ کی قسمیں کھاتے ہیں کہ وہ تم میں سے ہیں اور تم میں سے ہیں نہیں ہاں وہ لوگ ڈرتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka (orang-orang munafik) bersumpah dengan (nama) Allah, bahwa sesungguhnya mereka termasuk golonganmu; padahal mereka bukanlah dari golonganmu, akan tetapi mereka adalah orang-orang yang sangat takut (kepadamu).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَحْلِفُونَ", "hit": true, "audio": "audio/284b9b7aeb41bce7829c.m4a", "gloss": {"bs": "i zaklinju se", "en": "and they swear", "tr": "ve yemin ederler", "fr": "et ils jurent", "id": "dan mereka