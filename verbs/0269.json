fb867cda2cb08c749380.m4a", "gloss": {"bs": "da bi odsjekao", "en": "that He might cut off", "tr": "kesmesi için", "fr": "afin qu'Il retranche", "id": "agar Dia memotong", "ur": "تاکہ وہ کاٹ دے", "bn": "যাতে তিনি কেটে দেন", "fa": "تا ببرد"}}, {"text": "طَرَفًا", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَرُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَكْبِتَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَيَنقَلِبُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "خَآئِبِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "69:46", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5369.mp3", "translation": {"en": {"text": "And then severed his life-artery,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra da onun şah damarını keser atardık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر ان کی رگِ دل کاٹ دیتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian benar-benar Kami potong urat tali jantungnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "لَقَطَعْنَا", "hit": true, "audio": "audio/c744ec6a793468bead8f.m4a", "gloss": {"bs": "presjekli bismo", "en": "We would have cut", "tr": "keserdik", "fr": "Nous aurions coupé", "id": "niscaya Kami memotong", "ur": "ہم ضرور کاٹ دیتے", "bn": "আমরা অবশ্যই কেটে দিতাম", "fa": "قطعاً می‌بریدیم"}}, {"text": "مِنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْوَتِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَيَقْطَعُونَ", "count": 2, "first": "2:27", "audio": "