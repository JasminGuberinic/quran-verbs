{"rank": 13, "root": "خلق", "form": 1, "lemma": "خَلَقَ", "count": 184, "ayahCount": 168, "share": 0.95, "meaning": {"bs": "stvoriti", "en": "to create", "tr": "yaratmak", "fr": "créer", "id": "menciptakan", "ur": "پیدا کرنا", "bn": "সৃষ্টি করা", "fa": "آفریدن"}, "lemmaSpoken": "audio/9c232311cf7dc5d11f10.m4a", "animation": "<svg class=\"va va-vkhlq_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes vkhlq_1-0{from{transform:scale(0)}}.va-vkhlq_1 .a0{transform-origin:30px 36px;animation:vkhlq_1-0 0.6s ease-out both}.va-vkhlq_1 .a1{transform-origin:60px 36px;animation:vkhlq_1-0 0.6s ease-out 0.5s both}.va-vkhlq_1 .a2{transform-origin:90px 38px;animation:vkhlq_1-0 0.6s ease-out 1.0s both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-vkhlq_1.off,.va-vkhlq_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-vkhlq_1,.va-vkhlq_1 *{animation:none!important}}</style><circle class=\"q a0\" cx=\"30\" cy=\"36\" r=\"10\"/><rect class=\"q a1\" x=\"50\" y=\"26\" width=\"20\" height=\"20\" rx=\"1\"/><path class=\"q a2\" d=\"M90 26l11 20H79z\"/></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "خَلَقَ", "plain": "خَلَقَ", "quran": true, "notUsed": false, "spoken": "audio/9c232311cf7dc5d11f10.m4a", "recited": "audio/98ec23acf9d481a799d4.m4a", "recitedText": "خَلَقَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَخْلُقُ", "plain": "يَخْلُقُ", "quran": true, "notUsed": false, "spoken": "audio/08f20e7d7622dc86acea.m4a", "recited": "audio/ba1160f9d72e567d258f.m4a", "recitedText": "يَخْلُقُ"}], "nouns": {"participle": {"lemma": "خالِق", "count": 12, "spoken": "audio/9712917a2a7bd3fa90f3.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "خَلَقْتُ", "plain": "خَلَقْتُ", "quran": true, "notUsed": false, "spoken": "audio/92466dcf4038670ef3c2.m4a", "recited": "audio/c3dd6bdd3187b9d0c085.m4a", "recitedText": "خَلَقْتُ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "خَلَقْنَا", "plain": "خَلَقْنَا", "quran": true, "notUsed": false, "spoken": "audio/869257502a86f1eea80a.m4a", "recited": "audio/a13ccb3257cb29b01342.m4a", "recitedText": "خَلَقْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "خَلَقْتَ", "plain": "خَلَقْتَ", "quran": true, "notUsed": false, "spoken": "audio/b6ae4635f1f6ea304bf3.m4a", "recited": "audio/2af5a994d165af632aa5.m4a", "recitedText": "خَلَقْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "خَلَقْتِ", "plain": "خَلَقْتِ", "quran": false, "notUsed": false, "spoken": "audio/da1b802cfba175a85641.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "خَلَقْتُمَا", "plain": "خَلَقْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/a414e455d1182bbf034b.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "خَلَقْتُمْ", "plain": "خَلَقْتُمْ", "quran": false, "notUsed": false, "spoken": "audio/bb13b1dd73c44198eca8.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antunna", "arabic": "خَلَقْتُنَّ", "plain": "خَلَقْتُنَّ", "quran": false, "notUsed": false, "spoken": "audio/e01d983f025540b865f4.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huwa", "arabic": "خَلَقَ", "plain": "خَلَقَ", "quran": true, "notUsed": false, "spoken": "audio/9c232311cf7dc5d11f10.m4a", "recited": "audio/98ec23acf9d481a799d4.m4a", "recitedText": "خَلَقَ"}, {"tense": "past", "pronoun": "hiya", "arabic": "خَلَقَتْ", "plain": "خَلَقَتْ", "quran": false, "notUsed": false, "spoken": "audio/99ec7807a5461f3e5c69.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huma", "arabic": "خَلَقَا", "plain": "خَلَقَا", "quran": false, "notUsed": false, "spoken": "audio/27fef3a15cd8cf447ebc.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hum