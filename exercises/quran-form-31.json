[{"id":"aqala-37-138-2","words":["verb:aqala"],"options":[{"bs":"(zar ne) razumijete","en":"(will you not) understand"},{"bs":"razumjeli su ga","en":"they understood it"},{"bs":"razumije ih","en":"he/it understands them"},{"bs":"razumijemo","en":"we understand"}],"ref":"37:138","answerWord":"تَعْقِلُونَ","answerSound":"audio/3b3c9e1aa3d7748371fe.m4a","quranTranslation":{"text":"And at night-time; have ye then no sense?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"razumjeti, shvatiti","en":"to understand, to reason"},"passage":["وَبِٱلَّيْلِ","أَفَلَا","تَعْقِلُونَ"],"marked":[2],"facts":{"verb":"عَقَلَ"}},{"id":"aqala-29-35-6","words":["verb:aqala"],"options":[{"bs":"razumiju","en":"they understand"},{"bs":"razumije ih","en":"he/it understands them"},{"bs":"razumjeli su ga","en":"they understood it"},{"bs":"razumijemo","en":"we understand"}],"ref":"29:35","answerWord":"يَعْقِلُونَ","answerSound":"audio/2636b654c89dd0239cfc.m4a","quranTranslation":{"text":"And verily of that We have left a clear sign for people who have sense.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"razumjeti, shvatiti","en":"to understand, to reason"},"passage":["وَلَقَد","تَّرَكْنَا","مِنْهَآ","ءَايَةًۢ","بَيِّنَةً","لِّقَوْمٍ","يَعْقِلُونَ"],"marked":[6],"facts":{"verb":"عَقَلَ"}},{"id":"aqala-2-75-16","words":["verb:aqala"],"options":[{"bs":"razumjeli su ga","en":"they understood it"},{"bs":"razumijemo","en":"we understand"},{"bs":"razumije ih","en":"he/it understands them"},{"bs":"(zar ne) razumijete","en":"(will you not) understand"}],"ref":"2:75","answerWord":"عَقَلُوهُ","answerSound":"audio/3c38ff82b1910459d2ae.m4a","quranTranslation":{"text":"Have ye any hope that they will be true to you when a party of them used to listen to the word of Allah, then used to change it, after they had understood it, knowingly?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"razumjeti, shvatiti","en":"to understand, to reason"},"passage":["أَفَتَطْمَعُونَ","أَن","يُؤْمِنُوا۟","لَكُمْ","وَقَدْ","كَانَ","فَرِيقٌ","مِّنْهُمْ","يَسْمَعُونَ","كَلَٰمَ","ٱللَّهِ","ثُمَّ","يُحَرِّفُونَهُۥ","مِنۢ","بَعْدِ","مَا","عَقَلُوهُ","وَهُمْ","يَعْلَمُونَ"],"marked":[16],"facts":{"verb":"عَقَلَ"}},{"id":"aqala-29-43-5","words":["verb:aqala"],"options":[{"bs":"razumije ih","en":"he/it understands them"},{"bs":"razumijemo","en":"we understand"},{"bs":"(zar ne) razumijete","en":"(will you not) understand"},{"bs":"razumiju","en":"they understand"}],"ref":"29:43","answerWord":"يَعْقِلُهَآ","answerSound":"audio/ff6cc7ab54640ffb9d94.m4a","quranTranslation":{"text":"As for these similitudes, We coin them for mankind, but none will grasp their meaning save the wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"razumjeti, shvatiti","en":"to understand, to reason"},"passage":["وَتِلْكَ","ٱلْأَمْثَٰلُ","نَضْرِبُهَا","لِلنَّاسِ","وَمَا","يَعْقِلُهَآ","إِلَّا","ٱلْعَٰلِمُونَ"],"marked":[5],"facts":{"verb":"عَقَلَ"}},{"id":"aqala-67-10-5","words":["verb:aqala"],"options":[{"bs":"razumijemo","en":"we understand"},{"bs":"razumije ih","en":"he/it understands them"},{"bs":"razumiju","en":"they understand"},{"bs":"(zar ne) razumijete","en":"(will you not) understand"}],"ref":"67:10","answerWord":"نَعْقِلُ","answerSound":"audio/3f13103aeb59e2f9f320.m4a","quranTranslation":{"text":"And they say: Had we been wont to listen or have sense, we had not been among the dwellers in the flames.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"razumjeti, shvatiti","en":"to understand, to reason"},"passage":["وَقَالُوا۟","لَوْ","كُنَّا","نَسْمَعُ","أَوْ","نَعْقِلُ","مَا","كُنَّا","فِىٓ","أَصْحَٰبِ","ٱلسَّعِيرِ"],"marked":[5],"facts":{"verb":"عَقَلَ"}},{"id":"makara-27-70-8","words":["verb:makara"],"options":[{"bs":"spletkare","en":"they plot"},{"bs":"i spletkario je","en":"and he/it plotted"},{"bs":"smislili ste ga","en":"you (all) plotted it"},{"bs":"i smišljali su spletku","en":"and they plotted"}],"ref":"27:70","answerWord":"يَمْكُرُونَ","answerSound":"audio/02f8246e5c1a3d211df7.m4a","quranTranslation":{"text":"And grieve thou not for them, nor be in distress because of what they plot (against thee).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَلَا","تَحْزَنْ","عَلَيْهِمْ","وَلَا","تَكُن","فِى","ضَيْقٍ","مِّمَّا","يَمْكُرُونَ"],"marked":[8],"facts":{"verb":"مَكَرَ"}},{"id":"makara-71-22-0","words":["verb:makara"],"options":[{"bs":"i smišljali su spletku","en":"and they plotted"},{"bs":"spletkari","en":"he/it plots"},{"bs":"spletkario je","en":"he/it plotted"},{"bs":"da spletkare","en":"so that they may plot"}],"ref":"71:22","answerWord":"وَمَكَرُوا۟","answerSound":"audio/ecb034fa6b8f6f369bcb.m4a","quranTranslation":{"text":"And they have plotted a mighty plot,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَمَكَرُوا۟","مَكْرًا","كُبَّارًا"],"marked":[0],"facts":{"verb":"مَكَرَ"}},{"id":"makara-14-46-1","words":["verb:makara"],"options":[{"bs":"spletkarili su","en":"they plotted"},{"bs":"spletkare","en":"they plot"},{"bs":"i spletkario je","en":"and he/it plotted"},{"bs":"i spletkarili smo","en":"and we plotted"}],"ref":"14:46","answerWord":"مَكَرُوا۟","answerSound":"audio/2c15fec8ccf4da2115e8.m4a","quranTranslation":{"text":"Verily they have plotted their plot, and their plot is with Allah, though their plot were one whereby the mountains should be moved.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَقَدْ","مَكَرُوا۟","مَكْرَهُمْ","وَعِندَ","ٱللَّهِ","مَكْرُهُمْ","وَإِن","كَانَ","مَكْرُهُمْ","لِتَزُولَ","مِنْهُ","ٱلْجِبَالُ"],"marked":[1],"facts":{"verb":"مَكَرَ"}},{"id":"makara-13-42-1","words":["verb:makara"],"options":[{"bs":"spletkario je","en":"he/it plotted"},{"bs":"da spletkare","en":"so that they may plot"},{"bs":"spletkari","en":"he/it plots"},{"bs":"i spletkarili smo","en":"and we plotted"}],"ref":"13:42","answerWord":"مَكَرَ","answerSound":"audio/e870fdc9fef5a400542e.m4a","quranTranslation":{"text":"Those who were before them plotted; but all plotting is Allah's. He knoweth that which each soul earneth. The disbelievers will come to know for whom will be the sequel of the (heavenly) Home.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَقَدْ","مَكَرَ","ٱلَّذِينَ","مِن","قَبْلِهِمْ","فَلِلَّهِ","ٱلْمَكْرُ","جَمِيعًا","يَعْلَمُ","مَا","تَكْسِبُ","كُلُّ","نَفْسٍ","وَسَيَعْلَمُ","ٱلْكُفَّٰرُ","لِمَنْ","عُقْبَى","ٱلدَّارِ"],"marked":[1],"facts":{"verb":"مَكَرَ"}},{"id":"makara-3-54-1","words":["verb:makara"],"options":[{"bs":"i spletkario je","en":"and he/it plotted"},{"bs":"spletkarite","en":"you (all) plot"},{"bs":"spletkare","en":"they plot"},{"bs":"i smišljali su spletku","en":"and they plotted"}],"ref":"3:54","answerWord":"وَمَكَرَ","answerSound":"audio/62565973979c8d456fc8.m4a","quranTranslation":{"text":"And they (the disbelievers) schemed, and Allah schemed (against them): and Allah is the best of schemers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَمَكَرُوا۟","وَمَكَرَ","ٱللَّهُ","وَٱللَّهُ","خَيْرُ","ٱلْمَٰكِرِينَ"],"marked":[1],"facts":{"verb":"مَكَرَ"}},{"id":"makara-6-123-7","words":["verb:makara"],"options":[{"bs":"da spletkare","en":"so that they may plot"},{"bs":"i smišljali su spletku","en":"and they plotted"},{"bs":"i spletkario je","en":"and he/it plotted"},{"bs":"i spletkarili smo","en":"and we plotted"}],"ref":"6:123","answerWord":"لِيَمْكُرُوا۟","answerSound":"audio/3a33d18c017f495d391d.m4a","quranTranslation":{"text":"And thus have We made in every city great ones of its wicked ones, that they should plot therein. They do but plot against themselves, though they perceive not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَكَذَٰلِكَ","جَعَلْنَا","فِى","كُلِّ","قَرْيَةٍ","أَكَٰبِرَ","مُجْرِمِيهَا","لِيَمْكُرُوا۟","فِيهَا","وَمَا","يَمْكُرُونَ","إِلَّا","بِأَنفُسِهِمْ","وَمَا","يَشْعُرُونَ"],"marked":[7],"facts":{"verb":"مَكَرَ"}},{"id":"makara-7-123-11","words":["verb:makara"],"options":[{"bs":"smislili ste ga","en":"you (all) plotted it"},{"bs":"i spletkari","en":"and he/it plots"},{"bs":"i spletkare","en":"and they plot"},{"bs":"i spletkarili smo","en":"and we plotted"}],"ref":"7:123","answerWord":"مَّكَرْتُمُوهُ","answerSound":"audio/c9c50719b0e36cb66168.m4a","quranTranslation":{"text":"Pharaoh said: Ye believe in Him before I give you leave! Lo! this is the plot that ye have plotted in the city that ye may drive its people hence. But ye shall come to know!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["قَالَ","فِرْعَوْنُ","ءَامَنتُم","بِهِۦ","قَبْلَ","أَنْ","ءَاذَنَ","لَكُمْ","إِنَّ","هَٰذَا","لَمَكْرٌ","مَّكَرْتُمُوهُ","فِى","ٱلْمَدِينَةِ","لِتُخْرِجُوا۟","مِنْهَآ","أَهْلَهَا","فَسَوْفَ","تَعْلَمُونَ"],"marked":[11],"facts":{"verb":"مَكَرَ"}},{"id":"makara-8-30-1","words":["verb:makara"],"options":[{"bs":"spletkari","en":"he/it plots"},{"bs":"spletkarite","en":"you (all) plot"},{"bs":"i smišljali su spletku","en":"and they plotted"},{"bs":"i spletkario je","en":"and he/it plotted"}],"ref":"8:30","answerWord":"يَمْكُرُ","answerSound":"audio/8803799c608076cb7f8d.m4a","quranTranslation":{"text":"And when those who disbelieve plot against thee (O Muhammad) to wound thee fatally, or to kill thee or to drive thee forth; they plot, but Allah (also) plotteth; and Allah is the best of plotters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَإِذْ","يَمْكُرُ","بِكَ","ٱلَّذِينَ","كَفَرُوا۟","لِيُثْبِتُوكَ","أَوْ","يَقْتُلُوكَ","أَوْ","يُخْرِجُوكَ","وَيَمْكُرُونَ","وَيَمْكُرُ","ٱللَّهُ","وَٱللَّهُ","خَيْرُ","ٱلْمَٰكِرِينَ"],"marked":[1],"facts":{"verb":"مَكَرَ"}},{"id":"makara-8-30-10","words":["verb:makara"],"options":[{"bs":"i spletkare","en":"and they plot"},{"bs":"i spletkarili smo","en":"and we plotted"},{"bs":"i spletkari","en":"and he/it plots"},{"bs":"i spletkario je","en":"and he/it plotted"}],"ref":"8:30","answerWord":"وَيَمْكُرُونَ","answerSound":"audio/211f90243ec1ecfc4200.m4a","quranTranslation":{"text":"And when those who disbelieve plot against thee (O Muhammad) to wound thee fatally, or to kill thee or to drive thee forth; they plot, but Allah (also) plotteth; and Allah is the best of plotters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَإِذْ","يَمْكُرُ","بِكَ","ٱلَّذِينَ","كَفَرُوا۟","لِيُثْبِتُوكَ","أَوْ","يَقْتُلُوكَ","أَوْ","يُخْرِجُوكَ","وَيَمْكُرُونَ","وَيَمْكُرُ","ٱللَّهُ","وَٱللَّهُ","خَيْرُ","ٱلْمَٰكِرِينَ"],"marked":[10],"facts":{"verb":"مَكَرَ"}},{"id":"makara-8-30-11","words":["verb:makara"],"options":[{"bs":"i spletkari","en":"and he/it plots"},{"bs":"spletkare","en":"they plot"},{"bs":"i smišljali su spletku","en":"and they plotted"},{"bs":"i spletkarili smo","en":"and we plotted"}],"ref":"8:30","answerWord":"وَيَمْكُرُ","answerSound":"audio/814563337bc77df5086c.m4a","quranTranslation":{"text":"And when those who disbelieve plot against thee (O Muhammad) to wound thee fatally, or to kill thee or to drive thee forth; they plot, but Allah (also) plotteth; and Allah is the best of plotters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَإِذْ","يَمْكُرُ","بِكَ","ٱلَّذِينَ","كَفَرُوا۟","لِيُثْبِتُوكَ","أَوْ","يَقْتُلُوكَ","أَوْ","يُخْرِجُوكَ","وَيَمْكُرُونَ","وَيَمْكُرُ","ٱللَّهُ","وَٱللَّهُ","خَيْرُ","ٱلْمَٰكِرِينَ"],"marked":[11],"facts":{"verb":"مَكَرَ"}},{"id":"makara-10-21-21","words":["verb:makara"],"options":[{"bs":"spletkarite","en":"you (all) plot"},{"bs":"i smišljali su spletku","en":"and they plotted"},{"bs":"i spletkarili smo","en":"and we plotted"},{"bs":"da spletkare","en":"so that they may plot"}],"ref":"10:21","answerWord":"تَمْكُرُونَ","answerSound":"audio/0305eba5e03af6e2f77d.m4a","quranTranslation":{"text":"And when We cause mankind to taste of mercy after some adversity which had afflicted them, behold! they have some plot against Our revelations. Say: Allah is more swift in plotting. Lo! Our messengers write down that which ye plot.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَإِذَآ","أَذَقْنَا","ٱلنَّاسَ","رَحْمَةً","مِّنۢ","بَعْدِ","ضَرَّآءَ","مَسَّتْهُمْ","إِذَا","لَهُم","مَّكْرٌ","فِىٓ","ءَايَاتِنَا","قُلِ","ٱللَّهُ","أَسْرَعُ","مَكْرًا","إِنَّ","رُسُلَنَا","يَكْتُبُونَ","مَا","تَمْكُرُونَ"],"marked":[21],"facts":{"verb":"مَكَرَ"}},{"id":"makara-27-50-2","words":["verb:makara"],"options":[{"bs":"i spletkarili smo","en":"and we plotted"},{"bs":"smislili ste ga","en":"you (all) plotted it"},{"bs":"spletkario je","en":"he/it plotted"},{"bs":"spletkarite","en":"you (all) plot"}],"ref":"27:50","answerWord":"وَمَكَرْنَا","answerSound":"audio/bcdffcfcc98cfdce9c5a.m4a","quranTranslation":{"text":"So they plotted a plot: and We plotted a plot, while they perceived not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَمَكَرُوا۟","مَكْرًا","وَمَكَرْنَا","مَكْرًا","وَهُمْ","لَا","يَشْعُرُونَ"],"marked":[2],"facts":{"verb":"مَكَرَ"}}]