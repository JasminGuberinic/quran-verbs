"present", "pronoun": "antuma", "arabic": "تَظُنَّانِ", "plain": "تَظُنَّانِ", "quran": false, "notUsed": false, "spoken": "audio/d8b86548aa8f60e19035.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَظُنُّونَ", "plain": "تَظُنُّونَ", "quran": true, "notUsed": false, "spoken": "audio/df5c3ff699160dbeb8c0.m4a", "recited": "audio/681799c2a66d58c7cf80.m4a", "recitedText": "وَتَظُنُّونَ"}, {"tense": "present", "pronoun": "antunna", "arabic": "تَظْنُنَّ", "plain": "تَظْنُنَّ", "quran": false, "notUsed": false, "spoken": "audio/163a0fec352da7840e08.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَظُنُّ", "plain": "يَظُنُّ", "quran": true, "notUsed": false, "spoken": "audio/501b0b020c06bec487ef.m4a", "recited": "audio/9c96c35b8154bbe0e3a6.m4a", "recitedText": "يَظُنُّ"}, {"tense": "present", "pronoun": "hiya", "arabic": "تَظُنُّ", "plain": "تَظُنُّ", "quran": true, "notUsed": false, "spoken": "audio/b0f5128849c8b0210b6c.m4a", "recited": "audio/0dfefb4b8b585b513f8d.m4a", "recitedText": "تَظُنُّ"}, {"tense": "present", "pronoun": "huma", "arabic": "يَظُنَّانِ", "plain": "يَظُنَّانِ", "quran": false, "notUsed": false, "spoken": "audio/d6da74f2f2e6a6bcef94.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَظُنُّونَ", "plain": "يَظُنُّونَ", "quran": true, "notUsed": false, "spoken": "audio/5b441d5ed750135f2ca1.m4a", "recited": "audio/6291a07a69c212a16057.m4a", "recitedText": "يَظُنُّونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَظْنُنَّ", "plain": "يَظْنُنَّ", "quran": false, "notUsed": false, "spoken": "audio/c9953a79837229cde010.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اُظْنُنْ", "plain": "اُظْنُنْ", "quran": false, "notUsed": false, "spoken": "audio/e0f8c66b5f75a41823b0.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "ظُنِّي", "plain": "ظُنِّي", "quran": false, "notUsed": false, "spoken": "audio/815914e806b54a6debce.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "ظُنَّا", "plain": "ظُنَّا", "quran": false, "notUsed": false, "spoken": "audio/c65e76316d55422e0809.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ظُنُّوا", "plain": "ظُنُّوا", "quran": false, "notUsed": false, "spoken": "audio/097b1bc5f64587155142.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُظْنُنَّ", "plain": "اُظْنُنَّ", "quran": false, "notUsed": false, "spoken": "audio/617331eefbd27f27b794.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "72:7", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5454.mp3", "translation": {"en": {"text": "And indeed they supposed, even as ye suppose, that Allah would not raise anyone (from the dead) -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Doğrusu onlar sizin zannettiğiniz gibi, zannetmişlerdi ki, Allah asla kimseyi Peygamber göndermeyecek.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ کہ انہوں نے گمان کیا جیسا تمہیں گمان ہے کہ اللہ ہرگز کوئی رسول نہ بھیجے گا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya mereka (jin) menyangka sebagaimana persangkaan kamu (orang-orang kafir Mekah), bahwa Allah sekali-kali tidak akan membangkitkan seorang (rasul)pun,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ظَنُّوا۟", "hit": true, "audio": "audio/03cbf7f2578dc8989bfa.m4a", "gloss": {"en": "they thought", "bs": "mislili su", "tr": "sandılar", "fr": "ils ont pensé", "id": "mereka telah mengira", "ur": "انہوں نے گمان کیا", "bn": "তারা মনে করল", "fa": "گمان کردند"}}, {"text": "كَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "ظَنَنتُمْ", "hit": true, "audio": "audio/a2c51e8e6bbbdc642705.m4a", "gloss": {"en": "you (all) thought", "bs": "mislili ste", "tr": "sandınız", "fr": "vous avez pensé", "id": "kalian telah mengira", "ur": "تم نے گمان کیا", "bn": "তোমরা মনে করেছিলে", "fa": "گمان کردید"}}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّن", "hit": false, "audio": null, "gloss": null}, {"text": "يَبْعَثَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَحَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "75:28", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5579.mp3", "translation": {"en": {"text": "And he knoweth that it is the parting;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Can çekişen bunun o ayrılık anı olduğunu anlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "سمجھ لے گا کہ یہ جدائی کی گھڑی ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan dia yakin bahwa sesungguhnya itulah waktu perpisahan (dengan dunia),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَظَنَّ", "hit": true, "audio": "audio/07a7f22695d9a38640e5.m4a", "gloss": {"bs": "i on bude uvjeren", "en": "and he is certain", "tr": "ve kesin inansın", "fr": "et il est certain", "id": "dan dia yakin", "ur": "اور اسے یقین ہو جائے", "bn": "এবং সে নিশ্চিত হয়েছে", "fa": "و یقین کرد"}}, {"text": "أَنَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْفِرَاقُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:35", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2175.mp3", "translation": {"en": {"text": "And he went into his garden, while he (thus) wronged himself. He said: I think not that all this will ever perish.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Adam, bu şekilde kendine zulmederek bağına girdi ve şöyle dedi: \"Bunun hiç yok olacağını sanmıyorum\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اپنے باغ میں گیا اور اپنی جان پر ظلم کرتا ہوا بولا مجھے گمان نہیں کہ یہ کبھی فنا ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan dia memasuki kebunnya sedang dia zalim terhadap dirinya sendiri; ia berkata: \"Aku kira kebun ini tidak akan binasa selama-lamanya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَدَخَلَ", "hit": false, "audio": null, "gloss": null}, {"text": "جَنَّتَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ظَالِمٌ", "hit": false, "audio": null, "gloss": null}, {"text": "لِّنَفْسِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَظُنُّ", "hit": true, "audio": "audio/dd1bb37e8d3190656618.m4a", "gloss": {"en": "I think", "bs": "mislim", "tr": "sanırım", "fr": "je pense", "id": "aku mengira", "ur": "میں گمان کرتا ہوں", "bn": "আমি মনে করি", "fa": "گمان می‌کنم"}}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَبِيدَ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذِهِۦٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَبَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "41:23", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4241.mp3", "translation": {"en": {"text": "That, your thought which ye did think about your Lord, hath ruined you; and ye find yourselves (this day) among the lost.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte Rabbiniz hakkında beslediğiniz bu zannınız sizi helak etti de zarara uğrayanlardan oldunuz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ ہے تمہارا وہ گمان جو تم نے اپنے رب کے ساتھ کیا اور اس نے تمہیں ہلاک کردیا تو اب رہ گئے ہارے ہوؤں میں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan yang demikian itu adalah prasangkamu yang telah kamu sangka kepada Tuhanmu, Dia telah membinasakan kamu, maka jadilah kamu termasuk orang-orang yang merugi.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَذَٰلِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ظَنُّكُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "ظَنَنتُم", "hit": true, "audio": "audio/3af519ec398f83dbfec8.m4a", "gloss": {"en": "you (all) thought", "bs": "mislili ste", "tr": "sandınız", "fr": "vous avez pensé", "id": "kalian telah mengira", "ur": "تم نے گمان کیا", "bn": "তোমরা মনে করেছিলে", "fa": "گمان کردید"}}, {"text": "بِرَبِّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْدَىٰكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَصْبَحْتُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَٰسِرِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:46", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/53.mp3", "translation": {"en": {"text": "Who know that they will have to meet their Lord, and that unto Him they are returning.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar ki, Rablerine kavuşacaklarını ve gerçekten O'na döneceklerini bilirler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جنہیں یقین ہے کہ انہیں اپنے رب سے ملنا ہے اور اسی کی طرف پھرنا-", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yaitu) orang-orang yang meyakini, bahwa mereka akan menemui Tuhannya, dan bahwa mereka akan kembali kepada-Nya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَظُنُّونَ", "hit": true, "audio": "audio/6291a07a69c212a16057.m4a", "gloss": {"en": "they think", "bs": "misle", "tr": "sanırlar", "fr": "ils pensent", "id": "mereka mengira", "ur": "وہ گمان کرتے ہیں", "bn": "তারা মনে করে", "fa": "گمان می‌کنند"}}, {"text": "أَنَّهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّلَٰقُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "رَٰجِعُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "75:25", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5576.mp3", "translation": {"en": {"text": "Thou wilt know that some great disaster is about to fall on them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Anlar ki kendisine belkıran (bel kemiklerini kıran belalı bir iş) yapılır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "سمجھتے ہوں گے کہ ان کے ساتھ وہ کی جائے گی جو کمر کو توڑ دے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka yakin bahwa akan ditimpakan kepadanya malapetaka yang amat dahsyat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "تَظُنُّ", "hit": true, "audio": "audio/0dfefb4b8b585b513f8d.m4a", "gloss": {"bs": "(lica) očekuju", "en": "(faces) expect", "tr": "(yüzler) bekler", "fr": "(des visages) s'attendent", "id": "(wajah-wajah) mengharapkan", "ur": "(چہرے) توقع رکھتے ہیں", "bn": "(মুখমণ্ডল) আশঙ্কা করবে", "fa": "(چهره‌ها) انتظار دارند"}}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يُفْعَلَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَاقِرَةٌ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَظَنُّوٓا۟", "count": 6, "first": "7:171", "audio": "audio/2f6e29d0a6d3b275bf39.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "and they thought", "bs": "i mislili su", "tr": "ve sandılar", "fr": "et ils pensaient", "id": "dan mereka mengira", "ur": "اور انہوں نے گمان کیا", "bn": "এবং তারা মনে করল", "fa": "و گمان کردند"}}, {"arabic": "يَظُنُّونَ", "count": 5, "first": "2:46", "audio": "audio/6291a07a69c212a16057.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they think", "bs": "misle", "tr": "sanırlar", "fr": "ils pensent", "id": "mereka mengira", "ur": "وہ گمان کرتے ہیں", "bn": "তারা মনে করে", "fa": "گمان می‌کنند"}}, {"arabic": "ظَنَنتُمْ", "count": 4, "first": "41:22", "audio": "audio/9aad0c131732c129e24c.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) thought", "bs": "mislili ste", "tr": "sandınız", "fr": "vous avez pensé", "id": "kalian telah mengira", "ur": "تم نے گمان کیا", "bn": "তোমরা মনে করেছিলে", "fa": "گمان کردید"}}, {"arabic": "وَظَنَّ", "count": 3, "first": "10:24", "audio": "audio/88ac53dc03e2da167984.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "i on bude uvjeren", "en": "and he is certain", "tr": "ve kesin inansın", "fr": "et il est certain", "id": "dan dia yakin", "ur": "اور اسے یقین ہو جائے", "bn": "এবং সে নিশ্চিত হয়েছে", "fa": "و یقین کرد"}}, 