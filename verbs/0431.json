/385a5c37d3dc17cb2555.m4a", "gloss": {"bs": "i darovao im je", "en": "and He granted them", "tr": "ve onlara bahşetti", "fr": "et Il leur a accordé", "id": "dan Dia menganugerahi mereka", "ur": "اور اس نے انہیں عطا کیا", "bn": "এবং তিনি তাদের দান করলেন", "fa": "و به آنان عطا کرد"}}, {"text": "نَضْرَةً", "hit": false, "audio": null, "gloss": null}, {"text": "وَسُرُورًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُلَقَّىٰهَآ", "count": 3, "first": "28:80", "audio": "audio/b9de70f96ec0901d6f6b.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": ["hiya"], "mood": "subjunctive"}]}, {"arabic": "وَيُلَقَّوْنَ", "count": 1, "first": "25:75", "audio": "audio/3ad30134f4284f3c9b9e.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "and they are granted", "bs": "i bivaju podareni", "tr": "ve verilirler", "fr": "et ils reçoivent en don", "id": "dan mereka dianugerahi", "ur": "اور انہیں دیا جاتا ہے", "bn": "এবং তাদের দান করা হয়", "fa": "و بخشیده می‌شوند"}}, {"arabic": "لَتُلَقَّى", "count": 1, "first": "27:6", "audio": "audio/ec813ca2eae806ddfb52.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": true, "objects": [], "mood": "indicative"}]}, {"arabic": "وَلَقَّىٰهُمْ", "count": 1, "first": "76:11", "audio": "audio/385a5c37d3dc17cb2555.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hum"]}], "gloss": {"bs": "i darovao im je", "en": "and He granted them", "tr": "ve onlara bahşetti", "fr": "et Il leur a accordé", "id": "dan Dia menganugerahi mereka", "ur": "اور اس نے انہیں عطا کیا", "bn": "এবং তিনি তাদের দান করলেন", "fa": "و به آنان عطا کرد"}}], "ayatFile": "ayat/0431.json", "ayatTranslations": {"en": "ayat/0431.en.json", "tr": "ayat/0431.tr.json", "ur": "ayat/0431.ur.json", "id": "ayat/0431.id.json"}, "sentences": []}