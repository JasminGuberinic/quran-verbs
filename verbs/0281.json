asy/2009.mp3", "translation": {"en": {"text": "Such are they whose hearts and ears and eyes Allah hath sealed. And such are the heedless.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunlar, o kimselerdir ki; Allah kalblerini, kulaklarını ve gözlerini mühürlemiştir. Ve onlar, gafillerin ta kendileridir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یہ ہیں وه جن کے دل اور کان اور آنکھو ں پر اللہ نے مہر کر دی ہے اور وہی غفلت مین پڑے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka itulah orang-orang yang hati, pendengaran dan penglihatannya telah dikunci mati oleh Allah, dan mereka itulah orang-orang yang lalai.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "طَبَعَ", "hit": true, "audio": "audio/1d156cb3eb39c5c42753.m4a", "gloss": {"bs": "je zapečatio", "en": "sealed", "tr": "mühürledi", "fr": "a scellé", "id": "mengunci", "ur": "اس نے مہر لگا دی", "bn": "মোহর মেরে দিলেন", "fa": "مهر زد"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "قُلُوبِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَسَمْعِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَبْصَٰرِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْغَٰفِلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "30:59", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3468.mp3", "translation": {"en": {"text": "Thus doth Allah seal the hearts of those who know not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte bilmeyenlerin kalblerini Allah böyle mühürler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یوں ہی مہر کردیتا ہے اللہ جاہلوں کے دلوں پر", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Demikianlah Allah mengunci mati hati orang-orang yang tidak (mau) memahami.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَطْبَعُ", "hit": true, "audio": "audio/1ee4175a303f0c84b691.m4a", "gloss": {"bs": "pečati", "en": "seals", "tr": "mühürler", "fr": "scelle", "id": "mengunci", "ur": "وہ مہر لگاتا ہے", "bn": "মোহর মেরে দেন", "fa": "مهر می‌زند"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "قُلُوبِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْلَمُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "طَبَعَ", "count": 3, "first": "4:155", "audio": "audio/1d156cb3eb39c5c42753.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "je zapečatio", "en": "sealed", "tr": "mühürledi", "fr": "a scellé", "id": "mengunci", "ur": "اس نے مہر لگا دی", "bn": "মোহর মেরে দিলেন", "fa": "مهر زد"}}, {"arabic": "يَطْبَعُ", "count": 3, "first": "7:101", "audio": "audio/1ee4175a303f0c84b691.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "pečati", "en": "seals", "tr": "mühürler", "fr": "scelle", "id": "mengunci", "ur": "وہ مہر لگاتا ہے", "bn": "মোহর মেরে দেন", "fa": "مهر می‌زند"}}, {"arabic": "وَنَطْبَعُ", "count": 1, "first": "7:100", "audio": "audio/c799607484e255d13224.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "obje