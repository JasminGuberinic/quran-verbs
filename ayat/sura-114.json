{"ayat":[{"ref":"114:1","number":6231,"text":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","hits":[0,1,2,3]},{"ref":"114:2","number":6232,"text":"مَلِكِ ٱلنَّاسِ","hits":[0]},{"ref":"114:3","number":6233,"text":"إِلَٰهِ ٱلنَّاسِ","hits":[]},{"ref":"114:4","number":6234,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","hits":[0,1]},{"ref":"114:5","number":6235,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","hits":[0,1,2,3]},{"ref":"114:6","number":6236,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","hits":[]}]}