{"rank": 25, "root": "ظلم", "form": 1, "lemma": "ظَلَمَ", "count": 110, "ayahCount": 94, "share": 0.57, "meaning": {"bs": "učiniti nepravdu, griješiti", "en": "to wrong, to do injustice", "tr": "zulmetmek", "fr": "léser, être injuste", "id": "berbuat zalim", "ur": "ظلم کرنا", "bn": "জুলুম করা, অন্যায় করা", "fa": "ستم کردن، ظلم کردن"}, "lemmaSpoken": "audio/74e15bd0c539c911a359.m4a", "animation": "<svg class=\"va va-zalama_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes zalama_1-r{from,30%{transform:rotate(-90deg)}}@keyframes zalama_1-g{from,30%{transform:rotate(0)}45%{transform:rotate(-90deg)}}@keyframes zalama_1-h{from,40%{opacity:1}}@keyframes zalama_1-i{from,40%{opacity:0}}@keyframes zalama_1-s{from,55%{transform:rotate(0)}}.va-zalama_1 .a .ra{transform:rotate(-10deg);animation:zalama_1-r 2.6s ease-in-out both}.va-zalama_1 .b .ra{transform:rotate(-20deg);animation:zalama_1-g 2.6s ease-in-out both}.va-zalama_1 .ha{opacity:0;animation:zalama_1-h 2.6s step-end both}.va-zalama_1 .hb{animation:zalama_1-i 2.6s step-end both}.va-zalama_1 .a .tr{transform:rotate(22deg);animation:zalama_1-s 2.6s ease-in-out both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-zalama_1.off,.va-zalama_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-zalama_1,.va-zalama_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><g class=\"a\"><g transform=\"translate(42 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><circle class=\"q ha\" cy=\"17\" r=\"3.6\"/><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></g><g class=\"b\" transform=\"matrix(-1 0 0 1 120 0)\"><g transform=\"translate(46 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><circle class=\"q hb\" cy=\"17\" r=\"3.6\"/><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "ظَلَمَ", "plain": "ظَلَمَ", "quran": true, "notUsed": false, "spoken": "audio/74e15bd0c539c911a359.m4a", "recited": "audio/b174e43507c53723630b.m4a", "recitedText": "ظَلَمَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَظْلِمُ", "plain": "يَظْلِمُ", "quran": true, "notUsed": false, "spoken": "audio/3ae88cf0c8a0aa1f43a6.m4a", "recited": "audio/5a4225bab6bc159b9a86.m4a", "recitedText": "يَظْلِمُ"}], "nouns": {"participle": {"lemma": "ظالِم", "count": 129, "spoken": "audio/e001ab539906646e6cda.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "ظَلَمْتُ", "plain": "ظَلَمْتُ", "quran": true, "notUsed": false, "spoken": "audio/f2d295f096d65eda4e20.m4a", "recited": "audio/503ab8666106cef714a7.m4a", "recitedText": "ظَلَمْتُ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "ظَلَمْنَآ", "plain": "ظَلَمْنَا", "quran": true, "notUsed": false, "spoken": "audio/4b8dbd85c23240e7ef67.m4a", "recited": "audio/703a223e5688542db380.m4a", "recitedText": "ظَلَمْنَآ"}, {"tense": "past", "pronoun": "anta", "arabic": "ظَلَمْتَ", "plain": "ظَلَمْتَ", "quran": false, "notUsed": false, "spoken": "audio/985e58d38a3309cfa2cb.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "ظَلَمْتِ", "plain": "ظَلَمْتِ", "quran": false, "notUsed": false, "spoken": "audio/bf57af