[{"id":"arada-85-16-2","words":["verb:arada"],"options":[{"bs":"hoće","en":"He wills"},{"bs":"htjeli su","en":"they wanted"},{"bs":"htjeli ste","en":"you (all) wanted"},{"bs":"želio me je","en":"he/it wanted me"}],"ref":"85:16","answerWord":"يُرِيدُ","answerSound":"audio/8edc0144f4c589eefcee.m4a","quranTranslation":{"text":"Doer of what He will.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["فَعَّالٌ","لِّمَا","يُرِيدُ"],"marked":[2],"facts":{"verb":"أَرادَ"}},{"id":"arada-52-42-1","words":["verb:arada"],"options":[{"bs":"hoće","en":"they want"},{"bs":"želio me je","en":"he/it wanted me"},{"bs":"htjeli su","en":"they wanted"},{"bs":"pa smo htjeli","en":"so we wanted"}],"ref":"52:42","answerWord":"يُرِيدُونَ","answerSound":"audio/64acf5e36a9a68a1003a.m4a","quranTranslation":{"text":"Or seek they to ensnare (the messenger)? But those who disbelieve, they are the ensnared!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["أَمْ","يُرِيدُونَ","كَيْدًا","فَٱلَّذِينَ","كَفَرُوا۟","هُمُ","ٱلْمَكِيدُونَ"],"marked":[1],"facts":{"verb":"أَرادَ"}},{"id":"arada-51-57-1","words":["verb:arada"],"options":[{"bs":"hoću","en":"I want"},{"bs":"biva željen","en":"he/it is wanted"},{"bs":"htjele su","en":"they wanted"},{"bs":"htjeli su","en":"they (two) wanted"}],"ref":"51:57","answerWord":"أُرِيدُ","answerSound":"audio/da8e70da696f401aae65.m4a","quranTranslation":{"text":"I seek no livelihood from them, nor do I ask that they should feed Me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["مَآ","أُرِيدُ","مِنْهُم","مِّن","رِّزْقٍ","وَمَآ","أُرِيدُ","أَن","يُطْعِمُونِ"],"marked":[1,6],"facts":{"verb":"أَرادَ"}},{"id":"arada-37-86-4","words":["verb:arada"],"options":[{"bs":"hoćete","en":"you (all) want"},{"bs":"željeli smo ga","en":"we wanted it"},{"bs":"htjeli ste","en":"you (all) wanted"},{"bs":"žele","en":"they (two) want"}],"ref":"37:86","answerWord":"تُرِيدُونَ","answerSound":"audio/93c40ed41d714a6e8094.m4a","quranTranslation":{"text":"Is it a falsehood - gods beside Allah - that ye desire?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["أَئِفْكًا","ءَالِهَةً","دُونَ","ٱللَّهِ","تُرِيدُونَ"],"marked":[4],"facts":{"verb":"أَرادَ"}},{"id":"arada-3-145-11","words":["verb:arada"],"options":[{"bs":"hoće","en":"he/it wants"},{"bs":"i hoće","en":"and they want"},{"bs":"željen je","en":"he/it was wanted"},{"bs":"htjeli ste","en":"you (all) wanted"}],"ref":"3:145","answerWord":"يُرِدْ","answerSound":"audio/efb64dedd31d560f0b4e.m4a","quranTranslation":{"text":"No soul can ever die except by Allah's leave and at a term appointed. Whoso desireth the reward of the world, We bestow on him thereof; and whoso desireth the reward of the Hereafter, We bestow on him thereof. We shall reward the thankful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["وَمَا","كَانَ","لِنَفْسٍ","أَن","تَمُوتَ","إِلَّا","بِإِذْنِ","ٱللَّهِ","كِتَٰبًا","مُّؤَجَّلًا","وَمَن","يُرِدْ","ثَوَابَ","ٱلدُّنْيَا","نُؤْتِهِۦ","مِنْهَا","وَمَن","يُرِدْ","ثَوَابَ","ٱلْءَاخِرَةِ","نُؤْتِهِۦ","مِنْهَا","وَسَنَجْزِى","ٱلشَّٰكِرِينَ"],"marked":[11,17],"facts":{"verb":"أَرادَ"}},{"id":"arada-4-62-12","words":["verb:arada"],"options":[{"bs":"htjeli smo","en":"we wanted"},{"bs":"žele","en":"they (two) want"},{"bs":"hoćete","en":"you (all) want"},{"bs":"htjeli su","en":"they (two) wanted"}],"ref":"4:62","answerWord":"أَرَدْنَآ","answerSound":"audio/8f9868ae2cf72d211983.m4a","quranTranslation":{"text":"How would it be if a misfortune smote them because of that which their own hands have sent before (them)? Then would they come unto thee, swearing by Allah that they were seeking naught but harmony and kindness.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["فَكَيْفَ","إِذَآ","أَصَٰبَتْهُم","مُّصِيبَةٌۢ","بِمَا","قَدَّمَتْ","أَيْدِيهِمْ","ثُمَّ","جَآءُوكَ","يَحْلِفُونَ","بِٱللَّهِ","إِنْ","أَرَدْنَآ","إِلَّآ","إِحْسَٰنًا","وَتَوْفِيقًا"],"marked":[12],"facts":{"verb":"أَرادَ"}},{"id":"arada-4-27-5","words":["verb:arada"],"options":[{"bs":"i hoće","en":"and he/it wants"},{"bs":"pa je htio","en":"so he/it wanted"},{"bs":"žele","en":"they (two) want"},{"bs":"htjeli smo","en":"we wanted"}],"ref":"4:27","answerWord":"وَيُرِيدُ","answerSound":"audio/271208ccffa58b20f759.m4a","quranTranslation":{"text":"And Allah would turn to you in mercy; but those who follow vain desires would have you go tremendously astray.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["وَٱللَّهُ","يُرِيدُ","أَن","يَتُوبَ","عَلَيْكُمْ","وَيُرِيدُ","ٱلَّذِينَ","يَتَّبِعُونَ","ٱلشَّهَوَٰتِ","أَن","تَمِيلُوا۟","مَيْلًا","عَظِيمًا"],"marked":[5],"facts":{"verb":"أَرادَ"}},{"id":"arada-4-44-10","words":["verb:arada"],"options":[{"bs":"i hoće","en":"and they want"},{"bs":"pa smo htjeli","en":"so we wanted"},{"bs":"želio me je","en":"he/it wanted me"},{"bs":"hoće","en":"he/it wants"}],"ref":"4:44","answerWord":"وَيُرِيدُونَ","answerSound":"audio/7a30342c1dfc4cd28c68.m4a","quranTranslation":{"text":"Seest thou not those unto whom a portion of the Scripture hath been given, how they purchase error, and seek to make you (Muslims) err from the right way?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["أَلَمْ","تَرَ","إِلَى","ٱلَّذِينَ","أُوتُوا۟","نَصِيبًا","مِّنَ","ٱلْكِتَٰبِ","يَشْتَرُونَ","ٱلضَّلَٰلَةَ","وَيُرِيدُونَ","أَن","تَضِلُّوا۟","ٱلسَّبِيلَ"],"marked":[10],"facts":{"verb":"أَرادَ"}},{"id":"arada-5-113-1","words":["verb:arada"],"options":[{"bs":"hoćemo","en":"we want"},{"bs":"hoće","en":"He wills"},{"bs":"pa je htio","en":"so he/it wanted"},{"bs":"želio me je","en":"he/it wanted me"}],"ref":"5:113","answerWord":"نُرِيدُ","answerSound":"audio/3d693a3a7720ebcbc941.m4a","quranTranslation":{"text":"(They said:) We wish to eat thereof, that we may satisfy our hearts and know that thou hast spoken truth to us, and that thereof we may be witnesses.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["قَالُوا۟","نُرِيدُ","أَن","نَّأْكُلَ","مِنْهَا","وَتَطْمَئِنَّ","قُلُوبُنَا","وَنَعْلَمَ","أَن","قَدْ","صَدَقْتَنَا","وَنَكُونَ","عَلَيْهَا","مِنَ","ٱلشَّٰهِدِينَ"],"marked":[1],"facts":{"verb":"أَرادَ"}},{"id":"arada-4-88-9","words":["verb:arada"],"options":[{"bs":"zar hoćete?","en":"do you (all) want?"},{"bs":"pa je htio","en":"so he/it wanted"},{"bs":"pa smo htjeli","en":"so we wanted"},{"bs":"želio me je","en":"he/it wanted me"}],"ref":"4:88","answerWord":"أَتُرِيدُونَ","answerSound":"audio/273a4e3ba9e8a09df6b0.m4a","quranTranslation":{"text":"What aileth you that ye are become two parties regarding the hypocrites, when Allah cast them back (to disbelief) because of what they earned? Seek ye to guide him whom Allah hath sent astray? He whom Allah sendeth astray, for him thou (O MUhammad) canst not find a road.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["فَمَا","لَكُمْ","فِى","ٱلْمُنَٰفِقِينَ","فِئَتَيْنِ","وَٱللَّهُ","أَرْكَسَهُم","بِمَا","كَسَبُوٓا۟","أَتُرِيدُونَ","أَن","تَهْدُوا۟","مَنْ","أَضَلَّ","ٱللَّهُ","وَمَن","يُضْلِلِ","ٱللَّهُ","فَلَن","تَجِدَ","لَهُۥ","سَبِيلًا"],"marked":[9],"facts":{"verb":"أَرادَ"}},{"id":"arada-17-103-0","words":["verb:arada"],"options":[{"bs":"pa je htio","en":"so he/it wanted"},{"bs":"htjeli su","en":"they wanted"},{"bs":"biva željen","en":"he/it is wanted"},{"bs":"hoće","en":"they want"}],"ref":"17:103","answerWord":"فَأَرَادَ","answerSound":"audio/4a5126fbb4662b9ab430.m4a","quranTranslation":{"text":"And he wished to scare them from the land, but We drowned him and those with him, all together.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["فَأَرَادَ","أَن","يَسْتَفِزَّهُم","مِّنَ","ٱلْأَرْضِ","فَأَغْرَقْنَٰهُ","وَمَن","مَّعَهُۥ","جَمِيعًا"],"marked":[0],"facts":{"verb":"أَرادَ"}},{"id":"arada-33-28-6","words":["verb:arada"],"options":[{"bs":"hoćete","en":"you (all) want"},{"bs":"željeli smo ga","en":"we wanted it"},{"bs":"hoćemo","en":"we want"},{"bs":"htio je","en":"he/it wanted"}],"ref":"33:28","answerWord":"تُرِدْنَ","answerSound":"audio/758f4c0a00276ed05d4e.m4a","quranTranslation":{"text":"O Prophet! Say unto thy wives: If ye desire the world's life and its adornment, come! I will content you and will release you with a fair release.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["يَٰٓأَيُّهَا","ٱلنَّبِىُّ","قُل","لِّأَزْوَٰجِكَ","إِن","كُنتُنَّ","تُرِدْنَ","ٱلْحَيَوٰةَ","ٱلدُّنْيَا","وَزِينَتَهَا","فَتَعَالَيْنَ","أُمَتِّعْكُنَّ","وَأُسَرِّحْكُنَّ","سَرَاحًا","جَمِيلًا"],"marked":[6],"facts":{"verb":"أَرادَ"}},{"id":"arada-4-20-1","words":["verb:arada"],"options":[{"bs":"htjeli ste","en":"you (all) wanted"},{"bs":"pa sam htio","en":"so I wanted"},{"bs":"htjeli smo","en":"we wanted"},{"bs":"htjeli su","en":"they wanted"}],"ref":"4:20","answerWord":"أَرَدتُّمُ","answerSound":"audio/f4943127bd9224817386.m4a","quranTranslation":{"text":"And if ye wish to exchange one wife for another and ye have given unto one of them a sum of money (however great), take nothing from it. Would ye take it by the way of calumny and open wrong?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["وَإِنْ","أَرَدتُّمُ","ٱسْتِبْدَالَ","زَوْجٍ","مَّكَانَ","زَوْجٍ","وَءَاتَيْتُمْ","إِحْدَىٰهُنَّ","قِنطَارًا","فَلَا","تَأْخُذُوا۟","مِنْهُ","شَيْـًٔا","أَتَأْخُذُونَهُۥ","بُهْتَٰنًا","وَإِثْمًا","مُّبِينًا"],"marked":[1],"facts":{"verb":"أَرادَ"}},{"id":"arada-8-62-1","words":["verb:arada"],"options":[{"bs":"hoće","en":"they want"},{"bs":"htio sam","en":"I wanted"},{"bs":"i hoće","en":"and he/it wants"},{"bs":"pa je htio","en":"so he/it wanted"}],"ref":"8:62","answerWord":"يُرِيدُوٓا۟","answerSound":"audio/938cb79c1cf26737c1da.m4a","quranTranslation":{"text":"And if they would deceive thee, then lo! Allah is Sufficient for thee. He it is Who supporteth thee with His help and with the believers,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["وَإِن","يُرِيدُوٓا۟","أَن","يَخْدَعُوكَ","فَإِنَّ","حَسْبَكَ","ٱللَّهُ","هُوَ","ٱلَّذِىٓ","أَيَّدَكَ","بِنَصْرِهِۦ","وَبِٱلْمُؤْمِنِينَ"],"marked":[1],"facts":{"verb":"أَرادَ"}},{"id":"arada-8-71-1","words":["verb:arada"],"options":[{"bs":"hoće","en":"they want"},{"bs":"htjeli su","en":"they wanted"},{"bs":"pa sam htio","en":"so I wanted"},{"bs":"željen je","en":"he/it was wanted"}],"ref":"8:71","answerWord":"يُرِيدُوا۟","answerSound":"audio/95121c5aaaa6ed564da2.m4a","quranTranslation":{"text":"And if they would betray thee, they betrayed Allah before, and He gave (thee) power over them. Allah is Knower, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["وَإِن","يُرِيدُوا۟","خِيَانَتَكَ","فَقَدْ","خَانُوا۟","ٱللَّهَ","مِن","قَبْلُ","فَأَمْكَنَ","مِنْهُمْ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"marked":[1],"facts":{"verb":"أَرادَ"}},{"id":"arada-9-46-1","words":["verb:arada"],"options":[{"bs":"htjeli su","en":"they wanted"},{"bs":"želio me je","en":"he/it wanted me"},{"bs":"pa je htio","en":"so he/it wanted"},{"bs":"hoće","en":"they want"}],"ref":"9:46","answerWord":"أَرَادُوا۟","answerSound":"audio/353e4d6598c0566f7943.m4a","quranTranslation":{"text":"And if they had wished to go forth they would assuredly have made ready some equipment, but Allah was averse to their being sent forth and held them back and it was said (unto them): Sit ye with the sedentary!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["وَلَوْ","أَرَادُوا۟","ٱلْخُرُوجَ","لَأَعَدُّوا۟","لَهُۥ","عُدَّةً","وَلَٰكِن","كَرِهَ","ٱللَّهُ","ٱنۢبِعَاثَهُمْ","فَثَبَّطَهُمْ","وَقِيلَ","ٱقْعُدُوا۟","مَعَ","ٱلْقَٰعِدِينَ"],"marked":[1],"facts":{"verb":"أَرادَ"}},{"id":"arada-10-107-10","words":["verb:arada"],"options":[{"bs":"želi te","en":"he/it wants you"},{"bs":"hoćemo","en":"we want"},{"bs":"htjele su","en":"they wanted"},{"bs":"hoćete","en":"you (all) want"}],"ref":"10:107","answerWord":"يُرِدْكَ","answerSound":"audio/abcd6bff0c8866a9c74b.m4a","quranTranslation":{"text":"If Allah afflicteth thee with some hurt, there is none who can remove it save Him; and if He desireth good for thee, there is none who can repel His bounty. He striketh with it whom He will of his bondmen. He is the Forgiving, the Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["وَإِن","يَمْسَسْكَ","ٱللَّهُ","بِضُرٍّ","فَلَا","كَاشِفَ","لَهُۥٓ","إِلَّا","هُوَ","وَإِن","يُرِدْكَ","بِخَيْرٍ","فَلَا","رَآدَّ","لِفَضْلِهِۦ","يُصِيبُ","بِهِۦ","مَن","يَشَآءُ","مِنْ","عِبَادِهِۦ","وَهُوَ","ٱلْغَفُورُ","ٱلرَّحِيمُ"],"marked":[10],"facts":{"verb":"أَرادَ"}},{"id":"arada-11-34-4","words":["verb:arada"],"options":[{"bs":"htio sam","en":"I wanted"},{"bs":"želi te","en":"he/it wants you"},{"bs":"htjeli su","en":"they (two) wanted"},{"bs":"i htjeli su","en":"and they wanted"}],"ref":"11:34","answerWord":"أَرَدتُّ","answerSound":"audio/3e16b1c1acb89dc61eb4.m4a","quranTranslation":{"text":"My counsel will not profit you if I were minded to advise you, if Allah's will is to keep you astray. He is your Lord and unto Him ye will be brought back.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["وَلَا","يَنفَعُكُمْ","نُصْحِىٓ","إِنْ","أَرَدتُّ","أَنْ","أَنصَحَ","لَكُمْ","إِن","كَانَ","ٱللَّهُ","يُرِيدُ","أَن","يُغْوِيَكُمْ","هُوَ","رَبُّكُمْ","وَإِلَيْهِ","تُرْجَعُونَ"],"marked":[4],"facts":{"verb":"أَرادَ"}},{"id":"arada-16-40-4","words":["verb:arada"],"options":[{"bs":"željeli smo ga","en":"we wanted it"},{"bs":"želio me je","en":"he/it wanted me"},{"bs":"željen je","en":"he/it was wanted"},{"bs":"htjeli su","en":"they wanted"}],"ref":"16:40","answerWord":"أَرَدْنَٰهُ","answerSound":"audio/352c307661746ecd9fbd.m4a","quranTranslation":{"text":"And Our word unto a thing, when We intend it, is only that We say unto it: Be! and it is.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["إِنَّمَا","قَوْلُنَا","لِشَىْءٍ","إِذَآ","أَرَدْنَٰهُ","أَن","نَّقُولَ","لَهُۥ","كُن","فَيَكُونُ"],"marked":[4],"facts":{"verb":"أَرادَ"}},{"id":"arada-17-18-10","words":["verb:arada"],"options":[{"bs":"hoćemo","en":"we want"},{"bs":"hoće","en":"he/it wants"},{"bs":"hoću","en":"I want"},{"bs":"htjeli su","en":"they wanted"}],"ref":"17:18","answerWord":"نُّرِيدُ","answerSound":"audio/f9a1a8bd9eb8fbcca51c.m4a","quranTranslation":{"text":"Whoso desireth that (life) which hasteneth away, We hasten for him therein what We will for whom We please. And afterward We have appointed for him hell; he will endure the heat thereof, condemned, rejected.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"htjeti, namjeravati","en":"to want, to intend"},"passage":["مَّن","كَانَ","يُرِيدُ","ٱلْعَاجِلَةَ","عَجَّلْنَا","لَهُۥ","فِيهَا","مَا","نَشَآءُ","لِمَن","نُّرِيدُ","ثُمَّ","جَعَلْنَا","لَهُۥ","جَهَنَّمَ","يَصْلَىٰهَا","مَذْمُومًا","مَّدْحُورًا"],"marked":[10],"facts":{"verb":"أَرادَ"}},{"id":"zayyana-2-212-0","words":["verb:zayyana"],"options":[{"bs":"ukrašen je","en":"he/it was adorned"},{"bs":"sigurno ću uljepšati","en":"I will surely make attractive"},{"bs":"pa su ukrasili","en":"so they adorned"},{"bs":"ukrasili smo","en":"We adorned"}],"ref":"2:212","answerWord":"زُيِّنَ","answerSound":"audio/a8469a374e4f77619140.m4a","quranTranslation":{"text":"Beautified is the life of the world for those who disbelieve; they make a jest of the believers. But those who keep their duty to Allah will be above them on the Day of Resurrection. Allah giveth without stint to whom He will.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukrasiti, uljepšati","en":"to adorn, to make attractive"},"passage":["زُيِّنَ","لِلَّذِينَ","كَفَرُوا۟","ٱلْحَيَوٰةُ","ٱلدُّنْيَا","وَيَسْخَرُونَ","مِنَ","ٱلَّذِينَ","ءَامَنُوا۟","وَٱلَّذِينَ","ٱتَّقَوْا۟","فَوْقَهُمْ","يَوْمَ","ٱلْقِيَٰمَةِ","وَٱللَّهُ","يَرْزُقُ","مَن","يَشَآءُ","بِغَيْرِ","حِسَابٍ"],"marked":[0],"facts":{"verb":"زَيَّنَ"}},{"id":"zayyana-37-6-1","words":["verb:zayyana"],"options":[{"bs":"ukrasili smo","en":"We adorned"},{"bs":"ukrašen je","en":"he/it was adorned"},{"bs":"i ukrasio ga je","en":"and he/it adorned it"},{"bs":"sigurno ću uljepšati","en":"I will surely make attractive"}],"ref":"37:6","answerWord":"زَيَّنَّا","answerSound":"audio/0bd83ca3ae05eb1b763a.m4a","quranTranslation":{"text":"Lo! We have adorned the lowest heaven with an ornament, the planets;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukrasiti, uljepšati","en":"to adorn, to make attractive"},"passage":["إِنَّا","زَيَّنَّا","ٱلسَّمَآءَ","ٱلدُّنْيَا","بِزِينَةٍ","ٱلْكَوَاكِبِ"],"marked":[1],"facts":{"verb":"زَيَّنَ"}},{"id":"zayyana-6-43-8","words":["verb:zayyana"],"options":[{"bs":"i ukrasio je","en":"and he/it adorned"},{"bs":"i ukrasio ga je","en":"and he/it adorned it"},{"bs":"pa su ukrasili","en":"so they adorned"},{"bs":"ukrasili smo","en":"We adorned"}],"ref":"6:43","answerWord":"وَزَيَّنَ","answerSound":"audio/4828a8b478b6d2494123.m4a","quranTranslation":{"text":"If only, when Our disaster came on them, they had been humble! But their hearts were hardened and the devil made all that they used to do seem fair unto them!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukrasiti, uljepšati","en":"to adorn, to make attractive"},"passage":["فَلَوْلَآ","إِذْ","جَآءَهُم","بَأْسُنَا","تَضَرَّعُوا۟","وَلَٰكِن","قَسَتْ","قُلُوبُهُمْ","وَزَيَّنَ","لَهُمُ","ٱلشَّيْطَٰنُ","مَا","كَانُوا۟","يَعْمَلُونَ"],"marked":[8],"facts":{"verb":"زَيَّنَ"}},{"id":"zayyana-6-137-1","words":["verb:zayyana"],"options":[{"bs":"ukrasio je","en":"he/it adorned"},{"bs":"ukrasili smo","en":"We adorned"},{"bs":"i ukrasili smo ga","en":"and we adorned it"},{"bs":"pa su ukrasili","en":"so they adorned"}],"ref":"6:137","answerWord":"زَيَّنَ","answerSound":"audio/63c0e4723f66a6f44adf.m4a","quranTranslation":{"text":"Thus have their (so-called) partners (of Allah) made the killing of their children to seem fair unto many of the idolaters, that they may ruin them and make their faith obscure for them. Had Allah willed (it otherwise), they had not done so. So leave them alone with their devices.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukrasiti, uljepšati","en":"to adorn, to make attractive"},"passage":["وَكَذَٰلِكَ","زَيَّنَ","لِكَثِيرٍ","مِّنَ","ٱلْمُشْرِكِينَ","قَتْلَ","أَوْلَٰدِهِمْ","شُرَكَآؤُهُمْ","لِيُرْدُوهُمْ","وَلِيَلْبِسُوا۟","عَلَيْهِمْ","دِينَهُمْ","وَلَوْ","شَآءَ","ٱللَّهُ","مَا","فَعَلُوهُ","فَذَرْهُمْ","وَمَا","يَفْتَرُونَ"],"marked":[1],"facts":{"verb":"زَيَّنَ"}},{"id":"zayyana-15-16-5","words":["verb:zayyana"],"options":[{"bs":"i ukrasili smo ga","en":"and we adorned it"},{"bs":"ukrasio je","en":"he/it adorned"},{"bs":"i ukrašen je","en":"and he/it was adorned"},{"bs":"sigurno ću uljepšati","en":"I will surely make attractive"}],"ref":"15:16","answerWord":"وَزَيَّنَّٰهَا","answerSound":"audio/59069ff51c73fa69824b.m4a","quranTranslation":{"text":"And verily in the heaven we have set mansions of the stars, and We have beautified it for beholders.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukrasiti, uljepšati","en":"to adorn, to make attractive"},"passage":["وَلَقَدْ","جَعَلْنَا","فِى","ٱلسَّمَآءِ","بُرُوجًا","وَزَيَّنَّٰهَا","لِلنَّٰظِرِينَ"],"marked":[5],"facts":{"verb":"زَيَّنَ"}},{"id":"zayyana-15-39-4","words":["verb:zayyana"],"options":[{"bs":"sigurno ću uljepšati","en":"I will surely make attractive"},{"bs":"pa su ukrasili","en":"so they adorned"},{"bs":"i ukrasio ga je","en":"and he/it adorned it"},{"bs":"i ukrasili smo ga","en":"and we adorned it"}],"ref":"15:39","answerWord":"لَأُزَيِّنَنَّ","answerSound":"audio/dcc1b2363d2ccc79ecaf.m4a","quranTranslation":{"text":"He said: My Lord! Because Thou hast sent me astray, I verily shall adorn the path of error for them in the earth, and shall mislead them every one,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukrasiti, uljepšati","en":"to adorn, to make attractive"},"passage":["قَالَ","رَبِّ","بِمَآ","أَغْوَيْتَنِى","لَأُزَيِّنَنَّ","لَهُمْ","فِى","ٱلْأَرْضِ","وَلَأُغْوِيَنَّهُمْ","أَجْمَعِينَ"],"marked":[4],"facts":{"verb":"زَيَّنَ"}},{"id":"zayyana-16-63-7","words":["verb:zayyana"],"options":[{"bs":"pa je ukrasio","en":"so he/it adorned"},{"bs":"pa su ukrasili","en":"so they adorned"},{"bs":"i ukrasio ga je","en":"and he/it adorned it"},{"bs":"ukrasili smo","en":"We adorned"}],"ref":"16:63","answerWord":"فَزَيَّنَ","answerSound":"audio/281ebf6569d2ce1ccbcb.m4a","quranTranslation":{"text":"By Allah, We verily sent messengers unto the nations before thee, but the devil made their deeds fairseeming unto them. So he is their patron this day, and theirs will be a painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukrasiti, uljepšati","en":"to adorn, to make attractive"},"passage":["تَٱللَّهِ","لَقَدْ","أَرْسَلْنَآ","إِلَىٰٓ","أُمَمٍ","مِّن","قَبْلِكَ","فَزَيَّنَ","لَهُمُ","ٱلشَّيْطَٰنُ","أَعْمَٰلَهُمْ","فَهُوَ","وَلِيُّهُمُ","ٱلْيَوْمَ","وَلَهُمْ","عَذَابٌ","أَلِيمٌ"],"marked":[7],"facts":{"verb":"زَيَّنَ"}},{"id":"zayyana-41-12-10","words":["verb:zayyana"],"options":[{"bs":"i ukrasili smo","en":"and we adorned"},{"bs":"i ukrasili smo ga","en":"and we adorned it"},{"bs":"i ukrasio je","en":"and he/it adorned"},{"bs":"pa su ukrasili","en":"so they adorned"}],"ref":"41:12","answerWord":"وَزَيَّنَّا","answerSound":"audio/f168c36566e7c55bd033.m4a","quranTranslation":{"text":"Then He ordained them seven heavens in two Days and inspired in each heaven its mandate; and We decked the nether heaven with lamps, and rendered it inviolable. That is the measuring of the Mighty, the Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukrasiti, uljepšati","en":"to adorn, to make attractive"},"passage":["فَقَضَىٰهُنَّ","سَبْعَ","سَمَٰوَاتٍ","فِى","يَوْمَيْنِ","وَأَوْحَىٰ","فِى","كُلِّ","سَمَآءٍ","أَمْرَهَا","وَزَيَّنَّا","ٱلسَّمَآءَ","ٱلدُّنْيَا","بِمَصَٰبِيحَ","وَحِفْظًا","ذَٰلِكَ","تَقْدِيرُ","ٱلْعَزِيزِ","ٱلْعَلِيمِ"],"marked":[10],"facts":{"verb":"زَيَّنَ"}},{"id":"zayyana-41-25-3","words":["verb:zayyana"],"options":[{"bs":"pa su ukrasili","en":"so they adorned"},{"bs":"i ukrasio je","en":"and he/it adorned"},{"bs":"i ukrašen je","en":"and he/it was adorned"},{"bs":"i ukrasio ga je","en":"and he/it adorned it"}],"ref":"41:25","answerWord":"فَزَيَّنُوا۟","answerSound":"audio/cdd50ef3d8a5a44848d2.m4a","quranTranslation":{"text":"And We assigned them comrades (in the world), who made their present and their past fairseeming unto them. And the Word concerning nations of the jinn and humankind who passed away before them hath effect for them. Lo! they were ever losers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukrasiti, uljepšati","en":"to adorn, to make attractive"},"passage":["وَقَيَّضْنَا","لَهُمْ","قُرَنَآءَ","فَزَيَّنُوا۟","لَهُم","مَّا","بَيْنَ","أَيْدِيهِمْ","وَمَا","خَلْفَهُمْ","وَحَقَّ","عَلَيْهِمُ","ٱلْقَوْلُ","فِىٓ","أُمَمٍ","قَدْ","خَلَتْ","مِن","قَبْلِهِم","مِّنَ","ٱلْجِنِّ","وَٱلْإِنسِ","إِنَّهُمْ","كَانُوا۟","خَٰسِرِينَ"],"marked":[3],"facts":{"verb":"زَيَّنَ"}},{"id":"zayyana-48-12-10","words":["verb:zayyana"],"options":[{"bs":"i ukrašen je","en":"and he/it was adorned"},{"bs":"i ukrasio ga je","en":"and he/it adorned it"},{"bs":"pa su ukrasili","en":"so they adorned"},{"bs":"i ukrasili smo ga","en":"and we adorned it"}],"ref":"48:12","answerWord":"وَزُيِّنَ","answerSound":"audio/474b9661419da082c690.m4a","quranTranslation":{"text":"Nay, but ye deemed that the messenger and the believers would never return to their own folk, and that was made fairseeming in your hearts, and ye did think an evil thought, and ye were worthless folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukrasiti, uljepšati","en":"to adorn, to make attractive"},"passage":["بَلْ","ظَنَنتُمْ","أَن","لَّن","يَنقَلِبَ","ٱلرَّسُولُ","وَٱلْمُؤْمِنُونَ","إِلَىٰٓ","أَهْلِيهِمْ","أَبَدًا","وَزُيِّنَ","ذَٰلِكَ","فِى","قُلُوبِكُمْ","وَظَنَنتُمْ","ظَنَّ","ٱلسَّوْءِ","وَكُنتُمْ","قَوْمًۢا","بُورًا"],"marked":[10],"facts":{"verb":"زَيَّنَ"}},{"id":"zayyana-49-7-17","words":["verb:zayyana"],"options":[{"bs":"i ukrasio ga je","en":"and he/it adorned it"},{"bs":"i ukrašen je","en":"and he/it was adorned"},{"bs":"pa su ukrasili","en":"so they adorned"},{"bs":"i ukrasio je","en":"and he/it adorned"}],"ref":"49:7","answerWord":"وَزَيَّنَهُۥ","answerSound":"audio/cd723acac84d1d24f57a.m4a","quranTranslation":{"text":"And know that the messenger of Allah is among you. If he were to obey you in much of the government, ye would surely be in trouble; but Allah hath endeared the faith to you and hath beautified it in your hearts, and hath made disbelief and lewdness and rebellion hateful unto you. Such are they who are the rightly guided.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ukrasiti, uljepšati","en":"to adorn, to make attractive"},"passage":["وَٱعْلَمُوٓا۟","أَنَّ","فِيكُمْ","رَسُولَ","ٱللَّهِ","لَوْ","يُطِيعُكُمْ","فِى","كَثِيرٍ","مِّنَ","ٱلْأَمْرِ","لَعَنِتُّمْ","وَلَٰكِنَّ","ٱللَّهَ","حَبَّبَ","إِلَيْكُمُ","ٱلْإِيمَٰنَ","وَزَيَّنَهُۥ","فِى","قُلُوبِكُمْ","وَكَرَّهَ","إِلَيْكُمُ","ٱلْكُفْرَ","وَٱلْفُسُوقَ","وَٱلْعِصْيَانَ","أُو۟لَٰٓئِكَ","هُمُ","ٱلرَّٰشِدُونَ"],"marked":[17],"facts":{"verb":"زَيَّنَ"}},{"id":"kadhaba-6-24-2","words":["verb:kadhaba"],"options":[{"bs":"slagali su","en":"they lied"},{"bs":"pa je slagala","en":"so she/it lied"},{"bs":"lažete","en":"you (all) lie"},{"bs":"lažu","en":"they lie"}],"ref":"6:24","answerWord":"كَذَبُوا۟","answerSound":"audio/f865a9e2076ccef38f3d.m4a","quranTranslation":{"text":"See how they lie against themselves, and (how) the thing which they devised hath failed them!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"lagati","en":"to lie"},"passage":["ٱنظُرْ","كَيْفَ","كَذَبُوا۟","عَلَىٰٓ","أَنفُسِهِمْ","وَضَلَّ","عَنْهُم","مَّا","كَانُوا۟","يَفْتَرُونَ"],"marked":[2],"facts":{"verb":"كَذَبَ"}},{"id":"kadhaba-2-10-11","words":["verb:kadhaba"],"options":[{"bs":"lažu","en":"they lie"},{"bs":"lažete","en":"you (all) lie"},{"bs":"slagali su","en":"they lied"},{"bs":"pa je slagala","en":"so she/it lied"}],"ref":"2:10","answerWord":"يَكْذِبُونَ","answerSound":"audio/20328818ca8a10419ebc.m4a","quranTranslation":{"text":"In their hearts is a disease, and Allah increaseth their disease. A painful doom is theirs because they lie.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"lagati","en":"to lie"},"passage":["فِى","قُلُوبِهِم","مَّرَضٌ","فَزَادَهُمُ","ٱللَّهُ","مَرَضًا","وَلَهُمْ","عَذَابٌ","أَلِيمٌۢ","بِمَا","كَانُوا۟","يَكْذِبُونَ"],"marked":[11],"facts":{"verb":"كَذَبَ"}},{"id":"kadhaba-12-27-6","words":["verb:kadhaba"],"options":[{"bs":"pa je slagala","en":"so she/it lied"},{"bs":"lažu","en":"they lie"},{"bs":"lažete","en":"you (all) lie"},{"bs":"slagali su","en":"they lied"}],"ref":"12:27","answerWord":"فَكَذَبَتْ","answerSound":"audio/61e03ebb1c49c2d763af.m4a","quranTranslation":{"text":"And if his shirt is torn from behind, then she hath lied and he is of the truthful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"lagati","en":"to lie"},"passage":["وَإِن","كَانَ","قَمِيصُهُۥ","قُدَّ","مِن","دُبُرٍ","فَكَذَبَتْ","وَهُوَ","مِنَ","ٱلصَّٰدِقِينَ"],"marked":[6],"facts":{"verb":"كَذَبَ"}},{"id":"kadhaba-36-15-14","words":["verb:kadhaba"],"options":[{"bs":"lažete","en":"you (all) lie"},{"bs":"lažu","en":"they lie"},{"bs":"slagali su","en":"they lied"},{"bs":"pa je slagala","en":"so she/it lied"}],"ref":"36:15","answerWord":"تَكْذِبُونَ","answerSound":"audio/69649fa58d012fbd2e27.m4a","quranTranslation":{"text":"They said: Ye are but mortals like unto us. The Beneficent hath naught revealed. Ye do but lie!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"lagati","en":"to lie"},"passage":["قَالُوا۟","مَآ","أَنتُمْ","إِلَّا","بَشَرٌ","مِّثْلُنَا","وَمَآ","أَنزَلَ","ٱلرَّحْمَٰنُ","مِن","شَىْءٍ","إِنْ","أَنتُمْ","إِلَّا","تَكْذِبُونَ"],"marked":[14],"facts":{"verb":"كَذَبَ"}},{"id":"ardaa-22-2-6","words":["verb:ardaa"],"options":[{"bs":"dojila je","en":"she/it breast-fed"},{"bs":"doji ga!","en":"breast-feed him!"},{"bs":"doje","en":"they breast-feed"},{"bs":"dojile su","en":"they breast-fed"}],"ref":"22:2","answerWord":"أَرْضَعَتْ","answerSound":"audio/19c85bb8798b838e5f5e.m4a","quranTranslation":{"text":"On the day when ye behold it, every nursing mother will forget her nursling and every pregnant one will be delivered of her burden, and thou (Muhammad) wilt see mankind as drunken, yet they will not be drunken, but the Doom of Allah will be strong (upon them).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dojiti","en":"to breast-feed, to nurse"},"passage":["يَوْمَ","تَرَوْنَهَا","تَذْهَلُ","كُلُّ","مُرْضِعَةٍ","عَمَّآ","أَرْضَعَتْ","وَتَضَعُ","كُلُّ","ذَاتِ","حَمْلٍ","حَمْلَهَا","وَتَرَى","ٱلنَّاسَ","سُكَٰرَىٰ","وَمَا","هُم","بِسُكَٰرَىٰ","وَلَٰكِنَّ","عَذَابَ","ٱللَّهِ","شَدِيدٌ"],"marked":[6],"facts":{"verb":"أَرْضَعَ"}},{"id":"ardaa-28-7-5","words":["verb:ardaa"],"options":[{"bs":"doji ga!","en":"breast-feed him!"},{"bs":"doje","en":"they breast-feed"},{"bs":"dojile su vas","en":"they breast-fed you (all)"},{"bs":"dojile su","en":"they breast-fed"}],"ref":"28:7","answerWord":"أَرْضِعِيهِ","answerSound":"audio/46660fcc4246e32a2869.m4a","quranTranslation":{"text":"And We inspired the mother of Moses, saying: Suckle him and, when thou fearest for him, then cast him into the river and fear not nor grieve. Lo! We shall bring him back unto thee and shall make him (one) of Our messengers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dojiti","en":"to breast-feed, to nurse"},"passage":["وَأَوْحَيْنَآ","إِلَىٰٓ","أُمِّ","مُوسَىٰٓ","أَنْ","أَرْضِعِيهِ","فَإِذَا","خِفْتِ","عَلَيْهِ","فَأَلْقِيهِ","فِى","ٱلْيَمِّ","وَلَا","تَخَافِى","وَلَا","تَحْزَنِىٓ","إِنَّا","رَآدُّوهُ","إِلَيْكِ","وَجَاعِلُوهُ","مِنَ","ٱلْمُرْسَلِينَ"],"marked":[5],"facts":{"verb":"أَرْضَعَ"}}]