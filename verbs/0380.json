 {"arabic": "وَأَشْهَدَهُمْ", "count": 1, "first": "7:172", "audio": "audio/4ddac546d278a2831173.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hum"]}], "gloss": {"en": "and he/it called them to witness", "bs": "i uzeo ih je za svjedoke", "tr": "onları şahit tuttu", "fr": "et il les a pris à témoin", "id": "dan dia telah menjadikan mereka saksi", "ur": "اور اُس نے انہیں گواہ بنایا", "bn": "এবং সে তাদের সাক্ষী রাখল", "fa": "و آنان را گواه گرفت"}}, {"arabic": "أُشْهِدُ", "count": 1, "first": "11:54", "audio": "audio/3c9d821384cb9be4f3a0.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "I call to witness", "bs": "uzimam za svjedoka", "tr": "şahit tutarım", "fr": "je prends à témoin", "id": "aku menjadikan saksi", "ur": "میں گواہ بناتا ہوں", "bn": "আমি সাক্ষী রাখি", "fa": "گواه می‌گیرم"}}, {"arabic": "أَشْهَدتُّهُمْ", "count": 1, "first": "18:51", "audio": "audio/218b489c489a99875860.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": false, "objects": ["hum"]}], "gloss": {"en": "I called them to witness", "bs": "uzeo sam ih za svjedoke", "tr": "onları şahit tuttum", "fr": "je les ai pris à témoin", "id": "aku telah menjadikan mereka saksi", "ur": "میں نے انہیں گواہ بنایا", "bn": "আমি তাদের সাক্ষী রেখেছি", "fa": "آنان را گواه گرفتم"}}, {"arabic": "وَأَشْهِدُوا۟", "count": 1, "first": "65:2", "audio": "audio/72a06c590af60dc83128.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) call to witness!", "bs": "i uzmite za svjedoka!", "tr": "ve şahit tutun!", "fr": "et prenez à témoin !", "id": "dan jadikanlah saksi!", "ur": "اور گواہ بناؤ!", "bn": "এবং সাক্ষী রাখ!", "fa": "و گواه بگیرید!"}}], "ayatFile": "ayat/0380.json", "ayatTranslations": {"en": "ayat/0380.en.json", "tr": "ayat/0380.tr.json", "ur": "ayat/0380.ur.json", "id": "ayat/0380.id.json"}, "sentences": [{"arabi