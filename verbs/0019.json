{"rank": 19, "root": "رود", "form": 4, "lemma": "أَرادَ", "count": 139, "ayahCount": 112, "share": 0.72, "meaning": {"bs": "htjeti, namjeravati", "en": "to want, to intend", "tr": "istemek", "fr": "vouloir, avoir l'intention de", "id": "menghendaki, bermaksud", "ur": "ارادہ کرنا، چاہنا", "bn": "চাওয়া, ইচ্ছা করা", "fa": "خواستن، اراده کردن"}, "lemmaSpoken": "audio/65c279a7ce8aba11d36f.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَرَادَ", "plain": "أَرَادَ", "quran": true, "notUsed": false, "spoken": "audio/65c279a7ce8aba11d36f.m4a", "recited": "audio/c281e1f0d2c53a5d8ceb.m4a", "recitedText": "أَرَادَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُرِيدُ", "plain": "يُرِيدُ", "quran": true, "notUsed": false, "spoken": "audio/1e18ac17adafafc391b3.m4a", "recited": "audio/8edc0144f4c589eefcee.m4a", "recitedText": "يُرِيدُ"}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَرَدتُّ", "plain": "أَرَدْتُ", "quran": true, "notUsed": false, "spoken": "audio/61586e1dff77e43fafbb.m4a", "recited": "audio/3e16b1c1acb89dc61eb4.m4a", "recitedText": "أَرَدتُّ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَرَدْنَآ", "plain": "أَرَدْنَا", "quran": true, "notUsed": false, "spoken": "audio/614d76623e1923f790c4.m4a", "recited": "audio/8f9868ae2cf72d211983.m4a", "recitedText": "أَرَدْنَآ"}, {"tense": "past", "pronoun": "anta", "arabic": "أَرَدْتَ", "plain": "أَرَدْتَ", "quran": false, "notUsed": false, "spoken": "audio/ea83b0782e9af95268cb.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "أَرَدْتِ", "plain": "أَرَدْتِ", "quran": false, "notUsed": false, "spoken": "audio/d6fd86d7af1df5b5e360.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "أَرَدْتُمَا", "plain": "أَرَدْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/1f011cf94a9445b0ed3f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic":