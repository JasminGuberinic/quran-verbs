e, "spoken": "audio/c40d66934f51c0197861.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُصْدُقِي", "plain": "اُصْدُقِي", "quran": false, "notUsed": false, "spoken": "audio/4e40f0da7276b901e81b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُصْدُقَا", "plain": "اُصْدُقَا", "quran": false, "notUsed": false, "spoken": "audio/13584e3308d242a76f00.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُصْدُقُوا", "plain": "اُصْدُقُوا", "quran": false, "notUsed": false, "spoken": "audio/2239abc1433b1b723617.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُصْدُقْنَ", "plain": "اُصْدُقْنَ", "quran": false, "notUsed": false, "spoken": "audio/5f2540a5b39db9212db2.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "3:95", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/388.mp3", "translation": {"en": {"text": "Say: Allah speaketh truth. So follow the religion of Abraham, the upright. He was not of the idolaters.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki: \"Allah doğru söylemiştir. Öyle ise dosdoğru, Allah'ı birleyici olarak İbrahim'in dinine uyun. O, müşriklerden değildi\".", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ اللہ سچا ہے، تو ابراہیم کے دین پر چلو جو ہر باطل سے جدا تھے اور شرک والوں میں نہ تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah: \"Benarlah (apa yang difirmankan) Allah\". Maka ikutilah agama Ibrahim yang lurus, dan bukanlah dia termasuk orang-orang yang musyrik.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "صَدَقَ", "hit": true, "audio": "audio/059c2ee2433f7cc78943.m4a", "gloss": {"en": "he/it told the truth", "bs": "rekao je istinu"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱتَّبِعُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "مِلَّةَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِبْرَٰهِيمَ", "hit": false, "audio": null, "gloss": null}, {"text": "حَنِيفًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُشْرِكِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "29:3", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3343.mp3", "translation": {"en": {"text": "Lo! We tested those who were before you. Thus Allah knoweth those who are sincere, and knoweth those who feign.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun ki, biz onlardan öncekileri de imtihandan geçirmişizdir. Elbette Allah, doğruları ortaya çıkaracak, yalancıları da mutlaka ortaya koyacaktır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے ان سے اگلوں کو جانچا تو ضرور اللہ سچوں کو دیکھے گا اور ضرور جھوٹوں کو دیکھے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya kami telah menguji orang-orang yang sebelum mereka, maka sesungguhnya Allah mengetahui orang-orang yang benar dan sesungguhnya Dia mengetahui orang-orang yang dusta.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "قَبْلِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلَيَعْلَمَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "صَدَقُوا۟", "hit": true, "audio": "audio/2a67ae77a2153b45b9b6.m4a", "gloss": {"en": "they told the truth", "bs": "rekli su istinu"}}, {"text": "وَلَيَعْلَمَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكَٰذِبِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "27:27", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3186.mp3", "translation": {"en": {"text": "(Solomon) said: We shall see whether thou speakest truth or whether thou art of the liars.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Süleyman Hüdhüd'e) dedi ki: \"Doğru mu söyledin, yoksa yalancılardan mısın, bakacağız.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "سلیمان نے فرمایا اب ہم دیکھیں گے کہ تو نے سچ کہا یا تو جھوٹوں میں ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berkata Sulaiman: \"Akan kami lihat, apa kamu benar, ataukah kamu termasuk orang-orang yang berdusta.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَنَنظُرُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَصَدَقْتَ", "hit": true, "audio": "audio/8dd6786df8557d92baca.m4a", "gloss": {"bs": "istinu si rekao", "en": "you have told the truth", "tr": "doğru söyledin", "fr": "as-tu dit la vérité", "id": "kamu telah berkata benar", "ur": "کیا تو نے سچ کہا", "bn": "তুমি কি সত্য বলেছ", "fa": "آیا راست گفتی"}}, {"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكَٰذِبِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:9", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2492.mp3", "translation": {"en": {"text": "Then we fulfilled the promise unto them. So we delivered them and whom We would, and We destroyed the prodigals.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra biz onlara verdiğimiz sözü yerine getirdik; hem onları, hem de dilediğimiz kimseleri kurtardık, aşırı gidenleri yok ettik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر ہم نے اپنا وعدہ انہیں سچا کر دکھایا تو انہیں نجات دی اور جن کو چاہی اور حد سے بڑھنے والوں کو ہلاک کردیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian Kami tepati janji (yang telah Kami janjikan) kepada mereka. Maka Kami selamatkan mereka dan orang-orang yang Kami kehendaki dan Kami binasakan orang-orang yang melampaui batas.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "صَدَقْنَٰهُمُ", "hit": true, "audio": "audio/c53f14065db9163c73bb.m4a", "gloss": {"en": "we fulfilled our promise to them", "bs": "ispunili smo im obećanje", "tr": "onlara verdiğimiz sözü yerine getirdik", "fr": "nous vous avons tenu notre promesse", "id": "kami telah memenuhi janji kepada mereka", "ur": "ہم نے ان سے اپنا وعدہ پورا کیا", "bn": "আমরা তাদের কাছে আমাদের প্রতিশ্রুতি পূর্ণ করেছি", "fa": "به آنان وعده را وفا کردیم"}}, {"text": "ٱلْوَعْدَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَنجَيْنَٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "نَّشَآءُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَهْلَكْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُسْرِفِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "صَدَقُوا۟", "count": 5, "first": "2:177", "audio": "audio/ed7c527ff9aa951031fe.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they told the truth; they fulfilled", "bs": "rekli su istinu; ispunili su", "tr": "doğruyu söylediler; yerine getirdiler", "fr": "ils ont dit la vérité ; ils ont tenu promesse", "id": "mereka telah berkata benar; mereka telah memenuhi", "ur": "انہوں نے سچ ثابت کیا", "bn": "তারা সত্য বলেছে; তারা পূর্ণ করেছে", "fa": "راست گفتند؛ وفا کردند"}}, {"arabic": "صَدَقَ", "count": 2, "first": "3:95", "audio": "audio/059c2ee2433f7cc78943.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it told the truth; he/it fulfilled", "bs": "rekao je istinu; ispunio je", "tr": "doğruyu söyledi; yerine getirdi", "fr": "il a dit la vérité ; il a tenu parole", "id": "dia telah berkata benar; dia telah memenuhi", "ur": "اُس نے وعدہ پورا کیا", "bn": "সে সত্য বলেছে; সে পূর্ণ করেছে", "fa": "راست گفت؛ وفا کرد"}}, {"arabic": "وَصَدَقَ", "count": 2, "first": "33:22", "audio": "audio/9ef1ab1607a1d70eb3a5.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it told the truth", "bs": "i rekao je istinu", "tr": "ve doğruyu söyledi", "fr": "et il a dit la vérité", "id": "dan dia telah berkata benar", "ur": "اور اُس نے سچ کہا", "bn": "এবং সে সত্য বলেছে", "fa": "و راست گفت"}}, {"arabic": "صَدَقَكُمُ", "count": 1, "first": "3:152", "audio": "audio/9d736689becdc3607ced.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["antum"]}], "gloss": {"en": "he/it fulfilled his promise to you (all)", "bs": "ispunio vam je obećanje", "tr": "size verdiği sözü yerine getirdi", "fr": "il vous a tenu sa promesse", "id": "dia telah memenuhi janjinya kepada kalian", "ur": "اُس نے تم سب سے اپنا وعدہ پورا کیا", "bn": "সে তোমাদের কাছে তার প্রতিশ্রুতি পূর্ণ করেছে", "