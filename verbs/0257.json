ive"}], "gloss": {"en": "so let him beware", "bs": "pa neka se čuva", "tr": "böylece sakınsın", "fr": "qu'il se garde alors", "id": "maka biarlah dia waspada", "ur": "پس وہ خبردار رہے", "bn": "অতএব সে সতর্ক থাকুক", "fa": "پس پرهیز کند"}}, {"arabic": "فَٱحْذَرْهُمْ", "count": 1, "first": "63:4", "audio": "audio/a63048a96a12cea40480.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": ["hum"]}], "gloss": {"en": "so beware of them!", "bs": "pa ih se čuvaj!", "tr": "böylece onlardan sakın!", "fr": "alors garde-toi d'eux !", "id": "maka waspadalah terhadap mereka!", "ur": "پس ان سے خبردار رہو!", "bn": "অতএব তাদের থেকে সতর্ক থাক!", "fa": "پس از آنان پرهیز کن!"}}, {"arabic": "فَٱحْذَرُوهُمْ", "count": 1, "first": "64:14", "audio": "audio/cf27e82da78642e8ef33.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["hum"]}]}], "ayatFile": "ayat/0257.json", "ayatTranslations": {"en": "ayat/0257.en.json", "tr": "ayat/0257.tr.json", "ur": "ayat/0257.ur.json", "id": "ayat/0257.id.json"}, "sentences": [{"arabic": "يَحْذَرُ السَّائِقُ الْمَطَرَ", "spoken": "audio/098cd89eafaf89a8b551.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Vozač se čuva kiše.", "en": "The driver is wary of the rain.", "bn": "চালক বৃষ্টি নিয়ে সতর্ক।", "fa": "راننده از باران پروا دارد.", "fr": "Le chauffeur se méfie de la pluie.", "id": "Sopir itu waspada terhadap hujan.", "tr": "Sürücü yağmura karşı dikkatli.", "ur": "ڈرائیور بارش سے خبردار رہتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَحْذَرُ", "target": true, "translation": {"bs": "čuva se", "en": "is wary", "bn": "সতর্ক থাকে", "fa": "پروا دارد", "fr": "se méfie", "id": "waspada", "tr": "dikkatli", "ur": "وہ خبردار رہتا ہے"}}, {"arabic": "السَّائِقُ", "target": false, "translation": {"bs": "vozač", "en": "the driver", "bn": "চালক", "fa": "راننده", "fr": "le chauffeur", "id": "sopir itu", "tr": "şoför", "ur": "ڈرائیور"}}, {"arabic": "الْمَطَرَ"