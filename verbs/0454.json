"ayat/0454.ur.json", "id": "ayat/0454.id.json"}, "sentences": [{"arabic": "أَجْرَمُوا ثُمَّ نَدِمُوا", "spoken": "audio/4de78ca1b535ca1ad9a7.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Počinili su zločine, pa su se pokajali.", "en": "They committed crimes, then they regretted it.", "bn": "তারা অপরাধ করল, তারপর অনুতপ্ত হল।", "fa": "آنان مرتکب جرم شدند، سپس پشیمان شدند.", "fr": "Ils ont commis des crimes, puis ils l'ont regretté.", "id": "Mereka melakukan kejahatan, lalu mereka menyesal.", "tr": "Suç işlediler, sonra pişman oldular.", "ur": "انہوں نے جرم کیے، پھر پچھتائے۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَجْرَمُوا", "target": true, "translation": {"bs": "počinili su zločine", "en": "committed crimes", "bn": "তারা অপরাধ করল", "fa": "مرتکب جرم شدند", "fr": "ont commis des crimes", "id": "melakukan kejahatan", "tr": "suç işlediler", "ur": "انہوں نے جرم کیے"}}, {"arabic": "ثُمَّ", "target": false, "translation": {"bs": "pa", "en": "then", "bn": "তারপর", "fa": "سپس", "fr": "puis", "id": "lalu", "tr": "sonra", "ur": "پھر"}}, {"arabic": "نَدِمُوا", "target": false, "translation": {"bs": "pokajali su se", "en": "regretted", "bn": "অনুতপ্ত হল", "fa": "پشیمان شدند", "fr": "ont regretté", "id": "menyesal", "tr": "pişman oldular", "ur": "پچھتائے"}}]}, {"arabic": "أَجْرَمْنَا فِي حَقِّ الطَّبِيعَةِ", "spoken": "audio/262f0c1342ddd25e0b1f.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Počinili smo zločin prema prirodi.", "en": "We committed a crime against nature.", "bn": "আমরা প্রকৃতির বিরুদ্ধে অপরাধ করেছি।", "fa": "ما در حق طبیعت مرتکب جرم شدیم.", "fr": "Nous avons commis un crime contre la nature.", "id": "Kami melakukan kejahatan terhadap alam.", "tr": "Doğaya karşı suç işledik.", "ur": "ہم نے فطرت کے خلاف جرم کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَجْرَمْنَا", "target": true, "translation": {"bs": "počinili smo zločin", "en": "committed a crime", "bn": "আমরা অপরাধ করলাম", "fa": "مرتکب جرم شدی