t": "أَنْعَمْتَ", "hit": true, "audio": "audio/07f596c14781653afb87.m4a", "gloss": {"bs": "si podario blagodat", "en": "You have bestowed favour", "tr": "nimet verdin", "fr": "Tu as comblé de bienfaits", "id": "Engkau telah melimpahkan karunia", "ur": "تو نے نعمت دی", "bn": "আপনি নিয়ামত দান করেছেন", "fa": "نعمت داده‌ای"}}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "غَيْرِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَغْضُوبِ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلضَّآلِّينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:47", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/54.mp3", "translation": {"en": {"text": "O Children of Israel! Remember My favour wherewith I favoured you and how I preferred you to (all) creatures.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey İsrailoğulları! Size verdiğim nimeti ve vaktiyle sizi âlemlere üstün kıldığımı hatırlayın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے اولاد یعقوب یاد کرو میرا وہ احسان جو میں نے تم پر کیا اور یہ کہ اس سارے زمانہ پر تمہیں بڑائی دی-", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hai Bani Israil, ingatlah akan nikmat-Ku yang telah Aku anugerahkan kepadamu dan (ingatlah pula) bahwasanya Aku telah melebihkan kamu atas segala umat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَٰبَنِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِسْرَٰٓءِيلَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱذْكُرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "نِعْمَتِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّتِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنْعَمْتُ", "hit": true, "audio": "audio/057ef81b84e8bacaec16.m4a", "gloss": {"en": "I bestowed favour", "bs": "podario sam blagodat", "tr": "lütufta bulundum", "fr": "j'ai accordé ma grâce", "id": "aku telah memberi karunia", "ur": "میں نے احسان کیا", "bn": "আমি অনুগ্রহ করেছি", "fa": "نعمت ارزانی داشتم"}}, {"text": "عَلَيْكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "فَضَّلْتُكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَٰلَمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "43:59", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4384.mp3", "translation": {"en": {"text": "He is nothing but a slave on whom We bestowed favour, and We made him a pattern for the Children of Israel.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İsâ, ancak kendisine nimet verdiğimiz ve İsrailoğullarına örnek kıldığımız bir kuldur.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ تو نہیں مگر ایک بندہ جس پر ہم نے احسان فرمایا اور اسے ہم نے بنی اسرائیل کے لیے عجیب نمونہ بنایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Isa tidak lain hanyalah seorang hamba yang Kami berikan kepadanya nikmat (kenabian) dan Kami jadikan dia sebagai tanda bukti (kekuasaan Allah) untuk Bani lsrail", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "عَبْدٌ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنْعَمْنَا", "hit": true, "audio": "audio/81f6cce802c2275916c6.m4a", "gloss": {"en": "we bestowed favour", "bs": "podarili smo bla