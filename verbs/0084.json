{"rank": 84, "root": "ملك", "form": 1, "lemma": "مَلَكَ", "count": 44, "ayahCount": 42, "share": 0.23, "meaning": {"bs": "posjedovati, imati u vlasti", "en": "to own, to possess", "tr": "sahip olmak, elinde bulundurmak", "fr": "posséder, détenir", "id": "memiliki, menguasai", "ur": "مالک ہونا، اختیار رکھنا", "bn": "মালিক হওয়া, অধিকারী হওয়া", "fa": "مالک بودن، در اختیار داشتن"}, "lemmaSpoken": "audio/3cccc00bc4451608404f.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "مَلَكَ", "plain": "مَلَكَ", "quran": false, "notUsed": false, "spoken": "audio/3cccc00bc4451608404f.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَمْلِكُ", "plain": "يَمْلِكُ", "quran": true, "notUsed": false, "spoken": "audio/84a9e3d8f62c07f8ffac.m4a", "recited": "audio/a9a86861736c971f4392.m4a", "recitedText": "يَمْلِكُ"}], "nouns": {"participle": {"lemma": "مالِك", "count": 3, "spoken": "audio/128c749d876b313838e8.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "مَلَكْتُ", "plain": "مَلَكْتُ", "quran": false, "notUsed": false, "spoken": "audio/2071257918a04bf35d74.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "مَلَكْنَا", "plain": "مَلَكْنَا", "quran": false, "notUsed": false, "spoken": "audio/ecd15244323630588c38.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "مَلَكْتَ", "plain": "مَلَكْتَ", "quran": false, "notUsed": false, "spoken": "audio/f67c1a959af46670ac53.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "مَلَكْتِ", "plain": "مَلَكْتِ", "quran": false, "notUsed": false, "spoken": "audio/0e2a3af17ad52a8df73a.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "مَلَكْتُمَا", "plain": "مَلَكْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/30058905a6bfc08ff896.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pr