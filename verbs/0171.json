d He prepared", "tr": "ve hazırladı", "fr": "et Il a préparé", "id": "dan Dia menyiapkan", "ur": "اور اس نے تیار کیا", "bn": "এবং তিনি প্রস্তুত করেছেন", "fa": "و آماده ساخت"}}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "سَعِيرًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَأَعَدَّ", "count": 7, "first": "4:93", "audio": "audio/9ca265ddfa02dcde7617.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "i pripremio je", "en": "and He prepared", "tr": "ve hazırladı", "fr": "et Il a préparé", "id": "dan Dia menyiapkan", "ur": "اور اس نے تیار کیا", "bn": "এবং তিনি প্রস্তুত করেছেন", "fa": "و آماده ساخت"}}, {"arabic": "أَعَدَّ", "count": 7, "first": "4:102", "audio": "audio/a2014b652324374fc0c8.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it prepared", "bs": "pripremio je", "tr": "hazırladı", "fr": "il a préparé", "id": "dia telah mempersiapkan", "ur": "اُس نے تیار کیا", "bn": "সে প্রস্তুত করেছে", "fa": "آماده کرد"}}, {"arabic": "أُعِدَّتْ", "count": 4, "first": "2:24", "audio": "audio/9b22423fd935630f88c6.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": true, "objects": []}], "gloss": {"en": "she/it was prepared", "bs": "pripremljena je", "tr": "hazırlandı", "fr": "elle a été préparée", "id": "telah dipersiapkan", "ur": "وہ تیار کی گئی", "bn": "তা প্রস্তুত করা হয়েছে", "fa": "آماده شد"}}, {"arabic": "وَأَعِدُّوا۟", "count": 1, "first": "8:60", "audio": "audio/f5f6649ad2e62a9aac19.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) prepare!", "bs": "i pripremite!", "tr": "ve hazırlayın!", "fr": "et préparez !", "id": "dan persiapkanlah kalian!", "ur": "اور تیار کرو!", "bn": "এবং প্রস্তুত কর!", "fa": "و آماده کنید!"}}, {"arabic": "لَأَعَدُّوا۟", "count": 1, "first": "9:46", "audio": "audio/cdb8a11e8994ed6536af.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}]}], "ayatFile": "ayat/0171.json", "ayatTranslations": {"en": "ayat/0171.en.json", "tr": "ayat/0171.tr.json", "ur": "ayat/0171.ur.json", "id": "ayat/0171.id.json"}, "sentences": [{"arabic": "أَعَدَّ أَبِي الْعَشَاءَ", "spoken": "audio/a3eea6a420a3dfebf2da.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Moj otac je pripremio večeru.", "en": "My father prepared dinner.", "bn": "আমার বাবা রাতের খাবার প্রস্তুত করলেন।", "fa": "پدرم شام آماده کرد.", "fr": "Mon père a préparé le dîner.", "id": "Ayahku menyiapkan makan malam.", "tr": "Babam akşam yemeği hazırladı.", "ur": "میرے والد نے رات کا کھانا تیار کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَعَدَّ", "target": true, "translation": {"bs": "pripremio je", "en": "prepared", "bn": "প্রস্তুত করল", "fa": "آماده کرد", "fr": "a préparé", "id": "menyiapkan", "tr": "hazırladı", "ur": "اس نے تیار کیا"}}, {"arabic": "أَبِي", "target": false, "translation": {"bs": "moj otac", "en": "my father", "bn": "আমার বাবা", "fa": "پدرم", "fr": "mon père", "id": "ayahku", "tr": "babam", "ur": "میرے والد"}}, {"arabic": "الْعَشَاءَ", "target": false, "translation": {"bs": "večeru", "en": "the dinner", "bn": "রাতের খাবার", "fa": "شام", "fr": "le dîner", "id": "makan malam", "tr": "akşam yemeği", "ur": "رات کا کھانا"}}]}, {"arabic": "أَعَدُّوا الطَّعَامَ لِلضُّيُوفِ", "spoken": "audio/2a9cd45a0a49c7c27c6b.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Pripremili su hranu za goste.", "en": "They prepared food for the guests.", "bn": "তারা অতিথিদের জন্য খাবার প্রস্তুত করল।", "fa": "برای مهمانان غذا آماده کردند.", "fr": "Ils ont préparé de la nourriture pour les invités.", "id": "Mereka menyiapkan makanan untuk para tamu.", "tr": "Misafirler için yemek hazırladılar.", "ur": "انہوں نے مہمانوں کے لیے کھانا تیار کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَعَدُّوا", "target": true, "translation": {"bs": "pripremili su", "en": "they prepared", "bn": "তারা প্রস্তুত করল", "fa": "آماده کردند", "fr": "ont préparé", "id": "mereka menyiapkan", "tr": "hazırladılar", "ur": "انہوں نے تیار کیا"}}, {"arabic": "الطَّعَامَ", "target": false, "translation": {"bs": "hranu", "en": "the food", "bn": "খাবার", "fa": "غذا", "fr": "la nourriture", "id": "makanan itu", "tr": "yemek", "ur": "کھانا"}}, {"arabic": "لِلضُّيُوفِ", "target": false, "translation": {"bs": "za goste", "en": "for the guests", "bn": "অতিথিদের জন্য", "fa": "برای مهمانان", "fr": "pour les invités", "id": "untuk para tamu", "tr": "misafirler için", "ur": "مہمانوں کے لیے"}}]}, {"arabic": "أَعِدُّوا حَقَائِبَكُمْ لِلسَّفَرِ", "spoken": "audio/f2371aa9b0a41884be41.m4a", "tense": "imperative", "pronoun": "antum", "translation": {"bs": "Pripremite kofere za put.", "en": "Prepare your suitcases for the trip.", "bn": "সফরের জন্য তোমাদের স্যুটকেসগুলো প্রস্তুত করো।", "fa": "چمدان‌هایتان را برای سفر آماده کنید.", "fr": "Préparez vos valises pour le voyage.", "id": "Siapkan koper kalian untuk perjalanan.", "tr": "Yolculuk için bavullarınızı hazırlayın.", "ur": "سفر کے لیے اپنے بیگ تیار کرو۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَعِدُّوا", "target": true, "translation": {"bs": "pripremite", "en": "prepare", "bn": "প্রস্তুত করো", "fa": "آماده کنید", "fr": "préparez !", "id": "siapkanlah", "tr": "hazırlayın", "ur": "تیار کرو"}}, {"arabic": "حَقَائِبَكُمْ", "target": false, "translation": {"bs": "kofere", "en": "your suitcases", "bn": "তোমাদের সুটকেসগুলো", "fa": "چمدان‌هایتان", "fr": "vos valises", "id": "koper kalian", "tr": "bavullarınızı", "ur": "اپنے بیگ"}}, {"arabic": "لِلسَّفَرِ", "target": false, "translation": {"bs": "za put", "en": "for the trip", "bn": "সফরের জন্য", "fa": "برای سفر", "fr": "pour le voyage", "id": "untuk perjalanan", "tr": "yolculuk için", "ur": "سفر کے لیے"}}]}]}