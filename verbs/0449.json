": true, "audio": "audio/c302429041e45ea2c77b.m4a", "gloss": {"bs": "i izaći će", "en": "and they will come out", "tr": "ve çıkacaklar", "fr": "et ils sortiront", "id": "dan mereka akan keluar", "ur": "اور وہ نکل آئیں گے", "bn": "এবং তারা বেরিয়ে আসবে", "fa": "و بیرون خواهند آمد"}}, {"text": "لِلَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْوَٰحِدِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَهَّارِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "بَرَزُوا۟", "count": 2, "first": "2:250", "audio": "audio/f18fafa5530f17733a66.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they came out", "bs": "izašli su", "tr": "çıktılar", "fr": "ils sont sortis", "id": "mereka telah keluar", "ur": "وہ نکلے", "bn": "তারা বেরিয়ে এল", "fa": "بیرون آمدند"}}, {"arabic": "وَبَرَزُوا۟", "count": 2, "first": "14:21", "audio": "audio/9bde15015c3bc35bd262.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "i izaći će", "en": "and they will come out", "tr": "ve çıkacaklar", "fr": "et ils sortiront", "id": "dan mereka akan keluar", "ur": "اور وہ نکل آئیں گے", "bn": "এবং তারা বেরিয়ে আসবে", "fa": "و بیرون خواهند آمد"}}, {"arabic": "لَبَرَزَ", "count": 1, "first": "3:154", "audio": "audio/b7244c4ee8fced0f3e15.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}]}], "ayatFile": "ayat/0449.json", "ayatTranslations": {"en": "ayat/0449.en.json", "tr": "ayat/0449.tr.json", "ur": "ayat/0449.ur.json", "id": "ayat/0449.id.json"}, "sentences": [{"arabic": "بَرَزَ الْقَمَرُ مِنْ وَرَاءِ السَّحَابِ", "spoken": "audio/5b81ffa64aac526642b3.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Mjesec se pojavio iza oblaka.", "en": "The moon emerged from behind the clouds.", "bn": "চাঁদ মেঘের আড়াল থেকে বেরিয়ে এল।", "fa": "ماه از پشت ابرها نمایان شد.", "fr": "La lune est apparue derrière les nuages.", "id": "Bulan muncul dari balik awan.", "tr": "Ay bulutların ardından çıktı.", "ur": "چاند بادلوں کے پیچھے سے نمودار ہوا۔"}, "independentlyReviewed": true, "words": [{"arabic": "بَرَزَ", "target": true, "translation": {"bs": "pojavio se", "en": "emerged", "bn": "বেরিয়ে এল", "fa": "نمایان شد", "fr": "est apparu", "id": "muncul", "tr": "çıktı", "ur": "نمودار ہوا"}}, {"arabic": "الْقَمَرُ", "target": false, "translation": {"bs": "mjesec", "en": "the moon", "bn": "চাঁদ", "fa": "ماه", "fr": "la lune", "id": "bulan", "tr": "ay", "ur": "چاند"}}, {"arabic": "مِنْ", "target": false, "translation": {"bs": "od", "en": "from", "bn": "থেকে", "fa": "از", "fr": "de", "id": "dari", "tr": "-den", "ur": "سے"}}, {"arabic": "وَرَاءِ", "target": false, "translation": {"bs": "iza", "en": "behind", "bn": "পেছন", "fa": "پشت", "fr": "derrière", "id": "di balik", "tr": "arkasından", "ur": "پیچھے"}}, {"arabic": "السَّحَابِ", "target": false, "translation": {"bs": "oblaka", "en": "the clouds", "bn": "মেঘ", "fa": "ابرها", "fr": "les nuages", "id": "awan", "tr": "bulutlar", "ur": "بادل"}}]}, {"arabic": "بَرَزُوا فِي الرِّيَاضَةِ", "spoken": "audio/54c49c262fbb72d56fa2.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Istakli su se u sportu.", "en": "They excelled in sport.", "bn": "তারা খেলাধুলায় উজ্জ্বল হলো।", "fa": "آنان در ورزش درخشیدند.", "fr": "Ils ont excellé dans le sport.", "id": "Mereka unggul dalam olahraga.", "tr": "Sporda öne çıktılar.", "ur": "وہ کھیل میں نمایاں ہوئے۔"}, "independentlyReviewed": true, "words": [{"arabic": "بَرَزُوا", "target": true, "translation": {"bs": "istakli su se", "en": "they excelled", "bn": "তারা উজ্জ্বল হলো", "fa": "آنان درخشیدند", "fr": "ils ont excellé", "id": "mereka unggul", "tr": "öne çıktılar", "ur": "وہ نمایاں ہوئے"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "u", "en": "in", "bn": "মধ্যে", "fa": "در", "fr": "dans", "id": "di", "tr": "içinde", "ur": "میں"}}, {"arabic": "الرِّيَاضَةِ", "target": false, "translation": {"bs": "sportu", "en": "the sport", "bn": "খেলা", "fa": "ورزش", "fr": "le sport", "id": "olahraga", "tr": "spor", "ur": "کھیل"}}]}]}