noun": "anti", "arabic": "أَسْلِمِي", "plain": "أَسْلِمِي", "quran": false, "notUsed": false, "spoken": "audio/d4b76660aeb79f12198c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَسْلِمَا", "plain": "أَسْلِمَا", "quran": false, "notUsed": false, "spoken": "audio/961291da5419886a56c6.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَسْلِمُوا۟", "plain": "أَسْلِمُوا", "quran": true, "notUsed": false, "spoken": "audio/84c7914a8b799f1a82d6.m4a", "recited": "audio/a3b002350aea097f6ee9.m4a", "recitedText": "أَسْلِمُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَسْلِمْنَ", "plain": "أَسْلِمْنَ", "quran": false, "notUsed": false, "spoken": "audio/ab71ce3bad56f5167b92.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "72:14", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5461.mp3", "translation": {"en": {"text": "And there are among us some who have surrendered (to Allah) and there are among us some who are unjust. And whoso hath surrendered to Allah, such have taken the right path purposefully.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ve biz, bizlerden müslümanlar da var, hak yoldan sapanlar da var. Müslüman olanlar, işte onlar doğru yolu arayanlardır.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ کہ ہم میں کچھ مسلمان ہیں اور کچھ ظالم تو جو اسلام لائے انہوں نے بھلائی سوچی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya di antara kami ada orang-orang yang taat dan ada (pula) orang-orang yang menyimpang dari kebenaran. Barangsiapa yang yang taat, maka mereka itu benar-benar telah memilih jalan yang lurus.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُسْلِمُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَٰسِطُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَمَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَسْلَمَ", "hit": true, "audio": "audio/deb0ba69391537c1f34e.m4a", "gloss": {"en": "he/it submitted", "bs": "predao se", "tr": "teslim oldu", "fr": "il s'est soumis", "id": "dia telah berserah diri", "ur": "اُس نے تسلیم کیا", "bn": "সে আত্মসমর্পণ করল", "fa": "تسلیم شد"}}, {"text": "فَأُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَحَرَّوْا۟", "hit": false, "audio": null, "gloss": null}, {"text": "رَشَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:131", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/138.mp3", "translation": {"en": {"text": "When his Lord said unto him: Surrender! he said: I have surrendered to the Lord of the Worlds.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbi ona, \"İslâm ol!\" emrini verince, o \"Ben âlemlerin Rabbine teslim oldum.\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جبکہ اس سے اس کے رب نے فرمایا گردن رکھ عرض کی میں نے گردن رکھی اس کے لئے جو رب ہے سارے جہان کا-", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ketika Tuhannya berfirman kepadanya: \"Tunduk patuhlah!\" Ibrahim menjawab: \"Aku tunduk patuh kepada Tuhan semesta alam\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِذْ", "hit": false, "audio": null, "gloss": null}, {"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَسْلِمْ", "hit": true, "audio": "audio/4782f642b0a8d464979c.m4a", "gloss": {"bs": "predaj se", "en": "submit", "tr": "teslim ol", "fr": "soumets-toi", "id": "berserah dirilah", "ur": "سر تسلیم خم کر", "bn": "আত্মসমর্পণ করো", "fa": "تسلیم شو"}}, {"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَسْلَمْتُ", "hit": true, "audio": "audio/594d072d532220bffb92.m4a", "gloss": {"bs": "predao sam se", "en": "I have submitted", "tr": "teslim oldum", "fr": "je me suis soumis", "id": "aku telah berserah diri", "ur": "میں نے سر تسلیم خم کیا", "bn": "আমি আত্মসমর্পণ করেছি", "fa": "تسلیم شدم"}}, {"text": "لِرَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَٰلَمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:103", "tense": "past", "category": {"tense": "past", "pronoun": "huma", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3891.mp3", "translation": {"en": {"text": "Then, when they had both surrendered (to Allah), and he had flung him down upon his face,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ne zaman ki ikisi de bu şekilde Allah'a teslim oldular, İbrahim oğlunu şakağı üzerine yatırdı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو جب ان دونوں نے ہمارے حکم پر گردن رکھی اور باپ نے بیٹے کو ماتھے کے بل لٹایا اس وقت کا حال نہ پوچھ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tatkala keduanya telah berserah diri dan Ibrahim membaringkan anaknya atas pelipis(nya), (nyatalah kesabaran keduanya).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَمَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَسْلَمَا", "hit": true, "audio": "audio/2a9831eace94610a4cc0.m4a", "gloss": {"bs": "obojica su se predala", "en": "they both submitted", "tr": "ikisi de teslim oldu", "fr": "ils se soumirent tous deux", "id": "keduanya berserah diri", "ur": "دونوں نے سر تسلیم خم کیا", "bn": "তারা দুজনই আত্মসমর্পণ করল", "fa": "هر دو تسلیم شدند"}}, {"text": "وَتَلَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلْجَبِينِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَسْلَمَ", "count": 5, "first": "2:112", "audio": "audio/cc7aef106dd085cf9607.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it submitted", "bs": "predao se", "tr": "teslim oldu", "fr": "il s'est soumis", "id": "dia telah berserah diri", "ur": "اُس نے تسلیم کیا", "bn": "সে আত্মসমর্পণ করল", "fa": "تسلیم شد"}}, {"arabic": "أَسْلَمُوا۟", "count": 3, "first": "3:20", "audio": "audio/83136805f654a326cd96.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they submitted", "bs": "predali su se", "tr": "teslim oldular", "fr": "ils se sont soumis", "id": "mereka telah berserah diri", "ur": "انہوں نے تسلیم کیا", "bn": "তারা আত্মসমর্পণ করল", "fa": "تسلیم شدند"}}, {"arabic": "أَسْلَمْتُ", "count": 2, "first": "2:131", "audio": "audio/594d072d532220bffb92.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": false, "objects": []}], "gloss": {"bs": "predao sam se", "en": "I have submitted", "tr": "teslim oldum", "fr": "je me suis soumis", "id": "aku telah berserah diri", "ur": "میں نے سر تسلیم خم کیا", "bn": "আমি আত্মসমর্পণ করেছি", "fa": "تسلیم شدم"}}, {"arabic": "أَسْلِمْ", "count": 1, "first": "2:131", "audio": "audio/4782f642b0a8d464979c.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"bs": "predaj se", "en": "submit", "tr": "teslim ol", "fr": "soumets-toi", "id": "berserah dirilah", "ur": "سر تسلیم خم کر", "bn": "আত্মসমর্পণ করো", "fa": "تسلیم شو"}}, {"arabic": "ءَأَسْلَمْتُمْ", "count": 1, "first": "3:20", "audio": "audio/91578c2747070dfa3a87.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "did you (all) submit?", "bs": "zar ste se predali?