ama RI, via tanzil.net"}}, "words": [{"text": "بَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَجِبْتَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَسْخَرُونَ", "hit": true, "audio": "audio/0d5ddabd3bbd7206042a.m4a", "gloss": {"bs": "a oni se rugaju", "en": "and they ridicule", "tr": "ve onlar alay ederler", "fr": "et ils se moquent", "id": "dan mereka mengolok-olok", "ur": "اور وہ مذاق اڑاتے ہیں", "bn": "এবং তারা উপহাস করে", "fa": "و مسخره می‌کنند"}}]}], "forms": [{"arabic": "سَخِرُوا۟", "count": 3, "first": "6:10", "audio": "audio/6e508f610306de52fd5f.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they ridiculed", "bs": "ismijali su", "tr": "alay ettiler", "fr": "ils se sont moqués", "id": "mereka telah mengolok-olok", "ur": "انہوں نے مذاق اڑایا", "bn": "তারা উপহাস করল", "fa": "مسخره کردند"}}, {"arabic": "وَيَسْخَرُونَ", "count": 2, "first": "2:212", "audio": "audio/0d5ddabd3bbd7206042a.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "a oni se rugaju", "en": "and they ridicule", "tr": "ve onlar alay ederler", "fr": "et ils se moquent", "id": "dan mereka mengolok-olok", "ur": "اور وہ مذاق اڑاتے ہیں", "bn": "এবং তারা উপহাস করে", "fa": "و مسخره می‌کنند"}}, {"arabic": "فَيَسْخَرُونَ", "count": 1, "first": "9:79", "audio": "audio/ad5ad894051462e00a71.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "so they ridicule", "bs": "pa ismijavaju", "tr": "böylece alay ederler", "fr": "alors ils se moquent", "id": "maka mereka mengolok-olok", "ur": "پس وہ مذاق اڑاتے ہیں", "bn": "অতএব তারা উপহাস করে", "fa": "پس مسخره می‌کنند"}}, {"arabic": "سَخِرَ", "count": 1, "first": "9:79", "audio": "audio/947cbac12fd983c2c1cd.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it ridicu