{"rank": 115, "root": "سوي", "form": 8, "lemma": "اسْتَوَى", "count": 35, "ayahCount": 33, "share": 0.18, "meaning": {"bs": "ustaliti se, uzdići se", "en": "to be level, to settle, to rise", "tr": "istiva etmek, yükselmek", "fr": "être égal, se stabiliser, s'établir", "id": "bersemayam, menetap, naik", "ur": "برابر ہونا، قائم ہونا، بلند ہونا", "bn": "সমান হওয়া, স্থির হওয়া, আরোহণ করা", "fa": "مستوی شدن، استقرار یافتن، بالا رفتن"}, "lemmaSpoken": "audio/c61153cee50c7aeb7638.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "ٱسْتَوَىٰ", "plain": "اِسْتَوَى", "quran": true, "notUsed": false, "spoken": "audio/c61153cee50c7aeb7638.m4a", "recited": "audio/269202d904d5ad0e7b61.m4a", "recitedText": "ٱسْتَوَىٰ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَسْتَوِى", "plain": "يَسْتَوِي", "quran": true, "notUsed": false, "spoken": "audio/890f52e345d0f0925354.m4a", "recited": "audio/1b840a87dc7762871673.m4a", "recitedText": "يَسْتَوِى"}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "اِسْتَوَيْتُ", "plain": "اِسْتَوَيْتُ", "quran": false, "notUsed": false, "spoken": "audio/43b7ee951c41174bb4db.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "اِسْتَوَيْنَا", "plain": "اِسْتَوَيْنَا", "quran": false, "notUsed": false, "spoken": "audio/5759fb4b8b56935560d9.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "ٱسْتَوَيْتَ", "plain": "اِسْتَوَيْتَ", "quran": true, "notUsed": false, "spoken": "audio/c469e683de160fc986c2.m4a", "recited": "audio/e21f86d14eb6f410ab00.m4a", "recitedText": "ٱسْتَوَيْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "اِسْتَوَيْتِ", "plain": "اِسْتَوَيْتِ", "quran": false, "notUsed": false, "spoken": "audio/b155ee01b4b43ee8efb8.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "اِسْتَوَيْتُمَا", "plain": "اِسْتَوَيْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/7c42