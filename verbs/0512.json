"plain": "تِمِّي", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "تِمَّا", "plain": "تِمَّا", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "تِمُّوا", "plain": "تِمُّوا", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِتْمِمْنَ", "plain": "اِتْمِمْنَ", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}], "ayat": [{"ref": "6:115", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/904.mp3", "translation": {"en": {"text": "Perfected is the Word of thy Lord in truth and justice. There is naught that can change His words. He is the Hearer, the Knower.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbinin sözü hem doğrulukça, hem de adaletçe tamamlanmıştır. O'nun sözlerini değiştirebilecek hiç kimse yoktur. O, işitendir, bilendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور پوری ہے تیرے رب کی بات سچ اور انصاف میں اس کی باتوں کا کوئی بدلنے والا نہیں اور وہی ہے سنتا جانتا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Telah sempurnalah kalimat Tuhanmu (Al-Quran) sebagai kalimat yang benar dan adil. Tidak ada yang dapat merubah rubah kalimat-kalimat-Nya dan Dialah yang Maha Mendenyar lagi Maha Mengetahui.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَتَمَّتْ", "hit": true, "audio": "audio/5bb5663ed566cbd83104.m4a", "gloss": {"bs": "i ispunila se", "en": "and was fulfilled", "tr": "ve gerçekleşti", "fr": "et s'est accomplie", "id": "dan telah sempurna", "ur": "اور پوری ہو گئی", "bn": "এবং তা পূর্ণ হলো", "fa": "و کامل شد"}}, {"text": "كَلِمَتُ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "صِدْقًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَعَدْلًا", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مُبَدِّلَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِكَلِمَٰتِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمِيعُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَلِيمُ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَتَمَّتْ", "count": 3, "first": "6:115", "audio": "audio/5bb5663ed566cbd83104.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"bs": "i ispunila se", "en": "and was fulfilled", "tr": "ve tamamlandı", "fr": "et elle s'est accomplie", "id": "dan dia telah terpenuhi", "ur": "اور پورا ہوا", "bn": "এবং তা পূর্ণ হলো", "fa": "و کامل شد"}}, {"arabic": "فَتَمَّ", "count": 1, "first": "7:142", "audio": "audio/9e2637f2a3dbd23b4909.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "so he/it was complete", "bs": "pa se ispunio", "tr": "böylece tamamlandı", "fr": "alors il s'est accompli", "id": "maka dia telah sempurna", "ur": "پس وہ مکمل ہوا", "bn": "অতএব সে পূর্ণ হলো", "fa": "پس کامل شد"}}], "ayatFile": "ayat/0512.json", "ayatTranslations": {"en": "ayat/0512.en.json", "tr": "ayat/0512.tr.json", "ur": "ayat/0512.ur.json", "id": "ayat/0512.id.json"}, "sentences": [{"arabic": "تَمَّ الْبِنَاءُ فِي الصَّيْفِ", "spoken": "audio/e76b3cacfe363bdcccc9.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Zgrada je završena tokom ljeta.", "en": "The building was completed in the summer.", "bn": "গ্রীষ্মকালে ভবনটির নির্মাণ সম্পন্ন হয়েছে।", "fa": "ساختمان در تابستان به پایان رسید.", "fr": "Le bâtiment a été achevé durant l'été.", "id": "Bangunan itu selesai pada musim panas.", "tr": "Bina yaz boyunca tamamlandı.", "ur": "عمارت گرمیوں میں مکمل ہو گئی۔"}, "independentlyReviewed": true, "words": [{"arabic": "تَمَّ", "target": true, "translation": {"bs": "završena je", "en": "was completed", "bn": "সম্পন্ন হয়েছে", "fa": "تمام شد", "fr": "a été achevée", "id": "telah selesai", "tr": "tamamlandı", "ur": "مکمل ہوا"}}, {"arabic": "الْبِنَاءُ", "target": false, "translation": {"bs": "zgrada", "en": "the building", "bn": "ভবন", "fa": "ساختمان", "fr": "le bâtiment", "id": "bangunan itu", "tr": "bina", "ur": "عمارت"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "tokom", "en": "in", "bn": "মধ্যে", "fa": "در", "fr": "dans", "id": "di", "tr": "içinde", "ur": "میں"}}, {"arabic": "الصَّيْفِ", "target": false, "translation": {"bs": "ljeta", "en": "the summer", "bn": "গ্রীষ্মের", "fa": "تابستان", "fr": "l'été", "id": "musim panas", "tr": "yaz", "ur": "گرمی"}}]}, {"arabic": "تَمَّتِ الرِّحْلَةُ بِنَجَاحٍ", "spoken": "audio/8e16803d6457aac0ec69.m4a", "tense": "past", "pronoun": "hiya", "translation": {"bs": "Putovanje je uspješno završeno.", "en": "The journey was completed with success.", "bn": "যাত্রাটি সফলভাবে সম্পন্ন হয়েছে।", "fa": "سفر با موفقیت به پایان رسید.", "fr": "Le voyage s'est achevé avec succès.", "id": "Perjalanan itu selesai dengan sukses.", "tr": "Yolculuk başarıyla tamamlandı.", "ur": "سفر کامیابی کے ساتھ مکمل ہو گیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "تَمَّتِ", "target": true, "translation": {"bs": "završeno je", "en": "was completed", "bn": "সম্পন্ন হয়েছে", "fa": "تمام شد", "fr": "a été achevé", "id": "telah selesai", "tr": "tamamlandı", "ur": "مکمل ہوئی"}}, {"arabic": "الرِّحْلَةُ", "target": false, "translation": {"bs": "putovanje", "en": "the journey", "bn": "যাত্রা", "fa": "سفر", "fr": "le voyage", "id": "perjalanan itu", "tr": "yolculuk", "ur": "سفر"}}, {"arabic": "بِنَجَاحٍ", "target": false, "translation": {"bs": "uspješno", "en": "with 