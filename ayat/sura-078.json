{"ayat":[{"ref":"78:1","number":5673,"text":"عَمَّ يَتَسَآءَلُونَ","hits":[0,1]},{"ref":"78:2","number":5674,"text":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","hits":[1,2]},{"ref":"78:3","number":5675,"text":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","hits":[0,1,2,3]},{"ref":"78:4","number":5676,"text":"كَلَّا سَيَعْلَمُونَ","hits":[0,1]},{"ref":"78:5","number":5677,"text":"ثُمَّ كَلَّا سَيَعْلَمُونَ","hits":[0]},{"ref":"78:6","number":5678,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًا","hits":[0,1,2]},{"ref":"78:7","number":5679,"text":"وَٱلْجِبَالَ أَوْتَادًا","hits":[0,1]},{"ref":"78:8","number":5680,"text":"وَخَلَقْنَٰكُمْ أَزْوَٰجًا","hits":[0,1]},{"ref":"78:9","number":5681,"text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا","hits":[1]},{"ref":"78:10","number":5682,"text":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا","hits":[1,2]},{"ref":"78:11","number":5683,"text":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا","hits":[1]},{"ref":"78:12","number":5684,"text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا","hits":[0,3]},{"ref":"78:13","number":5685,"text":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا","hits":[1,2]},{"ref":"78:14","number":5686,"text":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا","hits":[0,1,3]},{"ref":"78:15","number":5687,"text":"لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا","hits":[0,1,2,3]},{"ref":"78:16","number":5688,"text":"وَجَنَّٰتٍ أَلْفَافًا","hits":[0]},{"ref":"78:17","number":5689,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًا","hits":[0,1,3,4]},{"ref":"78:18","number":5690,"text":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا","hits":[1,4,5]},{"ref":"78:19","number":5691,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا","hits":[0,1,3]},{"ref":"78:20","number":5692,"text":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","hits":[0,3]},{"ref":"78:21","number":5693,"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا","hits":[]},{"ref":"78:22","number":5694,"text":"لِّلطَّٰغِينَ مَـَٔابًا","hits":[]},{"ref":"78:23","number":5695,"text":"لَّٰبِثِينَ فِيهَآ أَحْقَابًا","hits":[]},{"ref":"78:24","number":5696,"text":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا","hits":[0,1,3,5]},{"ref":"78:25","number":5697,"text":"إِلَّا حَمِيمًا وَغَسَّاقًا","hits":[0]},{"ref":"78:26","number":5698,"text":"جَزَآءً وِفَاقًا","hits":[0]},{"ref":"78:27","number":5699,"text":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا","hits":[3,4]},{"ref":"78:28","number":5700,"text":"وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًا","hits":[0,1]},{"ref":"78:29","number":5701,"text":"وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًا","hits":[1,2,3]},{"ref":"78:30","number":5702,"text":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","hits":[1,2,4]},{"ref":"78:31","number":5703,"text":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","hits":[1]},{"ref":"78:32","number":5704,"text":"حَدَآئِقَ وَأَعْنَٰبًا","hits":[0,1]},{"ref":"78:33","number":5705,"text":"وَكَوَاعِبَ أَتْرَابًا","hits":[]},{"ref":"78:34","number":5706,"text":"وَكَأْسًا دِهَاقًا","hits":[0]},{"ref":"78:35","number":5707,"text":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا","hits":[1,3]},{"ref":"78:36","number":5708,"text":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا","hits":[2,3]},{"ref":"78:37","number":5709,"text":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","hits":[3,7,9]},{"ref":"78:38","number":5710,"text":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّا لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًا","hits":[1,2,3,6,8,9,10,12]},{"ref":"78:39","number":5711,"text":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","hits":[0,2,4,5,6]},{"ref":"78:40","number":5712,"text":"إِنَّآ أَنذَرْنَٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا","hits":[1,3,5,6,8,9,11,12,14]}]}