َدُّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُجْرِمُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَفْتَدِى", "hit": true, "audio": "audio/223a29de96cd294ca2f3.m4a", "gloss": {"bs": "otkupio bi se", "en": "he could ransom himself", "tr": "kendini fidye verip kurtarmak ister", "fr": "il se rachèterait", "id": "dia menebus dirinya", "ur": "وہ فدیہ دینا چاہے گا", "bn": "সে নিজেকে মুক্ত করতে চাইবে", "fa": "تا فدیه دهد"}}, {"text": "مِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمِئِذٍۭ", "hit": false, "audio": null, "gloss": null}, {"text": "بِبَنِيهِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "لَٱفْتَدَوْا۟", "count": 2, "first": "13:18", "audio": "audio/64682c1408b4c7e1f124.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}]}, {"arabic": "ٱفْتَدَتْ", "count": 1, "first": "2:229", "audio": "audio/83aab5c632bcaf2476e9.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"en": "she/it ransomed", "bs": "otkupila je", "tr": "fidye verdi", "fr": "elle a racheté", "id": "dia telah menebus", "ur": "اُس نے فدیہ دیا", "bn": "সে মুক্তিপণ দিল", "fa": "فدیه داد"}}, {"arabic": "ٱفْتَدَىٰ", "count": 1, "first": "3:91", "audio": "audio/18f88b709d409f632c17.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it ransomed", "bs": "otkupio je", "tr": "fidye verdi", "fr": "il a racheté", "id": "dia telah menebus", "ur": "اُس نے فدیہ دیا", "bn": "সে মুক্তিপণ দিল", "fa": "فدیه داد"}}, {"arabic": "لِيَفْتَدُوا۟", "count": 1, "first": "5:36", "audio": "audio/918d59b258b7a548580d.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "so that they may ransom", "bs": "da otkupe"