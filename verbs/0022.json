, "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "we seized", "bs": "kaznili smo", "tr": "yakaladık", "fr": "nous avons châtié", "id": "kami telah menghukum", "ur": "ہم نے پکڑا", "bn": "আমরা শাস্তি দিলাম", "fa": "مجازات کردیم"}}, {"arabic": "فَأَخَذْنَٰهُ", "count": 3, "first": "28:40", "audio": "audio/6631d191606c1cb48acd.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["huwa"]}]}, {"arabic": "يُؤْخَذُ", "count": 2, "first": "2:48", "audio": "audio/2db2fd20bd33921cd30f.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "it is taken", "bs": "uzima se", "tr": "alınır", "fr": "il se prend", "id": "diambil", "ur": "لیا جاتا ہے", "bn": "তা নেওয়া হয়", "fa": "گرفته می‌شود"}}, {"arabic": "أَخَذَتْهُ", "count": 2, "first": "2:206", "audio": "audio/fe74d4a3298f7031c171.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "she/it took him", "bs": "uzela ga je", "tr": "onu aldı", "fr": "elle l'a pris", "id": "dia telah mengambilnya", "ur": "اُس نے اسے لیا", "bn": "সে তাকে নিয়ে গেল", "fa": "او را گرفت"}}, {"arabic": "تَأْخُذُوا۟", "count": 2, "first": "2:229", "audio": "audio/f4c5dec2bad2279b37ac.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}, {"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "you (all) take", "bs": "uzimate", "tr": "alırsınız", "fr": "que vous preniez", "id": "kalian mengambil", "ur": "تم سب لو", "bn": "তোমরা নাও", "fa": "بگیرید"}}, {"arabic": "فَخُذُوهُمْ", "count": 2, "first": "4:89", "audio": "audio/33da8eddd1c564f5410a.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["hum"]}], "gloss": {"en": "so (you all) take them!", "bs": "pa ih uzmite!", "tr": "böylece onları alın!", "fr": "prenez-les 