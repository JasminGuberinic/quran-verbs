gloss": null}]}, {"ref": "26:51", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2983.mp3", "translation": {"en": {"text": "Lo! we ardently hope that our Lord will forgive us our sins because we are the first of the believers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Herhalde biz müminlerin evveli olduğumuzdan dolayı, Rabbimizin bize mağfiret buyuracağını ümit ederiz\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہمیں طمع ہے کہ ہمارا رب ہماری خطائیں بخش دے اس پر کہ سب سے پہلے ایمان لائے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "sesungguhnya kami amat menginginkan bahwa Tuhan kami akan mengampuni kesalahan kami, karena kami adalah orang-orang yang pertama-tama beriman\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "نَطْمَعُ", "hit": true, "audio": "audio/34681b32d6708a26583f.m4a", "gloss": {"en": "we hope", "bs": "nadamo se", "tr": "umarız", "fr": "nous espérons", "id": "kami berharap", "ur": "ہم امید رکھتے ہیں", "bn": "আমরা আশা করি", "fa": "امید داریم"}}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَغْفِرَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّنَا", "hit": false, "audio": null, "gloss": null}, {"text": "خَطَٰيَٰنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "كُنَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَوَّلَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُؤْمِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:82", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3014.mp3", "translation": {"en": {"text": "And Who, I ardently hope, will forgive me my sin on the Day of Judgment.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ve hesap günü, hatamı bağışlayacağını umduğumdur.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جس کی مجھے آس لگی ہے کہ میری خطائیں قیامت کے دن بخشے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan Yang amat kuinginkan akan mengampuni kesalahanku pada hari kiamat\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَطْمَعُ", "hit": true, "audio": "audio/c8f00d8c50bee9ccd746.m4a", "gloss": {"en": "I hope", "bs": "nadam se", "tr": "umarım", "fr": "j'espère", "id": "aku berharap", "ur": "میں امید رکھتا ہوں", "bn": "আমি আশা করি", "fa": "امید دارم"}}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَغْفِرَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِى", "hit": false, "audio": null, "gloss": null}, {"text": "خَطِيٓـَٔتِى", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلدِّينِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَفَتَطْمَعُونَ", "count": 1, "first": "2:75", "audio": "audio/0c6fa81fabcb3586abfa.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}]}, {"arabic": "وَنَطْمَعُ", "count": 1, "first": "5:84", "audio": "audio/32130e26b93b902f2d98.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "indicative"}]}, {"arabic": "يَطْمَعُونَ", "count": 1, "first": "7:46", "audio": "audio/bc14018f466831f2ca62.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they hope", "bs": "nadaju se", "tr": "umar