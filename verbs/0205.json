n": false, "notUsed": false, "spoken": "audio/7fa4085f5af66836d123.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِخْسَرِي", "plain": "اِخْسَرِي", "quran": false, "notUsed": false, "spoken": "audio/1fe5c394cb588b2fbc1e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِخْسَرَا", "plain": "اِخْسَرَا", "quran": false, "notUsed": false, "spoken": "audio/ebc3fd47aab2ad7fd90c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِخْسَرُوا", "plain": "اِخْسَرُوا", "quran": false, "notUsed": false, "spoken": "audio/bc28a272a68d1f9fd9a8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِخْسَرْنَ", "plain": "اِخْسَرْنَ", "quran": false, "notUsed": false, "spoken": "audio/fb1011ec73856d126464.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "11:21", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1494.mp3", "translation": {"en": {"text": "Such are they who have lost their souls, and that which they used to invent hath failed them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar kendilerine yazık etmiş olan kimselerdir. O iftira edip uydurdukları da kendilerinden yüz çevirip gitmişlerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہی ہیں جنہوں نے اپنی جانیں گھاٹے میں ڈالیں اور ان سے کھوئی گئیں جو باتیں جوڑتے تھے خواہ نخواہ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka itulah orang-orang yang merugikan dirinya sendiri, dan lenyaplah dari mereka apa yang selalu mereka ada-adakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"t