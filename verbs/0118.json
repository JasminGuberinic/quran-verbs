 "pronoun": "hunna", "arabic": "يَقُمْنَ", "plain": "يَقُمْنَ", "quran": false, "notUsed": false, "spoken": "audio/9847703bcc2f4b4bd11d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "قُمِ", "plain": "قُمْ", "quran": true, "notUsed": false, "spoken": "audio/6991a07f62990fbf5fa8.m4a", "recited": "audio/33a076aebd73b7c0ec96.m4a", "recitedText": "قُمِ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "قُومِي", "plain": "قُومِي", "quran": false, "notUsed": false, "spoken": "audio/b02ca9e67b257e112f9d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "قُومَا", "plain": "قُومَا", "quran": false, "notUsed": false, "spoken": "audio/c28dcdc264d1b9fb8782.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "قُومُوا۟", "plain": "قُومُوا", "quran": true, "notUsed": false, "spoken": "audio/fb4e9c6260b0c4c7ecd9.m4a", "recited": "audio/c2ef2411bb7c39aa1174.m4a", "recitedText": "وَقُومُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "قُمْنَ", "plain": "قُمْنَ", "quran": false, "notUsed": false, "spoken": "audio/aabb0087936c7e7730cc.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "30:12", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3421.mp3", "translation": {"en": {"text": "And in the day when the Hour riseth the unrighteous will despair.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kıyamet saatinin gelip çattığı gün suçlular, her ümidi keserler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جس دن قیامت قائم ہوگی مجرموں کی آس ٹوٹ جائے گی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan pada hari terjadinya kiamat, orang-orang yang berdosa terdiam berputus asa.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَقُومُ", "hit": true, "audio": "audio/aaba2d7600b76bd4df8a.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}, {"text": "ٱلسَّاعَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "يُبْلِسُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُجْرِمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:218", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3150.mp3", "translation": {"en": {"text": "Who seeth thee when thou standest up (to pray)", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O ki, (gece namaza) kalktığın zaman seni görüyor.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جو تمہیں دیکھتا ہے جب تم کھڑے ہوتے ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Yang melihat kamu ketika kamu berdiri (untuk sembahyang),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "يَرَىٰكَ", "hit": false, "audio": null, "gloss": null}, {"text": "حِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَقُومُ", "hit": true, "audio": "audio/f27e7fd101be19018c0f.m4a", "gloss": {"bs": "ustaješ", "en": "you stand", "tr": "kalkarsın", "fr": "tu te lèves", "id": "kamu berdiri", "ur": "تم کھڑے ہوتے ہو", "bn": "তুমি দাঁড়াও", "fa": "می‌ایستی"}}]}, {"ref": "83:6", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5854.mp3", "translation": {"en": {"text": "The day when (all) mankind stand before the Lord of the Worlds?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Öyle bir gün ki, insanlar o gün Rabblerinin huzurunda divan duracaklar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جس دن سب لوگ رب العالمین کے حضور کھڑے ہوں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yaitu) hari (ketika) manusia berdiri menghadap Tuhan semesta alam?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُومُ", "hit": true, "audio": "audio/ce1717fdfe0626f23bbc.m4a", "gloss": {"en": "he/it stands", "bs": "stoji", "tr": "durur", "fr": "il se tient debout", "id": "dia berdiri", "ur": "وہ کھڑا ہوتا ہے", "bn": "সে দাঁড়ায়", "fa": "می‌ایستد"}}, {"text": "ٱلنَّاسُ", "hit": false, "audio": null, "gloss": null}, {"text": "لِرَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَٰلَمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "73:2", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5477.mp3", "translation": {"en": {"text": "Keep vigil the night long, save a little -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Gecenin birazı hariç olmak üzere geceleyin kalk (namaz kıl).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "رات میں قیام فرما سوا کچھ رات کے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "bangunlah (untuk sembahyang) di malam hari, kecuali sedikit (daripadanya),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُمِ", "hit": true, "audio": "audio/33a076aebd73b7c0ec96.m4a", "gloss": {"bs": "ustani", "en": "stand", "tr": "kalk", "fr": "lève-toi", "id": "berdirilah", "ur": "کھڑے ہو جاؤ", "bn": "তুমি দাঁড়াও", "fa": "برخیز"}}, {"text": "ٱلَّيْلَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "قَلِيلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:238", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/245.mp3", "translation": {"en": {"text": "Be guardians of your prayers, and of the midmost prayer, and stand up with devotion to Allah.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Namazlara ve orta namaza devam edin ve Allah için boyun eğerek kalkıp namaza durun.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "نگہبانی کرو سب نمازوں کی اور بیچ کی نماز کی اور کھڑے ہو اللہ کے حضور ادب سے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Peliharalah semua shalat(mu), dan (peliharalah) shalat wusthaa. Berdirilah untuk Allah (dalam shalatmu) dengan khusyu'.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "حَٰفِظُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّلَوَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلصَّلَوٰةِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْوُسْطَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "وَقُومُوا۟", "hit": true, "audio": "audio/c2ef2411bb7c39aa1174.m4a", "gloss": {"en": "and (you all) stand!", "bs": "i stanite!", "tr": "ve durun!", "fr": "et tenez-vous debout !", "id": "dan berdirilah kalian!", "ur": "اور کھڑے ہو!", "bn": "এবং দাঁড়াও!", "fa": "و بایستید!"}}, {"text": "لِلَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "قَٰنِتِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "72:19", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5466.mp3", "translation": {"en": {"text": "And when the slave of Allah stood up in prayer to Him, they crowded on him, almost stifling.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah'ın kulu (Hz. Peygamber) kalkmış O'na dua ederken, neredeyse (cinler) onun etrafında keçe gibi birbirlerine geçeceklerdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ کہ جب اللہ کا بندہ اس کی بندگی کرنے کھڑا ہوا تو قریب تھا کہ وہ جن اس پر ٹھٹھ کے ٹھٹھ ہوجائیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan bahwasanya tatkala hamba Allah (Muhammad) berdiri menyembah-Nya (mengerjakan ibadat), hampir saja jin-jin itu desak mendesak mengerumuninya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "لَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "قَامَ", "hit": true, "audio": "audio/f2567b20498da3393ee1.m4a", "gloss": {"bs": "ustao je", "en": "stood", "tr": "kalktı", "fr": "se leva", "id": "berdiri", "ur": "وہ کھڑا ہوا", "bn": "সে দাঁড়াল", "fa": "ایستاد"}}, {"text": "عَبْدُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَدْعُوهُ", "hit": false, "audio": null, "gloss": null}, {"text": "كَادُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَكُونُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "لِبَدًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تَقُومُ", "count": 8, "first": "26:218", "audio": "audio/f27e7fd101be19018c0f.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}, {"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "indicative"}]}, {"arabic": "يَقُومُ", "count": 5, "first": "2:275", "audio": "audio/9d7e9b95113838f32cf5.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it stands", "bs": "stoji", "tr": "durur", "fr": "il se tient 