ext": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُرْجُمَا", "plain": "اُرْجُمَا", "quran": false, "notUsed": false, "spoken": "audio/666e960061b9f5e4649c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُرْجُمُوا", "plain": "اُرْجُمُوا", "quran": false, "notUsed": false, "spoken": "audio/35fc80f595ec2c2dceb4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُرْجُمْنَ", "plain": "اُرْجُمْنَ", "quran": false, "notUsed": false, "spoken": "audio/6c995c7729c872cbc1f6.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "19:46", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2296.mp3", "translation": {"en": {"text": "He said: Rejectest thou my gods, O Abraham? If thou cease not, I shall surely stone thee. Depart from me a long while!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Babası \"Ey İbrahim! Sen benim ilâhlarımdan yüz mü çeviriyorsun? Yemin ederim ki, eğer (onları kötülemekten) vazgeçmezsen, seni muhakkak taşlarım. (gerçektenveya söz ilesana taş atarım). Haydi uzun bir müddet benden uzak ol\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولا کیا تو میرے خداؤں سے منہ پھیرتا ہے، اے ابراہیم بیشک اگر تو باز نہ آیا تو میں تجھے پتھراؤ کروں گا اور مجھ سے زمانہ دراز تک بے علاقہ ہوجا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berkata bapaknya: \"Bencikah kamu kepada tuhan-tuhanku, hai Ibrahim? Jika kamu tidak berhenti, maka niscaya kamu akan kurajam, dan tinggalkanlah aku buat waktu yang lama\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرَاغِبٌ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَالِهَتِى", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰٓإِبْرَٰهِيمُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَئِن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَنتَهِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَأَرْجُمَنَّكَ", "hit": true, "audio": "audio/add55ef2a4b663657ccd.m4a", "gloss": {"en": "surely I will stone you", "bs": "zaista ću te kamenovati", "tr": "kesinlikle seni taşlayacağım", "fr": "je te lapiderai assurément", "id": "sungguh aku akan merajammu", "ur": "یقیناً میں تمہیں سنگسار کروں گا", "bn": "নিশ্চয়ই আমি তোমাকে পাথর মারব", "fa": "قطعاً تو را سنگسار خواهم کرد"}}, {"text": "وَٱهْجُرْنِى", "hit": false, "audio": null, "gloss": null}, {"text": "مَلِيًّا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:18", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3723.mp3", "translation": {"en": {"text": "(The people of the city) said: We augur ill of you. If ye desist not, we shall surely stone you, and grievous torture will befall you at our hands.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar dediler ki: \"Herhalde biz sizin yüzünüzden uğursuzluğa uğradık. Eğer bu işten vazgeçmezseniz, andolsun ki, sizi hiç tınmadan taşlarız ve mutlaka bizden size pek acıklı bir azab dokunur.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے ہم تمہیں منحوس سمجھتے ہیں بیشک اگر تم باز نہ آئے تو ضرور ہم تمہیں سنگسار کریں گے بیشک ہمارے ہاتھوں تم پر دکھ کی مار پڑے گی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka menjawab: \"Sesungguhnya kami bernasib malang karena kamu, sesungguhnya jika kamu tidak berhenti (menyeru kami), niscaya kami akan merajam kamu dan kamu pasti akan mendapat siksa yang pedih dari kami\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تَطَيَّرْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "بِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَئِن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَنتَهُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَرْجُمَنَّكُمْ", "hit": true, "audio": "audio/f0464fa0ae3247f28a80.m4a", "gloss": {"en": "surely we will stone you (all)", "bs": "zaista ćemo vas kamenovati", "tr": "kesinlikle sizi taşlayacağız", "fr": "nous vous lapiderons assurément", "id": "sungguh kami akan merajam kalian", "ur": "یقیناً ہم تم سب کو سنگسار کریں گے", "bn": "নিশ্চয়ই আমরা তোমাদের পাথর মারব", "fa": "قطعاً شما را سنگسار خواهیم کرد"}}, {"text": "وَلَيَمَسَّنَّكُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابٌ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "44:20", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4434.mp3", "translation": {"en": {"text": "And lo! I have sought refuge in my Lord and your Lord lest ye stone me to death.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Gerçekten ben, beni taşlamanızdan dolayı benim de Rabbim, sizin de Rabbiniz olan Allah'a sığındım.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور میں پناہ لیتا ہوں اپنے رب اور تمہارے رب کی اس سے کہ تم مجھے سنگسار کرو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya aku berlindung kepada Tuhanku dan Tuhanmu, dari keinginanmu