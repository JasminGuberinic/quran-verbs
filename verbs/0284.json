arabic": "عَاهِدْ", "plain": "عَاهِدْ", "quran": false, "notUsed": false, "spoken": "audio/6025312c9be263429b85.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "عَاهِدِي", "plain": "عَاهِدِي", "quran": false, "notUsed": false, "spoken": "audio/629a40dfa96df4830f9c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "عَاهِدَا", "plain": "عَاهِدَا", "quran": false, "notUsed": false, "spoken": "audio/7edb4d918655743d86bd.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "عَاهِدُوا", "plain": "عَاهِدُوا", "quran": false, "notUsed": false, "spoken": "audio/fc031f11d0f2ad0a9ef8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "عَاهِدْنَ", "plain": "عَاهِدْنَ", "quran": false, "notUsed": false, "spoken": "audio/d1097f4bc012fbfbe382.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "2:100", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/107.mp3", "translation": {"en": {"text": "Is it ever so that when they make a covenant a party of them set it aside? The truth is, most of them believe not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O fasıklar hem bunları tanımıyacaklar, hem de ne zaman bir ahd üzerine antlaşma yapsalar, her defasında mutlaka içlerinden bir güruh çıkıp onu bozacak ve atıverecek öyle mi? Hatta az bir güruh değil, onların çoğu ahit tanımaz imansızlardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور کیا جب کبھی کوئی عہد کرتے ہیں ان میں کا ایک فریق اسے پھینک دیتا ہے بلکہ ان میں بہتیروں کو ایمان نہیں -", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Patutkah (mereka ingkar kepada ayat-ayat Allah), dan setiap kali mereka mengikat janji, segolongan mereka melemparkannya? Bahkan sebagian besar dari mereka tidak beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَوَكُلَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "عَٰهَدُوا۟", "hit": true, "audio": "audio/f9508d30329917147b0a.m4a", "gloss": {"en": "they made a covenant with", "bs": "sklopili su savez", "tr": "antlaşma yaptılar", "fr": "ils ont conclu une alliance avec", "id": "mereka telah membuat perjanjian dengan", "ur": "انہوں نے عہد کیا", "bn": "তারা চুক্তি করেছে", "fa": "پیمان بستند"}}, {"text": "عَهْدًا", "hit": false, "audio": null, "gloss": null}, {"text": "نَّبَذَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فَرِيقٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْهُم", "hit": false, "audio": null, "gloss": null}, {"text": "بَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَكْثَرُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُؤْمِنُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "9:1", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1236.mp3", "translation": {"en": {"text": "Freedom from obligation (is proclaimed) from Allah and His messenger toward those of the idolaters with whom ye made a treaty.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah'dan ve Resulü'nden bir ültimatomdur bu, kendileriyle antlaşma yaptığınız müşriklere:", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیزاری کا حکم سنانا ہے اللہ اور اس کے رسول کی طرف سے ان مشرکوں کو جن سے تمہارا معاہدہ تھا اور وہ قائم نہ رہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Inilah pernyataan) pemutusan hubungan dari Allah dan Rasul-Nya (yang dihadapkan) kepada orang-orang musyrikin yang kamu (kaum muslimin) telah mengadakan perjanjian (dengan mereka).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "بَرَآءَةٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَرَسُولِهِۦٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَٰهَدتُّم", "hit": true, "audio": "audio/349b7f0335010cddba42.m4a", "gloss": {"bs": "ste sklopili ugovor", "en": "you made a covenant", "tr": "ahitleştiniz", "fr": "vous avez conclu un pacte", "id": "kamu telah mengikat perjanjian", "ur": "تم نے عہد کیا", "bn": "তোমরা অঙ্গীকার করেছিলে", "fa": "پیمان بستید"}}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُشْرِكِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "9:75", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1310.mp3", "translation": {"en": {"text": "And of them is he who made a covenant with Allah (saying): If He give us of His bounty we will give alms and become of the righteous.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yine onlardan kimi de Allah'a şöyle ahdetmişlerdi: \"Eğer bize lütuf ve kereminden ihsan ederse biz de elbette zekâtı veririz ve kesinlikle salihlerden oluruz.\" diye söz vermişlerdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان میں کوئی وہ ہیں جنہوں نے اللہ سے عہد کیا تھا کہ اگر ہمیں اپنے فضل سے دے تو ہم ضرور خیرات کریں گے اور ہم ضرور بھلے آدمی ہوجائیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan diantara mereka ada orang yang telah berikrar kepada Allah: \"Sesungguhnya jika Allah memberikan sebahagian karunia-Nya kepada kami, pastilah kami akan bersedekah dan pastilah kami termasuk orang-orang yang saleh.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمِنْهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَٰهَدَ", "hit": true, "audio": "audio/8b95f4cd77b5e40e02d1.m4a", "gloss": {"en": "he/it made a covenant with", "bs": "sklopio je savez", "tr": "antlaşma yaptı", "fr": "il a conclu une alliance avec", "id": "dia telah membuat perjanjian dengan", "ur": "اُس نے عہد کیا", "bn": "সে চুক্তি করল", "fa": "پیمان بست"}}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَئِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاتَىٰنَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "فَضْلِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَصَّدَّقَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَنَكُونَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّٰلِحِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "8:56", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1216.mp3", "translation": {"en": {"text": "Those of them with whom thou madest a treaty, and then at every opportunity they break their treaty, and they keep not duty (to Allah).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, kendileriyle antlaşma yaptığın halde her defasında antlaşmalarını bozarlar ve bundan hiç çekinmezler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ جن سے تم نے معاہدہ کیا تھا پھر ہر با ر اپنا عہد توڑ دیتے ہیں اور ڈرتے نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Yaitu) orang-orang yang kamu telah mengambil perjanjian dari mereka, sesudah itu mereka mengkhianati janjinya pada setiap kalinya, dan mereka tidak takut (akibat-akibatnya).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَٰهَدتَّ", "hit": true, "audio": "audio/59b257bf440553a87bb4.m4a", "gloss": {"en": "you made a covenant with", "bs": "sklopio si savez", "tr": "antlaşma yaptın", "fr": "tu as conclu une alliance avec", "id": "kamu telah membuat perjanjian dengan", "ur": "تم نے عہد کیا", "bn": "তুমি চুক্তি করেছ", "fa": "پیمان بستی"}}, {"text": "مِنْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "يَنقُضُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَهْدَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "كُلِّ", "hit": false, "audio": null, "gloss": null}, {"text": "مَرَّةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَّقُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "عَٰهَدُوا۟", "count": 4, "first": "2:100", "audio": "audio/f9508d30329917147b0a.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they made a covenant with", "bs": "sklopili su savez", "tr": "antlaşma yaptılar", "fr": "ils ont conclu une alliance avec", "id": "mereka telah membuat perjanjian dengan", "ur": "انہوں نے عہد کیا", "bn": "তারা চুক্তি করেছে", "fa": "پیمان بستند"}}, {"arabic": "عَٰهَدتُّم", "count": 2, "first": "9:1", "audio": "audio/349b7f0335010cddba42.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"bs": "ste sklopili ugovor", "en": "you made a covenant", "tr": "ahitleştiniz", "fr": "vous avez conclu un pacte", "id": "kamu telah mengikat perjanjian", "ur": "تم نے عہد کیا", "bn": "তোমরা অঙ্গীকার করেছিলে", "fa": "پی