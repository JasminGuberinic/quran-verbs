{"rank": 91, "root": "علم", "form": 2, "lemma": "عَلَّمَ", "count": 41, "ayahCount": 35, "share": 0.21, "meaning": {"bs": "poučiti, naučiti", "en": "to teach", "tr": "öğretmek", "fr": "enseigner", "id": "mengajarkan", "ur": "سکھانا، تعلیم دینا", "bn": "শেখানো", "fa": "آموختن، یاد دادن"}, "lemmaSpoken": "audio/259f1818af7fc0702ab6.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "عَلَّمَ", "plain": "عَلَّمَ", "quran": true, "notUsed": false, "spoken": "audio/259f1818af7fc0702ab6.m4a", "recited": "audio/fb1a42475abce7bd9120.m4a", "recitedText": "عَلَّمَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُعَلِّمُ", "plain": "يُعَلِّمُ", "quran": false, "notUsed": false, "spoken": "audio/085f1f76d28fe093f19f.m4a", "recited": null, "recitedText": null}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "عَلَّمْتُ", "plain": "عَلَّمْتُ", "quran": false, "notUsed": false, "spoken": "audio/f75fb89990c14df6de54.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "عَلَّمْنَا", "plain": "عَلَّمْنَا", "quran": false, "notUsed": false, "spoken": "audio/96c9299ba987c5694482.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "عَلَّمْتَ", "plain": "عَلَّمْتَ", "quran": false, "notUsed": false, "spoken": "audio/01f4ee330b7a3b4e383f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "عَلَّمْتِ", "plain": "عَلَّمْتِ", "quran": false, "notUsed": false, "spoken": "audio/edc4af23f2ab4cefe75b.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "عَلَّمْتُمَا", "plain": "عَلَّمْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/d44dacc3f82b5d8d071e.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "عَلَّمْتُم", "plain": "عَلَّمْتُمْ", "quran": true, "notUsed": false, "spoken": "audio/cd30238589eec39a9869.m4a", "recited": "audio/6a31514f4