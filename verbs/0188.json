 "quran": false, "notUsed": false, "spoken": "audio/ca7617be07ea00c97fbe.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "مَتِّعْ", "plain": "مَتِّعْ", "quran": false, "notUsed": false, "spoken": "audio/cd426097ad8147fea4d9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "مَتِّعِي", "plain": "مَتِّعِي", "quran": false, "notUsed": false, "spoken": "audio/d0c04ed2ab16dce87b34.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "مَتِّعَا", "plain": "مَتِّعَا", "quran": false, "notUsed": false, "spoken": "audio/20e690ba15daedc262ae.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "مَتِّعُوا", "plain": "مَتِّعُوا", "quran": false, "notUsed": false, "spoken": "audio/f2cfc7aac12d71bdbe0c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "مَتِّعْنَ", "plain": "مَتِّعْنَ", "quran": false, "notUsed": false, "spoken": "audio/837f9eab326fc640b437.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "26:205", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3137.mp3", "translation": {"en": {"text": "Hast thou then seen, if We content them for (long) years,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Gördün ya artık onlara senelerce zevk ettirsek,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بھلا دیکھو تو اگر کچھ برس ہم انہیں برتنے دیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka bagaimana pendapatmu jika Kami berikan kepada mereka kenikmatan hidup bertahun-tahun,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَفَرَءَيْتَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "مَّتَّعْنَٰهُمْ", "hit": true, "audio": "audio/52a9114732e09d1f3ac1.m4a", "gloss": {"bs": "damo im da uživaju", "en": "We let them enjoy", "tr": "onları faydalandırırız", "fr": "Nous les avons fait jouir", "id": "Kami biarkan mereka menikmati", "ur": "ہم نے انہیں فائدہ اٹھانے دیا", "bn": "আমরা তাদের ভোগ করতে দিয়েছি", "fa": "آنان را بهره‌مند ساختیم"}}, {"text": "سِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "31:24", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3493.mp3", "translation": {"en": {"text": "We give them comfort for a little, and then We drive them to a heavy doom.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz onlara biraz zevk ettiririz de sonra kendilerini ağır bir azaba zorlarız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہم انہیں کچھ برتنے دیں گے پھر انہیں بے بس کرکے سخت عذاب کی طرف لے جائیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kami biarkan mereka bersenang-senang sebentar, kemudian Kami paksa mereka (masuk) ke dalam siksa yang keras.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "نُمَتِّعُهُمْ", "hit": true, "audio": "audio/bad8265350c19298d5b5.m4a", "gloss": {"bs": "dajemo im da uživaju", "en": "We let them enjoy", "tr": "onları faydalandırıyoruz", "fr": "Nous les faisons jouir", "id": "Kami biarkan mereka menikmati", "ur": "ہم انہیں فائدہ اٹھانے دیتے ہیں", "bn": "আমরা তাদের ভোগ করতে দিই", "fa": "آنان را بهره‌مند می‌سازیم"}}, {"text": "قَلِيلًا", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "نَضْطَرُّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابٍ", "hit": false, "audio": null, "gloss": null}, {"text": "غَلِيظٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "43:29", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4354.mp3", "translation": {"en": {"text": "Nay, but I let these and their fathers enjoy life (only) till there should come unto them the Truth and a messenger making plain.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Doğrusu ben bunları da babalarını da kendilerine hak olan kitap ve gerçeği açıklayan bir peygamber gelinceye kadar faydalandırıp geçindirdim.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بلکہ میں نے انہیں اور ان کے باپ دادا کو دنیا کے فائدے دیے یہاں تک کہ ان کے پاس حق اور صاف بتانے والا رسول تشریف لایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tetapi Aku telah memberikan kenikmatan hidup kepada mereka dan bapak-bapak mereka sehingga datanglah kepada mereka kebenaran (Al Quran) dan seorang rasul yang memberi penjelasan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "بَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "مَتَّعْتُ", "hit": true, "audio": "audio/ec760b08ab2ad78bd5c9.m4a", "gloss": {"en": "I gave enjoyment", "bs": "dao sam da uživa", "tr": "zevklenmesine izin verdim", "fr": "j'ai permis de jouir", "id": "aku memberi kesenangan", "ur": "میں نے فائدہ دیا", "bn": "আমি উপভোগ করতে দিয়েছি", "fa": "او را بهره‌مند کردم"}}, {"text": "هَٰٓؤُلَآءِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَءَابَآءَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "حَتَّىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "جَآءَهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَقُّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَرَسُولٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مُّبِينٌ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "مَتَّعْنَا", "count": 3, "first": "15:88", "audio": "audio/1adb349070e1cadaee75.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "we gave enjoyment", "bs": "dali smo da uživa", "tr": "zevklenmesine izin verdik", "fr": "nous leur avons laissé jouir", "id": "kami telah memberi kesenangan", "ur": "ہم نے فائدہ دیا", "bn": "আমরা উপভোগ করতে দিয়েছি", "fa": "او را بهره‌مند کردیم"}}, {"arabic": "فَأُمَتِّعُهُۥ", "count": 1, "first": "2:126", "audio": "audio/def514974fd6ee00c03f.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": ["huwa"], "mood": "indicative"}], "gloss": {"en": "so I let him enjoy", "bs": "pa mu dajem da uživa", "tr": "böylece zevklenmesine izin veririm", "fr": "alors je lui permets de jouir", "id": "aku membiarkannya bersenang-senang", "ur": "پس میں اسے فائدہ دیتا ہوں", "bn": "অতএব আমি তাকে উপভোগ করতে দিই", "fa": "پس او را بهره‌مند می‌کنم"}}, {"arabic": "وَمَتِّعُوهُنَّ", "count": 1, "first": "2:236", "audio": "audio/098f37bddc23b342595b.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["hunna"]}], "gloss": {"en": "and (you all) provide for them!", "bs": "i darujte ih!", "tr": "ve onları nimetlendirin!", "fr": "et donnez-leur !", "id": "dan berikanlah kepada mereka!", "ur": "اور تم سب انہیں سامان دو!", "bn": "এবং তাদের জীবিকা দাও!", "fa": "و به آنان عطا کنید!"}}, {"arabic": "وَمَتَّعْنَٰهُمْ", "count": 1, "first": "10:98", "audio": "audio/8fb4d4d7e74601e94373.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["hum"]}], "gloss": {"en": "and we let them enjoy", "bs": "i dali smo im da uživaju", "tr": "ve zevklenmelerine izin verdik", "fr": "et nous leur avons permis de jouir", "id": "dan kami membiarkan mereka bersenang-senang", "ur": "اور ہم نے انہیں فائدہ دیا", "bn": "এবং আমরা তাদের উপভোগ করতে দিয়েছি", "fa": "و آنان را بهره‌مند کردیم"}}, {"arabic": "يُمَتِّعْكُم", "count": 1, "first": "11:3", "audio": "audio/52129cb1e47f4e