Used": false, "spoken": "audio/c5506cfe156aa576489b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَسْمِعْ", "plain": "أَسْمِعْ", "quran": true, "notUsed": false, "spoken": "audio/0348f61e03a54659e787.m4a", "recited": "audio/e8af2ba0d6dd14487071.m4a", "recitedText": "أَسْمِعْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَسْمِعِي", "plain": "أَسْمِعِي", "quran": false, "notUsed": false, "spoken": "audio/a8f87b58fde0efe39c86.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَسْمِعَا", "plain": "أَسْمِعَا", "quran": false, "notUsed": false, "spoken": "audio/0994ac6989a662ed195a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَسْمِعُوا", "plain": "أَسْمِعُوا", "quran": false, "notUsed": false, "spoken": "audio/f304cd07b08c25f2440e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَسْمِعْنَ", "plain": "أَسْمِعْنَ", "quran": false, "notUsed": false, "spoken": "audio/cd59c2bb78a2d9d30934.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "27:80", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3239.mp3", "translation": {"en": {"text": "Lo! thou canst not make the dead to hear, nor canst thou make the deaf to hear the call when they have turned to flee;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bil ki sen, ölülere işittiremezsin, arkasını dönüp kaçmakta olan sağırlara da daveti duyuramazsın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک تمہارے سنائے نہیں سنتے مردے اور نہ تمہارے سنائے بہرے پکار سنیں جب پھریں پیٹھ دے کر", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya kamu tidak dapat menjadikan orang-orang yang mati mendengar dan (tidak pula) menjadikan orang-orang yang tuli mendengar panggilan, apabila mereka telah berpaling membelakang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُسْمِعُ", "hit": true, "audio": "audio/20a0afbd01e84eb41853.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}, {"text": "ٱلْمَوْتَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُسْمِعُ", "hit": true, "audio": "audio/20a0afbd01e84eb41853.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "indicative"}]}, {"text": "ٱلصُّمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلدُّعَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَّوْا۟", "hit": false, "audio": null, "gloss": null}, {"text": "مُدْبِرِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "8:23", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1183.mp3", "translation": {"en": {"text": "Had Allah known of any good in them He would have made them hear, but had He made them hear they would have turned away, averse.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah onlarda hayır görseydi onlara işittirirdi, işittirseydi yine de aldırmaz arka dönerlerdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر اللہ ان میں کچھ بھلائی جانتا تو انہیں سنادیتا اور اگر سنا دیتا جب بھی انجام کا ر منہ پھیر کر پلٹ جاتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kalau sekiranya Allah mengetahui kebaikan ada pada mereka, tentulah Allah menjadikan mereka dapat mendengar. Dan jikalau Allah menjadikan mereka dapat mendengar, niscaya mereka pasti berpaling juga, sedang mereka memalingkan diri (dari apa yang mereka dengar itu).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلِمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "خَيْرًا", "hit": false, "audio": null, "gloss": null}, {"text": "لَّأَسْمَعَهُمْ", "hit": true, "audio": "audio/cb30d8a593fc8651f47a.m4a", "gloss": {"bs": "dao bi im da čuju", "en": "He would have made them hear", "tr": "onlara işittirirdi", "fr": "Il leur aurait fait entendre", "id": "niscaya Dia memperdengarkan mereka", "ur": "وہ ضرور انہیں سنوا دیتا", "bn": "তিনি অবশ্যই তাদের শোনাতেন", "fa": "قطعاً به آنان می‌شنوانید"}}, {"text": "وَلَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَسْمَعَهُمْ", "hit": true, "audio": "audio/f8c1d7d822a4d6deda24.m4a", "gloss": {"bs": "dao im da čuju", "en": "He made them hear", "tr": "onlara işittirdi", "fr": "Il leur fit entendre", "id": "Dia memperdengarkan mereka", "ur": "اس نے انہیں سنایا", "bn": "তিনি তাদের শোনালেন", "fa": "به آنان شنوانید"}}, {"text": "لَتَوَلَّوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَّهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّعْرِضُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "10:42", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1406.mp3", "translation": {"en": {"text": "And of them are some who listen unto thee. But canst thou make the deaf to hear even though they apprehend not?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İçlerinden seni dinlemeye gelenler de var. Sen, sağırlara, üstelik akılsız da olanlara dinletebilir misin?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان میں کوئی وہ ہیں جو تمہاری طرف کان لگاتے ہیں تو کیا تم بہروں کو سنا دو گے اگرچہ انہیں عقل نہ ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan di antara mereka ada orang yang mendengarkanmu. Apakah kamu dapat menjadikan orang-orang tuli itu mendengar walaupun mereka tidak mengerti.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمِنْهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّن", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَمِعُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَفَأَنتَ", "hit": false, "audio": null, "gloss": null}, {"text": "تُسْمِعُ", "hit": true, "audio": "audio/aeefcfa15e2aa49d96e1.m4a", "gloss": {"bs": "daješ da čuju", "en": "you make hear", "tr": "işittirirsin", "fr": "tu fais entendre", "id": "kamu memperdengarkan", "ur": "تو سناتا ہے", "bn": "তুমি শোনাও", "fa": "نمی‌شنوانی"}}, {"text": "ٱلصُّمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْقِلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:38", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2288.mp3", "translation": {"en": {"text": "See and hear them on the Day they come unto Us! yet the evil-doers are to-day in error manifest.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bize gelecekleri gün, neler işitecekler, neler görecekler! Fakat o zalimler bugün apaçık bir sapıklık içindedirler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کتنا سنیں گے اور کتنا دیکھیں گے جس دن ہمارے پاس حاضر ہونگے مگر آج ظالم کھلی گمراہی میں ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Alangkah terangnya pendengaran mereka dan alangkah tajamnya penglihatan mereka pada hari mereka datang kepada Kami. Tetapi orang-orang yang zalim pada hari ini (di dunia) berada dalam kesesatan yang nyata.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَسْمِعْ", "hit": true, "audio": "audio/e8af2ba0d6dd14487071.m4a", "gloss": {"bs": "kako će dobro čuti", "en": "how well they will hear", "tr": "ne güzel işitecekler", "fr": "comme ils entendront bien", "id": "alangkah jelasnya pendengaran mereka", "ur": "کتنا اچھا سنیں گے", "bn": "কতই না ভালো করে তারা শুনবে", "fa": "چه خوب می‌شنوند"}}, {"text": "بِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَبْصِرْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَأْتُونَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَٰكِنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلظَّٰلِمُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْيَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ضَلَٰلٍ", "hit": false, "audio": null, "gloss": null}, {"text": "مُّبِينٍ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تُسْمِعُ", "count": 8, "first": "10:42", "audio": "audio/aeefcfa15e2aa49d96e1.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "indicative"}, {"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}, {"arabic": "لَّأَسْمَعَهُمْ", "count": 1, "first": "8:23", "audio": "audio/cb30d8a593fc8651f47a.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hum"]}], "gloss": {"bs": "dao bi im da čuju", "en": "He would have made them hear", "tr": "onlara işittirirdi", "fr": "Il leur aurait fait entendre", "id": "niscaya Dia memperdengarkan mereka", "ur": "وہ ضرور انہیں سنوا دیتا", "bn": "তিনি অবশ্যই তাদের শোনাতেন", "fa": "قطعاً به آنان می‌شنوانید"}}, {"arabic": "أَسْمَعَهُمْ", "count": 1, "first": "8:23", "audio": "audio/f8c1d7d822a4d6deda24.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hum"]}], "gloss": {"bs": "dao im da čuju", "en": "He made them hear", "tr": "onlara işittirdi", "fr": "Il leur fit entendre", "id": "Dia memperdengarkan mereka", "ur": "اس نے انہیں سنایا", "bn": "তিনি তাদের শোনালেন", "fa": "به آنان شنوانید"}}, {"arabic": "وَأَسْمِعْ", "count": 1, "first": "18:26", "audio": "audio/ebae8f9b80ed1f0267b2.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "and how well he/it hears!", "bs": "i kako dobro čuje!", "tr": "ve ne güzel işitir!", "fr": "et comme il entend bien !", "id": "dan betapa baiknya dia mendengar!", "ur": "اور وہ کیا خوب سنتا ہے!", "bn": "এবং সে কত ভালো শোনে!", "fa": "و چه خوب می‌شنود!"}}, {"arabic": "أَسْمِعْ", "count": 1, "first": "19:38", "audio": "audio/e8af2ba0d6dd14487071.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"bs": "kako će dobro čuti", "en": "how well they will hear", "tr": "ne güzel işitecekler", "fr": "comme ils entendront bien", "id": "alangkah jelasnya pendengaran mereka", "ur": "کتنا اچھا سنیں گے", "bn": "কতই না ভালো করে তারা শুনবে", "fa": "چه خوب می‌شنوند"}}, {"arabic": "يُسْمِعُ", "count": 1, "first": "35:22", "audio": "audio/f15cbf269b308495f0ef.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it makes hear", "bs": "daje da čuje", "tr": "işittirir", "fr": "il fait entendre", "id": "dia membuat mendengar", "ur": "وہ سنواتا ہے", "bn": "সে শোনায়", "fa": "شنوایی می‌دهد"}}], "ayatFile": "ayat/0243.json", "ayatTranslations": {"en": "ayat/0243.en.json", "tr": "ayat/0243.tr.json", "ur": "ayat/0243.ur.json", "id": "ayat/0243.id.json"}, "sentences": [{"arabic": "يُسْمِعُ النَّاسَ صَوْتَهُ", "spoken": "audio/21d83854ab80797d5c06.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Daje ljudima da čuju njegov glas.", "en": "He makes people hear his voice.", "bn": "সে মানুষকে তার কণ্ঠ শোনায়।", "fa": "صدایش را به مردم می‌شنواند.", "fr": "Il fait entendre sa voix aux gens.", "id": "Dia membuat orang mendengar suaranya.", "tr": "İnsanlara sesini duyurur.", "ur": "وہ لوگوں کو اپنی آواز سناتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يُسْمِعُ", "target": true, "translation": {"bs": "daje da čuju", "en": "he makes hear", "bn": "সে শোনায়", "fa": "می‌شنواند", "fr": "fait entendre", "id": "dia memperdengarkan", "tr": "duyurur", "ur": "وہ سناتا ہے"}}, {"arabic": "النَّاسَ", "target": false, "translation": {"bs": "ljudima", "en": "the people", "bn": "মানুষদের", "fa": "مردم", "fr": "les gens", "id": "orang-orang itu", "tr": "insanlar", "ur": "لوگ"}}, {"arabic": "صَوْتَهُ", "target": false, "translation": {"bs": "njegov glas", "en": "his voice", "bn": "তার কণ্ঠ", "fa": "صدایش", "fr": "sa voix", "id": "suaranya", "tr": "sesini", "ur": "اس کی آواز"}}]}, {"arabic": "أَسْمِعْ جَدَّتَكَ صَوْتَكَ", "spoken": "audio/2f4c50b8a5c80b841357.m4a", "tense": "imperative", "pronoun": "anta", "translation": {"bs": "Daj baki da čuje tvoj glas.", "en": "Let your grandmother hear your voice.", "bn": "তোমার দাদিকে তোমার কণ্ঠ শোনাও।", "fa": "صدایت را به مادربزرگت بشنوان.", "fr": "Fais entendre ta voix à ta grand-mère.", "id": "Perdengarkan suaramu kepada nenekmu.", "tr": "Büyükannene sesini duyur.", "ur": "اپنی دادی کو اپنی آواز سناؤ۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَسْمِعْ", "target": true, "translation": {"bs": "daj da čuje", "en": "make hear", "bn": "শোনাও", "fa": "بشنوان", "fr": "fais entendre !", "id": "perdengarkan", "tr": "duyur", "ur": "سنا"}}, {