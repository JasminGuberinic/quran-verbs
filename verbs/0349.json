", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "رَاوِدِي", "plain": "رَاوِدِي", "quran": false, "notUsed": false, "spoken": "audio/d84f119230c844bb4719.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "رَاوِدَا", "plain": "رَاوِدَا", "quran": false, "notUsed": false, "spoken": "audio/4d6657c08ab9e5a97fd6.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "رَاوِدُوا", "plain": "رَاوِدُوا", "quran": false, "notUsed": false, "spoken": "audio/613406823701b7cf1268.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "رَاوِدْنَ", "plain": "رَاوِدْنَ", "quran": false, "notUsed": false, "spoken": "audio/102343c5a0c8c1cb6a70.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "12:61", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1657.mp3", "translation": {"en": {"text": "They said: We will try to win him from his father: that we will surely do.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Dediler ki: \"Onun için babasından izin almaya çalışacağız. Her hâlü kârda bunu yapacağz.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے ہم اس کی خواہش کریں گے اس کے باپ سے اور ہمیں یہ ضرور کرنا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka berkata: \"Kami akan membujuk ayahnya untuk membawanya (ke mari) dan sesungguhnya kami benar-benar akan melaksanakannya\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "سَنُرَٰوِدُ", "hit": true, "audio": "audio/2d67f53e55e6238bee9b.m4a", "gloss": {"bs": "nagovarat ćemo", "en": "we will try to persuade", "tr": "ayartmaya çalışacağız", "fr": "nous chercherons à persuader", "id": "kami akan membujuk", "ur": "ہم اسے پھسلائیں گے", "bn": "আমরা ফুসলিয়ে রাজি করাতে চেষ্টা করব", "fa": "خواهیم کوشید راضی کنیم"}}, {"text": "عَنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَبَاهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَفَٰعِلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "54:37", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4883.mp3", "translation": {"en": {"text": "They even asked of him his guests for an ill purpose. Then We blinded their eyes (and said): Taste now My punishment after My warnings!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onun konuklarından murad almaya kalkıştılar. Biz de gözlerini siliverdik. \"Haydi azabımı ve uyarılarımı tadın!\" (dedik).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "انہوں نے اسے اس کے مہمانوں سے پھسلانا چاہا تو ہم نے ان کی آنکھیں میٹ دی (چوپٹ کردیں) فرمایا چکھو میرا عذاب اور ڈر کے فرمان", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya mereka telah membujuknya (agar menyerahkan) tamunya (kepada mereka), lalu Kami butakan mata mereka, maka rasakanlah azab-Ku dan ancaman-ancaman-Ku.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "رَٰوَدُوهُ", "hit": true, "audio": "audio/d1b6636f47e8f85e1e51.m4a", "gloss": {"bs": "nagovarali su ga", "en": "they tried to entice him", "tr": "onu ayartmaya çalıştılar", "fr": "ils cherchèrent à le séduire", "id": "mereka membujuknya", "ur": "انہوں نے اسے پھسلایا", "bn": "তারা তাকে ফুসলাতে চেয়েছিল", "fa": "او را فریفتند"}}, {"text": "عَن", "hit": false, "audio": null, "gloss": null}, {"text": "ضَيْفِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "فَطَمَسْنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْيُنَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَذُوقُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَنُذُرِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "رَٰوَدتُّهُۥ", "count": 2, "first": "12:32", "audio": "audio/621bb3d7afe0ddbd1fdf.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "I tried to persuade him", "bs": "nagovarao sam ga", "tr": "onu ikna etmeye çalıştım", "fr": "je l'ai incité", "id": "aku telah membujuknya", "ur": "میں نے اسے بہلانے کی کوشش کی", "bn": "আমি তাকে রাজি করাতে চেয়েছিলাম", "fa": "او را ترغیب کردم"}}, {"arabic": "وَرَٰوَدَتْهُ", "count": 1, "first": "12:23", "audio": "audio/85c6bdcf487a6b88fa5f.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "and she/it tried to persuade him", "bs": "i nagovarala ga je", "tr": "onu ikna etmeye çalıştı", "fr": "et elle l'a incité", "id": "dan dia telah membujuknya", "ur": "اور اُس نے اسے بہلانے کی کوشش کی", "bn": "এবং সে তাকে রাজি করাতে চাইল", "fa": "و او را ترغیب کرد"}}, {"arabic": "رَٰوَدَتْنِى", "count": 1, "first": "12:26", "audio": "audio/58da5b1d0340602b03e8.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": ["ana"]}], "gloss": {"en": "she/it tried to persuade me", "bs": "nagovarala me je", "tr": "beni ikna etmeye çalıştı", "fr": "elle m'a incité", "id": "dia telah membujukku", "ur": "اُس نے مجھے بہلانے کی کوشش کی", "bn": "সে আমাকে রাজি করাতে চাইল", "fa": "مرا ترغیب کرد"}}, {"arabic": "تُرَٰوِدُ", "count": 1, "first": "12:30", "audio": "audio/1cbab91836f3febb3878.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}, {"arabic": "رَٰوَدتُّنَّ", "count": 1, "first": "12:51", "audio": "audio/512ab85581e27b7c7463.m4a", "grammar": [{"tense": "past", "pronoun": "antunna", "passive": false, "objects": []}], "gloss": {"en": "you (all) tried to persuade", "bs": "nagovarale ste", "tr": "ikna etmeye çalıştınız", "fr": "vous avez incité", "id": "kalian telah membujuk", "ur": "تم سب نے بہلانے کی کوشش کی", "bn": "তোমরা রাজি করাতে চেয়েছিলে", "fa": "ترغیب کردید"}}, {"arabic": "سَنُرَٰوِدُ", "count": 1, "first": "12:61", "audio": "audio/2d67f53e55e6238bee9b.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "nagovarat ćemo", "en": "we will try to persuade", "tr": "ayartmaya çalışacağız", "fr": "nous chercherons à persuader", "id": "kami akan membujuk", "ur": "ہم اسے پھسلائیں گے", "bn": "আমরা ফুসলিয়ে রাজি করাতে চেষ্টা করব", "fa": "خواهیم کوشید راضی کنیم"}}, {"arabic": "رَٰوَدُوهُ", "count": 1, "first": "54:37", "audio": "audio/d1b6636f47e8f85e1e51.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": ["huwa"]}], "gloss": {"bs": "nagovarali su ga", "en": "they tried to entice him", "tr": "onu ayartmaya çalıştılar", "fr": "ils cherchèrent à le séduire", "id": "mereka membujuknya", "ur": "انہوں نے اسے پھسلایا", "bn": "তারা তাকে ফুসলাতে চেয়েছিল", "fa": "او را فریفتند"}}], "ayatFile": "ayat/0349.json", "ayatTranslations": {"en": "ayat/0349.en.json", "tr": "ayat/0349.tr.json", "ur": "ayat/0349.ur.json", "id": "ayat/0349.id.json"}, "sentences": [{"arabic": "رَاوَدَنِي أَمَلٌ كَبِيرٌ", "spoken": "audio/c451b12962ee8a4f7565.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Obuzela me velika nada.", "en": "A great hope came over me.", "bn": "একটি বিরাট আশা আমাকে পেয়ে বসল।", "fa": "امید بزرگی به من دست داد.", "fr": "Un grand espoir m'a envahi.", "id": "Sebuah harapan besar terlintas dalam diriku.", "tr": "Bana büyük bir umut geldi.", "ur": "مجھے ایک بڑی امید ہوئی۔"}, "independentlyReviewed": true, "words": [{"arabic": "رَاوَدَنِي", "target": true, "translation": {"bs": "obuzela me", "en": "came over me", "bn": "আমাকে পেয়ে বসল", "fa": "به من دست داد", "fr": "m'a envahi", "id": "terlintas dalam diriku", "tr": "geldi bana", "ur": "مجھے آئی"}}, {"arabic": "أَمَلٌ", "target": false, "translation": {"bs": "nada", "en": "a hope", "bn": "একটি আশা", "fa": "امیدی", "fr": "un espoir", "id": "sebuah harapan", "tr": "bir umut", "ur": "ایک امید"}}, {"arabic": "كَبِيرٌ", "target": false, "translation": {"bs": "velika", "en": "great", "bn": "বিরাট", "fa": "بزرگ", "fr": "grand", "id": "besar", "tr": "büyük", "ur": "بڑی"}}]}, {"arabic": "يُرَاوِدُنِي سُؤَالٌ قَدِيمٌ", "spoken": "audio/e940c2d1be1728c26240.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Stalno mi se vraća jedno staro pitanje.", "en": "An old question keeps coming back to me.", "bn": "একটি পুরোনো প্রশ্ন বারবার আমার মনে ফিরে আসে।", "fa": "پرسشی قدیمی مدام به ذهنم برمی‌گردد.", "fr": "Une vieille question me revient sans cesse.", "id": "Sebuah pertanyaan lama terus terlintas dalam benakku.", "tr": "Eski bir soru bana geri gelip duruyor.", "ur": "ایک پرانا سوال مجھے بار بار آتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يُرَاوِدُنِي", "target": true, "translation": {"bs": "vraća mi se", "en": "keeps coming back to me", "bn": "বারবার ফিরে আসে", "fa": "مدام به ذهنم برمی‌گردد", "fr": "me revient sans cesse", "id": "terus terlintas dalam benakku", "tr": "geri gelip duruyor bana", "ur": "مجھے بار بار آتا ہے"}}, {"arabic": "سُؤَالٌ", "target": false, "translation": {"bs": "pitanje", "en": "a question", "bn": "একটি প্রশ্ন", "fa": "پرسشی", "fr": "une question", "id": "sebuah pertanyaan", "tr": "bir soru", "ur": "ایک سوال"}}, {"arabic": "قَدِيمٌ", "target": false, "translation": {"bs": "staro", "en": "old", "bn": "পুরোনো", "fa": "قدیمی", "fr": "ancienne", "id": "lama", "tr": "eski", "ur": "پرانا"}}]}]}