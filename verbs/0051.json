": "audio/913941a9dba72b7259aa.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَضْلِلْ", "plain": "أَضْلِلْ", "quran": false, "notUsed": false, "spoken": "audio/bc3bf2a339272700a63c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَضِلِّي", "plain": "أَضِلِّي", "quran": false, "notUsed": false, "spoken": "audio/7fd2e573db4f86a0e313.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَضِلَّا", "plain": "أَضِلَّا", "quran": false, "notUsed": false, "spoken": "audio/82bda38055d8da912116.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَضِلُّوا", "plain": "أَضِلُّوا", "quran": false, "notUsed": false, "spoken": "audio/78b8ff6b92e05d985560.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَضْلِلْنَ", "plain": "أَضْلِلْنَ", "quran": false, "notUsed": false, "spoken": "audio/1351faa0d7dcce6773a8.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "7:178", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1132.mp3", "translation": {"en": {"text": "He whom Allah leadeth, he indeed is led aright, while he whom Allah sendeth astray - they indeed are losers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah kime hidayet ederse, o hidayete erer, kimi de dalalette bırakırsa, işte onlar hüsrana uğrayanların ta kendileri olurlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جسے اللہ راہ دکھائے تو وہی راہ پر ہے، اور جسے گمراہ کرے تو وہی نقصان میں رہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Barangsiapa yang diberi petunjuk oleh Allah, maka dialah yang mendapat petunjuk; dan barangsiapa yang disesatkan Allah, maka merekalah orang-orang yang merugi.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَهْدِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "فَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُهْتَدِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "يُضْلِلْ", "hit": true, "audio": "audio/f859330787eb65aa804b.m4a", "gloss": {"bs": "(koga) ostavi u zabludi", "en": "(whomever) He leaves astray", "tr": "(kimi) saptırırsa", "fr": "(celui que) Il égare", "id": "(siapa yang) Dia sesatkan", "ur": "(جسے) وہ گمراہ کر دے", "bn": "(যাকে) তিনি পথভ্রষ্ট করেন", "fa": "(هر که را) گمراه کند"}}, {"text": "فَأُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَٰسِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "71:27", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5446.mp3", "translation": {"en": {"text": "If Thou shouldst leave them, they will mislead Thy slaves and will beget none save lewd ingrates.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Zira sen onları bırakırsan kullarını yoldan çıkarırlar ve sadece ahlâksız ve kâfir çocuklar doğururlar.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک اگر تو انہیں رہنے دے گا تو تیرے بندوں کو گمراہ کردیں گے اور ان کے اولاد ہوگی تو وہ بھی نہ ہوگی مگر بدکار بڑی ناشکر", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya jika Engkau biarkan mereka tinggal, niscaya mereka akan menyesatkan hamba-hamba-Mu, dan mereka tidak akan melahirkan selain anak yang berbuat maksiat lagi sangat kafir.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَذَرْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُضِلُّوا۟", "hit": true, "audio": "audio/b46817a4b98c8cefc0ac.m4a", "gloss": {"en": "they mislead", "bs": "zavode", "tr": "saptırırlar", "fr": "qu'ils égarent", "id": "mereka menyesatkan", "ur": "وہ گمراہ کرتے ہیں", "bn": "তারা বিভ্রান্ত করে", "fa": "گمراه کنند"}}, {"text": "عِبَادَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَلِدُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "فَاجِرًا", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَّارًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:99", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3031.mp3", "translation": {"en": {"text": "It was but the guilty who misled us.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ve bizi hep o günahkarlar saptırdı.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہمیں نہ بہکایا مگر مجرموں نے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan tiadalah yang menyesatkan kami kecuali orang-orang yang berdosa.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَضَلَّنَآ", "hit": true, "audio": "audio/5cef647893173da28001.m4a", "gloss": {"bs": "zaveli su nas", "en": "misled us", "tr": "bizi saptırdılar", "fr": "nous a égarés", "id": "menyesatkan kami", "ur": "اس نے ہمیں گمراہ کیا", "bn": "আমাদের পথভ্রষ্ট করেছে", "fa": "ما را گمراه کرد"}}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُجْرِمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "33:67", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3600.mp3", "translation": {"en": {"text": "And they say: Our Lord! Lo! we obeyed our princes and great men, and they misled us from the Way.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yine derler ki: \"Ey Rabbimiz! Biz beylerimize ve büyüklerimize itaat ettik de bizi yanlış yola götürdüler.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور کہیں گے اے ہمارے رب! ہم اپنے سرداروں اور اپنے بڑوں کے کہنے پر چلے تو انہوں نے ہمیں راہ سے بہکادیا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka berkata: \"Ya Tuhan kami, sesungguhnya kami telah mentaati pemimpin-pemimpin dan pembesar-pembesar kami, lalu mereka menyesatkan kami dari jalan (yang benar).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَطَعْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "سَادَتَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَكُبَرَآءَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَضَلُّونَا", "hit": true, "audio": "audio/9ec1111fa4e879b318dc.m4a", "gloss": {"en": "so they misled us", "bs": "pa su nas zaveli", "tr": "böylece bizi saptırdılar", "fr": "alors ils nous ont égarés", "id": "maka mereka telah menyesatkan kami", "ur": "پس انہوں نے ہمیں گمراہ کیا", "bn": "অতএব তারা আমাদের বিভ্রান্ত করেছে", "fa": "پس ما را گمراه کردند"}}, {"text": "ٱلسَّبِيلَا۠", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُضِلُّ", "count": 9, "first": "2:26", "audio": "audio/1762f1718141962e4f80.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it misleads", "bs": "zavodi", "tr": "saptırır", "fr": "il égare", "id": "dia menyesatkan", "ur": "وہ گمراہ کرتا ہے", "bn": "সে বিভ্রান্ত করে", "fa": "گمراه می‌کند"}}, {"arabic": "يُضْلِلِ", "count": 9, "first": "4:88", "audio": "audio/09ee0aed521e43ef2b56.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "he/it misleads", "bs": "zavodi", "tr": "saptırır", "fr": "qu'il égare", "id": "dia menyesatkan", "ur": "وہ گمراہ کرتا ہے", "bn": "সে বিভ্রান্ত করে", "fa": "گمراه کند"}}, {"arabic": "أَضَلَّ", "count": 4, "first": "4:88", "audio": "audio/3a10c6a3acdb51ca6825.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it misled", "bs": "zaveo je", "tr": "saptırdı", "fr": "il a égaré", "id": "dia telah menyesatkan", "ur": "اُس نے گمراہ کیا", "bn": "সে বিভ্রান্ত করল", "fa": "گمراه کرد"}}, {"arabic": "يُضْلِلْ", "count": 3, "first": "7:178", "audio": "audio/f859330787eb65aa804b.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"bs": "(koga) ostavi u zabludi", "en": "(whomever) He leaves astray", "tr": "(kimi) saptırırsa", "fr": "(celui que) Il égare", "id": "(siapa yang) Dia sesatkan", "ur": "(جسے) وہ گمراہ کر دے", "bn": "(যাকে) তিনি পথভ্রষ্ট করেন", "fa": "(هر که را) گمراه کند"}}, {"arabic": "لِيُضِلَّ", "count": 3, "first": "9:115", "audio": "audio/68a9024c0e12bbaeb4f4.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "so that he/it may mislead", "bs": "da zavede", "tr": "saptırsın diye", "fr": "qu'il égare", "id": "agar dia menyesatkan", "ur": "تاکہ وہ گمراہ کرے", "bn": "যাতে সে বিভ্রান্ত করে", "fa": "تا گمراه کند"}}, {"arabic": "يُضِلُّونَ", "count": 2, "first": "3:69", "audio": "audio/b44c801643c1f25cf850.m