oun": "anti", "arabic": "اِكْسِبِي", "plain": "اِكْسِبِي", "quran": false, "notUsed": false, "spoken": "audio/a956068ff057989569f1.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِكْسِبَا", "plain": "اِكْسِبَا", "quran": false, "notUsed": false, "spoken": "audio/b16ded7317176e61c693.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِكْسِبُوا", "plain": "اِكْسِبُوا", "quran": false, "notUsed": false, "spoken": "audio/5231b517af6ca0b643d2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِكْسِبْنَ", "plain": "اِكْسِبْنَ", "quran": false, "notUsed": false, "spoken": "audio/2bd8b49b1efe7e9865fa.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "74:38", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5533.mp3", "translation": {"en": {"text": "Every soul is a pledge for its own deeds;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Her nefis kendi kazancına bağlıdır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہر جان اپنی کرنی (اعمال) میں گروی ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tiap-tiap diri bertanggung jawab atas apa yang telah diperbuatnya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كُلُّ", "hit": false, "audio": null, "gloss": null}, {"text": "نَفْسٍۭ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَسَبَتْ", "hit": true, "audio": "audio/986ccc0bcf115fc37dfe.m4a", "gloss": {"bs": "je zaradila", "en": "it has earned", "tr": "kazandı", "fr": "elle a acquis", "id": "telah diusahakannya", "ur": "اس نے کمایا", "bn": "সে অর্জন করেছে", "fa": "به دست آورده است"}}, {"text": "رَهِينَةٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "42:34", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4306.mp3", "translation": {"en": {"text": "Or He causeth them to perish on account of that which they have earned - And He forgiveth much -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yahut da Allah kazandıkları günahlar yüzünden onları helâk eder ve birçoğunu da bağışlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا انہیں تباہ کردے لوگوں کے گناہوں کے سبب اور بہت معاف فرمادے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "atau kapal-kapal itu dibinasakan-Nya karena perbuatan mereka atau Dia memberi maaf sebagian besar (dari mereka).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُوبِقْهُنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَسَبُوا۟", "hit": true, "audio": "audio/caee4dfe65c5dc8464be.m4a", "gloss": {"en": "they earned", "bs": "zaradili su", "tr": "kazandılar", "fr": "ils ont gagné", "id": "mereka telah berusaha", "ur": "انہوں نے کمایا", "bn": "তারা উপার্জন করল", "fa": "کسب کردند"}}, {"text": "وَيَعْفُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَن", "hit": false, "audio": null, "gloss": null}, {"text": "كَثِيرٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "10:8", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1372.mp3", "translation": {"en": {"text": "Their home will be the Fire because of what they used to earn.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte bunların kendi elleriyle ettikleri yüzünden varacakları yer cehennemdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ان لوگوں کا ٹھکانا دوزخ ہے بدلہ ان کی کمائی کا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka itu tempatnya ialah neraka, disebabkan apa yang selalu mereka kerjakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَأْوَىٰهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلنَّارُ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَكْسِبُونَ", "hit": true, "audio": "audio/7c96a65e82951cb86c7e.m4a", "gloss": {"bs": "(su) zarađivali", "en": "(they used to) earn", "tr": "kazanıyorlardı", "fr": "(ils) acquéraient", "id": "(mereka dahulu) mengusahakan", "ur": "(وہ) کماتے (تھے)", "bn": "(তারা) অর্জন করত", "fa": "(همواره) به دست می‌آوردند"}}]}, {"ref": "6:3", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/792.mp3", "translation": {"en": {"text": "He is Allah in the heavens and in the earth. He knoweth both your secret and your utterance, and He knoweth what ye earn.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O, göklerde de, yerde de (tek) Allah'tır. Sizin gizlinizi, açığınızı ve ne kazandığınızı bilir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہی اللہ ہے آسمانوں اور زمین کا اسے تمہارا چھپا اور ظاہر سب معلوم ہے اور تمہارے کام جانتا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Dialah Allah (yang disembah), baik di langit maupun di bumi; Dia mengetahui apa yang kamu rahasiakan dan apa yang kamu lahirkan dan mengetahui (pula) apa yang kamu usahakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمَٰوَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَفِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْلَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "سِرَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَجَهْرَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَعْلَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَكْسِبُونَ", "hit": true, "audio": "audio/9893e22c510033bdee3c.m4a", "gloss": {"en": "you (all) earn", "bs": "zarađujete", "tr": "kazanıyorsunuz", "fr": "vous gagnez", "id": "kalian berusaha", "ur": "تم سب کماتے ہو", "bn": "তোমরা উপার্জন কর", "fa": "کسب می‌کنید"}}]}, {"ref": "111:2", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6218.mp3", "translation": {"en": {"text": "His wealth and gains will not exempt him.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ne malı ne de kazandığı onu kurtaramadı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اسے کچھ کام نہ آیا اس کا مال اور نہ جو کمایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tidaklah berfaedah kepadanya harta bendanya dan apa yang ia usahakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَغْنَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَالُهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَسَبَ", "hit": true, "audio": "audio/64526491a44b567ba1ca.m4a", "gloss":