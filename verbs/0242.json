t": "شُرَكَآءِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَزْعُمُونَ", "hit": true, "audio": "audio/58fd6fcd5bdcede1daed.m4a", "gloss": {"bs": "ste tvrdili", "en": "you claimed", "tr": "iddia ettiniz", "fr": "vous prétendiez", "id": "kamu mengklaim", "ur": "تم نے دعویٰ کیا", "bn": "তোমরা দাবি করেছিলে", "fa": "ادعا می‌کردید"}}]}, {"ref": "17:92", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2121.mp3", "translation": {"en": {"text": "Or thou cause the heaven to fall upon us piecemeal, as thou hast pretended, or bring Allah and the angels as a warrant;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Yahut söyleyip zannettiğin gibi, göğü başımıza parça parça düşüresin veya Allah'ı ve melekleri söylediğine şahit getiresin. \"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا تم ہم پر آسمان گرا دو جیسا تم نے کہا ہے ٹکڑے ٹکڑے یااللہ اور فرشتوں کو ضامن لے آؤ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "atau kamu jatuhkan langit berkeping-keping atas kami, sebagaimana kamu katakan atau kamu datangkan Allah dan malaikat-malaikat berhadapan muka dengan kami.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "تُسْقِطَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "زَعَمْتَ", "hit": true, "audio": "audio/568a7ce8b8c915027af3.m4a", "gloss": {"bs": "si tvrdio", "en": "you claimed", "tr": "iddia ettin", "fr": "tu as prétendu", "id": "kamu mengklaim", "ur": "تو نے دعویٰ کیا", "bn": "তুমি দাবি করেছিলে", "fa": "ادعا کردی"}}, {"text": "عَلَيْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "كِسَفًا", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَأْتِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْمَلَٰٓئِكَةِ", "hit": false, "audio": null, "gloss": null}, {"text": "قَبِيلًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تَزْعُمُونَ", "count": 4, "first": "6:22", "audio": "audio/58fd6fcd5bdcede1daed.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "ste tvrdili", "en": "you claimed", "tr": "iddia ettiniz", "fr": "vous prétendiez", "id": "kamu mengklaim", "ur": "تم نے دعویٰ کیا", "bn": "তোমরা দাবি করেছিলে", "fa": "ادعا می‌کردید"}}, {"arabic": "زَعَمْتُمْ", "count": 4, "first": "6:94", "audio": "audio/f2eaed527d86eef92031.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) claimed", "bs": "tvrdili ste", "tr": "iddia ettiniz", "fr": "vous avez prétendu", "id": "kalian telah mengaku", "ur": "تم سب نے دعویٰ کیا", "bn": "তোমরা দাবি করেছ", "fa": "ادعا کردید"}}, {"arabic": "زَعَمْتُم", "count": 2, "first": "17:56", "audio": "audio/67a181725a0e7dad4677.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) claimed", "bs": "tvrdili ste", "tr": "iddia ettiniz", "fr": "vous avez prétendu", "id": "kalian telah mengaku", "ur": "تم سب نے دعویٰ کیا", "bn": "তোমরা দাবি করেছ", "fa": "ادعا کردید"}}, {"arabic": "يَزْعُمُونَ", "count": 1, "first": "4:60", "audio": "audio/2cf8857b1fa787132955.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they claim", "bs": "tvrde", "tr": "iddia ederler", "fr": "ils prétendent", "id": "mereka mengaku", "ur": "وہ دع