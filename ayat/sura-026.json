{"ayat":[{"ref":"26:1","number":2933,"text":"طسٓمٓ","hits":[]},{"ref":"26:2","number":2934,"text":"تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ ٱلْمُبِينِ","hits":[0,1,2,3]},{"ref":"26:3","number":2935,"text":"لَعَلَّكَ بَٰخِعٌ نَّفْسَكَ أَلَّا يَكُونُوا۟ مُؤْمِنِينَ","hits":[0,2,3,4,5]},{"ref":"26:4","number":2936,"text":"إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ ٱلسَّمَآءِ ءَايَةً فَظَلَّتْ أَعْنَٰقُهُمْ لَهَا خَٰضِعِينَ","hits":[0,1,2,3,4,5,7,8,9]},{"ref":"26:5","number":2937,"text":"وَمَا يَأْتِيهِم مِّن ذِكْرٍ مِّنَ ٱلرَّحْمَٰنِ مُحْدَثٍ إِلَّا كَانُوا۟ عَنْهُ مُعْرِضِينَ","hits":[0,1,3,7,9]},{"ref":"26:6","number":2938,"text":"فَقَدْ كَذَّبُوا۟ فَسَيَأْتِيهِمْ أَنۢبَٰٓؤُا۟ مَا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","hits":[0,1,3,6,7]},{"ref":"26:7","number":2939,"text":"أَوَلَمْ يَرَوْا۟ إِلَى ٱلْأَرْضِ كَمْ أَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍ كَرِيمٍ","hits":[0,1,2,3,4,5,6,9,10]},{"ref":"26:8","number":2940,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","hits":[0,2]},{"ref":"26:9","number":2941,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","hits":[1,2,3,4]},{"ref":"26:10","number":2942,"text":"وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئْتِ ٱلْقَوْمَ ٱلظَّٰلِمِينَ","hits":[0,1,6,7]},{"ref":"26:11","number":2943,"text":"قَوْمَ فِرْعَوْنَ أَلَا يَتَّقُونَ","hits":[2,3]},{"ref":"26:12","number":2944,"text":"قَالَ رَبِّ إِنِّىٓ أَخَافُ أَن يُكَذِّبُونِ","hits":[0,3]},{"ref":"26:13","number":2945,"text":"وَيَضِيقُ صَدْرِى وَلَا يَنطَلِقُ لِسَانِى فَأَرْسِلْ إِلَىٰ هَٰرُونَ","hits":[0,1,3,4,5]},{"ref":"26:14","number":2946,"text":"وَلَهُمْ عَلَىَّ ذَنۢبٌ فَأَخَافُ أَن يَقْتُلُونِ","hits":[0,2,5]},{"ref":"26:15","number":2947,"text":"قَالَ كَلَّا فَٱذْهَبَا بِـَٔايَٰتِنَآ إِنَّا مَعَكُم مُّسْتَمِعُونَ","hits":[1,2]},{"ref":"26:16","number":2948,"text":"فَأْتِيَا فِرْعَوْنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلْعَٰلَمِينَ","hits":[4,6]},{"ref":"26:17","number":2949,"text":"أَنْ أَرْسِلْ مَعَنَا بَنِىٓ إِسْرَٰٓءِيلَ","hits":[3]},{"ref":"26:18","number":2950,"text":"قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيدًا وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ","hits":[4,5,8,9]},{"ref":"26:19","number":2951,"text":"وَفَعَلْتَ فَعْلَتَكَ ٱلَّتِى فَعَلْتَ وَأَنتَ مِنَ ٱلْكَٰفِرِينَ","hits":[0,2,4,6]},{"ref":"26:20","number":2952,"text":"قَالَ فَعَلْتُهَآ إِذًا وَأَنَا۠ مِنَ ٱلضَّآلِّينَ","hits":[2,3,5]},{"ref":"26:21","number":2953,"text":"فَفَرَرْتُ مِنكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لِى رَبِّى حُكْمًا وَجَعَلَنِى مِنَ ٱلْمُرْسَلِينَ","hits":[0,2,4,7,8,10]},{"ref":"26:22","number":2954,"text":"وَتِلْكَ نِعْمَةٌ تَمُنُّهَا عَلَىَّ أَنْ عَبَّدتَّ بَنِىٓ إِسْرَٰٓءِيلَ","hits":[1,2]},{"ref":"26:23","number":2955,"text":"قَالَ فِرْعَوْنُ وَمَا رَبُّ ٱلْعَٰلَمِينَ","hits":[]},{"ref":"26:24","number":2956,"text":"قَالَ رَبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ إِن كُنتُم مُّوقِنِينَ","hits":[]},{"ref":"26:25","number":2957,"text":"قَالَ لِمَنْ حَوْلَهُۥٓ أَلَا تَسْتَمِعُونَ","hits":[1,4]},{"ref":"26:26","number":2958,"text":"قَالَ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ","hits":[3]},{"ref":"26:27","number":2959,"text":"قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِىٓ أُرْسِلَ إِلَيْكُمْ لَمَجْنُونٌ","hits":[3,6]},{"ref":"26:28","number":2960,"text":"قَالَ رَبُّ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ وَمَا بَيْنَهُمَآ إِن كُنتُمْ تَعْقِلُونَ","hits":[2,8]},{"ref":"26:29","number":2961,"text":"قَالَ لَئِنِ ٱتَّخَذْتَ إِلَٰهًا غَيْرِى لَأَجْعَلَنَّكَ مِنَ ٱلْمَسْجُونِينَ","hits":[2]},{"ref":"26:30","number":2962,"text":"قَالَ أَوَلَوْ جِئْتُكَ بِشَىْءٍ مُّبِينٍ","hits":[1,2,3]},{"ref":"26:31","number":2963,"text":"قَالَ فَأْتِ بِهِۦٓ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ","hits":[6]},{"ref":"26:32","number":2964,"text":"فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَانٌ مُّبِينٌ","hits":[0,1,2,3,4]},{"ref":"26:33","number":2965,"text":"وَنَزَعَ يَدَهُۥ فَإِذَا هِىَ بَيْضَآءُ لِلنَّٰظِرِينَ","hits":[0,1,4]},{"ref":"26:34","number":2966,"text":"قَالَ لِلْمَلَإِ حَوْلَهُۥٓ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٌ","hits":[1,4,5,6]},{"ref":"26:35","number":2967,"text":"يُرِيدُ أَن يُخْرِجَكُم مِّنْ أَرْضِكُم بِسِحْرِهِۦ فَمَاذَا تَأْمُرُونَ","hits":[0,2,5,6,7]},{"ref":"26:36","number":2968,"text":"قَالُوٓا۟ أَرْجِهْ وَأَخَاهُ وَٱبْعَثْ فِى ٱلْمَدَآئِنِ حَٰشِرِينَ","hits":[2,3]},{"ref":"26:37","number":2969,"text":"يَأْتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٍ","hits":[]},{"ref":"26:38","number":2970,"text":"فَجُمِعَ ٱلسَّحَرَةُ لِمِيقَٰتِ يَوْمٍ مَّعْلُومٍ","hits":[0,2,3,4]},{"ref":"26:39","number":2971,"text":"وَقِيلَ لِلنَّاسِ هَلْ أَنتُم مُّجْتَمِعُونَ","hits":[1,2,3]},{"ref":"26:40","number":2972,"text":"لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُوا۟ هُمُ ٱلْغَٰلِبِينَ","hits":[1,5]},{"ref":"26:41","number":2973,"text":"فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالُوا۟ لِفِرْعَوْنَ أَئِنَّ لَنَا لَأَجْرًا إِن كُنَّا نَحْنُ ٱلْغَٰلِبِينَ","hits":[7,10]},{"ref":"26:42","number":2974,"text":"قَالَ نَعَمْ وَإِنَّكُمْ إِذًا لَّمِنَ ٱلْمُقَرَّبِينَ","hits":[1]},{"ref":"26:43","number":2975,"text":"قَالَ لَهُم مُّوسَىٰٓ أَلْقُوا۟ مَآ أَنتُم مُّلْقُونَ","hits":[]},{"ref":"26:44","number":2976,"text":"فَأَلْقَوْا۟ حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا۟ بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ ٱلْغَٰلِبُونَ","hits":[1,4]},{"ref":"26:45","number":2977,"text":"فَأَلْقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِكُونَ","hits":[7]},{"ref":"26:46","number":2978,"text":"فَأُلْقِىَ ٱلسَّحَرَةُ سَٰجِدِينَ","hits":[]},{"ref":"26:47","number":2979,"text":"قَالُوٓا۟ ءَامَنَّا بِرَبِّ ٱلْعَٰلَمِينَ","hits":[1]},{"ref":"26:48","number":2980,"text":"رَبِّ مُوسَىٰ وَهَٰرُونَ","hits":[]},{"ref":"26:49","number":2981,"text":"قَالَ ءَامَنتُمْ لَهُۥ قَبْلَ أَنْ ءَاذَنَ لَكُمْ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِى عَلَّمَكُمُ ٱلسِّحْرَ فَلَسَوْفَ تَعْلَمُونَ لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَٰفٍ وَلَأُصَلِّبَنَّكُمْ أَجْمَعِينَ","hits":[5,8,10,12,13,14,16,19]},{"ref":"26:50","number":2982,"text":"قَالُوا۟ لَا ضَيْرَ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ","hits":[]},{"ref":"26:51","number":2983,"text":"إِنَّا نَطْمَعُ أَن يَغْفِرَ لَنَا رَبُّنَا خَطَٰيَٰنَآ أَن كُنَّآ أَوَّلَ ٱلْمُؤْمِنِينَ","hit