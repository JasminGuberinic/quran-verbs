t", "pronoun": "hunna", "arabic": "يُسَبِّحْنَ", "plain": "يُسَبِّحْنَ", "quran": true, "notUsed": false, "spoken": "audio/aa8ba2ed194d48aa8f94.m4a", "recited": "audio/81d146418456a0e3e00d.m4a", "recitedText": "يُسَبِّحْنَ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "سَبِّحْ", "plain": "سَبِّحْ", "quran": true, "notUsed": false, "spoken": "audio/fbd9fff62b9e60a89e5e.m4a", "recited": "audio/4270aa415f4a73ce746c.m4a", "recitedText": "وَسَبِّحْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "سَبِّحِي", "plain": "سَبِّحِي", "quran": false, "notUsed": false, "spoken": "audio/8a42221ecc92418a8d5d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "سَبِّحَا", "plain": "سَبِّحَا", "quran": false, "notUsed": false, "spoken": "audio/d6d2bff0862511d5f244.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "سَبِّحُوا۟", "plain": "سَبِّحُوا", "quran": true, "notUsed": false, "spoken": "audio/f1eb454402c643779a86.m4a", "recited": "audio/8e1075b12dc0c4a36744.m4a", "recitedText": "سَبِّحُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "سَبِّحْنَ", "plain": "سَبِّحْنَ", "quran": false, "notUsed": false, "spoken": "audio/a2fea2ce081acf047369.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "56:74", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5053.mp3", "translation": {"en": {"text": "Therefor (O Muhammad), praise the name of thy Lord, the Tremendous.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Öyleyse büyük Rabbinin adını yücelt.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اے محبوب تم پاکی بولو اپنے عظمت والے رب کے نام کی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka bertasbihlah dengan (menyebut) nama Rabbmu Yang Maha Besar.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَسَبِّحْ", "hit": true, "audio": "audio/b4ddff88d24158b3de3f.m4a", "gloss": {"en": "so glorify!", "bs": "pa slavi!", "tr": "böylece tesbih et!", "fr": "alors glorifie !", "id": "maka bertasbihlah!", "ur": "پس تسبیح کر!", "bn": "অতএব তসবীহ পাঠ কর!", "fa": "پس تسبیح بگو!"}}, {"text": "بِٱسْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَظِيمِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "62:1", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5178.mp3", "translation": {"en": {"text": "All that is in the heavens and all that is in the earth glorifieth Allah, the Sovereign Lord, the Holy One, the Mighty, the Wise.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Göklerde ve yerde olanların hepsi padişah, mukaddes, azîz ve hakîm olan Allah'ı tesbih etmektedir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ کی پاکی بولتا ہے جو کچھ آسمانوں میں ہے اور جو کچھ زمین میں ہے بادشاہ کمال پاکی والا عزت والا حکمت والا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Senantiasa bertasbih kepada Allah apa yang ada di langit dan apa yang ada di bumi. Raja, Yang Maha Suci, Yang Maha Perkasa lagi Maha Bijaksana.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يُسَبِّحُ", "hit": true, "audio": "audio/bd363cc27f6994540daa.m4a", "gloss": {"en": "he/it glorifies", "bs": "slavi", "tr": "tesbih eder", "fr": "il glorifie", "id": "dia bertasbih", "ur": "وہ تسبیح کرتا ہے", "bn": "সে তসবীহ পাঠ করে", "fa": "تسبیح می‌گوید"}}, {"text": "لِلَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمَٰوَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَلِكِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقُدُّوسِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَزِيزِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَكِيمِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:20", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2503.mp3", "translation": {"en": {"text": "They glorify (Him) night and day; they flag not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Gece gündüz (hep Allah'ı) tesbih ederler, usanmazlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "رات دن اس کی پاکی بولتے ہیں اور سستی نہیں کرتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka selalu bertasbih malam dan siang tiada henti-hentinya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يُسَبِّحُونَ", "hit": true, "audio": "audio/4596b3f1464988715517.m4a", "gloss": {"en": "they glorify", "bs": "slave", "tr": "tesbih ederler", "fr": "ils glorifient", "id": "mereka bertasbih", "ur": "وہ تسبیح کرتے ہیں", "bn": "তারা তসবীহ পাঠ করে", "fa": "تسبیح می‌گویند"}}, {"text": "ٱلَّيْلَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلنَّهَارَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَفْتُرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "57:1", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5076.mp3", "translation": {"en": {"text": "All that is in the heavens and the earth glorifieth Allah; and He is the Mighty, the Wise.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Göklerde ve yerde bulunan her şey Allah'ı tesbih etmektedir. O, çok güçlüdür, hüküm ve hikmet sahibidir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ کی پاکی بولتا ہے جو کچھ آسمان اور زمین میں ہے اور وہی عزت و حکمت والا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Semua yang berada di langit dan yang berada di bumi bertasbih kepada Allah (menyatakan kebesaran Allah). Dan Dialah Yang Maha Perkasa lagi Maha Bijaksana.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "سَبَّحَ", "hit": true, "audio": "audio/cc1a05980b65ddfb403a.m4a", "gloss": {"bs": "slavi", "en": "glorifies", "tr": "tesbih eder", "fr": "glorifie", "id": "menyucikan", "ur": "وہ تسبیح کرتا ہے", "bn": "তিনি পবিত্রতা ঘোষণা করেন", "fa": "تسبیح می‌گوید"}}, {"text": "لِلَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمَٰوَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَزِيزُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَكِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:33", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2381.mp3", "translation": {"en": {"text": "That we may glorify Thee much", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ki seni çok tesbih edelim.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ ہم بکثرت تیری پاکی بولیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "supaya kami banyak bertasbih kepada Engkau,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَىْ", "hit": false, "audio": null, "gloss": null}, {"text": "نُسَبِّحَكَ", "hit": true, "audio": "audio/8e79fc9a4768d4184149.m4a", "gloss": {"bs": "(da) Te slavimo", "en": "(that) we may glorify You", "tr": "Seni tesbih edelim diye", "fr": "(afin que) nous Te glorifiions", "id": "(agar) kami menyucikan-Mu", "ur": "(تاکہ) ہم تیری تسبیح کریں", "bn": "(যাতে) আমরা তোমার পবিত্রতা ঘোষণা করি", "fa": "(تا) تو را تسبیح گوییم"}}, {"text": "كَثِيرًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "33:42", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3575.mp3", "translation": {"en": {"text": "And glorify Him early and late.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve O'nu sabah akşam tesbih edin.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور صبح و شام اس کی پاکی بولو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan bertasbihlah kepada-Nya diwaktu pagi dan petang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَسَبِّحُوهُ", "hit": true, "audio": "audio/ba1881844da5e3613cf6.m4a", "gloss": {"bs": "i slavite Ga!", "en": "and glorify Him!", "tr": "ve O'nu tesbih edin!", "fr": "et glorifiez-Le !", "id": "dan sucikanlah Dia!", "ur": "اور اس کی تسبیح کرو!", "bn": "এবং তাঁর তাসবীহ পাঠ করো!", "fa": "و او را تسبیح گویید!"}}, {"text": "بُكْرَةً", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَصِيلًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَسَبِّحْ", "count": 6, "first": "3:41", "audio": "audio/4270aa415f4a73ce746c.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "and glorify!", "bs": "i slavi!", "tr": "ve tesbih et!", "fr": "et glorifie !", "id": "dan bertasbihlah!", "u