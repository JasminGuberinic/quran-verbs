n": "anta", "arabic": "اِنْزِعْ", "plain": "اِنْزِعْ", "quran": false, "notUsed": false, "spoken": "audio/bbf309cc741775d4855d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِنْزِعِي", "plain": "اِنْزِعِي", "quran": false, "notUsed": false, "spoken": "audio/c81dcb14d011f3dbdc59.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِنْزِعَا", "plain": "اِنْزِعَا", "quran": false, "notUsed": false, "spoken": "audio/07b989dc9cb3e6b4a84a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِنْزِعُوا", "plain": "اِنْزِعُوا", "quran": false, "notUsed": false, "spoken": "audio/b8eb8dade1ad968e3379.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِنْزِعْنَ", "plain": "اِنْزِعْنَ", "quran": false, "notUsed": false, "spoken": "audio/2cb0cae46fe87a37bd90.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "15:47", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1849.mp3", "translation": {"en": {"text": "And We remove whatever rancour may be in their breasts. As brethren, face to face, (they rest) on couches raised.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz o cennetliklerin kalblerindeki kinleri çıkarır atarız. Hepsi kardeşler olarak sevinç içinde karşılıklı koltuklara otururlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے ان کے سینوں میں جو کچھ کینے تھے سب کھینچ لیے آپس میں بھائی ہیں تختوں پر روبرو بیٹھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami lenyapkan segala rasa dendam yang berada dalam hati mereka, sedang mereka merasa bersaudara duduk berhadap-hadapan di atas dipan-dipan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَنَزَعْنَا", "hit": true, "audio": "audio/7c1dc8ddda941b7d7c4f.m4a", "gloss": {"en": "and we removed", "bs": "i uklonili smo", "tr": "ve kaldırdık", "fr": "et nous avons enlevé", "id": "dan kami telah menghapus", "ur": "اور ہم نے دور کیا", "bn": "এবং আমরা অপসারণ করেছি", "fa": "و برداشتیم"}}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "صُدُورِهِم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْ", "hit": false, "audio": null, "gloss": null}, {"text": "غِلٍّ", "hit": false, "audio": null, "gloss": null}, {"text": "إِخْوَٰنًا", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "سُرُرٍ", "hit": false, "audio": null, "gloss": null}, {"text": "مُّتَقَٰبِلِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:108", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1062.mp3", "translation": {"en": {"text": "And he drew forth his hand (from his bosom), and lo! it was white for the beholders.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve Musa elini koynundan çıkarıverdi, eli bembeyaz olmuş, bakanların gözünü kamaştırıyordu.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اپنا ہاتھ گریبان میں ڈال کر نکا لا تو وہ دیکھنے والوں کے سامنے جگمگانے لگا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan ia mengeluarkan tangannya, maka ketika itu juga tangan itu menjadi putih bercahaya (kelihatan) oleh orang-orang yang melihatnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَنَزَعَ", "hit": true, "audio": "audio/10d00172c16f53d0a302.m4a", "gloss": {"bs": "i izvadio je", "en": "and he drew out", "tr": "ve çıkardı", "fr": "et il retira", "id": "dan dia mencabut", "ur": "اور اس نے نکال لیا", "bn": "এবং সে বের করে আনল", "fa": "و برکشید"}}, {"text": "يَدَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "هِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "بَيْضَآءُ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلنَّٰظِرِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:69", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2319.mp3", "translation": {"en": {"text": "Then We shall pluck out from every sect whichever of them was most stubborn in rebellion to the Beneficent.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra her zümreden Rahmân'a karşı en ziyade isyankâr hangileri ise, muhakkak ayırıp atacağız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر ہم ہر گروہ سے نکالیں گے جو ان میں رحمن پر سب سے زیادہ بے باک ہوگا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian pasti akan Kami tarik dari tiap-tiap golongan siapa di antara mereka yang sangat durhaka kepada Tuhan Yang Maha Pemurah.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَنزِعَنَّ", "hit": true, "audio": "audio/21216acb8f71a2371e4a.m4a", "gloss": {"en": "surely we will remove", "bs": "zaista ćemo ukloniti", "tr": "kesinlikle kaldıracağız", "fr": "nous enlèverons assurément", "id": "sungguh kami akan menghapus", "ur": "یقیناً ہم دور کریں گے", "bn": "নিশ্চয়ই আমরা সরিয়ে দেব", "fa": "قطعاً برخواهیم داشت"}}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "كُلِّ", "hit": false, "audio": null, "gloss": null}, {"text": "شِيعَةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "أَيُّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَشَدُّ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَى",