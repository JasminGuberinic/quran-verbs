{"rank": 79, "root": "نذر", "form": 4, "lemma": "أَنذَرَ", "count": 45, "ayahCount": 40, "share": 0.23, "meaning": {"bs": "opomenuti, upozoriti", "en": "to warn", "tr": "uyarmak", "fr": "avertir", "id": "memperingatkan", "ur": "ڈرانا، خبردار کرنا", "bn": "সতর্ক করা", "fa": "بیم دادن، هشدار دادن"}, "lemmaSpoken": "audio/44a38c158a4920cc56df.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَنذَرَ", "plain": "أَنْذَرَ", "quran": true, "notUsed": false, "spoken": "audio/44a38c158a4920cc56df.m4a", "recited": "audio/e2590f8de751373e6144.m4a", "recitedText": "أَنذَرَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُنْذِرُ", "plain": "يُنْذِرُ", "quran": false, "notUsed": false, "spoken": "audio/844891897d721a8f4c2c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَنذِرْ", "plain": "أَنْذِرْ", "quran": true, "notUsed": false, "spoken": "audio/6bf33e0f8e6f90f422e3.m4a", "recited": "audio/85fe6f97c2859541fc67.m4a", "recitedText": "أَنذِرْ"}], "nouns": {"participle": {"lemma": "مُنذِر", "count": 15, "spoken": "audio/77359638d7364bbb8bcf.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَنْذَرْتُ", "plain": "أَنْذَرْتُ", "quran": false, "notUsed": false, "spoken": "audio/d7b322cc97770d577259.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَنْذَرْنَا", "plain": "أَنْذَرْنَا", "quran": false, "notUsed": false, "spoken": "audio/c9f3c4e3cd01de5a7319.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "أَنْذَرْتَ", "plain": "أَنْذَرْتَ", "quran": false, "notUsed": false, "spoken": "audio/c0c94d93fbc68ba8832a.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "أَنْذَرْتِ", "plain": "أَنْذَرْتِ", "quran": false, "notUsed": false, "spoken": "audio/fcad74ea6be25c012507.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "أَنْذَ