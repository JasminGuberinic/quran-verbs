رِي", "target": true, "translation": {"bs": "prodaje", "en": "sells", "bn": "বিক্রি করে", "fa": "می‌فروشد", "fr": "vend", "id": "dia menjual", "tr": "satar", "ur": "بیچتا ہے"}}, {"arabic": "الْفَلَّاحُ", "target": false, "translation": {"bs": "seljak", "en": "the farmer", "bn": "কৃষকটি", "fa": "کشاورز", "fr": "l'agriculteur", "id": "petani itu", "tr": "çiftçi", "ur": "کسان"}}, {"arabic": "الْقَمْحَ", "target": false, "translation": {"bs": "pšenicu", "en": "the wheat", "bn": "গম", "fa": "گندم", "fr": "le blé", "id": "gandum itu", "tr": "buğday", "ur": "گندم"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "na", "en": "at", "bn": "এ", "fa": "در", "fr": "à", "id": "di", "tr": "-de", "ur": "میں"}}, {"arabic": "السُّوقِ", "target": false, "translation": {"bs": "pijaci", "en": "the market", "bn": "বাজার", "fa": "بازار", "fr": "le marché", "id": "pasar itu", "tr": "çarşı", "ur": "بازار"}}]}, {"arabic": "شَرَوْا بَيْتَهُمُ الْقَدِيمَ", "spoken": "audio/a1991a09600d49071b7d.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Prodali su svoju staru kuću.", "en": "They sold their old house.", "bn": "তারা তাদের পুরনো বাড়িটি বিক্রি করেছে।", "fa": "خانه قدیمی‌شان را فروختند.", "fr": "Ils ont vendu leur vieille maison.", "id": "Mereka menjual rumah tua mereka.", "tr": "Eski evlerini sattılar.", "ur": "انہوں نے اپنا پرانا گھر بیچ دیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "شَرَوْا", "target": true, "translation": {"bs": "prodali su", "en": "sold", "bn": "বিক্রি করেছে", "fa": "فروختند", "fr": "ont vendu", "id": "mereka menjual", "tr": "sattılar", "ur": "بیچ دیے"}}, {"arabic": "بَيْتَهُمُ", "target": false, "translation": {"bs": "svoju kuću", "en": "their house", "bn": "তাদের বাড়ি", "fa": "خانه‌شان", "fr": "leur maison", "id": "rumah mereka", "tr": "evlerini", "ur": "ان کا گھر"}}, {"arabic": "الْقَدِيمَ", "target": false, "translation": {"bs": "staru", "en": "old", "bn": "পুরোনো", "fa": "قدیمی", "fr": "vieux", "id": "tua", "tr": "yaşlı", "ur