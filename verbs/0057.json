ive": false, "objects": []}], "gloss": {"en": "(you all) carry out!", "bs": "izvršite!", "tr": "yerine getirin!", "fr": "accomplissez !", "id": "laksanakanlah!", "ur": "پورا کرو!", "bn": "পালন কর!", "fa": "به انجام رسانید!"}}, {"arabic": "قَضَىٰهَا", "count": 1, "first": "12:68", "audio": "audio/026d0c7e01437aa758c4.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hiya"]}], "gloss": {"en": "he/it fulfilled it", "bs": "ispunio ju je", "tr": "onu yerine getirdi", "fr": "il l'a accompli", "id": "dia telah memenuhinya", "ur": "اُس نے اسے پورا کیا", "bn": "সে তা পূর্ণ করল", "fa": "آن را به انجام رساند"}}, {"arabic": "وَقَضَىٰ", "count": 1, "first": "17:23", "audio": "audio/16a24132632aab864c2a.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it decreed", "bs": "i odredio je", "tr": "ve takdir etti", "fr": "et il a décrété", "id": "dan dia telah menetapkan", "ur": "اور اُس نے فیصلہ کیا", "bn": "এবং সে নির্ধারণ করল", "fa": "و مقدر کرد"}}, {"arabic": "فَٱقْضِ", "count": 1, "first": "20:72", "audio": "audio/63f5320ba8b958fe58b9.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "so decree!", "bs": "pa odredi!", "tr": "böylece takdir et!", "fr": "décrète donc !", "id": "maka tetapkanlah!", "ur": "پس فیصلہ کر!", "bn": "অতএব নির্ধারণ কর!", "fa": "پس مقدر کن!"}}, {"arabic": "تَقْضِى", "count": 1, "first": "20:72", "audio": "audio/5e6246955fcf3b402bd7.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "indicative"}]}, {"arabic": "يُقْضَىٰٓ", "count": 1, "first": "20:114", "audio": "audio/ca7ff854e58e1f63420c.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "it is finished", "bs": "završava se", "tr": "tamamlanır", "fr": "il s'achève", "id": "diselesaikan", "ur": "یہ پورا ہو چکا", "bn": "তা সম