o teške poreze.", "en": "The king imposed heavy taxes on the people.", "bn": "রাজা জনগণের উপর ভারী কর চাপিয়েছিলেন।", "fa": "پادشاه مالیات‌های سنگینی بر مردم تحمیل کرد.", "fr": "Le roi a imposé de lourds impôts au peuple.", "id": "Raja itu membebankan pajak yang berat kepada rakyat.", "tr": "Kral halka ağır vergiler yükledi.", "ur": "بادشاہ نے عوام پر بھاری ٹیکس عائد کیے۔"}, "independentlyReviewed": true, "words": [{"arabic": "سَامَ", "target": true, "translation": {"bs": "nametnuo je", "en": "imposed", "bn": "চাপিয়েছে", "fa": "تحمیل کرد", "fr": "a imposé", "id": "dia memberlakukan", "tr": "yükledi", "ur": "مسلط کیا"}}, {"arabic": "الْمَلِكُ", "target": false, "translation": {"bs": "kralj", "en": "the king", "bn": "রাজা", "fa": "پادشاه", "fr": "le roi", "id": "raja itu", "tr": "kral", "ur": "بادشاہ"}}, {"arabic": "الشَّعْبَ", "target": false, "translation": {"bs": "narodu", "en": "on the people", "bn": "জনগণের উপর", "fa": "بر مردم", "fr": "au peuple", "id": "kepada rakyat", "tr": "halka", "ur": "لوگوں پر"}}, {"arabic": "ضَرَائِبَ", "target": false, "translation": {"bs": "poreze", "en": "taxes", "bn": "কর", "fa": "مالیات‌ها", "fr": "des impôts", "id": "pajak", "tr": "vergiler", "ur": "ٹیکس"}}, {"arabic": "ثَقِيلَةً", "target": false, "translation": {"bs": "teške", "en": "heavy", "bn": "ভারী", "fa": "سنگین", "fr": "lourds", "id": "berat", "tr": "ağır", "ur": "بھاری"}}]}, {"arabic": "يَسُومُ الْمُدِيرُ الْعُمَّالَ عَمَلًا شَاقًّا", "spoken": "audio/5671eee50a08afbf6fa3.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Direktor radnicima nameće težak rad.", "en": "The manager imposes hard work on the workers.", "bn": "ব্যবস্থাপক শ্রমিকদের উপর কঠিন কাজ চাপায়।", "fa": "مدیر کار سختی بر کارگران تحمیل می‌کند.", "fr": "Le directeur impose un travail pénible aux ouvriers.", "id": "Direktur itu membebankan pekerjaan yang berat kepada para pekerja.", "tr": "Müdür işçilere zor iş yükler.", "ur": "منیجر مزدوروں پر سخت کام مسلط کرتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَسُومُ", "target": true, "translation": {"bs": "nameće", "en": "imposes", "bn": "চাপায়", "fa": "تحمیل می‌کند", "fr": "impose", "id": "ia membebankan", "tr": "yükler", "ur": "مسلط کرتا ہے"}}, {"arabic": "الْمُدِيرُ", "target": false, "translation": {"bs": "direktor", "en": "the manager", "bn": "পরিচালক", "fa": "مدیر", "fr": "le directeur", "id": "direktur itu", "tr": "müdür", "ur": "منیجر"}}, {"arabic": "الْعُمَّالَ", "target": false, "translation": {"bs": "radnicima", "en": "on the workers", "bn": "শ্রমিকদের উপর", "fa": "بر کارگران", "fr": "aux ouvriers", "id": "kepada para pekerja", "tr": "işçilere", "ur": "مزدوروں پر"}}, {"arabic": "عَمَلًا", "target": false, "translation": {"bs": "rad", "en": "work", "bn": "কাজ", "fa": "کار", "fr": "travail", "id": "pekerjaan", "tr": "iş", "ur": "کام"}}, {"arabic": "شَاقًّا", "target": false, "translation": {"bs": "težak", "en": "hard", "bn": "কঠিন", "fa": "سخت", "fr": "pénible", "id": "berat", "tr": "zor", "ur": "سخت"}}]}, {"arabic": "لَا أَسُومُ أَحَدًا عَمَلًا شَاقًّا", "spoken": "audio/f57b9cfd366771bccbcb.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Ne namećem nikome težak rad.", "en": "I do not impose hard work on anyone.", "bn": "আমি কারও উপর কঠিন কাজ চাপাই না।", "fa": "بر هیچ‌کس کار سخت تحمیل نمی‌کنم.", "fr": "Je n'impose un travail pénible à personne.", "id": "Aku tidak membebankan pekerjaan berat kepada siapa pun.", "tr": "Hiç kimseye zor iş yüklemem.", "ur": "میں کسی پر سخت کام مسلط نہیں کرتا۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "أَسُومُ", "target": true, "translation": {"bs": "namećem", "en": "impose", "bn": "চাপাই", "fa": "تحمیل می‌کنم", "fr": "j'impose", "id": "aku membebankan", "tr": "yüklerim", "ur": "مسلط کرتا ہوں"}}, {"arabic": "أَحَدًا", "target": false, "translation": {"bs": "nikome", "en": "on someone", "bn": "কারও উপর", "fa": "بر کسی", "fr": "à personne", "id": "kepada siapa pun", "tr": "hiç kimseye", "ur": "کسی پر"}}, {"arabic": "عَمَلًا", "target": false, "translation": {"bs": "rad", "en": "work", "bn": "কাজ", "fa": "کار", "fr": "travail", "id": "pekerjaan", "tr": "iş", "ur": "کام"}}, {"arabic": "شَاقًّا", "target": false, "translation": {"bs": "težak", "en": "hard", "bn": "কঠিন", "fa": "سخت", "fr": "pénible", "id": "berat", "tr": "zor", "ur": "سخت"}}]}, {"arabic": "سَامُوا الْفَلَّاحِينَ ضَرَائِبَ بَاهِظَةً", "spoken": "audio/ea87a6c97cb4d5aab368.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Nametnuli su seljacima previsoke poreze.", "en": "They imposed exorbitant taxes on the peasants.", "bn": "তারা কৃষকদের উপর অতিরিক্ত কর চাপিয়েছে।", "fa": "بر کشاورزان مالیات‌های گزاف تحمیل کردند.", "fr": "Ils ont imposé des impôts exorbitants aux paysans.", "id": "Mereka membebankan pajak selangit kepada para petani.", "tr": "Köylülere aşırı vergiler yüklediler.", "ur": "انہوں نے کسانوں پر بھاری ٹیکس عائد کیے۔"}, "independentlyReviewed": true, "words": [{"arabic": "سَامُوا", "target": true, "translation": {"bs": "nametnuli su", "en": "imposed", "bn": "চাপিয়েছে", "fa": "تحمیل کردند", "fr": "ont imposé", "id": "mereka memberlakukan", "tr": "yüklediler", "ur": "مسلط کیا"}}, {"arabic": "الْفَلَّاحِينَ", "target": false, "translation": {"bs": "seljacima", "en": "on the peasants", "bn": "কৃষকদের উপর", "fa": "بر کشاورزان", "fr": "aux paysans", "id": "kepada para petani", "tr": "köylülere", "ur": "کسانوں پر"}}, {"arabic": "ضَرَائِبَ", "target": false, "translation": {"bs": "poreze", "en": "taxes", "bn": "কর", "fa": "مالیات‌ها", "fr": "des impôts", "id": "pajak", "tr": "vergiler", "ur": "ٹیکس"}}, {"arabic": "بَاهِظَةً", "target": false, "translation": {"bs": "previsoke", "en": "exorbitant", "bn": "অতিরিক্ত", "fa": "گزاف", "fr": "exorbitants", "id": "selangit", "tr": "aşırı", "ur": "بھاری"}}]}]}