ation": {"bs": "dijete", "en": "the child", "bn": "শিশুটি", "fa": "کودک", "fr": "l'enfant", "id": "anak itu", "tr": "çocuk", "ur": "بچہ"}}]}, {"arabic": "الْبَرْدُ يُعَذِّبُ الْفُقَرَاءَ", "spoken": "audio/ab9c6255dc0989e391ce.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Hladnoća muči siromašne.", "en": "The cold torments the poor.", "bn": "শীত গরিবদের কষ্ট দেয়।", "fa": "سرما فقیران را رنج می‌دهد.", "fr": "Le froid tourmente les pauvres.", "id": "Dingin menyiksa orang miskin.", "tr": "Soğuk fakirlere eziyet eder.", "ur": "سردی غریبوں کو ستاتی ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "الْبَرْدُ", "target": false, "translation": {"bs": "hladnoća", "en": "the cold", "bn": "শীত", "fa": "سرما", "fr": "le froid", "id": "dingin itu", "tr": "soğuk", "ur": "سردی"}}, {"arabic": "يُعَذِّبُ", "target": true, "translation": {"bs": "muči", "en": "torments", "bn": "কষ্ট দেয়", "fa": "رنج می‌دهد", "fr": "tourmente", "id": "menyiksa", "tr": "eziyet eder", "ur": "وہ ستاتا ہے"}}, {"arabic": "الْفُقَرَاءَ", "target": false, "translation": {"bs": "siromašne", "en": "the poor", "bn": "গরিব", "fa": "فقیران", "fr": "les pauvres", "id": "orang miskin", "tr": "fakirler", "ur": "غریب"}}]}, {"arabic": "مَا عَذَّبْنَا الْحَيَوَانَ", "spoken": "audio/63b1853e141de1d075c8.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Nismo mučili životinju.", "en": "We did not torment the animal.", "bn": "আমরা প্রাণীটিকে কষ্ট দিইনি।", "fa": "حیوان را آزار ندادیم.", "fr": "Nous n'avons pas tourmenté l'animal.", "id": "Kami tidak menyiksa hewan itu.", "tr": "Hayvana eziyet etmedik.", "ur": "ہم نے جانور کو نہیں ستایا۔"}, "independentlyReviewed": true, "words": [{"arabic": "مَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "nous n'avons pas", "id": "tidak", "tr": "-me", "ur": "نہیں"}}, {"arabic": "عَذَّبْنَا", "target": true, "translation": {"bs": "smo mučili", "en": "we tormented", "bn": "আমরা কষ্ট দিলাম", "fa": "آزار دادیم", "fr": "nous avons tourmenté", "id": "kami menyiksa", "tr": "eziyet ettik", "ur": "ہم نے ستایا"}}, {"arabic": "الْحَيَوَانَ", "target": false, "translation": {"bs": "životinju", "en": "the animal", "bn": "প্রাণী", "fa": "حیوان", "fr": "l'animal", "id": "hewan", "tr": "hayvan", "ur": "جانور"}}]}]}