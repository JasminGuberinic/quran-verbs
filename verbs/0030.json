{"rank": 30, "root": "ليس", "form": 1, "lemma": "لَيْسَ", "count": 89, "ayahCount": 85, "share": 0.46, "meaning": {"bs": "ne biti", "en": "not to be", "tr": "olmamak", "fr": "ne pas être", "id": "tidak ada, bukan", "ur": "نہ ہونا", "bn": "না হওয়া", "fa": "نبودن"}, "lemmaSpoken": "audio/e7c0609146ebc50bfa2c.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "لَيْسَ", "plain": "لَيْسَ", "quran": true, "notUsed": false, "spoken": "audio/e7c0609146ebc50bfa2c.m4a", "recited": "audio/f3e398a165bf1107adb4.m4a", "recitedText": "لَيْسَ"}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "hiya", "arabic": "لَيْسَتِ", "plain": "لَيْسَتِ", "quran": true, "notUsed": false, "spoken": "audio/6d8ec61cded49a8508ce.m4a", "recited": "audio/e8f0b997326652f7a817.m4a", "recitedText": "لَيْسَتِ"}, {"tense": "past", "pronoun": "huwa", "arabic": "لَيْسَ", "plain": "لَيْسَ", "quran": true, "notUsed": false, "spoken": "audio/e7c0609146ebc50bfa2c.m4a", "recited": "audio/f3e398a165bf1107adb4.m4a", "recitedText": "لَيْسَ"}, {"tense": "past", "pronoun": "antum", "arabic": "لَسْتُم", "plain": "لَسْتُم", "quran": true, "notUsed": false, "spoken": "audio/7267597948bf4e9827af.m4a", "recited": "audio/fd1f1cbdba83a001098a.m4a", "recitedText": "وَلَسْتُم"}, {"tense": "past", "pronoun": "hum", "arabic": "لَيْسُوا۟", "plain": "لَيْسُوا۟", "quran": true, "notUsed": false, "spoken": "audio/123ed63543fcd8bf13a4.m4a", "recited": "audio/9a469bcd17328c6fedd8.m4a", "recitedText": "لَيْسُوا۟"}, {"tense": "past", "pronoun": "anta", "arabic": "لَسْتَ", "plain": "لَسْتَ", "quran": true, "notUsed": false, "spoken": "audio/fc75cf7185d75e72cc9b.m4a", "recited": "audio/c27600793736277cf816.m4a", "recitedText": "لَسْتَ"}, {"tense": "past", "pronoun": "ana", "arabic": "لَّسْتُ", "plain": "لَّسْتُ", "quran": true, "notUsed": false, "spoken": "audio/d8c0bd45d31ee168de5b.m4a", "recited": "audio/46802cc93a8a16c6e12c.m4a", "recitedText": "لَّسْتُ"}, {"tense": "past", "pronoun": "antunna", "arabic": "لَسْتُنَّ", "plain": "لَسْتُنَّ", "quran": true, "notUsed": false, "spoken": "audio/7d0b115dcfb027bf8246.m4a", "recited": "audio/38de2c2b9532a984c19b.m4a", "recitedText": "لَسْتُنَّ"}], "ayat": [{"ref": "56:2", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4981.mp3", "translation": {"en": {"text": "There is no denying that it will befall -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onun oluşunu yalanlayacak kimse yoktur.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس وقت اس کے ہونے میں کسی کو انکار کی گنجائش نہ ہوگی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "tidak seorangpun dapat berdusta tentang kejadiannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَيْسَ", "hit": true, "audio": "audio/f3e398a165bf1107adb4.m4a", "gloss": {"bs": "nema", "en": "there is not", "tr": "yoktur", "fr": "il n'y a pas", "id": "tidak ada", "ur": "نہیں ہے", "bn": "নেই", "fa": "نیست"}}, {"text": "لِوَقْعَتِهَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَاذِبَةٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "88:22", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5989.mp3", "translation": {"en": {"text": "Thou art not at all a warder over them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onların üzerinde bir zorba değilsin.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم کچھ ان پر کڑ وڑا (ضامن) نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kamu bukanlah orang yang berkuasa atas mereka,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَّسْتَ", "hit": true, "audio": "audio/e675ab4719367b24d766.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "anta", "passive": false, "objects": []}]}, {"text": "عَلَيْهِم", "hit": false, "audio": null, "gloss": null}, {"text": "بِمُصَيْطِرٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:20", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1822.mp3", "translation": {"en": {"text": "And we have given unto you livelihoods therein, and unto those for whom ye provide not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Orada hem sizin için, hem de sizin rızıklarını veremediğiniz kimseler için geçim yollarını yarattık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور تمہارے لیے اس میں روزیاں کردیں اور وہ کردیے جنہیں تم رزق نہیں دیتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami telah menjadikan untukmu di bumi keperluan-keperluan hidup, dan (Kami menciptakan pula) makhluk-makhluk yang kamu sekali-kali bukan pemberi rezeki kepadanya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَجَعَلْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَعَٰيِشَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّسْتُمْ", "hit": true, "audio": "audio/04982a37bd6fd46c580e.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}]}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "بِرَٰزِقِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "6:66", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/855.mp3", "translation": {"en": {"text": "Thy people (O Muhammad) have denied it, though it is the Truth. Say: I am not put in charge of you.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kavmin o (Kur'ân'ı) yalan saydı, halbuki o gerçektir. De ki: \" Ben sizin vekiliniz değilim\".", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اسے جھٹلایا تمہاری قوم نے اور یہی حق ہے، تم فرماؤ میں تم پر کچھ کڑوڑا (حاکمِ اعلیٰ) نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan kaummu mendustakannya (azab) padahal azab itu benar adanya. Katakanlah: \"Aku ini bukanlah orang yang diserahi mengurus urusanmu\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَكَذَّبَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْمُكَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَقُّ", "hit": false, "audio": null, "gloss": null}, {"text": "قُل", "hit": false, "audio": null, "gloss": null}, {"text": "لَّسْتُ", "hit": true, "audio": "audio/46802cc93a8a16c6e12c.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "ana", "passive": false, "objects": []}]}, {"text": "عَلَيْكُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِوَكِيلٍ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "لَيْسَ", "count": 38, "first": "2:198", "audio": "audio/f3e398a165bf1107adb4.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "nema", "en": "there is not", "tr": "yoktur", "fr": "il n'y a pas", "id": "tidak ada", "ur": "نہیں ہے", "bn": "নেই", "fa": "نیست"}}, {"arabic": "أَلَيْسَ", "count": 13, "first": "6:30", "audio": "audio/c722135bb99f2b77737d.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}]}, {"arabic": "لَّيْسَ", "count": 9, "first": "2:177", "audio": "audio/08a97b2d72dbb8029026.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "pas