{"ayat":[{"ref":"3:137","number":430,"text":"قَدْ خَلَتْ مِن قَبْلِكُمْ سُنَنٌ فَسِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُكَذِّبِينَ","hits":[12]},{"ref":"6:11","number":800,"text":"قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ ثُمَّ ٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُكَذِّبِينَ","hits":[9]},{"ref":"16:36","number":1937,"text":"وَلَقَدْ بَعَثْنَا فِى كُلِّ أُمَّةٍ رَّسُولًا أَنِ ٱعْبُدُوا۟ ٱللَّهَ وَٱجْتَنِبُوا۟ ٱلطَّٰغُوتَ فَمِنْهُم مَّنْ هَدَى ٱللَّهُ وَمِنْهُم مَّنْ حَقَّتْ عَلَيْهِ ٱلضَّلَٰلَةُ فَسِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُكَذِّبِينَ","hits":[27]},{"ref":"43:25","number":4350,"text":"فَٱنتَقَمْنَا مِنْهُمْ فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُكَذِّبِينَ","hits":[6]},{"ref":"52:11","number":4746,"text":"فَوَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[2]},{"ref":"56:51","number":5030,"text":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ","hits":[4]},{"ref":"56:92","number":5071,"text":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ","hits":[4]},{"ref":"68:8","number":5279,"text":"فَلَا تُطِعِ ٱلْمُكَذِّبِينَ","hits":[2]},{"ref":"69:49","number":5372,"text":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","hits":[4]},{"ref":"73:11","number":5486,"text":"وَذَرْنِى وَٱلْمُكَذِّبِينَ أُو۟لِى ٱلنَّعْمَةِ وَمَهِّلْهُمْ قَلِيلًا","hits":[1]},{"ref":"77:15","number":5637,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[2]},{"ref":"77:19","number":5641,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[2]},{"ref":"77:24","number":5646,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[2]},{"ref":"77:28","number":5650,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[2]},{"ref":"77:34","number":5656,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[2]},{"ref":"77:37","number":5659,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[2]},{"ref":"77:40","number":5662,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[2]},{"ref":"77:45","number":5667,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[