"recitedText": null}, {"tense": "present", "pronoun": "hunna", "arabic": "يَصْبِرْنَ", "plain": "يَصْبِرْنَ", "quran": false, "notUsed": false, "spoken": "audio/dc1ac3e23da32f3f83f8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱصْبِرْ", "plain": "اِصْبِرْ", "quran": true, "notUsed": false, "spoken": "audio/6e2d8cf9a7ce81a1b706.m4a", "recited": "audio/8c25c70bf4de5efc09f1.m4a", "recitedText": "ٱصْبِرْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِصْبِرِي", "plain": "اِصْبِرِي", "quran": false, "notUsed": false, "spoken": "audio/10e7bd89527bc65cf601.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِصْبِرَا", "plain": "اِصْبِرَا", "quran": false, "notUsed": false, "spoken": "audio/267934ce0040808eca2c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱصْبِرُوا۟", "plain": "اِصْبِرُوا", "quran": true, "notUsed": false, "spoken": "audio/74f97b661a2fd03aa429.m4a", "recited": "audio/f52bddf4e1d6570ce729.m4a", "recitedText": "ٱصْبِرُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِصْبِرْنَ", "plain": "اِصْبِرْنَ", "quran": false, "notUsed": false, "spoken": "audio/94ae531cff68f565840b.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "70:5", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5380.mp3", "translation": {"en": {"text": "But be patient (O Muhammad) with a patience fair to see.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O halde güzel bir sabır ile sabret.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو تم اچھی طرح صبر کرو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka bersabarlah kamu dengan sabar yang baik.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱصْبِرْ", "hit": true, "audio": "audio/9ad9d48444312e4a9b07.m4a", "gloss": {"bs": "zato se strpi!", "en": "so be patient!", "tr": "öyleyse sabret!", "fr": "sois donc patient !", "id": "maka bersabarlah!", "ur": "پس صبر کرو!", "bn": "অতএব ধৈর্য ধরো!", "fa": "پس صبر کن!"}}, {"text": "صَبْرًا", "hit": false, "audio": null, "gloss": null}, {"text": "جَمِيلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "16:42", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1943.mp3", "translation": {"en": {"text": "Such as are steadfast and put their trust in Allah.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O Muhacirler, müşriklerin eziyetlerine sabredenler ve Rablerine tevekkül edenlerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ جنہوں نے صبر کیا اور اپنے رب ہی پر بھروسہ کرتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yaitu) orang-orang yang sabar dan hanya kepada Tuhan saja mereka bertawakkal.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "صَبَرُوا۟", "hit": true, "audio": "audio/a82a7a335ddf51b7e032.m4a", "gloss": {"bs": "su bili strpljivi", "en": "were patient", "tr": "sabrettiler", "fr": "furent patients", "id": "mereka bersabar", "ur": "انہوں نے صبر کیا", "bn": "তারা ধৈর্য ধরেছিল", "fa": "صبر کردند"}}, {"text": "وَعَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَوَكَّلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "52:16", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4751.mp3", "translation": {"en": {"text": "Endure the heat thereof, and whether ye are patient of it or impatient of it is all one for you. Ye are only being paid for what ye used to do.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Girin oraya, ister sabredin ister etmeyin artık sizin için birdir. Siz hep yaptıklarınıza göre cezalandırılacaksınız\" (denilecek).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس میں جاؤ اب چاہے صبر کرو یا نہ کرو، سب تم پر ایک سا ہے تمہیں اسی کا بدلہ جو تم کرتے تھے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Masukklah kamu ke dalamnya (rasakanlah panas apinya); maka baik kamu bersabar atau tidak, sama saja bagimu; kamu diberi balasan terhadap apa yang telah kamu kerjakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱصْلَوْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱصْبِرُوٓا۟", "hit": true, "audio": "audio/43d31b9ae428cae0ece4.m4a", "gloss": {"en": "so (you all) be patient!", "bs": "pa se strpite!", "tr": "böylece sabredin!", "fr": "alors soyez patients !", "id": "maka bersabarlah kalian!", "ur": "پس تم سب صبر کرو!", "bn": "অতএব তোমরা ধৈর্য ধর!", "fa": "پس صبر کنید!"}}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَصْبِرُوا۟", "hit": true, "audio": "audio/01c7324d6fd746c0ec04.m4a", "gloss": {"en": "you (all) are patient", "bs": "strpite se", "tr": "sabredersiniz", "fr": "vous soyez patients", "id": "kalian bersabar", "ur": "تم سب صبر کرتے ہو", "bn": "তোমরা ধৈর্য ধর", "fa": "صبر کنید"}}, {"text": "سَوَآءٌ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُجْزَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْمَلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:200", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/493.mp3", "translation": {"en": {"text": "O ye who believe! Endure, outdo all others in endurance, be ready, and observe your duty to Allah, in order that ye may succeed.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey iman edenler! Sabredin, düşmanlarınıza karşı sebat gösterin, nöbet bekleşin, Allah'dan gereğince korkun ki, kurtuluşa eresiniz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے ایمان والو! صبر کرو اور صبر میں دشمنوں سے آگے رہو اور سرحد پر اسلامی ملک کی نگہبانی کرو اور اللہ سے ڈرتے رہو اس امید پر کہ کامیاب ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hai orang-orang yang beriman, bersabarlah kamu dan kuatkanlah kesabaranmu dan tetaplah bersiap siaga (di perbatasan negerimu) dan bertakwalah kepada Allah, supaya kamu beruntung.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَٰٓأَيُّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱصْبِرُوا۟", "hit": true, "audio": "audio/f52bddf4e1d6570ce729.m4a", "gloss": {"en": "(you all) be patient!", "bs": "strpite se!", "tr": "sabredin!", "fr": "soyez patients !", "id": "bersabarlah kalian!", "ur": "صبر کرو!", "bn": "তোমরা ধৈর্য ধর!", "fa": "صبر کنید!"}}, {"text": "وَصَابِرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَرَابِطُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱتَّقُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تُفْلِحُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "42:43", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4315.mp3", "translation": {"en": {"text": "And verily whoso is patient and forgiveth - lo! that, verily, is (of) the steadfast heart of things.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Her kim de sabreder ve kusuru bağışlarsa, işte bu elbette azmedilecek işlerdendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک جس نے صبر کیا اور بخش دیا تو یہ ضرور ہمت کے کام ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tetapi orang yang bersabar dan memaafkan, sesungguhnya (perbuatan) yang demikian itu termasuk hal-hal yang diutamakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "صَبَرَ", "hit": true, "audio": "audio/f7e9f60bdb00221f30af.m4a", "gloss": {"en": "he/it was patient", "bs": "strpio se", "tr": "sabretti", "fr": "il a été patient", "id": "dia telah bersabar", "ur": "اُس نے صبر کیا", "bn": "সে ধৈর্য ধরেছিল", "fa": "صبر کرد"}}, {"text": "وَغَفَرَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَمِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَزْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأُمُورِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:68", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2208.mp3", "translation": {"en": {"text": "How canst thou bear with that whereof thou canst not compass any knowledge?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"İçyüzünü kavrayamadığın şeye nasıl sabredeceksin?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اس بات پر کیونکر صبر کریں گے جسے آپ کا علم محیط نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan bagaimana kamu dapat sabar atas sesuatu, yang kamu belum mempunyai pengetahuan yang cukup tentang hal itu?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَكَيْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَصْبِرُ", "hit": true, "audio": "audio/48024d1a3ab1ea034a00.m4a", "gloss": {"bs": "(kako da) se strpiš", "en": "(how can) you be patient", "tr": "nasıl sabredersin", "fr": "(comment) pourrais-tu être patient", "id": "(bagaimana) kamu bisa bersabar", "ur": "(تم کیسے) صبر کرو گے", "bn": "(কীভাবে) তুমি ধৈর্য ধরবে", "fa": "(چگونه) صبر می‌کنی"}}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تُحِطْ", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "خُبْرًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "صَبَرُوا۟", "count": 11, "first": "7:137", "audio": "audio/ef8c584e04cac0d7ce3b.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "su bili strpljivi", "en": "were patient", "tr": "sabrettiler", "fr": "furent patients", "id": "mereka bersabar", "ur": "انہوں نے صبر کیا", "bn": "তারা ধৈর্য ধরেছিল", "fa": "صبر کردند"}}, {"arabic": "فَٱصْبِرْ", "count": 11, "first": "11:49", "audio": "audio/3b817ec010400a3ed8ac.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"bs": "zato se strpi!", "en": "so be patient!", "tr": "öyleyse sabret!", "fr": "sois donc patient !", "id": "maka bersabarlah!", "ur": "پس صبر کرو!", "bn": "অতএব ধৈর্য ধরো!", "fa": "پس صبر کن!"}}, {"arabic": "وَٱصْبِرْ", "count": 7, "first": "10:109", "audio"