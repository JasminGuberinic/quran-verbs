346d8b06d4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُخْلِي", "plain": "اُخْلِي", "quran": false, "notUsed": false, "spoken": "audio/347da876653751a005ea.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُخْلُوَا", "plain": "اُخْلُوَا", "quran": false, "notUsed": false, "spoken": "audio/1c533fd8ebc9199ddb3b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُخْلُوا", "plain": "اُخْلُوا", "quran": false, "notUsed": false, "spoken": "audio/7220086283cc7d4179b5.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُخْلُونَ", "plain": "اُخْلُونَ", "quran": false, "notUsed": false, "spoken": "audio/ae2050b28d2eaedc3b9e.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "15:13", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1815.mp3", "translation": {"en": {"text": "They believe not therein, though the example of the men of old hath gone before.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kur'âna iman etmezler, halbuki öncekilerin sünneti (inanmadıkları için başlarına gelenler) gelip geçmiştir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ اس پر ایمان نہیں لاتے اور اگلوں کی راہ پڑچکی ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka tidak beriman kepadanya (Al Quran) dan sesungguhnya telah berlalu sunnatullah terhadap orang-orang dahulu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُؤْمِنُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "وَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَتْ", "hit": true, "audio": "audio/cd35e25257969e69444d.m4a", "gloss": {"bs": "prošao je", "en": "has passed", "tr": "geçti", "fr": "a disparu", "id": "telah berlalu", "ur": "گزر چکا", "bn": "গত হয়ে গেছে", "fa": "گذشته است"}}, {"text": "سُنَّةُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَوَّلِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "33:62", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3595.mp3", "translation": {"en": {"text": "That was the way of Allah in the case of those who passed away of old; thou wilt not find for the way of Allah aught of power to change.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah'ın bundan önce geçenler hakkındaki kanunu budur. Ve sen Allah'ın kanununu değiştirmeye asla çare bulamazsın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ کا دستور چلا آتا ہے ان لوگوں میں جو پہلے گزر گئے اور تم اللہ کا دستور ہرگز بدلتا نہ پاؤ گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sebagai sunnah Allah yang berlaku atas orang-orang yang telah terdahulu sebelum(mu), dan kamu sekali-kali tiada akan mendapati peubahan pada sunnah Allah.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "سُنَّةَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَوْا۟", "hit": true, "audio": "audio/ef1bfb7246d1db212a27.m4a", "gloss": {"en": "they passed away", "bs": "prošli su"}}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "قَبْلُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَجِدَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِسُنَّةِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "تَبْدِيلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "35:24", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3684.mp3", "translation": {"en": {"text": "Lo! We have sent thee with the Truth, a bearer of glad tidings and a warner; and there is not a nation but a warner hath passed among them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Muhakkak ki biz seni hak ile hem bir müjdeci, hem bir uyarıcı olarak gönderdik. Hiçbir ümmet de yoktur ki, içlerinde bir uyarıcı geçmiş olmasın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے محبوب! بیشک ہم نے تمہیں حق کے ساتھ بھیجا خوشخبری دیتا اور ڈر سنا تا اور جو کوئی گروہ تھا سب میں ایک ڈر سنانے والا گزر چکا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Kami mengutus kamu dengan membawa kebenaran sebagai pembawa berita gembira dan sebagai pemberi peringatan. Dan tidak ada suatu umatpun melainkan telah ada padanya seorang pemberi peringatan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْسَلْنَٰكَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْحَقِّ", "hit": false, "audio": null, "gloss": null}, {"text": "بَشِيرًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَذِيرًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِن", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أُمَّةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَا", "hit": true, "audio": "audio/7aef0ad0758fcbde1d8c.m4a", "gloss": {"en": "he/it passed away", "bs": "p