": "anta", "arabic": "اُقْتُلْ", "plain": "اُقْتُلْ", "quran": false, "notUsed": false, "spoken": "audio/3d136ee9735646035ebf.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُقْتُلِي", "plain": "اُقْتُلِي", "quran": false, "notUsed": false, "spoken": "audio/ab50be5f3d64da56bfc4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُقْتُلَا", "plain": "اُقْتُلَا", "quran": false, "notUsed": false, "spoken": "audio/fd2acf6e1c33972ba706.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱقْتُلُوٓا۟", "plain": "اُقْتُلُوا", "quran": true, "notUsed": false, "spoken": "audio/7685d935c7e03f0367cf.m4a", "recited": "audio/380fe942bcb543cb2775.m4a", "recitedText": "ٱقْتُلُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُقْتُلْنَ", "plain": "اُقْتُلْنَ", "quran": false, "notUsed": false, "spoken": "audio/cf97f58f6603d40fccf6.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "26:14", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2946.mp3", "translation": {"en": {"text": "And they have a crime against me, so I fear that they will kill me.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Hem onların bana isnad ettikleri bir suç var. Ondan dolayı korkarım ki, hemen beni öldürürler.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان کا مجھ پر ایک الزام ہے تو میں ڈرتا ہو ں کہیں مجھے کر دیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan aku berdosa terhadap mereka, maka aku takut mereka akan membunuhku\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ذَنۢبٌ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَخَافُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَقْتُلُونِ", "hit": true, "audio": "audio/f405d5a0109f89ec5188.m4a", "gloss": {"bs": "ubit će me", "en": "they will kill me", "tr": "beni öldürecekler", "fr": "ils me tueront", "id": "mereka akan membunuhku", "ur": "وہ مجھے قتل کر دیں گے", "bn": "তারা আমাকে হত্যা করবে", "fa": "مرا خواهند کشت"}}]}, {"ref": "5:30", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/699.mp3", "translation": {"en": {"text": "But (the other's) mind imposed on him the killing of his brother, so he slew him and became one of the losers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine kurbanı kabul edilmeyenin nefsi kendisini, kardeşini öldürmeye teşvik etti ve onu öldürdü. Böylece zarara uğrayanlardan oldu.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اسکے نفس نے اسے بھائی کے قتل کا چاؤ دلایا تو اسے قتل کردیا تو رہ گیا نقصان میں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka hawa nafsu Qabil menjadikannya menganggap mudah membunuh saudaranya, sebab itu dibunuhnyalah, maka jadilah ia seorang diantara orang-orang yang merugi.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَطَوَّعَتْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "نَفْسُهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "قَتْلَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَقَتَلَهُۥ", "hit": true, "audio": "audio/b1da824c1699d5fbbdc6.m4a", "gloss": {"bs": "pa ga je ubio", "en": "and he killed him", "tr": "ve onu öldürdü", "fr": "et il le tua", "id": "dan dia membunuhnya", "ur": "پھر اس نے اسے قتل کر دیا", "bn": "এবং সে তাকে হত্যা করল", "fa": "و او را کشت"}}, {"text": "فَأَصْبَحَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَٰسِرِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:72", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/79.mp3", "translation": {"en": {"text": "And (remember) when ye slew a man and disagreed concerning it and Allah brought forth that which ye were hiding.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hani bir zamanlar siz bir adam öldürmüştünüz de onun hakkında birbirinizle atışmış ve onu üstünüzden atmıştınız, halbuki Allah, saklamış olduğunuzu açığa çıkaracaktı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جب تم نے ایک خون کیا تو ایک دوسرے پر اس کی تہمت ڈالنے لگے اور اللہ کو ظاہر کرنا تھا جو تم چھپاتے تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan (ingatlah), ketika kamu membunuh seorang manusia lalu kamu saling tuduh menuduh tentang itu. Dan Allah hendak menyingkapkan apa yang selama ini kamu sembunyikan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِذْ", "hit": false, "audio": null, "gloss": null}, {"text": "قَتَلْتُمْ", "hit": true, "audio": "audio/6f5ad1ff6f0e6fb45aac.m4a", "gloss": {"en": "you (all) killed", "bs": "ubili ste", "tr": "öldürdünüz", "fr": "vous avez tué", "id": "kalian telah membunuh", "ur": "تم سب نے قتل کیا", "bn": "তোমরা হত্যা করেছ", "fa": "کشتید"}}, {"text": "نَفْسًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱدَّٰرَْٰٔتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "مُخْرِجٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مَّا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَكْتُمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "28:33", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3285.mp3", "translation": {"en": {"text": "He said: My Lord! Lo! I killed a man among them and I fear that they will kill me.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa dedi ki: \"Rabbim! Ben onlardan birini öldürmüştüm, beni öldürmelerinden korkuyorum.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "عرض کی اے میرے رب! میں نے ان میں ایک جان مار ڈالی ہے تو ڈرتا ہوں کہ مجھے قتل کردیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Musa berkata: \"Ya Tuhanku sesungguhnya aku, telah membunuh seorang manusia dari golongan mereka, maka aku takut mereka akan membunuhku.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "قَتَلْتُ", "hit": true, "audio": "audio/c1c6257f3a427232290a.m4a", "gloss": {"en": "I killed", "bs": "ubio sam", "tr": "öldürdüm", "fr": "j'ai tué", "id": "aku telah membunuh", "ur": "میں نے قتل کیا", "bn": "আমি হত্যা করেছি", "fa": "کشتم"}}, {"text": "مِنْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَفْسًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَخَافُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَقْتُلُونِ", "hit": true, "audio": "audio/7f1374d3c0dea0ef675c.m4a", "gloss": {"bs": "ubit će me", "en": "they will kill me", "tr": "beni öldürecekler", "fr": "ils me tueront", "id": "mereka akan membunuhku", "ur": "وہ مجھے قتل کر دیں گے", "bn": "তারা আমাকে হত্যা করবে", "fa": "مرا خواهند کشت"}}]}], "forms": [{"arabic": "قُتِلَ", "count": 6, "first": "3:144", "audio": "audio/c5055af683d8c3152ce5.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "he/it was killed", "bs": "ubijen je", "tr": "öldürüldü", "fr": "il a été tué", "id": "dia telah dibunuh", "ur": "قتل کیا گیا", "bn": "তাকে হত্যা করা হয়েছে", "fa": "کشته شد"}}, {"arabic": "وَيَقْتُلُونَ", "count": 4, "first": "2:61", "audio": "audio/51d883165bbeb800c2f4.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and they kill", "bs": "i ubijaju", "tr": "ve öldürürler", "fr": "et ils tuent", "id": "dan mereka membunuh", "ur": "اور وہ قتل کرتے ہیں", "bn": "এবং তারা হত্যা করে", "fa": "و می‌کشند"}}, {"arabic": "تَقْتُلُونَ", "count": 4, "first": "2:85", "audio": "audio/11214829b382705a958e.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "you (all) kill", "bs": "ubijate", "tr": "öldürüyorsunuz", "fr": "vous tuez", "id": "kalian membunuh", "ur": "تم سب قتل کرتے ہو", "bn": "তোমরা হত্যা কর", "fa": "می‌کشید"}}, {"arabic": "قُتِلُوا۟", "count": 4, "first": "3:156", "audio": "audio/c03a164c0b46b36fe61c.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": true, "objects": []}], "gloss": {"en": "they were killed", "bs": "ubijeni su", "tr": "öldürüldüler", "fr": "ils ont été tués", "id": "mereka telah dibunuh", "ur": "وہ قتل کیے گئے", "bn": "তাদের হত্যা করা হয়েছিল", "fa": "کشته شدند"}}, {"arabic": "قَتَلَ", "count": 4, "first": "4:92", "audio": "audio/18cc6ea77fb311ac19b5.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it killed", "bs": "ubio je", "tr": "öldürdü", "fr": "il a tué", "id": "dia telah membunuh", "ur": "اُس نے قتل کیا", "bn": "সে হত্যা করেছে", "fa"