{"ayat":[{"ref":"69:1","number":5324,"text":"ٱلْحَآقَّةُ","hits":[]},{"ref":"69:2","number":5325,"text":"مَا ٱلْحَآقَّةُ","hits":[0]},{"ref":"69:3","number":5326,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","hits":[1]},{"ref":"69:4","number":5327,"text":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ","hits":[0]},{"ref":"69:5","number":5328,"text":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ","hits":[0,2]},{"ref":"69:6","number":5329,"text":"وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ","hits":[3]},{"ref":"69:7","number":5330,"text":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ","hits":[0,1,3,5,7,8,9,11,13]},{"ref":"69:8","number":5331,"text":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ","hits":[0,2,3]},{"ref":"69:9","number":5332,"text":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ","hits":[0,2]},{"ref":"69:10","number":5333,"text":"فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً","hits":[0,1,2,3]},{"ref":"69:11","number":5334,"text":"إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ","hits":[0,1,2,3,4]},{"ref":"69:12","number":5335,"text":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ","hits":[0,4]},{"ref":"69:13","number":5336,"text":"فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ","hits":[0,1]},{"ref":"69:14","number":5337,"text":"وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً","hits":[1,2]},{"ref":"69:15","number":5338,"text":"فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ","hits":[1]},{"ref":"69:16","number":5339,"text":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ","hits":[0,1,2]},{"ref":"69:17","number":5340,"text":"وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَٰنِيَةٌ","hits":[0,4]},{"ref":"69:18","number":5341,"text":"يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ","hits":[1,2,3]},{"ref":"69:19","number":5342,"text":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَٰبِيَهْ","hits":[2,3,4,5,7]},{"ref":"69:20","number":5343,"text":"إِنِّى ظَنَنتُ أَنِّى مُلَٰقٍ حِسَابِيَهْ","hits":[1,2,4]},{"ref":"69:21","number":5344,"text":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","hits":[0]},{"ref":"69:22","number":5345,"text":"فِى جَنَّةٍ عَالِيَةٍ","hits":[1]},{"ref":"69:23","number":5346,"text":"قُطُوفُهَا دَانِيَةٌ","hits":[]},{"ref":"69:24","number":5347,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ","hits":[0,1]},{"ref":"69:25","number":5348,"text":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ","hits":[6,7]},{"ref":"69:26","number":5349,"text":"وَلَمْ أَدْرِ مَا حِسَابِيَهْ","hits":[1]},{"ref":"69:27","number":5350,"text":"يَٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ","hits":[1]},{"ref":"69:28","number":5351,"text":"مَآ أَغْنَىٰ عَنِّى مَالِيَهْ","hits":[1,2,3]},{"ref":"69:29","number":5352,"text":"هَلَكَ عَنِّى سُلْطَٰنِيَهْ","hits":[0,2]},{"ref":"69:30","number":5353,"text":"خُذُوهُ فَغُلُّوهُ","hits":[1]},{"ref":"69:31","number":5354,"text":"ثُمَّ ٱلْجَحِيمَ صَلُّوهُ","hits":[0]},{"ref":"69:32","number":5355,"text":"ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ","hits":[5,6]},{"ref":"69:33","number":5356,"text":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ","hits":[3,5]},{"ref":"69:34","number":5357,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","hits":[3,4]},{"ref":"69:35","number":5358,"text":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌ","hits":[0]},{"ref":"69:36","number":5359,"text":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ","hits":[2]},{"ref":"69:37","number":5360,"text":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ","hits":[]},{"ref":"69:38","number":5361,"text":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ","hits":[1,3]},{"ref":"69:39","number":5362,"text":"وَمَا لَا تُبْصِرُونَ","hits":[]},{"ref":"69:40","number":5363,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","hits":[1,3]},{"ref":"69:41","number":5364,"text":"وَمَا هُوَ بِقَوْلِ شَاعِرٍ قَلِيلًا مَّا تُؤْمِنُونَ","hits":[3,4]},{"ref":"69:42","number":5365,"text":"وَلَا بِقَوْلِ كَاهِنٍ قَلِيلًا مَّا تَذَكَّرُونَ","hits":[5]},{"ref":"69:43","number":5366,"text":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ","hits":[3]},{"ref":"69:44","number":5367,"text":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ","hits":[0]},{"ref":"69:45","number":5368,"text":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ","hits":[]},{"ref":"69:46","number":5369,"text":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ","hits":[1]},{"ref":"69:47","number":5370,"text":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ","hits":[5]},{"ref":"69:48","number":5371,"text":"وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ","hits":[2]},{"ref":"69:49","number":5372,"text":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","hits":[1,4]},{"ref":"69:50","number":5373,"text":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ","hits":[1,3]},{"ref":"69:51","number":5374,"text":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ","hits":[1,2]},{"ref":"69:52","number":5375,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","hits":[0,1]}]}