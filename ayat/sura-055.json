{"ayat":[{"ref":"55:1","number":4902,"text":"ٱلرَّحْمَٰنُ","hits":[]},{"ref":"55:2","number":4903,"text":"عَلَّمَ ٱلْقُرْءَانَ","hits":[0]},{"ref":"55:3","number":4904,"text":"خَلَقَ ٱلْإِنسَٰنَ","hits":[0,1]},{"ref":"55:4","number":4905,"text":"عَلَّمَهُ ٱلْبَيَانَ","hits":[1]},{"ref":"55:5","number":4906,"text":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ","hits":[0,1,2]},{"ref":"55:6","number":4907,"text":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ","hits":[0,1,2]},{"ref":"55:7","number":4908,"text":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ","hits":[0,1,2,3]},{"ref":"55:8","number":4909,"text":"أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ","hits":[0,1,2]},{"ref":"55:9","number":4910,"text":"وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ","hits":[0,1,2,3]},{"ref":"55:10","number":4911,"text":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ","hits":[0]},{"ref":"55:11","number":4912,"text":"فِيهَا فَٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ","hits":[1,2]},{"ref":"55:12","number":4913,"text":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ","hits":[0]},{"ref":"55:13","number":4914,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[2,3]},{"ref":"55:14","number":4915,"text":"خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍ كَٱلْفَخَّارِ","hits":[2,3]},{"ref":"55:15","number":4916,"text":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ","hits":[5]},{"ref":"55:16","number":4917,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:17","number":4918,"text":"رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ","hits":[1]},{"ref":"55:18","number":4919,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:19","number":4920,"text":"مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ","hits":[1,2]},{"ref":"55:20","number":4921,"text":"بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ","hits":[1,3]},{"ref":"55:21","number":4922,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:22","number":4923,"text":"يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ","hits":[0,2]},{"ref":"55:23","number":4924,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:24","number":4925,"text":"وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ","hits":[0]},{"ref":"55:25","number":4926,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:26","number":4927,"text":"كُلُّ مَنْ عَلَيْهَا فَانٍ","hits":[1,2]},{"ref":"55:27","number":4928,"text":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ","hits":[1,5]},{"ref":"55:28","number":4929,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:29","number":4930,"text":"يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ","hits":[0,6,7,9]},{"ref":"55:30","number":4931,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:31","number":4932,"text":"سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ","hits":[1,3]},{"ref":"55:32","number":4933,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:33","number":4934,"text":"يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٍ","hits":[2,3,4,14,15]},{"ref":"55:34","number":4935,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:35","number":4936,"text":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ","hits":[0,7]},{"ref":"55:36","number":4937,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:37","number":4938,"text":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ","hits":[0,1,3]},{"ref":"55:38","number":4939,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:39","number":4940,"text":"فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ","hits":[3,4]},{"ref":"55:40","number":4941,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:41","number":4942,"text":"يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ","hits":[0,1,3,5]},{"ref":"55:42","number":4943,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:43","number":4944,"text":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ","hits":[0,2,4]},{"ref":"55:44","number":4945,"text":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ","hits":[0]},{"ref":"55:45","number":4946,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:46","number":4947,"text":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ","hits":[1,2,4]},{"ref":"55:47","number":4948,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:48","number":4949,"text":"ذَوَاتَآ أَفْنَانٍ","hits":[]},{"ref":"55:49","number":4950,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:50","number":4951,"text":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ","hits":[1,2]},{"ref":"55:51","number":4952,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:52","number":4953,"text":"فِيهِمَا مِن كُلِّ فَٰكِهَةٍ زَوْجَانِ","hits":[4]},{"ref":"55:53","number":4954,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:54","number":4955,"text":"مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍ","hits":[2]},{"ref":"55:55","number":4956,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:56","number":4957,"text":"فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ","hits":[3]},{"ref":"55:57","number":4958,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:58","number":4959,"text":"كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ","hits":[0]},{"ref":"55:59","number":4960,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:60","number":4961,"text":"هَلْ جَزَآءُ ٱلْإِحْسَٰنِ إِلَّا ٱلْإِحْسَٰنُ","hits":[0,1,2]},{"ref":"55:61","number":4962,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:62","number":4963,"text":"وَمِن دُونِهِمَا جَنَّتَانِ","hits":[]},{"ref":"55:63","number":4964,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:64","number":4965,"text":"مُدْهَآمَّتَانِ","hits":[]},{"ref":"55:65","number":4966,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:66","number":4967,"text":"فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ","hits":[]},{"ref":"55:67","number":4968,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:68","number":4969,"text":"فِيهِمَا فَٰكِهَةٌ وَنَخْلٌ وَرُمَّانٌ","hits":[3]},{"ref":"55:69","number":4970,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:70","number":4971,"text":"فِيهِنَّ خَيْرَٰتٌ حِسَانٌ","hits":[1,2]},{"ref":"55:71","number":4972,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:72","number":4973,"text":"حُورٌ مَّقْصُورَٰتٌ فِى ٱلْخِيَامِ","hits":[]},{"ref":"55:73","number":4974,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:74","number":4975,"text":"لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ","hits":[]},{"ref":"55:75","number":4976,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:76","number":4977,"text":"مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِىٍّ حِسَانٍ","hits":[]},{"ref":"55:77","number":4978,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","hits":[]},{"ref":"55:78","number":4979,"text":"تَبَٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَٰلِ وَٱلْإِكْرَامِ","hits":[0,1]}]}