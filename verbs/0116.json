{"rank": 116, "root": "نسي", "form": 1, "lemma": "نَسِيَ", "count": 35, "ayahCount": 30, "share": 0.18, "meaning": {"bs": "zaboraviti", "en": "to forget", "tr": "unutmak", "fr": "oublier", "id": "lupa", "ur": "بھولنا", "bn": "ভুলে যাওয়া", "fa": "فراموش کردن"}, "lemmaSpoken": "audio/0730c3a136f98dfad18c.m4a", "animation": "<svg class=\"va va-nasiya_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes nasiya_1-o{from{opacity:1}}@keyframes nasiya_1-a{from,40%{transform:rotate(0)}}@keyframes nasiya_1-q{from,70%{opacity:0}}.va-nasiya_1 .ti{opacity:0;animation:nasiya_1-o 1.6s ease-in .2s both}.va-nasiya_1 .tc{stroke-dasharray:3 3}.va-nasiya_1 .ra{transform:rotate(-165deg);animation:nasiya_1-a 2.2s ease-out both}.va-nasiya_1 .qm{animation:nasiya_1-q 2.4s step-end both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-nasiya_1.off,.va-nasiya_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-nasiya_1,.va-nasiya_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><circle class=\"q t1\" cx=\"44\" cy=\"12\" r=\"1.3\"/><circle class=\"q t2\" cx=\"49\" cy=\"8\" r=\"1.9\"/><ellipse class=\"p tc\" cx=\"66\" cy=\"10\" rx=\"14\" ry=\"8.5\"/><rect class=\"q ti\" x=\"62\" y=\"6\" width=\"8\" height=\"8\" rx=\"1.5\"/><g class=\"qm\"><path class=\"p\" d=\"M62 6q0-4 4-4t4 4q0 3-4 4v2\"/><circle class=\"q\" cx=\"66\" cy=\"15\" r=\"1.3\"/></g><g transform=\"translate(36 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "نَسِىَ", "plain": "نَسِيَ", "quran": true, "notUsed": false, "spoken": "audio/0730c3a136f98dfad18c.m4a", "recited": "audio/a1817cc4040181e80f3c.m4a", "recitedText": "نَسِىَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَنسَى", "plain": "يَنْسَى", "quran": true, "notUsed": false, "spoken": "audio/c0a587a54953c2e92e94.m4a", "recited": "audio/b99eb225d97f326d2e53.m4a", "recitedText": "يَنسَى"}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "نَسِيتُ", "plain": "نَسِيتُ", "quran": true, "notUsed": false, "spoken": "audio/69cba8db51ac57903547.m4a", "recited": "audio/35f4bdc4fcbff5fc3b37.m4a", "recitedText": "نَسِيتُ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "نَّسِينَآ", "plain": "نَسِينَا", "quran": true, "notUsed": false, "spoken": "audio/a8b4c9027e83d058011d.m4a", "recited": "audio/a8c585edcc498f2c90de.m4a", "recitedText": "نَّسِينَآ"}, {"tense": "past", "pronoun": "anta", "arabic": "نَسِيتَ", "plain": "نَسِيتَ", "quran": true, "notUsed": false, "spoken": "audio/82fc6bfc9607e8f9748e.m4a", "recited": "audio/e619aab0028269ba2ebf.m4a", "recitedText": "نَسِيتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "نَسِيتِ", "plain": "نَسِيتِ", "quran": false, "notUsed": false, "spoken": "audio/1d746469833a9bc2ab26.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "نَسِيتُمَا", "plain": "نَسِيتُمَا", "quran": false, "notUsed": false, "spoken": "audio/dbe7547ef4cc3018b701.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "نَسِيتُمْ", "plain": "نَسِيتُمْ", "quran": true, "notUsed": false, "spoken": "audio/0b56daefecfed96eff09.m4a", "recited": "audio/cd9c2e8a8269d4a44d72.m4a", "recitedText": "نَسِيتُمْ"}, {"tense": "past", "pronoun": "antunna", "arabic": "نَسِيتُنَّ", "plain": "نَسِيتُنَّ", "quran": false, "notUsed": false, "spoken": "audio/032aa0bfad51f44007f2.m4a", "r