{"rank": 130, "root": "صبح", "form": 4, "lemma": "أَصْبَحَ", "count": 28, "ayahCount": 28, "share": 0.14, "meaning": {"bs": "postati, osvanuti", "en": "to become, to be in the morning", "tr": "olmak, sabaha ermek", "fr": "devenir, être au matin", "id": "menjadi, berada di waktu pagi", "ur": "ہو جانا، صبح کرنا", "bn": "হয়ে যাওয়া, সকাল করা", "fa": "شدن، صبح کردن"}, "lemmaSpoken": "audio/d9d2581cc05db9f0de29.m4a", "animation": "<svg class=\"va va-subha_4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes sh1{from{transform:translateY(18px)}}@keyframes sh2{from{opacity:0}}.va-subha_4 .sn{animation:sh1 1.6s ease-out both}.va-subha_4 .ry{animation:sh2 .6s ease-out 1.4s both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-subha_4.off,.va-subha_4.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-subha_4,.va-subha_4 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><g class=\"sn\"><path class=\"q\" d=\"M46 61a14 14 0 0 1 28 0z\"/></g><path class=\"p ry\" d=\"M60 36V30M40 44l-5-4M80 44l5-4M32 56h-6M88 56h6\"/></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَصْبَحَ", "plain": "أَصْبَحَ", "quran": true, "notUsed": false, "spoken": "audio/d9d2581cc05db9f0de29.m4a", "recited": "audio/1757e7aaff2bde6b2a3c.m4a", "recitedText": "أَصْبَحَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُصْبِحُ", "plain": "يُصْبِحُ", "quran": false, "notUsed": false, "spoken": "audio/5de01b23fffaeb984902.m4a", "recited": null, "recitedText": null}], "nouns": {"verbal_noun": {"lemma": "إِصْباح", "count": 1, "spoken": "audio/e5ac62c6a045e0ab3509.m4a"}, "participle": {"lemma": "مُصْبِح", "count": 5, "spoken": "audio/086665c739389f364652.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَصْبَحْتُ", "plain": "أَصْبَحْتُ", "quran": fal