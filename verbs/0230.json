 {"bs": "djed", "en": "the grandfather", "bn": "দাদা", "fa": "پدربزرگ", "fr": "le grand-père", "id": "kakek", "tr": "dede", "ur": "دادا"}}, {"arabic": "أَحْفَادَهُ", "target": false, "translation": {"bs": "svoje unuke", "en": "his grandchildren", "bn": "তার নাতিদের", "fa": "نوه‌هایش", "fr": "ses petits-enfants", "id": "cucu-cucunya", "tr": "torunlarına", "ur": "اپنے پوتوں"}}]}, {"arabic": "أَعِظُ أَوْلَادِي بِلُطْفٍ", "spoken": "audio/4f4b8bf02ef99dd6f2f7.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Svoju djecu savjetujem blago.", "en": "I admonish my children gently.", "bn": "আমি আমার সন্তানদের কোমলভাবে উপদেশ দিই।", "fa": "فرزندانم را با ملایمت پند می‌دهم.", "fr": "J'exhorte mes enfants avec douceur.", "id": "Aku menasihati anak-anakku dengan lembut.", "tr": "Çocuklarıma yumuşak bir dille öğüt veririm.", "ur": "میں اپنے بچوں کو نرمی سے نصیحت کرتا ہوں۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَعِظُ", "target": true, "translation": {"bs": "savjetujem", "en": "I admonish", "bn": "আমি উপদেশ দিই", "fa": "پند می‌دهم", "fr": "j'exhorte", "id": "aku menasihati", "tr": "öğüt veririm", "ur": "میں نصیحت کرتا ہوں"}}, {"arabic": "أَوْلَادِي", "target": false, "translation": {"bs": "svoju djecu", "en": "my children", "bn": "আমার সন্তানদের", "fa": "فرزندانم", "fr": "mes enfants", "id": "anak-anakku", "tr": "çocuklarıma", "ur": "میرے بچے"}}, {"arabic": "بِلُطْفٍ", "target": false, "translation": {"bs": "blago", "en": "with gentleness", "bn": "কোমলতার সাথে", "fa": "با ملایمت", "fr": "avec douceur", "id": "dengan lembut", "tr": "yumuşaklıkla", "ur": "نرمی سے"}}]}, {"arabic": "وَعَظُوا أَصْدِقَاءَهُمْ", "spoken": "audio/1243223055c646daf312.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Savjetovali su svoje prijatelje.", "en": "They admonished their friends.", "bn": "তারা তাদের বন্ধুদের উপদেশ দিল।", "fa": "دوستانشان را پند دادند.", "fr": "Ils ont exhorté leurs amis.", "id": "Mereka menasihati teman-teman mereka.", "tr": "Arkadaşl