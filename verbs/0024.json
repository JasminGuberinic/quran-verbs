 الایمان · tanzil.net"}, "id": {"text": "Maka bersujudlah kepada Allah dan sembahlah (Dia).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱسْجُدُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لِلَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱعْبُدُوا۟", "hit": true, "audio": "audio/3b9c79ff016c669497a8.m4a", "gloss": {"bs": "i obožavajte", "en": "and worship", "tr": "ve kulluk edin", "fr": "et adorez", "id": "dan sembahlah", "ur": "اور بندگی کرو", "bn": "এবং ইবাদত কর", "fa": "و عبادت کنید"}}]}, {"ref": "37:161", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3949.mp3", "translation": {"en": {"text": "Lo! verily, ye and that which ye worship,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Çünkü siz ve taptıklarınız, kendiliğinden cehenneme saldıran kimseden başkasını, Allah'a karşı kandırıp, saptıramazsınız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو تم اور جو کچھ تم اللہ کے سوا پوجتے ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka sesungguhnya kamu dan apa-apa yang kamu sembah itu,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَإِنَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْبُدُونَ", "hit": true, "audio": "audio/b5e719bb18e19489eaf7.m4a", "gloss": {"bs": "obožavate", "en": "you worship", "tr": "taptıklarınız", "fr": "vous adorez", "id": "kamu sembah", "ur": "تم پوجتے ہو", "bn": "তোমরা ইবাদত কর", "fa": "می‌پرستید"}}]}, {"ref": "106:3", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6196.mp3", "translation": {"en": {"text": "So let them worship the Lord of this House,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bu Beyt (Kâbe)nin Rabbine kulluk etsinler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو انہیں چاہیے اس گھر کے رب کی بندگی کریں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka hendaklah mereka menyembah Tuhan Pemilik rumah ini (Ka'bah).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلْيَعْبُدُوا۟", "hit": true, "audio": "audio/f14ac097c78b082c94f5.m4a", "gloss": {"en": "so let them worship", "bs": "pa neka obožavaju", "tr": "böylece ibadet etsinler", "fr": "qu'ils adorent alors", "id": "maka biarlah mereka menyembah", "ur": "پس وہ عبادت کریں", "bn": "অতএব তারা ইবাদত করুক", "fa": "پس بپرستند"}}, {"text": "رَبَّ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبَيْتِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "109:2", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6209.mp3", "translation": {"en": {"text": "I worship not that which ye worship;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sizin taptıklarınıza ben tapmam.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "نہ میں پوجتا ہوں جو تم پوجتے ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Aku tidak akan menyembah apa yang kamu sembah.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْبُدُ", "hit": true, "audio": "audio/a32608f9d28e3cd07fe9.m4a", "gloss": {"en": "I worship", "bs": "obožavam", "tr": "ibadet ederim", "fr": "j'adore", "id": "aku menyembah", "ur": "میں عبادت کرتا ہوں", "bn": "আমি ইবাদত করি", "fa": "می‌پرستم"}}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْبُدُونَ", "hit": true, "audio": "audio/9d6c0c60e0a47ab9c545.m4a", "gloss": {"bs": "obožavate", "en": "you worship", "tr": "taptıklarınız", "fr": "vous adorez", "id": "kamu sembah", "ur": "تم پوجتے ہو", "bn": "তোমরা ইবাদত কর", "fa": "می‌پرستید"}}]}, {"ref": "1:5", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5.mp3", "translation": {"en": {"text": "Thee (alone) we worship; Thee (alone) we ask for help.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ancak sana ederiz kulluğu, ibadeti ve ancak senden dileriz yardımı, inayeti. (Ya Rab!).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہم تجھی کو پوجیں اور تجھی سے مدد چاہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hanya Engkaulah yang kami sembah, dan hanya kepada Engkaulah kami meminta pertolongan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِيَّاكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَعْبُدُ", "hit": true, "audio": "audio/003626ae799c539d5d7e.m4a", "gloss": {"en": "we worship", "bs": "obožavamo", "tr": "ibadet ederiz", "fr": "nous adorons", "id": "kami menyembah", "ur": "ہم عبادت کرتے ہیں", "bn": "আমরা ইবাদত করি", "fa": "می‌پرستیم"}}, {"text": "وَإِيَّاكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَسْتَعِينُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "109:4", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6211.mp3", "translation": {"en": {"text": "And I shall not worship that which ye worship.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ben asla sizin taptıklarınıza tapacak değilim.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور نہ میں پوجوں گا جو تم نے پوجا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan aku tidak pernah menjadi penyembah apa yang kamu sembah,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَا۠", "hit": false, "audio": null, "gloss": null}, {"text": "عَابِدٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مَّا", "hit": false, "audio": null, "gloss": null}, {"text": "عَبَدتُّمْ", "hit": true, "audio": "audio/20a39d8de2f416e455f0.m4a", "gloss": {"bs": "obožavali ste", "en": "you worshipped", "tr": "taptığınız", "fr": "vous avez adoré", "id": "kamu sembah", "ur": "تم نے پوجا", "bn": "তোমরা ইবাদত করেছ", "fa": "پرستیدید"}}]}], "forms": [{"arabic": "تَعْبُدُونَ", "count": 20, "first": "2:83", "audio": "audio/b5e719bb18e19489eaf7.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "obožavate", "en": "you worship", "tr": "taptıklarınız", "fr": "vous adorez", "id": "kamu sembah", "ur": "تم پوجتے ہو", "bn": "তোমরা ইবাদত কর", "fa": "می‌پرستید"}}, {"arabic": "ٱعْبُدُوا۟", "count": 17, "first": "2:21", "audio": "audio/ebf30b3806a5627372e8.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "(you all) worship!", "bs": "obožavajte!", "tr": "ibadet edin!", "fr": "adorez !", "id": "sembahlah!", "ur": "تم سب عبادت کرو!", "bn": "তোমরা ইবাদত করো!", "fa": "بپرستید!"}}, {"arabic": "يَعْبُدُ", "count": 8, "first": "7:70", "audio": "audio/2f1beb9c06c6c0ebfed8.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it worships", "bs": "obožava", "tr": "ibadet eder", "fr": "il adore", "id": "dia menyembah", "ur": "وہ عبادت کرتا ہے", "bn": "সে ইবাদত করে", "fa": "می‌پرستد"}}, {"arabic": "أَعْبُدُ", "count": 8, "first": "10:104", "audio": "audio/4c053cf00ce1094b1aed.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "glos