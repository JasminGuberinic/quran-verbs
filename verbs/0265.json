tuma", "arabic": "اِصْطَفِيَا", "plain": "اِصْطَفِيَا", "quran": false, "notUsed": false, "spoken": "audio/45d3b45ae7e89923d49e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِصْطَفُوا", "plain": "اِصْطَفُوا", "quran": false, "notUsed": false, "spoken": "audio/f78664ae16df5f10aa81.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِصْطَفِينَ", "plain": "اِصْطَفِينَ", "quran": false, "notUsed": false, "spoken": "audio/5e697c3dc89ece3897d2.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "37:153", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3941.mp3", "translation": {"en": {"text": "(And again of their falsehood): He hath preferred daughters to sons.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Allah) kızları oğullara tercih mi etmiş?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا اس نے بیٹیاں پسند کیں بیٹے چھوڑ کر،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apakah Tuhan memilih (mengutamakan) anak-anak perempuan daripada anak laki-laki?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَصْطَفَى", "hit": true, "audio": "audio/a14285dd85a927b92903.m4a", "gloss": {"bs": "zar je odabrao", "en": "has He chosen", "tr": "seçti mi", "fr": "a-t-Il choisi", "id": "apakah Dia telah memilih", "ur": "کیا اس نے چن لیا", "bn": "তিনি কি মনোনীত করেছেন", "fa": "آیا برگزیده است"}}, {"text": "ٱلْبَنَاتِ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبَنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "22:75", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2670.mp3", "translation": {"en": {"text": "Allah chooseth from the angels messengers, and (also) from mankind. Lo! Allah is Hearer, Seer.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah hem meleklerden, hem de insanlardan elçiler seçer. Şüphesiz Allah her şeyi işitir, her şeyi görür.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ چن لیتا ہے فرشتوں میں سے رسول اور آدمیوں میں سے بیشک اللہ سنتا دیکھتا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah memilih utusan-utusan-(Nya) dari malaikat dan dari manusia; sesungguhnya Allah Maha Mendengar lagi Maha Melihat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَصْطَفِى", "hit": true, "audio": "audio/9ef9542913391b8fbf1d.m4a", "gloss": {"bs": "bira", "en": "chooses", "tr": "seçer", "fr": "choisit", "id": "memilih", "ur": "وہ چن لیتا ہے", "bn": "মনোনীত করেন", "fa": "برمی‌گزیند"}}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَلَٰٓئِكَةِ", "hit": false, "audio": null, "gloss": null}, {"text": "رُسُلًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَمِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلنَّاسِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَمِيعٌۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بَصِيرٌ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ٱصْطَفَىٰٓ", "count": 2, "first": "3:33", "audio": "audio/c9dbcaa159cd41ac8295.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it chose", "bs": "odabrao je", "tr": "seçti", "fr": "il a choisi", "id": "dia telah memilih", "ur": "اُس نے چنا", "bn": "সে মনোনীত করল", "fa": "برگزید"}}, {"arabic": "ٱصْطَفَيْنَٰهُ", "count": 1, "