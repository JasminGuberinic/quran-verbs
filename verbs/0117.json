ext": "تو جو ان دو کے سوا کچھ اور چاہے وہی حد سے بڑھنے والے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Barangsiapa mencari yang di balik itu maka mereka itulah orang-orang yang melampaui batas.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَمَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱبْتَغَىٰ", "hit": true, "audio": "audio/e6d18b5aec8ebfef759f.m4a", "gloss": {"bs": "traži", "en": "seeks", "tr": "arar", "fr": "cherche", "id": "mencari", "ur": "وہ چاہتا ہے", "bn": "সে চায়", "fa": "می‌جوید"}}, {"text": "وَرَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "ذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَادُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَبْتَغُونَ", "count": 6, "first": "5:2", "audio": "audio/d3b79ac07981d260f899.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they seek", "bs": "traže", "tr": "ararlar", "fr": "ils cherchent", "id": "mereka mencari", "ur": "وہ تلاش کرتے ہیں", "bn": "তারা খোঁজে", "fa": "می‌جویند"}}, {"arabic": "وَلِتَبْتَغُوا۟", "count": 4, "first": "16:14", "audio": "audio/dce0eb31377677e8b1e0.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "and so that you (all) may seek", "bs": "i da tražite", "tr": "ve arasanız diye", "fr": "et que vous cherchiez", "id": "dan agar kalian mencari", "ur": "اور تاکہ تم تلاش کرو", "bn": "এবং যাতে তোমরা খোঁজ", "fa": "و تا بجویید"}}, {"arabic": "وَٱبْتَغُوا۟", "count": 2, "first": "2:187", "audio": "audio/1f3765d5cacda5c49ca3.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) seek!", "bs": "i tražite!