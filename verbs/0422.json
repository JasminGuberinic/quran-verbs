, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "عَاقِبِي", "plain": "عَاقِبِي", "quran": false, "notUsed": false, "spoken": "audio/1f108fba6918b1524d8c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "عَاقِبَا", "plain": "عَاقِبَا", "quran": false, "notUsed": false, "spoken": "audio/0c304c55a8fe9ac3129c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "عَاقِبُوا۟", "plain": "عَاقِبُوا", "quran": true, "notUsed": false, "spoken": "audio/992f2d6faa5231d1c34a.m4a", "recited": "audio/2edbb8a887366defd57d.m4a", "recitedText": "فَعَاقِبُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "عَاقِبْنَ", "plain": "عَاقِبْنَ", "quran": false, "notUsed": false, "spoken": "audio/c5ae9da24818b1dcaf5f.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "16:126", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2027.mp3", "translation": {"en": {"text": "If ye punish, then punish with the like of that wherewith ye were afflicted. But if ye endure patiently, verily it is better for the patient.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer (bir suçtan dolayı) ceza verecek olursanız size yapılan azab ve cezanın misli ile ceza verin. Ama sabrederseniz, elbette o, sabredenler için daha hayırlıdır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر تم سزا دو تو ایسی ہی سزا دو جیسی تمہیں تکلیف پہونچائی تھی اور اگر تم صبر کرو تو بیشک صبر والوں کو صبر سب سے اچھا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan jika kamu memberikan balasan, maka balaslah dengan balasan yang sama dengan siksaan yang ditimpakan kepadamu. Akan tetapi jika kamu bersabar, sesungguhnya itulah yang lebih baik bagi orang-orang yang sabar.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَاقَبْتُمْ", "hit": true, "audio": "audio/6686a30943c07dabb4db.m4a", "gloss": {"bs": "kaznite", "en": "you (all) punish", "tr": "cezalandırırsınız", "fr": "vous punissez", "id": "kalian menghukum", "ur": "تم (سب نے) سزا دی", "bn": "তোমরা (সবাই) শাস্তি দিয়েছ", "fa": "شما (همگی) مجازات کردید"}}, {"text": "فَعَاقِبُوا۟", "hit": true, "audio": "audio/2edbb8a887366defd57d.m4a", "gloss": {"bs": "onda kaznite (svi)", "en": "then punish (all of you)", "tr": "o halde cezalandırın (hepiniz)", "fr": "alors punissez (vous tous)", "id": "maka hukumlah (kalian semua)", "ur": "پھر (تم سب) سزا دو", "bn": "তাহলে তোমরা (সবাই) শাস্তি দাও", "fa": "پس (همگی) مجازات کنید"}}, {"text": "بِمِثْلِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "عُوقِبْتُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَئِن", "hit": false, "audio": null, "gloss": null}, {"text": "صَبَرْتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "خَيْرٌ", "hit": false, "audio": null, "gloss": null}, {"text": "لِّلصَّٰبِرِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "عَاقَبْتُمْ", "count": 1, "first": "16:126", "audio": "audio/6686a30943c07dabb4db.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"bs": "kaznite", "en": "you (all) punish", "tr": "cezalandırırsınız", "fr": "vous punissez", "id": "kalian menghukum", "ur": "تم (سب نے) سزا دی", "bn": "তোমরা (সবাই) শাস্তি দিয়েছ", "fa": "شما (همگی) مجازات کردید"}}, {"arabic": "فَعَاقِبُوا۟", "count": 1, "first": "16:126", "audio": "audio/2edbb8a887366defd57d.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"bs": "onda kaznite (svi)", "en": "then punish (all of you)", "tr": "o halde cezalandırın (hepiniz)", "fr": "alors punissez (vous tous)", "id": "maka hukumlah (kalian semua)", "ur": "پھر (تم سب) سزا دو", "bn": "তাহলে তোমরা (সবাই) শাস্তি দাও", "fa": "پس (همگی) مجازات کنید"}}, {"arabic": "عُوقِبْتُم", "count": 1, "first": "16:126", "audio": "audio/a882c2ceba059c34fab6.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": true, "objects": []}], "gloss": {"en": "you (all) were punished", "bs": "kažnjeni ste", "tr": "cezalandırıldınız", "fr": "vous avez été punis", "id": "kalian telah dihukum", "ur": "تم سب کو سزا دی گئی", "bn": "তোমাদের শাস্তি দেওয়া হয়েছিল", "fa": "کیفر داده شدید"}}, {"arabic": "عَاقَبَ", "count": 1, "first": "22:60", "audio": "audio/69ec681416ad5db231e7.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it retaliated", "bs": "uzvratio je", "tr": "karşılık verdi", "fr": "il a riposté", "id": "dia telah membalas", "ur": "اُس نے بدلہ لیا", "bn": "সে প্রতিশোধ নিল", "fa": "انتقام گرفت"}}, {"arabic": "عُوقِبَ", "count": 1, "first": "22:60", "audio": "audio/b9a5f6ba82c4933d8474.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "he/it was punished", "bs": "kažnjen je", "tr": "cezalandırıldı", "fr": "il a été puni", "id": "dia telah dihukum", "ur": "اُسے سزا دی گئی", "bn": "তাকে শাস্তি দেওয়া হয়েছে", "fa": "کیفر داده شد"}}, {"arabic": "فَعَاقَبْتُمْ", "count": 1, "first": "60:11", "audio": "audio/26babd326f927abfb1a9.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so you (all) retaliated", "bs": "pa ste uzvratili", "tr": "böylece karşılık verdiniz", "fr": "alors vous avez riposté", "id": "maka kalian telah membalas", "ur": "پس تم سب نے بدلہ لیا", "bn": "অতএব তোমরা প্রতিশোধ নিয়েছ", "fa": "پس انتقام گرفتید"}}], "ayatFile": "ayat/0422.json", "ayatTranslations": {"en": "ayat/0422.en.json", "tr": "ayat/0422.tr.json", "ur": "ayat/0422.ur.json", "id": "ayat/0422.id.json"}, "sentences": [{"arabic": "عَاقَبَ الْمُعَلِّمُ الطَّالِبَ الْكَسُولَ", "spoken": "audio/6fdde475bc84bf684f07.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Učitelj je kaznio lijenog učenika.", "en": "The teacher punished the lazy student.", "bn": "শিক্ষক অলস ছাত্রকে শাস্তি দিলেন।", "fa": "معلم دانش‌آموز تنبل را مجازات کرد.", "fr": "L'enseignant a puni l'étudiant paresseux.", "id": "Guru itu menghukum pelajar yang malas.", "tr": "Öğretmen tembel öğrenciyi cezalandırdı.", "ur": "استاد نے سست طالب علم کو سزا دی۔"}, "independentlyReviewed": true, "words": [{"arabic": "عَاقَبَ", "target": true, "translation": {"bs": "kaznio je", "en": "punished", "bn": "শাস্তি দিল", "fa": "مجازات کرد", "fr": "a puni", "id": "menghukum", "tr": "cezalandırdı", "ur": "سزا دی"}}, {"arabic": "الْمُعَلِّمُ", "target": false, "translation": {"bs": "učitelj", "en": "the teacher", "bn": "শিক্ষক", "fa": "معلم", "fr": "le professeur", "id": "guru itu", "tr": "öğretmen", "ur": "استاد"}}, {"arabic": "الطَّالِبَ", "target": false, "translation": {"bs": "učenika", "en": "the student", "bn": "ছাত্রকে", "fa": "دانشجو", "fr": "l'étudiant", "id": "siswa itu", "tr": "öğrenci", "ur": "طالب علم"}}, {"arabic": "الْكَسُولَ", "target": false, "translation": {"bs": "lijenog", "en": "lazy", "bn": "অলস", "fa": "تنبل", "fr": "paresseux", "id": "pemalas itu", "tr": "tembel", "ur": "سست"}}]}, {"arabic": "عَاقِبُوا الْغَشَّاشَ بِعَدْلٍ", "spoken": "audio/b55ff39e9b8a84cce7a9.m4a", "tense": "imperative", "pronoun": "antum", "translation": {"bs": "Kaznite (svi) varalicu pravedno.", "en": "Punish the swindler with justice, (all of you).", "bn": "তোমরা (সবাই) প্রতারককে ন্যায়বিচারের সাথে শাস্তি দাও।", "fa": "شما (همگی) متقلب را با عدالت مجازات کنید.", "fr": "Punissez le tricheur avec justice, vous tous.", "id": "Hukumlah penipu itu dengan adil, wahai kalian semua.", "tr": "Hilekârı adaletle cezalandırın, hepiniz.", "ur": "تم سب دھوکے باز کو انصاف کے ساتھ سزا دو۔"}, "independentlyReviewed": true, "words": [{"arabic": "عَاقِبُوا", "target": true, "translation": {"bs": "kaznite", "en": "punish (you all)", "bn": "শাস্তি দাও (তোমরা সবাই)", "fa": "مجازات کنید (شما همگی)", "fr": "punissez (vous tous)", "id": "hukumlah (kalian semua)", "tr": "cezalandırın", "ur": "سزا دو (تم سب)"}}, {"arabic": "الْغَشَّاشَ", "target": false, "translation": {"bs": "varalicu", "en": "the swindler", "bn": "প্রতারক", "fa": "متقلب", "fr": "le tricheur", "id": "penipu itu", "tr": "hilekâr", "ur": "دھوکے باز"}}, {"arabic": "بِعَدْلٍ", "target": false, "translation": {"bs": "pravedno", "en": "with justice", "bn": "ন্যায়বিচারের সাথে", "fa": "با عدالت", "fr": "avec justice", "id": "dengan adil", "tr": "adaletle", "ur": "انصاف سے"}}]}, {"arabic": "عَاقَبْتُمُ اللِّصَّ", "spoken": "audio/127f45fdda24805f372e.m4a", "tense": "past", "pronoun": "antum", "translation": {"bs": "Kaznili ste (svi) lopova.", "en": "You (all) punished the thief.", "bn": "তোমরা (সবাই) চোরকে শাস্তি দিয়েছ।", "fa": "شما (همگی) دزد را مجازات کردید.", "fr": "Vous avez puni le voleur.", "id": "Kalian menghukum pencuri itu.", "tr": "Hırsızı cezalandırdınız.", "ur": "تم سب نے چور کو سزا دی۔"}, "independentlyReviewed": true, "words": [{"arabic": "عَاقَبْتُمُ", "target": true, "translation": {"bs": "kaznili ste", "en": "punished (you all)", "bn": "তোমরা (সবাই) শাস্তি দিয়েছ", "fa": "مجازات کردید (شما همگی)", "fr": "avez puni (vous tous)", "id": "menghukum (kalian semua)", "tr": "cezalandırdınız", "ur": "تم سب نے سزا دی"}}, {"arabic": "اللِّصَّ", "target": false, "translation": {"bs": "lopova", "en": "the thief", "bn": "চোর", "fa": "دزد", "fr": "le voleur", "id": "pencuri itu", "tr": "hırsız", "ur": "چور"}}]}]}