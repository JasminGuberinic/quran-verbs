se, "spoken": "audio/4176ac4746f4fdea6709.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِشْتَهِينَ", "plain": "اِشْتَهِينَ", "quran": false, "notUsed": false, "spoken": "audio/eafa5ea9f29c3c1e84d6.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "77:42", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5664.mp3", "translation": {"en": {"text": "And fruits such as they desire.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Canlarının çektiğinden türlü meyveler arasındadırlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور میووں میں جو ان کا جی چاہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan (mendapat) buah-buahan dari (macam-macam) yang mereka ingini.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَفَوَٰكِهَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَشْتَهُونَ", "hit": true, "audio": "audio/48849e587f31a5942713.m4a", "gloss": {"bs": "požele", "en": "they desire", "tr": "canlarının çektiği şeyi isterler", "fr": "ils désirent", "id": "mereka menginginkan", "ur": "وہ چاہتے ہیں", "bn": "তারা কামনা করে", "fa": "آرزو می‌کنند"}}]}, {"ref": "21:102", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2585.mp3", "translation": {"en": {"text": "They will not hear the slightest sound thereof, while they abide in that which their souls desire.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunlar onun (cehennemin) uğultusunu bile duymazlar. Canlarının istediği şeyler içinde temelli kalırlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ اس کی بھنک (ہلکی سی آواز بھی) نہ سنیں گے اور وہ اپنی من مانتی خواہشوں میں ہمیشہ رہیں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka tidak mendengar sedikitpun suara api neraka, dan mereka kekal dalam menikmati apa yang diingini oleh mereka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْمَعُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "حَسِيسَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱشْتَهَتْ", "hit": true, "audio": "audio/2eb43b392d5d088f254a.m4a", "gloss": {"bs": "poželjele su", "en": "it desired", "tr": "arzuladı", "fr": "elle a désiré", "id": "ia menginginkan", "ur": "اس نے چاہا", "bn": "সেটি কামনা করল", "fa": "آرزو کرد"}}, {"text": "أَنفُسُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "خَٰلِدُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَشْتَهُونَ", "count": 5, "first": "16:57", "audio": "audio/48849e587f31a5942713.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "požele", "en": "they desire", "tr": "canlarının çektiği şeyi isterler", "fr": "ils désirent", "id": "mereka menginginkan", "ur": "وہ چاہتے ہیں", "bn": "তারা কামনা করে", "fa": "آرزو می‌کنند"}}, {"arabic": "ٱشْتَهَتْ", "count": 1, "first": "21:102", "audio": "audio/2eb43b392d5d088f254a.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"bs": "poželjele su", "en": "it desired", "tr": "arzuladı", "fr": "elle a désiré", "id": "ia menginginkan", "ur": "اس نے چاہا", "bn": "সেটি কামনা করল", "fa": "آرزو کرد"}}, {"arabic": "تَشْتَهِىٓ", "count": 1, "first": "41:31", "audio": "audio/9b6fb0e5bbd87e6dc309.m4a", "grammar": [{"tense": "pres