{"ayat":[{"ref":"95:1","number":6099,"text":"وَٱلتِّينِ وَٱلزَّيْتُونِ","hits":[0,1]},{"ref":"95:2","number":6100,"text":"وَطُورِ سِينِينَ","hits":[]},{"ref":"95:3","number":6101,"text":"وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","hits":[0,1,2]},{"ref":"95:4","number":6102,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ","hits":[0,1,2,3]},{"ref":"95:5","number":6103,"text":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ","hits":[0,1]},{"ref":"95:6","number":6104,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","hits":[0,1,2,3,4,5,6]},{"ref":"95:7","number":6105,"text":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","hits":[0,1,3]},{"ref":"95:8","number":6106,"text":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ","hits":[0]}]}