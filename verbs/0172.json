udio/f7891b271aeff2cde9a7.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تَعْرِفَانِ", "plain": "تَعْرِفَانِ", "quran": false, "notUsed": false, "spoken": "audio/4a5cfd5dd5d5324df2ec.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَعْرِفُونَ", "plain": "تَعْرِفُونَ", "quran": false, "notUsed": false, "spoken": "audio/d811af2fec4e3410704f.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antunna", "arabic": "تَعْرِفْنَ", "plain": "تَعْرِفْنَ", "quran": false, "notUsed": false, "spoken": "audio/fbbb7de2a17d40267432.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَعْرِفُ", "plain": "يَعْرِفُ", "quran": false, "notUsed": false, "spoken": "audio/a25e1310a99bf5ff25c6.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hiya", "arabic": "تَعْرِفُ", "plain": "تَعْرِفُ", "quran": false, "notUsed": false, "spoken": "audio/dfd43f20e678e2c5e85b.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يَعْرِفَانِ", "plain": "يَعْرِفَانِ", "quran": false, "notUsed": false, "spoken": "audio/9f226d2bed0bd3da4994.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَعْرِفُونَ", "plain": "يَعْرِفُونَ", "quran": true, "notUsed": false, "spoken": "audio/334241fef5a05160a1fe.m4a", "recited": "audio/2b69530cfe63a95ed9ba.m4a", "recitedText": "يَعْرِفُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَعْرِفْنَ", "plain": "يَعْرِفْنَ", "quran": false, "notUsed": false, "spoken": "audio/d9a30819e35b2e118fc2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِعْرِفْ", "plain": "اِعْرِفْ", "quran": false, "notUsed": false, "spoken": "audio/49552d4f53dcb9994617.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِعْرِفِي", "plain": "اِعْرِفِي", "quran": false, "notUsed": false, "spoken": "audio/d6f4d7b174c38a5c1395.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِعْرِفَا", "plain": "اِعْرِفَا", "quran": false, "notUsed": false, "spoken": "audio/c107af6c58fcd7239b8d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِعْرِفُوا", "plain": "اِعْرِفُوا", "quran": false, "notUsed": false, "spoken": "audio/2494f6750c9153ab6ca8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِعْرِفْنَ", "plain": "اِعْرِفْنَ", "quran": false, "notUsed": false, "spoken": "audio/20b8627ef8dd064255dd.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "16:83", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1984.mp3", "translation": {"en": {"text": "They know the favour of Allah and then deny it. Most of them are ingrates.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hem Allah'ın nimetini bilirler, sonra da onu inkâr ederler. Onların çoğu kâfir kimselerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ کی نعمت پہنچانتے ہیں پھر اس سے منکر ہوتے ہیں اور ان میں اکثر کافر ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka mengetahui nikmat Allah, kemudian mereka mengingkarinya dan kebanyakan mereka adalah orang-orang yang kafir.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَعْرِفُونَ", "hit": true, "audio": "audio/043b55a1af85619c953b.m4a", "gloss": {"en": "they know", "bs": "znaju", "tr": "bilirler", "fr": "ils savent", "id": "mereka mengetahui", "ur": "وہ جانتے ہیں", "bn": "তারা জানে", "fa": "می‌دانند"}}, {"text": "نِعْمَتَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "يُنكِرُونَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَكْثَرُهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكَٰفِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "83:24", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5872.mp3", "translation": {"en": {"text": "Thou wilt know in their faces the radiance of delight.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yüzlerinde nimet ve mutluluğun sevincini görürsün.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ان کے چہروں میں چین کی تازگی پہنچانے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kamu dapat mengetahui dari wajah mereka kesenangan mereka yang penuh kenikmatan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "تَعْرِفُ", "hit": true, "audio": "audio/ed15a57fab04777ff1a2.m4a", "gloss": {"bs": "prepoznaješ", "en": "you recognize", "tr": "tanırsın", "fr": "tu reconnais", "id": "kamu mengenali", "ur": "تم پہچانتے ہو", "bn": "তুমি চিনতে পারো", "fa": "می‌شناسی"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "وُجُوهِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَضْرَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلنَّعِيمِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:58", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1654.mp3", "translation": {"en": {"text": "And Joseph's brethren came and presented themselves before him, and he knew them but they knew him not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Bir gün) Yusuf'un kardeşleri çıkageldiler ve onun yanına girdiler. O, onları görür görmez tanıdı, oysa onlar onu tanıyamamışlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یوسف کے بھائی آئے تو اس کے پاس حاضر ہوئے تو یوسف نے انہیں پہچان لیا اور وہ اس سے انجان رہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan saudara-saudara Yusuf datang (ke Mesir} lalu mereka masuk ke (tempat)nya. Maka Yusuf mengenal mereka, sedang mereka tidak kenal (lagi) kepadanya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَجَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِخْوَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "يُوسُفَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَدَخَلُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَعَرَفَهُمْ", "hit": true, "audio": "audio/46c72a518ad9cf181450.m4a", "gloss": {"bs": "i prepoznao ih je", "en": "and he recognized them", "tr": "ve onları tanıdı", "fr": "et il les reconnut", "id": "dan dia mengenali mereka", "ur": "پھر اس نے انہیں پہچان لیا", "bn": "এবং সে তাদের চিনল", "fa": "پس آنان را شناخت"}}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "مُنكِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "27:93", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3252.mp3", "translation": {"en": {"text": "And say: Praise be to Allah Who will show you His portents so that ye shall know them. And thy Lord is not unaware of what ye (mortals) do.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve şöyle de: Hamd, Allah'a mahsustur. O, âyetlerini size gösterecek, siz de onları görüp tanıyacaksınız. Rabbin, yaptıklarınızdan habersiz değildir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور فرماؤ کہ سب خوبیاں اللہ کے لیے عنقریب وہ تمہیں اپنی نشانیاں دکھائے گا تو انہیں پہچان لو گے اور اے محبوب! تمہارا رب غافل نہیں، اے لوگو! تمہارے اعمال سے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan katakanlah: \"Segala puji bagi Allah, Dia akan memperlihatkan kepadamu tanda-tanda kebesaran-Nya, maka kamu akan mengetahuinya. Dan Tuhanmu tiada lalai dari apa yang kamu kerjakan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقُلِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَمْدُ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "سَيُرِيكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَعْرِفُونَهَا", "hit": true, "audio": "audio/945df6b31a9baf421d7e.m4a", "gloss": {"en": "so you (all) know them", "bs": "pa ih znate", "tr": "böylece onları bilirsiniz", "fr": "alors vous les connaissez", "id": "maka kalian mengetahui mereka", "ur": "پس تم سب انہیں جانتے ہو", "bn": "অতএব তোমরা তাদের জানো", "fa": "پس آنان را می‌دانید"}}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِغَٰفِلٍ", "hit": false, "audio": null, "gloss": null}, {"text": "عَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْمَلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "47:30", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4575.mp3", "translation": {"en": {"text": "And if We would, We could show them unto thee (Muhammad) so that thou shouldst know them surely by their marks. And thou shalt know them by the burden of their talk. And Allah knoweth your deeds.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey Muhammed! Eğer biz dileseydik onları sana gösterirdik. Sen de onları yüzlerinden tanırdın. Andolsun ki, sen onları sözlerinin üslubundan da tanırsın. Allah ise bütün yaptıklarınızı bilir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر ہم چاہیں تو تمہیں ان کو دکھادیں کہ تم ان کی صورت سے پہچان لو اور ضرور تم انہیں بات کے اسلوب میں پہچان لو گے اور اللہ تمہارے عمل جانتا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan kalau Kami kehendaki, niscaya Kami tunjukkan mereka kepadamu sehingga kamu benar-benar dapat mengenal mereka dengan tanda-tandanya. Dan kamu benar-benar akan mengenal mereka dari kiasan-kiasan perkataan mereka dan Allah mengetahui perbuatan-perbuatan kamu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَشَآءُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَأَرَيْنَٰكَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلَعَرَفْتَهُم", "hit": true, "audio": "audio/81ebc50a06b927e31f82.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "anta", "passive": false, "objects": ["hum"]}]}, {"text": "بِسِيمَٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَتَعْرِفَنَّهُمْ", "hit": true, "audio": "audio/140e42dea9a7aaedd45c.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": ["hum"], "mood": "indicative"}]}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "لَحْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَوْلِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْلَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْمَٰلَكُمْ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَعْرِفُونَ", "count": 4, "first": "2:146", "audio": "audio/2b69530cfe63a95ed9ba.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they know", "bs": "znaju", "tr": "bilirler", "fr": "ils savent", "id": "mereka mengetahui", "ur": "وہ جانتے ہیں", "bn": "তারা জানে", "fa": "می‌دانند"}}, {"arabic": "عَرَفُوا۟", "count": 2, "first": "2:89", "audio": "audio/8c2c515fbb42b36ef399.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they knew", "bs": "znali su", "tr": "bildiler", "fr": "ils ont su", "id": "mereka telah mengetahui", "ur": "وہ جانتے تھے", "bn": "তারা জানত", "fa": "دانستند"}}, {"arabic": "يَعْرِفُونَهُۥ", "count": 2, "first": "2:146", "audio": "audio/fe8af917252e7025a08f.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["huwa"], "mood": "indicative"}], "gloss": {"en": "they know him/it", "bs": "znaju ga", "tr": "onu bilirler", "fr": "ils le savent", "id": "mereka mengetahuinya", "ur": "وہ اسے جانتے ہیں", "bn": "তারা তাকে জানে", "fa": "او را می‌دانند"}}, {"arabic": "تَعْرِفُ", "count": 2, "first": "22:72", "audio": "audio/ed15a57fab04777ff1a2.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "prepoznaješ", "en": "you recognize", "tr": "tanırsın", "fr": "tu reconnais", "id": "kamu mengenali", "ur": "تم پہچانتے ہو", "bn": "তুমি চিনতে পারো", "fa": "می‌شناسی"}}, {"arabic": "تَعْرِفُهُم", "count": 1, "first": "2:273", "audio": "audio/43898f81ada191cd13fb.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": ["hum"], "mood": "indicative"}]}, {"arabic": "يَعْرِفُونَهُم", "count": 1, "first": "7:48", "audio": "audio/34937d8df8671ebd4cd4.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"en": "they know them", "bs": "znaju ih", "tr": "onları bilirler", "fr": "ils les connaissent", "id": "mereka mengetahui mereka", "ur": "وہ انہیں جانت