a": "و فراگرفت"}}, {"text": "بِهِم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَهْزِءُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَحَاقَ", "count": 7, "first": "11:8", "audio": "audio/3015383157fd04eac02e.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "i obuhvatilo je", "en": "and it surrounded", "tr": "ve kuşattı", "fr": "et cela cerna", "id": "dan ia meliputi", "ur": "اور آ گھیرا", "bn": "এবং তা ঘিরে ফেলল", "fa": "و فراگرفت"}}, {"arabic": "فَحَاقَ", "count": 2, "first": "6:10", "audio": "audio/c68bf4621e3af6435379.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}]}, {"arabic": "يَحِيقُ", "count": 1, "first": "35:43", "audio": "audio/c8251d31536991d1afae.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it surrounds", "bs": "obuhvata", "tr": "kuşatır", "fr": "il entoure", "id": "dia meliputi", "ur": "وہ گھیرتا ہے", "bn": "সে পরিবেষ্টন করে", "fa": "در بر می‌گیرد"}}], "ayatFile": "ayat/0298.json", "ayatTranslations": {"en": "ayat/0298.en.json", "tr": "ayat/0298.tr.json", "ur": "ayat/0298.ur.json", "id": "ayat/0298.id.json"}, "sentences": [{"arabic": "حَاقَ الْخَطَرُ بِالْقَرْيَةِ", "spoken": "audio/70dadfeb0dcf83d2098b.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Opasnost je okružila selo.", "en": "Danger surrounded the village.", "bn": "বিপদ গ্রামকে ঘিরে ফেলল।", "fa": "خطر روستا را فرا گرفت.", "fr": "Le danger a cerné le village.", "id": "Bahaya mengepung desa itu.", "tr": "Tehlike köyü kuşattı.", "ur": "خطرے نے گاؤں کو گھیر لیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "حَاقَ", "target": true, "translation": {"bs": 