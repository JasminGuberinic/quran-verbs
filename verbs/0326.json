, "notUsed": false, "spoken": "audio/d9d9e6f576c8c5ad399c.m4a", "recited": "audio/0517d6302f4b3381219f.m4a", "recitedText": "وَسَارِعُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "سَارِعْنَ", "plain": "سَارِعْنَ", "quran": false, "notUsed": false, "spoken": "audio/805734b008f74794dfde.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "23:61", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2734.mp3", "translation": {"en": {"text": "These race for the good things, and they shall win them in the race.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte onlar, iyiliklere koşuşurlar ve iyilik için yarışırlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یہ لوگ بھلائیوں میں جلدی کرتے ہیں اور یہی سب سے پہلے انہیں پہنچے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka itu bersegera untuk mendapat kebaikan-kebaikan, dan merekalah orang-orang yang segera memperolehnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُسَٰرِعُونَ", "hit": true, "audio": "audio/d008fa2636aa3b651428.m4a", "gloss": {"en": "they hasten", "bs": "hitaju", "tr": "acele ederler", "fr": "ils se hâtent", "id": "mereka bergegas", "ur": "وہ جلدی کرتے ہیں", "bn": "তারা তাড়াহুড়ো করে", "fa": "می‌شتابند"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَيْرَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "سَٰبِقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:133", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/426.mp3", "translation": {"en": {"text": "And vie one with another for forgiveness from your Lord, and for a paradise as wide as are the heavens and the earth, prepared for those who ward off (evil);", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbinizin bağışına ve genişliği göklerle yer arası kadar olan, Allah'tan gereği gibi korkanlar için hazırlanmış bulunan cennete koşun!", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور دوڑو اپنے رب کی بخشش اور ایسی جنت کی طرف جس کی چوڑان میں سب آسمان و زمین پرہیزگاروں کے لئے تیار کر رکھی ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan bersegeralah kamu kepada ampunan dari Tuhanmu dan kepada surga yang luasnya seluas langit dan bumi yang disediakan untuk orang-orang yang bertakwa,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَسَارِعُوٓا۟", "hit": true, "audio": "audio/0517d6302f4b3381219f.m4a", "gloss": {"bs": "i požurite", "en": "and hasten", "tr": "ve acele edin", "fr": "et hâtez-vous", "id": "dan bersegeralah", "ur": "اور دوڑو", "bn": "এবং তাড়াতাড়ি করো", "fa": "و بشتابید"}}, {"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "مَغْفِرَةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "رَّبِّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَجَنَّةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "عَرْضُهَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمَٰوَٰتُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْأَرْضُ", "hit": false, "audio": null, "gloss": null}, {"text": "أُعِدَّتْ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلْمُتَّقِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:56", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2729.mp3", "translation": {"en": {"text": "We hasten unto them with good things? Nay, but they perceive not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kendilerine faydalar sağlamak için can atıyoruz. Hayır, onlar işin farkına varamıyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یہ جلد جلد ان کو بھلائیاں دیتے ہیں بلکہ انہیں خبر نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kami bersegera memberikan kebaikan-kebaikan kepada mereka? Tidak, sebenarnya mereka tidak sadar.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "نُسَارِعُ", "hit": true, "audio": "audio/c07bdc15ca0ff932b082.m4a", "gloss": {"bs": "požurujemo", "en": "We hasten", "tr": "acele ettiririz", "fr": "Nous nous empressons", "id": "Kami bersegera", "ur": "ہم جلدی کرتے ہیں", "bn": "আমরা দ্রুত করি", "fa": "می‌شتابیم"}}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَيْرَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "بَل", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَشْعُرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُسَٰرِعُونَ", "count": 6, "first": "3:176", "audio": "audio/7b0f2bf6ca1b6900bf66.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they hasten", "bs": "hitaju", "tr": "acele ederler", "fr": "ils se hâtent", "id": "mereka bergegas", "ur": "وہ جلدی کرتے ہیں", "bn": "তারা তাড়াহুড়ো করে", "fa": "می‌شتابند"}}, {"arabic": "وَيُسَٰرِعُونَ", "count": 1, "first": "3:114", "audio": "audio/ab1ee91d1b0d633c49fe.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and they hasten", "bs": "i hitaju", "tr": "ve acele ederler", "fr": "et i