 null, "gloss": null}, {"text": "فَأَحْبَطَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْمَٰلَهُمْ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "كَرِهَ", "count": 8, "first": "8:8", "audio": "audio/44ee578a402d5d572b0d.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "mrzili", "en": "disliked", "tr": "hoşlanmadılar", "fr": "détesta", "id": "membenci", "ur": "انہوں نے ناپسند کیا", "bn": "অপছন্দ করল", "fa": "ناپسند داشت"}}, {"arabic": "تَكْرَهُوا۟", "count": 2, "first": "2:216", "audio": "audio/d85275d923f7f08093ce.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "you (all) dislike", "bs": "mrzite", "tr": "nefret edersiniz", "fr": "vous détestez", "id": "kalian membenci", "ur": "تم سب ناپسند کرتے ہو", "bn": "তোমরা অপছন্দ কর", "fa": "ناخوش دارید"}}, {"arabic": "كَرِهُوا۟", "count": 2, "first": "47:9", "audio": "audio/bb089b569a05758bee3e.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they disliked", "bs": "mrzili su", "tr": "nefret ettiler", "fr": "ils détestaient", "id": "mereka membenci", "ur": "انہوں نے ناپسند کیا", "bn": "তারা অপছন্দ করেছিল", "fa": "ناخوش داشتند"}}, {"arabic": "كَرِهْتُمُوهُنَّ", "count": 1, "first": "4:19", "audio": "audio/23a8b142920a18123d85.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": ["hunna"]}], "gloss": {"en": "you (all) disliked them", "bs": "mrzili ste ih", "tr": "onlardan nefret ettiniz", "fr": "vous les détestiez", "id": "kalian membenci mereka", "ur": "تم سب نے انہیں ناپسند کیا", "bn": "তোমরা তাদের অপছন্দ করেছ", "fa": "آنان را ناخوش داشتید"}}, {"arabic": "وَكَرِهُوٓا۟", "count": 1, "first": "9:81", "audio": "audio/2cad6655e5dfafd7ea1e.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "and they disliked", "