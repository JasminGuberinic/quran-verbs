.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Djed je zabavljao svog unuka.", "en": "The grandfather entertained his grandson.", "bn": "দাদা তার নাতিকে আনন্দ দিলেন।", "fa": "پدربزرگ نوه‌اش را شاد کرد.", "fr": "Le grand-père a tenu compagnie à son petit-fils.", "id": "Sang kakek menghibur cucunya.", "tr": "Dede torununu neşelendirdi.", "ur": "دادا نے اپنے پوتے کا دل بہلایا۔"}, "independentlyReviewed": true, "words": [{"arabic": "آنَسَ", "target": true, "translation": {"bs": "zabavljao je", "en": "entertained", "bn": "সঙ্গ দিল", "fa": "مونس شد", "fr": "a tenu compagnie à", "id": "menghibur", "tr": "neşelendirdi", "ur": "دل بہلایا"}}, {"arabic": "الْجَدُّ", "target": false, "translation": {"bs": "djed", "en": "the grandfather", "bn": "দাদা", "fa": "پدربزرگ", "fr": "le grand-père", "id": "kakek", "tr": "dede", "ur": "دادا"}}, {"arabic": "حَفِيدَهُ", "target": false, "translation": {"bs": "svog unuka", "en": "his grandson", "bn": "তার নাতি", "fa": "نوه‌اش", "fr": "son petit-fils", "id": "cucunya", "tr": "torununu", "ur": "اس کا پوتا"}}]}, {"arabic": "آنَسْتُ صَوْتًا بَعِيدًا", "spoken": "audio/0c43fe465ea398d46f47.m4a", "tense": "past", "pronoun": "ana", "translation": {"bs": "Opazio sam daleki zvuk.", "en": "I perceived a distant sound.", "bn": "আমি দূরের একটি শব্দ টের পেলাম।", "fa": "من صدایی دور احساس کردم.", "fr": "J'ai perçu un son lointain.", "id": "Aku merasakan suara yang jauh.", "tr": "Uzaktan bir ses sezdim.", "ur": "میں نے ایک دور کی آواز محسوس کی۔"}, "independentlyReviewed": true, "words": [{"arabic": "آنَسْتُ", "target": true, "translation": {"bs": "opazio sam", "en": "I perceived", "bn": "আমি টের পেলাম", "fa": "من احساس کردم", "fr": "j'ai perçu", "id": "aku merasakan", "tr": "sezdim", "ur": "میں نے محسوس کیا"}}, {"arabic": "صَوْتًا", "target": false, "translation": {"bs": "zvuk", "en": "a sound", "bn": "একটি শব্দ", "fa": "یک صدا", "fr": "un son", "id": "suara", "tr": "bir ses", "ur": "ایک آواز"}}, {"arabic": "بَعِيدًا", "target": false, "translation": {"bs": "daleki", "en": "distant", "bn": "দূরের", "fa": "دور", "fr": "lointain", "id": "jauh", "tr": "uzaktan gelen", "ur": "دور کی"}}]}, {"arabic": "آنَسْتُمْ تَغَيُّرًا فِي الطَّقْسِ", "spoken": "audio/e1457c3ca63304c36f79.m4a", "tense": "past", "pronoun": "antum", "translation": {"bs": "Opazili ste promjenu vremena.", "en": "You (all) perceived a change in the weather.", "bn": "তোমরা সবাই আবহাওয়ার পরিবর্তন টের পেলে।", "fa": "شما تغییری در هوا احساس کردید.", "fr": "Vous avez perçu un changement dans le temps.", "id": "Kalian merasakan perubahan cuaca.", "tr": "Havada bir değişiklik sezdiniz.", "ur": "تم سب نے موسم میں تبدیلی محسوس کی۔"}, "independentlyReviewed": true, "words": [{"arabic": "آنَسْتُمْ", "target": true, "translation": {"bs": "opazili ste", "en": "you (all) perceived", "bn": "তোমরা সবাই টের পেলে", "fa": "شما (همه) احساس کردید", "fr": "vous avez perçu", "id": "kalian merasakan", "tr": "sezdiniz", "ur": "تم سب نے محسوس کیا"}}, {"arabic": "تَغَيُّرًا", "target": false, "translation": {"bs": "promjenu", "en": "a change", "bn": "একটি পরিবর্তন", "fa": "یک تغییر", "fr": "un changement", "id": "perubahan", "tr": "bir değişiklik", "ur": "ایک تبدیلی"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "u", "en": "in", "bn": "মধ্যে", "fa": "در", "fr": "dans", "id": "di", "tr": "içinde", "ur": "میں"}}, {"arabic": "الطَّقْسِ", "target": false, "translation": {"bs": "vremenu", "en": "the weather", "bn": "আবহাওয়া", "fa": "هوا", "fr": "le temps", "id": "cuaca", "tr": "hava", "ur": "موسم"}}]}]}