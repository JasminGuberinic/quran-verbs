": "تَمُوتِينَ", "quran": false, "notUsed": false, "spoken": "audio/332d0ac6ad6eb32223f6.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تَمُوتَانِ", "plain": "تَمُوتَانِ", "quran": false, "notUsed": false, "spoken": "audio/c2b2d6f3214cb76b6787.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَمُوتُونَ", "plain": "تَمُوتُونَ", "quran": true, "notUsed": false, "spoken": "audio/d24afcf8a48c21bf6bc0.m4a", "recited": "audio/9967557b05cddaeb4a26.m4a", "recitedText": "تَمُوتُونَ"}, {"tense": "present", "pronoun": "antunna", "arabic": "تَمُتْنَ", "plain": "تَمُتْنَ", "quran": false, "notUsed": false, "spoken": "audio/be70cabe1bf5e5fa935e.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَمُوتُ", "plain": "يَمُوتُ", "quran": true, "notUsed": false, "spoken": "audio/2de2c44fc5d414b4bcae.m4a", "recited": "audio/0d63b367e56cdae34d34.m4a", "recitedText": "يَمُوتُ"}, {"tense": "present", "pronoun": "hiya", "arabic": "تَمُوتُ", "plain": "تَمُوتُ", "quran": true, "notUsed": false, "spoken": "audio/1a17cf8e0e5e8e7f453a.m4a", "recited": "audio/bd637bba9e5b61f803c5.m4a", "recitedText": "تَمُوتُ"}, {"tense": "present", "pronoun": "huma", "arabic": "يَمُوتَانِ", "plain": "يَمُوتَانِ", "quran": false, "notUsed": false, "spoken": "audio/1ffffcab33c616de3e36.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَمُوتُونَ", "plain": "يَمُوتُونَ", "quran": true, "notUsed": false, "spoken": "audio/58f9fd83fd9c00ac9f79.m4a", "recited": "audio/700c68587ffedc5f1320.m4a", "recitedText": "يَمُوتُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَمُتْنَ", "plain": "يَمُتْنَ", "quran": false, "notUsed": false, "spoken": "audio/331ed9f1f760f958fcab.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "مُتْ", "plain": "مُتْ", "quran": false, "notUsed": false, "spoken": "audio/ce9b2064adc3cd58b609.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "مُوتِي", "plain": "مُوتِي", "quran": false, "notUsed": false, "spoken": "audio/10d00b585a43bf8c9032.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "مُوتَا", "plain": "مُوتَا", "quran": false, "notUsed": false, "spoken": "audio/9619f774f4ef19d65a35.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "مُوتُوا۟", "plain": "مُوتُوا", "quran": true, "notUsed": false, "spoken": "audio/d21a7c0e64d5b0c52fc7.m4a", "recited": "audio/11d10c02c6991f3a234d.m4a", "recitedText": "مُوتُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "مُتْنَ", "plain": "مُتْنَ", "quran": false, "notUsed": false, "spoken": "audio/3a83825d5d6898c79c47.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "9:125", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1360.mp3", "translation": {"en": {"text": "But as for those in whose hearts is disease, it only addeth wickedness to their wickedness, and they die while they are disbelievers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kalblerinde bir hastalık olanlara gelince, onların da murdarlıklarına (küfürlerine) murdarlık (küfür) katmıştır ve kâfir olarak ölüp gitmişlerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جن کے دلوں میں آزار ہے انہیں اور پلیدی پر پلیدی بڑھائی اور وہ کفر ہی پر مر گئے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan adapun orang-orang yang di dalam hati mereka ada penyakit, maka dengan surat itu bertambah kekafiran mereka, disamping kekafirannya (yang telah ada) dan mereka mati dalam keadaan kafir.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "قُلُوبِهِم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّرَضٌ", "hit": false, "audio": null, "gloss": null}, {"text": "فَزَادَتْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "رِجْسًا", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "رِجْسِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَاتُوا۟", "hit": true, "audio": "audio/bbd2bed813bfdb3dbcdd.m4a", "gloss": {"en": "and they died", "bs": "i umrli su", "tr": "ve öldüler", "fr": "et ils sont morts", "id": "dan mereka telah mati", "ur": "اور وہ مرے", "bn": "এবং তারা মারা গেল", "fa": "و مردند"}}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَٰفِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "87:13", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5961.mp3", "translation": {"en": {"text": "Wherein he will neither die nor live.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra ne ölecek onda, ne de hayat bulacaktır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر نہ اس میں مرے اور نہ جیے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian dia tidak akan mati di dalamnya dan tidak (pula) hidup.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَمُوتُ", "hit": true, "audio": "audio/0d63b367e56cdae34d34.m4a", "gloss": {"bs": "umire", "en": "he dies", "tr": "ölür", "fr": "il meurt", "id": "dia mati", "ur": "وہ مرتا ہے", "bn": "সে মারা যায়", "fa": "می‌میرد"}}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَحْيَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:25", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/979.mp3", "translation": {"en": {"text": "He said: There shall ye live, and there shall ye die, and thence shall ye be brought forth.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Orada yaşayacaksınız, orada öleceksiniz ve yine oradan (dirilip) çıkarılacaksınız!\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "فرمایا اسی میں جیوگے اور اسی میں مرو گے اور اسی میں اٹھائے جاؤ گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah berfirman: \"Di bumi itu kamu hidup dan di bumi itu kamu mati, dan dari bumi itu (pula) kamu akan dibangkitkan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَحْيَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَفِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَمُوتُونَ", "hit": true, "audio": "audio/9967557b05cddaeb4a26.m4a", "gloss": {"en": "you (all) die", "bs": "umirete", "tr": "ölürsünüz", "fr": "vous mourez", "id": "kalian mati", "ur": "تم سب مرو", "bn": "তোমরা মারা যাবে", "fa": "می‌میرید"}}, {"text": "وَمِنْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُخْرَجُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:158", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/451.mp3", "translation": {"en": {"text": "What though ye be slain or die, when unto Allah ye are gathered?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun, ölseniz de, öldürülseniz de Allah'ın huzurunda toplanacaksınız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر تم مرو یا مارے جاؤ تو اللہ کی طرف اٹھنا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sungguh jika kamu meninggal atau gugur, tentulah kepada Allah saja kamu dikumpulkan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَئِن", "hit": false, "audio": null, "gloss": null}, {"text": "مُّتُّمْ", "hit": true, "audio": "audio/f1fc17a2305ab9ed631e.m4a", "gloss": {"bs": "umrete", "en": "you die", "tr": "ölürsünüz", "fr": "vous mourez", "id": "kamu mati", "ur": "تم مر جاؤ", "bn": "তোমরা মারা যাও", "fa": "بمیرید"}}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "قُتِلْتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَإِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "تُحْشَرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:66", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2316.mp3", "translation": {"en": {"text": "And man saith: When I am dead, shall I forsooth be brought forth alive?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Halbuki insan şöyle der: \"Ben öldüğüm zaman, ileride gerçekten diri olarak (mezardan) çıkarılacak mıyım?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور آدمی کہتا ہے کیا جب میں مرجاؤں گا تو ضرور عنقریب جِلا کر نکالا جاؤں گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan berkata manusia: \"Betulkah apabila aku telah mati, bahwa aku sungguh-sungguh akan dibangkitkan menjadi hidup kembali?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَقُولُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْإِنسَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَءِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِتُّ", "hit": true, "audio": "audio/fed014674f92ae306501.m4a", "gloss": {"en": "I died", "bs": "umro sam", "tr": "öldüm", "fr": "je suis mort", "id": "aku telah mati", "ur": "میں مرا", "bn": "আমি মারা গেছি", "fa": "مردم"}}, {"text": "لَسَوْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "أُخْرَجُ", "hit": false, "audio": null, "gloss": null}, {"text": "حَيًّا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:37", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2710.mp3", "translation": {"en": {"text": "There is naught but our life of the world; we die and we live, and we shall not be raised (again).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Dünya hayatından başka gerçek yoktur. (Kimimiz) ölürüz, (kimimiz) yaşarız; bir daha diriltilecek değiliz.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ تو نہیں مگر ہماری دنیا کی زندگی کہ ہم مرتے جیتے ہیں اور ہمیں اٹھنا نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "kehidupan itu tidak lain hanyalah kehidupan kita di dunia ini, kita mati dan kita hidup dan sekali-kali tidak akan dibangkitkan lagi,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "هِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "حَيَاتُنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلدُّنْيَا", "hit": false, "audio": null, "gloss": null}, {"text": "نَمُوتُ", "hit": true, "audio": "audio/d38a2c4a9cd6ad069805.m4a", "gloss": {"en": "we die", "bs": "umiremo"