": "مَدَّ", "target": true, "translation": {"bs": "pružilo je", "en": "stretched out", "bn": "প্রসারিত করল", "fa": "دراز کرد", "fr": "a tendu", "id": "membentangkan", "tr": "uzattı", "ur": "اس نے بڑھایا"}}, {"arabic": "الْوَلَدُ", "target": false, "translation": {"bs": "dijete", "en": "the child", "bn": "শিশুটি", "fa": "کودک", "fr": "l'enfant", "id": "anak itu", "tr": "çocuk", "ur": "بچہ"}}, {"arabic": "يَدَهُ", "target": false, "translation": {"bs": "svoju ruku", "en": "his hand", "bn": "তার হাত", "fa": "دستش", "fr": "sa main", "id": "tangannya", "tr": "elini", "ur": "اپنا ہاتھ"}}]}, {"arabic": "نَمُدُّ يَدَ الْعَوْنِ", "spoken": "audio/7711539177bddc310a33.m4a", "tense": "present", "pronoun": "nahnu", "translation": {"bs": "Pružamo ruku pomoći.", "en": "We extend a helping hand.", "bn": "আমরা সাহায্যের হাত বাড়িয়ে দিই।", "fa": "دست یاری دراز می‌کنیم.", "fr": "Nous tendons une main secourable.", "id": "Kami mengulurkan tangan membantu.", "tr": "Yardım eli uzatıyoruz.", "ur": "ہم مدد کا ہاتھ بڑھاتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "نَمُدُّ", "target": true, "translation": {"bs": "pružamo", "en": "we extend", "bn": "আমরা প্রসারিত করি", "fa": "دراز می‌کنیم", "fr": "nous tendons", "id": "kami membentangkan", "tr": "uzatırız", "ur": "ہم بڑھاتے ہیں"}}, {"arabic": "يَدَ", "target": false, "translation": {"bs": "ruku", "en": "hand", "bn": "হাত", "fa": "دست", "fr": "la main", "id": "tangan", "tr": "el", "ur": "ہاتھ"}}, {"arabic": "الْعَوْنِ", "target": false, "translation": {"bs": "pomoći", "en": "the assistance", "bn": "সাহায্য", "fa": "یاری", "fr": "l'aide", "id": "bantuan", "tr": "yardım", "ur": "مدد"}}]}]}