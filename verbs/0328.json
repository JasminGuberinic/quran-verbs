"gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "تُكَذِّبُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:13", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2945.mp3", "translation": {"en": {"text": "And I shall be embarrassed, and my tongue will not speak plainly, therefor send for Aaron (to help me).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ve göğsüm daralır, dilim dönmez, onun için Harun'a da elçilik ver.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور میرا سینہ تنگی کرتا ہے اور میری زبان نہیں چلتی تو توُ ہا رون کو بھی رسول کر،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan (karenanya) sempitlah dadaku dan tidak lancar lidahku maka utuslah (Jibril) kepada Harun.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَضِيقُ", "hit": false, "audio": null, "gloss": null}, {"text": "صَدْرِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَنطَلِقُ", "hit": true, "audio": "audio/1de74c6f7ff501e998f5.m4a", "gloss": {"bs": "(ne) razvezuje se", "en": "(does not) speak freely", "tr": "(rahat) konuşamaz", "fr": "(ne) parle (pas) librement", "id": "(tidak) berbicara bebas", "ur": "(کھلتی) نہیں زبان", "bn": "(সে) স্বচ্ছন্দে কথা বলে (না)", "fa": "(آزادانه) سخن نمی‌گوید"}}, {"text": "لِسَانِى", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَرْسِلْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "38:6", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3976.mp3", "translation": {"en": {"text": "The chiefs among them go about, exhorting: Go and be staunch to your gods! Lo! this is a thing designed.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İçlerinden ileri gelenler fırladılar ve dediler ki: \"İlâhlarınız üzerinde sabır ve sebat edin. Bu, gerçekten arzu edilen bir murad!\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان میں کے سردار چلے کہ اس کے پاس سے چل دو اور اپنے خداؤں پر صابر رہو بیشک اس میں اس کا کوئی مطلب ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan pergilah pemimpin-pemimpin mereka (seraya berkata): \"Pergilah kamu dan tetaplah (menyembah) tuhan-tuhanmu, sesungguhnya ini benar-benar suatu hal yang dikehendaki.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱنطَلَقَ", "hit": true, "audio": "audio/39115ea81a1fde8fbcbb.m4a", "gloss": {"en": "and he/it set off", "bs": "i krenuo je", "tr": "ve yola çıktı", "fr": "et il est parti", "id": "dan dia berangkat", "ur": "اور وہ نکلا", "bn": "এবং সে রওনা হলো", "fa": "و حرکت کرد"}}, {"text": "ٱلْمَلَأُ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱمْشُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱصْبِرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَالِهَتِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَشَىْءٌ", "hit": false, "audio": null, "gloss": null}, {"text": "يُرَادُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "68:23", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5294.mp3", "translation": {"en": {"text": "So they went off, saying one unto another in low tones:", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Derken fırladılar, aralarında fısıldaşıyorlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو چلے اور آپس میں آہستہ آہستہ کہتے جاتے تھے کہ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka pergilah mereka saling berbisik-bisik.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱنطَلَقُوا۟", "hit": true, "audio": "audio/cccf2740fc680996d6ac.m4a", "gloss": {"bs": "pa su krenuli", "en": "so they set off", "tr": "bunun üzerine yola çıktılar", "fr": "alors ils partirent", "id": "lalu mereka berangkat", "ur": "پھر وہ چل پڑے", "bn": "তখন তারা রওনা দিল", "fa": "پس روانه شدند"}}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَخَٰفَتُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "فَٱنطَلَقَا", "count": 3, "first": "18:71", "audio": "audio/9c75f96dae080e1cd78e.m4a", "grammar": [{"tense": "past", "pronoun": "huma", "passive": false, "objects": []}], "gloss": {"en": "so they (two) set off", "bs": "pa su krenuli", "tr": "böylece yola çıktılar", "fr": "alors ils (deux) sont partis", "id": "maka mereka berdua berangkat", "ur": "پس وہ دونوں نکلے", "bn": "অতএব তারা দুজন রওনা হলো", "fa": "پس حرکت کردند"}}, {"arabic": "ٱنطَلِقُوٓا۟", "count": 2, "first": "77:29", "audio": "audio/c011fc4ea631d56577d7.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"bs": "idite", "en": "go off", "tr": "gidin", "fr": "partez", "id": "pergilah", "ur": "چل پڑو", "bn": "তোমরা রওনা দাও", "fa": "بروید"}}, {"arabic": "يَنطَلِقُ", "count": 1, "first": "26:13", "audio": "audio/1de74c6f7ff501e998f5.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "(ne) razvezuje se", "en": "(does not) speak freely", "tr": "(rah