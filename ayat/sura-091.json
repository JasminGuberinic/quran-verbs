{"ayat":[{"ref":"91:1","number":6044,"text":"وَٱلشَّمْسِ وَضُحَىٰهَا","hits":[0,1]},{"ref":"91:2","number":6045,"text":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","hits":[0,1,2]},{"ref":"91:3","number":6046,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","hits":[0]},{"ref":"91:4","number":6047,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","hits":[0,2]},{"ref":"91:5","number":6048,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","hits":[0,1,2]},{"ref":"91:6","number":6049,"text":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","hits":[0]},{"ref":"91:7","number":6050,"text":"وَنَفْسٍ وَمَا سَوَّىٰهَا","hits":[0,2]},{"ref":"91:8","number":6051,"text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","hits":[2]},{"ref":"91:9","number":6052,"text":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","hits":[0,1,2,3]},{"ref":"91:10","number":6053,"text":"وَقَدْ خَابَ مَن دَسَّىٰهَا","hits":[1]},{"ref":"91:11","number":6054,"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","hits":[0]},{"ref":"91:12","number":6055,"text":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","hits":[0]},{"ref":"91:13","number":6056,"text":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا","hits":[0,1,2,4]},{"ref":"91:14","number":6057,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","hits":[1,3,4,5]},{"ref":"91:15","number":6058,"text":"وَلَا يَخَافُ عُقْبَٰهَا","hits":[0,1]}]}