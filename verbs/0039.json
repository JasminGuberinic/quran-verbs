edText": "يَأْمُرُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَأْمُرْنَ", "plain": "يَأْمُرْنَ", "quran": false, "notUsed": false, "spoken": "audio/158fad664854fdede898.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أْمُرْ", "plain": "اُؤْمُرْ", "quran": true, "notUsed": false, "spoken": "audio/308261263381902928aa.m4a", "recited": "audio/70ff1986d2520456dd66.m4a", "recitedText": "وَأْمُرْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُؤْمُرِي", "plain": "اُؤْمُرِي", "quran": false, "notUsed": false, "spoken": "audio/ab41d486be49c410aa13.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُؤْمُرَا", "plain": "اُؤْمُرَا", "quran": false, "notUsed": false, "spoken": "audio/889b5efd120dcfc22a77.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُؤْمُرُوا", "plain": "اُؤْمُرُوا", "quran": false, "notUsed": false, "spoken": "audio/80b7518e00a618c6a0d9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُؤْمُرْنَ", "plain": "اُؤْمُرْنَ", "quran": false, "notUsed": false, "spoken": "audio/9e00069163e3c75fd3ee.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "19:55", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2305.mp3", "translation": {"en": {"text": "He enjoined upon his people worship and almsgiving, and was acceptable in the sight of his Lord.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ailesine ve çevresine namaz kılmayı ve zekat vermeyi emrederdi ve Rabbinin katında hoşnutluğa ermişti.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اپنے گھر والوں کو نماز اور زکوٰة کا حکم دیتا اور اپنے رب کو پسند تھا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan ia menyuruh ahlinya untuk bersembahyang dan menunaikan zakat, dan ia adalah seorang yang diridhai di sisi Tuhannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَكَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَأْمُرُ", "hit": true, "audio": "audio/42fbd365e25211643733.m4a", "gloss": {"en": "he/it commands", "bs": "naređuje", "tr": "emreder", "fr": "il ordonne", "id": "dia memerintahkan", "ur": "وہ حکم دیتا ہے", "bn": "সে আদেশ করে", "fa": "فرمان می‌دهد"}}, {"text": "أَهْلَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلصَّلَوٰةِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلزَّكَوٰةِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَكَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "عِندَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "مَرْضِيًّا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "96:12", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6118.mp3", "translation": {"en": {"text": "Or enjoineth piety?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Veya kötülüklerden sakınmayı emrederse?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا پرہیزگاری بتاتا تو کیا خوب تھا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "atau dia menyuruh bertakwa (kepada Allah)?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمَرَ", "hit": true, "audio": "audio/96a70d3da70762886577.m4a", "gloss": {"bs": "(ili) je naređivao", "en": "(or) he enjoined", "tr": "(veya) emretti", "fr": "(ou) a-t-il ordonné", "id": "(atau) dia memerintahkan", "ur": "(یا) اس نے حکم دیا", "bn": "(অথবা) সে আদেশ করেছে", "fa": "(یا) فرمان داد"}}, {"text": "بِٱلتَّقْوَىٰٓ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "57:24", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5099.mp3", "translation": {"en": {"text": "Who hoard and who enjoin upon the people avarice. And whosoever turneth away, still Allah is the Absolute, the Owner of Praise.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar cimrilik edip insanlara da cimriliği emrederler. Kim yüz çevirirse Allah, zengindir, övgüye layıktır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ جو آپ بخل کریں اور اوروں سے بخل کو کہیں اور جو منہ پھیرے تو بیشک اللہ ہی بے نیاز ہے سب خوبیوں سراہا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yaitu) orang-orang yang kikir dan menyuruh manusia berbuat kikir. Dan barangsiapa yang berpaling (dari perintah-perintah Allah) maka sesungguhnya Allah Dialah Yang Maha Kaya lagi Maha Terpuji.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَبْخَلُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَأْمُرُونَ", "hit": true, "audio": "audio/f0a19608bd9f8afe27ad.m4a", "gloss": {"en": "and they command", "bs": "i naređuju", "tr": "ve emrederler", "fr": "et ils ordonnent", "id": "dan mereka memerintahkan", "ur": "اور وہ حکم دیتے ہیں", "bn": "এবং তারা আদেশ করে", "fa": "و فرمان می‌دهند"}}, {"text": "ٱلنَّاسَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْبُخْلِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَوَلَّ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْغَنِىُّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَمِيدُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:110", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1064.mp3", "translation": {"en": {"text": "Who would expel you from your land. Now what do ye advise?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O, sizi yurdunuzdan çıkarmak istiyor. (Firavun): \"O halde siz ne diyorsunuz?\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تمہیں تمہارے ملک سے نکا لا چاہتا ہے تو تمہارا کیا مشورہ ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "yang bermaksud hendak mengeluarkan kamu dari negerimu\". (Fir'aun berkata): \"Maka apakah yang kamu anjurkan?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يُرِيدُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يُخْرِجَكُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْضِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَمَاذَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَأْمُرُونَ", "hit": true, "audio": "audio/c4081f6b2e7e67d5fd2e.m4a", "gloss": {"bs": "savjetujete (naređujete)", "en": "you advise (command)", "tr": "emrediyorsunuz", "fr": "vous conseillez (ordonnez)", "id": "kamu menyuruh", "ur": "تم حکم دیتے ہو", "bn": "তোমরা আদেশ করো", "fa": "فرمان می‌دهید"}}]}, {"ref": "7:199", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1153.mp3", "translation": {"en": {"text": "Keep to forgiveness (O Muhammad), and enjoin kindness, and turn away from the ignorant.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sen yine de affa sarıl, iyiliği emret ve cahillerden yüz çevir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے محبوب! معاف کرنا اختیار کرو اور بھلائی کا حکم دو اور جاہلوں سے منہ پھیرلو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Jadilah engkau pemaaf dan suruhlah orang mengerjakan yang ma'ruf, serta berpalinglah dari pada orang-orang yang bodoh.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "خُذِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَفْوَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأْمُرْ", "hit": true, "audio": "audio/52a461cc4ab9b8b50898.m4a", "gloss": {"bs": "i naređuj!", "en": "and enjoin!", "tr": "ve emret!", "fr": "et ordonne !", "id": "dan perintahkanlah!", "ur": "اور حکم دو!", "bn": "এবং আদেশ করো!", "fa": "و فرمان بده!"}}, {"text": "بِٱلْعُرْفِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَعْرِضْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْجَٰهِلِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "27:33", "tense": "present", "category": {"tense": "present", "pronoun": "anti", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3192.mp3", "translation": {"en": {"text": "They said: We are lords of might and lords of great prowess, but it is for thee to command; so consider what thou wilt command.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, şöyle cevap verdiler: \"Biz güçlü kuvvetli kimseleriz, zorlu savaş erbabıyız, buyruk ise senindir; artık ne emredeceğini düşün taşın.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ بولے ہم زور والے اور بڑی سخت لڑائی والے ہیں اور اختیار تیرا ہے تو نظر کر کہ کیا حکم دیتی ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka menjawab: \"Kita adalah orang-orang yang memiliki kekuatan dan (juga) memiliki keberanian yang sangat (dalam peperangan), dan keputusan berada ditanganmu: maka pertimbangkanlah apa yang akan kamu perintahkan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "نَحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "أُو۟لُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "قُوَّةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأُو۟لُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "بَأْسٍ", "hit": false, "audio": null, "gloss": null}, {"text": "شَدِيدٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْأَمْرُ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْكِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱنظُرِى", "hit": false, "audio": null, "gloss": null}, {"text": "مَاذَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَأْمُرِينَ", "hit": true, "audio": "audio/f789c2128b4388dfe3d2.m4a", "gloss": {"en": "you command", "bs": "naređuješ", "tr": "emredersin", "fr": "tu ordonnes", "id": "kamu memerintahkan", "ur": "تم حکم دیتی ہو", "bn": "তুমি আদেশ কর", "fa": "فرمان می‌دهی"}}]}], "forms": [{"arabic": "أَمَرَ", "count": 7, "first": "2:27", "audio": "audio/96a70d3da70762886577.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "(ili) je naređivao", "en": "(or) he enjoined", "tr": "(veya) emretti", "fr": "(ou) a-t-il ordonné", "id": "(atau) dia memerintahkan", "ur": "(یا) اس نے حکم دیا", "bn": "(অথবা) সে আদেশ করেছে", "fa": "(یا) فرمان داد"}}, {"arabic": "وَأُمِرْتُ", "count": 6, "first": "10:72", "audio": "audio/7b8ae064c824f0665b38.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": true, "objects": []}], "gloss": {"en": "and I was commanded", "bs": "i naređeno mi je", "tr": "ve bana emredildi", "fr": "et il m'a été ordonné", "id": "dan telah diperintahkan kepadaku", "ur": "اور مجھے حکم دیا گیا", "bn": "এবং আমাকে আদেশ করা হয়েছে", "fa": "و به من فرمان داده شد"}}, {"arabic": "أُمِرْتُ", "count": 5, "first": "6:14", "audio": "audio/795c1c4b8c97e6738013.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": true, "objects": []}], "gloss": {"en": "I was commanded", "bs": "naređeno mi je", "tr": "bana emredildi", "fr": "il m'a été ordonné", "id": "telah diperintahkan kepadaku", "ur": "مجھے حکم دیا گیا", "bn": "আমাকে আদেশ করা হয়েছে", "fa": "به من فرمان داده شد"}}, {"arabic": "يَأْمُرُ", "count": 5, "first": "7:28", "audio": "audio/6af24f2078fe532018bd.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it commands", "bs": "naređuje", "tr": "emreder", "fr": "il ordonne", "id": "dia memerintahkan", "ur": "وہ حکم دیتا ہے", "bn": "সে আদেশ করে", "fa": "فرمان می‌دهد"}}, {"arabic": "وَيَأْمُرُونَ", "count": 4, "first": "3:104", "audio": "audio/b91902940c5b5213ae1c.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and they command", "bs": "i naređuju", "tr": "ve emrederler", "fr": "et ils ordonnent", "id": "dan mereka memerintahkan", "ur": "اور وہ حکم دیتے ہیں", "bn": "এবং তারা আদেশ করে", "fa": "و فرمان می‌دهند"}}, {"arabic": "وَأْمُرْ", "count": 4, "first": "7:145", "audio": "audio/70ff1986d2520456dd66.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"bs": "i naređuj!", "en": "and enjoin!", "tr": "ve emret!", "fr": "et ordonne !", "id": "dan perintahkanlah!", "ur": "اور حکم دو!", "bn": "এবং আদেশ করো!", "fa": "و فرمان بده!"}}, {"arabic": "يَأْمُرُونَ", "count": 3, "first": "3:21", "audio": "audio/60d70c651b1999b1931c.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they command", "bs": "naređuju", "tr": "emrederler", "fr": "ils ordonnent", "id": "mereka memerintahkan", "ur": "وہ حکم دیتے ہیں", "bn": "তারা আদেশ করে", "fa": "فرمان می‌دهند"}}, {"arabic": "تَأْمُرُونَ", "count": 3, "first": "3:110", "audio": "audio/e4bcd1d0234e060e8d12.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "savjetujete (naređujete)", "en": "you advise (command)", "tr": "emrediyorsunuz", "fr": "vous conseillez (ordonnez)", "id": "kamu menyuruh", "ur": "تم حکم دیتے ہو", "bn": "তোমরা আদেশ করো", "fa": "فرمان می‌دهید"}}, {"arabic": "أُمِرُوٓا۟", "count": 3, "first": "4:60", "audio": "audio/e74fdbd7ce648a44400a.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": true, "objects": []}], "gloss": {"en": "they were commanded", "bs": "naređeno im je", "tr": "onlara emredildi", "fr": "il leur a été ordonné", "id": "telah diperintahkan kepada mereka", "ur": "انہیں حکم دیا گیا", "bn": "তাদের আদেশ করা হয়েছিল", "fa": "به آنان فرمان داده شد"}}, {"arabic": "يَأْمُرُكُمْ", "count": 2, "first": "2:67", "audio": "audio/0d1b7691b6892b8db355.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "he/it commands you (all)", "bs": "naređuje vam", "tr": "size emreder", "fr": "il vous ordonne", "id": "dia memerintahkan kalian", "ur": "وہ تم سب کو حکم دیتا ہے", "bn": "সে তোমাদের আদেশ করে", "fa": "به شما فرمان می‌دهد"}}, {"arabic": "تُؤْمَرُونَ", "count": 2, "first": "2:68", "audio": "audio/d1bf8ddb9ddaf7de0f2a.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "you (all) are commanded", "bs": "naređuje vam se", "tr": "size emredilir", "fr": "il vous est ordonné", "id": "kalian diperintahkan", "ur": "تمہیں حکم دیا جاتا ہے", "bn": "তোমাদের আদেশ করা হয়", "fa": "به شما فرمان داده می‌شود"}}, {"arabic": "يَأْمُرُكُم", "count": 2, "first": "2:93", "audio": "audio/ea8ef0da8d854a7e9a2a.m4a", "grammar": [{"tense": "present", "pronou