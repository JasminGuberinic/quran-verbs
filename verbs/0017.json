{"rank": 17, "root": "وقي", "form": 8, "lemma": "اتَّقَى", "count": 166, "ayahCount": 158, "share": 0.86, "meaning": {"bs": "bojati se (Allaha), čuvati se", "en": "to be mindful (of God), to fear", "tr": "sakınmak, takva sahibi olmak", "fr": "craindre (Dieu), se prémunir", "id": "bertakwa", "ur": "تقویٰ اختیار کرنا، ڈرنا", "bn": "তাকওয়া অবলম্বন করা, (আল্লাহকে) ভয় করা", "fa": "تقوا پیشه کردن، پروا داشتن (از خدا)"}, "lemmaSpoken": "audio/401f18824a46eea4e5f8.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "ٱتَّقَىٰ", "plain": "اِتَّقَى", "quran": true, "notUsed": false, "spoken": "audio/401f18824a46eea4e5f8.m4a", "recited": "audio/c3ade28f7f433f394847.m4a", "recitedText": "ٱتَّقَىٰ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَتَّقِى", "plain": "يَتَّقِي", "quran": true, "notUsed": false, "spoken": "audio/0cf1052b3700b2c3f0a7.m4a", "recited": "audio/96d5effcb372063622cb.m4a", "recitedText": "يَتَّقِى"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱتَّقِ", "plain": "اِتَّقِ", "quran": true, "notUsed": false, "spoken": "audio/908278663e2b6cad92c7.m4a", "recited": "audio/beb6082d3449f305a9cc.m4a", "recitedText": "ٱتَّقِ"}], "nouns": {"participle": {"lemma": "مُتَّقي", "count": 49, "spoken": "audio/1476d769416ceff00973.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "اِتَّقَيْتُ", "plain": "اِتَّقَيْتُ", "quran": false, "notUsed": false, "spoken": "audio/2379fa4c8ac9f3e5fc43.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "اِتَّقَيْنَا", "plain": "اِتَّقَيْنَا", "quran": false, "notUsed": false, "spoken": "audio/538d6e18fcbc815bbd2b.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "اِتَّقَيْتَ", "plain": "اِتَّقَيْتَ", "quran": false, "notUsed": false, "spoken": "audio/52759e205bae9cc09707.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "اِتَّقَيْتِ", "plain": "اِتَّقَيْتِ", "quran": fa