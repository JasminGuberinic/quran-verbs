{"rank": 146, "root": "بدل", "form": 2, "lemma": "بَدَّلَ", "count": 23, "ayahCount": 21, "share": 0.12, "meaning": {"bs": "promijeniti, zamijeniti", "en": "to change, to exchange", "tr": "değiştirmek, takas etmek", "fr": "changer, échanger", "id": "mengganti, menukar", "ur": "بدلنا، تبدیل کرنا", "bn": "বদলানো, বিনিময় করা", "fa": "تغییر دادن، عوض کردن"}, "lemmaSpoken": "audio/2ddd3e9675dd9cb9c553.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "بَدَّلَ", "plain": "بَدَّلَ", "quran": true, "notUsed": false, "spoken": "audio/2ddd3e9675dd9cb9c553.m4a", "recited": "audio/407d4d4fcab3139b7247.m4a", "recitedText": "بَدَّلَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُبَدِّلُ", "plain": "يُبَدِّلُ", "quran": true, "notUsed": false, "spoken": "audio/75abcf3ca942d9f8d04a.m4a", "recited": "audio/25f6f5504b6b6a0a70b9.m4a", "recitedText": "يُبَدِّلُ"}], "nouns": {"participle": {"lemma": "مُبَدِّل", "count": 3, "spoken": "audio/54816aa075c0786f63f7.m4a"}, "verbal_noun": {"lemma": "تَبْدِيل", "count": 7, "spoken": "audio/0147b9168d17f1e788cf.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "بَدَّلْتُ", "plain": "بَدَّلْتُ", "quran": false, "notUsed": false, "spoken": "audio/30be4efcc08c8867d99f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "بَدَّلْنَآ", "plain": "بَدَّلْنَا", "quran": true, "notUsed": false, "spoken": "audio/3ee5805b621d9f1cce16.m4a", "recited": "audio/42737622fa0fc8e45b95.m4a", "recitedText": "بَدَّلْنَآ"}, {"tense": "past", "pronoun": "anta", "arabic": "بَدَّلْتَ", "plain": "بَدَّلْتَ", "quran": false, "notUsed": false, "spoken": "audio/50a7f1a433fe399f6a7d.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "بَدَّلْتِ", "plain": "بَدَّلْتِ", "quran": false, "notUsed": false, "spoken": "audio/4a6ab3f9c5ec169ed028.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "بَدَّلْتُمَا", "plain"