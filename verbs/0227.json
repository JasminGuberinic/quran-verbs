ull, "gloss": null}, {"text": "ٱلْكَرِيمِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:196", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/489.mp3", "translation": {"en": {"text": "Let not the vicissitude (of the success) of those who disbelieve, in the land, deceive thee (O Muhammad).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kâfirlerin diyar diyar dolaşmaları sakın seni aldatmasın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے سننے والے! کافروں کا شہروں میں اہلے گہلے پھرنا ہرگز تجھے دھوکا نہ دے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Janganlah sekali-kali kamu terperdaya oleh kebebasan orang-orang kafir bergerak di dalam negeri.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَغُرَّنَّكَ", "hit": true, "audio": "audio/6a75123ca2806a523dcf.m4a", "gloss": {"bs": "neka te ne zavara", "en": "let [it] not deceive you", "tr": "seni aldatmasın", "fr": "qu'il ne te leurre pas", "id": "janganlah [ia] memperdayakanmu", "ur": "وہ تجھے دھوکے میں نہ ڈالے", "bn": "তা যেন তোমাকে প্রতারিত না করে", "fa": "تو را مفریبد"}}, {"text": "تَقَلُّبُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبِلَٰدِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَغَرَّتْهُمُ", "count": 3, "first": "6:70", "audio": "audio/72fc49ded4751e3de65e.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": ["hum"]}], "gloss": {"en": "and she/it deceived them", "bs": "i zavarala ih je", "tr": "ve onları aldattı", "fr": "et elle les a trompés", "id": "dan dia telah