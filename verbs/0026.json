": "يَسْأَلْنَ", "plain": "يَسْأَلْنَ", "quran": false, "notUsed": false, "spoken": "audio/cc2ec349ea3efb1e92b1.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "سْـَٔلِ", "plain": "اِسْأَلْ", "quran": true, "notUsed": false, "spoken": "audio/2a5fa788f9c28f2f6f25.m4a", "recited": "audio/0e5c67e95d292bc3889a.m4a", "recitedText": "فَسْـَٔلِ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِسْأَلِي", "plain": "اِسْأَلِي", "quran": false, "notUsed": false, "spoken": "audio/d10fc6b1fe93997a2643.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِسْأَلَا", "plain": "اِسْأَلَا", "quran": false, "notUsed": false, "spoken": "audio/ca0acc4140fd3b62c19e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "سْـَٔلُوا۟", "plain": "اِسْأَلُوا", "quran": true, "notUsed": false, "spoken": "audio/654c24e607029764cf00.m4a", "recited": "audio/7cc93ae95dee001b5ead.m4a", "recitedText": "وَسْـَٔلُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِسْأَلْنَ", "plain": "اِسْأَلْنَ", "quran": false, "notUsed": false, "spoken": "audio/3ba05f1f04e5d0de6596.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "51:12", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4687.mp3", "translation": {"en": {"text": "They ask: When is the Day of Judgment?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar: \"Hesap ve ceza günü ne zaman?\" diye soruyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پوچھتے ہیں انصاف کا دن کب ہوگا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka bertanya: \"Bilakah hari pembalasan itu?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَسْـَٔلُونَ", "hit": true, "audio": "audio/7593c92857fdb2732576.m4a", "gloss": {"en": "they ask", "bs": "pitaju", "tr": "sorarlar", "fr": "ils demandent", "id": "mereka bertanya", "ur": "وہ پوچھتے ہیں", "bn": "তারা জিজ্ঞেস করে", "fa": "می‌پرسند"}}, {"text": "أَيَّانَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلدِّينِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "38:86", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4056.mp3", "translation": {"en": {"text": "Say (O Muhammad, unto mankind): I ask of you no fee for this, and I am no simulating.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey Muhammed! De ki: \"Ben o Kur'ân'a karşı sizden bir ücret istemiyorum. Ve ben kendiliğimden bir şey de teklif etmiyorum.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ میں اس قرآن پر تم سے کچھ اجر نہیں مانگتا اور میں بناوٹ والوں سے نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah (hai Muhammad): \"Aku tidak meminta upah sedikitpun padamu atas dakwahku dan bukanlah aku termasuk orang-orang yang mengada-adakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "مَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَسْـَٔلُكُمْ", "hit": true, "audio": "audio/273e066ff6d3c1d54c44.m4a", "gloss": {"en": "I ask you (all)", "bs": "pitam vas", "tr": "size soruyorum", "fr": "je vous demande", "id": "aku bertanya kepada kalian", "ur": "میں تم سب سے پوچھتا ہوں", "bn": "আমি তোমাদের জিজ্ঞেস করি", "fa": "از شما می‌پرسم"}}, {"text": "عَلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْرٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَا۠", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُتَكَلِّفِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "68:40", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5311.mp3", "translation": {"en": {"text": "Ask them (O Muhammad) which of them will vouch for that!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sor bakalım onlara, içlerinden ona kefil hangisi?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم ان سے پوچھو ان میں کون سا اس کا ضامن ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tanyakanlah kepada mereka: \"Siapakah di antara mereka yang bertanggung jawab terhadap keputusan yang diambil itu?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "سَلْهُمْ", "hit": true, "audio": "audio/b531699e7b7f8df0ef4b.m4a", "gloss": {"bs": "pitaj ih!", "en": "ask them!", "tr": "onlara sor!", "fr": "interroge-les !", "id": "tanyakan kepada mereka!", "ur": "ان سے پوچھو!", "bn": "তাদের জিজ্ঞাসা করো!", "fa": "از آنان بپرس!"}}, {"text": "أَيُّهُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "زَعِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "70:10", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5385.mp3", "translation": {"en": {"text": "And no familiar friend will ask a question of his friend", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Dost dostun halini soramaz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور کوئی دوست کسی دوست کی بات نہ پوچھے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan tidak ada seorang teman akrabpun menanyakan temannya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْـَٔلُ", "hit": true, "audio": "audio/fbbfa8ddc91b858bec02.m4a", "gloss": {"en": "he/it asks", "bs": "pita", "tr": "sorar", "fr": "il demande", "id": "dia bertanya", "ur": "وہ پوچھتا ہے", "bn": "সে জিজ্ঞেস করে", "fa": "می‌پرسد"}}, {"text": "حَمِيمٌ", "hit": false, "audio": null, "gloss": null}, {"text": "حَمِيمًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "70:1", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5376.mp3", "translation": {"en": {"text": "A questioner questioned concerning the doom about to fall", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bir isteyen, olacak azabı istedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ایک مانگنے والا وہ عذاب مانگتا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Seseorang telah meminta kedatangan azab yang akan menimpa,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "سَأَلَ", "hit": true, "audio": "audio/1e88cfa0e23a26a5701e.m4a", "gloss": {"bs": "pitao je (tražio je)", "en": "asked", "tr": "sordu", "fr": "il demanda", "id": "dia bertanya", "ur": "اس نے پوچھا", "bn": "সে জিজ্ঞাসা করল", "fa": "پرسید"}}, {"text": "سَآئِلٌۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بِعَذَابٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَاقِعٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:92", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1894.mp3", "translation": {"en": {"text": "Them, by thy Lord, We shall question, every one,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbin hakkı için biz, mutlaka onların hepsini yaptıklarından dolayı hesaba çekeceğiz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو تمہارے رب کی قسم ہم ضرور ان سب سے پوچھیں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka demi Tuhanmu, Kami pasti akan menanyai mereka semua,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَوَرَبِّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَسْـَٔلَنَّهُمْ", "hit": true, "audio": "audio/f06cfeb41388713fbcd1.m4a", "gloss": {"bs": "sigurno ćemo ih pitati", "en": "We will surely ask them", "tr": "onlara mutlaka soracağız", "fr": "Nous les interrogerons certes", "id": "sungguh Kami akan menanyai mereka", "ur": "ہم ضرور ان سے پوچھیں گے", "bn": "আমরা অবশ্যই তাদের জিজ্ঞাসা করব", "fa": "قطعاً از آنان خواهیم پرسید"}}, {"text": "أَجْمَعِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَسْـَٔلُكُمْ", "count": 11, "first": "6:90", "audio": "audio/dbe1acc5713b012b6913.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "I ask you (all)", "bs": "pitam vas", "tr": "size soruyorum", "fr": "je vous demande", "id": "aku bertanya kepada kalian", "ur": "میں تم سب سے پوچھتا ہوں", "bn": "আমি তোমাদের জিজ্ঞেস করি", "fa": "از شما می‌پرسم"}}, {"arabic": "يَسْـَٔلُونَكَ", "count": 9, "first": "2:189", "audio": "audio/7f8f7ba5909bc01beaaa.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["anta"], "mood": "indicative"}], "gloss": {"en": "they ask you", "bs": "pitaju te", "tr": "sana soruyorlar", "fr": "ils te demandent", "id": "mereka bertanya kepadamu", "ur": "وہ تم سے پوچھتے ہیں", "bn": "তারা তোমাকে জিজ্ঞেস করে", "fa": "از تو می‌پرسند"}}, {"arabic": "وَيَسْـَٔلُونَكَ", "count": 6, "first": "2:219", "audio": "audio/42b4609088127a0b657a.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "