ll}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْتَذِرُوا۟", "hit": true, "audio": "audio/eceefc2f3330284031d7.m4a", "gloss": {"en": "you (all) apologize", "bs": "ispričavate se", "tr": "özür dilersiniz", "fr": "que vous vous excusiez", "id": "kalian meminta maaf", "ur": "تم سب معذرت کرتے ہو", "bn": "তোমরা ক্ষমা চাও", "fa": "عذرخواهی کنید"}}, {"text": "ٱلْيَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُجْزَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْمَلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "77:36", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5658.mp3", "translation": {"en": {"text": "Nor are they suffered to put forth excuses.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kendilerine izin de verilmez ki, özür beyan etsinler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور نہ انہیں اجازت ملے کہ عذر کریں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan tidak diizinkan kepada mereka minta uzur sehingga mereka (dapat) minta uzur.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُؤْذَنُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَيَعْتَذِرُونَ", "hit": true, "audio": "audio/8aa126c8443663ac701e.m4a", "gloss": {"bs": "pa da se opravdavaju", "en": "so that they may make excuses", "tr": "böylece özür dilerler", "fr