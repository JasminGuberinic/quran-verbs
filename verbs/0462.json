12.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "خُونَا", "plain": "خُونَا", "quran": false, "notUsed": false, "spoken": "audio/0e51131d42191c76e7c0.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "خُونُوا", "plain": "خُونُوا", "quran": false, "notUsed": false, "spoken": "audio/8ff43ab515e2fff2547a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "خُنَّ", "plain": "خُنَّ", "quran": false, "notUsed": false, "spoken": "audio/83b5571f9a3c2ec233d1.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "8:27", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1187.mp3", "translation": {"en": {"text": "O ye who believe! Betray not Allah and His messenger, nor knowingly betray your trusts.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey iman edenler! Allah'a ve Resul'e hainlik etmeyiniz ki, bile bile kendi emanetlerinize hıyanet etmiş olmayasınız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے ایمان والو! اللہ اور رسول سے دغا نہ کرو اور نہ اپنی امانتوں میں دانستہ خیانت،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hai orang-orang yang beriman, janganlah kamu mengkhianati Allah dan Rasul (Muhammad) dan (juga) janganlah kamu mengkhianati amanat-amanat yang dipercayakan kepadamu, sedang kamu mengetahui.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَٰٓأَيُّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَخُونُوا۟", "hit": true, "audio": "audio/386b28f6b490b1f67a04.m4a", "gloss": {"bs": "iznevjerite", "en": "you (all) betray", "tr": "ihanet edersiniz", "fr": "vous trahissez", "id": "kalian berkhianat", "ur": "تم سب خیانت کرتے ہو", "bn": "তোমরা বিশ্বাসঘাতকতা কর", "fa": "شما خیانت می‌کنید"}}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلرَّسُولَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَخُونُوٓا۟", "hit": true, "audio": "audio/e5361521bcb60f794156.m4a", "gloss": {"bs": "i iznevjerite", "en": "and you (all) betray", "tr": "ve ihanet edersiniz", "fr": "et vous trahissez", "id": "dan kalian berkhianat", "ur": "اور تم سب خیانت کرتے ہو", "bn": "এবং তোমরা বিশ্বাসঘাতকতা কর", "fa": "و شما خیانت می‌کنید"}}, {"text": "أَمَٰنَٰتِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْلَمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:52", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1648.mp3", "translation": {"en": {"text": "(Then Joseph said: I asked for) this, that he (my lord) may know that I betrayed him not in secret, and that surely Allah guideth not the snare of the betrayers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Yusuf dedi ki): İşte bu şunun içindir: Bilsin ki, ben ona arkasından hainlik etmedim. Gerçekten Allah hainlerin hilesini başarıya ulaştırmaz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یوسف نے کہا یہ میں نے اس لیے کیا کہ عزیز کو معلوم ہوجائے کہ میں نے پیٹھ پیچھے اس کی خیانت نہ کی اور اللہ دغا بازوں کا مکر نہیں چلنے دیتا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Yusuf berkata): \"Yang demikian itu agar dia (Al Aziz) mengetahui bahwa sesungguhnya aku tidak berkhianat kepadanya di belakangnya, dan bahwasanya Allah tidak meridhai tipu daya orang-orang yang berkhianat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِيَعْلَمَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "لَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخُنْهُ", "hit": true, "audio": "audio/ccbbb7a437068ab64f04.m4a", "gloss": {"en": "I betray him", "bs": "izdajem ga", "tr": "ona ihanet ederim", "fr": "je le trahis", "id": "aku mengkhianatinya", "ur": "میں اس سے خیانت کرتا ہوں", "bn": "আমি তার সাথে বিশ্বাসঘাতকতা করি", "fa": "به او خیانت می‌کنم"}}, {"text": "بِٱلْغَيْبِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَهْدِى", "hit": false, "audio": null, "gloss": null}, {"text": "كَيْدَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَآئِنِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تَخُونُوا۟", "count": 1, "first": "8:27", "audio": "audio/386b28f6b490b1f67a04.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"bs": "iznevjerite", "en": "you (all) betray", "tr": "ihanet edersiniz", "fr": "vous trahissez", "id": "kalian berkhianat", "ur": "تم سب خیانت کرتے ہو", "bn": "তোমরা বিশ্বাসঘাতকতা কর", "fa": "شما خیانت می‌کنید"}}, {"arabic": "وَتَخُونُوٓا۟", "count": 1, "first": "8:27", "audio": "audio/e5361521bcb60f794156.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"bs": "i iznevjerite", "en": "and you (all) betray", "tr": "ve ihanet edersiniz", "fr": "et vous trahissez", "id": "dan kalian berkhianat", "ur": "اور تم سب خیانت کرتے ہو", "bn": "এবং তোমরা বিশ্বাসঘাতকতা কর", "fa": "و شما خیانت می‌کنید"}}, {"arabic": "خَانُوا۟", "count": 1, "first": "8:71", "audio": 