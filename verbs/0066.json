anti", "arabic": "ضِلِّي", "plain": "ضِلِّي", "quran": false, "notUsed": false, "spoken": "audio/fe68936cda9537b7ba47.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "ضِلَّا", "plain": "ضِلَّا", "quran": false, "notUsed": false, "spoken": "audio/3ba5ff4af4e74afcfc27.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ضِلُّوا", "plain": "ضِلُّوا", "quran": false, "notUsed": false, "spoken": "audio/d839a8342d3fa8d026dc.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِضْلِلْنَ", "plain": "اِضْلِلْنَ", "quran": false, "notUsed": false, "spoken": "audio/f7369a162976eba0229c.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "37:71", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3859.mp3", "translation": {"en": {"text": "And verily most of the men of old went astray before them,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun ki, onlardan öncekilerin çoğu sapıklıkta idiler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ان سے پہلے بہت سے اگلے گمراہ ہوئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya telah sesat sebelum mereka (Quraisy) sebagian besar dari orang-orang yang dahulu,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "ضَلَّ", "hit": true, "audio": "audio/f3e171c854aca7d9557f.m4a", "gloss": {"bs": "zalutala je", "en": "went astray", "tr": "saptı", "fr": "s'égara", "id": "tersesat", "ur": "وہ بھٹک گیا", "bn": "সে পথভ্রষ্ট হলো", "fa": "گمراه شد"}}, {"text": "قَبْلَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَكْثَرُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَوَّلِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:92", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2440.mp3", "translation": {"en": {"text": "He (Moses) said: O Aaron! What held thee back when thou didst see them gone astray,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Musa gelince kardeşine şöyle) dedi: \"Ey Harun! bunların sapıklığa düştüğünü gördüğün vakit, seni engelleyen ne oldu?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "موسیٰ نے کہا، اے ہارون! تمہیں کس بات نے روکا تھا جب تم نے انہیں گمراہ ہوتے دیکھا تھا کہ میرے پیچھے آتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berkata Musa: \"Hai Harun, apa yang menghalangi kamu ketika kamu melihat mereka telah sesat,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰهَٰرُونُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَنَعَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذْ", "hit": false, "audio": null, "gloss": null}, {"text": "رَأَيْتَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ضَلُّوٓا۟", "hit": true, "audio": "audio/e75a1124e41050d0a825.m4a", "gloss": {"en": "they went astray", "bs": "zalutali su", "tr": "saptılar", "fr": "ils se sont égarés", "id": "mereka telah tersesat", "ur": "وہ گمراہ ہوئے", "bn": "তারা পথভ্রষ্ট হলো", "fa": "گمراه شدند"}}]}, {"ref": "6:117", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/906.mp3", "translation": {"en": {"text": "Lo! thy Lord, He knoweth best who erreth from His way; and He knoweth best (who are) the rightly guided.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Şüphesiz ki Rabbin, yolundan kimlerin saptığını çok iyi bilir. O, doğru yolda olanları da çok iyi bilir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تیرا رب خوب جانتا ہے کہ کون بہکا اس کی راہ سے اور وہ خوب جانتا ہے ہدایت والوں کو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Tuhanmu, Dialah yang lebih mengetahui tentang orang yang tersesat dari jalan-Nya dan Dia lebih mengetahui tentang orang orang yang mendapat petunjuk.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْلَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَضِلُّ", "hit": true, "audio": "audio/50d120b0a8e56258a031.m4a", "gloss": {"bs": "zaluta", "en": "goes astray", "tr": "sapar", "fr": "s'égare", "id": "dia tersesat", "ur": "وہ بھٹکتا ہے", "bn": "সে পথভ্রষ্ট হয়", "fa": "گمراه می‌شود"}}, {"text": "عَن", "hit": false, "audio": null, "gloss": null}, {"text": "سَبِيلِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْلَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْمُهْتَدِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ضَلَّ", "count": 18, "first": "2:108", "audio": "audio/c63d0d9b111cc461275e.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "zalutala je", "en": "went astray", "tr": "saptı", "fr": "s'égara", "id": "tersesat", "ur": "وہ بھٹک گیا", "bn": "সে পথভ্রষ্ট হলো", "fa": "گمراه شد"}}, {"arabic": "ضَلُّوا۟", "count": 8, "first": "4:167", "audio": "audio/df50705a7d3289a10cd2.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "t