{"rank": 307, "root": "قوم", "form": 10, "lemma": "اسْتَقَامَ", "count": 10, "ayahCount": 9, "share": 0.05, "meaning": {"bs": "biti ispravan, ustrajati", "en": "to be upright, to go straight", "tr": "dosdoğru olmak, istikamet üzere olmak", "fr": "être droit, aller droit", "id": "istikamah, lurus", "ur": "سیدھا ہونا، سیدھی راہ چلنا", "bn": "সরল হওয়া, সোজা পথে চলা", "fa": "استوار بودن، راست رفتن"}, "lemmaSpoken": "audio/a3f86746ed1594eacfc1.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "اِسْتَقَامَ", "plain": "اِسْتَقَامَ", "quran": false, "notUsed": false, "spoken": "audio/a3f86746ed1594eacfc1.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَسْتَقِيمُ", "plain": "يَسْتَقِيمُ", "quran": false, "notUsed": false, "spoken": "audio/94c8b731370a35e01407.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱسْتَقِمْ", "plain": "اِسْتَقِمْ", "quran": true, "notUsed": false, "spoken": "audio/8c21e27ce7df24856184.m4a", "recited": "audio/6f8f198e252eacef5aaf.m4a", "recitedText": "فَٱسْتَقِمْ"}], "nouns": {"participle": {"lemma": "مُسْتَقِيم", "count": 37, "spoken": "audio/5bb82e271f8bb5d0ce5b.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "اِسْتَقَمْتُ", "plain": "اِسْتَقَمْتُ", "quran": false, "notUsed": false, "spoken": "audio/6368fb187649a66f4508.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "اِسْتَقَمْنَا", "plain": "اِسْتَقَمْنَا", "quran": false, "notUsed": false, "spoken": "audio/512494e13d865cb06a2b.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "اِسْتَقَمْتَ", "plain": "اِسْتَقَمْتَ", "quran": false, "notUsed": false, "spoken": "audio/9f2c816fef5ea2128354.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "اِسْتَقَمْتِ", "plain": "اِسْتَقَمْتِ", "quran": false, "notUsed": false, "spoken": "audio/ffe2c0c919a