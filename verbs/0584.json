en": "ayat/0584.en.json", "tr": "ayat/0584.tr.json", "ur": "ayat/0584.ur.json", "id": "ayat/0584.id.json"}, "sentences": [{"arabic": "نَزَغَ الْحَاسِدُ بَيْنَ الْأَخَوَيْنِ", "spoken": "audio/9f7d5e3823e93676dcbe.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Zavidnik je posijao razdor između dva brata.", "en": "The envious man sowed discord between the two brothers.", "bn": "হিংসুক লোকটি দুই ভাইয়ের মধ্যে বিভেদ সৃষ্টি করেছে।", "fa": "حسود میان دو برادر فتنه انگیخت.", "fr": "L'envieux a semé la discorde entre les deux frères.", "id": "Si pendengki itu menebar perselisihan di antara kedua saudara itu.", "tr": "Hasetçi iki kardeşin arasına fitne soktu.", "ur": "حاسد نے دونوں بھائیوں کے درمیان فساد ڈال دیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "نَزَغَ", "target": true, "translation": {"bs": "posijao je razdor", "en": "sowed discord", "bn": "বিভেদ সৃষ্টি করেছে", "fa": "فتنه انگیخت", "fr": "a semé la discorde", "id": "dia menebar perselisihan", "tr": "fitne soktu", "ur": "فساد ڈالا"}}, {"arabic": "الْحَاسِدُ", "target": false, "translation": {"bs": "zavidnik", "en": "the envious man", "bn": "হিংসুক", "fa": "حسود", "fr": "l'envieux", "id": "si pendengki itu", "tr": "hasetçi", "ur": "حاسد"}}, {"arabic": "بَيْنَ", "target": false, "translation": {"bs": "između", "en": "between", "bn": "মধ্যে", "fa": "میان", "fr": "entre", "id": "di antara", "tr": "arasında", "ur": "کے درمیان"}}, {"arabic": "الْأَخَوَيْنِ", "target": false, "translation": {"bs": "dva brata", "en": "the two brothers", "bn": "দুই ভাই", "fa": "دو برادر", "fr": "les deux frères", "id": "dua saudara itu", "tr": "iki kardeş", "ur": "دونوں بھائی"}}]}, {"arabic": "يَنْزَغُ النَّمَّامُ بَيْنَ النَّاسِ", "spoken": "audio/9b4f084ee67a9210c707.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Klevetnik sije razdor među ljudima.", "en": "The slanderer sows discord among people.", "bn": "চোগলখোর মানুষের মধ্যে বিভেদ সৃষ্টি করে।", "fa": "سخن‌چین میان مردم فتنه می‌انگیزد.", "fr": "Le calomniateur sème la discorde parmi les gens.", "id": "Si pemfitnah itu menebar perselisihan di antara orang-orang.", "tr": "İftiracı insanlar arasına fitne sokar.", "ur": "چغل خور لوگوں کے درمیان فساد ڈالتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَنْزَغُ", "target": true, "translation": {"bs": "sije razdor", "en": "sows discord", "bn": "বিভেদ সৃষ্টি করে", "fa": "فتنه می‌انگیزد", "fr": "sème la discorde", "id": "ia menebar perselisihan", "tr": "fitne sokar", "ur": "فساد ڈالتا ہے"}}, {"arabic": "النَّمَّامُ", "target": false, "translation": {"bs": "klevetnik", "en": "the slanderer", "bn": "চোগলখোর", "fa": "سخن‌چین", "fr": "le calomniateur", "id": "si pemfitnah itu", "tr": "iftiracı", "ur": "چغل خور"}}, {"arabic": "بَيْنَ", "target": false, "translation": {"bs": "među", "en": "among", "bn": "মধ্যে", "fa": "میان", "fr": "parmi", "id": "di antara", "tr": "arasında", "ur": "کے درمیان"}}, {"arabic": "النَّاسِ", "target": false, "translation": {"bs": "ljudima", "en": "the people", "bn": "মানুষের", "fa": "مردم", "fr": "les gens", "id": "orang-orang itu", "tr": "insanlar", "ur": "لوگ"}}]}]}