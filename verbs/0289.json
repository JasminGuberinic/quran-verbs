883203c63900091.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَنِبْ", "plain": "أَنِبْ", "quran": false, "notUsed": false, "spoken": "audio/dd0d966a6c4350a5b4fd.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَنِيبِي", "plain": "أَنِيبِي", "quran": false, "notUsed": false, "spoken": "audio/b38ec70c604787127623.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَنِيبَا", "plain": "أَنِيبَا", "quran": false, "notUsed": false, "spoken": "audio/060d2729b7c5a0f87447.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَنِيبُوٓا۟", "plain": "أَنِيبُوا", "quran": true, "notUsed": false, "spoken": "audio/48b56bf2a905d18a9bf5.m4a", "recited": "audio/337d27cabac7b394c7db.m4a", "recitedText": "وَأَنِيبُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَنِبْنَ", "plain": "أَنِبْنَ", "quran": false, "notUsed": false, "spoken": "audio/a89a7e9b42a62b1f3769.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "38:34", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4004.mp3", "translation": {"en": {"text": "And verily We tried Solomon, and set upon his throne a (mere) body. Then did he repent.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun ki Süleyman'ı imtihan da ettik ve tahtının üzerine bir ceset bıraktık. Sonra tekrar tevbe ile önceki haline döndü.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے سلیمان کو جانچا اور اس کے تخت پر ایک بے جان بدن ڈال دیا پھر رجوع لایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya Kami telah menguji Sulaiman dan Kami jadikan (dia) tergeletak di atas kursinya sebagai tubuh (yang lemah karena sakit), kemudian ia bertaubat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "سُلَيْمَٰنَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَلْقَيْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "كُرْسِيِّهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "جَسَدًا", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَابَ", "hit": true, "audio": "audio/b2354585e91d2bc16d64.m4a", "gloss": {"bs": "se obratio pokajanjem", "en": "he turned (in repentance)", "tr": "tövbe ile döndü", "fr": "il revint (repentant)", "id": "dia bertobat", "ur": "اس نے رجوع کیا", "bn": "সে ফিরে এল (তাওবা করে)", "fa": "بازگشت (با توبه)"}}]}, {"ref": "39:17", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4075.mp3", "translation": {"en": {"text": "And those who put away false gods lest they should worship them and turn to Allah in repentance, for them there are glad tidings. Therefor give good tidings (O Muhammad) to My bondmen", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Tağuttan, ona kulluk etmekten kaçınıp da tam gönülle Allah'a yönelenlere gelince, müjde onlaradır. Haydi müjdele kullarımı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جو بتوں کی پوجا سے بچے اور اللہ کی طرف رجوع ہوئے انہیں کے لیے خوشخبری ہے تو خوشی سناؤ میرے ان بندوں کو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang menjauhi thaghut (yaitu) tidak menyembahnya dan kembali kepada Allah, bagi mereka berita gembira; sebab itu sampaikanlah berita itu kepada hamba-hamba-Ku,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱجْتَنَبُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلطَّٰغُوتَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْبُدُوهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنَابُوٓا۟", "hit": true, "audio": "audio/afadb811fffb9051023b.m4a", "gloss": {"en": "and they turned (in repentance)", "bs": "i obratili su se", "tr": "ve tövbe ettiler", "fr": "et ils se sont repentis", "id": "dan mereka telah bertobat", "ur": "اور انہوں نے توبہ کی", "bn": "এবং তারা তাওবা করল", "fa": "و بازگشتند"}}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبُشْرَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "فَبَشِّرْ", "hit": false, "audio": null, "gloss": null}, {"text": "عِبَادِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَنَابَ", "count": 3, "first": "13:27", "audio": "audio/8ca36562fc38bf48d0fa.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "se obratio pokajanjem", "en": "he turned (in repentance)", "tr": "tövbe ile döndü", "fr": "il revint (repentant)", "id": "dia bertobat", "ur": "اس نے رجوع کیا", "bn": "সে ফিরে এল (তাওবা করে)", "fa": "بازگشت (با توبه)"}}, {"arabic": "أُنِيبُ", "count": 2, "first": "11:88", "audio": "audio/824c169801a88b1ea814.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "I turn (in repentance)", "bs": "obraćam se", "tr": "tövbe ederim", "fr": "je me repens", "id": "aku bertobat", "ur": "میں توبہ کرتا ہوں", "bn": "আমি তাওবা করি", "fa": "بازمی‌گردم"}}, {"arabic": "يُنِيبُ", "count": 2, "first": "40:13", "audio": "audio/5df437f009fed34e955e.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it turns (in repentance)", "bs": "obraća se", "tr": "tövbe eder", "fr": "il se repent", "id": "dia bertobat", "ur": "وہ توبہ کرتا ہے", "bn": "সে তাওবা করে", "fa": "بازمی‌گردد"}}, {"arabic": "وَأَنَابَ", "count": 1, "first": "38:24", "audio": "audio/752c4646e9b821bc63b9.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it turned (in repentance)", "bs": "i obratio se", "tr": "ve tövbe etti", "fr": "et il s'est repenti", "id": "dan dia telah bertobat", "ur": "اور اُس نے توبہ کی", "bn": "এবং সে তাওবা করল", "fa": "و بازگشت"}}, {"arabic": "وَأَنَابُوٓا۟", "count": 1, "first": "39:17", "audio": "audio/afadb811fffb9051023b.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "and they turned (in repentance)", "bs": "i obratili su se", "tr": "ve tövbe ettiler", "fr": "et ils se sont repentis", "id": "dan mereka telah bertobat", "ur": "اور انہوں نے توبہ کی", "bn": "এবং তারা তাওবা করল", "fa": "و بازگشتند"}}, {"arabic": "وَأَنِيبُوٓا۟", "count": 1, "first": "39:54", "audio": "audio/337d27cabac7b394c7db.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) turn (in repentance)!", "bs": "i obratite se!", "tr": "ve tövbe edin!", "fr": "et repentez-vous !", "id": "dan bertobatlah kalian!", "ur": "اور توبہ کرو!", "bn": "এবং তোমরা তাওবা কর!", "fa": "و بازگردید!"}}, {"arabic": "أَنَبْنَا", "count": 1, "first": "60:4", "audio": "audio/30d299a102dbbe5cc7ce.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "we turned (in repentance)", "bs": "obratili smo se", "tr": "tövbe ettik", "fr": "nous nous sommes repentis", "id": "kami telah bertobat", "ur": "ہم نے توبہ کی", "bn": "আমরা তাওবা করেছি", "fa": "بازگشتیم"}}], "ayatFile": "ayat/0289.json", "ayatTranslations": {"en": "ayat/0289.en.json", "tr": "ayat/0289.tr.json", "ur": "ayat/0289.ur.json", "id": "ayat/0289.id.json"}, "sentences": [{"arabic": "أَنَابَ أَخَاهُ فِي الْعَمَلِ", "spoken": "audio/067ed9a5225c4132d500.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Opunomoćio je brata na poslu.", "en": "He made his brother his deputy at work.", "bn": "সে কাজে তার ভাইকে নিজের প্রতিনিধি বানাল।", "fa": "برادرش را در کار جانشین خود کرد.", "fr": "Il a désigné son frère pour le remplacer au travail.", "id": "Dia menunjuk saudaranya sebagai wakilnya di tempat kerja.", "tr": "Kardeşini işte vekili yaptı.", "ur": "اس نے کام میں اپنے بھائی کو اپنا نائب بنایا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَنَابَ", "target": true, "translation": {"bs": "opunomoćio je", "en": "deputized", "bn": "প্রতিনিধিত্ব করল", "fa": "جانشین کرد", "fr": "a délégué", "id": "mewakilkan", "tr": "vekil kıldı", "ur": "اس نے نائب مقرر کیا"}}, {"arabic": "أَخَاهُ", "target": false, "translation": {"bs": "brata", "en": "his brother", "bn": "তার ভাই", "fa": "برادرش", "fr": "à son frère", "id": "saudaranya", "tr": "kardeşine", "ur": "اپنے بھائی کی"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "na", "en": "in", "bn": "মধ্যে", "fa": "در", "fr": "dans", "id": "di", "tr": "içinde", "ur": "میں"}}, {"arabic": "الْعَمَلِ", "target": false, "translation": {"bs": "poslu", "en": "the work", "bn": "কাজ", "fa": "کار", "fr": "du travail", "id": "pekerjaan", "tr": "iş", "ur": "کام"}}]}, {"arabic": "يُنِيبُ الْمُدِيرُ مُسَاعِدَهُ", "spoken": "audio/c87c1290c085f46849ba.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Direktor opunomoćuje svog pomoćnika.", "en": "The manager deputizes his assistant.", "bn": "ম্যানেজার তার সহকারীকে প্রতিনিধি করেন।", "fa": "مدیر دستیارش را جانشین می‌کند.", "fr": "Le directeur délègue son assistant.", "id": "Manajer menunjuk asistennya sebagai wakil.", "tr": "Müdür yardımcısını vekil kılar.", "ur": "مینیجر