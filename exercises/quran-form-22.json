[{"id":"qatala-2-4-76-2","words":["verb:qatala-2"],"options":[{"bs":"bore se","en":"they fight"},{"bs":"borite se","en":"you (all) fight"},{"bs":"(da) su se borili protiv vas","en":"(if) they had fought you"},{"bs":"borite se protiv njih!","en":"(you all) fight them!"}],"ref":"4:76","answerWord":"يُقَٰتِلُونَ","answerSound":"audio/a06c970d5ca614e0c6af.m4a","quranTranslation":{"text":"Those who believe do battle for the cause of Allah; and those who disbelieve do battle for the cause of idols. So fight the minions of the devil. Lo! the devil's strategy is ever weak.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["ٱلَّذِينَ","ءَامَنُوا۟","يُقَٰتِلُونَ","فِى","سَبِيلِ","ٱللَّهِ","وَٱلَّذِينَ","كَفَرُوا۟","يُقَٰتِلُونَ","فِى","سَبِيلِ","ٱلطَّٰغُوتِ","فَقَٰتِلُوٓا۟","أَوْلِيَآءَ","ٱلشَّيْطَٰنِ","إِنَّ","كَيْدَ","ٱلشَّيْطَٰنِ","كَانَ","ضَعِيفًا"],"marked":[2,8],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-2-190-5","words":["verb:qatala-2"],"options":[{"bs":"bore se protiv vas","en":"they fight you (all)"},{"bs":"borite se protiv njih!","en":"(you all) fight them!"},{"bs":"borite se!","en":"(you all) fight!"},{"bs":"borio se","en":"he/it fought"}],"ref":"2:190","answerWord":"يُقَٰتِلُونَكُمْ","answerSound":"audio/e7a0d028a8ef20fabb01.m4a","quranTranslation":{"text":"Fight in the way of Allah against those who fight against you, but begin not hostilities. Lo! Allah loveth not aggressors.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["وَقَٰتِلُوا۟","فِى","سَبِيلِ","ٱللَّهِ","ٱلَّذِينَ","يُقَٰتِلُونَكُمْ","وَلَا","تَعْتَدُوٓا۟","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","ٱلْمُعْتَدِينَ"],"marked":[5],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-2-244-0","words":["verb:qatala-2"],"options":[{"bs":"i borite se!","en":"and fight!"},{"bs":"borili su se protiv vas","en":"they fought you (all)"},{"bs":"(da) su se borili protiv vas","en":"(if) they had fought you"},{"bs":"bore se","en":"they fight"}],"ref":"2:244","answerWord":"وَقَٰتِلُوا۟","answerSound":"audio/1949d721d7656dd1c4d0.m4a","quranTranslation":{"text":"Fight in the way of Allah, and know that Allah is Hearer, Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["وَقَٰتِلُوا۟","فِى","سَبِيلِ","ٱللَّهِ","وَٱعْلَمُوٓا۟","أَنَّ","ٱللَّهَ","سَمِيعٌ","عَلِيمٌ"],"marked":[0],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-2-191-20","words":["verb:qatala-2"],"options":[{"bs":"borili su se protiv vas","en":"they fought you (all)"},{"bs":"i borite se protiv njih!","en":"and (you all) fight them!"},{"bs":"borite se!","en":"(you all) fight!"},{"bs":"bori se","en":"he/it fights"}],"ref":"2:191","answerWord":"قَٰتَلُوكُمْ","answerSound":"audio/3bfbbe5dbe4f3ef3dd4f.m4a","quranTranslation":{"text":"And slay them wherever ye find them, and drive them out of the places whence they drove you out, for persecution is worse than slaughter. And fight not with them at the Inviolable Place of Worship until they first attack you there, but if they attack you (there) then slay them. Such is the reward of disbelievers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["وَٱقْتُلُوهُمْ","حَيْثُ","ثَقِفْتُمُوهُمْ","وَأَخْرِجُوهُم","مِّنْ","حَيْثُ","أَخْرَجُوكُمْ","وَٱلْفِتْنَةُ","أَشَدُّ","مِنَ","ٱلْقَتْلِ","وَلَا","تُقَٰتِلُوهُمْ","عِندَ","ٱلْمَسْجِدِ","ٱلْحَرَامِ","حَتَّىٰ","يُقَٰتِلُوكُمْ","فِيهِ","فَإِن","قَٰتَلُوكُمْ","فَٱقْتُلُوهُمْ","كَذَٰلِكَ","جَزَآءُ","ٱلْكَٰفِرِينَ"],"marked":[20],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-2-193-0","words":["verb:qatala-2"],"options":[{"bs":"i borite se protiv njih!","en":"and (you all) fight them!"},{"bs":"borilo se protiv vas","en":"you (all) were fought"},{"bs":"borilo se protiv njih","en":"they were fought"},{"bs":"borili su se protiv vas","en":"they fought you (all)"}],"ref":"2:193","answerWord":"وَقَٰتِلُوهُمْ","answerSound":"audio/1a3e9b4abfbfc3a618b7.m4a","quranTranslation":{"text":"And fight them until persecution is no more, and religion is for Allah. But if they desist, then let there be no hostility except against wrong-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["وَقَٰتِلُوهُمْ","حَتَّىٰ","لَا","تَكُونَ","فِتْنَةٌ","وَيَكُونَ","ٱلدِّينُ","لِلَّهِ","فَإِنِ","ٱنتَهَوْا۟","فَلَا","عُدْوَٰنَ","إِلَّا","عَلَى","ٱلظَّٰلِمِينَ"],"marked":[0],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-4-76-12","words":["verb:qatala-2"],"options":[{"bs":"pa se borite!","en":"so (you all) fight!"},{"bs":"borimo se","en":"we fight"},{"bs":"borio se","en":"he/it fought"},{"bs":"borili su se protiv vas","en":"they fought you (all)"}],"ref":"4:76","answerWord":"فَقَٰتِلُوٓا۟","answerSound":"audio/8dd5d3537d0c5a0e886c.m4a","quranTranslation":{"text":"Those who believe do battle for the cause of Allah; and those who disbelieve do battle for the cause of idols. So fight the minions of the devil. Lo! the devil's strategy is ever weak.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["ٱلَّذِينَ","ءَامَنُوا۟","يُقَٰتِلُونَ","فِى","سَبِيلِ","ٱللَّهِ","وَٱلَّذِينَ","كَفَرُوا۟","يُقَٰتِلُونَ","فِى","سَبِيلِ","ٱلطَّٰغُوتِ","فَقَٰتِلُوٓا۟","أَوْلِيَآءَ","ٱلشَّيْطَٰنِ","إِنَّ","كَيْدَ","ٱلشَّيْطَٰنِ","كَانَ","ضَعِيفًا"],"marked":[12],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-9-30-19","words":["verb:qatala-2"],"options":[{"bs":"borio se protiv njih","en":"he/it fought them"},{"bs":"i borite se!","en":"and fight!"},{"bs":"borite se protiv njih!","en":"(you all) fight them!"},{"bs":"borite se","en":"you (all) fight"}],"ref":"9:30","answerWord":"قَٰتَلَهُمُ","answerSound":"audio/c8445a800484164f6a80.m4a","quranTranslation":{"text":"And the Jews say: Ezra is the son of Allah, and the Christians say: The Messiah is the son of Allah. That is their saying with their mouths. They imitate the saying of those who disbelieved of old. Allah (Himself) fighteth against them. How perverse are they!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["وَقَالَتِ","ٱلْيَهُودُ","عُزَيْرٌ","ٱبْنُ","ٱللَّهِ","وَقَالَتِ","ٱلنَّصَٰرَى","ٱلْمَسِيحُ","ٱبْنُ","ٱللَّهِ","ذَٰلِكَ","قَوْلُهُم","بِأَفْوَٰهِهِمْ","يُضَٰهِـُٔونَ","قَوْلَ","ٱلَّذِينَ","كَفَرُوا۟","مِن","قَبْلُ","قَٰتَلَهُمُ","ٱللَّهُ","أَنَّىٰ","يُؤْفَكُونَ"],"marked":[19],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-2-191-12","words":["verb:qatala-2"],"options":[{"bs":"borite se protiv njih","en":"you (all) fight them"},{"bs":"pa se borite!","en":"so (you all) fight!"},{"bs":"borili su se","en":"they fought"},{"bs":"borilo se protiv njih","en":"they were fought"}],"ref":"2:191","answerWord":"تُقَٰتِلُوهُمْ","answerSound":"audio/5db626255ea694aaf4ac.m4a","quranTranslation":{"text":"And slay them wherever ye find them, and drive them out of the places whence they drove you out, for persecution is worse than slaughter. And fight not with them at the Inviolable Place of Worship until they first attack you there, but if they attack you (there) then slay them. Such is the reward of disbelievers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["وَٱقْتُلُوهُمْ","حَيْثُ","ثَقِفْتُمُوهُمْ","وَأَخْرِجُوهُم","مِّنْ","حَيْثُ","أَخْرَجُوكُمْ","وَٱلْفِتْنَةُ","أَشَدُّ","مِنَ","ٱلْقَتْلِ","وَلَا","تُقَٰتِلُوهُمْ","عِندَ","ٱلْمَسْجِدِ","ٱلْحَرَامِ","حَتَّىٰ","يُقَٰتِلُوكُمْ","فِيهِ","فَإِن","قَٰتَلُوكُمْ","فَٱقْتُلُوهُمْ","كَذَٰلِكَ","جَزَآءُ","ٱلْكَٰفِرِينَ"],"marked":[12],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-3-146-3","words":["verb:qatala-2"],"options":[{"bs":"borio se","en":"he/it fought"},{"bs":"bore se protiv vas","en":"they fight you (all)"},{"bs":"borimo se","en":"we fight"},{"bs":"borite se","en":"you (all) fight"}],"ref":"3:146","answerWord":"قَٰتَلَ","answerSound":"audio/5fb674ec94c61ad1a1be.m4a","quranTranslation":{"text":"And with how many a prophet have there been a number of devoted men who fought (beside him). They quailed not for aught that befell them in the way of Allah, nor did they weaken, nor were they brought low. Allah loveth the steadfast.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["وَكَأَيِّن","مِّن","نَّبِىٍّ","قَٰتَلَ","مَعَهُۥ","رِبِّيُّونَ","كَثِيرٌ","فَمَا","وَهَنُوا۟","لِمَآ","أَصَابَهُمْ","فِى","سَبِيلِ","ٱللَّهِ","وَمَا","ضَعُفُوا۟","وَمَا","ٱسْتَكَانُوا۟","وَٱللَّهُ","يُحِبُّ","ٱلصَّٰبِرِينَ"],"marked":[3],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-4-74-0","words":["verb:qatala-2"],"options":[{"bs":"pa neka se bori","en":"so let him fight"},{"bs":"borite se","en":"you (all) fight"},{"bs":"borilo se protiv njih","en":"they were fought"},{"bs":"borio se","en":"he/it fought"}],"ref":"4:74","answerWord":"فَلْيُقَٰتِلْ","answerSound":"audio/02226b98042460f3126e.m4a","quranTranslation":{"text":"Let those fight in the way of Allah who sell the life of this world for the other. Whoso fighteth in the way of Allah, be he slain or be he victorious, on him We shall bestow a vast reward.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["فَلْيُقَٰتِلْ","فِى","سَبِيلِ","ٱللَّهِ","ٱلَّذِينَ","يَشْرُونَ","ٱلْحَيَوٰةَ","ٱلدُّنْيَا","بِٱلْءَاخِرَةِ","وَمَن","يُقَٰتِلْ","فِى","سَبِيلِ","ٱللَّهِ","فَيُقْتَلْ","أَوْ","يَغْلِبْ","فَسَوْفَ","نُؤْتِيهِ","أَجْرًا","عَظِيمًا"],"marked":[0],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-4-74-10","words":["verb:qatala-2"],"options":[{"bs":"bori se","en":"he/it fights"},{"bs":"(da) su se borili protiv vas","en":"(if) they had fought you"},{"bs":"borite se protiv njih","en":"you (all) fight them"},{"bs":"borilo se protiv njih","en":"they were fought"}],"ref":"4:74","answerWord":"يُقَٰتِلْ","answerSound":"audio/789cf94ae71c06e247f8.m4a","quranTranslation":{"text":"Let those fight in the way of Allah who sell the life of this world for the other. Whoso fighteth in the way of Allah, be he slain or be he victorious, on him We shall bestow a vast reward.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["فَلْيُقَٰتِلْ","فِى","سَبِيلِ","ٱللَّهِ","ٱلَّذِينَ","يَشْرُونَ","ٱلْحَيَوٰةَ","ٱلدُّنْيَا","بِٱلْءَاخِرَةِ","وَمَن","يُقَٰتِلْ","فِى","سَبِيلِ","ٱللَّهِ","فَيُقْتَلْ","أَوْ","يَغْلِبْ","فَسَوْفَ","نُؤْتِيهِ","أَجْرًا","عَظِيمًا"],"marked":[10],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-9-14-0","words":["verb:qatala-2"],"options":[{"bs":"borite se protiv njih!","en":"(you all) fight them!"},{"bs":"bore se protiv vas","en":"they fight you (all)"},{"bs":"borite se","en":"you (all) fight"},{"bs":"borilo se protiv njih","en":"they were fought"}],"ref":"9:14","answerWord":"قَٰتِلُوهُمْ","answerSound":"audio/61cf82821c1fc5c14d26.m4a","quranTranslation":{"text":"Fight them! Allah will chastise them at your hands, and He will lay them low and give you victory over them, and He will heal the breasts of folk who are believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["قَٰتِلُوهُمْ","يُعَذِّبْهُمُ","ٱللَّهُ","بِأَيْدِيكُمْ","وَيُخْزِهِمْ","وَيَنصُرْكُمْ","عَلَيْهِمْ","وَيَشْفِ","صُدُورَ","قَوْمٍ","مُّؤْمِنِينَ"],"marked":[0],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-22-39-2","words":["verb:qatala-2"],"options":[{"bs":"protiv njih se bori","en":"they are fought against"},{"bs":"borili su se","en":"they fought"},{"bs":"borilo se protiv vas","en":"you (all) were fought"},{"bs":"borite se protiv njih","en":"you (all) fight them"}],"ref":"22:39","answerWord":"يُقَٰتَلُونَ","answerSound":"audio/b8e3dad08fc321112e05.m4a","quranTranslation":{"text":"Sanction is given unto those who fight because they have been wronged; and Allah is indeed Able to give them victory;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["أُذِنَ","لِلَّذِينَ","يُقَٰتَلُونَ","بِأَنَّهُمْ","ظُلِمُوا۟","وَإِنَّ","ٱللَّهَ","عَلَىٰ","نَصْرِهِمْ","لَقَدِيرٌ"],"marked":[2],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-33-20-20","words":["verb:qatala-2"],"options":[{"bs":"borili su se","en":"they fought"},{"bs":"borimo se","en":"we fight"},{"bs":"protiv njih se bori","en":"they are fought against"},{"bs":"(da) su se borili protiv vas","en":"(if) they had fought you"}],"ref":"33:20","answerWord":"قَٰتَلُوٓا۟","answerSound":"audio/4afbd408590eefe93b19.m4a","quranTranslation":{"text":"They hold that the clans have not retired (for good); and if the clans should advance (again), they would fain be in the desert with the wandering Arabs, asking for the news of you; and if they were among you, they would not give battle, save a little.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["يَحْسَبُونَ","ٱلْأَحْزَابَ","لَمْ","يَذْهَبُوا۟","وَإِن","يَأْتِ","ٱلْأَحْزَابُ","يَوَدُّوا۟","لَوْ","أَنَّهُم","بَادُونَ","فِى","ٱلْأَعْرَابِ","يَسْـَٔلُونَ","عَنْ","أَنۢبَآئِكُمْ","وَلَوْ","كَانُوا۟","فِيكُم","مَّا","قَٰتَلُوٓا۟","إِلَّا","قَلِيلًا"],"marked":[20],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-48-16-10","words":["verb:qatala-2"],"options":[{"bs":"borite se protiv njih","en":"you (all) fight them"},{"bs":"borili su se","en":"they fought"},{"bs":"borimo se","en":"we fight"},{"bs":"i borite se protiv njih!","en":"and (you all) fight them!"}],"ref":"48:16","answerWord":"تُقَٰتِلُونَهُمْ","answerSound":"audio/3c584e8571a3e601dfb5.m4a","quranTranslation":{"text":"Say unto those of the wandering Arabs who were left behind: Ye will be called against a folk of mighty prowess, to fight them until they surrender; and if ye obey, Allah will give you a fair reward; but if ye turn away as ye did turn away before, He will punish you with a painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["قُل","لِّلْمُخَلَّفِينَ","مِنَ","ٱلْأَعْرَابِ","سَتُدْعَوْنَ","إِلَىٰ","قَوْمٍ","أُو۟لِى","بَأْسٍ","شَدِيدٍ","تُقَٰتِلُونَهُمْ","أَوْ","يُسْلِمُونَ","فَإِن","تُطِيعُوا۟","يُؤْتِكُمُ","ٱللَّهُ","أَجْرًا","حَسَنًا","وَإِن","تَتَوَلَّوْا۟","كَمَا","تَوَلَّيْتُم","مِّن","قَبْلُ","يُعَذِّبْكُمْ","عَذَابًا","أَلِيمًا"],"marked":[10],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-48-22-1","words":["verb:qatala-2"],"options":[{"bs":"(da) su se borili protiv vas","en":"(if) they had fought you"},{"bs":"borio se protiv njih","en":"he/it fought them"},{"bs":"borili su se protiv vas","en":"they fought you (all)"},{"bs":"borili su se","en":"they fought"}],"ref":"48:22","answerWord":"قَٰتَلَكُمُ","answerSound":"audio/cf744bfa96ae2f52fa1a.m4a","quranTranslation":{"text":"And if those who disbelieve join battle with you they will take to flight, and afterward they will find no protecting friend nor helper.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["وَلَوْ","قَٰتَلَكُمُ","ٱلَّذِينَ","كَفَرُوا۟","لَوَلَّوُا۟","ٱلْأَدْبَٰرَ","ثُمَّ","لَا","يَجِدُونَ","وَلِيًّا","وَلَا","نَصِيرًا"],"marked":[1],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-49-9-12","words":["verb:qatala-2"],"options":[{"bs":"pa se borite!","en":"so (you all) fight!"},{"bs":"protiv njih se bori","en":"they are fought against"},{"bs":"i borili su se","en":"and they fought"},{"bs":"bore se","en":"they fight"}],"ref":"49:9","answerWord":"فَقَٰتِلُوا۟","answerSound":"audio/2ea76f621bd7aa9350c8.m4a","quranTranslation":{"text":"And if two parties of believers fall to fighting, then make peace between them. And if one party of them doeth wrong to the other, fight ye that which doeth wrong till it return unto the ordinance of Allah; then, if it return, make peace between them justly, and act equitably. Lo! Allah loveth the equitable.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["وَإِن","طَآئِفَتَانِ","مِنَ","ٱلْمُؤْمِنِينَ","ٱقْتَتَلُوا۟","فَأَصْلِحُوا۟","بَيْنَهُمَا","فَإِنۢ","بَغَتْ","إِحْدَىٰهُمَا","عَلَى","ٱلْأُخْرَىٰ","فَقَٰتِلُوا۟","ٱلَّتِى","تَبْغِى","حَتَّىٰ","تَفِىٓءَ","إِلَىٰٓ","أَمْرِ","ٱللَّهِ","فَإِن","فَآءَتْ","فَأَصْلِحُوا۟","بَيْنَهُمَا","بِٱلْعَدْلِ","وَأَقْسِطُوٓا۟","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلْمُقْسِطِينَ"],"marked":[12],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-59-11-22","words":["verb:qatala-2"],"options":[{"bs":"borilo se protiv vas","en":"you (all) were fought"},{"bs":"borite se!","en":"(you all) fight!"},{"bs":"i borili su se","en":"and they fought"},{"bs":"borite se protiv njih!","en":"(you all) fight them!"}],"ref":"59:11","answerWord":"قُوتِلْتُمْ","answerSound":"audio/2dc19fbe1e449ecd369c.m4a","quranTranslation":{"text":"Hast thou not observed those who are hypocrites, (how) they tell their brethren who disbelieve among the People of the Scripture: If ye are driven out, we surely will go out with you, and we will never obey anyone against you, and if ye are attacked we verily will help you. And Allah beareth witness that they verily are liars.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["أَلَمْ","تَرَ","إِلَى","ٱلَّذِينَ","نَافَقُوا۟","يَقُولُونَ","لِإِخْوَٰنِهِمُ","ٱلَّذِينَ","كَفَرُوا۟","مِنْ","أَهْلِ","ٱلْكِتَٰبِ","لَئِنْ","أُخْرِجْتُمْ","لَنَخْرُجَنَّ","مَعَكُمْ","وَلَا","نُطِيعُ","فِيكُمْ","أَحَدًا","أَبَدًا","وَإِن","قُوتِلْتُمْ","لَنَنصُرَنَّكُمْ","وَٱللَّهُ","يَشْهَدُ","إِنَّهُمْ","لَكَٰذِبُونَ"],"marked":[22],"facts":{"verb":"قاتَلَ"}},{"id":"qatala-2-59-12-6","words":["verb:qatala-2"],"options":[{"bs":"borilo se protiv njih","en":"they were fought"},{"bs":"borite se","en":"you (all) fight"},{"bs":"borilo se protiv vas","en":"you (all) were fought"},{"bs":"bore se","en":"they fight"}],"ref":"59:12","answerWord":"قُوتِلُوا۟","answerSound":"audio/752aae79383ad67f3b11.m4a","quranTranslation":{"text":"(For) indeed if they are driven out they go not out with them, and indeed if they are attacked they help them not, and indeed if they had helped them they would have turned and fled, and then they would not have been victorious.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"boriti se","en":"to fight"},"passage":["لَئِنْ","أُخْرِجُوا۟","لَا","يَخْرُجُونَ","مَعَهُمْ","وَلَئِن","قُوتِلُوا۟","لَا","يَنصُرُونَهُمْ","وَلَئِن","نَّصَرُوهُمْ","لَيُوَلُّنَّ","ٱلْأَدْبَٰرَ","ثُمَّ","لَا","يُنصَرُونَ"],"marked":[6],"facts":{"verb":"قاتَلَ"}},{"id":"nada-19-3-1","words":["verb:nada"],"options":[{"bs":"pozvao je","en":"he/it called"},{"bs":"pozivaju te","en":"they call you"},{"bs":"pa ju je pozvao","en":"so he/it called her"},{"bs":"pozvat će ih","en":"He will call them"}],"ref":"19:3","answerWord":"نَادَىٰ","answerSound":"audio/06d1e603ab48634882af.m4a","quranTranslation":{"text":"When he cried unto his Lord a cry in secret,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["إِذْ","نَادَىٰ","رَبَّهُۥ","نِدَآءً","خَفِيًّا"],"marked":[1],"facts":{"verb":"نادَى"}},{"id":"nada-20-11-2","words":["verb:nada"],"options":[{"bs":"pozvan je","en":"he/it was called"},{"bs":"i pozvao ih je","en":"and he/it called them (two)"},{"bs":"i dozvali smo ga","en":"and We called him"},{"bs":"pozvat će ih","en":"He will call them"}],"ref":"20:11","answerWord":"نُودِىَ","answerSound":"audio/9a6ad106cba8b001c52d.m4a","quranTranslation":{"text":"And when he reached it, he was called by name: O Moses!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["فَلَمَّآ","أَتَىٰهَا","نُودِىَ","يَٰمُوسَىٰٓ"],"marked":[2],"facts":{"verb":"نادَى"}},{"id":"nada-28-65-1","words":["verb:nada"],"options":[{"bs":"pozvat će ih","en":"He will call them"},{"bs":"pa ju je pozvao","en":"so he/it called her"},{"bs":"poziva","en":"he/it calls"},{"bs":"pa je pozvao","en":"so he/it called"}],"ref":"28:65","answerWord":"يُنَادِيهِمْ","answerSound":"audio/b49da8cc2ef31ea3fbf8.m4a","quranTranslation":{"text":"And on the Day when He will call unto them and say: What answer gave ye to the messengers?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["وَيَوْمَ","يُنَادِيهِمْ","فَيَقُولُ","مَاذَآ","أَجَبْتُمُ","ٱلْمُرْسَلِينَ"],"marked":[1],"facts":{"verb":"نادَى"}},{"id":"nada-7-44-0","words":["verb:nada"],"options":[{"bs":"i pozvao je","en":"and he/it called"},{"bs":"poziva","en":"he/it calls"},{"bs":"pozovite!","en":"(you all) call!"},{"bs":"i pozvali su","en":"and they called"}],"ref":"7:44","answerWord":"وَنَادَىٰٓ","answerSound":"audio/345cf8b30a764a410176.m4a","quranTranslation":{"text":"And the dwellers of the Garden cry unto the dwellers of the Fire: We have found that which our Lord promised us (to be) the Truth. Have ye (too) found that which your Lord promised the Truth? They say: Yea, verily. And a crier in between them crieth: The curse of Allah is on evil-doers,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["وَنَادَىٰٓ","أَصْحَٰبُ","ٱلْجَنَّةِ","أَصْحَٰبَ","ٱلنَّارِ","أَن","قَدْ","وَجَدْنَا","مَا","وَعَدَنَا","رَبُّنَا","حَقًّا","فَهَلْ","وَجَدتُّم","مَّا","وَعَدَ","رَبُّكُمْ","حَقًّا","قَالُوا۟","نَعَمْ","فَأَذَّنَ","مُؤَذِّنٌۢ","بَيْنَهُمْ","أَن","لَّعْنَةُ","ٱللَّهِ","عَلَى","ٱلظَّٰلِمِينَ"],"marked":[0],"facts":{"verb":"نادَى"}},{"id":"nada-11-42-6","words":["verb:nada"],"options":[{"bs":"i pozvao je","en":"and he/it called"},{"bs":"pozvali ste","en":"you (all) called"},{"bs":"pa su pozvali","en":"so they called"},{"bs":"pozivaju te","en":"they call you"}],"ref":"11:42","answerWord":"وَنَادَىٰ","answerSound":"audio/1bafab45ca211109267c.m4a","quranTranslation":{"text":"And it sailed with them amid waves like mountains, and Noah cried unto his son - and he was standing aloof - O my son! Come ride with us, and be not with the disbelievers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["وَهِىَ","تَجْرِى","بِهِمْ","فِى","مَوْجٍ","كَٱلْجِبَالِ","وَنَادَىٰ","نُوحٌ","ٱبْنَهُۥ","وَكَانَ","فِى","مَعْزِلٍ","يَٰبُنَىَّ","ٱرْكَب","مَّعَنَا","وَلَا","تَكُن","مَّعَ","ٱلْكَٰفِرِينَ"],"marked":[6],"facts":{"verb":"نادَى"}},{"id":"nada-7-46-8","words":["verb:nada"],"options":[{"bs":"i pozvali su","en":"and they called"},{"bs":"pozvao nas je","en":"he/it called us"},{"bs":"bivaju pozvani","en":"they are called"},{"bs":"i pozvao ih je","en":"and he/it called them (two)"}],"ref":"7:46","answerWord":"وَنَادَوْا۟","answerSound":"audio/6867ab84e277a6565589.m4a","quranTranslation":{"text":"Between them is a veil. And on the Heights are men who know them all by their marks. And they call unto the dwellers of the Garden: Peace be unto you! They enter it not although they hope (to enter).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["وَبَيْنَهُمَا","حِجَابٌ","وَعَلَى","ٱلْأَعْرَافِ","رِجَالٌ","يَعْرِفُونَ","كُلًّۢا","بِسِيمَىٰهُمْ","وَنَادَوْا۟","أَصْحَٰبَ","ٱلْجَنَّةِ","أَن","سَلَٰمٌ","عَلَيْكُمْ","لَمْ","يَدْخُلُوهَا","وَهُمْ","يَطْمَعُونَ"],"marked":[8],"facts":{"verb":"نادَى"}},{"id":"nada-37-104-0","words":["verb:nada"],"options":[{"bs":"i dozvali smo ga","en":"and We called him"},{"bs":"i pozvali su","en":"and they called"},{"bs":"pa je pozvao","en":"so he/it called"},{"bs":"pozvan je","en":"he/it was called"}],"ref":"37:104","answerWord":"وَنَٰدَيْنَٰهُ","answerSound":"audio/5d9e7a752dcec542ff75.m4a","quranTranslation":{"text":"We called unto him: O Abraham!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["وَنَٰدَيْنَٰهُ","أَن","يَٰٓإِبْرَٰهِيمُ"],"marked":[0],"facts":{"verb":"نادَى"}},{"id":"nada-21-87-10","words":["verb:nada"],"options":[{"bs":"pa je pozvao","en":"so he/it called"},{"bs":"pozvali smo","en":"we called"},{"bs":"pozivaju te","en":"they call you"},{"bs":"pa su pozvali","en":"so they called"}],"ref":"21:87","answerWord":"فَنَادَىٰ","answerSound":"audio/a0fd6a5e9ce8e0385aa9.m4a","quranTranslation":{"text":"And (mention) Dhu'n-Nun, when he went off in anger and deemed that We had no power over him, but he cried out in the darkness, saying: There is no Allah save Thee. Be Thou Glorified! Lo! I have been a wrong-doer.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["وَذَا","ٱلنُّونِ","إِذ","ذَّهَبَ","مُغَٰضِبًا","فَظَنَّ","أَن","لَّن","نَّقْدِرَ","عَلَيْهِ","فَنَادَىٰ","فِى","ٱلظُّلُمَٰتِ","أَن","لَّآ","إِلَٰهَ","إِلَّآ","أَنتَ","سُبْحَٰنَكَ","إِنِّى","كُنتُ","مِنَ","ٱلظَّٰلِمِينَ"],"marked":[10],"facts":{"verb":"نادَى"}},{"id":"nada-40-10-3","words":["verb:nada"],"options":[{"bs":"bivaju pozvani","en":"they are called"},{"bs":"pa ga je pozvala","en":"so she/it called him"},{"bs":"pozvali ste","en":"you (all) called"},{"bs":"i pozvali su","en":"and they called"}],"ref":"40:10","answerWord":"يُنَادَوْنَ","answerSound":"audio/189dd175c9935d5cec95.m4a","quranTranslation":{"text":"Lo! (on that day) those who disbelieve are informed by proclamation: Verily Allah's abhorrence is more terrible than your abhorrence one of another, when ye were called unto the faith but did refuse.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["إِنَّ","ٱلَّذِينَ","كَفَرُوا۟","يُنَادَوْنَ","لَمَقْتُ","ٱللَّهِ","أَكْبَرُ","مِن","مَّقْتِكُمْ","أَنفُسَكُمْ","إِذْ","تُدْعَوْنَ","إِلَى","ٱلْإِيمَٰنِ","فَتَكْفُرُونَ"],"marked":[3],"facts":{"verb":"نادَى"}},{"id":"nada-3-39-0","words":["verb:nada"],"options":[{"bs":"pa ga je pozvala","en":"so she/it called him"},{"bs":"pozvao ga je","en":"he/it called him"},{"bs":"pozovite!","en":"(you all) call!"},{"bs":"pozvao je","en":"he/it called"}],"ref":"3:39","answerWord":"فَنَادَتْهُ","answerSound":"audio/86f22ba61e8678e0e777.m4a","quranTranslation":{"text":"And the angels called to him as he stood praying in the sanctuary: Allah giveth thee glad tidings of (a son whose name is) John, (who cometh) to confirm a word from Allah lordly, chaste, a prophet of the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["فَنَادَتْهُ","ٱلْمَلَٰٓئِكَةُ","وَهُوَ","قَآئِمٌ","يُصَلِّى","فِى","ٱلْمِحْرَابِ","أَنَّ","ٱللَّهَ","يُبَشِّرُكَ","بِيَحْيَىٰ","مُصَدِّقًۢا","بِكَلِمَةٍ","مِّنَ","ٱللَّهِ","وَسَيِّدًا","وَحَصُورًا","وَنَبِيًّا","مِّنَ","ٱلصَّٰلِحِينَ"],"marked":[0],"facts":{"verb":"نادَى"}},{"id":"nada-3-193-4","words":["verb:nada"],"options":[{"bs":"poziva","en":"he/it calls"},{"bs":"i dozvali smo ga","en":"and We called him"},{"bs":"i pozvao ih je","en":"and he/it called them (two)"},{"bs":"pozvali smo","en":"we called"}],"ref":"3:193","answerWord":"يُنَادِى","answerSound":"audio/d1efbe8f4d66602004ff.m4a","quranTranslation":{"text":"Our Lord! Lo! we have heard a crier calling unto Faith: \"Believe ye in your Lord!\" So we believed. Our Lord! Therefor forgive us our sins, and remit from us our evil deeds, and make us die the death of the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["رَّبَّنَآ","إِنَّنَا","سَمِعْنَا","مُنَادِيًا","يُنَادِى","لِلْإِيمَٰنِ","أَنْ","ءَامِنُوا۟","بِرَبِّكُمْ","فَـَٔامَنَّا","رَبَّنَا","فَٱغْفِرْ","لَنَا","ذُنُوبَنَا","وَكَفِّرْ","عَنَّا","سَيِّـَٔاتِنَا","وَتَوَفَّنَا","مَعَ","ٱلْأَبْرَارِ"],"marked":[4],"facts":{"verb":"نادَى"}},{"id":"nada-5-58-1","words":["verb:nada"],"options":[{"bs":"pozvali ste","en":"you (all) called"},{"bs":"bivaju pozvani","en":"they are called"},{"bs":"i pozvao ih je","en":"and he/it called them (two)"},{"bs":"i pozvali su","en":"and they called"}],"ref":"5:58","answerWord":"نَادَيْتُمْ","answerSound":"audio/b89dba225e46f0f594d0.m4a","quranTranslation":{"text":"And when ye call to prayer they take it for a jest and sport. That is because they are a folk who understand not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["وَإِذَا","نَادَيْتُمْ","إِلَى","ٱلصَّلَوٰةِ","ٱتَّخَذُوهَا","هُزُوًا","وَلَعِبًا","ذَٰلِكَ","بِأَنَّهُمْ","قَوْمٌ","لَّا","يَعْقِلُونَ"],"marked":[1],"facts":{"verb":"نادَى"}},{"id":"nada-7-22-14","words":["verb:nada"],"options":[{"bs":"i pozvao ih je","en":"and he/it called them (two)"},{"bs":"pa su pozvali","en":"so they called"},{"bs":"i pozvao je","en":"and he/it called"},{"bs":"pozvao nas je","en":"he/it called us"}],"ref":"7:22","answerWord":"وَنَادَىٰهُمَا","answerSound":"audio/57a19318aa4ebf0a8561.m4a","quranTranslation":{"text":"Thus did he lead them on with guile. And when they tasted of the tree their shame was manifest to them and they began to hide (by heaping) on themselves some of the leaves of the Garden. And their Lord called them, (saying): Did I not forbid you from that tree and tell you: Lo! Satan is an open enemy to you?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["فَدَلَّىٰهُمَا","بِغُرُورٍ","فَلَمَّا","ذَاقَا","ٱلشَّجَرَةَ","بَدَتْ","لَهُمَا","سَوْءَٰتُهُمَا","وَطَفِقَا","يَخْصِفَانِ","عَلَيْهِمَا","مِن","وَرَقِ","ٱلْجَنَّةِ","وَنَادَىٰهُمَا","رَبُّهُمَآ","أَلَمْ","أَنْهَكُمَا","عَن","تِلْكُمَا","ٱلشَّجَرَةِ","وَأَقُل","لَّكُمَآ","إِنَّ","ٱلشَّيْطَٰنَ","لَكُمَا","عَدُوٌّ","مُّبِينٌ"],"marked":[14],"facts":{"verb":"نادَى"}},{"id":"nada-18-52-2","words":["verb:nada"],"options":[{"bs":"pozovite!","en":"(you all) call!"},{"bs":"pa ju je pozvao","en":"so he/it called her"},{"bs":"i pozvao je","en":"and he/it called"},{"bs":"pozvao ga je","en":"he/it called him"}],"ref":"18:52","answerWord":"نَادُوا۟","answerSound":"audio/621f3d80e9b894b42daa.m4a","quranTranslation":{"text":"And (be mindful of) the Day when He will say: Call those partners of Mine whom ye pretended. Then they will cry unto them, but they will not hear their prayer, and We shall set a gulf of doom between them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["وَيَوْمَ","يَقُولُ","نَادُوا۟","شُرَكَآءِىَ","ٱلَّذِينَ","زَعَمْتُمْ","فَدَعَوْهُمْ","فَلَمْ","يَسْتَجِيبُوا۟","لَهُمْ","وَجَعَلْنَا","بَيْنَهُم","مَّوْبِقًا"],"marked":[2],"facts":{"verb":"نادَى"}},{"id":"nada-19-24-0","words":["verb:nada"],"options":[{"bs":"pa ju je pozvao","en":"so he/it called her"},{"bs":"pozvan je","en":"he/it was called"},{"bs":"poziva","en":"he/it calls"},{"bs":"pozvao nas je","en":"he/it called us"}],"ref":"19:24","answerWord":"فَنَادَىٰهَا","answerSound":"audio/70af3717e85f8a9601cc.m4a","quranTranslation":{"text":"Then (one) cried unto her from below her, saying: Grieve not! Thy Lord hath placed a rivulet beneath thee,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["فَنَادَىٰهَا","مِن","تَحْتِهَآ","أَلَّا","تَحْزَنِى","قَدْ","جَعَلَ","رَبُّكِ","تَحْتَكِ","سَرِيًّا"],"marked":[0],"facts":{"verb":"نادَى"}},{"id":"nada-28-46-5","words":["verb:nada"],"options":[{"bs":"pozvali smo","en":"we called"},{"bs":"i pozvao je","en":"and he/it called"},{"bs":"pa su pozvali","en":"so they called"},{"bs":"poziva","en":"he/it calls"}],"ref":"28:46","answerWord":"نَادَيْنَا","answerSound":"audio/7a8464c50c83cd29cbc4.m4a","quranTranslation":{"text":"And thou was not beside the Mount when We did call; but (the knowledge of it is) a mercy from thy Lord that thou mayst warn a folk unto whom no warner came before thee, that haply they may give heed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["وَمَا","كُنتَ","بِجَانِبِ","ٱلطُّورِ","إِذْ","نَادَيْنَا","وَلَٰكِن","رَّحْمَةً","مِّن","رَّبِّكَ","لِتُنذِرَ","قَوْمًا","مَّآ","أَتَىٰهُم","مِّن","نَّذِيرٍ","مِّن","قَبْلِكَ","لَعَلَّهُمْ","يَتَذَكَّرُونَ"],"marked":[5],"facts":{"verb":"نادَى"}},{"id":"nada-37-75-1","words":["verb:nada"],"options":[{"bs":"pozvao nas je","en":"he/it called us"},{"bs":"i pozvao ih je","en":"and he/it called them (two)"},{"bs":"pa ju je pozvao","en":"so he/it called her"},{"bs":"i dozvali smo ga","en":"and We called him"}],"ref":"37:75","answerWord":"نَادَىٰنَا","answerSound":"audio/9436be3d9392e27c93fb.m4a","quranTranslation":{"text":"And Noah verily prayed unto Us, and gracious was the Hearer of his prayer","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["وَلَقَدْ","نَادَىٰنَا","نُوحٌ","فَلَنِعْمَ","ٱلْمُجِيبُونَ"],"marked":[1],"facts":{"verb":"نادَى"}},{"id":"nada-38-3-6","words":["verb:nada"],"options":[{"bs":"pa su pozvali","en":"so they called"},{"bs":"i pozvao je","en":"and he/it called"},{"bs":"pozvat će ih","en":"He will call them"},{"bs":"pozvali smo","en":"we called"}],"ref":"38:3","answerWord":"فَنَادَوا۟","answerSound":"audio/a6ed70a15c68d16dd696.m4a","quranTranslation":{"text":"How many a generation We destroyed before them, and they cried out when it was no longer the time for escape!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["كَمْ","أَهْلَكْنَا","مِن","قَبْلِهِم","مِّن","قَرْنٍ","فَنَادَوا۟","وَّلَاتَ","حِينَ","مَنَاصٍ"],"marked":[6],"facts":{"verb":"نادَى"}},{"id":"nada-49-4-2","words":["verb:nada"],"options":[{"bs":"pozivaju te","en":"they call you"},{"bs":"i pozvao je","en":"and he/it called"},{"bs":"poziva","en":"he/it calls"},{"bs":"i dozvali smo ga","en":"and We called him"}],"ref":"49:4","answerWord":"يُنَادُونَكَ","answerSound":"audio/5935dddd3de0134dd27b.m4a","quranTranslation":{"text":"Lo! those who call thee from behind the private apartments, most of them have no sense.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["إِنَّ","ٱلَّذِينَ","يُنَادُونَكَ","مِن","وَرَآءِ","ٱلْحُجُرَٰتِ","أَكْثَرُهُمْ","لَا","يَعْقِلُونَ"],"marked":[2],"facts":{"verb":"نادَى"}},{"id":"nada-50-41-2","words":["verb:nada"],"options":[{"bs":"poziva","en":"he/it calls"},{"bs":"i pozvani su","en":"and they were called"},{"bs":"pozvao nas je","en":"he/it called us"},{"bs":"bivaju pozvani","en":"they are called"}],"ref":"50:41","answerWord":"يُنَادِ","answerSound":"audio/6e0b03ecf7c8eaf975d4.m4a","quranTranslation":{"text":"And listen on the day when the crier crieth from a near place,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozvati, dozvati","en":"to call, to call out"},"passage":["وَٱسْتَمِعْ","يَوْمَ","يُنَادِ","ٱلْمُنَادِ","مِن","مَّكَانٍ","قَرِيبٍ"],"marked":[2],"facts":{"verb":"نادَى"}},{"id":"absara-2-17-16","words":["verb:absara"],"options":[{"bs":"vidjet će","en":"they will see"},{"bs":"vidio je","en":"he/it saw"},{"bs":"vidjeli smo","en":"we saw"},{"bs":"vidite","en":"you (all) see"}],"ref":"2:17","answerWord":"يُبْصِرُونَ","answerSound":"audio/4da748f15c2c50b10bb1.m4a","quranTranslation":{"text":"Their likeness is as the likeness of one who kindleth fire, and when it sheddeth its light around him Allah taketh away their light and leaveth them in darkness, where they cannot see,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vidjeti, uočiti","en":"to see, to perceive"},"passage":["مَثَلُهُمْ","كَمَثَلِ","ٱلَّذِى","ٱسْتَوْقَدَ","نَارًا","فَلَمَّآ","أَضَآءَتْ","مَا","حَوْلَهُۥ","ذَهَبَ","ٱللَّهُ","بِنُورِهِمْ","وَتَرَكَهُمْ","فِى","ظُلُمَٰتٍ","لَّا","يُبْصِرُونَ"],"marked":[16],"facts":{"verb":"أَبْصَرَ"}},{"id":"absara-69-39-2","words":["verb:absara"],"options":[{"bs":"vidite","en":"you (all) see"},{"bs":"i vide","en":"and they see"},{"bs":"vidi","en":"he/it sees"},{"bs":"vidjeli smo","en":"we saw"}],"ref":"69:39","answerWord":"تُبْصِرُونَ","answerSound":"audio/0f27c3cf6665855471d1.m4a","quranTranslation":{"text":"And all that ye see not","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vidjeti, uočiti","en":"to see, to perceive"},"passage":["وَمَا","لَا","تُبْصِرُونَ"],"marked":[2],"facts":{"verb":"أَبْصَرَ"}},{"id":"absara-19-38-2","words":["verb:absara"],"options":[{"bs":"i posmatraj","en":"and watch"},{"bs":"i vide","en":"and they see"},{"bs":"vidi","en":"he/it sees"},{"bs":"vidite","en":"you (all) see"}],"ref":"19:38","answerWord":"وَأَبْصِرْ","answerSound":"audio/d496814179ffbdb0e448.m4a","quranTranslation":{"text":"See and hear them on the Day they come unto Us! yet the evil-doers are to-day in error manifest.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vidjeti, uočiti","en":"to see, to perceive"},"passage":["أَسْمِعْ","بِهِمْ","وَأَبْصِرْ","يَوْمَ","يَأْتُونَنَا","لَٰكِنِ","ٱلظَّٰلِمُونَ","ٱلْيَوْمَ","فِى","ضَلَٰلٍ","مُّبِينٍ"],"marked":[2],"facts":{"verb":"أَبْصَرَ"}},{"id":"absara-6-104-6","words":["verb:absara"],"options":[{"bs":"vidio je","en":"he/it saw"},{"bs":"vidjeli smo","en":"we saw"},{"bs":"vidjet će","en":"they will see"},{"bs":"vidi","en":"he/it sees"}],"ref":"6:104","answerWord":"أَبْصَرَ","answerSound":"audio/1cab92d694fc6110770e.m4a","quranTranslation":{"text":"Proofs have come unto you from your Lord, so whoso seeth, it is for his own good, and whoso is blind is blind to his own hurt. And I am not a keeper over you.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vidjeti, uočiti","en":"to see, to perceive"},"passage":["قَدْ","جَآءَكُم","بَصَآئِرُ","مِن","رَّبِّكُمْ","فَمَنْ","أَبْصَرَ","فَلِنَفْسِهِۦ","وَمَنْ","عَمِىَ","فَعَلَيْهَا","وَمَآ","أَنَا۠","عَلَيْكُم","بِحَفِيظٍ"],"marked":[6],"facts":{"verb":"أَبْصَرَ"}},{"id":"absara-18-26-9","words":["verb:absara"],"options":[{"bs":"kako dobro vidi!","en":"how well he/it sees!"},{"bs":"vidi","en":"he/it sees"},{"bs":"i vide","en":"and they see"},{"bs":"vidite","en":"you (all) see"}],"ref":"18:26","answerWord":"أَبْصِرْ","answerSound":"audio/5592b821f1b6444a0375.m4a","quranTranslation":{"text":"Say: Allah is Best Aware how long they tarried. His is the Invisible of the heavens and the earth. How clear of sight is He and keen of hearing! They have no protecting friend beside Him, and He maketh none to share in His government.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vidjeti, uočiti","en":"to see, to perceive"},"passage":["قُلِ","ٱللَّهُ","أَعْلَمُ","بِمَا","لَبِثُوا۟","لَهُۥ","غَيْبُ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","أَبْصِرْ","بِهِۦ","وَأَسْمِعْ","مَا","لَهُم","مِّن","دُونِهِۦ","مِن","وَلِىٍّ","وَلَا","يُشْرِكُ","فِى","حُكْمِهِۦٓ","أَحَدًا"],"marked":[9],"facts":{"verb":"أَبْصَرَ"}},{"id":"absara-19-42-10","words":["verb:absara"],"options":[{"bs":"vidi","en":"he/it sees"},{"bs":"kako dobro vidi!","en":"how well he/it sees!"},{"bs":"vidjeli smo","en":"we saw"},{"bs":"vidio je","en":"he/it saw"}],"ref":"19:42","answerWord":"يُبْصِرُ","answerSound":"audio/fd5ae7f733d7af135edb.m4a","quranTranslation":{"text":"When he said unto his father: O my father! Why worshippest thou that which heareth not nor seeth, nor can in aught avail thee?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vidjeti, uočiti","en":"to see, to perceive"},"passage":["إِذْ","قَالَ","لِأَبِيهِ","يَٰٓأَبَتِ","لِمَ","تَعْبُدُ","مَا","لَا","يَسْمَعُ","وَلَا","يُبْصِرُ","وَلَا","يُغْنِى","عَنكَ","شَيْـًٔا"],"marked":[10],"facts":{"verb":"أَبْصَرَ"}},{"id":"absara-32-12-9","words":["verb:absara"],"options":[{"bs":"vidjeli smo","en":"we saw"},{"bs":"vidio je","en":"he/it saw"},{"bs":"kako dobro vidi!","en":"how well he/it sees!"},{"bs":"i vide","en":"and they see"}],"ref":"32:12","answerWord":"أَبْصَرْنَا","answerSound":"audio/43ad1ee3600543309b1d.m4a","quranTranslation":{"text":"Couldst thou but see when the guilty hang their heads before their Lord, (and say): Our Lord! We have now seen and heard, so send us back; we will do right, now we are sure.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vidjeti, uočiti","en":"to see, to perceive"},"passage":["وَلَوْ","تَرَىٰٓ","إِذِ","ٱلْمُجْرِمُونَ","نَاكِسُوا۟","رُءُوسِهِمْ","عِندَ","رَبِّهِمْ","رَبَّنَآ","أَبْصَرْنَا","وَسَمِعْنَا","فَٱرْجِعْنَا","نَعْمَلْ","صَٰلِحًا","إِنَّا","مُوقِنُونَ"],"marked":[9],"facts":{"verb":"أَبْصَرَ"}},{"id":"absara-37-175-0","words":["verb:absara"],"options":[{"bs":"i posmatraj ih","en":"and watch them"},{"bs":"i vide","en":"and they see"},{"bs":"vidite","en":"you (all) see"},{"bs":"i posmatraj","en":"and watch"}],"ref":"37:175","answerWord":"وَأَبْصِرْهُمْ","answerSound":"audio/031a7445344bd89e2e42.m4a","quranTranslation":{"text":"And watch, for they will (soon) see.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vidjeti, uočiti","en":"to see, to perceive"},"passage":["وَأَبْصِرْهُمْ","فَسَوْفَ","يُبْصِرُونَ"],"marked":[0],"facts":{"verb":"أَبْصَرَ"}},{"id":"absara-68-5-1","words":["verb:absara"],"options":[{"bs":"i vide","en":"and they see"},{"bs":"vidite","en":"you (all) see"},{"bs":"vidi","en":"he/it sees"},{"bs":"vidio je","en":"he/it saw"}],"ref":"68:5","answerWord":"وَيُبْصِرُونَ","answerSound":"audio/2c01a89e03b91b1c653c.m4a","quranTranslation":{"text":"And thou wilt see and they will see","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vidjeti, uočiti","en":"to see, to perceive"},"passage":["فَسَتُبْصِرُ","وَيُبْصِرُونَ"],"marked":[1],"facts":{"verb":"أَبْصَرَ"}},{"id":"qanata-15-56-2","words":["verb:qanata"],"options":[{"bs":"očajava","en":"despairs"},{"bs":"očajavate","en":"you (all) despair"},{"bs":"očajavaju","en":"they despair"},{"bs":"izgubili su nadu","en":"they despaired"}],"ref":"15:56","answerWord":"يَقْنَطُ","answerSound":"audio/f5701f5477e8ee54915a.m4a","quranTranslation":{"text":"He said: And who despaireth of the mercy of his Lord save those who are astray?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"očajavati, izgubiti nadu","en":"to despair"},"passage":["قَالَ","وَمَن","يَقْنَطُ","مِن","رَّحْمَةِ","رَبِّهِۦٓ","إِلَّا","ٱلضَّآلُّونَ"],"marked":[2],"facts":{"verb":"قَنَطَ"}},{"id":"qanata-30-36-14","words":["verb:qanata"],"options":[{"bs":"očajavaju","en":"they despair"},{"bs":"očajava","en":"despairs"},{"bs":"izgubili su nadu","en":"they despaired"},{"bs":"očajavate","en":"you (all) despair"}],"ref":"30:36","answerWord":"يَقْنَطُونَ","answerSound":"audio/9f250638ac3e5a1ec9e4.m4a","quranTranslation":{"text":"And when We cause mankind to taste of mercy they rejoice therein; but if an evil thing befall them as the consequence of their own deeds, lo! they are in despair!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"očajavati, izgubiti nadu","en":"to despair"},"passage":["وَإِذَآ","أَذَقْنَا","ٱلنَّاسَ","رَحْمَةً","فَرِحُوا۟","بِهَا","وَإِن","تُصِبْهُمْ","سَيِّئَةٌۢ","بِمَا","قَدَّمَتْ","أَيْدِيهِمْ","إِذَا","هُمْ","يَقْنَطُونَ"],"marked":[14],"facts":{"verb":"قَنَطَ"}},{"id":"qanata-39-53-7","words":["verb:qanata"],"options":[{"bs":"očajavate","en":"you (all) despair"},{"bs":"očajavaju","en":"they despair"},{"bs":"izgubili su nadu","en":"they despaired"},{"bs":"očajava","en":"despairs"}],"ref":"39:53","answerWord":"تَقْنَطُوا۟","answerSound":"audio/15913775a858639dd373.m4a","quranTranslation":{"text":"Say: O My slaves who have been prodigal to their own hurt! Despair not of the mercy of Allah, Who forgiveth all sins. Lo! He is the Forgiving, the Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"očajavati, izgubiti nadu","en":"to despair"},"passage":["قُلْ","يَٰعِبَادِىَ","ٱلَّذِينَ","أَسْرَفُوا۟","عَلَىٰٓ","أَنفُسِهِمْ","لَا","تَقْنَطُوا۟","مِن","رَّحْمَةِ","ٱللَّهِ","إِنَّ","ٱللَّهَ","يَغْفِرُ","ٱلذُّنُوبَ","جَمِيعًا","إِنَّهُۥ","هُوَ","ٱلْغَفُورُ","ٱلرَّحِيمُ"],"marked":[7],"facts":{"verb":"قَنَطَ"}},{"id":"qanata-42-28-7","words":["verb:qanata"],"options":[{"bs":"izgubili su nadu","en":"they despaired"},{"bs":"očajavate","en":"you (all) despair"},{"bs":"očajava","en":"despairs"},{"bs":"očajavaju","en":"they despair"}],"ref":"42:28","answerWord":"قَنَطُوا۟","answerSound":"audio/6201c9fe8f732d051915.m4a","quranTranslation":{"text":"And He it is Who sendeth down the saving rain after they have despaired, and spreadeth out His mercy. He is the Protecting Friend, the Praiseworthy.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"očajavati, izgubiti nadu","en":"to despair"},"passage":["وَهُوَ","ٱلَّذِى","يُنَزِّلُ","ٱلْغَيْثَ","مِنۢ","بَعْدِ","مَا","قَنَطُوا۟","وَيَنشُرُ","رَحْمَتَهُۥ","وَهُوَ","ٱلْوَلِىُّ","ٱلْحَمِيدُ"],"marked":[7],"facts":{"verb":"قَنَطَ"}}]