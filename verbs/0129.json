{"rank": 129, "root": "رحم", "form": 1, "lemma": "رَحِمَ", "count": 28, "ayahCount": 28, "share": 0.14, "meaning": {"bs": "smilovati se", "en": "to have mercy", "tr": "merhamet etmek", "fr": "faire miséricorde", "id": "mengasihi", "ur": "رحم کرنا", "bn": "দয়া করা, রহম করা", "fa": "رحم کردن"}, "lemmaSpoken": "audio/6687a4c93dca00cb66c4.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "رَّحِمَ", "plain": "رَحِمَ", "quran": true, "notUsed": false, "spoken": "audio/6687a4c93dca00cb66c4.m4a", "recited": "audio/f40df72cdc6796f4cf5b.m4a", "recitedText": "رَّحِمَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَرْحَمُ", "plain": "يَرْحَمُ", "quran": true, "notUsed": false, "spoken": "audio/4913698a7d576962467e.m4a", "recited": "audio/42135e2252049fe6a6b4.m4a", "recitedText": "وَيَرْحَمُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱرْحَمْ", "plain": "اِرْحَمْ", "quran": true, "notUsed": false, "spoken": "audio/b499513a9663f8f6ae51.m4a", "recited": "audio/93227c1806515549b320.m4a", "recitedText": "وَٱرْحَمْ"}], "nouns": {"participle": {"lemma": "راحِم", "count": 6, "spoken": "audio/858a02cd20d3d9b719a1.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "رَحِمْتُ", "plain": "رَحِمْتُ", "quran": false, "notUsed": false, "spoken": "audio/3b9f71b53479c2205e54.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "رَحِمْنَا", "plain": "رَحِمْنَا", "quran": false, "notUsed": false, "spoken": "audio/da5588534d4146a8999d.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "رَحِمْتَ", "plain": "رَحِمْتَ", "quran": false, "notUsed": false, "spoken": "audio/0c9e2d338e65264d7122.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "رَحِمْتِ", "plain": "رَحِمْتِ", "quran": false, "notUsed": false, "spoken": "audio/443e6e0dc89b17b83e67.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "ara