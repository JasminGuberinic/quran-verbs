 "اِكْذِبْ", "quran": false, "notUsed": false, "spoken": "audio/0859e0bf319e6eb7a4de.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِكْذِبِي", "plain": "اِكْذِبِي", "quran": false, "notUsed": false, "spoken": "audio/d165ca5c8797dc257ec5.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِكْذِبَا", "plain": "اِكْذِبَا", "quran": false, "notUsed": false, "spoken": "audio/ebf891dd88f5fa733a10.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِكْذِبُوا", "plain": "اِكْذِبُوا", "quran": false, "notUsed": false, "spoken": "audio/ffb8f986531ff121c57c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِكْذِبْنَ", "plain": "اِكْذِبْنَ", "quran": false, "notUsed": false, "spoken": "audio/affadb0e3151aa879543.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "6:24", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/813.mp3", "translation": {"en": {"text": "See how they lie against themselves, and (how) the thing which they devised hath failed them!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bak, vicdanlarına karşı nasıl yalan söylediler! O uydurdukları putlar da kendilerinden kaybolup gitti.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "دیکھو کیسا جھوٹ باندھا خود اپنے اوپر اور گم گئیں ان سے جو باتیں بناتے تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Lihatlah bagaimana mereka telah berdusta kepada diri mereka sendiri dan hilanglah daripada mereka sembahan-sembahan yang dahulu mereka ada-adakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱنظُرْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَيْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَذَبُوا۟", "hit": true, "audio": "audio/f865a9e2076ccef38f3d.m4a", "gloss": {"en": "they lied", "bs": "slagali su", "tr": "yalan söylediler", "fr": "ils ont menti", "id": "mereka telah berbohong", "ur": "انہوں نے جھوٹ بولا", "bn": "তারা মিথ্যা বলেছে", "fa": "دروغ گفتند"}}, {"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنفُسِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَضَلَّ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَفْتَرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:10", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/17.mp3", "translation": {"en": {"text": "In their hearts is a disease, and Allah increaseth their disease. A painful doom is theirs because they lie.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kalplerinde hastalık vardır. Allah da onların hastalığını arttırmıştır. Yalan söylemelerine karşılık onlara elem verici bir azab vardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ان کے دلوں میں بیماری ہے تو اللہ نے ان کی بیماری اور بڑھائی اور ان کے لئے دردناک عذاب ہے، بدلا ان کے جھوٹ کا -", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dalam hati mereka ada penyakit, lalu ditambah Allah penyakitnya; dan bagi mereka siksa yang pedih, disebabkan mereka berdusta.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "قُلُوبِهِم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّرَضٌ", "hit": false, "audio": null, "gloss": null}, {"text": "فَزَادَهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَرَضًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابٌ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلِيمٌۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَكْذِبُونَ", "hit": true, "audio": "audio/20328818ca8a10419ebc.m4a", "gloss": {"bs": "lažu", "en": "they lie", "tr": "yalan söylerler", "fr": "ils mentent", "id": "mereka berdusta", "ur": "وہ جھوٹ بولتے ہیں", "bn": "তারা মিথ্যা বলে", "fa": "دروغ می‌گویند"}}]}, {"ref": "53:11", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4795.mp3", "translation": {"en": {"text": "The heart lied not (in seeing) what it saw.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onun gördüğünü kalb(i) yalanlamadı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "دل نے جھوٹ نہ کہا جو دیکھا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hatinya tidak mendustakan apa yang telah dilihatnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَذَبَ", "hit": true, "audio": "audio/b4488456e9cf84669f34.m4a", "gloss": {"bs": "je slagalo", "en": "lied", "tr": "yalan söyledi", "fr": "mentit", "id": "berdusta", "ur": "اس نے جھوٹ کہا", "bn": "মিথ্যা বলল", "fa": "دروغ گفت"}}, {"text": "ٱلْفُؤَادُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "رَأَىٰٓ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:27", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1623.mp3", "translation": {"en": {"text": "And if his shirt is torn from behind, then she hath lied and he is of the truthful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Yok eğer gömleği arkadan yırtılmış ise hanım yalan söylemiştir, o zaman bu doğru söyleyenlerdendir.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر ان کا کر ُتا پیچھے سے چاک ہوا تو عورت جھوٹی ہے اور یہ سچے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan jika baju gamisnya koyak di belakang, maka wanita itulah yang dusta, dan Yusuf termasuk orang-orang yang benar\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِن", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "قَمِيصُهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "قُدَّ", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "دُبُرٍ", "hit": false, "audio": null, "gloss": null}, {"text": "فَكَذَبَتْ", "hit": true, "audio": "audio/61e03ebb1c49c2d763af.m4a", "gloss": {"en": "so she/it lied", "bs": "pa je slagala", "tr": "böylece yalan söyledi", "fr": "alors elle a menti", "id": "maka dia telah berbohong", "ur": "پس اُس نے جھوٹ بولا", "bn": "অতএব সে মিথ্যা বলল", "fa": "پس دروغ گفت"}}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّٰدِقِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "كَذَبُوا۟", "count": 4, "first": "6:24", "audio": "audio/f865a9e2076ccef38f3d.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they lied", "bs": "slagali su", "tr": "yalan söylediler", "fr": "ils ont menti", "id": "mereka telah berbohong", "ur": "انہوں نے جھوٹ بولا", "bn": "তারা মিথ্যা বলেছে", "fa": "دروغ گفتند"}}, {"arabic": "ي