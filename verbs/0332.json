quran": false, "notUsed": false, "spoken": "audio/a478ff9f2dc823845f33.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِفْرِضِي", "plain": "اِفْرِضِي", "quran": false, "notUsed": false, "spoken": "audio/e749ff88e263e74d80ef.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِفْرِضَا", "plain": "اِفْرِضَا", "quran": false, "notUsed": false, "spoken": "audio/077d6f5d4c1cfda0d347.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِفْرِضُوا", "plain": "اِفْرِضُوا", "quran": false, "notUsed": false, "spoken": "audio/05b8420318198591b87b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِفْرِضْنَ", "plain": "اِفْرِضْنَ", "quran": false, "notUsed": false, "spoken": "audio/72d4e0a5914948c16c5e.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "66:2", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5231.mp3", "translation": {"en": {"text": "Allah hath made lawful for you (Muslims) absolution from your oaths (of such a kind), and Allah is your Protector. He is the Knower, the Wise.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah size yeminlerinizi çözmeyi meşrû kılmıştır. Allah sizin sahibinizdir. O bilendir, hikmetle yönetendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک اللہ نے تمہارے لیے تمہاری قسموں کا اتار مقرر فرمادیا اور اللہ تمہارا مولیٰ ہے، اور اللہ علم و حکمت والا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Allah telah mewajibkan kepadamu sekalian membebaskan diri dari sumpahmu dan Allah adalah Pelindungmu dan Dia Maha Mengetahui lagi Maha Bijaksana.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَرَضَ", "hit": true, "audio": "audio/9a599691be02f15856ab.m4a", "gloss": {"en": "he/it imposed", "bs": "odredio je", "tr": "tayin etti", "fr": "il a imposé", "id": "dia telah menetapkan", "ur": "اُس نے فرض کیا", "bn": "সে নির্ধারণ করল", "fa": "مقرر کرد"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَحِلَّةَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَيْمَٰنِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَوْلَىٰكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَلِيمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَكِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "24:1", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2792.mp3", "translation": {"en": {"text": "(Here is) a surah which We have revealed and enjoined, and wherein We have revealed plain tokens, that haply ye may take heed.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(İşte bu âyetler) bizim indirdiğimiz ve (hükümlerini üzerinize) farz kıldığımız bir sûredir. Belki düşünüp öğüt alırsınız diye onda açık açık âyetler indirdik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یہ ایک سورة ہے کہ ہم نے اتاری اور ہم نے اس کے احکام فرض کیے اور ہم نے اس میں روشن آیتیں نازل فرمائیں کہ تم دھیان کرو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Ini adalah) satu surat yang Kami turunkan dan Kami wajibkan (menjalankan hukum-hukum yang ada di dalam)nya, dan Kami turunkan di dalamnya ayat ayat yang jelas, agar kamu selalu mengingatinya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "سُورَةٌ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنزَلْنَٰهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَفَرَضْنَٰهَا", "hit": true, "audio": "audio/6441bd0be42c224715ac.m4a", "gloss": {"bs": "i propisali smo je", "en": "and We made it obligatory", "tr": "ve onu farz kıldık", "fr": "et Nous l'avons rendue obligatoire", "id": "dan Kami mewajibkannya", "ur": "اور ہم نے اسے فرض کیا", "bn": "এবং আমরা তা ফরয করেছি", "fa": "و آن را واجب کردیم"}}, {"text": "وَأَنزَلْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَآ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتٍۭ", "hit": false, "audio": null, "gloss": null}, {"text": "بَيِّنَٰتٍ", "hit": false, "audio": null, "gloss": null}, {"text": "لَّعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَذَكَّرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "فَرَضَ", "count": 4, "first": "2:197", "audio": "audio/38da4addbe5f69e574e0.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it imposed", "bs": "odredio je", "tr": "tayin etti", "fr": "il a imposé", "id": "dia telah menetapkan", "ur": "اُس نے فرض کیا", "bn": "সে নির্ধারণ করল", "fa": "مقرر کرد"}}, {"arabic": "فَرَضْتُمْ", "count": 2, "first": "2:237", "audio": "audio/9cf0fe3b85207baa42f2.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) appointed", "bs": "odredili ste", "tr": "tayin ettiniz", "fr": "vous avez désigné", "id": "kalian telah menetapkan", "ur": "تم سب نے مقرر کیا", "bn": "তোমরা নির্ধারণ করেছ", "fa": "مقرر کردید"}}, {"arabic": "تَفْرِضُوا۟", "count": 1, "first": "2:236", "audio": "audio/683684a96b50060734bb.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "you (all) appoint", "bs": "određujete", "tr": "tayin edersiniz", "fr": "vous désignez", "id": "kalian menetapkan", "ur": "تم سب مقرر کرتے ہو", "bn": "তোমরা নির্ধারণ কর", "fa": "مقرر کنید"}}, {"arabic": "وَفَرَضْنَٰهَا", "count": 1, "first": "24:1", "audio": "audio/6441bd0be42c224715ac.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["hiya"]}], "gloss": {"bs": "i propisali smo je", "en": "and We made it obligatory", "tr": "ve onu farz kıldık", "fr": "et Nous l'avons rendue obligatoire", "id": "dan Kami mewajibkannya", "ur": "اور ہم نے اسے فرض کیا", "bn": "এবং আমরা তা ফরয করেছি", "fa": "و آن را واجب کردیم"}}, {"arabic": "فَرَضْنَا", "count": 1, "first": "33:50", "audio": "audio/6d25138eb187791a2b00.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "we imposed", "bs": "odredili smo", "tr": "tayin ettik", "fr": "nous avons imposé", "id": "kami telah menetapkan", "ur": "ہم نے فرض کیا", "bn": "আমরা নির্ধারণ করেছি", "fa": "مقرر کردیم"}}], "ayatFile": "ayat/0332.json", "ayatTranslations": {"en": "ayat/0332.en.json", "tr": "ayat/0332.tr.json", "ur": "ayat/0332.ur.json", "id": "ayat/0332.id.json"}, "sentences": [{"arabic": "فَرَضَ الْمُعَلِّمُ قَاعِدَةً", "spoken": "audio/e139f4bafa7dafcfcf01.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Učitelj je uveo pravilo.", "en": "The teacher imposed a rule.", "bn": "শিক্ষক একটি নিয়ম আরোপ করলেন।", "fa": "معلم قاعده‌ای وضع کرد.", "fr": "L'enseignant a imposé une règle.", "id": "Guru menetapkan sebuah aturan.", "tr": "Öğretmen bir kural koydu.", "ur": "استاد نے ایک قاعدہ نافذ کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "فَرَضَ", "target": true, "translation": {"bs": "uveo je", "en": "imposed", "bn": "আরোপ করল", "fa": "وضع کرد", "fr": "a imposé", "id": "mewajibkan", "tr": "koydu", "ur": "اس نے نافذ کیا"}}, {"arabic": "الْمُعَلِّمُ", "target": false, "translation": {"bs": "učitelj", "en": "the teacher", "bn": "শিক্ষক", "fa": "معلم", "fr": "le professeur", "id": "guru itu", "tr": "öğretmen", "ur": "استاد"}}, {"arabic"