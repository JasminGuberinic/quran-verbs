n": "anta", "arabic": "اِئْمَنْ", "plain": "اِئْمَنْ", "quran": false, "notUsed": false, "spoken": "audio/8563d242e1d91d8667b1.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِئْمَنِي", "plain": "اِئْمَنِي", "quran": false, "notUsed": false, "spoken": "audio/4313210ddeca7cd68f2c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِئْمَنَا", "plain": "اِئْمَنَا", "quran": false, "notUsed": false, "spoken": "audio/7b64397bdd7c39697b92.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِئْمَنُوا", "plain": "اِئْمَنُوا", "quran": false, "notUsed": false, "spoken": "audio/304052034158491c0eeb.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِئْمَنَّ", "plain": "اِئْمَنَّ", "quran": false, "notUsed": false, "spoken": "audio/e3d4807b5413d12e84b0.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "67:16", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5257.mp3", "translation": {"en": {"text": "Have ye taken security from Him Who is in the heaven that He will not cause the earth to swallow you when lo! it is convulsed?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Her şeyi kuşatmış olan Allah ın yeri sizinle birlikte göçürüvermesinden emin misiniz? O zaman yer çalkalanıyordur.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا تم اس سےنڈر ہوگئے جس کی سلطنت آسمان میں ہے کہ تمہیں زمین میں دھنسادے جبھی وہ کانپتی رہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apakah kamu merasa aman terhadap Allah yang (berkuasa) di langit bahwa Dia akan menjungkir balikkan bumi bersama kamu, sehingga dengan tiba-tiba bumi itu bergoncang?,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ءَأَمِنتُم", "hit": true, "audio": "audio/763a0aeeeb8144ac4010.m4a", "gloss": {"en": "did you (all) feel safe?", "bs": "zar ste se osjećali sigurnima?", "tr": "emin oldunuz mu?", "fr": "vous êtes-vous sentis en sécurité ?", "id": "apakah kalian telah merasa aman?", "ur": "کیا تم بےخوف ہو گئے؟", "bn": "তোমরা কি নিরাপদ বোধ করেছিলে?", "fa": "آیا احساس امنیت کردید؟"}}, {"text": "مَّن", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمَآءِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَخْسِفَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِكُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "هِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَمُورُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:97", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1051.mp3", "translation": {"en": {"text": "Are the people of the townships then secure from the coming of Our wrath upon them as a night-raid while they sleep?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Acaba o ülkelerin halkı, geceleyin uyurlarken kendilerine azabımızın gelmeyeceğinden emin mi idiler?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا بستیوں والے نہیں ڈرتے کہ ان پر ہمارا عذاب رات کو آئے جب وہ سوتے ہوں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka apakah penduduk negeri-negeri itu merasa aman dari kedatangan siksaan Kami kepada mereka di malam hari di waktu mereka sedang tidur?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَفَأَمِنَ", "hit": true, "audio": "audio/f83c32d4efa928e3b761.m4a", "gloss": {"bs": "zar su se onda osjećali sigurnim", "en": "did they then feel secure", "tr": "onlar emin mi oldular", "fr": "se sentirent-ils donc en sécurité", "id": "apakah mereka merasa aman", "ur": "کیا پھر وہ بے خوف ہو گئے", "bn": "তারা কি তাহলে নিরাপদ মনে করেছে", "fa": "آیا پس ایمن شدند"}}, {"text": "أَهْلُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقُرَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَأْتِيَهُم", "hit": false, "audio": null, "gloss": null}, {"text": "بَأْسُنَا", "hit": false, "audio": null, "gloss": null}, {"text": "بَيَٰتًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَآئِمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:11", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1607.mp3", "translation": {"en": {"text": "They said: O our father! Why wilt thou not trust us with Joseph, when lo! we are good friends to him?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Dediler ki: \"Ey babamız! Sen bize Yusuf için neden güvenmiyorsun? Halbuki biz onun iyiliğini istiyoruz.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے اے ہمارے باپ! آپ کو کیا ہوا کہ یوسف کے معامل ہ میں ہمارا اعتبار نہیں کرتے اور ہم تو اس کے خیر خواہ ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka berkata: \"Wahai ayah kami, apa sebabnya kamu tidak mempercayai kami terhadap Yusuf, padahal sesungguhnya kami adalah orang-orang yang mengingini kebaikan baginya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰٓأَبَانَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَأْمَ۫نَّا", "hit": true, "audio": "audio/55f74491ea87ae750d64.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": ["nahnu"], "mood": "indicative"}]}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "يُوسُفَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَٰصِحُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:99", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1053.mp3", "translation": {"en": {"text": "Are they then secure from Allah's scheme? None deemeth himself secure from Allah's scheme save folk that perish.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah'ın tuzağından (kurtulacaklarına) emin mi oldular? Ziyana uğrayan topluluktan başkası, Allah'ın tuzağından emin olmaz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا اللہ کی خفی تدبیر سے بے خبر ہیں تو اللہ کی خفی تدبیر سے نذر نہیں ہوتے مگر تباہی والے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka apakah mereka merasa aman dari azab Allah (yang tidak terduga-duga)? Tiada yang merasa aman dan azab Allah kecuali orang-orang yang merugi.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَفَأَمِنُوا۟", "hit": true, "audio": "audio/104e645b9a6dd7979f4e.m4a", "gloss": {"bs": "zar su se onda osjećali sigurnim", "en": "did they then feel secure", "tr": "onlar emin mi oldular", "fr": "se sentirent-ils donc en sécurité", "id": "apakah mereka merasa aman", "ur": "کیا پھر وہ بے خوف ہو گئے", "bn": "তারা কি তাহলে নিরাপদ মনে করেছে", "fa": "آیا پس ایمن شدند"}}, {"text": "مَكْرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَأْمَنُ", "hit": true, "audio": "audio/a08b22585d7464a7d45e.m4a", "gloss": {"bs": "osjeća se sigurnim", "en": "feels secure", "tr": "emin olur", "fr": "se sent en sécurité", "id": "merasa aman", "ur": "بے خوف ہوتا ہے", "bn": "নিরাপদ বোধ করে", "fa": "ایمن می‌شود"}}, {"text": "مَكْرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَوْمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَٰسِرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَمِنتُمْ", "count": 3, "first": "2:196", "audio": "audio/6da4c245b5e60c278bd3.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) felt safe", "bs": "osjećali ste se sigurnima", "tr": "güvende hissettiniz", "fr": "vous vous êtes sentis en sécurité", "id": "kalian telah merasa aman", "ur": "تم بےخوف ہوئے", "bn": "তোমরা নিরাপদ বোধ করেছিলে", "fa": "احساس امنیت کردید"}}, {"arabic": "تَأْمَنْهُ", "count": 2, "first": "3:75", "audio": "audio/7b7bdc71b0da3a1faba1.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": ["huwa"], "mood": "jussive"}]}, {"arabic": "أَفَأَمِنَ", "count": 2, "first": "7:97", "audio": "audio/f83c32d4efa928e3b761.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "zar su se onda osjećali sigurnim", "en": "did they then feel secure", "tr": "onlar emin mi oldular", "fr": "se sentirent-ils donc en sécurité", "id": "apakah mereka merasa aman", "ur": "کیا پھر وہ بے خوف ہو گئے", "bn": "তারা কি তাহলে নিরাপদ মনে করেছে", "fa": "آیا پس ایمن شدند"}}, {"arabic": "أَمِنَ", "count": 1, "fir