[{"id":"tawaffa-2-234-1","words":["verb:tawaffa"],"options":[{"bs":"bivaju usmrćeni","en":"they are taken in death"},{"bs":"usmrtio ih je","en":"he/it took them in death"},{"bs":"usmrćuje vas","en":"he/it takes you (all) in death"},{"bs":"usmrtila ga je","en":"she/it took him in death"}],"ref":"2:234","answerWord":"يُتَوَفَّوْنَ","answerSound":"audio/914446116ce31041f6b7.m4a","quranTranslation":{"text":"Such of you as die and leave behind them wives, they (the wives) shall wait, keeping themselves apart, four months and ten days. And when they reach the term (prescribed for them) then there is no sin for you in aught that they may do with themselves in decency. Allah is informed of what ye do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti dušu, usmrtiti","en":"to take the soul, to cause to die"},"passage":["وَٱلَّذِينَ","يُتَوَفَّوْنَ","مِنكُمْ","وَيَذَرُونَ","أَزْوَٰجًا","يَتَرَبَّصْنَ","بِأَنفُسِهِنَّ","أَرْبَعَةَ","أَشْهُرٍ","وَعَشْرًا","فَإِذَا","بَلَغْنَ","أَجَلَهُنَّ","فَلَا","جُنَاحَ","عَلَيْكُمْ","فِيمَا","فَعَلْنَ","فِىٓ","أَنفُسِهِنَّ","بِٱلْمَعْرُوفِ","وَٱللَّهُ","بِمَا","تَعْمَلُونَ","خَبِيرٌ"],"marked":[1],"facts":{"verb":"تَوَفَّى"}},{"id":"tawaffa-3-193-17","words":["verb:tawaffa"],"options":[{"bs":"i usmrti nas!","en":"and take us in death!"},{"bs":"usmrtio ih je","en":"he/it took them in death"},{"bs":"uzimaju im duše","en":"they take them in death"},{"bs":"usmrćuje ih","en":"he/it takes them in death"}],"ref":"3:193","answerWord":"وَتَوَفَّنَا","answerSound":"audio/0933d914ec9a9123497d.m4a","quranTranslation":{"text":"Our Lord! Lo! we have heard a crier calling unto Faith: \"Believe ye in your Lord!\" So we believed. Our Lord! Therefor forgive us our sins, and remit from us our evil deeds, and make us die the death of the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti dušu, usmrtiti","en":"to take the soul, to cause to die"},"passage":["رَّبَّنَآ","إِنَّنَا","سَمِعْنَا","مُنَادِيًا","يُنَادِى","لِلْإِيمَٰنِ","أَنْ","ءَامِنُوا۟","بِرَبِّكُمْ","فَـَٔامَنَّا","رَبَّنَا","فَٱغْفِرْ","لَنَا","ذُنُوبَنَا","وَكَفِّرْ","عَنَّا","سَيِّـَٔاتِنَا","وَتَوَفَّنَا","مَعَ","ٱلْأَبْرَارِ"],"marked":[17],"facts":{"verb":"تَوَفَّى"}},{"id":"tawaffa-10-104-20","words":["verb:tawaffa"],"options":[{"bs":"usmrćuje vas","en":"he/it takes you (all) in death"},{"bs":"usmrćuje ih","en":"he/it takes them in death"},{"bs":"usmrtio ih je","en":"he/it took them in death"},{"bs":"i usmrti nas!","en":"and take us in death!"}],"ref":"10:104","answerWord":"يَتَوَفَّىٰكُمْ","answerSound":"audio/8dd74996dd4d801bdb74.m4a","quranTranslation":{"text":"Say (O Muhammad): O mankind! If ye are in doubt of my religion, then (know that) I worship not those whom ye worship instead of Allah, but I worship Allah Who causeth you to die, and I have been commanded to be of the believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti dušu, usmrtiti","en":"to take the soul, to cause to die"},"passage":["قُلْ","يَٰٓأَيُّهَا","ٱلنَّاسُ","إِن","كُنتُمْ","فِى","شَكٍّ","مِّن","دِينِى","فَلَآ","أَعْبُدُ","ٱلَّذِينَ","تَعْبُدُونَ","مِن","دُونِ","ٱللَّهِ","وَلَٰكِنْ","أَعْبُدُ","ٱللَّهَ","ٱلَّذِى","يَتَوَفَّىٰكُمْ","وَأُمِرْتُ","أَنْ","أَكُونَ","مِنَ","ٱلْمُؤْمِنِينَ"],"marked":[20],"facts":{"verb":"تَوَفَّى"}},{"id":"tawaffa-4-15-15","words":["verb:tawaffa"],"options":[{"bs":"usmrćuje ih","en":"he/it takes them in death"},{"bs":"usmrtila ga je","en":"she/it took him in death"},{"bs":"i usmrti nas!","en":"and take us in death!"},{"bs":"usmrtio si me","en":"you took me in death"}],"ref":"4:15","answerWord":"يَتَوَفَّىٰهُنَّ","answerSound":"audio/200ed74e807bd0a379e5.m4a","quranTranslation":{"text":"As for those of your women who are guilty of lewdness, call to witness four of you against them. And if they testify (to the truth of the allegation) then confine them to the houses until death take them or (until) Allah appoint for them a way (through new legislation).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti dušu, usmrtiti","en":"to take the soul, to cause to die"},"passage":["وَٱلَّٰتِى","يَأْتِينَ","ٱلْفَٰحِشَةَ","مِن","نِّسَآئِكُمْ","فَٱسْتَشْهِدُوا۟","عَلَيْهِنَّ","أَرْبَعَةً","مِّنكُمْ","فَإِن","شَهِدُوا۟","فَأَمْسِكُوهُنَّ","فِى","ٱلْبُيُوتِ","حَتَّىٰ","يَتَوَفَّىٰهُنَّ","ٱلْمَوْتُ","أَوْ","يَجْعَلَ","ٱللَّهُ","لَهُنَّ","سَبِيلًا"],"marked":[15],"facts":{"verb":"تَوَفَّى"}},{"id":"tawaffa-4-97-2","words":["verb:tawaffa"],"options":[{"bs":"usmrtio ih je","en":"he/it took them in death"},{"bs":"usmrtila ga je","en":"she/it took him in death"},{"bs":"usmrćuju ih","en":"they take them in death"},{"bs":"usmrtio si me","en":"you took me in death"}],"ref":"4:97","answerWord":"تَوَفَّىٰهُمُ","answerSound":"audio/b2195e49f27002e83759.m4a","quranTranslation":{"text":"Lo! as for those whom the angels take (in death) while they wrong themselves, (the angels) will ask: In what were ye engaged? They will say: We were oppressed in the land. (The angels) will say: Was not Allah's earth spacious that ye could have migrated therein? As for such, their habitation will be hell, an evil journey's end;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti dušu, usmrtiti","en":"to take the soul, to cause to die"},"passage":["إِنَّ","ٱلَّذِينَ","تَوَفَّىٰهُمُ","ٱلْمَلَٰٓئِكَةُ","ظَالِمِىٓ","أَنفُسِهِمْ","قَالُوا۟","فِيمَ","كُنتُمْ","قَالُوا۟","كُنَّا","مُسْتَضْعَفِينَ","فِى","ٱلْأَرْضِ","قَالُوٓا۟","أَلَمْ","تَكُنْ","أَرْضُ","ٱللَّهِ","وَٰسِعَةً","فَتُهَاجِرُوا۟","فِيهَا","فَأُو۟لَٰٓئِكَ","مَأْوَىٰهُمْ","جَهَنَّمُ","وَسَآءَتْ","مَصِيرًا"],"marked":[2],"facts":{"verb":"تَوَفَّى"}},{"id":"tawaffa-5-117-19","words":["verb:tawaffa"],"options":[{"bs":"usmrtio si me","en":"you took me in death"},{"bs":"uzimaju im duše","en":"they take them in death"},{"bs":"bivaju usmrćeni","en":"they are taken in death"},{"bs":"i usmrti nas!","en":"and take us in death!"}],"ref":"5:117","answerWord":"تَوَفَّيْتَنِى","answerSound":"audio/5b00e52388e3e09bade4.m4a","quranTranslation":{"text":"I spake unto them only that which Thou commandedst me, (saying): Worship Allah, my Lord and your Lord. I was a witness of them while I dwelt among them, and when Thou tookest me Thou wast the Watcher over them. Thou art Witness over all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti dušu, usmrtiti","en":"to take the soul, to cause to die"},"passage":["مَا","قُلْتُ","لَهُمْ","إِلَّا","مَآ","أَمَرْتَنِى","بِهِۦٓ","أَنِ","ٱعْبُدُوا۟","ٱللَّهَ","رَبِّى","وَرَبَّكُمْ","وَكُنتُ","عَلَيْهِمْ","شَهِيدًا","مَّا","دُمْتُ","فِيهِمْ","فَلَمَّا","تَوَفَّيْتَنِى","كُنتَ","أَنتَ","ٱلرَّقِيبَ","عَلَيْهِمْ","وَأَنتَ","عَلَىٰ","كُلِّ","شَىْءٍ","شَهِيدٌ"],"marked":[19],"facts":{"verb":"تَوَفَّى"}},{"id":"tawaffa-6-61-12","words":["verb:tawaffa"],"options":[{"bs":"usmrtila ga je","en":"she/it took him in death"},{"bs":"usmrćuju ih","en":"they take them in death"},{"bs":"usmrtio si me","en":"you took me in death"},{"bs":"bivaju usmrćeni","en":"they are taken in death"}],"ref":"6:61","answerWord":"تَوَفَّتْهُ","answerSound":"audio/121e3734e91ebc02eba0.m4a","quranTranslation":{"text":"He is the Omnipotent over His slaves. He sendeth guardians over you until, when death cometh unto one of you, Our messengers receive him, and they neglect not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti dušu, usmrtiti","en":"to take the soul, to cause to die"},"passage":["وَهُوَ","ٱلْقَاهِرُ","فَوْقَ","عِبَادِهِۦ","وَيُرْسِلُ","عَلَيْكُمْ","حَفَظَةً","حَتَّىٰٓ","إِذَا","جَآءَ","أَحَدَكُمُ","ٱلْمَوْتُ","تَوَفَّتْهُ","رُسُلُنَا","وَهُمْ","لَا","يُفَرِّطُونَ"],"marked":[12],"facts":{"verb":"تَوَفَّى"}},{"id":"tawaffa-47-27-2","words":["verb:tawaffa"],"options":[{"bs":"uzimaju im duše","en":"they take them in death"},{"bs":"usmrtio si me","en":"you took me in death"},{"bs":"usmrtio ih je","en":"he/it took them in death"},{"bs":"usmrćuje ih","en":"he/it takes them in death"}],"ref":"47:27","answerWord":"تَوَفَّتْهُمُ","answerSound":"audio/79b0a144bad7bdadcc18.m4a","quranTranslation":{"text":"Then how (will it be with them) when the angels gather them, smiting their faces and their backs!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti dušu, usmrtiti","en":"to take the soul, to cause to die"},"passage":["فَكَيْفَ","إِذَا","تَوَفَّتْهُمُ","ٱلْمَلَٰٓئِكَةُ","يَضْرِبُونَ","وُجُوهَهُمْ","وَأَدْبَٰرَهُمْ"],"marked":[2],"facts":{"verb":"تَوَفَّى"}},{"id":"ghalaba-23-106-2","words":["verb:ghalaba"],"options":[{"bs":"nadvladala je","en":"overcame"},{"bs":"pobjeđujete","en":"you (all) overcome"},{"bs":"bivaju pobijeđeni","en":"they are overcome"},{"bs":"bit ćete pobijeđeni","en":"you (all) will be overcome"}],"ref":"23:106","answerWord":"غَلَبَتْ","answerSound":"audio/84912b2de372bb761d81.m4a","quranTranslation":{"text":"They will say: Our Lord! Our evil fortune conquered us, and we were erring folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pobijediti, nadvladati","en":"to overcome, to defeat"},"passage":["قَالُوا۟","رَبَّنَا","غَلَبَتْ","عَلَيْنَا","شِقْوَتُنَا","وَكُنَّا","قَوْمًا","ضَآلِّينَ"],"marked":[2],"facts":{"verb":"غَلَبَ"}},{"id":"ghalaba-8-65-11","words":["verb:ghalaba"],"options":[{"bs":"pobjeđuju","en":"they overcome"},{"bs":"pobijedili su","en":"they overcame"},{"bs":"pobjeđuje","en":"he/it overcomes"},{"bs":"nadvladala je","en":"overcame"}],"ref":"8:65","answerWord":"يَغْلِبُوا۟","answerSound":"audio/c6622fc26bf1bbe82c88.m4a","quranTranslation":{"text":"O Prophet! Exhort the believers to fight. If there be of you twenty steadfast they shall overcome two hundred, and if there be of you a hundred (steadfast) they shall overcome a thousand of those who disbelieve, because they (the disbelievers) are a folk without intelligence.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pobijediti, nadvladati","en":"to overcome, to defeat"},"passage":["يَٰٓأَيُّهَا","ٱلنَّبِىُّ","حَرِّضِ","ٱلْمُؤْمِنِينَ","عَلَى","ٱلْقِتَالِ","إِن","يَكُن","مِّنكُمْ","عِشْرُونَ","صَٰبِرُونَ","يَغْلِبُوا۟","مِا۟ئَتَيْنِ","وَإِن","يَكُن","مِّنكُم","مِّا۟ئَةٌ","يَغْلِبُوٓا۟","أَلْفًا","مِّنَ","ٱلَّذِينَ","كَفَرُوا۟","بِأَنَّهُمْ","قَوْمٌ","لَّا","يَفْقَهُونَ"],"marked":[11],"facts":{"verb":"غَلَبَ"}},{"id":"ghalaba-8-65-17","words":["verb:ghalaba"],"options":[{"bs":"pobjeđuju","en":"they overcome"},{"bs":"bit ćete pobijeđeni","en":"you (all) will be overcome"},{"bs":"zaista ću pobijediti","en":"surely I will overcome"},{"bs":"nadvladala je","en":"overcame"}],"ref":"8:65","answerWord":"يَغْلِبُوٓا۟","answerSound":"audio/2acda9e2f483a5730307.m4a","quranTranslation":{"text":"O Prophet! Exhort the believers to fight. If there be of you twenty steadfast they shall overcome two hundred, and if there be of you a hundred (steadfast) they shall overcome a thousand of those who disbelieve, because they (the disbelievers) are a folk without intelligence.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pobijediti, nadvladati","en":"to overcome, to defeat"},"passage":["يَٰٓأَيُّهَا","ٱلنَّبِىُّ","حَرِّضِ","ٱلْمُؤْمِنِينَ","عَلَى","ٱلْقِتَالِ","إِن","يَكُن","مِّنكُمْ","عِشْرُونَ","صَٰبِرُونَ","يَغْلِبُوا۟","مِا۟ئَتَيْنِ","وَإِن","يَكُن","مِّنكُم","مِّا۟ئَةٌ","يَغْلِبُوٓا۟","أَلْفًا","مِّنَ","ٱلَّذِينَ","كَفَرُوا۟","بِأَنَّهُمْ","قَوْمٌ","لَّا","يَفْقَهُونَ"],"marked":[17],"facts":{"verb":"غَلَبَ"}},{"id":"ghalaba-3-12-3","words":["verb:ghalaba"],"options":[{"bs":"bit ćete pobijeđeni","en":"you (all) will be overcome"},{"bs":"pa su pobijeđeni","en":"so they were overcome"},{"bs":"pobjeđuju","en":"they overcome"},{"bs":"pobjeđuje","en":"he/it overcomes"}],"ref":"3:12","answerWord":"سَتُغْلَبُونَ","answerSound":"audio/55c37f99c4bf2c966248.m4a","quranTranslation":{"text":"Say (O Muhammad) unto those who disbelieve: Ye shall be overcome and gathered unto Hell, an evil resting-place.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pobijediti, nadvladati","en":"to overcome, to defeat"},"passage":["قُل","لِّلَّذِينَ","كَفَرُوا۟","سَتُغْلَبُونَ","وَتُحْشَرُونَ","إِلَىٰ","جَهَنَّمَ","وَبِئْسَ","ٱلْمِهَادُ"],"marked":[3],"facts":{"verb":"غَلَبَ"}},{"id":"ghalaba-4-74-16","words":["verb:ghalaba"],"options":[{"bs":"pobjeđuje","en":"he/it overcomes"},{"bs":"pobijedit će","en":"they will overcome"},{"bs":"pa su pobijeđeni","en":"so they were overcome"},{"bs":"bivaju pobijeđeni","en":"they are overcome"}],"ref":"4:74","answerWord":"يَغْلِبْ","answerSound":"audio/230ad9eb5c6dfedfb77e.m4a","quranTranslation":{"text":"Let those fight in the way of Allah who sell the life of this world for the other. Whoso fighteth in the way of Allah, be he slain or be he victorious, on him We shall bestow a vast reward.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pobijediti, nadvladati","en":"to overcome, to defeat"},"passage":["فَلْيُقَٰتِلْ","فِى","سَبِيلِ","ٱللَّهِ","ٱلَّذِينَ","يَشْرُونَ","ٱلْحَيَوٰةَ","ٱلدُّنْيَا","بِٱلْءَاخِرَةِ","وَمَن","يُقَٰتِلْ","فِى","سَبِيلِ","ٱللَّهِ","فَيُقْتَلْ","أَوْ","يَغْلِبْ","فَسَوْفَ","نُؤْتِيهِ","أَجْرًا","عَظِيمًا"],"marked":[16],"facts":{"verb":"غَلَبَ"}},{"id":"ghalaba-7-119-0","words":["verb:ghalaba"],"options":[{"bs":"pa su pobijeđeni","en":"so they were overcome"},{"bs":"bivaju pobijeđeni","en":"they are overcome"},{"bs":"pobijedit će","en":"they will overcome"},{"bs":"nadvladala je","en":"overcame"}],"ref":"7:119","answerWord":"فَغُلِبُوا۟","answerSound":"audio/bb5bd930f5b09619eec8.m4a","quranTranslation":{"text":"Thus were they there defeated and brought low.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pobijediti, nadvladati","en":"to overcome, to defeat"},"passage":["فَغُلِبُوا۟","هُنَالِكَ","وَٱنقَلَبُوا۟","صَٰغِرِينَ"],"marked":[0],"facts":{"verb":"غَلَبَ"}},{"id":"ghalaba-8-36-15","words":["verb:ghalaba"],"options":[{"bs":"bivaju pobijeđeni","en":"they are overcome"},{"bs":"pobjeđujete","en":"you (all) overcome"},{"bs":"pobijeđena je","en":"she/it was overcome"},{"bs":"nadvladala je","en":"overcame"}],"ref":"8:36","answerWord":"يُغْلَبُونَ","answerSound":"audio/29f510e110f910d7fbbe.m4a","quranTranslation":{"text":"Lo! those who disbelieve spend their wealth in order that they may debar (men) from the way of Allah. They will spend it, then it will become an anguish for them, then they will be conquered. And those who disbelieve will be gathered unto hell,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pobijediti, nadvladati","en":"to overcome, to defeat"},"passage":["إِنَّ","ٱلَّذِينَ","كَفَرُوا۟","يُنفِقُونَ","أَمْوَٰلَهُمْ","لِيَصُدُّوا۟","عَن","سَبِيلِ","ٱللَّهِ","فَسَيُنفِقُونَهَا","ثُمَّ","تَكُونُ","عَلَيْهِمْ","حَسْرَةً","ثُمَّ","يُغْلَبُونَ","وَٱلَّذِينَ","كَفَرُوٓا۟","إِلَىٰ","جَهَنَّمَ","يُحْشَرُونَ"],"marked":[15],"facts":{"verb":"غَلَبَ"}},{"id":"ghalaba-30-2-0","words":["verb:ghalaba"],"options":[{"bs":"pobijeđena je","en":"she/it was overcome"},{"bs":"zaista ću pobijediti","en":"surely I will overcome"},{"bs":"pobjeđuju","en":"they overcome"},{"bs":"pobijedili su","en":"they overcame"}],"ref":"30:2","answerWord":"غُلِبَتِ","answerSound":"audio/f20e3873afc03b86287a.m4a","quranTranslation":{"text":"The Romans have been defeated","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pobijediti, nadvladati","en":"to overcome, to defeat"},"passage":["غُلِبَتِ","ٱلرُّومُ"],"marked":[0],"facts":{"verb":"غَلَبَ"}},{"id":"ghalaba-30-3-7","words":["verb:ghalaba"],"options":[{"bs":"pobijedit će","en":"they will overcome"},{"bs":"nadvladala je","en":"overcame"},{"bs":"zaista ću pobijediti","en":"surely I will overcome"},{"bs":"pobijedili su","en":"they overcame"}],"ref":"30:3","answerWord":"سَيَغْلِبُونَ","answerSound":"audio/914b9a03958616732ffc.m4a","quranTranslation":{"text":"In the nearer land, and they, after their defeat will be victorious","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pobijediti, nadvladati","en":"to overcome, to defeat"},"passage":["فِىٓ","أَدْنَى","ٱلْأَرْضِ","وَهُم","مِّنۢ","بَعْدِ","غَلَبِهِمْ","سَيَغْلِبُونَ"],"marked":[7],"facts":{"verb":"غَلَبَ"}},{"id":"ghalaba-41-26-10","words":["verb:ghalaba"],"options":[{"bs":"pobjeđujete","en":"you (all) overcome"},{"bs":"pa su pobijeđeni","en":"so they were overcome"},{"bs":"pobijeđena je","en":"she/it was overcome"},{"bs":"pobijedit će","en":"they will overcome"}],"ref":"41:26","answerWord":"تَغْلِبُونَ","answerSound":"audio/2706d6a1a577a96e72d4.m4a","quranTranslation":{"text":"Those who disbelieve say: Heed not this Qur'an, and drown the hearing of it; haply ye may conquer.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pobijediti, nadvladati","en":"to overcome, to defeat"},"passage":["وَقَالَ","ٱلَّذِينَ","كَفَرُوا۟","لَا","تَسْمَعُوا۟","لِهَٰذَا","ٱلْقُرْءَانِ","وَٱلْغَوْا۟","فِيهِ","لَعَلَّكُمْ","تَغْلِبُونَ"],"marked":[10],"facts":{"verb":"غَلَبَ"}},{"id":"ghalaba-58-21-2","words":["verb:ghalaba"],"options":[{"bs":"zaista ću pobijediti","en":"surely I will overcome"},{"bs":"bit ćete pobijeđeni","en":"you (all) will be overcome"},{"bs":"pobijedit će","en":"they will overcome"},{"bs":"pa su pobijeđeni","en":"so they were overcome"}],"ref":"58:21","answerWord":"لَأَغْلِبَنَّ","answerSound":"audio/35d9266a80df2e3f8b90.m4a","quranTranslation":{"text":"Allah hath decreed: Lo! I verily shall conquer, I and My messengers. Lo! Allah is Strong, Almighty.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pobijediti, nadvladati","en":"to overcome, to defeat"},"passage":["كَتَبَ","ٱللَّهُ","لَأَغْلِبَنَّ","أَنَا۠","وَرُسُلِىٓ","إِنَّ","ٱللَّهَ","قَوِىٌّ","عَزِيزٌ"],"marked":[2],"facts":{"verb":"غَلَبَ"}},{"id":"ahsa-78-29-2","words":["verb:ahsa"],"options":[{"bs":"izbrojali smo ga","en":"we counted it"},{"bs":"izbrojao ju je","en":"he/it counted it"},{"bs":"izbrojao ih je","en":"He has counted them"},{"bs":"i izbrojite!","en":"and (you all) count!"}],"ref":"78:29","answerWord":"أَحْصَيْنَٰهُ","answerSound":"audio/b3ee6f1695147e124502.m4a","quranTranslation":{"text":"Everything have We recorded in a Book.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrojati, prebrojati","en":"to count"},"passage":["وَكُلَّ","شَىْءٍ","أَحْصَيْنَٰهُ","كِتَٰبًا"],"marked":[2],"facts":{"verb":"أَحْصَى"}},{"id":"ahsa-18-49-18","words":["verb:ahsa"],"options":[{"bs":"izbrojao ju je","en":"he/it counted it"},{"bs":"i izbrojao je","en":"and he/it counted"},{"bs":"i izbrojite!","en":"and (you all) count!"},{"bs":"izbrojali smo ga","en":"we counted it"}],"ref":"18:49","answerWord":"أَحْصَىٰهَا","answerSound":"audio/73df6d8f8e13aaa770ee.m4a","quranTranslation":{"text":"And the Book is placed, and thou seest the guilty fearful of that which is therein, and they say: What kind of a Book is this that leaveth not a small thing nor a great thing but hath counted it! And they find all that they did confronting them, and thy Lord wrongeth no-one.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrojati, prebrojati","en":"to count"},"passage":["وَوُضِعَ","ٱلْكِتَٰبُ","فَتَرَى","ٱلْمُجْرِمِينَ","مُشْفِقِينَ","مِمَّا","فِيهِ","وَيَقُولُونَ","يَٰوَيْلَتَنَا","مَالِ","هَٰذَا","ٱلْكِتَٰبِ","لَا","يُغَادِرُ","صَغِيرَةً","وَلَا","كَبِيرَةً","إِلَّآ","أَحْصَىٰهَا","وَوَجَدُوا۟","مَا","عَمِلُوا۟","حَاضِرًا","وَلَا","يَظْلِمُ","رَبُّكَ","أَحَدًا"],"marked":[18],"facts":{"verb":"أَحْصَى"}},{"id":"ahsa-19-94-1","words":["verb:ahsa"],"options":[{"bs":"izbrojao ih je","en":"He has counted them"},{"bs":"brojite ga","en":"you (all) count it"},{"bs":"i izbrojite!","en":"and (you all) count!"},{"bs":"izbrojali smo ga","en":"we counted it"}],"ref":"19:94","answerWord":"أَحْصَىٰهُمْ","answerSound":"audio/4538c0a324e1939acfc2.m4a","quranTranslation":{"text":"Verily He knoweth them and numbereth them with (right) numbering.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrojati, prebrojati","en":"to count"},"passage":["لَّقَدْ","أَحْصَىٰهُمْ","وَعَدَّهُمْ","عَدًّا"],"marked":[1],"facts":{"verb":"أَحْصَى"}},{"id":"ahsa-58-6-7","words":["verb:ahsa"],"options":[{"bs":"izbrojao ga je","en":"he/it counted it"},{"bs":"i izbrojite!","en":"and (you all) count!"},{"bs":"izbrojali smo ga","en":"we counted it"},{"bs":"brojite ga","en":"you (all) count it"}],"ref":"58:6","answerWord":"أَحْصَىٰهُ","answerSound":"audio/5e9f24de1950d742f006.m4a","quranTranslation":{"text":"On the day when Allah will raise them all together and inform them of what they did. Allah hath kept account of it while they forgot it. And Allah is Witness over all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrojati, prebrojati","en":"to count"},"passage":["يَوْمَ","يَبْعَثُهُمُ","ٱللَّهُ","جَمِيعًا","فَيُنَبِّئُهُم","بِمَا","عَمِلُوٓا۟","أَحْصَىٰهُ","ٱللَّهُ","وَنَسُوهُ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَىْءٍ","شَهِيدٌ"],"marked":[7],"facts":{"verb":"أَحْصَى"}},{"id":"ahsa-72-28-9","words":["verb:ahsa"],"options":[{"bs":"i izbrojao je","en":"and he/it counted"},{"bs":"izbrojao ga je","en":"he/it counted it"},{"bs":"izbrojao ih je","en":"He has counted them"},{"bs":"i izbrojite!","en":"and (you all) count!"}],"ref":"72:28","answerWord":"وَأَحْصَىٰ","answerSound":"audio/a24f89371619548e6080.m4a","quranTranslation":{"text":"That He may know that they have indeed conveyed the messages of their Lord. He surroundeth all their doings, and He keepeth count of all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrojati, prebrojati","en":"to count"},"passage":["لِّيَعْلَمَ","أَن","قَدْ","أَبْلَغُوا۟","رِسَٰلَٰتِ","رَبِّهِمْ","وَأَحَاطَ","بِمَا","لَدَيْهِمْ","وَأَحْصَىٰ","كُلَّ","شَىْءٍ","عَدَدًۢا"],"marked":[9],"facts":{"verb":"أَحْصَى"}},{"id":"fatara-6-79-4","words":["verb:fatara"],"options":[{"bs":"stvorio je","en":"he/it created"},{"bs":"stvorio vas je","en":"he/it created you (all)"},{"bs":"stvorio me je","en":"He created me"},{"bs":"stvorio nas je","en":"he/it created us"}],"ref":"6:79","answerWord":"فَطَرَ","answerSound":"audio/9f721e12f8a4f0f82407.m4a","quranTranslation":{"text":"Lo! I have turned my face toward Him Who created the heavens and the earth, as one by nature upright, and I am not of the idolaters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, dati postanak","en":"to create, to originate"},"passage":["إِنِّى","وَجَّهْتُ","وَجْهِىَ","لِلَّذِى","فَطَرَ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضَ","حَنِيفًا","وَمَآ","أَنَا۠","مِنَ","ٱلْمُشْرِكِينَ"],"marked":[4],"facts":{"verb":"فَطَرَ"}},{"id":"fatara-43-27-2","words":["verb:fatara"],"options":[{"bs":"stvorio me je","en":"He created me"},{"bs":"stvorio nas je","en":"he/it created us"},{"bs":"stvorio vas je","en":"he/it created you (all)"},{"bs":"stvorio ih je","en":"he/it created them"}],"ref":"43:27","answerWord":"فَطَرَنِى","answerSound":"audio/6a76858c9901910742d8.m4a","quranTranslation":{"text":"Save Him Who did create me, for He will surely guide me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, dati postanak","en":"to create, to originate"},"passage":["إِلَّا","ٱلَّذِى","فَطَرَنِى","فَإِنَّهُۥ","سَيَهْدِينِ"],"marked":[2],"facts":{"verb":"فَطَرَ"}},{"id":"fatara-11-51-10","words":["verb:fatara"],"options":[{"bs":"stvorio me je","en":"he/it created me"},{"bs":"stvorio je","en":"he/it created"},{"bs":"stvorio nas je","en":"he/it created us"},{"bs":"stvorio ih je","en":"he/it created them"}],"ref":"11:51","answerWord":"فَطَرَنِىٓ","answerSound":"audio/342b669c7a3a706ed5fe.m4a","quranTranslation":{"text":"O my people! I ask of you no reward for it. Lo! my reward is the concern only of Him Who made me. Have ye then no sense?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, dati postanak","en":"to create, to originate"},"passage":["يَٰقَوْمِ","لَآ","أَسْـَٔلُكُمْ","عَلَيْهِ","أَجْرًا","إِنْ","أَجْرِىَ","إِلَّا","عَلَى","ٱلَّذِى","فَطَرَنِىٓ","أَفَلَا","تَعْقِلُونَ"],"marked":[10],"facts":{"verb":"فَطَرَ"}},{"id":"fatara-17-51-11","words":["verb:fatara"],"options":[{"bs":"stvorio vas je","en":"he/it created you (all)"},{"bs":"stvorio nas je","en":"he/it created us"},{"bs":"stvorio je","en":"he/it created"},{"bs":"stvorio ih je","en":"he/it created them"}],"ref":"17:51","answerWord":"فَطَرَكُمْ","answerSound":"audio/ff9d6c191b705b6c9f4c.m4a","quranTranslation":{"text":"Or some created thing that is yet greater in your thoughts! Then they will say: Who shall bring us back (to life). Say: He Who created you at the first. Then will they shake their heads at thee, and say: When will it be? Say: It will perhaps be soon;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, dati postanak","en":"to create, to originate"},"passage":["أَوْ","خَلْقًا","مِّمَّا","يَكْبُرُ","فِى","صُدُورِكُمْ","فَسَيَقُولُونَ","مَن","يُعِيدُنَا","قُلِ","ٱلَّذِى","فَطَرَكُمْ","أَوَّلَ","مَرَّةٍ","فَسَيُنْغِضُونَ","إِلَيْكَ","رُءُوسَهُمْ","وَيَقُولُونَ","مَتَىٰ","هُوَ","قُلْ","عَسَىٰٓ","أَن","يَكُونَ","قَرِيبًا"],"marked":[11],"facts":{"verb":"فَطَرَ"}},{"id":"fatara-20-72-9","words":["verb:fatara"],"options":[{"bs":"stvorio nas je","en":"he/it created us"},{"bs":"stvorio me je","en":"he/it created me"},{"bs":"stvorio je","en":"he/it created"},{"bs":"stvorio ih je","en":"he/it created them"}],"ref":"20:72","answerWord":"فَطَرَنَا","answerSound":"audio/70f92514356135612ce8.m4a","quranTranslation":{"text":"They said: We choose thee not above the clear proofs that have come unto us, and above Him Who created us. So decree what thou wilt decree. Thou wilt end for us only this life of the world.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, dati postanak","en":"to create, to originate"},"passage":["قَالُوا۟","لَن","نُّؤْثِرَكَ","عَلَىٰ","مَا","جَآءَنَا","مِنَ","ٱلْبَيِّنَٰتِ","وَٱلَّذِى","فَطَرَنَا","فَٱقْضِ","مَآ","أَنتَ","قَاضٍ","إِنَّمَا","تَقْضِى","هَٰذِهِ","ٱلْحَيَوٰةَ","ٱلدُّنْيَآ"],"marked":[9],"facts":{"verb":"فَطَرَ"}},{"id":"fatara-21-56-7","words":["verb:fatara"],"options":[{"bs":"stvorio ih je","en":"he/it created them"},{"bs":"stvorio nas je","en":"he/it created us"},{"bs":"stvorio vas je","en":"he/it created you (all)"},{"bs":"stvorio je","en":"he/it created"}],"ref":"21:56","answerWord":"فَطَرَهُنَّ","answerSound":"audio/598b93f362ed1b530c28.m4a","quranTranslation":{"text":"He said: Nay, but your Lord is the Lord of the heavens and the earth, Who created them; and I am of those who testify unto that.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, dati postanak","en":"to create, to originate"},"passage":["قَالَ","بَل","رَّبُّكُمْ","رَبُّ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","ٱلَّذِى","فَطَرَهُنَّ","وَأَنَا۠","عَلَىٰ","ذَٰلِكُم","مِّنَ","ٱلشَّٰهِدِينَ"],"marked":[7],"facts":{"verb":"فَطَرَ"}},{"id":"bawwaa-10-93-1","words":["verb:bawwaa"],"options":[{"bs":"nastanili smo","en":"we settled"},{"bs":"i nastanio vas je","en":"and he/it settled you (all)"},{"bs":"zaista ćemo ih nastaniti","en":"surely we will settle them"},{"bs":"raspoređivao si","en":"you were stationing"}],"ref":"10:93","answerWord":"بَوَّأْنَا","answerSound":"audio/a06a1c89dd04c3bee429.m4a","quranTranslation":{"text":"And We verily did allot unto the Children of Israel a fixed abode, and did provide them with good things; and they differed not until the knowledge came unto them. Lo! thy Lord will judge between them on the Day of Resurrection concerning that wherein they used to differ.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nastaniti, smjestiti","en":"to settle, to accommodate"},"passage":["وَلَقَدْ","بَوَّأْنَا","بَنِىٓ","إِسْرَٰٓءِيلَ","مُبَوَّأَ","صِدْقٍ","وَرَزَقْنَٰهُم","مِّنَ","ٱلطَّيِّبَٰتِ","فَمَا","ٱخْتَلَفُوا۟","حَتَّىٰ","جَآءَهُمُ","ٱلْعِلْمُ","إِنَّ","رَبَّكَ","يَقْضِى","بَيْنَهُمْ","يَوْمَ","ٱلْقِيَٰمَةِ","فِيمَا","كَانُوا۟","فِيهِ","يَخْتَلِفُونَ"],"marked":[1],"facts":{"verb":"بَوَّأَ"}},{"id":"bawwaa-7-74-7","words":["verb:bawwaa"],"options":[{"bs":"i nastanio vas je","en":"and he/it settled you (all)"},{"bs":"nastanili smo","en":"we settled"},{"bs":"raspoređivao si","en":"you were stationing"},{"bs":"zaista ćemo ih nastaniti","en":"surely we will settle them"}],"ref":"7:74","answerWord":"وَبَوَّأَكُمْ","answerSound":"audio/38744ebc96000d5171e9.m4a","quranTranslation":{"text":"And remember how He made you viceroys after A'ad and gave you station in the earth. Ye choose castles in the plains and hew the mountains into dwellings. So remember (all) the bounties of Allah and do not evil, making mischief in the earth.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nastaniti, smjestiti","en":"to settle, to accommodate"},"passage":["وَٱذْكُرُوٓا۟","إِذْ","جَعَلَكُمْ","خُلَفَآءَ","مِنۢ","بَعْدِ","عَادٍ","وَبَوَّأَكُمْ","فِى","ٱلْأَرْضِ","تَتَّخِذُونَ","مِن","سُهُولِهَا","قُصُورًا","وَتَنْحِتُونَ","ٱلْجِبَالَ","بُيُوتًا","فَٱذْكُرُوٓا۟","ءَالَآءَ","ٱللَّهِ","وَلَا","تَعْثَوْا۟","فِى","ٱلْأَرْضِ","مُفْسِدِينَ"],"marked":[7],"facts":{"verb":"بَوَّأَ"}},{"id":"bawwaa-16-41-8","words":["verb:bawwaa"],"options":[{"bs":"zaista ćemo ih nastaniti","en":"surely we will settle them"},{"bs":"i nastanio vas je","en":"and he/it settled you (all)"},{"bs":"raspoređivao si","en":"you were stationing"},{"bs":"nastanili smo","en":"we settled"}],"ref":"16:41","answerWord":"لَنُبَوِّئَنَّهُمْ","answerSound":"audio/d70d8005542f2b355941.m4a","quranTranslation":{"text":"And those who became fugitives for the cause of Allah after they had been oppressed, We verily shall give them goodly lodging in the world, and surely the reward of the Hereafter is greater, if they but knew;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nastaniti, smjestiti","en":"to settle, to accommodate"},"passage":["وَٱلَّذِينَ","هَاجَرُوا۟","فِى","ٱللَّهِ","مِنۢ","بَعْدِ","مَا","ظُلِمُوا۟","لَنُبَوِّئَنَّهُمْ","فِى","ٱلدُّنْيَا","حَسَنَةً","وَلَأَجْرُ","ٱلْءَاخِرَةِ","أَكْبَرُ","لَوْ","كَانُوا۟","يَعْلَمُونَ"],"marked":[8],"facts":{"verb":"بَوَّأَ"}},{"id":"bawwaa-29-58-4","words":["verb:bawwaa"],"options":[{"bs":"zaista ćemo ih nastaniti","en":"surely we will settle them"},{"bs":"raspoređivao si","en":"you were stationing"},{"bs":"nastanili smo","en":"we settled"},{"bs":"i nastanio vas je","en":"and he/it settled you (all)"}],"ref":"29:58","answerWord":"لَنُبَوِّئَنَّهُم","answerSound":"audio/408d947a910242f92ed7.m4a","quranTranslation":{"text":"Those who believe and do good works, them verily We shall house in lofty dwellings of the Garden underneath which rivers flow. There they will dwell secure. How sweet the guerdon of the toilers,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nastaniti, smjestiti","en":"to settle, to accommodate"},"passage":["وَٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","لَنُبَوِّئَنَّهُم","مِّنَ","ٱلْجَنَّةِ","غُرَفًا","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَٰرُ","خَٰلِدِينَ","فِيهَا","نِعْمَ","أَجْرُ","ٱلْعَٰمِلِينَ"],"marked":[4],"facts":{"verb":"بَوَّأَ"}},{"id":"nakatha-43-50-6","words":["verb:nakatha"],"options":[{"bs":"prekršili su (riječ)","en":"they broke (their word)"},{"bs":"prekršio je","en":"he/it broke (an oath or a pledge)"},{"bs":"prekršili su","en":"they broke (an oath or a pledge)"},{"bs":"krši","en":"he/it breaks (an oath or a pledge)"}],"ref":"43:50","answerWord":"يَنكُثُونَ","answerSound":"audio/f71b5b14813aad554645.m4a","quranTranslation":{"text":"But when We eased them of the torment, behold! they broke their word.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"prekršiti (zakletvu, ugovor)","en":"to break (an oath or a pledge)"},"passage":["فَلَمَّا","كَشَفْنَا","عَنْهُمُ","ٱلْعَذَابَ","إِذَا","هُمْ","يَنكُثُونَ"],"marked":[6],"facts":{"verb":"نَكَثَ"}},{"id":"nakatha-9-12-1","words":["verb:nakatha"],"options":[{"bs":"prekršili su","en":"they broke (an oath or a pledge)"},{"bs":"prekršio je","en":"he/it broke (an oath or a pledge)"},{"bs":"prekršili su (riječ)","en":"they broke (their word)"},{"bs":"krši","en":"he/it breaks (an oath or a pledge)"}],"ref":"9:12","answerWord":"نَّكَثُوٓا۟","answerSound":"audio/27349c33d7e381699594.m4a","quranTranslation":{"text":"And if they break their pledges after their treaty (hath been made with you) and assail your religion, then fight the heads of disbelief - Lo! they have no binding oaths - in order that they may desist.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"prekršiti (zakletvu, ugovor)","en":"to break (an oath or a pledge)"},"passage":["وَإِن","نَّكَثُوٓا۟","أَيْمَٰنَهُم","مِّنۢ","بَعْدِ","عَهْدِهِمْ","وَطَعَنُوا۟","فِى","دِينِكُمْ","فَقَٰتِلُوٓا۟","أَئِمَّةَ","ٱلْكُفْرِ","إِنَّهُمْ","لَآ","أَيْمَٰنَ","لَهُمْ","لَعَلَّهُمْ","يَنتَهُونَ"],"marked":[1],"facts":{"verb":"نَكَثَ"}},{"id":"nakatha-48-10-11","words":["verb:nakatha"],"options":[{"bs":"prekršio je","en":"he/it broke (an oath or a pledge)"},{"bs":"prekršili su (riječ)","en":"they broke (their word)"},{"bs":"krši","en":"he/it breaks (an oath or a pledge)"},{"bs":"prekršili su","en":"they broke (an oath or a pledge)"}],"ref":"48:10","answerWord":"نَّكَثَ","answerSound":"audio/1d23061c7bc2f156df49.m4a","quranTranslation":{"text":"Lo! those who swear allegiance unto thee (Muhammad), swear allegiance only unto Allah. The Hand of Allah is above their hands. So whosoever breaketh his oath, breaketh it only to his soul's hurt; while whosoever keepeth his covenant with Allah, on him will He bestow immense reward.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"prekršiti (zakletvu, ugovor)","en":"to break (an oath or a pledge)"},"passage":["إِنَّ","ٱلَّذِينَ","يُبَايِعُونَكَ","إِنَّمَا","يُبَايِعُونَ","ٱللَّهَ","يَدُ","ٱللَّهِ","فَوْقَ","أَيْدِيهِمْ","فَمَن","نَّكَثَ","فَإِنَّمَا","يَنكُثُ","عَلَىٰ","نَفْسِهِۦ","وَمَنْ","أَوْفَىٰ","بِمَا","عَٰهَدَ","عَلَيْهُ","ٱللَّهَ","فَسَيُؤْتِيهِ","أَجْرًا","عَظِيمًا"],"marked":[11],"facts":{"verb":"نَكَثَ"}},{"id":"nakatha-48-10-13","words":["verb:nakatha"],"options":[{"bs":"krši","en":"he/it breaks (an oath or a pledge)"},{"bs":"prekršili su (riječ)","en":"they broke (their word)"},{"bs":"prekršio je","en":"he/it broke (an oath or a pledge)"},{"bs":"prekršili su","en":"they broke (an oath or a pledge)"}],"ref":"48:10","answerWord":"يَنكُثُ","answerSound":"audio/f23a6c63ba158e870ff0.m4a","quranTranslation":{"text":"Lo! those who swear allegiance unto thee (Muhammad), swear allegiance only unto Allah. The Hand of Allah is above their hands. So whosoever breaketh his oath, breaketh it only to his soul's hurt; while whosoever keepeth his covenant with Allah, on him will He bestow immense reward.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"prekršiti (zakletvu, ugovor)","en":"to break (an oath or a pledge)"},"passage":["إِنَّ","ٱلَّذِينَ","يُبَايِعُونَكَ","إِنَّمَا","يُبَايِعُونَ","ٱللَّهَ","يَدُ","ٱللَّهِ","فَوْقَ","أَيْدِيهِمْ","فَمَن","نَّكَثَ","فَإِنَّمَا","يَنكُثُ","عَلَىٰ","نَفْسِهِۦ","وَمَنْ","أَوْفَىٰ","بِمَا","عَٰهَدَ","عَلَيْهُ","ٱللَّهَ","فَسَيُؤْتِيهِ","أَجْرًا","عَظِيمًا"],"marked":[13],"facts":{"verb":"نَكَثَ"}}]