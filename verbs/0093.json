audio/083611624228646a9d3d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُبْلُغُوا", "plain": "اُبْلُغُوا", "quran": false, "notUsed": false, "spoken": "audio/7e522aced454851fc118.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُبْلُغْنَ", "plain": "اُبْلُغْنَ", "quran": false, "notUsed": false, "spoken": "audio/b62a38fe4bb7048e51d6.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "12:22", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1618.mp3", "translation": {"en": {"text": "And And when he reached his prime We gave him wisdom and knowledge. Thus We reward the good.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O, tam erginlik çağına gelince, kendisine ilim ve hüküm verdik. İşte biz, güzel iş yapanları böyle mükafatlandırırız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جب اپنی پوری قوت کو پہنچا ہم نے اسے حکم اور علم عطا فرمایا اور ہم ایسا ہی صلہ دیتے ہیں نیکوں کو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan tatkala dia cukup dewasa Kami berikan kepadanya hikmah dan ilmu. Demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "بَلَغَ", "hit": true, "audio": "audio/e6ee287337c91cd703ab.m4a", "gloss": {"en": "he/it reached", "bs": "dostigao je", "tr": "ulaştı", "fr": "il a atteint", "id": "dia telah mencapai", "ur": "وہ پہنچا", "bn": "সে পৌঁছাল", "fa": "رسید"}}, {"text": "أَشُدَّهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاتَيْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "حُكْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَعِلْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَكَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَجْزِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُحْسِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "40:80", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4213.mp3", "translation": {"en": {"text": "(Many) benefits ye have from them - and that ye may satisfy by their means a need that is in your breasts, and may be borne upon them as upon the ship.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sizin için onlarda daha nice menfaatler vardır. Onların üzerinde gönüllerinizdeki bir arzuya erersiniz. Hem onlar üzerinde, hem de gemiler üzerinde taşınırsınız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور تمہارے لیے ان میں کتنے ہی فائدے ہیں اور اس لیے کہ تم ان کی پیٹھ پر اپنے دل کی مرادوں کو پہنچو اور ان پر اور کشتیوں پر سوار ہوتے ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan (ada lagi) manfaat-manfaat yang lain pada binatang ternak itu untuk kamu dan supaya kamu mencapai suatu keperluan yang tersimpan dalam hati dengan mengendarainya. Dan kamu dapat diangkut dengan mengendarai binatang-binatang itu dan dengan mengendarai bahtera.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَنَٰفِعُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلِتَبْلُغُوا۟", "hit": true, "audio": "audio/fb6f50fd69f2fedcc4ad.m4a", "gloss": {"en": "and so that you (all) may reach", "bs": "i da dostignete", "tr": "ve ulaşasınız diye", "fr": "et que vous atteigniez", "id": "dan agar kalian mencapai", "ur": "اور تاکہ تم پہنچو", "bn": "এবং যাতে তোমরা পৌঁছাও", "fa": "و تا برسید"}}, {"text": "عَلَيْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "حَاجَةً", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "صُدُورِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَعَلَيْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَعَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْفُلْكِ", "hit": false, "audio": null, "gloss": null}, {"text": "تُحْمَلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "56:83", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5062.mp3", "translation": {"en": {"text": "Why, then, when (the soul) cometh up to the throat (of the dying)", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Can boğaza dayandığı zaman", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر کیوں نہ ہو جب جان گلے تک پہنچے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka mengapa ketika nyawa sampai di kerongkongan,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَوْلَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "بَلَغَتِ", "hit": true, "audio": "audio/f852dfce493ba140a9e6.m4a", "gloss": {"bs": "(kad) dopre", "en": "(when it) reaches", "tr": "(ulaştığında)", "fr": "(lorsqu')elle atteint", "id": "(ketika) sampai", "ur": "(جب) پہنچ جائے", "bn": "(যখন তা) পৌঁছায়", "fa": "(وقتی) برسد"}}, {"text": "ٱلْحُلْقُومَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "40:36", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4169.mp3", "translation": {"en": {"text": "And Pharaoh said: O Haman! Build for me a tower that haply I may reach the roads,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Firavun dedi ki: \"Ey Hâmân! Bana bir kule yap, belki ben o yollara ulaşabilirim.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور فرعون بولا اے ہامان! میرے لیے اونچا محل بنا شاید میں پہنچ جاؤں راستوں تک،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan berkatalah Fir'aun: \"Hai Haman, buatkanlah bagiku sebuah bangunan yang tinggi supaya aku sampai ke pintu-pintu,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِرْعَوْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰهَٰمَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱبْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "لِى", "hit": false, "audio": null, "gloss": null}, {"text": "صَرْحًا", "hit": false, "audio": null, "gloss": null}, {"text": "لَّعَلِّىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَبْلُغُ", "hit": true, "audio": "audio/9c7ef3ffa93596f0c95b.m4a", "gloss": {"bs": "(da) dosegnem", "en": "I may reach", "tr": "ulaşırım diye", "fr": "que j'atteigne", "id": "aku mencapai", "ur": "(کہ) میں پہنچ جاؤں", "bn": "আমি পৌঁছাতে পারি", "fa": "(که) برسم"}}, {"text": "ٱلْأَسْبَٰبَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:61", "tense": "past", "category": {"tense": "past", "pronoun": "huma", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2201.mp3", "translation": {"en": {"text": "And when they reached the point where the two met, they forgot their fish, and it took its way into the waters, being free.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine ikisi de iki denizin birleştiği yere vardıklarında balıklarını unuttular. Bu arada balık, denizde yolunu bulup kaybolmuştu.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر جب وہ دونوں ان دریاؤں کے ملنے کی جگہ پہنچے اپنی مچھلی بھول گئے اور اس نے سمندر میں اپنی راہ لی سرنگ بناتی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka tatkala mereka sampai ke pertemuan dua buah laut itu, mereka lalai akan ikannya, lalu ikan itu melompat mengambil jalannya ke laut itu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "بَلَغَا", "hit": true, "audio": "audio/9bfd3b4d964e96136076.m4a", "gloss": {"en": "they (two) reached", "bs": "dostigli su", "tr": "ulaştılar", "fr": "ils (deux) ont atteint", "id": "mereka berdua telah mencapai", "ur": "وہ دونوں پہنچے", "bn": "তারা দুজন পৌঁছাল", "fa": "آن دو رسیدند"}}, {"text": "مَجْمَعَ", "hit": false, "audio": null, "gloss": null}, {"text": "بَيْنِهِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "نَسِيَا", "hit": false, "audio": null, "gloss": null}, {"text": "حُوتَهُمَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱتَّخَذَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَبِيلَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبَحْرِ", "hit": false, "audio": null, "gloss": null}, {"text": "سَرَبًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "بَلَغَ", "count": 9, "first": "6:19", "audio": "audio/36c9f84c3f7a52205071.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it reached", "bs": "dostigao je", "tr": "ulaştı", "fr": "il a atteint", "id": "dia telah mencapai", "ur": "وہ پہنچا", "bn": "সে পৌঁছাল", "fa": "رسید"}}, {"arabic": "يَبْلُغَ", "count": 5, "first": "2:196", "audio": "audio/8f3f4295d9c98a475f7f.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "he/it reaches", "bs": "dostiže", "tr": "ulaşır", "fr": "il atteint", "id": "dia mencapai", "ur": "وہ پہنچتا ہے", "bn": "সে পৌঁছায়", "fa": "برسد"}}, {"ar