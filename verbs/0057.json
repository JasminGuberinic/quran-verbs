{"rank": 57, "root": "قضي", "form": 1, "lemma": "قَضَى", "count": 59, "ayahCount": 56, "share": 0.3, "meaning": {"bs": "odrediti, izvršiti", "en": "to decree, to carry out", "tr": "hükmetmek, yerine getirmek", "fr": "décréter, accomplir", "id": "menetapkan, melaksanakan", "ur": "فیصلہ کرنا، پورا کرنا", "bn": "ফয়সালা করা, সম্পন্ন করা", "fa": "حکم کردن، به انجام رساندن"}, "lemmaSpoken": "audio/bbd2ac6ea18138367093.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "قَضَىٰ", "plain": "قَضَى", "quran": true, "notUsed": false, "spoken": "audio/bbd2ac6ea18138367093.m4a", "recited": "audio/9b049370e61478103356.m4a", "recitedText": "قَضَىٰ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَقْضِى", "plain": "يَقْضِي", "quran": true, "notUsed": false, "spoken": "audio/2e587eb593de817ae744.m4a", "recited": "audio/9a5cea9e4c06430128c6.m4a", "recitedText": "يَقْضِى"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱقْضِ", "plain": "اِقْضِ", "quran": true, "notUsed": false, "spoken": "audio/d3b4cd1bdcd4c21de17d.m4a", "recited": "audio/63f5320ba8b958fe58b9.m4a", "recitedText": "فَٱقْضِ"}], "nouns": {"participle": {"lemma": "قاض", "count": 1, "spoken": "audio/16321451e1467a7eaa9d.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "قَضَيْتُ", "plain": "قَضَيْتُ", "quran": true, "notUsed": false, "spoken": "audio/5826c2656c1fd07e6b7c.m4a", "recited": "audio/3495fd98b62f60490e62.m4a", "recitedText": "قَضَيْتُ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "قَضَيْنَآ", "plain": "قَضَيْنَا", "quran": true, "notUsed": false, "spoken": "audio/835102e23074e3ad7c5b.m4a", "recited": "audio/2edac4a55761328005ee.m4a", "recitedText": "قَضَيْنَآ"}, {"tense": "past", "pronoun": "anta", "arabic": "قَضَيْتَ", "plain": "قَضَيْتَ", "quran": true, "notUsed": false, "spoken": "audio/1d9ad992d0606bf5f14b.m4a", "recited": "audio/c60c6b63822b78747676.m4a", "recitedText": "قَضَيْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "قَضَيْتِ", "plain": "قَضَيْ