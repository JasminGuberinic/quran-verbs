 "target": true, "translation": {"bs": "uzimam za svjedoka", "en": "call to witness", "bn": "আমি সাক্ষী রাখি", "fa": "گواه می‌گیرم", "fr": "je prends à témoin", "id": "aku mempersaksikan", "tr": "şahit tutarım", "ur": "میں گواہ بناتا ہوں"}}, {"arabic": "صَدِيقِي", "target": false, "translation": {"bs": "prijatelja", "en": "my friend", "bn": "আমার বন্ধু", "fa": "دوستم", "fr": "mon ami", "id": "temanku", "tr": "arkadaşım", "ur": "میرا دوست"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "na", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "الْبَيْعِ", "target": false, "translation": {"bs": "prodaju", "en": "the sale", "bn": "বিক্রি", "fa": "فروش", "fr": "la vente", "id": "penjualan", "tr": "satış", "ur": "فروخت"}}]}, {"arabic": "أَشْهِدُوا جِيرَانَكُمْ عَلَى الِاتِّفَاقِ", "spoken": "audio/baeaa82d1218bf842f0d.m4a", "tense": "imperative", "pronoun": "antum", "translation": {"bs": "Uzmite (svi) svoje komšije za svjedoke sporazuma.", "en": "Call your (pl.) neighbors to witness the agreement, (all of you).", "bn": "তোমরা তোমাদের প্রতিবেশীদের চুক্তির সাক্ষী রাখ।", "fa": "شما همسایگان خود را بر توافق گواه بگیرید.", "fr": "Prenez vos voisins à témoin de l'accord, vous tous.", "id": "Persaksikanlah tetangga-tetangga kalian atas kesepakatan itu, wahai kalian semua.", "tr": "Komşularınızı anlaşmaya şahit tutun, hepiniz.", "ur": "تم سب اپنے پڑوسیوں کو سمجھوتے پر گواہ بناؤ۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَشْهِدُوا", "target": true, "translation": {"bs": "uzmite za svjedoke", "en": "call to witness (you all)", "bn": "তোমরা সাক্ষী রাখ", "fa": "گواه بگیرید", "fr": "prenez à témoin", "id": "persaksikanlah (kalian)", "tr": "şahit tutun", "ur": "تم سب گواہ بناؤ"}}, {"arabic": "جِيرَانَكُمْ", "target": false, "translation": {"bs": "svoje komšije", "en": "your (pl.) neighbors", "bn": "তোমাদের প্রতিবেশীরা", "fa": "همسایگانتان", "fr": "vos voisins", "id": "tetangga-tetangga kalian", "tr": "komşularınız", "ur": "تم سب کے پڑوسی"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "na", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "الِاتِّفَاقِ", "target": false, "translation": {"bs": "sporazum", "en": "the agreement", "bn": "চুক্তি", "fa": "توافق", "fr": "l'accord", "id": "kesepakatan itu", "tr": "anlaşma", "ur": "سمجھوتا"}}]}]}