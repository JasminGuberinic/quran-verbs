": "اُدْرُسِي", "quran": false, "notUsed": false, "spoken": "audio/6e670f74df90cf6def49.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُدْرُسَا", "plain": "اُدْرُسَا", "quran": false, "notUsed": false, "spoken": "audio/8aba6ecf94f37e96dbb3.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُدْرُسُوا", "plain": "اُدْرُسُوا", "quran": false, "notUsed": false, "spoken": "audio/522ae9ca9d4eb00cd9f9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُدْرُسْنَ", "plain": "اُدْرُسْنَ", "quran": false, "notUsed": false, "spoken": "audio/4dc52fca46f0a4b2d1cc.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "68:37", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5308.mp3", "translation": {"en": {"text": "Or have ye a scripture wherein ye learn", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yoksa size ait bir kitap var da onda mı okuyorsunuz?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا تمہارے لیے کوئی کتاب ہے اس میں پڑھتے ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Atau adakah kamu mempunyai sebuah kitab (yang diturunkan Allah) yang kamu membacanya?,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كِتَٰبٌ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "تَدْرُسُونَ", "hit": true, "audio": "audio/e90f8a78f586e2d9ab2e.m4a", "gloss": {"bs": "učite", "en": "you (all) study", "tr": "okursunuz", "fr": "vous étudiez", "id": "kalian mempelajari", "ur": "تم سب پڑھتے ہو", "bn": "তোমরা অধ্যয়ন কর", "fa": "شما می‌خوانید"}}]}, {"ref": "6:105", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/894.mp3", "translation": {"en": {"text": "Thus do We display Our revelations that they may say (unto thee, Muhammad): \"Thou hast studied,\" and that We may make (it) clear for people who have knowledge.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte böylece âyetleri türlü türlü çevirip açıklıyoruz ki, onlar sana: \"Sen bunları bir yerlerden okuyup öğrenmişsin\" desinler ve bilen bir toplum için de onu iyice beyan edelim.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم اسی طرح آیتیں طرح طرح سے بیان کرتے اور اس لیے کہ کافر بول اٹھیں کہ تم تو پڑھے ہو اور اس لیے کہ اسے علم والوں پر واضح کردیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Demikianlah Kami mengulang-ulangi ayat-ayat Kami supaya (orang-orang yang beriman mendapat petunjuk) dan supaya orang-orang musyrik mengatakan: \"Kamu telah mempelajari ayat-ayat itu (dari Ahli Kitab)\", dan supaya Kami menjelaskan Al Quran itu kepada orang-orang yang mengetahui.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَكَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نُصَرِّفُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْءَايَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلِيَقُولُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "دَرَسْتَ", "hit": true, "audio": "audio/7461b5040677960d9f72.m4a", "gloss": {"bs": "ti si učio", "en": "you have studied", "tr": "okudun", "fr": "tu as étudié", "id": "engkau telah mempelajari", "ur": "تم نے پڑھا ہے", "bn": "তুমি অধ্যয়ন করেছ", "fa": "تو خوانده‌ای"}}, {"text": "وَلِنُبَيِّنَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "لِقَوْمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْلَمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "34:44", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3650.mp3", "translation": {"en": {"text": "And We have given them no scriptures which they study, nor sent We unto them, before thee, any warner.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Halbuki biz onlara öyle ders alacakları kitaplar göndermedik. Kendilerine senden önce bir uyarıcı da göndermedik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے انہیں کچھ کتابیں نہ دیں جنہیں پڑھتے ہوں نہ تم سے پہلے ان کے پاس کوئی ڈر سنانے والا آیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami tidak pernah memberikan kepada mereka kitab-kitab yang mereka baca dan sekali-kali tidak pernah (pula) mengutus kepada mereka sebelum kamu seorang pemberi peringatanpun.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاتَيْنَٰهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "كُتُبٍ", "hit": false, "audio": null, "gloss": null}, {"text": "يَدْرُسُونَهَا", "hit": true, "audio": "audio/8f6b92e13b07e6518ab8.m4a", "gloss": {"en": "they study them", "bs": "proučavaju ih", "tr": "onları incelerler", "fr": "ils les étudient", "id": "mereka mempelajari mereka", "ur": "وہ انہیں پڑھتے ہیں", "bn": "তারা তাদের অধ্যয়ন করে", "fa": "بررسی می‌کنند"}}, {"text": "وَمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْسَلْنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "قَبْلَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "نَّذِيرٍ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تَدْرُسُ