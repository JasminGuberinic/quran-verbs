d": "Ibu itu memperdengarkan sebuah lagu kepada anaknya.", "tr": "Anne çocuğuna bir şarkı dinletir.", "ur": "ماں اپنے بچے کو ایک گانا سناتی ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "تُسْمِعُ", "target": true, "translation": {"bs": "pušta da čuje", "en": "makes hear", "bn": "শোনায়", "fa": "می‌شنواند", "fr": "fait entendre", "id": "memperdengarkan", "tr": "dinletir", "ur": "وہ سناتی ہے"}}, {"arabic": "الْأُمُّ", "target": false, "translation": {"bs": "majka", "en": "the mother", "bn": "মা", "fa": "مادر", "fr": "la mère", "id": "ibu itu", "tr": "anne", "ur": "ماں"}}, {"arabic": "طِفْلَهَا", "target": false, "translation": {"bs": "svom djetetu", "en": "her child", "bn": "তার শিশু", "fa": "کودکش", "fr": "son enfant", "id": "anaknya", "tr": "çocuğu", "ur": "اس کا بچہ"}}, {"arabic": "أُغْنِيَةً", "target": false, "translation": {"bs": "pjesmu", "en": "a song", "bn": "একটি গান", "fa": "آهنگی", "fr": "une chanson", "id": "sebuah lagu", "tr": "bir şarkı", "ur": "ایک گانا"}}]}]}