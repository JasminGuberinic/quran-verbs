{"ayat":[{"ref":"85:1","number":5910,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ","hits":[0,2]},{"ref":"85:2","number":5911,"text":"وَٱلْيَوْمِ ٱلْمَوْعُودِ","hits":[0]},{"ref":"85:3","number":5912,"text":"وَشَاهِدٍ وَمَشْهُودٍ","hits":[0]},{"ref":"85:4","number":5913,"text":"قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ","hits":[0,1]},{"ref":"85:5","number":5914,"text":"ٱلنَّارِ ذَاتِ ٱلْوَقُودِ","hits":[0]},{"ref":"85:6","number":5915,"text":"إِذْ هُمْ عَلَيْهَا قُعُودٌ","hits":[0,1,2]},{"ref":"85:7","number":5916,"text":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ","hits":[2,3,4]},{"ref":"85:8","number":5917,"text":"وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ","hits":[1,2,3,4,5,7,8]},{"ref":"85:9","number":5918,"text":"ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ","hits":[0,1,2,4,8,9]},{"ref":"85:10","number":5919,"text":"إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ","hits":[0,1,2,4,5,6,7,8,9,11]},{"ref":"85:11","number":5920,"text":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ","hits":[3,4,6,7,10,11,12,13]},{"ref":"85:12","number":5921,"text":"إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ","hits":[2,3]},{"ref":"85:13","number":5922,"text":"إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ","hits":[1,2,3]},{"ref":"85:14","number":5923,"text":"وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ","hits":[]},{"ref":"85:15","number":5924,"text":"ذُو ٱلْعَرْشِ ٱلْمَجِيدُ","hits":[1,2]},{"ref":"85:16","number":5925,"text":"فَعَّالٌ لِّمَا يُرِيدُ","hits":[2]},{"ref":"85:17","number":5926,"text":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ","hits":[0,1,2,3]},{"ref":"85:18","number":5927,"text":"فِرْعَوْنَ وَثَمُودَ","hits":[]},{"ref":"85:19","number":5928,"text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ","hits":[0,2,3]},{"ref":"85:20","number":5929,"text":"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ","hits":[]},{"ref":"85:21","number":5930,"text":"بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ","hits":[]},{"ref":"85:22","number":5931,"text":"فِى لَوْحٍ مَّحْفُوظٍۭ","hits":[1]}]}