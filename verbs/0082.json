n": "أَرَيْتُنَّ", "quran": false, "notUsed": false, "spoken": "audio/dc61ddfe8781e27435cd.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huwa", "arabic": "أَرَى", "plain": "أَرَى", "quran": false, "notUsed": false, "spoken": "audio/98c54bb82121e3c03dc4.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hiya", "arabic": "أَرَتْ", "plain": "أَرَتْ", "quran": false, "notUsed": false, "spoken": "audio/ea38c6341dcf58353b94.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huma", "arabic": "أَرَيَا", "plain": "أَرَيَا", "quran": false, "notUsed": false, "spoken": "audio/804accc9e904d70a97c2.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hum", "arabic": "أَرَوْا", "plain": "أَرَوْا", "quran": false, "notUsed": false, "spoken": "audio/83f8556145abadc1f44f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hunna", "arabic": "أَرَيْنَ", "plain": "أَرَيْنَ", "quran": false, "notUsed": false, "spoken": "audio/bcefe741bb0f478d07bb.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "ana", "arabic": "أُرِي", "plain": "أُرِي", "quran": false, "notUsed": false, "spoken": "audio/12ae68ac5acd5d1cd16a.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "nahnu", "arabic": "نُرِىٓ", "plain": "نُرِي", "quran": true, "notUsed": false, "spoken": "audio/9ee55c1c655f745ecab6.m4a", "recited": "audio/93a61af19e42950ddafb.m4a", "recitedText": "نُرِىٓ"}, {"tense": "present", "pronoun": "anta", "arabic": "تُرِي", "plain": "تُرِي", "quran": false, "notUsed": false, "spoken": "audio/bffab664efe37e1304d8.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "anti", "arabic": "تُرِينَ", "plain": "تُرِينَ", "quran": false, "notUsed": false, "spoken": "audio/bfa3373805bc05d81dd6.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تُرِيَانِ", "plain": "تُرِيَ