 "audio/e6e5d358f163b44f54c2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "عِظِي", "plain": "عِظِي", "quran": false, "notUsed": false, "spoken": "audio/4739ad80b72ae0709e65.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "عِظَا", "plain": "عِظَا", "quran": false, "notUsed": false, "spoken": "audio/92e9178094e3e2ac7c87.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "عِظُوا", "plain": "عِظُوا", "quran": false, "notUsed": false, "spoken": "audio/4bac1fef986aaa4c373e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "عِظْنَ", "plain": "عِظْنَ", "quran": false, "notUsed": false, "spoken": "audio/dbab19b3db69181ff964.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "24:17", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2808.mp3", "translation": {"en": {"text": "Allah admonisheth you that ye repeat not the like thereof ever, if ye are (in truth) believers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer inanmış insanlarsanız, Allah, bir daha buna benzer tutumu tekrarlamaktan sizi sakındırıp uyarıyor.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ تمہیں نصیحت فرماتا ہے کہ اب کبھی ایسا نہ کہنا اگر ایمان رکھتے ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah memperingatkan kamu agar (jangan) kembali memperbuat yang seperti itu selama-lamanya, jika kamu orang-orang yang beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَعِظُكُمُ", "hit": true, "audio": "audio/5be940082f4768dde9af.m4a", "gloss": {"bs": "vas opominje", "en": "admonishes you", "tr": "size öğüt verir", "fr": "vous exhorte", "id": "menasihatimu", "ur": "تمہیں نصیحت کرتا ہے", "bn": "তোমাদের উপদেশ দেন", "fa": "به شما پند می‌دهد"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَعُودُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لِمِثْلِهِۦٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَبَدًا", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّؤْمِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:136", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3068.mp3", "translation": {"en": {"text": "They said: It is all one to us whether thou preachest or art not of those who preach;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Dediler ki: \"Sen ha vaaz etmişsin, ha vaaz edenlerden olmamışsın, bizce birdir.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے ہمیں برابر ہے چاہے تم نصیحت کرو یا ناصحوں میں نہ ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka menjawab: \"Adalah sama saja bagi kami, apakah kamu memberi nasehat atau tidak memberi nasehat,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "سَوَآءٌ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَوَعَظْتَ", "hit": true, "audio": "audio/1ca40546b3625ed7d948.m4a", "gloss": {"bs": "da li si savjetovao", "en": "whether you admonished", "tr": "öğüt verdin mi", "fr": "que tu aies exhorté", "id": "baik kamu menasihati", "ur": "کیا تو نے نصیحت کی", "bn": "তুমি উপদেশ দিয়েছ কি না", "fa": "آیا پند دادی"}}, {"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَمْ", "hi