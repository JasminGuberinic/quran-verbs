{"rank": 155, "root": "سلم", "form": 4, "lemma": "أَسْلَمَ", "count": 22, "ayahCount": 19, "share": 0.11, "meaning": {"bs": "predati se, pokoriti se", "en": "to submit, to surrender", "tr": "teslim olmak, boyun eğmek", "fr": "se soumettre, s'en remettre", "id": "berserah diri, tunduk", "ur": "سر تسلیم خم کرنا، حوالے کرنا", "bn": "আত্মসমর্পণ করা, মাথা নত করা", "fa": "تسلیم شدن، گردن نهادن"}, "lemmaSpoken": "audio/b9870134859cfe8643ee.m4a", "animation": "<svg class=\"va va-aslama_4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes aslama_4-t{from{transform:rotate(0)}}@keyframes aslama_4-a{from{transform:rotate(0)}}.va-aslama_4 .tr{transform:rotate(75deg);animation:aslama_4-t 1.6s ease-in-out .3s both}.va-aslama_4 .la,.va-aslama_4 .ra{transform:rotate(-50deg);animation:aslama_4-a 1.6s ease-in-out .3s both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-aslama_4.off,.va-aslama_4.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-aslama_4,.va-aslama_4 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><path class=\"p\" d=\"M34 61h52\"/><g transform=\"translate(54 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَسْلَمَ", "plain": "أَسْلَمَ", "quran": true, "notUsed": false, "spoken": "audio/b9870134859cfe8643ee.m4a", "recited": "audio/cc7aef106dd085cf9607.m4a", "recitedText": "أَسْلَمَ"}, {"tense": "present", "pronou