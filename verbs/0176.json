{"rank": 176, "root": "نشأ", "form": 4, "lemma": "أَنشَأَ", "count": 20, "ayahCount": 20, "share": 0.1, "meaning": {"bs": "stvoriti, podići", "en": "to produce, to bring into being", "tr": "çıkarmak, var etmek", "fr": "produire, faire exister", "id": "menumbuhkan, mengadakan", "ur": "پیدا کرنا، اٹھانا", "bn": "সৃষ্টি করা, অস্তিত্বে আনা", "fa": "پدید آوردن، به وجود آوردن"}, "lemmaSpoken": "audio/6de9838860b876df47a5.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَنشَأَ", "plain": "أَنْشَأَ", "quran": true, "notUsed": false, "spoken": "audio/6de9838860b876df47a5.m4a", "recited": "audio/e3f1297c54f491fcf05d.m4a", "recitedText": "أَنشَأَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُنشِئُ", "plain": "يُنْشِئُ", "quran": true, "notUsed": false, "spoken": "audio/dce49cb2067df8441674.m4a", "recited": "audio/c6597e2a45b7c8691147.m4a", "recitedText": "يُنشِئُ"}], "nouns": {"verbal_noun": {"lemma": "إِنشاء", "count": 1, "spoken": "audio/967f9d61c007c9679d35.m4a"}, "participle": {"lemma": "مُنشِئ", "count": 1, "spoken": "audio/b3191680e9754f5d2ba4.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَنْشَأْتُ", "plain": "أَنْشَأْتُ", "quran": false, "notUsed": false, "spoken": "audio/9cab5e6505121f3cfbbf.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَنشَأْنَا", "plain": "أَنْشَأْنَا", "quran": true, "notUsed": false, "spoken": "audio/aa5b787975a7066470f0.m4a", "recited": "audio/b8356330a3cf5d53a7e2.m4a", "recitedText": "أَنشَأْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "أَنْشَأْتَ", "plain": "أَنْشَأْتَ", "quran": false, "notUsed": false, "spoken": "audio/72df7c3080cd923c7120.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "أَنْشَأْتِ", "plain": "أَنْشَأْتِ", "quran": false, "notUsed": false, "spoken": "audio/e6e4ca522b9160fcc61a.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "أَنْشَأ