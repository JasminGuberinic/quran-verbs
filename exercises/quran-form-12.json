[{"id":"akala-77-46-0","words":["verb:akala"],"options":[{"bs":"jedite!","en":"eat!"},{"bs":"jedete ga","en":"you (all) eat it"},{"bs":"jede","en":"he/it eats"},{"bs":"jedu","en":"they (two) eat"}],"ref":"77:46","answerWord":"كُلُوا۟","answerSound":"audio/2bd2931fa8a98c3b9f9e.m4a","quranTranslation":{"text":"Eat and take your ease (on earth) a little. Lo! ye are guilty.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["كُلُوا۟","وَتَمَتَّعُوا۟","قَلِيلًا","إِنَّكُم","مُّجْرِمُونَ"],"marked":[0],"facts":{"verb":"أَكَلَ"}},{"id":"akala-36-72-5","words":["verb:akala"],"options":[{"bs":"jedu","en":"they eat"},{"bs":"da jedete","en":"so that you (all) may eat"},{"bs":"jede","en":"he/it eats"},{"bs":"jede ga","en":"he/it eats him"}],"ref":"36:72","answerWord":"يَأْكُلُونَ","answerSound":"audio/090128040ce2fad4c0a9.m4a","quranTranslation":{"text":"And have subdued them unto them, so that some of them they have for riding, some for food?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["وَذَلَّلْنَٰهَا","لَهُمْ","فَمِنْهَا","رَكُوبُهُمْ","وَمِنْهَا","يَأْكُلُونَ"],"marked":[5],"facts":{"verb":"أَكَلَ"}},{"id":"akala-2-188-1","words":["verb:akala"],"options":[{"bs":"jedete","en":"you (all) eat"},{"bs":"pa jedi!","en":"so eat!"},{"bs":"jeo je","en":"he/it ate"},{"bs":"jedu","en":"they (two) eat"}],"ref":"2:188","answerWord":"تَأْكُلُوٓا۟","answerSound":"audio/b4e9da6b67aaf9dad101.m4a","quranTranslation":{"text":"And eat not up your property among yourselves in vanity, nor seek by it to gain the hearing of the judges that ye may knowingly devour a portion of the property of others wrongfully.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["وَلَا","تَأْكُلُوٓا۟","أَمْوَٰلَكُم","بَيْنَكُم","بِٱلْبَٰطِلِ","وَتُدْلُوا۟","بِهَآ","إِلَى","ٱلْحُكَّامِ","لِتَأْكُلُوا۟","فَرِيقًا","مِّنْ","أَمْوَٰلِ","ٱلنَّاسِ","بِٱلْإِثْمِ","وَأَنتُمْ","تَعْلَمُونَ"],"marked":[1],"facts":{"verb":"أَكَلَ"}},{"id":"akala-2-188-9","words":["verb:akala"],"options":[{"bs":"da jedete","en":"so that you (all) may eat"},{"bs":"jeo je","en":"he/it ate"},{"bs":"pa neka jede","en":"so let him eat"},{"bs":"pa ga jedite!","en":"so (you all) eat it!"}],"ref":"2:188","answerWord":"لِتَأْكُلُوا۟","answerSound":"audio/50551dd4f9f3ab1e919e.m4a","quranTranslation":{"text":"And eat not up your property among yourselves in vanity, nor seek by it to gain the hearing of the judges that ye may knowingly devour a portion of the property of others wrongfully.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["وَلَا","تَأْكُلُوٓا۟","أَمْوَٰلَكُم","بَيْنَكُم","بِٱلْبَٰطِلِ","وَتُدْلُوا۟","بِهَآ","إِلَى","ٱلْحُكَّامِ","لِتَأْكُلُوا۟","فَرِيقًا","مِّنْ","أَمْوَٰلِ","ٱلنَّاسِ","بِٱلْإِثْمِ","وَأَنتُمْ","تَعْلَمُونَ"],"marked":[9],"facts":{"verb":"أَكَلَ"}},{"id":"akala-9-34-8","words":["verb:akala"],"options":[{"bs":"zaista jedu","en":"surely they eat"},{"bs":"pa jedi!","en":"so eat!"},{"bs":"pa ga jedite!","en":"so (you all) eat it!"},{"bs":"jedu","en":"they eat"}],"ref":"9:34","answerWord":"لَيَأْكُلُونَ","answerSound":"audio/266ff3dd628a5474c131.m4a","quranTranslation":{"text":"O ye who believe! Lo! many of the (Jewish) rabbis and the (Christian) monks devour the wealth of mankind wantonly and debar (men) from the way of Allah. They who hoard up gold and silver and spend it not in the way of Allah, unto them give tidings (O Muhammad) of a painful doom,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓا۟","إِنَّ","كَثِيرًا","مِّنَ","ٱلْأَحْبَارِ","وَٱلرُّهْبَانِ","لَيَأْكُلُونَ","أَمْوَٰلَ","ٱلنَّاسِ","بِٱلْبَٰطِلِ","وَيَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","وَٱلَّذِينَ","يَكْنِزُونَ","ٱلذَّهَبَ","وَٱلْفِضَّةَ","وَلَا","يُنفِقُونَهَا","فِى","سَبِيلِ","ٱللَّهِ","فَبَشِّرْهُم","بِعَذَابٍ","أَلِيمٍ"],"marked":[8],"facts":{"verb":"أَكَلَ"}},{"id":"akala-12-43-7","words":["verb:akala"],"options":[{"bs":"jede ih","en":"he/it eats them"},{"bs":"jedemo","en":"we eat"},{"bs":"i jedu","en":"and they eat"},{"bs":"i jedite!","en":"and (you two) eat!"}],"ref":"12:43","answerWord":"يَأْكُلُهُنَّ","answerSound":"audio/3a72598ffbccbb59465e.m4a","quranTranslation":{"text":"And the king said: Lo! I saw in a dream seven fat kine which seven lean were eating, and seven green ears of corn and other (seven) dry. O notables! Expound for me my vision, if ye can interpret dreams.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["وَقَالَ","ٱلْمَلِكُ","إِنِّىٓ","أَرَىٰ","سَبْعَ","بَقَرَٰتٍ","سِمَانٍ","يَأْكُلُهُنَّ","سَبْعٌ","عِجَافٌ","وَسَبْعَ","سُنۢبُلَٰتٍ","خُضْرٍ","وَأُخَرَ","يَابِسَٰتٍ","يَٰٓأَيُّهَا","ٱلْمَلَأُ","أَفْتُونِى","فِى","رُءْيَٰىَ","إِن","كُنتُمْ","لِلرُّءْيَا","تَعْبُرُونَ"],"marked":[7],"facts":{"verb":"أَكَلَ"}},{"id":"akala-2-35-6","words":["verb:akala"],"options":[{"bs":"i jedite!","en":"and (you two) eat!"},{"bs":"(ako) ga vuk pojede","en":"(if) the wolf ate him"},{"bs":"jedu","en":"they eat"},{"bs":"i jedete","en":"and you (all) eat"}],"ref":"2:35","answerWord":"وَكُلَا","answerSound":"audio/b2270bfe2d9ad29c879e.m4a","quranTranslation":{"text":"And We said: O Adam! Dwell thou and thy wife in the Garden, and eat ye freely (of the fruits) thereof where ye will; but come not nigh this tree lest ye become wrong-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["وَقُلْنَا","يَٰٓـَٔادَمُ","ٱسْكُنْ","أَنتَ","وَزَوْجُكَ","ٱلْجَنَّةَ","وَكُلَا","مِنْهَا","رَغَدًا","حَيْثُ","شِئْتُمَا","وَلَا","تَقْرَبَا","هَٰذِهِ","ٱلشَّجَرَةَ","فَتَكُونَا","مِنَ","ٱلظَّٰلِمِينَ"],"marked":[6],"facts":{"verb":"أَكَلَ"}},{"id":"akala-4-4-11","words":["verb:akala"],"options":[{"bs":"pa ga jedite!","en":"so (you all) eat it!"},{"bs":"jede ga","en":"he/it eats him"},{"bs":"jede","en":"he/it eats"},{"bs":"jedi!","en":"eat!"}],"ref":"4:4","answerWord":"فَكُلُوهُ","answerSound":"audio/3d190a979195e2255bc3.m4a","quranTranslation":{"text":"And give unto the women (whom ye marry) free gift of their marriage portions; but if they of their own accord remit unto you a part thereof, then ye are welcome to absorb it (in your wealth).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["وَءَاتُوا۟","ٱلنِّسَآءَ","صَدُقَٰتِهِنَّ","نِحْلَةً","فَإِن","طِبْنَ","لَكُمْ","عَن","شَىْءٍ","مِّنْهُ","نَفْسًا","فَكُلُوهُ","هَنِيٓـًٔا","مَّرِيٓـًٔا"],"marked":[11],"facts":{"verb":"أَكَلَ"}},{"id":"akala-5-113-3","words":["verb:akala"],"options":[{"bs":"jedemo","en":"we eat"},{"bs":"jedu","en":"they eat"},{"bs":"pa neka jede","en":"so let him eat"},{"bs":"i jedite!","en":"and (you all) eat!"}],"ref":"5:113","answerWord":"نَّأْكُلَ","answerSound":"audio/e6526944ced50f8b94d0.m4a","quranTranslation":{"text":"(They said:) We wish to eat thereof, that we may satisfy our hearts and know that thou hast spoken truth to us, and that thereof we may be witnesses.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["قَالُوا۟","نُرِيدُ","أَن","نَّأْكُلَ","مِنْهَا","وَتَطْمَئِنَّ","قُلُوبُنَا","وَنَعْلَمَ","أَن","قَدْ","صَدَقْتَنَا","وَنَكُونَ","عَلَيْهَا","مِنَ","ٱلشَّٰهِدِينَ"],"marked":[3],"facts":{"verb":"أَكَلَ"}},{"id":"akala-12-13-8","words":["verb:akala"],"options":[{"bs":"jede ga","en":"he/it eats him"},{"bs":"jedete ga","en":"you (all) eat it"},{"bs":"da jedete","en":"so that you (all) may eat"},{"bs":"pa ga jedite!","en":"so (you all) eat it!"}],"ref":"12:13","answerWord":"يَأْكُلَهُ","answerSound":"audio/48d032f8c58ce44d97ff.m4a","quranTranslation":{"text":"He said: Lo! in truth it saddens me that ye should take him with you, and I fear less the wolf devour him while ye are heedless of him.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["قَالَ","إِنِّى","لَيَحْزُنُنِىٓ","أَن","تَذْهَبُوا۟","بِهِۦ","وَأَخَافُ","أَن","يَأْكُلَهُ","ٱلذِّئْبُ","وَأَنتُمْ","عَنْهُ","غَٰفِلُونَ"],"marked":[8],"facts":{"verb":"أَكَلَ"}},{"id":"akala-12-14-2","words":["verb:akala"],"options":[{"bs":"(ako) ga vuk pojede","en":"(if) the wolf ate him"},{"bs":"jede","en":"he/it eats"},{"bs":"jedete","en":"you (all) eat"},{"bs":"da jedu","en":"so that they may eat"}],"ref":"12:14","answerWord":"أَكَلَهُ","answerSound":"audio/420a3a317d78ec6452e0.m4a","quranTranslation":{"text":"They said: If the wolf should devour him when we are (so strong) a band, then surely we should have already perished.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["قَالُوا۟","لَئِنْ","أَكَلَهُ","ٱلذِّئْبُ","وَنَحْنُ","عُصْبَةٌ","إِنَّآ","إِذًا","لَّخَٰسِرُونَ"],"marked":[2],"facts":{"verb":"أَكَلَ"}},{"id":"akala-12-17-9","words":["verb:akala"],"options":[{"bs":"pa ga je jeo","en":"so he/it ate him"},{"bs":"jedemo","en":"we eat"},{"bs":"jedete ga","en":"you (all) eat it"},{"bs":"jede","en":"he/it eats"}],"ref":"12:17","answerWord":"فَأَكَلَهُ","answerSound":"audio/28471088beedceb7a1cb.m4a","quranTranslation":{"text":"Saying: O our father! We went racing one with another, and left Joseph by our things, and the wolf devoured him, and thou believest not our saying even when we speak the truth.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["قَالُوا۟","يَٰٓأَبَانَآ","إِنَّا","ذَهَبْنَا","نَسْتَبِقُ","وَتَرَكْنَا","يُوسُفَ","عِندَ","مَتَٰعِنَا","فَأَكَلَهُ","ٱلذِّئْبُ","وَمَآ","أَنتَ","بِمُؤْمِنٍ","لَّنَا","وَلَوْ","كُنَّا","صَٰدِقِينَ"],"marked":[9],"facts":{"verb":"أَكَلَ"}},{"id":"akala-12-48-7","words":["verb:akala"],"options":[{"bs":"jedu","en":"they eat"},{"bs":"(ako) ga vuk pojede","en":"(if) the wolf ate him"},{"bs":"da jedu","en":"so that they may eat"},{"bs":"jeo je","en":"he/it ate"}],"ref":"12:48","answerWord":"يَأْكُلْنَ","answerSound":"audio/b1080115e299550b70be.m4a","quranTranslation":{"text":"Then after that will come seven hard years which will devour all that ye have prepared for them, save a little of that which ye have stored.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["ثُمَّ","يَأْتِى","مِنۢ","بَعْدِ","ذَٰلِكَ","سَبْعٌ","شِدَادٌ","يَأْكُلْنَ","مَا","قَدَّمْتُمْ","لَهُنَّ","إِلَّا","قَلِيلًا","مِّمَّا","تُحْصِنُونَ"],"marked":[7],"facts":{"verb":"أَكَلَ"}},{"id":"akala-15-3-1","words":["verb:akala"],"options":[{"bs":"jedu","en":"they eat"},{"bs":"jedete","en":"you (all) eat"},{"bs":"i jedite!","en":"and (you all) eat!"},{"bs":"jede","en":"he/it eats"}],"ref":"15:3","answerWord":"يَأْكُلُوا۟","answerSound":"audio/67e33d5083ed6625f5fd.m4a","quranTranslation":{"text":"Let them eat and enjoy life, and let (false) hope beguile them. They will come to know!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["ذَرْهُمْ","يَأْكُلُوا۟","وَيَتَمَتَّعُوا۟","وَيُلْهِهِمُ","ٱلْأَمَلُ","فَسَوْفَ","يَعْلَمُونَ"],"marked":[1],"facts":{"verb":"أَكَلَ"}},{"id":"akala-16-69-1","words":["verb:akala"],"options":[{"bs":"jedi!","en":"eat!"},{"bs":"jedete ga","en":"you (all) eat it"},{"bs":"pa neka jede","en":"so let him eat"},{"bs":"zaista jedu","en":"surely they eat"}],"ref":"16:69","answerWord":"كُلِى","answerSound":"audio/d9f85a8f14edb8863d38.m4a","quranTranslation":{"text":"Then eat of all fruits, and follow the ways of thy Lord, made smooth (for thee). There cometh forth from their bellies a drink divers of hues, wherein is healing for mankind. Lo! herein is indeed a portent for people who reflect.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["ثُمَّ","كُلِى","مِن","كُلِّ","ٱلثَّمَرَٰتِ","فَٱسْلُكِى","سُبُلَ","رَبِّكِ","ذُلُلًا","يَخْرُجُ","مِنۢ","بُطُونِهَا","شَرَابٌ","مُّخْتَلِفٌ","أَلْوَٰنُهُۥ","فِيهِ","شِفَآءٌ","لِّلنَّاسِ","إِنَّ","فِى","ذَٰلِكَ","لَءَايَةً","لِّقَوْمٍ","يَتَفَكَّرُونَ"],"marked":[1],"facts":{"verb":"أَكَلَ"}},{"id":"akala-19-26-0","words":["verb:akala"],"options":[{"bs":"pa jedi!","en":"so eat!"},{"bs":"jedu","en":"they eat"},{"bs":"jedemo","en":"we eat"},{"bs":"jede ga","en":"he/it eats him"}],"ref":"19:26","answerWord":"فَكُلِى","answerSound":"audio/4f4135ef24939182e595.m4a","quranTranslation":{"text":"So eat and drink and be consoled. And if thou meetest any mortal, say: Lo! I have vowed a fast unto the Beneficent, and may not speak this day to any mortal.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["فَكُلِى","وَٱشْرَبِى","وَقَرِّى","عَيْنًا","فَإِمَّا","تَرَيِنَّ","مِنَ","ٱلْبَشَرِ","أَحَدًا","فَقُولِىٓ","إِنِّى","نَذَرْتُ","لِلرَّحْمَٰنِ","صَوْمًا","فَلَنْ","أُكَلِّمَ","ٱلْيَوْمَ","إِنسِيًّا"],"marked":[0],"facts":{"verb":"أَكَلَ"}},{"id":"akala-20-121-0","words":["verb:akala"],"options":[{"bs":"pa su jeli","en":"so they (two) ate"},{"bs":"jedu","en":"they (two) eat"},{"bs":"jede","en":"he/it eats"},{"bs":"jede ga","en":"he/it eats him"}],"ref":"20:121","answerWord":"فَأَكَلَا","answerSound":"audio/12c40859d6332b14f7f0.m4a","quranTranslation":{"text":"Then they twain ate thereof, so that their shame became apparent unto them, and they began to hide by heaping on themselves some of the leaves of the Garden. And Adam disobeyed his Lord, so went astray.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["فَأَكَلَا","مِنْهَا","فَبَدَتْ","لَهُمَا","سَوْءَٰتُهُمَا","وَطَفِقَا","يَخْصِفَانِ","عَلَيْهِمَا","مِن","وَرَقِ","ٱلْجَنَّةِ","وَعَصَىٰٓ","ءَادَمُ","رَبَّهُۥ","فَغَوَىٰ"],"marked":[0],"facts":{"verb":"أَكَلَ"}},{"id":"akala-36-35-0","words":["verb:akala"],"options":[{"bs":"da jedu","en":"so that they may eat"},{"bs":"pa ga jedite!","en":"so (you all) eat it!"},{"bs":"pa jedi!","en":"so eat!"},{"bs":"jedete","en":"you (all) eat"}],"ref":"36:35","answerWord":"لِيَأْكُلُوا۟","answerSound":"audio/3db74d33d9fc8f1f1674.m4a","quranTranslation":{"text":"That they may eat of the fruit thereof, and their hands made it not. Will they not, then, give thanks?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["لِيَأْكُلُوا۟","مِن","ثَمَرِهِۦ","وَمَا","عَمِلَتْهُ","أَيْدِيهِمْ","أَفَلَا","يَشْكُرُونَ"],"marked":[0],"facts":{"verb":"أَكَلَ"}},{"id":"akala-47-12-15","words":["verb:akala"],"options":[{"bs":"i jedu","en":"and they eat"},{"bs":"jedi!","en":"eat!"},{"bs":"(niko) je ne jede","en":"(none) eats it"},{"bs":"i jedete","en":"and you (all) eat"}],"ref":"47:12","answerWord":"وَيَأْكُلُونَ","answerSound":"audio/ea6a74ede355d1da2a29.m4a","quranTranslation":{"text":"Lo! Allah will cause those who believe and do good works to enter Gardens underneath which rivers flow; while those who disbelieve take their comfort in this life and eat even as the cattle eat, and the Fire is their habitation.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["إِنَّ","ٱللَّهَ","يُدْخِلُ","ٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","جَنَّٰتٍ","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَٰرُ","وَٱلَّذِينَ","كَفَرُوا۟","يَتَمَتَّعُونَ","وَيَأْكُلُونَ","كَمَا","تَأْكُلُ","ٱلْأَنْعَٰمُ","وَٱلنَّارُ","مَثْوًى","لَّهُمْ"],"marked":[15],"facts":{"verb":"أَكَلَ"}},{"id":"akala-69-37-1","words":["verb:akala"],"options":[{"bs":"(niko) je ne jede","en":"(none) eats it"},{"bs":"jedu","en":"they (two) eat"},{"bs":"jedi!","en":"eat!"},{"bs":"i jedete","en":"and you (all) eat"}],"ref":"69:37","answerWord":"يَأْكُلُهُۥٓ","answerSound":"audio/f5cee613519ef2170d15.m4a","quranTranslation":{"text":"Which none but sinners eat.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"jesti","en":"to eat"},"passage":["لَّا","يَأْكُلُهُۥٓ","إِلَّا","ٱلْخَٰطِـُٔونَ"],"marked":[1],"facts":{"verb":"أَكَلَ"}},{"id":"akhfa-5-15-10","words":["verb:akhfa"],"options":[{"bs":"skrivate","en":"you (all) hide"},{"bs":"skrivaju","en":"conceal"},{"bs":"skrivam ga","en":"I hide it"},{"bs":"skrivate je","en":"you (all) hide it"}],"ref":"5:15","answerWord":"تُخْفُونَ","answerSound":"audio/cf4150f3ac99276d01cd.m4a","quranTranslation":{"text":"O People of the Scripture! Now hath Our messenger come unto you, expounding unto you much of that which ye used to hide in the Scripture, and forgiving much. now hath come unto you light from Allah and plain Scripture,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakriti, prikriti","en":"to hide, to conceal"},"passage":["يَٰٓأَهْلَ","ٱلْكِتَٰبِ","قَدْ","جَآءَكُمْ","رَسُولُنَا","يُبَيِّنُ","لَكُمْ","كَثِيرًا","مِّمَّا","كُنتُمْ","تُخْفُونَ","مِنَ","ٱلْكِتَٰبِ","وَيَعْفُوا۟","عَن","كَثِيرٍ","قَدْ","جَآءَكُم","مِّنَ","ٱللَّهِ","نُورٌ","وَكِتَٰبٌ","مُّبِينٌ"],"marked":[10],"facts":{"verb":"أَخْفَى"}},{"id":"akhfa-2-271-6","words":["verb:akhfa"],"options":[{"bs":"skrivate je","en":"you (all) hide it"},{"bs":"sakriven je","en":"he/it was hidden"},{"bs":"skrivamo","en":"we hide"},{"bs":"skrivate","en":"you (all) hide"}],"ref":"2:271","answerWord":"تُخْفُوهَا","answerSound":"audio/74ac553b03057b2a6bc2.m4a","quranTranslation":{"text":"If ye publish your almsgiving, it is well, but if ye hide it and give it to the poor, it will be better for you, and will atone for some of your ill-deeds. Allah is Informed of what ye do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakriti, prikriti","en":"to hide, to conceal"},"passage":["إِن","تُبْدُوا۟","ٱلصَّدَقَٰتِ","فَنِعِمَّا","هِىَ","وَإِن","تُخْفُوهَا","وَتُؤْتُوهَا","ٱلْفُقَرَآءَ","فَهُوَ","خَيْرٌ","لَّكُمْ","وَيُكَفِّرُ","عَنكُم","مِّن","سَيِّـَٔاتِكُمْ","وَٱللَّهُ","بِمَا","تَعْمَلُونَ","خَبِيرٌ"],"marked":[6],"facts":{"verb":"أَخْفَى"}},{"id":"akhfa-3-29-2","words":["verb:akhfa"],"options":[{"bs":"skrivate","en":"you (all) hide"},{"bs":"skrivate je","en":"you (all) hide it"},{"bs":"sakriven je","en":"he/it was hidden"},{"bs":"skrivamo","en":"we hide"}],"ref":"3:29","answerWord":"تُخْفُوا۟","answerSound":"audio/96d9fdb82e97665820f2.m4a","quranTranslation":{"text":"Say, (O Muhammad): Whether ye hide that which is in your breasts or reveal it, Allah knoweth it. He knoweth that which is in the heavens and that which is in the earth, and Allah is Able to do all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakriti, prikriti","en":"to hide, to conceal"},"passage":["قُلْ","إِن","تُخْفُوا۟","مَا","فِى","صُدُورِكُمْ","أَوْ","تُبْدُوهُ","يَعْلَمْهُ","ٱللَّهُ","وَيَعْلَمُ","مَا","فِى","ٱلسَّمَٰوَٰتِ","وَمَا","فِى","ٱلْأَرْضِ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَىْءٍ","قَدِيرٌ"],"marked":[2],"facts":{"verb":"أَخْفَى"}},{"id":"akhfa-14-38-4","words":["verb:akhfa"],"options":[{"bs":"skrivamo","en":"we hide"},{"bs":"sakrili ste","en":"you (all) hid"},{"bs":"skrivaju","en":"they hide"},{"bs":"skrivate","en":"you (all) hide"}],"ref":"14:38","answerWord":"نُخْفِى","answerSound":"audio/5f2fb1cdb174eea7376f.m4a","quranTranslation":{"text":"Our Lord! Lo! Thou knowest that which we hide and that which we proclaim. Nothing in the earth or in the heaven is hidden from Allah.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakriti, prikriti","en":"to hide, to conceal"},"passage":["رَبَّنَآ","إِنَّكَ","تَعْلَمُ","مَا","نُخْفِى","وَمَا","نُعْلِنُ","وَمَا","يَخْفَىٰ","عَلَى","ٱللَّهِ","مِن","شَىْءٍ","فِى","ٱلْأَرْضِ","وَلَا","فِى","ٱلسَّمَآءِ"],"marked":[4],"facts":{"verb":"أَخْفَى"}},{"id":"akhfa-32-17-4","words":["verb:akhfa"],"options":[{"bs":"sakriven je","en":"he/it was hidden"},{"bs":"skrivaju","en":"conceal"},{"bs":"skrivate","en":"you (all) hide"},{"bs":"skrivate je","en":"you (all) hide it"}],"ref":"32:17","answerWord":"أُخْفِىَ","answerSound":"audio/fd99ea393a0de7b4809b.m4a","quranTranslation":{"text":"No soul knoweth what is kept hid for them of joy, as a reward for what they used to do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakriti, prikriti","en":"to hide, to conceal"},"passage":["فَلَا","تَعْلَمُ","نَفْسٌ","مَّآ","أُخْفِىَ","لَهُم","مِّن","قُرَّةِ","أَعْيُنٍ","جَزَآءًۢ","بِمَا","كَانُوا۟","يَعْمَلُونَ"],"marked":[4],"facts":{"verb":"أَخْفَى"}}]