[{"id":"balagha-12-22-1","words":["verb:balagha"],"options":[{"bs":"dostigao je","en":"he/it reached"},{"bs":"dostigao si","en":"you reached"},{"bs":"(da) dosegnem","en":"I may reach"},{"bs":"dostigli su","en":"they (two) reached"}],"ref":"12:22","answerWord":"بَلَغَ","answerSound":"audio/36c9f84c3f7a52205071.m4a","quranTranslation":{"text":"And And when he reached his prime We gave him wisdom and knowledge. Thus We reward the good.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["وَلَمَّا","بَلَغَ","أَشُدَّهُۥٓ","ءَاتَيْنَٰهُ","حُكْمًا","وَعِلْمًا","وَكَذَٰلِكَ","نَجْزِى","ٱلْمُحْسِنِينَ"],"marked":[1],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-2-234-11","words":["verb:balagha"],"options":[{"bs":"dostigle su","en":"they reached"},{"bs":"dostigao me je","en":"he/it reached me"},{"bs":"da dostigne","en":"so that he/it may reach"},{"bs":"i dostigli smo","en":"and we reached"}],"ref":"2:234","answerWord":"بَلَغْنَ","answerSound":"audio/a2c464b7c8b1b1dadcae.m4a","quranTranslation":{"text":"Such of you as die and leave behind them wives, they (the wives) shall wait, keeping themselves apart, four months and ten days. And when they reach the term (prescribed for them) then there is no sin for you in aught that they may do with themselves in decency. Allah is informed of what ye do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["وَٱلَّذِينَ","يُتَوَفَّوْنَ","مِنكُمْ","وَيَذَرُونَ","أَزْوَٰجًا","يَتَرَبَّصْنَ","بِأَنفُسِهِنَّ","أَرْبَعَةَ","أَشْهُرٍ","وَعَشْرًا","فَإِذَا","بَلَغْنَ","أَجَلَهُنَّ","فَلَا","جُنَاحَ","عَلَيْكُمْ","فِيمَا","فَعَلْنَ","فِىٓ","أَنفُسِهِنَّ","بِٱلْمَعْرُوفِ","وَٱللَّهُ","بِمَا","تَعْمَلُونَ","خَبِيرٌ"],"marked":[11],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-56-83-2","words":["verb:balagha"],"options":[{"bs":"(kad) dopre","en":"(when it) reaches"},{"bs":"dostigli su","en":"they (two) reached"},{"bs":"dostižu","en":"they reach"},{"bs":"(da) dosegnem","en":"I may reach"}],"ref":"56:83","answerWord":"بَلَغَتِ","answerSound":"audio/f852dfce493ba140a9e6.m4a","quranTranslation":{"text":"Why, then, when (the soul) cometh up to the throat (of the dying)","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["فَلَوْلَآ","إِذَا","بَلَغَتِ","ٱلْحُلْقُومَ"],"marked":[2],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-3-40-7","words":["verb:balagha"],"options":[{"bs":"dostigao me je","en":"he/it reached me"},{"bs":"da dostigne","en":"so that he/it may reach"},{"bs":"i dostigao je","en":"and he/it reached"},{"bs":"dostižem","en":"I reach"}],"ref":"3:40","answerWord":"بَلَغَنِىَ","answerSound":"audio/a71c477725d1d738d4f7.m4a","quranTranslation":{"text":"He said: My Lord! How can I have a son when age hath overtaken me already and my wife is barren? (The angel) answered: So (it will be). Allah doeth what He will.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["قَالَ","رَبِّ","أَنَّىٰ","يَكُونُ","لِى","غُلَٰمٌ","وَقَدْ","بَلَغَنِىَ","ٱلْكِبَرُ","وَٱمْرَأَتِى","عَاقِرٌ","قَالَ","كَذَٰلِكَ","ٱللَّهُ","يَفْعَلُ","مَا","يَشَآءُ"],"marked":[7],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-13-14-16","words":["verb:balagha"],"options":[{"bs":"da dostigne","en":"so that he/it may reach"},{"bs":"dostigao sam","en":"I reached"},{"bs":"da dostignete","en":"so that you (all) may reach"},{"bs":"dostigli su","en":"they (two) reached"}],"ref":"13:14","answerWord":"لِيَبْلُغَ","answerSound":"audio/49e66c48144984cdc22a.m4a","quranTranslation":{"text":"Unto Him is the real prayer. Those unto whom they pray beside Allah respond to them not at all, save as (is the response to) one who stretcheth forth his hands toward water (asking) that it may come unto his mouth, and it will never reach it. The prayer of disbelievers goeth (far) astray.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["لَهُۥ","دَعْوَةُ","ٱلْحَقِّ","وَٱلَّذِينَ","يَدْعُونَ","مِن","دُونِهِۦ","لَا","يَسْتَجِيبُونَ","لَهُم","بِشَىْءٍ","إِلَّا","كَبَٰسِطِ","كَفَّيْهِ","إِلَى","ٱلْمَآءِ","لِيَبْلُغَ","فَاهُ","وَمَا","هُوَ","بِبَٰلِغِهِۦ","وَمَا","دُعَآءُ","ٱلْكَٰفِرِينَ","إِلَّا","فِى","ضَلَٰلٍ"],"marked":[16],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-18-60-7","words":["verb:balagha"],"options":[{"bs":"dostižem","en":"I reach"},{"bs":"i dostigla je","en":"and she/it reached"},{"bs":"dostigao sam","en":"I reached"},{"bs":"i da dostignete","en":"and so that you (all) may reach"}],"ref":"18:60","answerWord":"أَبْلُغَ","answerSound":"audio/8393200d487f03ff1fcb.m4a","quranTranslation":{"text":"And when Moses said unto his servant: I will not give up until I reach the point where the two rivers meet, though I march on for ages.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["وَإِذْ","قَالَ","مُوسَىٰ","لِفَتَىٰهُ","لَآ","أَبْرَحُ","حَتَّىٰٓ","أَبْلُغَ","مَجْمَعَ","ٱلْبَحْرَيْنِ","أَوْ","أَمْضِىَ","حُقُبًا"],"marked":[7],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-18-61-1","words":["verb:balagha"],"options":[{"bs":"dostigli su","en":"they (two) reached"},{"bs":"i dostigao je","en":"and he/it reached"},{"bs":"dostižu","en":"they reach"},{"bs":"da dostigne","en":"so that he/it may reach"}],"ref":"18:61","answerWord":"بَلَغَا","answerSound":"audio/9bfd3b4d964e96136076.m4a","quranTranslation":{"text":"And when they reached the point where the two met, they forgot their fish, and it took its way into the waters, being free.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["فَلَمَّا","بَلَغَا","مَجْمَعَ","بَيْنِهِمَا","نَسِيَا","حُوتَهُمَا","فَٱتَّخَذَ","سَبِيلَهُۥ","فِى","ٱلْبَحْرِ","سَرَبًا"],"marked":[1],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-18-76-9","words":["verb:balagha"],"options":[{"bs":"dostigao si","en":"you reached"},{"bs":"i dostigli smo","en":"and we reached"},{"bs":"(da) dosegnem","en":"I may reach"},{"bs":"da dostigne","en":"so that he/it may reach"}],"ref":"18:76","answerWord":"بَلَغْتَ","answerSound":"audio/66f5333b9f1db53859b1.m4a","quranTranslation":{"text":"(Moses) said: If I ask thee after this concerning aught, keep not company with me. Thou hast received an excuse from me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["قَالَ","إِن","سَأَلْتُكَ","عَن","شَىْءٍۭ","بَعْدَهَا","فَلَا","تُصَٰحِبْنِى","قَدْ","بَلَغْتَ","مِن","لَّدُنِّى","عُذْرًا"],"marked":[9],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-19-8-10","words":["verb:balagha"],"options":[{"bs":"dostigao sam","en":"I reached"},{"bs":"i da dostignete","en":"and so that you (all) may reach"},{"bs":"i dostigao je","en":"and he/it reached"},{"bs":"(da) dosegnem","en":"I may reach"}],"ref":"19:8","answerWord":"بَلَغْتُ","answerSound":"audio/989a10cf1a5ce6d75010.m4a","quranTranslation":{"text":"He said: My Lord! How can I have a son when my wife is barren and I have reached infirm old age?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["قَالَ","رَبِّ","أَنَّىٰ","يَكُونُ","لِى","غُلَٰمٌ","وَكَانَتِ","ٱمْرَأَتِى","عَاقِرًا","وَقَدْ","بَلَغْتُ","مِنَ","ٱلْكِبَرِ","عِتِيًّا"],"marked":[10],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-33-10-10","words":["verb:balagha"],"options":[{"bs":"i dostigla je","en":"and she/it reached"},{"bs":"dostignu","en":"they (two) reach"},{"bs":"(da) dosegnem","en":"I may reach"},{"bs":"da dostigne","en":"so that he/it may reach"}],"ref":"33:10","answerWord":"وَبَلَغَتِ","answerSound":"audio/b82a1ddcb0f64cbaa7f3.m4a","quranTranslation":{"text":"When they came upon you from above you and from below you, and when eyes grew wild and hearts reached to the throats, and ye were imagining vain thoughts concerning Allah.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["إِذْ","جَآءُوكُم","مِّن","فَوْقِكُمْ","وَمِنْ","أَسْفَلَ","مِنكُمْ","وَإِذْ","زَاغَتِ","ٱلْأَبْصَٰرُ","وَبَلَغَتِ","ٱلْقُلُوبُ","ٱلْحَنَاجِرَ","وَتَظُنُّونَ","بِٱللَّهِ","ٱلظُّنُونَا۠"],"marked":[10],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-40-36-7","words":["verb:balagha"],"options":[{"bs":"(da) dosegnem","en":"I may reach"},{"bs":"i da dostignete","en":"and so that you (all) may reach"},{"bs":"dostiže","en":"he/it reaches"},{"bs":"dostigao me je","en":"he/it reached me"}],"ref":"40:36","answerWord":"أَبْلُغُ","answerSound":"audio/9c7ef3ffa93596f0c95b.m4a","quranTranslation":{"text":"And Pharaoh said: O Haman! Build for me a tower that haply I may reach the roads,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["وَقَالَ","فِرْعَوْنُ","يَٰهَٰمَٰنُ","ٱبْنِ","لِى","صَرْحًا","لَّعَلِّىٓ","أَبْلُغُ","ٱلْأَسْبَٰبَ"],"marked":[7],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-40-67-25","words":["verb:balagha"],"options":[{"bs":"i da dostignete","en":"and so that you (all) may reach"},{"bs":"dostigao si","en":"you reached"},{"bs":"dostižu","en":"they reach"},{"bs":"(da) dosegnem","en":"I may reach"}],"ref":"40:67","answerWord":"وَلِتَبْلُغُوٓا۟","answerSound":"audio/789cece56413cefc5ddf.m4a","quranTranslation":{"text":"He it is Who created you from dust, then from a drop (of seed) then from a clot, then bringeth you forth as a child, then (ordaineth) that ye attain full strength and afterward that ye become old men - though some among you die before - and that ye reach an appointed term, that haply ye may understand.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["هُوَ","ٱلَّذِى","خَلَقَكُم","مِّن","تُرَابٍ","ثُمَّ","مِن","نُّطْفَةٍ","ثُمَّ","مِنْ","عَلَقَةٍ","ثُمَّ","يُخْرِجُكُمْ","طِفْلًا","ثُمَّ","لِتَبْلُغُوٓا۟","أَشُدَّكُمْ","ثُمَّ","لِتَكُونُوا۟","شُيُوخًا","وَمِنكُم","مَّن","يُتَوَفَّىٰ","مِن","قَبْلُ","وَلِتَبْلُغُوٓا۟","أَجَلًا","مُّسَمًّى","وَلَعَلَّكُمْ","تَعْقِلُونَ"],"marked":[25],"facts":{"verb":"بَلَغَ"}},{"id":"balagha-40-80-3","words":["verb:balagha"],"options":[{"bs":"i da dostignete","en":"and so that you (all) may reach"},{"bs":"pa su dostigle","en":"so they reached"},{"bs":"dostignu","en":"they (two) reach"},{"bs":"i dostigao je","en":"and he/it reached"}],"ref":"40:80","answerWord":"وَلِتَبْلُغُوا۟","answerSound":"audio/fb6f50fd69f2fedcc4ad.m4a","quranTranslation":{"text":"(Many) benefits ye have from them - and that ye may satisfy by their means a need that is in your breasts, and may be borne upon them as upon the ship.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dostići, doseći","en":"to reach, to attain"},"passage":["وَلَكُمْ","فِيهَا","مَنَٰفِعُ","وَلِتَبْلُغُوا۟","عَلَيْهَا","حَاجَةً","فِى","صُدُورِكُمْ","وَعَلَيْهَا","وَعَلَى","ٱلْفُلْكِ","تُحْمَلُونَ"],"marked":[3],"facts":{"verb":"بَلَغَ"}},{"id":"bashshara-84-24-0","words":["verb:bashshara"],"options":[{"bs":"pa ih obavijesti","en":"so give them tidings"},{"bs":"obradovan je","en":"he/it was given good news"},{"bs":"pa ga obraduj!","en":"so give him good news!"},{"bs":"i obradovali smo ga","en":"and we gave him good news"}],"ref":"84:24","answerWord":"فَبَشِّرْهُم","answerSound":"audio/267d849bce2cf3a1bb85.m4a","quranTranslation":{"text":"So give them tidings of a painful doom,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["فَبَشِّرْهُم","بِعَذَابٍ","أَلِيمٍ"],"marked":[0],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-16-58-1","words":["verb:bashshara"],"options":[{"bs":"obradovan je","en":"he/it was given good news"},{"bs":"donosimo ti radosnu vijest","en":"we give you good news"},{"bs":"i raduje","en":"and he/it gives good news"},{"bs":"obradovali smo te","en":"we gave you good news"}],"ref":"16:58","answerWord":"بُشِّرَ","answerSound":"audio/c53dbb886ee14a840b08.m4a","quranTranslation":{"text":"When if one of them receiveth tidings of the birth of a female, his face remaineth darkened, and he is wroth inwardly.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["وَإِذَا","بُشِّرَ","أَحَدُهُم","بِٱلْأُنثَىٰ","ظَلَّ","وَجْهُهُۥ","مُسْوَدًّا","وَهُوَ","كَظِيمٌ"],"marked":[1],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-31-7-13","words":["verb:bashshara"],"options":[{"bs":"pa ga obraduj!","en":"so give him good news!"},{"bs":"raduje te","en":"he/it gives you good news"},{"bs":"i obradovali smo ga","en":"and we gave him good news"},{"bs":"i obraduj!","en":"and give good news!"}],"ref":"31:7","answerWord":"فَبَشِّرْهُ","answerSound":"audio/caee4015b51f5573b41e.m4a","quranTranslation":{"text":"And when Our revelations are recited unto him he turneth away in pride as if he heard them not, as if there were a deafness in his ears. So give him tidings of a painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["وَإِذَا","تُتْلَىٰ","عَلَيْهِ","ءَايَٰتُنَا","وَلَّىٰ","مُسْتَكْبِرًا","كَأَن","لَّمْ","يَسْمَعْهَا","كَأَنَّ","فِىٓ","أُذُنَيْهِ","وَقْرًا","فَبَشِّرْهُ","بِعَذَابٍ","أَلِيمٍ"],"marked":[13],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-15-53-4","words":["verb:bashshara"],"options":[{"bs":"donosimo ti radosnu vijest","en":"we give you good news"},{"bs":"i obradovali su ga","en":"and they gave him good news"},{"bs":"pa ga obraduj!","en":"so give him good news!"},{"bs":"i obraduj!","en":"and give good news!"}],"ref":"15:53","answerWord":"نُبَشِّرُكَ","answerSound":"audio/d79f42ee864477e06d85.m4a","quranTranslation":{"text":"They said: Be not afraid! Lo! we bring thee good tidings of a boy possessing wisdom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["قَالُوا۟","لَا","تَوْجَلْ","إِنَّا","نُبَشِّرُكَ","بِغُلَٰمٍ","عَلِيمٍ"],"marked":[4],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-3-39-9","words":["verb:bashshara"],"options":[{"bs":"raduje te","en":"he/it gives you good news"},{"bs":"i obradovali su ga","en":"and they gave him good news"},{"bs":"raduje ih","en":"he/it gives them good news"},{"bs":"obradovali smo te","en":"we gave you good news"}],"ref":"3:39","answerWord":"يُبَشِّرُكَ","answerSound":"audio/7c294a0df85bfcb38282.m4a","quranTranslation":{"text":"And the angels called to him as he stood praying in the sanctuary: Allah giveth thee glad tidings of (a son whose name is) John, (who cometh) to confirm a word from Allah lordly, chaste, a prophet of the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["فَنَادَتْهُ","ٱلْمَلَٰٓئِكَةُ","وَهُوَ","قَآئِمٌ","يُصَلِّى","فِى","ٱلْمِحْرَابِ","أَنَّ","ٱللَّهَ","يُبَشِّرُكَ","بِيَحْيَىٰ","مُصَدِّقًۢا","بِكَلِمَةٍ","مِّنَ","ٱللَّهِ","وَسَيِّدًا","وَحَصُورًا","وَنَبِيًّا","مِّنَ","ٱلصَّٰلِحِينَ"],"marked":[9],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-3-45-6","words":["verb:bashshara"],"options":[{"bs":"raduje te","en":"he/it gives you good news"},{"bs":"radujete","en":"you (all) give good news"},{"bs":"raduje","en":"he/it gives good news"},{"bs":"obraduj!","en":"give good news!"}],"ref":"3:45","answerWord":"يُبَشِّرُكِ","answerSound":"audio/1a7a073f6e03ce8b0402.m4a","quranTranslation":{"text":"(And remember) when the angels said: O Mary! Lo! Allah giveth thee glad tidings of a word from him, whose name is the Messiah, Jesus, son of Mary, illustrious in the world and the Hereafter, and one of those brought near (unto Allah).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["إِذْ","قَالَتِ","ٱلْمَلَٰٓئِكَةُ","يَٰمَرْيَمُ","إِنَّ","ٱللَّهَ","يُبَشِّرُكِ","بِكَلِمَةٍ","مِّنْهُ","ٱسْمُهُ","ٱلْمَسِيحُ","عِيسَى","ٱبْنُ","مَرْيَمَ","وَجِيهًا","فِى","ٱلدُّنْيَا","وَٱلْءَاخِرَةِ","وَمِنَ","ٱلْمُقَرَّبِينَ"],"marked":[6],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-4-138-0","words":["verb:bashshara"],"options":[{"bs":"obraduj!","en":"give good news!"},{"bs":"pa smo je obradovali","en":"so we gave her good news"},{"bs":"i obradovali su ga","en":"and they gave him good news"},{"bs":"donosimo ti radosnu vijest","en":"we give you good news"}],"ref":"4:138","answerWord":"بَشِّرِ","answerSound":"audio/070bde09d0682ab4cf90.m4a","quranTranslation":{"text":"Bear unto the hypocrites the tidings that for them there is a painful doom;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["بَشِّرِ","ٱلْمُنَٰفِقِينَ","بِأَنَّ","لَهُمْ","عَذَابًا","أَلِيمًا"],"marked":[0],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-9-21-0","words":["verb:bashshara"],"options":[{"bs":"raduje ih","en":"he/it gives them good news"},{"bs":"pa ga obraduj!","en":"so give him good news!"},{"bs":"raduje","en":"he/it gives good news"},{"bs":"raduje te","en":"he/it gives you good news"}],"ref":"9:21","answerWord":"يُبَشِّرُهُمْ","answerSound":"audio/4117ac8a9eba22d82aa8.m4a","quranTranslation":{"text":"Their Lord giveth them good tidings of mercy from Him, and acceptance, and Gardens where enduring pleasure will be theirs;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["يُبَشِّرُهُمْ","رَبُّهُم","بِرَحْمَةٍ","مِّنْهُ","وَرِضْوَٰنٍ","وَجَنَّٰتٍ","لَّهُمْ","فِيهَا","نَعِيمٌ","مُّقِيمٌ"],"marked":[0],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-11-71-3","words":["verb:bashshara"],"options":[{"bs":"pa smo je obradovali","en":"so we gave her good news"},{"bs":"i obradovali smo ga","en":"and we gave him good news"},{"bs":"pa ga obraduj!","en":"so give him good news!"},{"bs":"raduje","en":"he/it gives good news"}],"ref":"11:71","answerWord":"فَبَشَّرْنَٰهَا","answerSound":"audio/1264c444be0a242a197f.m4a","quranTranslation":{"text":"And his wife, standing by laughed when We gave her good tidings (of the birth) of Isaac, and, after Isaac, of Jacob.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["وَٱمْرَأَتُهُۥ","قَآئِمَةٌ","فَضَحِكَتْ","فَبَشَّرْنَٰهَا","بِإِسْحَٰقَ","وَمِن","وَرَآءِ","إِسْحَٰقَ","يَعْقُوبَ"],"marked":[3],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-15-54-1","words":["verb:bashshara"],"options":[{"bs":"zar ste me obradovali?","en":"did you (all) give me good news?"},{"bs":"i raduje","en":"and he/it gives good news"},{"bs":"raduje te","en":"he/it gives you good news"},{"bs":"pa smo ga obradovali","en":"so We gave him good news"}],"ref":"15:54","answerWord":"أَبَشَّرْتُمُونِى","answerSound":"audio/dce8b628847e0b3820a8.m4a","quranTranslation":{"text":"He said: Bring ye me good tidings (of a son) when old age hath overtaken me? Of what then can ye bring good tidings?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["قَالَ","أَبَشَّرْتُمُونِى","عَلَىٰٓ","أَن","مَّسَّنِىَ","ٱلْكِبَرُ","فَبِمَ","تُبَشِّرُونَ"],"marked":[1],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-15-54-7","words":["verb:bashshara"],"options":[{"bs":"radujete","en":"you (all) give good news"},{"bs":"raduje ih","en":"he/it gives them good news"},{"bs":"i obradovali smo ga","en":"and we gave him good news"},{"bs":"i obradovali su ga","en":"and they gave him good news"}],"ref":"15:54","answerWord":"تُبَشِّرُونَ","answerSound":"audio/2a71611f12630638a918.m4a","quranTranslation":{"text":"He said: Bring ye me good tidings (of a son) when old age hath overtaken me? Of what then can ye bring good tidings?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["قَالَ","أَبَشَّرْتُمُونِى","عَلَىٰٓ","أَن","مَّسَّنِىَ","ٱلْكِبَرُ","فَبِمَ","تُبَشِّرُونَ"],"marked":[7],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-15-55-1","words":["verb:bashshara"],"options":[{"bs":"obradovali smo te","en":"we gave you good news"},{"bs":"zar ste me obradovali?","en":"did you (all) give me good news?"},{"bs":"i obradovali smo ga","en":"and we gave him good news"},{"bs":"i raduje","en":"and he/it gives good news"}],"ref":"15:55","answerWord":"بَشَّرْنَٰكَ","answerSound":"audio/1c3b625730608437d5df.m4a","quranTranslation":{"text":"They said: We bring thee good tidings in truth. So be not thou of the despairing.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["قَالُوا۟","بَشَّرْنَٰكَ","بِٱلْحَقِّ","فَلَا","تَكُن","مِّنَ","ٱلْقَٰنِطِينَ"],"marked":[1],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-17-9-7","words":["verb:bashshara"],"options":[{"bs":"i raduje","en":"and he/it gives good news"},{"bs":"donosimo ti radosnu vijest","en":"we give you good news"},{"bs":"i obraduj!","en":"and give good news!"},{"bs":"i obradovali su ga","en":"and they gave him good news"}],"ref":"17:9","answerWord":"وَيُبَشِّرُ","answerSound":"audio/eab38b28bce699678b7b.m4a","quranTranslation":{"text":"Lo! this Qur'an guideth unto that which is straightest, and giveth tidings unto the believers who do good works that theirs will be a great reward.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["إِنَّ","هَٰذَا","ٱلْقُرْءَانَ","يَهْدِى","لِلَّتِى","هِىَ","أَقْوَمُ","وَيُبَشِّرُ","ٱلْمُؤْمِنِينَ","ٱلَّذِينَ","يَعْمَلُونَ","ٱلصَّٰلِحَٰتِ","أَنَّ","لَهُمْ","أَجْرًا","كَبِيرًا"],"marked":[7],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-18-2-6","words":["verb:bashshara"],"options":[{"bs":"i raduje","en":"and he/it gives good news"},{"bs":"obradovali smo te","en":"we gave you good news"},{"bs":"zar ste me obradovali?","en":"did you (all) give me good news?"},{"bs":"pa smo ga obradovali","en":"so We gave him good news"}],"ref":"18:2","answerWord":"وَيُبَشِّرَ","answerSound":"audio/173c90a04920cbb5ab0d.m4a","quranTranslation":{"text":"(But hath made it) straight, to give warning of stern punishment from Him, and to bring unto the believers who do good works the news that theirs will be a fair reward,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["قَيِّمًا","لِّيُنذِرَ","بَأْسًا","شَدِيدًا","مِّن","لَّدُنْهُ","وَيُبَشِّرَ","ٱلْمُؤْمِنِينَ","ٱلَّذِينَ","يَعْمَلُونَ","ٱلصَّٰلِحَٰتِ","أَنَّ","لَهُمْ","أَجْرًا","حَسَنًا"],"marked":[6],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-37-101-0","words":["verb:bashshara"],"options":[{"bs":"pa smo ga obradovali","en":"so We gave him good news"},{"bs":"raduje te","en":"he/it gives you good news"},{"bs":"radujete","en":"you (all) give good news"},{"bs":"i obraduj!","en":"and give good news!"}],"ref":"37:101","answerWord":"فَبَشَّرْنَٰهُ","answerSound":"audio/d832e777666033f65fb6.m4a","quranTranslation":{"text":"So We gave him tidings of a gentle son.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["فَبَشَّرْنَٰهُ","بِغُلَٰمٍ","حَلِيمٍ"],"marked":[0],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-37-112-0","words":["verb:bashshara"],"options":[{"bs":"i obradovali smo ga","en":"and we gave him good news"},{"bs":"pa ga obraduj!","en":"so give him good news!"},{"bs":"i raduje","en":"and he/it gives good news"},{"bs":"obraduj!","en":"give good news!"}],"ref":"37:112","answerWord":"وَبَشَّرْنَٰهُ","answerSound":"audio/a099cafea8f373f03015.m4a","quranTranslation":{"text":"And we gave him tidings of the birth of Isaac, a prophet of the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["وَبَشَّرْنَٰهُ","بِإِسْحَٰقَ","نَبِيًّا","مِّنَ","ٱلصَّٰلِحِينَ"],"marked":[0],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-39-17-10","words":["verb:bashshara"],"options":[{"bs":"pa obraduj!","en":"so give good news!"},{"bs":"radujete","en":"you (all) give good news"},{"bs":"pa smo je obradovali","en":"so we gave her good news"},{"bs":"raduje","en":"he/it gives good news"}],"ref":"39:17","answerWord":"فَبَشِّرْ","answerSound":"audio/e5908afd88c42948d9ff.m4a","quranTranslation":{"text":"And those who put away false gods lest they should worship them and turn to Allah in repentance, for them there are glad tidings. Therefor give good tidings (O Muhammad) to My bondmen","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["وَٱلَّذِينَ","ٱجْتَنَبُوا۟","ٱلطَّٰغُوتَ","أَن","يَعْبُدُوهَا","وَأَنَابُوٓا۟","إِلَى","ٱللَّهِ","لَهُمُ","ٱلْبُشْرَىٰ","فَبَشِّرْ","عِبَادِ"],"marked":[10],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-42-23-2","words":["verb:bashshara"],"options":[{"bs":"raduje","en":"he/it gives good news"},{"bs":"i obraduj!","en":"and give good news!"},{"bs":"pa ga obraduj!","en":"so give him good news!"},{"bs":"obradovali smo te","en":"we gave you good news"}],"ref":"42:23","answerWord":"يُبَشِّرُ","answerSound":"audio/660d6dbc86d37884cd55.m4a","quranTranslation":{"text":"This it is which Allah announceth unto His bondmen who believe and do good works. Say (O Muhammad, unto mankind): I ask of you no fee therefor, save lovingkindness among kinsfolk. And whoso scoreth a good deed We add unto its good for him. Lo! Allah is Forgiving, Responsive.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["ذَٰلِكَ","ٱلَّذِى","يُبَشِّرُ","ٱللَّهُ","عِبَادَهُ","ٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","قُل","لَّآ","أَسْـَٔلُكُمْ","عَلَيْهِ","أَجْرًا","إِلَّا","ٱلْمَوَدَّةَ","فِى","ٱلْقُرْبَىٰ","وَمَن","يَقْتَرِفْ","حَسَنَةً","نَّزِدْ","لَهُۥ","فِيهَا","حُسْنًا","إِنَّ","ٱللَّهَ","غَفُورٌ","شَكُورٌ"],"marked":[2],"facts":{"verb":"بَشَّرَ"}},{"id":"bashshara-51-28-6","words":["verb:bashshara"],"options":[{"bs":"i obradovali su ga","en":"and they gave him good news"},{"bs":"pa smo ga obradovali","en":"so We gave him good news"},{"bs":"obradovan je","en":"he/it was given good news"},{"bs":"pa ih obavijesti","en":"so give them tidings"}],"ref":"51:28","answerWord":"وَبَشَّرُوهُ","answerSound":"audio/d39690b4806edcf7eede.m4a","quranTranslation":{"text":"Then he conceived a fear of them. They said: Fear not! and gave him tidings of (the birth of) a wise son.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obradovati, navijestiti radosnu vijest","en":"to give good news, to announce"},"passage":["فَأَوْجَسَ","مِنْهُمْ","خِيفَةً","قَالُوا۟","لَا","تَخَفْ","وَبَشَّرُوهُ","بِغُلَٰمٍ","عَلِيمٍ"],"marked":[6],"facts":{"verb":"بَشَّرَ"}},{"id":"alana-28-69-6","words":["verb:alana"],"options":[{"bs":"objavljuju","en":"they announce"},{"bs":"objavili ste","en":"you (all) announced"},{"bs":"objavljujete","en":"you declare"},{"bs":"javno sam govorio","en":"I announced"}],"ref":"28:69","answerWord":"يُعْلِنُونَ","answerSound":"audio/372c9fe7d429177f124f.m4a","quranTranslation":{"text":"And thy Lord knoweth what their breasts conceal, and what they publish.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"objaviti, javno reći","en":"to announce, to declare"},"passage":["وَرَبُّكَ","يَعْلَمُ","مَا","تُكِنُّ","صُدُورُهُمْ","وَمَا","يُعْلِنُونَ"],"marked":[6],"facts":{"verb":"أَعْلَنَ"}},{"id":"alana-16-19-5","words":["verb:alana"],"options":[{"bs":"objavljujete","en":"you declare"},{"bs":"objavili ste","en":"you (all) announced"},{"bs":"javno sam govorio","en":"I announced"},{"bs":"objavljujemo","en":"we announce"}],"ref":"16:19","answerWord":"تُعْلِنُونَ","answerSound":"audio/ac56f760c1e781ac239d.m4a","quranTranslation":{"text":"And Allah knoweth that which ye keep hidden and that which ye proclaim.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"objaviti, javno reći","en":"to announce, to declare"},"passage":["وَٱللَّهُ","يَعْلَمُ","مَا","تُسِرُّونَ","وَمَا","تُعْلِنُونَ"],"marked":[5],"facts":{"verb":"أَعْلَنَ"}},{"id":"alana-14-38-6","words":["verb:alana"],"options":[{"bs":"objavljujemo","en":"we announce"},{"bs":"objavljujete","en":"you declare"},{"bs":"objavljuju","en":"they announce"},{"bs":"javno sam govorio","en":"I announced"}],"ref":"14:38","answerWord":"نُعْلِنُ","answerSound":"audio/8a08389956684e77f43f.m4a","quranTranslation":{"text":"Our Lord! Lo! Thou knowest that which we hide and that which we proclaim. Nothing in the earth or in the heaven is hidden from Allah.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"objaviti, javno reći","en":"to announce, to declare"},"passage":["رَبَّنَآ","إِنَّكَ","تَعْلَمُ","مَا","نُخْفِى","وَمَا","نُعْلِنُ","وَمَا","يَخْفَىٰ","عَلَى","ٱللَّهِ","مِن","شَىْءٍ","فِى","ٱلْأَرْضِ","وَلَا","فِى","ٱلسَّمَآءِ"],"marked":[6],"facts":{"verb":"أَعْلَنَ"}},{"id":"alana-71-9-2","words":["verb:alana"],"options":[{"bs":"javno sam govorio","en":"I announced"},{"bs":"objavili ste","en":"you (all) announced"},{"bs":"objavljujemo","en":"we announce"},{"bs":"objavljuju","en":"they announce"}],"ref":"71:9","answerWord":"أَعْلَنتُ","answerSound":"audio/452a7a8fe64c4b0ace4f.m4a","quranTranslation":{"text":"And lo! I have made public proclamation unto them, and I have appealed to them in private.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"objaviti, javno reći","en":"to announce, to declare"},"passage":["ثُمَّ","إِنِّىٓ","أَعْلَنتُ","لَهُمْ","وَأَسْرَرْتُ","لَهُمْ","إِسْرَارًا"],"marked":[2],"facts":{"verb":"أَعْلَنَ"}},{"id":"adda-16-18-1","words":["verb:adda"],"options":[{"bs":"brojite","en":"you (all) count"},{"bs":"brojimo","en":"We count"},{"bs":"brojimo ih","en":"we count them"},{"bs":"i izbrojao ih je","en":"and He has counted them"}],"ref":"16:18","answerWord":"تَعُدُّوا۟","answerSound":"audio/08b93c50c8982f13ffeb.m4a","quranTranslation":{"text":"And if ye would count the favour of Allah ye cannot reckon it. Lo! Allah is indeed Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"brojati, izbrojati","en":"to count"},"passage":["وَإِن","تَعُدُّوا۟","نِعْمَةَ","ٱللَّهِ","لَا","تُحْصُوهَآ","إِنَّ","ٱللَّهَ","لَغَفُورٌ","رَّحِيمٌ"],"marked":[1],"facts":{"verb":"عَدَّ"}},{"id":"adda-22-47-13","words":["verb:adda"],"options":[{"bs":"brojite","en":"you (all) count"},{"bs":"brojimo","en":"We count"},{"bs":"i izbrojao ih je","en":"and He has counted them"},{"bs":"brojimo ih","en":"we count them"}],"ref":"22:47","answerWord":"تَعُدُّونَ","answerSound":"audio/664b5e754f5508cf129c.m4a","quranTranslation":{"text":"And they will bid thee hasten on the Doom, and Allah faileth not His promise, but lo! a Day with Allah is as a thousand years of what ye reckon.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"brojati, izbrojati","en":"to count"},"passage":["وَيَسْتَعْجِلُونَكَ","بِٱلْعَذَابِ","وَلَن","يُخْلِفَ","ٱللَّهُ","وَعْدَهُۥ","وَإِنَّ","يَوْمًا","عِندَ","رَبِّكَ","كَأَلْفِ","سَنَةٍ","مِّمَّا","تَعُدُّونَ"],"marked":[13],"facts":{"verb":"عَدَّ"}},{"id":"adda-19-84-4","words":["verb:adda"],"options":[{"bs":"brojimo","en":"We count"},{"bs":"brojimo ih","en":"we count them"},{"bs":"brojite","en":"you (all) count"},{"bs":"i izbrojao ih je","en":"and He has counted them"}],"ref":"19:84","answerWord":"نَعُدُّ","answerSound":"audio/aba9fe902b6d49c6dd1e.m4a","quranTranslation":{"text":"So make no haste against them (O Muhammad). We do but number unto them a sum (of days).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"brojati, izbrojati","en":"to count"},"passage":["فَلَا","تَعْجَلْ","عَلَيْهِمْ","إِنَّمَا","نَعُدُّ","لَهُمْ","عَدًّا"],"marked":[4],"facts":{"verb":"عَدَّ"}},{"id":"adda-19-94-2","words":["verb:adda"],"options":[{"bs":"i izbrojao ih je","en":"and He has counted them"},{"bs":"brojite","en":"you (all) count"},{"bs":"brojimo ih","en":"we count them"},{"bs":"brojimo","en":"We count"}],"ref":"19:94","answerWord":"وَعَدَّهُمْ","answerSound":"audio/cb12c224904e4ff56b6d.m4a","quranTranslation":{"text":"Verily He knoweth them and numbereth them with (right) numbering.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"brojati, izbrojati","en":"to count"},"passage":["لَّقَدْ","أَحْصَىٰهُمْ","وَعَدَّهُمْ","عَدًّا"],"marked":[2],"facts":{"verb":"عَدَّ"}},{"id":"adda-38-62-7","words":["verb:adda"],"options":[{"bs":"brojimo ih","en":"we count them"},{"bs":"brojite","en":"you (all) count"},{"bs":"brojimo","en":"We count"},{"bs":"i izbrojao ih je","en":"and He has counted them"}],"ref":"38:62","answerWord":"نَعُدُّهُم","answerSound":"audio/271e837d88325e884c9e.m4a","quranTranslation":{"text":"And they say: What aileth us that we behold not men whom we were wont to count among the wicked?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"brojati, izbrojati","en":"to count"},"passage":["وَقَالُوا۟","مَا","لَنَا","لَا","نَرَىٰ","رِجَالًا","كُنَّا","نَعُدُّهُم","مِّنَ","ٱلْأَشْرَارِ"],"marked":[7],"facts":{"verb":"عَدَّ"}},{"id":"jahara-13-10-6","words":["verb:jahara"],"options":[{"bs":"govorio je naglas","en":"he/it spoke aloud"},{"bs":"govoriš naglas","en":"you speak aloud"},{"bs":"govorite (svi) naglas","en":"speak (all) aloud"},{"bs":"govorite naglas","en":"you (all) speak aloud"}],"ref":"13:10","answerWord":"جَهَرَ","answerSound":"audio/743a55475ca133124bc7.m4a","quranTranslation":{"text":"Alike of you is he who hideth the saying and he who noiseth it abroad, he who lurketh in the night and he who goeth freely in the daytime.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"govoriti naglas, javno iznijeti","en":"to speak aloud, to make public"},"passage":["سَوَآءٌ","مِّنكُم","مَّنْ","أَسَرَّ","ٱلْقَوْلَ","وَمَن","جَهَرَ","بِهِۦ","وَمَنْ","هُوَ","مُسْتَخْفٍۭ","بِٱلَّيْلِ","وَسَارِبٌۢ","بِٱلنَّهَارِ"],"marked":[6],"facts":{"verb":"جَهَرَ"}},{"id":"jahara-49-2-10","words":["verb:jahara"],"options":[{"bs":"govorite naglas","en":"you (all) speak aloud"},{"bs":"govorio je naglas","en":"he/it spoke aloud"},{"bs":"govoriš naglas","en":"you speak aloud"},{"bs":"govorite (svi) naglas","en":"speak (all) aloud"}],"ref":"49:2","answerWord":"تَجْهَرُوا۟","answerSound":"audio/ea40a7d5b810c193b1ad.m4a","quranTranslation":{"text":"O ye who believe! Lift not up your voices above the voice of the Prophet, nor shout when speaking to him as ye shout one to another, lest your works be rendered vain while ye perceive not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"govoriti naglas, javno iznijeti","en":"to speak aloud, to make public"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","لَا","تَرْفَعُوٓا۟","أَصْوَٰتَكُمْ","فَوْقَ","صَوْتِ","ٱلنَّبِىِّ","وَلَا","تَجْهَرُوا۟","لَهُۥ","بِٱلْقَوْلِ","كَجَهْرِ","بَعْضِكُمْ","لِبَعْضٍ","أَن","تَحْبَطَ","أَعْمَٰلُكُمْ","وَأَنتُمْ","لَا","تَشْعُرُونَ"],"marked":[10],"facts":{"verb":"جَهَرَ"}},{"id":"jahara-67-13-3","words":["verb:jahara"],"options":[{"bs":"govorite (svi) naglas","en":"speak (all) aloud"},{"bs":"govorite naglas","en":"you (all) speak aloud"},{"bs":"govoriš naglas","en":"you speak aloud"},{"bs":"govorio je naglas","en":"he/it spoke aloud"}],"ref":"67:13","answerWord":"ٱجْهَرُوا۟","answerSound":"audio/42cb66e2eccc199c3318.m4a","quranTranslation":{"text":"And keep your opinion secret or proclaim it, lo! He is Knower of all that is in the breasts (of men).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"govoriti naglas, javno iznijeti","en":"to speak aloud, to make public"},"passage":["وَأَسِرُّوا۟","قَوْلَكُمْ","أَوِ","ٱجْهَرُوا۟","بِهِۦٓ","إِنَّهُۥ","عَلِيمٌۢ","بِذَاتِ","ٱلصُّدُورِ"],"marked":[3],"facts":{"verb":"جَهَرَ"}}]