{"rank": 29, "root": "أكل", "form": 1, "lemma": "أَكَلَ", "count": 93, "ayahCount": 87, "share": 0.48, "meaning": {"bs": "jesti", "en": "to eat", "tr": "yemek", "fr": "manger", "id": "makan", "ur": "کھانا", "bn": "খাওয়া", "fa": "خوردن"}, "lemmaSpoken": "audio/193be2a17ec458f9da0b.m4a", "animation": "<svg class=\"va va-akala_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes ak-a{from{transform:rotate(-30deg)}}.va-akala_1 .ra{transform:rotate(-150deg);animation:ak-a .8s ease-in-out 3 alternate both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-akala_1.off,.va-akala_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-akala_1,.va-akala_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><g transform=\"translate(56 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><circle class=\"q\" cy=\"17\" r=\"3.6\"/><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَكَلَ", "plain": "أَكَلَ", "quran": true, "notUsed": false, "spoken": "audio/193be2a17ec458f9da0b.m4a", "recited": "audio/b29bcc0418ee01f0c206.m4a", "recitedText": "أَكَلَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَأْكُلُ", "plain": "يَأْكُلُ", "quran": true, "notUsed": false, "spoken": "audio/08ead56e203d0856991c.m4a", "recited": "audio/c3cf4ebf8c071e77e9bd.m4a", "recitedText": "يَأْكُلُ"}], "nouns": {"verbal_noun": {"lemma": "أَكْل", "count": 4, "spoken": "audio/cd9099440f583414a1e6.m4a"}, "parti