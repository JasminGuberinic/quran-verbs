 false, "audio": null, "gloss": null}]}, {"ref": "20:24", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2372.mp3", "translation": {"en": {"text": "Go thou unto Pharaoh! Lo! he hath transgressed (the bounds).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Firavun'a git, çünkü o hakikaten azdı.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "فرعون کے پاس جا اس نے سر اٹھایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Pergilah kepada Fir'aun; sesungguhnya ia telah melampaui batas\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱذْهَبْ", "hit": true, "audio": "audio/b83aee7f634582d35fcd.m4a", "gloss": {"bs": "idi", "en": "go", "tr": "git", "fr": "va", "id": "pergilah", "ur": "جا", "bn": "যাও", "fa": "برو"}}, {"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "فِرْعَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "طَغَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:43", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antuma", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2391.mp3", "translation": {"en": {"text": "Go, both of you, unto Pharaoh. Lo! he hath transgressed (the bounds).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Firavun'a gidin, çünkü o gerçekten azdı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "دونوں فرعون کے پاس جاؤ بیشک اس نے سر اٹھایا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Pergilah kamu berdua kepada Fir'aun, sesungguhnya dia telah melampaui batas;", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱذْهَبَآ", "hit": true, "audio": "audio/689ab5fc1a2a5216cf5e.m4a", "gloss": null, "grammar": [{"tense": "imperative", "pronoun": "antuma", "passive": false, "objects": ["antuma"]}]}, {"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "فِرْعَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "طَغَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:93", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1689.mp3", "translation": {"en": {"text": "Go with this shirt of mine and lay it on my father's face, he will become (again) a seer; and come to me with all your folk.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Alın şu gömleğimi götürün de babamın yüzüne sürün, gözü açılır. Ve bütün ailenizle toplanıp bana gelin.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "میرا یہ کرتا لے جاؤ اسے میرے باپ کے منہ پر ڈالو ان کی آنکھیں کھل جائیں گی اور اپنے سب گھر بھر کو میرے پاس لے آ ؤ،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Pergilah kamu dengan membawa baju gamisku ini, lalu letakkanlah dia kewajah ayahku, nanti ia akan melihat kembali; dan bawalah keluargamu semuanya kepadaku\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱذْهَبُوا۟", "hit": true, "audio": "audio/5d4e00fecc51ce219599.m4a", "gloss": {"en": "(you all) take!", "bs": "odnesite!"}}, {"text": "بِقَمِيصِى", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَلْقُوهُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "وَجْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَبِى", "hit": false, "audio": null, "gloss": null}, {"text": "يَأْتِ", "hit": false, "audio": null, "gloss": null}, {"text": "بَصِيرًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَأْتُونِى", "hit": false, "audio": null, "gloss": null}, {"text": "بِأَهْلِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْمَعِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "43:41", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4366.mp3", "translation": {"en": {"text": "And if We take thee away, We surely shall take vengeance on them,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer biz seni onlara azap gelmeden önce alıp götürsek bile onlardan intikam alırız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اگر ہم تمہیں لے جائیں تو ان سے ہم ضرور بدلہ لیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sungguh, jika Kami mewafatkan kamu (sebelum kamu mencapai kemenangan) maka sesungguhnya Kami akan menyiksa mereka (di akhirat).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَإِمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "نَذْهَبَنَّ", "hit": true, "audio": "audio/6da55f7682bc8033b533.m4a", "gloss": {"bs": "odvedemo (te)", "en": "We take (you) away", "tr": "(seni) götürürsek", "fr": "Nous (t')emporterons", "id": "Kami membawa (kamu) pergi", "ur": "ہم (تمہیں) لے جائیں", "bn": "আমরা (তোমাকে) নিয়ে যাব", "fa": "(قطعاً تو را) خواهیم برد"}}, {"text": "بِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّنتَقِمُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ذَهَبَ", "count": 5, "first": "2:17", "audio": "audio/41c82060e7ddb26a4c59.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "otišao je", "en": "he went", "tr": "gitti", "fr": "il est pa