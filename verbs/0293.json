 false, "audio": null, "gloss": null}, {"text": "لَعَلَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَذَكَّرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:26", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2374.mp3", "translation": {"en": {"text": "And ease my task for me;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşimi kolaylaştır,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور میرے لیے میرا کام آسان کر،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan mudahkanlah untukku urusanku,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَسِّرْ", "hit": true, "audio": "audio/75e313e2f6a15a57e440.m4a", "gloss": {"bs": "i olakšaj", "en": "and ease", "tr": "ve kolaylaştır", "fr": "et facilite", "id": "dan mudahkanlah", "ur": "اور آسان کر دے", "bn": "এবং সহজ করে দাও", "fa": "و آسان گردان"}}, {"text": "لِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْرِى", "hit": false, "audio": null, "gloss": null}]}, {"ref": "80:20", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5778.mp3", "translation": {"en": {"text": "Then maketh the way easy for him,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra ona yolunu kolaylaştırdı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر اسے راستہ آسان کیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian Dia memudahkan jalannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّبِيلَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسَّرَهُۥ", "hit": true, "audio": "audio/d99c90bb296cbee59a10.m4a", "