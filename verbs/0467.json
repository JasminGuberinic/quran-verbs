rative", "pronoun": "antunna", "arabic": "اِرْكَعْنَ", "plain": "اِرْكَعْنَ", "quran": false, "notUsed": false, "spoken": "audio/2ec576e19adb991c363c.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "2:43", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/50.mp3", "translation": {"en": {"text": "Establish worship, pay the poor-due, and bow your heads with those who bow (in worship).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hem namazı dosdoğru kılın, zekatı verin, rükû edenlerle birlikte siz de rükû edin.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور نماز قائم رکھو اور زکوٰة دو اور رکوع کرنے والوں کے ساتھ رکوع کرو-", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan dirikanlah shalat, tunaikanlah zakat dan ruku'lah beserta orang-orang yang ruku'.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَقِيمُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّلَوٰةَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَءَاتُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلزَّكَوٰةَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱرْكَعُوا۟", "hit": true, "audio": "audio/ad544301595426f43d45.m4a", "gloss": {"bs": "i činite (svi) ruku'", "en": "and bow (all)", "tr": "ve rükû edin", "fr": "et inclinez-vous (vous tous)", "id": "dan rukuklah (kalian semua)", "ur": "اور تم سب رکوع کرو", "bn": "এবং তোমরা রুকু কর", "fa": "و (شما) رکوع کنید"}}, {"text": "مَعَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّٰكِعِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:43", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anti", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/336.mp3", "translation": {"en": {"text": "O Mary! Be obedient to thy Lord, prostrate thyself and bow with those who bow (in worship).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey Meryem! Rabbine divan dur ve secdeye kapan ve rüku' edenlerle beraber rüku' et\" demişlerdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے مریم اپنے رب کے حضور ادب سے کھڑی ہو اور اس کے لئے سجدہ کر اور رکوع والوں کے ساتھ رکوع کر،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hai Maryam, taatlah kepada Tuhanmu, sujud dan ruku'lah bersama orang-orang yang ruku'.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَٰمَرْيَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱقْنُتِى", "hit": false, "audio": null, "gloss": null}, {"text": "لِرَبِّكِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱسْجُدِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱرْكَعِى", "hit": true, "audio": "audio/a3678928371c08476f1a.m4a", "gloss": {"en": "and bow (in prayer)!", "bs": "i pokloni se!", "tr": "ve rüku et!", "fr": "et prosterne-toi !", "id": "dan sujudlah!", "ur": "اور رکوع کرو!", "bn": "এবং সিজদা কর!", "fa": "و رکوع کن!"}}, {"text": "مَعَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّٰكِعِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "77:48", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5670.mp3", "translation": {"en": {"text": "When it is said unto them: Bow down, they bow not down!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlara: \"Rüku edin\" denildiği zaman etmezler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جب ان سے کہا جائے کہ نماز پڑھو تو نہیں پڑھتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan apabila dikatakan kepada mereka: \"Rukuklah, niscaya mereka tidak mau ruku'.", "by": "Kementerian Agama 