 false, "translation": {"bs": "bratu", "en": "your brother", "bn": "তোমার ভাই", "fa": "برادرت", "fr": "ton frère", "id": "saudaramu", "tr": "kardeşin", "ur": "تمہارا بھائی"}}, {"arabic": "عَنِ", "target": false, "translation": {"bs": "od", "en": "from", "bn": "থেকে", "fa": "از", "fr": "de", "id": "dari", "tr": "-den", "ur": "سے"}}, {"arabic": "الْكَذِبِ", "target": false, "translation": {"bs": "laganja", "en": "lying", "bn": "মিথ্যা বলা", "fa": "دروغ گفتن", "fr": "le mensonge", "id": "berbohong", "tr": "yalan söylemek", "ur": "جھوٹ بولنا"}}]}, {"arabic": "يَنْهَوْنَ عَنِ الْغِشِّ", "spoken": "audio/af9dd372289a3c963c90.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Zabranjuju varanje.", "en": "They forbid cheating.", "bn": "তারা প্রতারণা নিষিদ্ধ করে।", "fa": "تقلب را ممنوع می‌کنند.", "fr": "Ils interdisent la tricherie.", "id": "Mereka melarang penipuan.", "tr": "Hileyi yasaklıyorlar.", "ur": "وہ دھوکے سے منع کرتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَنْهَوْنَ", "target": true, "translation": {"bs": "zabranjuju", "en": "they forbid", "bn": "তারা নিষেধ করে", "fa": "منع می‌کنند", "fr": "ils interdisent", "id": "mereka melarang", "tr": "yasaklarlar", "ur": "وہ منع کرتے ہیں"}}, {"arabic": "عَنِ", "target": false, "translation": {"bs": "od", "en": "from", "bn": "থেকে", "fa": "از", "fr": "de", "id": "dari", "tr": "-den", "ur": "سے"}}, {"arabic": "الْغِشِّ", "target": false, "translation": {"bs": "varanja", "en": "cheating", "bn": "প্রতারণা করা", "fa": "تقلب کردن", "fr": "la tricherie", "id": "berbuat curang", "tr": "hile yapmak", "ur": "دھوکا دینا"}}]}, {"arabic": "نَهَى الْأَبُ ابْنَهُ عَنِ الْكَذِبِ", "spoken": "audio/37cf89f7ce51111f516b.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Otac je sinu zabranio laganje.", "en": "The father forbade his son from lying.", "bn": "বাবা তার ছেলেকে মিথ্যা বলতে নিষেধ করলেন।", "fa": "پدر پسرش را از دروغ گفتن منع کرد.", "fr": "Le père a interdit à son fils de mentir.", "id