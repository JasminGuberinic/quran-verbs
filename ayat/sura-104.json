{"ayat":[{"ref":"104:1","number":6180,"text":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","hits":[]},{"ref":"104:2","number":6181,"text":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","hits":[0,1,2]},{"ref":"104:3","number":6182,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","hits":[0,1]},{"ref":"104:4","number":6183,"text":"كَلَّا لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","hits":[0,1,2]},{"ref":"104:5","number":6184,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","hits":[0,1]},{"ref":"104:6","number":6185,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","hits":[0]},{"ref":"104:7","number":6186,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","hits":[0,1,2,3]},{"ref":"104:8","number":6187,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","hits":[0]},{"ref":"104:9","number":6188,"text":"فِى عَمَدٍ مُّمَدَّدَةٍۭ","hits":[1]}]}