quran": false, "notUsed": false, "spoken": "audio/092cda0123ddc8fa563b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَهْلِكِي", "plain": "أَهْلِكِي", "quran": false, "notUsed": false, "spoken": "audio/86d593706b84ae261140.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَهْلِكَا", "plain": "أَهْلِكَا", "quran": false, "notUsed": false, "spoken": "audio/648a70e7e71a9edaabb5.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَهْلِكُوا", "plain": "أَهْلِكُوا", "quran": false, "notUsed": false, "spoken": "audio/685ec26bf58f7526458b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَهْلِكْنَ", "plain": "أَهْلِكْنَ", "quran": false, "notUsed": false, "spoken": "audio/0c376addc8f5e2f64198.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "54:51", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4897.mp3", "translation": {"en": {"text": "And verily We have destroyed your fellows; but is there any that remembereth?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun biz, sizin benzerlerinizi hep helak ettik. Öğüt alan yok mudur?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے تمہاری وضع کے ہلاک کردیے تو ہے کوئی دھیان کرنے والا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya telah Kami binasakan orang yang serupa dengan kamu. Maka adakah orang yang mau mengambil pelajaran?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَهْلَكْنَآ", "hit": true, "audio": "audio/48b2a1171558a8df260f.m4a", "gloss": {"en": "we destroyed", "bs": "uništili smo", "tr": "yok ettik", "fr": "nous avons détruit", "id": "kami telah membinasakan", "ur": "ہم نے تباہ کیا", "bn": "আমরা ধ্বংস করেছি", "fa": "نابود کردیم"}}, {"text": "أَشْيَاعَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَهَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "مُّدَّكِرٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "11:117", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1590.mp3", "translation": {"en": {"text": "In truth thy Lord destroyed not the townships tyrannously while their folk were doing right.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Senin Rabbin, halkları iyi ve ıslahatçı iken, o memleketleri haksız yere helak edecek değildir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور تمہارا رب ایسا نہیں کہ بستیوں کو بے وجہ ہلاک کردے اور ان کے لوگ اچھے ہوں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Tuhanmu sekali-kali tidak akan membinasakan negeri-negeri secara zalim, sedang penduduknya orang-orang yang berbuat kebaikan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِيُهْلِكَ", "hit": true, "audio": "audio/4b0ce1a683cd3d4c84e1.m4a", "gloss": {"en": "so that he/it may destroy", "bs": "da uništi", "tr": "yok etsin diye", "fr": "qu'il détruise", "id": "agar dia membinasakan", "ur": "تاکہ وہ تباہ کرے", "bn": "যাতে সে ধ্বংস করে", "fa": "تا نابود کند"}}, {"text": "ٱلْقُرَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "بِظُلْمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَهْلُهَا", "hit": false, "audio": null, "gloss": null}, {"text": "مُصْلِحُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "77:16", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5638.mp3", "translation": {"en": {"text": "Destroyed We not the former folk,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz, öncekileri helak etmedik mi?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا ہم نے اگلوں کو ہلاک نہ فرمایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Bukankah Kami telah membinasakan orang-orang yang dahulu?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَلَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نُهْلِكِ", "hit": true, "audio": "audio/0cea2b14398b2967f937.m4a", "gloss": {"bs": "(zar nismo) uništili", "en": "(did We not) destroy", "tr": "(biz) helak etmedik mi", "fr": "(n'avons-Nous pas) détruit", "id": "(bukankah Kami) membinasakan", "ur": "(کیا ہم نے) ہلاک نہیں کیا", "bn": "(আমরা কি) ধ্বংস করিনি", "fa": "(آیا) نابود نکردیم"}}, {"text": "ٱلْأَوَّلِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "53:50", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4834.mp3", "translation": {"en": {"text": "And that He destroyed the former (tribe of) A'ad,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O, helak etti önce gelen Âd'ı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ کہ اسی نے پہلی عاد کو ہلاک فرمایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan bahwasanya Dia telah membinasakan kaum 'Aad yang pertama,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنَّهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَهْلَكَ", "hit": true, "audio": "audio/2be97e7662ee1c367876.m4a", "gloss": {"bs": "uništio je", "en": "destroyed", "tr": "helak etti", "fr": "a détruit", "id": "membinasakan", "ur": "اس نے ہلاک کیا", "bn": "ধ্বংস করলেন", "fa": "نابود کرد"}}, {"text": "عَادًا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأُولَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "6:26", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/815.mp3", "translation": {"en": {"text": "And they forbid (men) from it and avoid it, and they ruin none save themselves, though they perceive not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, insanları Kur'ân'a iman etmekten menederler, hem de kendileri ondan uzak dururlar. Böylece yalnız kendilerini mahvediyorlar ama farkında değiller.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ اس سے روکتے اور اس سے دور بھاگتے ہیں اور بلاک نہیں کرتے مگر اپنی جانیں اور انہیں شعور نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka melarang (orang lain) mendengarkan Al-Quran dan mereka sendiri menjauhkan diri daripadanya, dan mereka hanyalah membinasakan diri mereka sendiri, sedang mereka tidak menyadari.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَنْهَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَنْـَٔوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِن", "hit": false, "audio": null, "gloss": null}, {"text": "يُهْلِكُونَ", "hit": true, "audio": "audio/afbeb21f0d101e9b8f6e.m4a", "gloss": {"en": "they destroy", "bs": "uništavaju", "tr": "yok ederler", "fr": "ils détruisent", "id": "mereka membinasakan", "ur": "وہ تباہ کرتے ہیں", "bn": "তারা ধ্বংস করে", "fa": "نابود می‌کنند"}}, {"text": "إِلَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنفُسَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَشْعُرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "90:6", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6029.mp3", "translation": {"en": {"text": "And he saith: I have destroyed vast wealth:", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ben, yığın yığın mal yok ettim diyor.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہتا ہے میں نے ڈھیروں مال فنا کردیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mengatakan: \"Aku telah menghabiskan harta yang banyak\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَقُولُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَهْلَكْتُ", "hit": true, "audio": "audio/90f97a611306dac6ac7a.m4a", "gloss": {"en": "I squandered", "bs": "potrošio sam", "tr": "harcadım", "fr": "j'ai dilapidé", "id": "aku telah menghambur-hamburkan", "ur": "میں نے ضائع کیا", "bn": "আমি অপচয় করেছি", "fa": "هدر دادم"}}, {"text": "مَالًا", "hit": false, "audio": null, "gloss": null}, {"text": "لُّبَدًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَهْلَكْنَا", "count": 15, "first": "6:6", "audio": "audio/3cc55e3c03ee9c933290.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "we destroyed", "bs": "uništili smo", "tr": "yok ettik", "fr": "nous avons détruit", "id": "kami telah membinasakan", "ur": "ہم نے تباہ کیا", "bn": "আমরা ধ্বংস করেছি", "fa": "نابود کردیم"}}, {"arabic": "أَهْلَكْنَٰهُمْ", "count": 3, "first": "18:59", "audio": "audio/a59c5c58e441cddfbdcf.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objec