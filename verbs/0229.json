rative", "pronoun": "antunna", "arabic": "أَفْسِدْنَ", "plain": "أَفْسِدْنَ", "quran": false, "notUsed": false, "spoken": "audio/db00ed5a3b05da8637ed.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "26:152", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3084.mp3", "translation": {"en": {"text": "Who spread corruption in the earth, and reform not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Yeryüzünde bozgunculuk yapıp dirlik düzenlik vermeyen bozguncuların emrine uymayın.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ جو زمین میں فساد پھیلاتے ہیں اور بناؤ نہیں کرتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "yang membuat kerusakan di muka bumi dan tidak mengadakan perbaikan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُفْسِدُونَ", "hit": true, "audio": "audio/70a6e13288b65343972f.m4a", "gloss": {"bs": "čine nered", "en": "they spread corruption", "tr": "fesat çıkarırlar", "fr": "ils sèment la corruption", "id": "mereka berbuat kerusakan", "ur": "وہ فساد کرتے ہیں", "bn": "তারা ফাসাদ সৃষ্টি করে", "fa": "فساد می‌کنند"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُصْلِحُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "47:22", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4567.mp3", "translation": {"en": {"text": "Would ye then, if ye were given the command, work corruption in the land and sever your ties of kinship?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Demek siz iş başına gelecek olursanız yeryüzünde bozgunculuk çıkaracaksınız ve akrabalık bağlarınızı koparacaksınız öyle mi?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو کیا تمہارے یہ لچھن نظر آتے ہیں کہ اگر تمہیں حکومت ملے تو زمین میں فساد پھیلاؤ اور اپنے رشتے کاٹ دو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka apakah kiranya jika kamu berkuasa kamu akan membuat kerusakan di muka bumi dan memutuskan hubungan kekeluargaan?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَهَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَسَيْتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَوَلَّيْتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "تُفْسِدُوا۟", "hit": true, "audio": "audio/caae08d8b781dce8c74c.m4a", "gloss": {"en": "you (all) corrupt", "bs": "kvarite", "tr": "bozarsınız", "fr": "vous corrompez", "id": "kalian merusak", "ur": "تم سب فساد کرتے ہو", "bn": "তোমরা বিপর্যয় সৃষ্টি কর", "fa": "فساد کنید"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتُقَطِّعُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْحَامَكُمْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:73", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1669.mp3", "translation": {"en": {"text": "They said: By Allah, well ye know we came not to do evil in the land, and are no thieves.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Allah'a yemin ederiz ki,\" dediler, \"Muhakkak siz de anlamışsınızdır ya, biz buraya fesat çıkarmak için gelmedik. Biz hırsız da değiliz.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے خدا کی قسم! تمہیں خوب معلوم ہے کہ ہم زمین میں فساد کرنے نہ آئے اور نہ ہم چور ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Saudara-saudara Yusuf menjawab \"Demi Allah sesungguhnya kamu mengetahui bahwa kami datang bukan untuk membuat kerusakan di negeri (ini) dan kami bukanlah para pencuri\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "تَٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلِمْتُم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّا", "hit": false, "audio": null, "gloss": null}, {"text": "جِئْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لِنُفْسِدَ", "hit": true, "audio": "audio/766d0ecf52ca543a39c0.m4a", "gloss": {"en": "so that we may corrupt", "bs": "da pokvarimo", "tr": "bozalım diye", "fr": "que nous corrompions", "id": "agar kami merusak", "ur": "تاکہ ہم فساد کریں", "bn": "যাতে আমরা বিপর্যয় সৃষ্টি করি", "fa": "تا فساد کنیم"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "سَٰرِقِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تُفْسِدُوا۟", "count": 4, "first": "2:11", "audio": "audio/e1e0d07882c403d8cc2e.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}, {"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "you (all) corrupt", "bs": "kvarite", "tr": "bozarsınız", "fr": "vous corrompez", "id": "kalian merusak", "ur": "تم سب فساد کرتے ہو", "bn": "তোমরা বিপর্যয় সৃষ্টি কর", "fa": "فساد کنید"}}, {"arabic": "يُفْسِدُونَ", "count": 3, "first": 