lse, "notUsed": false, "spoken": "audio/1d25da53c34ac2acf449.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "نَزِّلْنَ", "plain": "نَزِّلْنَ", "quran": false, "notUsed": false, "spoken": "audio/4bdc000621a794362cc1.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "7:196", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1150.mp3", "translation": {"en": {"text": "Lo! my Protecting Friend is Allah Who revealeth the Scripture. He befriendeth the righteous.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Zira benim velim, o kitabı indiren Allah'tır. Ve O, salih kullarına sahip çıkar.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک میرا والی اللہ ہے جس نے کتاب ا تاری اور وہ نیکوں کو دوست رکھتا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya pelindungku ialahlah Yang telah menurunkan Al Kitab (Al Quran) dan Dia melindungi orang-orang yang saleh.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلِۦِّىَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "نَزَّلَ", "hit": true, "audio": "audio/ee77abde2ba10e391c92.m4a", "gloss": {"en": "he/it sent down", "bs": "objavio je", "tr": "indirdi", "fr": "il a fait descendre", "id": "dia telah menurunkan", "ur": "اُس نے اتارا", "bn": "সে অবতীর্ণ করেছে", "fa": "نازل کرد"}}, {"text": "ٱلْكِتَٰبَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَوَلَّى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّٰلِحِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:198", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3130.mp3", "translation": {"en": {"text": "And if We had revealed it unto one of any other nation than the Arabs,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz onu Arapça bilmeyenlerden birine indirseydik de, bunu o okusaydı, yine de ona iman etmezlerdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر ہم اسے کسی غیر عربی شخص پر اتارتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan kalau Al Quran itu Kami turunkan kepada salah seorang dari golongan bukan Arab,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَزَّلْنَٰهُ", "hit": true, "audio": "audio/c7c7e6fdcfafdbeaefd2.m4a", "gloss": {"bs": "(da) smo ga objavili", "en": "(had) We sent it down", "tr": "onu indirseydik", "fr": "(si) Nous l'avions fait descendre", "id": "(sekiranya) Kami menurunkannya", "ur": "(اگر) ہم اسے اتارتے", "bn": "(যদি) আমরা তা নাযিল করতাম", "fa": "(اگر) آن را نازل کرده بودیم"}}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَعْجَمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:8", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1810.mp3", "translation": {"en": {"text": "We send not down the angels save with the Fact, and in that case (the disbelievers) would not be tolerated.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz o melekleri ancak, hak ile indiririz. Ve indirildikleri vakit de onlara (kâfirlere) hiç mühlet verilmez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہم فرشتے بیکار نہیں اتارتے 