vojoj presudi", "en": "his ruling", "bn": "তার রায়", "fa": "حکمش", "fr": "dans son jugement", "id": "keputusannya", "tr": "hükmünde", "ur": "اس کا فیصلہ"}}]}, {"arabic": "أَعْدِلُ بَيْنَ طُلَّابِي", "spoken": "audio/ed3c362dbf6edb7350f1.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Pravedan sam prema svim učenicima.", "en": "I am fair to all my students.", "bn": "আমি আমার সব ছাত্রের প্রতি ন্যায্য আচরণ করি।", "fa": "با همه دانش‌آموزانم منصف هستم.", "fr": "Je suis équitable envers tous mes élèves.", "id": "Aku bersikap adil kepada semua muridku.", "tr": "Bütün öğrencilerime adil davranırım.", "ur": "میں اپنے تمام طلبہ کے ساتھ انصاف کرتا ہوں۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَعْدِلُ", "target": true, "translation": {"bs": "pravedan sam", "en": "I act justly", "bn": "আমি ন্যায়বিচার করি", "fa": "عدالت می‌کنم", "fr": "je suis juste", "id": "aku berlaku adil", "tr": "adil davranırım", "ur": "میں انصاف کرتا ہوں"}}, {"arabic": "بَيْنَ", "target": false, "translation": {"bs": "među", "en": "among", "bn": "মধ্যে", "fa": "میان", "fr": "parmi", "id": "di antara", "tr": "arasında", "ur": "کے درمیان"}}, {"arabic": "طُلَّابِي", "target": false, "translation": {"bs": "svojim učenicima", "en": "my students", "bn": "আমার ছাত্ররা", "fa": "دانش‌آموزانم", "fr": "mes élèves", "id": "murid-muridku", "tr": "öğrencilerim", "ur": "میرے طلبہ"}}]}, {"arabic": "عَدَلُوا فِي الْقِسْمَةِ", "spoken": "audio/34edeae3b8d5c51d415f.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Bili su pravedni u podjeli.", "en": "They were fair in the sharing.", "bn": "তারা বণ্টনে ন্যায়বিচার করল।", "fa": "در تقسیم عدالت کردند.", "fr": "Ils ont été équitables dans le partage.", "id": "Mereka adil dalam pembagian itu.", "tr": "Paylaşımda adil davrandılar.", "ur": "انہوں نے تقسیم میں انصاف کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "عَدَلُوا", "target": true, "translation": {"bs": "bili su pravedni", "en": "they acted justly", "bn": "তারা ন