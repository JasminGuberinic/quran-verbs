[{"id":"adhdhaba-2-284-20","words":["verb:adhdhaba"],"options":[{"bs":"i kažnjava","en":"and he/it punishes"},{"bs":"kažnjavamo ga","en":"we punish him"},{"bs":"kažnjava nas","en":"he/it punishes us"},{"bs":"kažnjava ih","en":"he/it punishes them"}],"ref":"2:284","answerWord":"وَيُعَذِّبُ","answerSound":"audio/69a88f8822bd40f9955f.m4a","quranTranslation":{"text":"Unto Allah (belongeth) whatsoever is in the heavens and whatsoever is in the earth; and whether ye make known what is in your minds or hide it, Allah will bring you to account for it. He will forgive whom He will and He will punish whom He will. Allah is Able to do all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["لِّلَّهِ","مَا","فِى","ٱلسَّمَٰوَٰتِ","وَمَا","فِى","ٱلْأَرْضِ","وَإِن","تُبْدُوا۟","مَا","فِىٓ","أَنفُسِكُمْ","أَوْ","تُخْفُوهُ","يُحَاسِبْكُم","بِهِ","ٱللَّهُ","فَيَغْفِرُ","لِمَن","يَشَآءُ","وَيُعَذِّبُ","مَن","يَشَآءُ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَىْءٍ","قَدِيرٌ"],"marked":[20],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-5-40-8","words":["verb:adhdhaba"],"options":[{"bs":"kažnjava","en":"he/it punishes"},{"bs":"pa ga kažnjava","en":"so he/it punishes him"},{"bs":"pa ih kažnjava","en":"so he/it punishes them"},{"bs":"kažnjavamo","en":"we punish"}],"ref":"5:40","answerWord":"يُعَذِّبُ","answerSound":"audio/cc8a7f1b21aac714b0df.m4a","quranTranslation":{"text":"Knowest thou not that unto Allah belongeth the Sovereignty of the heavens and the earth? He punisheth whom He will, and forgiveth whom He will. Allah is Able to do all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["أَلَمْ","تَعْلَمْ","أَنَّ","ٱللَّهَ","لَهُۥ","مُلْكُ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","يُعَذِّبُ","مَن","يَشَآءُ","وَيَغْفِرُ","لِمَن","يَشَآءُ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَىْءٍ","قَدِيرٌ"],"marked":[8],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-9-39-2","words":["verb:adhdhaba"],"options":[{"bs":"kažnjava vas","en":"he/it punishes you (all)"},{"bs":"da kazni","en":"so that he/it may punish"},{"bs":"kažnjavam ga","en":"I punish him"},{"bs":"kažnjavamo","en":"we punish"}],"ref":"9:39","answerWord":"يُعَذِّبْكُمْ","answerSound":"audio/c96b45ba108e928d9093.m4a","quranTranslation":{"text":"If ye go not forth He will afflict you with a painful doom, and will choose instead of you a folk other than you. Ye cannot harm Him at all. Allah is Able to do all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["إِلَّا","تَنفِرُوا۟","يُعَذِّبْكُمْ","عَذَابًا","أَلِيمًا","وَيَسْتَبْدِلْ","قَوْمًا","غَيْرَكُمْ","وَلَا","تَضُرُّوهُ","شَيْـًٔا","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَىْءٍ","قَدِيرٌ"],"marked":[2],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-9-14-1","words":["verb:adhdhaba"],"options":[{"bs":"kažnjava ih","en":"he/it punishes them"},{"bs":"pa ih kažnjavam","en":"so I punish them"},{"bs":"i kaznili smo ga","en":"and we punished it"},{"bs":"kažnjava","en":"he/it punishes"}],"ref":"9:14","answerWord":"يُعَذِّبْهُمُ","answerSound":"audio/505f5be5ff7a407fff00.m4a","quranTranslation":{"text":"Fight them! Allah will chastise them at your hands, and He will lay them low and give you victory over them, and He will heal the breasts of folk who are believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["قَٰتِلُوهُمْ","يُعَذِّبْهُمُ","ٱللَّهُ","بِأَيْدِيكُمْ","وَيُخْزِهِمْ","وَيَنصُرْكُمْ","عَلَيْهِمْ","وَيَشْفِ","صُدُورَ","قَوْمٍ","مُّؤْمِنِينَ"],"marked":[1],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-33-24-4","words":["verb:adhdhaba"],"options":[{"bs":"i kažnjava","en":"and he/it punishes"},{"bs":"pa ih kažnjava","en":"so he/it punishes them"},{"bs":"pa ih kažnjavam","en":"so I punish them"},{"bs":"kažnjava ga","en":"he/it punishes him"}],"ref":"33:24","answerWord":"وَيُعَذِّبَ","answerSound":"audio/982c04d4b34cfc11db64.m4a","quranTranslation":{"text":"That Allah may reward the true men for their truth, and punish the hypocrites if He will, or relent toward them (if He will). Lo! Allah is Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["لِّيَجْزِىَ","ٱللَّهُ","ٱلصَّٰدِقِينَ","بِصِدْقِهِمْ","وَيُعَذِّبَ","ٱلْمُنَٰفِقِينَ","إِن","شَآءَ","أَوْ","يَتُوبَ","عَلَيْهِمْ","إِنَّ","ٱللَّهَ","كَانَ","غَفُورًا","رَّحِيمًا"],"marked":[4],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-3-56-3","words":["verb:adhdhaba"],"options":[{"bs":"pa ih kažnjavam","en":"so I punish them"},{"bs":"da ih kazni","en":"so that he/it may punish them"},{"bs":"kažnjava vas","en":"he/it punishes you (all)"},{"bs":"kažnjava ga","en":"he/it punishes him"}],"ref":"3:56","answerWord":"فَأُعَذِّبُهُمْ","answerSound":"audio/f12c15b192745a03c2ab.m4a","quranTranslation":{"text":"As for those who disbelieve I shall chastise them with a heavy chastisement in the world and the Hereafter; and they will have no helpers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["فَأَمَّا","ٱلَّذِينَ","كَفَرُوا۟","فَأُعَذِّبُهُمْ","عَذَابًا","شَدِيدًا","فِى","ٱلدُّنْيَا","وَٱلْءَاخِرَةِ","وَمَا","لَهُم","مِّن","نَّٰصِرِينَ"],"marked":[3],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-3-128-9","words":["verb:adhdhaba"],"options":[{"bs":"kažnjava ih","en":"he/it punishes them"},{"bs":"kažnjavamo","en":"we punish"},{"bs":"pa ih kažnjavam","en":"so I punish them"},{"bs":"kažnjava","en":"he/it punishes"}],"ref":"3:128","answerWord":"يُعَذِّبَهُمْ","answerSound":"audio/9d9f4604f847f8f912a1.m4a","quranTranslation":{"text":"It is no concern at all of thee (Muhammad) whether He relent toward them or punish them; for they are evil-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["لَيْسَ","لَكَ","مِنَ","ٱلْأَمْرِ","شَىْءٌ","أَوْ","يَتُوبَ","عَلَيْهِمْ","أَوْ","يُعَذِّبَهُمْ","فَإِنَّهُمْ","ظَٰلِمُونَ"],"marked":[9],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-4-173-14","words":["verb:adhdhaba"],"options":[{"bs":"pa ih kažnjava","en":"so he/it punishes them"},{"bs":"kažnjava nas","en":"he/it punishes us"},{"bs":"kažnjava vas","en":"he/it punishes you (all)"},{"bs":"kažnjavam ga","en":"I punish him"}],"ref":"4:173","answerWord":"فَيُعَذِّبُهُمْ","answerSound":"audio/9f0cc506cb27aaffa8ec.m4a","quranTranslation":{"text":"Then, as for those who believed and did good works, unto them will He pay their wages in full, adding unto them of His bounty; and as for those who were scornful and proud, them will He punish with a painful doom. And they will not find for them, against Allah, any protecting friend or helper.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["فَأَمَّا","ٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","فَيُوَفِّيهِمْ","أُجُورَهُمْ","وَيَزِيدُهُم","مِّن","فَضْلِهِۦ","وَأَمَّا","ٱلَّذِينَ","ٱسْتَنكَفُوا۟","وَٱسْتَكْبَرُوا۟","فَيُعَذِّبُهُمْ","عَذَابًا","أَلِيمًا","وَلَا","يَجِدُونَ","لَهُم","مِّن","دُونِ","ٱللَّهِ","وَلِيًّا","وَلَا","نَصِيرًا"],"marked":[14],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-5-18-9","words":["verb:adhdhaba"],"options":[{"bs":"kažnjava vas","en":"he/it punishes you (all)"},{"bs":"i kaznili smo ga","en":"and we punished it"},{"bs":"kažnjava ih","en":"he/it punishes them"},{"bs":"kažnjavam ga","en":"I punish him"}],"ref":"5:18","answerWord":"يُعَذِّبُكُم","answerSound":"audio/d96fd9ac0cbc6ecb6c93.m4a","quranTranslation":{"text":"The Jews and Christians say: We are sons of Allah and His loved ones. Say: Why then doth He chastise you for your sins? Nay, ye are but mortals of His creating. He forgiveth whom He will, and chastiseth whom He will. Allah's is the Sovereignty of the heavens and the earth and all that is between them, and unto Him is the journeying.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["وَقَالَتِ","ٱلْيَهُودُ","وَٱلنَّصَٰرَىٰ","نَحْنُ","أَبْنَٰٓؤُا۟","ٱللَّهِ","وَأَحِبَّٰٓؤُهُۥ","قُلْ","فَلِمَ","يُعَذِّبُكُم","بِذُنُوبِكُم","بَلْ","أَنتُم","بَشَرٌ","مِّمَّنْ","خَلَقَ","يَغْفِرُ","لِمَن","يَشَآءُ","وَيُعَذِّبُ","مَن","يَشَآءُ","وَلِلَّهِ","مُلْكُ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","وَمَا","بَيْنَهُمَا","وَإِلَيْهِ","ٱلْمَصِيرُ"],"marked":[9],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-5-115-10","words":["verb:adhdhaba"],"options":[{"bs":"kažnjavam ga","en":"I punish him"},{"bs":"kažnjavamo","en":"we punish"},{"bs":"i kažnjava","en":"and he/it punishes"},{"bs":"kažnjava ih","en":"he/it punishes them"}],"ref":"5:115","answerWord":"أُعَذِّبُهُۥ","answerSound":"audio/0b4f4ac52aa03158787e.m4a","quranTranslation":{"text":"Allah said: Lo! I send it down for you. And whoso disbelieveth of you afterward, him surely will I punish with a punishment wherewith I have not punished any of (My) creatures.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["قَالَ","ٱللَّهُ","إِنِّى","مُنَزِّلُهَا","عَلَيْكُمْ","فَمَن","يَكْفُرْ","بَعْدُ","مِنكُمْ","فَإِنِّىٓ","أُعَذِّبُهُۥ","عَذَابًا","لَّآ","أُعَذِّبُهُۥٓ","أَحَدًا","مِّنَ","ٱلْعَٰلَمِينَ"],"marked":[10],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-5-115-13","words":["verb:adhdhaba"],"options":[{"bs":"kažnjavam ga","en":"I punish him"},{"bs":"da ih kazni","en":"so that he/it may punish them"},{"bs":"i kaznio je","en":"and he/it punished"},{"bs":"pa će ga (Allah) kazniti","en":"then (God) will punish him"}],"ref":"5:115","answerWord":"أُعَذِّبُهُۥٓ","answerSound":"audio/454ecef608d1b26624bb.m4a","quranTranslation":{"text":"Allah said: Lo! I send it down for you. And whoso disbelieveth of you afterward, him surely will I punish with a punishment wherewith I have not punished any of (My) creatures.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["قَالَ","ٱللَّهُ","إِنِّى","مُنَزِّلُهَا","عَلَيْكُمْ","فَمَن","يَكْفُرْ","بَعْدُ","مِنكُمْ","فَإِنِّىٓ","أُعَذِّبُهُۥ","عَذَابًا","لَّآ","أُعَذِّبُهُۥٓ","أَحَدًا","مِّنَ","ٱلْعَٰلَمِينَ"],"marked":[13],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-8-33-3","words":["verb:adhdhaba"],"options":[{"bs":"da ih kazni","en":"so that he/it may punish them"},{"bs":"kažnjava ga","en":"he/it punishes him"},{"bs":"kažnjava vas","en":"he/it punishes you (all)"},{"bs":"pa ih kažnjavam","en":"so I punish them"}],"ref":"8:33","answerWord":"لِيُعَذِّبَهُمْ","answerSound":"audio/ab0220c2644aee53216c.m4a","quranTranslation":{"text":"But Allah would not punish them while thou wast with them, nor will He punish them while they seek forgiveness.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["وَمَا","كَانَ","ٱللَّهُ","لِيُعَذِّبَهُمْ","وَأَنتَ","فِيهِمْ","وَمَا","كَانَ","ٱللَّهُ","مُعَذِّبَهُمْ","وَهُمْ","يَسْتَغْفِرُونَ"],"marked":[3],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-8-34-3","words":["verb:adhdhaba"],"options":[{"bs":"kažnjava ih","en":"he/it punishes them"},{"bs":"kažnjavam ga","en":"I punish him"},{"bs":"pa će ga (Allah) kazniti","en":"then (God) will punish him"},{"bs":"kažnjava nas","en":"he/it punishes us"}],"ref":"8:34","answerWord":"يُعَذِّبَهُمُ","answerSound":"audio/0316830ca4f6542a97bc.m4a","quranTranslation":{"text":"What (plea) have they that Allah should not punish them, when they debar (His servants) from the Inviolable Place of Worship, though they are not its fitting guardians. Its fitting guardians are those only who keep their duty to Allah. But most of them know not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["وَمَا","لَهُمْ","أَلَّا","يُعَذِّبَهُمُ","ٱللَّهُ","وَهُمْ","يَصُدُّونَ","عَنِ","ٱلْمَسْجِدِ","ٱلْحَرَامِ","وَمَا","كَانُوٓا۟","أَوْلِيَآءَهُۥٓ","إِنْ","أَوْلِيَآؤُهُۥٓ","إِلَّا","ٱلْمُتَّقُونَ","وَلَٰكِنَّ","أَكْثَرَهُمْ","لَا","يَعْلَمُونَ"],"marked":[3],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-9-26-12","words":["verb:adhdhaba"],"options":[{"bs":"i kaznio je","en":"and he/it punished"},{"bs":"pa ih kažnjavam","en":"so I punish them"},{"bs":"kažnjava","en":"he/it punishes"},{"bs":"kažnjava ih","en":"he/it punishes them"}],"ref":"9:26","answerWord":"وَعَذَّبَ","answerSound":"audio/7e66854ef4a34b29ec6c.m4a","quranTranslation":{"text":"Then Allah sent His peace of reassurance down upon His messenger and upon the believers, and sent down hosts ye could not see, and punished those who disbelieved. Such is the reward of disbelievers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["ثُمَّ","أَنزَلَ","ٱللَّهُ","سَكِينَتَهُۥ","عَلَىٰ","رَسُولِهِۦ","وَعَلَى","ٱلْمُؤْمِنِينَ","وَأَنزَلَ","جُنُودًا","لَّمْ","تَرَوْهَا","وَعَذَّبَ","ٱلَّذِينَ","كَفَرُوا۟","وَذَٰلِكَ","جَزَآءُ","ٱلْكَٰفِرِينَ"],"marked":[12],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-9-55-8","words":["verb:adhdhaba"],"options":[{"bs":"da ih kazni","en":"so that he/it may punish them"},{"bs":"kažnjava nas","en":"he/it punishes us"},{"bs":"kažnjavam ga","en":"I punish him"},{"bs":"kažnjava","en":"he/it punishes"}],"ref":"9:55","answerWord":"لِيُعَذِّبَهُم","answerSound":"audio/bbad788b89d5cb61dc45.m4a","quranTranslation":{"text":"So let not their riches nor their children please thee (O Muhammad). Allah thereby intendeth but to punish them in the life of the world and that their souls shall pass away while they are disbelievers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["فَلَا","تُعْجِبْكَ","أَمْوَٰلُهُمْ","وَلَآ","أَوْلَٰدُهُمْ","إِنَّمَا","يُرِيدُ","ٱللَّهُ","لِيُعَذِّبَهُم","بِهَا","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","وَتَزْهَقَ","أَنفُسُهُمْ","وَهُمْ","كَٰفِرُونَ"],"marked":[8],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-9-66-11","words":["verb:adhdhaba"],"options":[{"bs":"kažnjavamo","en":"we punish"},{"bs":"kažnjava ih","en":"he/it punishes them"},{"bs":"i kažnjava","en":"and he/it punishes"},{"bs":"pa ga kažnjava","en":"so he/it punishes him"}],"ref":"9:66","answerWord":"نُعَذِّبْ","answerSound":"audio/fdff92b035bab362433e.m4a","quranTranslation":{"text":"Make no excuse. Ye have disbelieved after your (confession of) belief. If We forgive a party of you, a party of you We shall punish because they have been guilty.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["لَا","تَعْتَذِرُوا۟","قَدْ","كَفَرْتُم","بَعْدَ","إِيمَٰنِكُمْ","إِن","نَّعْفُ","عَن","طَآئِفَةٍ","مِّنكُمْ","نُعَذِّبْ","طَآئِفَةًۢ","بِأَنَّهُمْ","كَانُوا۟","مُجْرِمِينَ"],"marked":[11],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-9-85-8","words":["verb:adhdhaba"],"options":[{"bs":"kažnjava ih","en":"he/it punishes them"},{"bs":"i kaznio je","en":"and he/it punished"},{"bs":"i kaznili smo ga","en":"and we punished it"},{"bs":"kažnjava ga","en":"he/it punishes him"}],"ref":"9:85","answerWord":"يُعَذِّبَهُم","answerSound":"audio/f8cc3826bc2552c85052.m4a","quranTranslation":{"text":"Let not their wealth nor their children please thee! Allah purposeth only to punish them thereby in the world, and that their souls shall pass away while they are disbelievers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["وَلَا","تُعْجِبْكَ","أَمْوَٰلُهُمْ","وَأَوْلَٰدُهُمْ","إِنَّمَا","يُرِيدُ","ٱللَّهُ","أَن","يُعَذِّبَهُم","بِهَا","فِى","ٱلدُّنْيَا","وَتَزْهَقَ","أَنفُسُهُمْ","وَهُمْ","كَٰفِرُونَ"],"marked":[8],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-9-101-15","words":["verb:adhdhaba"],"options":[{"bs":"kaznit ćemo ih","en":"we will punish them"},{"bs":"pa ih kažnjava","en":"so he/it punishes them"},{"bs":"kažnjavam ga","en":"I punish him"},{"bs":"kažnjavamo","en":"we punish"}],"ref":"9:101","answerWord":"سَنُعَذِّبُهُم","answerSound":"audio/1a4372399d8fd6924547.m4a","quranTranslation":{"text":"And among those around you of the wandering Arabs there are hypocrites, and among the townspeople of Al-Madinah (there are some who) persist in hypocrisy whom thou (O Muhammad) knowest not. We, We know them, and We shall chastise them twice; then they will be relegated to a painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["وَمِمَّنْ","حَوْلَكُم","مِّنَ","ٱلْأَعْرَابِ","مُنَٰفِقُونَ","وَمِنْ","أَهْلِ","ٱلْمَدِينَةِ","مَرَدُوا۟","عَلَى","ٱلنِّفَاقِ","لَا","تَعْلَمُهُمْ","نَحْنُ","نَعْلَمُهُمْ","سَنُعَذِّبُهُم","مَّرَّتَيْنِ","ثُمَّ","يُرَدُّونَ","إِلَىٰ","عَذَابٍ","عَظِيمٍ"],"marked":[15],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-9-106-5","words":["verb:adhdhaba"],"options":[{"bs":"kažnjava ih","en":"he/it punishes them"},{"bs":"i kaznio je","en":"and he/it punished"},{"bs":"pa ga kažnjava","en":"so he/it punishes him"},{"bs":"kažnjavam ga","en":"I punish him"}],"ref":"9:106","answerWord":"يُعَذِّبُهُمْ","answerSound":"audio/80e1ff4baaa2f11c549d.m4a","quranTranslation":{"text":"And (there are) others who await Allah's decree, whether He will punish them or will forgive them. Allah is Knower, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["وَءَاخَرُونَ","مُرْجَوْنَ","لِأَمْرِ","ٱللَّهِ","إِمَّا","يُعَذِّبُهُمْ","وَإِمَّا","يَتُوبُ","عَلَيْهِمْ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"marked":[5],"facts":{"verb":"عَذَّبَ"}},{"id":"adhdhaba-18-87-5","words":["verb:adhdhaba"],"options":[{"bs":"kažnjavamo ga","en":"we punish him"},{"bs":"kažnjava nas","en":"he/it punishes us"},{"bs":"kažnjava ih","en":"he/it punishes them"},{"bs":"i kažnjava","en":"and he/it punishes"}],"ref":"18:87","answerWord":"نُعَذِّبُهُۥ","answerSound":"audio/d33e6fcc3e7256922342.m4a","quranTranslation":{"text":"He said: As for him who doeth wrong, we shall punish him, and then he will be brought back unto his Lord, Who will punish him with awful punishment!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"kazniti, mučiti","en":"to punish, to torment"},"passage":["قَالَ","أَمَّا","مَن","ظَلَمَ","فَسَوْفَ","نُعَذِّبُهُۥ","ثُمَّ","يُرَدُّ","إِلَىٰ","رَبِّهِۦ","فَيُعَذِّبُهُۥ","عَذَابًا","نُّكْرًا"],"marked":[5],"facts":{"verb":"عَذَّبَ"}}]