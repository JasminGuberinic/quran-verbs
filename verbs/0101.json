{"rank": 101, "root": "موت", "form": 1, "lemma": "ماتَ", "count": 39, "ayahCount": 38, "share": 0.2, "meaning": {"bs": "umrijeti", "en": "to die", "tr": "ölmek", "fr": "mourir", "id": "mati", "ur": "مرنا", "bn": "মারা যাওয়া", "fa": "مردن"}, "lemmaSpoken": "audio/f29a840be5349f70d9d4.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "مَّاتَ", "plain": "مَاتَ", "quran": true, "notUsed": false, "spoken": "audio/f29a840be5349f70d9d4.m4a", "recited": "audio/ebf35b2d64beb85b64e6.m4a", "recitedText": "مَّاتَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَمُوتُ", "plain": "يَمُوتُ", "quran": true, "notUsed": false, "spoken": "audio/2de2c44fc5d414b4bcae.m4a", "recited": "audio/0d63b367e56cdae34d34.m4a", "recitedText": "يَمُوتُ"}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "مِتُّ", "plain": "مِتُّ", "quran": true, "notUsed": false, "spoken": "audio/c4c2b7d413290afe1c2c.m4a", "recited": "audio/cb638d5db2c45715d7ce.m4a", "recitedText": "مِتُّ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "مِتْنَا", "plain": "مِتْنَا", "quran": false, "notUsed": false, "spoken": "audio/c3bc4bc9edcba446ccdd.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "مِّتَّ", "plain": "مِتَّ", "quran": true, "notUsed": false, "spoken": "audio/94bafeffe3414d0e10cb.m4a", "recited": "audio/86524046d4c1ecde7c56.m4a", "recitedText": "مِّتَّ"}, {"tense": "past", "pronoun": "anti", "arabic": "مِتِّ", "plain": "مِتِّ", "quran": false, "notUsed": false, "spoken": "audio/0ac867ffe30618f9ff30.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "مِتُّمَا", "plain": "مِتُّمَا", "quran": false, "notUsed": false, "spoken": "audio/19ded20d3af9ebd6934b.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "مُتُّمْ", "plain": "مِتُّمْ", "quran": true, "notUsed": false, "spoken": "audio/b4ecedf7698e9b116ba6.m4a", "recited": "audio/87ba818669f82a2