": false, "spoken": "audio/9b072f303db33b3bffe7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "خَوِّفَا", "plain": "خَوِّفَا", "quran": false, "notUsed": false, "spoken": "audio/ad9da840017dd0fa2e94.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "خَوِّفُوا", "plain": "خَوِّفُوا", "quran": false, "notUsed": false, "spoken": "audio/b66227bfa27042270800.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "خَوِّفْنَ", "plain": "خَوِّفْنَ", "quran": false, "notUsed": false, "spoken": "audio/633724797aaac62e8b92.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "3:175", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/468.mp3", "translation": {"en": {"text": "It is only the devil who would make (men) fear his partisans. Fear them not; fear Me, if ye are true believers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Size o haberi getiren) ancak şeytandır, (sadece) kendi dostlarını korkutabilir. Onlardan korkmayın, eğer mümin iseniz benden korkun.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ تو شیطان ہی ہے کہ اپنے دوستوں سے دھمکاتا ہے تو ان سے نہ ڈرو اور مجھ سے ڈرو اگر ایمان رکھتے ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya mereka itu tidak lain hanyalah syaitan yang menakut-nakuti (kamu) dengan kawan-kawannya (orang-orang musyrik Quraisy), karena itu janganlah kamu takut kepada mereka, tetapi takutlah kepada-Ku, jika kamu benar-benar orang yang beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "ذَٰلِكُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلشَّيْطَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "يُخَوِّفُ", "hit": true, "audio": "audio/ec85e26b8ee551d2dc44.m4a", "gloss": {"bs": "plaši", "en": "frightens", "tr": "korkutuyor", "fr": "effraie", "id": "menakut-nakuti", "ur": "ڈراتا ہے", "bn": "সে ভয় দেখায়", "fa": "می‌ترساند"}}, {"text": "أَوْلِيَآءَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَخَافُوهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَخَافُونِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّؤْمِنِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُخَوِّفُ", "count": 2, "first": "3:175", "audio": "audio/ec85e26b8ee551d2dc44.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "plaši", "en": "frightens", "tr": "korkutur", "fr": "il effraie", "id": "dia menakut-nakuti", "ur": "ڈراتا ہے", "bn": "ভীতি সঞ্চার করে", "fa": "می‌ترساند"}}, {"arabic": "وَنُخَوِّفُهُمْ", "count": 1, "first": "17:60", "audio": "audio/541d7daa16559659df7a.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"en": "and we frighten them", "bs": "i plašimo ih", "tr": "ve onları korkutuyoruz", "fr": "et nous les effrayons", "id": "dan kami menakut-nakuti mereka", "ur": "اور ہم انہیں ڈراتے ہیں", "bn": "এবং আমরা তাদের ভীতি প্রদর্শন করি", "fa": "و آنان را می‌ترسانیم"}}, {"arabic": "وَيُخَوِّفُونَكَ", "count": 1, "first": "39:36", "audio": "audio/0896c7055cdaec60337f.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["anta"], "mood": "indicative"}], "gloss": {"en": "and they frighten you", "bs": "i plaše te", "tr": "ve sizi korkutuyorlar", "fr": "et ils t'effraient", "id": "dan mereka menakut-nakuti kamu", "ur": "اور وہ تمہیں ڈراتے ہیں", "bn": "এবং তারা তোমাদের ভীতি দেখায়", "fa": "و تو را می‌ترسانند"}}], "ayatFile": "ayat/0527.json", "ayatTranslations": {"en": "ayat/0527.en.json", "tr": "ayat/0527.tr.json", "ur": "ayat/0527.ur.json", "id": "ayat/0527.id.json"}, "sentences": [{"arabic": "يُخَوِّفُ الرَّعْدُ الطِّفْلَ", "spoken": "audio/94cd24c0ccc7d68e495d.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Grmljavina plaši dijete.", "en": "The thunder frightens the child.", "bn": "বজ্রধ্বনি শিশুটিকে ভয় দেখায়।", "fa": "رعد کودک را می‌ترساند.", "fr": "Le tonnerre effraie l'enfant.", "id": "Guntur itu menakut-nakuti anak itu.", "tr": "Gök gürültüsü çocuğu korkutur.", "ur": "گرج بچے کو ڈراتی ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يُخَوِّفُ", "target": true, "translation": {"bs": "plaši", "en": "frightens", "bn": "ভয় দেখায়", "fa": "می‌ترساند", "fr": "effraie", "id": "ia menakut-nakuti", "tr": "korkutur", "ur": "ڈراتا ہے"}}, {"arabic": "الرَّعْدُ", "target": false, "translation": {"bs": "grmljavina", "en": "the thunder", "bn": "বজ্রধ্বনি", "fa": "رعد", "fr": "le tonnerre", "id": "guntur itu", "tr": "gök gürültüsü", "ur": "گرج"}}, {"arabic": "الطِّفْلَ", "target": false, "translation": {"bs": "dijete", "en": "the child", "bn": "শিশুটি", "fa": "کودک", "fr": "l'enfant", "id": "anak itu", "tr": "çocuk", "ur": "بچہ"}}]}]}