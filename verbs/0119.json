{"rank": 119, "root": "عرض", "form": 4, "lemma": "أَعْرَضَ", "count": 32, "ayahCount": 30, "share": 0.17, "meaning": {"bs": "okrenuti se, odvratiti se", "en": "to turn away", "tr": "yüz çevirmek", "fr": "se détourner", "id": "berpaling", "ur": "منہ پھیرنا، اعراض کرنا", "bn": "মুখ ফিরিয়ে নেওয়া", "fa": "روی گرداندن"}, "lemmaSpoken": "audio/c33b5c8c2741b6b93664.m4a", "animation": "<svg class=\"va va-arada_4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes arada_4-t{from{transform:scaleX(1)}}@keyframes arada_4-c{from{transform:rotate(0)}}.va-arada_4 .a .fig{transform:scaleX(-1);animation:arada_4-t .5s ease-in-out .8s both}.va-arada_4 .b .ra{transform:rotate(-90deg)}.va-arada_4 .a .la{transform:rotate(-55deg);animation:arada_4-c .5s ease-out 1.3s both}.va-arada_4 .a .ra{transform:rotate(-40deg);animation:arada_4-c .5s ease-out 1.3s both}.va-arada_4 .a .tr{transform:rotate(-6deg)}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-arada_4.off,.va-arada_4.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-arada_4,.va-arada_4 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><g class=\"a\"><g transform=\"translate(40 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></g><g class=\"b\" transform=\"matrix(-1 0 0 1 120 0)\"><g transform=\"translate(34 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><circle class=\"q\" cy=\"17\" r=\"3.6\"/><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَعْرَضَ", "plain": "أَعْرَضَ", "quran": true, "notUsed": false, "spoken": "audio/c33b5c8c2741b6b93664.m4a", "recited": "audio/9f5758376dddd58e7027.m4a", "recitedText": "أَعْرَضَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُعْرِضُ", "plain": "يُعْرِضُ", "quran": false, "notUsed": false, "spoken": "audio/b6c6be2e7d4db622a22c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَعْرِضْ", "plain": "أَعْرِضْ", "quran": true, "notUsed": false, "spoken": "audio/db999a3e2b18ea375d22.m4a", "recited": "audio/a287f5f2cd15175c391b.m4a", "recitedText": "أَعْرِضْ"}], "nouns": {"participle": {"lemma": "مُعْرِض", "count": 19, "spoken": "audio/37faa8500556e2cfacc5.m4a"}, "verbal_noun": {"lemma": "إِعْراض", "count": 2, "spoken": "audio/da0d336ba68b97de42b8.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَعْرَضْتُ", "plain": "أَعْرَضْتُ", "quran": false, "notUsed": false, "spoken": "audio/27dcd7c3e67958d84ab1.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَعْرَضْنَا", "plain": "أَعْرَضْنَا", "quran": false, "notUsed": false, "spoken": "audio/c3fe84669737858efa70.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "أَعْرَضْتَ", "plain": "أَعْرَضْتَ", "quran": false, "notUsed": false, "spoken": "audio/9a2939f2a294bde90994.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "أَعْرَضْتِ", "plain": "أَعْرَضْتِ", "quran": false, "notUsed": false, "spoken": "audio/734858a632b7a03366f3.m4a", "recited": null, "r