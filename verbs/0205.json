hit": false, "audio": null, "gloss": null}, {"text": "تَقُومُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّاعَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَئِذٍ", "hit": false, "audio": null, "gloss": null}, {"text": "يَخْسَرُ", "hit": true, "audio": "audio/b6908bdc004995295d59.m4a", "gloss": {"bs": "će izgubiti", "en": "will lose", "tr": "kaybedecek", "fr": "perdra", "id": "akan merugi", "ur": "گھاٹے میں رہے گا", "bn": "ক্ষতিগ্রস্ত হবে", "fa": "زیان خواهد دید"}}, {"text": "ٱلْمُبْطِلُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "خَسِرُوٓا۟", "count": 8, "first": "6:12", "audio": "audio/10a6ca1805c2af083ffa.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "izgubili su", "en": "they lost", "tr": "kaybettiler", "fr": "ils ont perdu", "id": "mereka merugi", "ur": "وہ گھاٹے میں رہے", "bn": "তারা ক্ষতিগ্রস্ত হয়েছে", "fa": "زیان دیدند"}}, {"arabic": "خَسِرَ", "count": 5, "first": "4:119", "audio": "audio/1e68d398b25c9cca2716.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it lost", "bs": "izgubio je", "tr": "kaybetti", "fr": "il a perdu", "id": "dia telah kehilangan", "ur": "وہ گم ہوا", "bn": "সে হারাল", "fa": "گم کرد"}}, {"arabic": "وَخَسِرَ", "count": 2, "first": "40:78", "audio": "audio/7c8a8f4b33dc3d9fa399.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it lost", "bs": "i izgubio je", "tr": "ve kaybetti", "fr": "et il a perdu", "id": "dan dia telah kehilangan", "ur": "اور وہ گم ہوا", "bn": "এবং সে হারাল", "fa": "و گم کرد"}}, {"arabic": "يَخْسَرُ", "count": 1, "first": "45:27", "audio": "audio/b6908bdc004995295d59.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "će izgubiti", "en": "will lose", "tr": "kaybedecek", "fr": "perdra", "id": "akan merugi", "ur": "گھاٹے میں رہے گا", "bn": "ক্ষতিগ্রস্ত হবে", "fa": "زیان خواهد دید"}}], "ayatFile": "ayat/0205.json", "ayatTranslations": {"en": "ayat/0205.en.json", "tr": "ayat/0205.tr.json", "ur": "ayat/0205.ur.json", "id": "ayat/0205.id.json"}, "sentences": [{"arabic": "خَسِرَ الْفَرِيقُ الْمُبَارَاةَ", "spoken": "audio/a042bcaef0adf648d609.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Tim je izgubio utakmicu.", "en": "The team lost the match.", "bn": "দলটি ম্যাচ হারল।", "fa": "تیم مسابقه را باخت.", "fr": "L'équipe a perdu le match.", "id": "Tim itu kalah dalam pertandingan.", "tr": "Takım maçı kaybetti.", "ur": "ٹیم میچ ہار گئی۔"}, "independentlyReviewed": true, "words": [{"arabic": "خَسِرَ", "target": true, "translation": {"bs": "izgubio je", "en": "lost", "bn": "হারল", "fa": "باخت", "fr": "a perdu", "id": "kalah", "tr": "kaybetti", "ur": "وہ ہار گیا"}}, {"arabic": "الْفَرِيقُ", "target": false, "translation": {"bs": "tim", "en": "the team", "bn": "দল", "fa": "تیم", "fr": "l'équipe", "id": "tim itu", "tr": "takım", "ur": "ٹیم"}}, {"arabic": "الْمُبَارَاةَ", "target": false, "translation": {"bs": "utakmicu", "en": "the match", "bn": "ম্যাচ", "fa": "مسابقه", "fr": "le match", "id": "pertandingan", "tr": "maç", "ur": "میچ"}}]}, {"arabic": "يَخْسَرُ التَّاجِرُ مَالًا كَثِيرًا", "spoken": "audio/2894c5614d125042c5d9.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Trgovac gubi mnogo novca.", "en": "The merchant loses a lot of money.", "bn": "ব্যবসায়ী অনেক অর্থ হারায়।", "fa": "تاجر پول زیادی از دست می‌دهد.", "fr": "Le commerçant perd beaucoup d'argent.", "id": "Pedagang itu merugi banyak uang.", "tr": "Tüccar çok para kaybeder.", "ur": "تاجر بہت سا پیسہ گنوا دیتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَخْسَرُ", "target": true, "translation": {"bs": "gubi", "en": "loses", "bn": "হারে", "fa": "از دست می‌دهد", "fr": "perd", "id": "kalah", "tr": "kaybeder", "ur": "وہ ہارتا ہے"}}, {"arabic": "التَّاجِرُ", "tar