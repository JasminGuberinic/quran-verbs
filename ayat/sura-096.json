{"ayat":[{"ref":"96:1","number":6107,"text":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","hits":[0,1,2,3,4]},{"ref":"96:2","number":6108,"text":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","hits":[1,2]},{"ref":"96:3","number":6109,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","hits":[]},{"ref":"96:4","number":6110,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","hits":[1,2]},{"ref":"96:5","number":6111,"text":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","hits":[2,3,4]},{"ref":"96:6","number":6112,"text":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","hits":[0,1,3]},{"ref":"96:7","number":6113,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","hits":[0,1,2]},{"ref":"96:8","number":6114,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","hits":[1]},{"ref":"96:9","number":6115,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","hits":[2]},{"ref":"96:10","number":6116,"text":"عَبْدًا إِذَا صَلَّىٰٓ","hits":[0,1,2]},{"ref":"96:11","number":6117,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","hits":[1,2,3,4]},{"ref":"96:12","number":6118,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","hits":[0,1,2]},{"ref":"96:13","number":6119,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","hits":[2,3]},{"ref":"96:14","number":6120,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","hits":[2]},{"ref":"96:15","number":6121,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","hits":[3]},{"ref":"96:16","number":6122,"text":"نَاصِيَةٍ كَٰذِبَةٍ خَاطِئَةٍ","hits":[1]},{"ref":"96:17","number":6123,"text":"فَلْيَدْعُ نَادِيَهُۥ","hits":[0]},{"ref":"96:18","number":6124,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ","hits":[]},{"ref":"96:19","number":6125,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب","hits":[1,2,3,4]}]}