[{"id":"kafa-33-3-3","words":["verb:kafa"],"options":[{"bs":"i bio je dovoljan","en":"and he/it sufficed"},{"bs":"dovoljni smo ti","en":"We suffice you"},{"bs":"dovoljan vam je","en":"he/it suffices you (all)"},{"bs":"dovoljan im je","en":"he/it suffices them"}],"ref":"33:3","answerWord":"وَكَفَىٰ","answerSound":"audio/819fb56a4945a8d060ad.m4a","quranTranslation":{"text":"And put thy trust in Allah, for Allah is sufficient as Trustee.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti dovoljan","en":"to suffice"},"passage":["وَتَوَكَّلْ","عَلَى","ٱللَّهِ","وَكَفَىٰ","بِٱللَّهِ","وَكِيلًا"],"marked":[3],"facts":{"verb":"كَفَى"}},{"id":"kafa-13-43-6","words":["verb:kafa"],"options":[{"bs":"bio je dovoljan","en":"he/it sufficed"},{"bs":"dovoljni smo ti","en":"We suffice you"},{"bs":"dovoljan im je","en":"he/it suffices them"},{"bs":"dovoljan je","en":"he/it suffices"}],"ref":"13:43","answerWord":"كَفَىٰ","answerSound":"audio/8fd7174075ab236c48d2.m4a","quranTranslation":{"text":"They who disbelieve say: Thou art no messenger (of Allah). Say: Allah, and whosoever hath knowledge of the Scripture, is sufficient witness between me and you.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti dovoljan","en":"to suffice"},"passage":["وَيَقُولُ","ٱلَّذِينَ","كَفَرُوا۟","لَسْتَ","مُرْسَلًا","قُلْ","كَفَىٰ","بِٱللَّهِ","شَهِيدًۢا","بَيْنِى","وَبَيْنَكُمْ","وَمَنْ","عِندَهُۥ","عِلْمُ","ٱلْكِتَٰبِ"],"marked":[6],"facts":{"verb":"كَفَى"}},{"id":"kafa-3-124-4","words":["verb:kafa"],"options":[{"bs":"dovoljan vam je","en":"he/it suffices you (all)"},{"bs":"dovoljni smo ti","en":"We suffice you"},{"bs":"bio je dovoljan","en":"he/it sufficed"},{"bs":"dovoljan je","en":"he/it suffices"}],"ref":"3:124","answerWord":"يَكْفِيَكُمْ","answerSound":"audio/6c84772ee0da702ce4bc.m4a","quranTranslation":{"text":"When thou didst say unto the believers: Is it not sufficient for you that your Lord should support you with three thousand angels sent down (to your help)?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti dovoljan","en":"to suffice"},"passage":["إِذْ","تَقُولُ","لِلْمُؤْمِنِينَ","أَلَن","يَكْفِيَكُمْ","أَن","يُمِدَّكُمْ","رَبُّكُم","بِثَلَٰثَةِ","ءَالَٰفٍ","مِّنَ","ٱلْمَلَٰٓئِكَةِ","مُنزَلِينَ"],"marked":[4],"facts":{"verb":"كَفَى"}},{"id":"kafa-10-29-0","words":["verb:kafa"],"options":[{"bs":"pa je bio dovoljan","en":"so he/it sufficed"},{"bs":"dovoljan im je","en":"he/it suffices them"},{"bs":"dovoljni smo ti","en":"We suffice you"},{"bs":"dovoljan je","en":"he/it suffices"}],"ref":"10:29","answerWord":"فَكَفَىٰ","answerSound":"audio/d8b3150122069426f4a3.m4a","quranTranslation":{"text":"Allah sufficeth as a witness between us and you, that we were unaware of your worship.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti dovoljan","en":"to suffice"},"passage":["فَكَفَىٰ","بِٱللَّهِ","شَهِيدًۢا","بَيْنَنَا","وَبَيْنَكُمْ","إِن","كُنَّا","عَنْ","عِبَادَتِكُمْ","لَغَٰفِلِينَ"],"marked":[0],"facts":{"verb":"كَفَى"}},{"id":"kafa-15-95-1","words":["verb:kafa"],"options":[{"bs":"dovoljni smo ti","en":"We suffice you"},{"bs":"dovoljan vam je","en":"he/it suffices you (all)"},{"bs":"i bio je dovoljan","en":"and he/it sufficed"},{"bs":"dovoljan je","en":"he/it suffices"}],"ref":"15:95","answerWord":"كَفَيْنَٰكَ","answerSound":"audio/ff78d6602e2faa2b48da.m4a","quranTranslation":{"text":"Lo! We defend thee from the scoffers,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti dovoljan","en":"to suffice"},"passage":["إِنَّا","كَفَيْنَٰكَ","ٱلْمُسْتَهْزِءِينَ"],"marked":[1],"facts":{"verb":"كَفَى"}},{"id":"kafa-29-51-1","words":["verb:kafa"],"options":[{"bs":"dovoljan im je","en":"he/it suffices them"},{"bs":"i bio je dovoljan","en":"and he/it sufficed"},{"bs":"dovoljan je","en":"he/it suffices"},{"bs":"dovoljni smo ti","en":"We suffice you"}],"ref":"29:51","answerWord":"يَكْفِهِمْ","answerSound":"audio/154c0e8e2d9f4110509b.m4a","quranTranslation":{"text":"Is it not enough for them that We have sent down unto thee the Scripture which is read unto them? Lo! herein verily is mercy, and a reminder for folk who believe.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti dovoljan","en":"to suffice"},"passage":["أَوَلَمْ","يَكْفِهِمْ","أَنَّآ","أَنزَلْنَا","عَلَيْكَ","ٱلْكِتَٰبَ","يُتْلَىٰ","عَلَيْهِمْ","إِنَّ","فِى","ذَٰلِكَ","لَرَحْمَةً","وَذِكْرَىٰ","لِقَوْمٍ","يُؤْمِنُونَ"],"marked":[1],"facts":{"verb":"كَفَى"}},{"id":"kafa-33-25-8","words":["verb:kafa"],"options":[{"bs":"i bio je dovoljan","en":"and he/it sufficed"},{"bs":"dovoljan im je","en":"he/it suffices them"},{"bs":"dovoljan vam je","en":"he/it suffices you (all)"},{"bs":"dovoljni smo ti","en":"We suffice you"}],"ref":"33:25","answerWord":"وَكَفَى","answerSound":"audio/0969cbf63101b0a5c300.m4a","quranTranslation":{"text":"And Allah repulsed the disbelievers in their wrath; they gained no good. Allah averted their attack from the believers. Allah is ever Strong, Mighty.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti dovoljan","en":"to suffice"},"passage":["وَرَدَّ","ٱللَّهُ","ٱلَّذِينَ","كَفَرُوا۟","بِغَيْظِهِمْ","لَمْ","يَنَالُوا۟","خَيْرًا","وَكَفَى","ٱللَّهُ","ٱلْمُؤْمِنِينَ","ٱلْقِتَالَ","وَكَانَ","ٱللَّهُ","قَوِيًّا","عَزِيزًا"],"marked":[8],"facts":{"verb":"كَفَى"}},{"id":"kafa-41-53-12","words":["verb:kafa"],"options":[{"bs":"dovoljan je","en":"he/it suffices"},{"bs":"i bio je dovoljan","en":"and he/it sufficed"},{"bs":"dovoljni smo ti","en":"We suffice you"},{"bs":"dovoljan im je","en":"he/it suffices them"}],"ref":"41:53","answerWord":"يَكْفِ","answerSound":"audio/fb48652732a99afb016a.m4a","quranTranslation":{"text":"We shall show them Our portents on the horizons and within themselves until it will be manifest unto them that it is the Truth. Doth not thy Lord suffice, since He is Witness over all things?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti dovoljan","en":"to suffice"},"passage":["سَنُرِيهِمْ","ءَايَٰتِنَا","فِى","ٱلْءَافَاقِ","وَفِىٓ","أَنفُسِهِمْ","حَتَّىٰ","يَتَبَيَّنَ","لَهُمْ","أَنَّهُ","ٱلْحَقُّ","أَوَلَمْ","يَكْفِ","بِرَبِّكَ","أَنَّهُۥ","عَلَىٰ","كُلِّ","شَىْءٍ","شَهِيدٌ"],"marked":[12],"facts":{"verb":"كَفَى"}}]