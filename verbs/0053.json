ent.", "id": "Istrinya memperoleh uang.", "tr": "Karısı para kazandı.", "ur": "اس کی بیوی نے مال کمایا۔"}, "independentlyReviewed": true, "words": [{"arabic": "كَسَبَتْ", "target": true, "translation": {"bs": "zaradila je", "en": "earned, gained", "bn": "উপার্জন করল", "fa": "به دست آورد", "fr": "a gagné", "id": "memperoleh, mendapatkan", "tr": "kazandılar", "ur": "اس نے کمایا"}}, {"arabic": "زَوْجَتُهُ", "target": false, "translation": {"bs": "njegova žena", "en": "his wife", "bn": "তার স্ত্রী", "fa": "همسرش", "fr": "sa femme", "id": "istrinya", "tr": "karısı", "ur": "اس کی بیوی"}}, {"arabic": "مَالًا", "target": false, "translation": {"bs": "novac", "en": "money", "bn": "টাকা", "fa": "مال", "fr": "de l'argent", "id": "uang", "tr": "para", "ur": "مال"}}]}, {"arabic": "يَكْسِبُونَ رِزْقَهُمْ", "spoken": "audio/b51ac7f0c9a67f7186b7.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Zarađuju za život.", "en": "They earn their livelihood.", "bn": "তারা তাদের জীবিকা উপার্জন করে।", "fa": "روزی خود را به دست می‌آورند.", "fr": "Ils gagnent leur subsistance.", "id": "Mereka mencari nafkah mereka.", "tr": "Geçimlerini kazanıyorlar.", "ur": "وہ اپنی روزی کماتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَكْسِبُونَ", "target": true, "translation": {"bs": "zarađuju", "en": "earn, gain", "bn": "উপার্জন করো", "fa": "به دست می‌آورند", "fr": "gagnent", "id": "peroleh, dapatkan", "tr": "kazanıyorlar", "ur": "وہ کماتے ہیں"}}, {"arabic": "رِزْقَهُمْ", "target": false, "translation": {"bs": "za život", "en": "their livelihood", "bn": "তাদের জীবিকা", "fa": "روزی‌شان", "fr": "leur subsistance", "id": "nafkah mereka", "tr": "geçimlerini", "ur": "ان کی روزی"}}]}]}