ken": "audio/a87c75742ad4eb19c8ba.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِضْرِبَا", "plain": "اِضْرِبَا", "quran": false, "notUsed": false, "spoken": "audio/e8ef2fc6d49e8f772fe7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱضْرِبُوا۟", "plain": "اِضْرِبُوا", "quran": true, "notUsed": false, "spoken": "audio/a7ba2f1a6e8bed69950a.m4a", "recited": "audio/95498e7efa669814e613.m4a", "recitedText": "فَٱضْرِبُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِضْرِبْنَ", "plain": "اِضْرِبْنَ", "quran": false, "notUsed": false, "spoken": "audio/1d25149a7c54807bf5d9.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "36:78", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3783.mp3", "translation": {"en": {"text": "And he hath coined for Us a similitude, and hath forgotten the fact of his creation, saying: Who will revive these bones when they have rotted away?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yaratılışını unutarak bize bir de mesel fırlattı: \"Kim diriltecekmiş o çürümüş kemikleri?\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہمارے لیے کہاوت کہتا ہے اور اپنی پیدائش بھول گیا بولا ایسا کون ہے کہ ہڈیوں کو زندہ کرے جب وہ بالکل گل گئیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan ia membuat perumpamaan bagi Kami; dan dia lupa kepada kejadiannya; ia berkata: \"Siapakah yang dapat menghidupkan tulang belulang, yang telah hancur luluh?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَضَرَبَ", "hit": true, "audio": "audio/a6d3e14419bbc8ab2099.m4a", "gloss": {"en": "and he/it set forth", "bs": "i naveo je", "tr": "ve ileri sürdü", "fr": "et il a exposé", "id": "dan dia telah memberangkatkan", "ur": "اور اُس نے بیان کیا", "bn": "এবং সে বর্ণনা করল", "fa": "و بیان کرد"}}, {"text": "لَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَثَلًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَسِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلْقَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "يُحْىِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعِظَٰمَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَمِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:13", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3718.mp3", "translation": {"en": {"text": "Coin for them a similitude: The people of the city when those sent (from Allah) came unto them;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sen onlara, o şehir halkını örnek ver. Hani oraya peygamberler gelmişti.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان سے نشانیاں بیان کرو اس شہر والوں کی جب ان کے پاس فرستادے (رسول) آئے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan buatlah bagi mereka suatu perumpamaan, yaitu penduduk suatu negeri ketika utusan-utusan datang kepada mereka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱضْرِبْ", "hit": true, "audio": "audio/6a43358615ca8c6cbea0.m4a", "gloss": {"bs": "i navedi (primjer)!", "en": "and set forth (an example)!", "tr": "ve (misal) ver!", "fr": "et propose (un exemple) !", "id": "dan buatlah (perumpamaan)!", "ur": "اور بیان کرو (مثال)!", "bn": "এবং (উদাহরণ) পেশ করো!", "fa": "و (مَثَل) بزن!"}}, {"text": "لَهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّثَلًا", "hit": false, "audio": null, "gloss": null}, {"text": "أَصْحَٰبَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَرْيَةِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذْ", "hit": false, "audio": null, "gloss": null}, {"text": "جَآءَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُرْسَلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "14:25", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1775.mp3", "translation": {"en": {"text": "Giving its fruit at every season by permission of its Lord? Allah coineth the similitudes for mankind in order that they may reflect.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(O ağaç) Rabbinin izniyle her zaman meyve verir. Öğüt alsınlar diye Allah insanlara böyle misaller verir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہر وقت پھل دیتا ہے اپنے رب کے حکم سے اور اللہ لوگوں کے لیے مثالیں بیان فرماتا ہے کہ کہیں وہ سمجھیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "pohon itu memberikan buahnya pada setiap musim dengan seizin Tuhannya. Allah membuat perumpamaan-perumpamaan itu untuk manusia supaya mereka selalu ingat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "تُؤْتِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أُكُلَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُلَّ", "hit": false, "audio": null, "gloss": null}, {"text": "حِينٍۭ", "hit": false, "audio": null, "gloss": null}, {"text": "بِإِذْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَضْرِبُ", "hit": true, "audio": "audio/f20ae625e53e4c7f1bcf.m4a", "gloss": {"en": "and he/it sets forth", "bs": "i navodi", "tr": "ve ileri sürer", "fr": "et il conduit", "id": "dan dia memberangkatkan", "ur": "اور وہ بیان کرتا ہے", "bn": "এবং সে বর্ণনা করে", "fa": "و بیان می‌کند"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَمْثَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلنَّاسِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَذَكَّرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:11", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2151.mp3", "translation": {"en": {"text": "Then We sealed up their hearing in the Cave for a number of years.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine biz de kulaklarını tıkayarak mağarada onları yıllarca uyuttuk.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ہم نے اس غار میں ان کے کے کانوں پر گنتی کے کئی برس تھپکا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Kami tutup telinga mereka beberapa tahun dalam gua itu,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَضَرَبْنَا", "hit": true, "audio": "audio/e9b9385fc9e444f4f629.m4a", "gloss": {"bs": "pa smo im zatvorili (uši)", "en": "so We sealed (their ears)", "tr": "böylece (kulaklarına) perde vurduk", "fr": "alors Nous avons scellé (leurs oreilles)", "id": "maka Kami tutup (telinga mereka)", "ur": "پھر ہم نے (ان کے کانوں پر) پردہ ڈال دیا", "bn": "তখন আমরা (তাদের কানে) পর্দা ফেলে দিলাম", "fa": "پس (بر گوش‌هایشان) پرده زدیم"}}, {"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاذَانِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكَهْفِ", "hit": false, "audio": null, "gloss": null}, {"text": "سِنِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَدَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:73", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/80.mp3", "translation": {"en": {"text": "And We said: Smite him with some of it. Thus Allah bringeth the dead to life and showeth you His portents so that ye may understand.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte bundan dolayı, o sığırın bir parçası ile o ölüye vurun, dedik. Allah ölüleri işte böyle diriltir ve size âyetlerini gösterir, belki aklınızı başınıza toplarsınız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ہم نے فرمایا اس مقتول کو اس گائے کا ایک ٹکڑا مارو اللہ یونہی مرُدے جلائے گا۔ اور تمہیں اپنی نشانیاں دکھاتا ہے کہ کہیں تمہیں عقل ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Lalu Kami berfirman: \"Pukullah mayat itu dengan sebahagian anggota sapi betina itu!\" Demikianlah Allah menghidupkan kembali orang-orang yang telah mati, dam memperlihatkan padamu tanda-tanda kekuasaan-Nya agar kamu mengerti.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَقُلْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱضْرِبُوهُ", "hit": true, "audio": "audio/75d680753c99daf70042.m4a", "gloss": {"en": "(you all) strike him/it!", "bs": "udarite ga!", "tr": "ona vurun!", "fr": "frappez-le !", "id": "pukullah dia!", "ur": "اسے مارو!", "bn": "তোমরা তাকে আঘাত কর!", "fa": "او را بزنید!"}}, {"text": "بِبَعْضِهَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُحْىِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَوْتَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيُرِيكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْقِلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "47:27", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4572.mp3", "translation": {"en": {"text": "Then how (will it be with them) when the angels gather them, smiting their faces and their backs!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Melekler onların yüzlerine ve arkalarına vurarak canlarını alırken durumları nasıl olacak?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو کیسا ہوگا جب فرشتے ان کی روح قبض کریں گے ان کے منہ اور ان کی پیٹھیں مارتے ہوئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Bagaimanakah (keadaan mereka) apabila malaikat mencabut nyawa mereka seraya memukul-mukul muka mereka dan punggung mereka?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَكَيْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَوَفَّتْهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَلَٰٓئِكَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَضْرِبُونَ", "hit": true, "audio": "audio/919c621a56f156e9dd22.m4a", "gloss": {"bs": "udaraju", "en": "they strike", "tr": "vururlar", "fr": "ils frappent", "id": "mereka memukul", "ur": "وہ مارتے ہیں", "bn": "তারা আঘাত করে", "fa": "می‌زنند"}}, {"text": "وُجُوهَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَدْبَٰرَهُمْ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ضَرَبَ", "count": 6, "first": "14:24", "audio": "audio/e2bf64b3e09c680cdaa0.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it set forth", "bs": "naveo je", "tr": "ileri sürdü", "fr": "il a exposé ; il a conduit", "id": "dia telah memberangkatkan", "ur": "اُس نے بیان کیا", "bn": "সে বর্ণনা করল", "fa": "بیان کرد"}}, {"arabic": "وَضَرَبَ", "count": 4, "first": "16:76", "audio": "audio/2ab08d2a6e30e09c3632.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it set forth", "bs": "i naveo je", "tr": "ve ileri sürdü", "fr": "et il a exposé", "id": "dan dia telah memberangkatkan", "ur": "اور اُس نے بیان کیا", "bn": "এবং সে বর্ণনা করল", "fa": "و بیان کرد"}}, {"arabic": "ٱضْرِب", "count": 3, "first": "2:60", "audio": "audio/26d105957414aa1b786b.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "strike!", "bs": "udari!", "tr": "vur!", "fr": "frappe !", "id": "pukullah!", "ur": "مار!", "bn": "আঘাত কর!", "fa": "بزن!"}}, {"arabic": "ضَرَبُوا۟", "count": 3, "first": "3:156", "audio": "audio/d662cb93b29edd710a79.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they set forth; they travelled", "bs": "naveli su; putovali su", "tr": "ileri sürdüler; yolculuk ettiler", "fr": "ils ont conduit ; ils ont voyagé", "id": "mereka telah memberangkatkan; mereka telah bepergian", "ur": "انہوں نے سفر کیا", "bn": "তারা ভ্রমণ করল", "fa": "حرکت کردند؛ سفر کردند"}}, {"arabic": "ضَرَبْتُمْ", "count": 3, "first": "4:94", "audio": "audio/23cfbe4cdd267be15bfa.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) travelled", "bs": "putovali ste", "tr": "yolculuk ettiniz", "fr": "vous avez voyagé", "id": "kalian telah bepergian", "ur": "تم سب نے سفر کیا", "bn": "তোমরা ভ্রমণ করেছ", "fa": "سفر کردید"}}, {"arabic": "يَضْرِبُونَ", "count": 3, "first": "8:50", "audio": "audio/a4b594b6ac08974a8329.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "udaraju", "en": "they strike", "tr": "vururlar", "fr": "ils frappent", "id": "mereka memukul", "ur": "وہ مارتے ہیں", "bn": "তারা আঘাত করে", "fa": "می‌زنند"}}, {"arabic": "يَضْرِبُ", "count": 3, "first": "13:17", "audio": "audio/d3aeae7da6c268a870d3.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it sets forth", "bs": "navodi", "tr": "ileri sürer", "fr": "il conduit", "id": "dia memberangkatkan", "ur": "وہ بیان کرتا ہے", "bn": "সে বর্ণনা করে", "fa": "بیان می‌کند"}}, {"arabic": "وَٱضْرِبْ", "count": 3, "first": "18:32", "audio": "audio/5d2404c2e24b1226a4f0.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"bs": "i navedi (primjer)!", "en": "and set forth (an example)!", "tr": "ve (misal) ver!", "fr": "et propose (un exemple) !", "id": "dan buatlah (perumpamaan)!", "ur": "اور بیان کرو (مثال)!", "bn": "এবং (উদাহরণ) পেশ করো!", "fa": "و (مَثَل) بزن!"}}, {"arabic": "ضَرَبْنَا", "count": 3, "first": "25:39", "audio": "audio/fe2b16f5363aa2913dd0.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "we set forth", "bs": "naveli smo", "tr": "ileri sürdük", "fr": "nous avons conduit", "id": "kami telah memberangkatkan", "ur": "ہم بیان کرتے ہیں", "bn": "আমরা বর্ণনা করলাম", "fa": "بیان کردیم"}}, {"arabic": "وَضُرِبَتْ", "count": 2, "first": "2:61", "audio": "audio/874841ef14f63dcd5024.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": true, "objects": []}], "gloss": {"en": "and it was imposed", "bs": "i nametnuta je", "tr": "ve dayatıldı", "fr": "et elle a été imposée", "id": "dan telah dibebankan", "ur": "اور فرض کیا گیا", "bn": "এবং তা নির্ধারিত হলো", "fa": "و تحمیل شد"}}, {"arabic": "وَيَضْرِبُ", "count": 2, "first": "14:25", "audio": "audio/f20ae625e53e4c7f1bcf.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and he/it sets forth", "bs": "i navodi", "tr": "ve ileri sürer", "fr": "et il conduit", "id": "dan dia memberangkatkan", "ur": "اور وہ بیان کرتا ہے", "bn": "এবং সে বর্ণনা করে", "fa": "و بیان می‌کند"}}, {"arabic": "ضُرِبَ", "count": 2, "first": "22:73", "audio": "audio/1b26a054240ee95d1d7c.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "it was set forth", "bs": "navedeno je", "tr": "ileri sürüldü", "fr": "il a été conduit", "id": "telah diberangkatkan", "ur": "بیان کیا گیا", "bn": "তা বর্ণিত হয়েছে", "fa": "بیان شد"}}, {"arabic": "نَضْرِبُهَا", "count": 2, "first": "29:43", "audio": "audio/3a96177109301d7d93bd.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["hiya"], "mood": "indicative"}], "gloss": {"en": "we set them forth", "bs": "navodimo ih", "tr": "onları ileri sürüyoruz", "fr": "nous les conduisons", "id": "kami memberangkatkan mereka", "ur": "ہم ان کو بیان کرتے ہیں", "bn": "আমরা তাদের বর্ণনা করি", "fa": "آن‌ها را بیان می‌کنیم"}}, {"arabic": "يَضْرِبَ", "count": 1, "first": "2:26", "audio": "audio/ce3b231364e3971aa100.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "he/it sets forth", "bs": "navodi", "tr": "ileri sürer", "fr": "qu'il conduise", "id": "dia memberangkatkan", "ur": "وہ بیان کرتا ہے", "bn": "সে বর্ণনা করে", "fa": "بیان کند"}}, {"arabic": "ٱضْرِبُوهُ", "count": 1, "first": "2:73", "audio": "audio/75d680753c99daf70042.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "(you all) strike him/it!", "bs": "udarite ga!", "tr": "ona vurun!", "fr": "frappez-le !", "id": "pukullah dia!", "ur": "اسے مارو!", "bn": "তোমরা তাকে আঘাত কর!", "fa": "او را بزنید!"}}, {"arabic": "ضُرِبَتْ", "count": 1, "first": "3:112", "audio": "audio/cca176138c4f9f465c8a.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": true, "objects": []}], "gloss": {"en": "it was imposed", "bs": "nametnuta je", "tr": "dayatıldı", "fr": "elle a été imposée", "id": "telah dibebankan", "ur": "فرض کیا گیا", "bn": "তা নির্ধারিত হয়েছিল", "fa": "تحمیل شد"}}, {"arabic": "وَٱضْرِبُوهُنَّ", "count": 1, "first": "4:34", "audio": "audio/9cb924aa11f7d1e33ae4.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["hunna"]}], "gloss": {"en": "and (you all) strike them!", "bs": "i udarite ih!", "tr": "ve onlara vurun!", "fr": "et frappez-les !", "id": "dan pukullah mereka!", "ur": "اور انہیں مارو!", "bn": "এবং তোমরা তাদের আঘাত কর!", "fa": "و آنان را بزنید!"}}, {"arabic": "فَٱضْرِبُوا۟", "count": 1, "first": "8:12", "audio": "audio/95498e7efa669814e613.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) strike!", "bs": "pa udarite!", "tr": "böylece vurun!", "fr": "frappez donc !", "id": "maka pukullah!", "ur": "پس مار!", "bn": "অতএব তোমরা আঘাত কর!", "fa": "پس بزنید!"}}, {"arabic": "وَٱضْرِبُوا۟", "count": 1, "first": "8:12", "audio": "audio/eb316230d27b8cb055fb.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) strike!", "bs": "i udarite!", "tr": "ve vurun!", "fr": "et frappez !", "id": "dan pukullah!", "ur": "اور مار!", "bn": "এবং তোমরা আঘাত কর!", "fa": "و بزنید!"}}, {"arabic": "وَضَرَبْنَا", "count": 1, "first": "14:45", "audio": "audio/bbec1dba91e6c6ff32cf.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "and we set forth", "bs": "i naveli smo", "tr": "ve ileri sürdük", "fr": "et nous avons conduit", "id": "dan kami telah memberangkatkan", "ur": "اور ہم نے بیان کیا", "bn": "এবং আমরা বর্ণনা করলাম", "fa": "و بیان کردیم"}}, {"arabic": "تَضْرِبُوا۟", "count": 1, "first": "16:74", "audio": "audio/fef5c01e7f7cec647b88.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "you (all) set forth", "bs"