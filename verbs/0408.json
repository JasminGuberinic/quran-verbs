8d3.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "jussive"}], "gloss": {"en": "and he/it protects you (all)", "bs": "i štiti vas", "tr": "ve sizi korur", "fr": "et il vous protège", "id": "dan dia melindungi kalian", "ur": "اور وہ تم سب کی حفاظت کرتا ہے", "bn": "এবং সে তোমাদের রক্ষা করে", "fa": "و شما را حفاظت کند"}}, {"arabic": "يُجِيرَنِى", "count": 1, "first": "72:22", "audio": "audio/4d49c55720e479e5fa04.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["ana"], "mood": "subjunctive"}], "gloss": {"bs": "zaštititi me", "en": "(will) protect me", "tr": "beni koruyacak", "fr": "(va) me protéger", "id": "(akan) melindungiku", "ur": "(وہ) مجھے پناہ دے گا", "bn": "(সে) আমাকে আশ্রয় দেবে", "fa": "مرا پناه می‌دهد"}}], "ayatFile": "ayat/0408.json", "ayatTranslations": {"en": "ayat/0408.en.json", "tr": "ayat/0408.tr.json", "ur": "ayat/0408.ur.json", "id": "ayat/0408.id.json"}, "sentences": [{"arabic": "يُجِيرُ الْكَرِيمُ الْمَظْلُومَ", "spoken": "audio/7e0ea95df7972eeeec40.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Plemenit čovjek štiti potlačenog.", "en": "The generous man protects the oppressed.", "bn": "দানশীল লোক নির্যাতিত ব্যক্তিকে আশ্রয় দেয়।", "fa": "مرد بخشنده ستمدیده را پناه می‌دهد.", "fr": "L'homme généreux protège l'opprimé.", "id": "Orang dermawan itu melindungi orang yang dizalimi.", "tr": "Cömert adam mazlumu korur.", "ur": "سخی آدمی مظلوم کو پناہ دیتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يُجِيرُ", "target": true, "translation": {"bs": "štiti", "en": "protects", "bn": "আশ্রয় দেয়", "fa": "پناه می‌دهد", "fr": "protège", "id": "melindungi", "tr": "korur", "ur": "پناہ دیتا ہے"}}, {"arabic": "الْكَرِيمُ", "target": false, "translation": {"bs": "plemenit čovjek", "en": "the generous man", "bn": "দানশীল লোক", "fa": "مرد بخشنده", "fr": "l'homme généreux", "id": "orang dermawan itu", "tr": "cömert adam", "ur": "سخی آدمی"