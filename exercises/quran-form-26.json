[{"id":"razaqa-2-57-11","words":["verb:razaqa"],"options":[{"bs":"opskrbili smo vas","en":"we provided you (all)"},{"bs":"opskrbio vas je","en":"he/it provided you (all)"},{"bs":"i opskrbio me je","en":"and he/it provided me"},{"bs":"opskrbljuje je","en":"he/it provides it"}],"ref":"2:57","answerWord":"رَزَقْنَٰكُمْ","answerSound":"audio/f3a52b3d61c99d112b24.m4a","quranTranslation":{"text":"And We caused the white cloud to overshadow you and sent down on you the manna and the quails, (saying): Eat of the good things wherewith We have provided you - they wronged Us not, but they did wrong themselves.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَظَلَّلْنَا","عَلَيْكُمُ","ٱلْغَمَامَ","وَأَنزَلْنَا","عَلَيْكُمُ","ٱلْمَنَّ","وَٱلسَّلْوَىٰ","كُلُوا۟","مِن","طَيِّبَٰتِ","مَا","رَزَقْنَٰكُمْ","وَمَا","ظَلَمُونَا","وَلَٰكِن","كَانُوٓا۟","أَنفُسَهُمْ","يَظْلِمُونَ"],"marked":[11],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-5-88-2","words":["verb:razaqa"],"options":[{"bs":"opskrbio vas je","en":"he/it provided you (all)"},{"bs":"i opskrbili smo ih","en":"and we provided them"},{"bs":"opskrbili smo ga","en":"we provided him"},{"bs":"i opskrbite ih!","en":"and (you all) provide them!"}],"ref":"5:88","answerWord":"رَزَقَكُمُ","answerSound":"audio/5c3f20e3da9b17b26e27.m4a","quranTranslation":{"text":"Eat of that which Allah hath bestowed on you as food lawful and good, and keep your duty to Allah in Whom ye are believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَكُلُوا۟","مِمَّا","رَزَقَكُمُ","ٱللَّهُ","حَلَٰلًا","طَيِّبًا","وَٱتَّقُوا۟","ٱللَّهَ","ٱلَّذِىٓ","أَنتُم","بِهِۦ","مُؤْمِنُونَ"],"marked":[2],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-42-19-3","words":["verb:razaqa"],"options":[{"bs":"opskrbljuje","en":"He provides (for)"},{"bs":"zaista će ih opskrbiti","en":"surely he/it will provide them"},{"bs":"i opskrbili smo ih","en":"and we provided them"},{"bs":"i opskrbi!","en":"and provide!"}],"ref":"42:19","answerWord":"يَرْزُقُ","answerSound":"audio/0c672990dbde0c4e9194.m4a","quranTranslation":{"text":"Allah is gracious unto His slaves. He provideth for whom He will. And He is the Strong, the Mighty.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["ٱللَّهُ","لَطِيفٌۢ","بِعِبَادِهِۦ","يَرْزُقُ","مَن","يَشَآءُ","وَهُوَ","ٱلْقَوِىُّ","ٱلْعَزِيزُ"],"marked":[3],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-10-31-2","words":["verb:razaqa"],"options":[{"bs":"opskrbljuje vas","en":"he/it provides you (all)"},{"bs":"pa ih opskrbite!","en":"so (you all) provide them!"},{"bs":"opskrbljuje","en":"He provides (for)"},{"bs":"bivaju opskrbljeni","en":"they are provided"}],"ref":"10:31","answerWord":"يَرْزُقُكُم","answerSound":"audio/768ed943eb96b7109e65.m4a","quranTranslation":{"text":"Say (unto them, O Muhammad): Who provideth for you from the sky and the earth, or Who owneth hearing and sight; and Who bringeth forth the living from the dead and bringeth forth the dead from the living; and Who directeth the course? They will say: Allah. Then say: Will ye not then keep your duty (unto Him)?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["قُلْ","مَن","يَرْزُقُكُم","مِّنَ","ٱلسَّمَآءِ","وَٱلْأَرْضِ","أَمَّن","يَمْلِكُ","ٱلسَّمْعَ","وَٱلْأَبْصَٰرَ","وَمَن","يُخْرِجُ","ٱلْحَىَّ","مِنَ","ٱلْمَيِّتِ","وَيُخْرِجُ","ٱلْمَيِّتَ","مِنَ","ٱلْحَىِّ","وَمَن","يُدَبِّرُ","ٱلْأَمْرَ","فَسَيَقُولُونَ","ٱللَّهُ","فَقُلْ","أَفَلَا","تَتَّقُونَ"],"marked":[2],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-8-26-14","words":["verb:razaqa"],"options":[{"bs":"i opskrbio vas je","en":"and he/it provided you (all)"},{"bs":"i opskrbi nas!","en":"and provide us!"},{"bs":"opskrbljeni su","en":"they were provided"},{"bs":"opskrbljujemo vas","en":"we provide you (all)"}],"ref":"8:26","answerWord":"وَرَزَقَكُم","answerSound":"audio/d5859098fa186e7fc490.m4a","quranTranslation":{"text":"And remember, when ye were few and reckoned feeble in the land, and were in fear lest men should extirpate you, how He gave you refuge, and strengthened you with His help, and made provision of good things for you, that haply ye might be thankful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَٱذْكُرُوٓا۟","إِذْ","أَنتُمْ","قَلِيلٌ","مُّسْتَضْعَفُونَ","فِى","ٱلْأَرْضِ","تَخَافُونَ","أَن","يَتَخَطَّفَكُمُ","ٱلنَّاسُ","فَـَٔاوَىٰكُمْ","وَأَيَّدَكُم","بِنَصْرِهِۦ","وَرَزَقَكُم","مِّنَ","ٱلطَّيِّبَٰتِ","لَعَلَّكُمْ","تَشْكُرُونَ"],"marked":[14],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-10-93-6","words":["verb:razaqa"],"options":[{"bs":"i opskrbili smo ih","en":"and we provided them"},{"bs":"i opskrbi ih!","en":"and provide them!"},{"bs":"bivaju opskrbljeni","en":"they are provided"},{"bs":"opskrbljeni smo","en":"we were provided"}],"ref":"10:93","answerWord":"وَرَزَقْنَٰهُم","answerSound":"audio/219ca4907468f68313b5.m4a","quranTranslation":{"text":"And We verily did allot unto the Children of Israel a fixed abode, and did provide them with good things; and they differed not until the knowledge came unto them. Lo! thy Lord will judge between them on the Day of Resurrection concerning that wherein they used to differ.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَلَقَدْ","بَوَّأْنَا","بَنِىٓ","إِسْرَٰٓءِيلَ","مُبَوَّأَ","صِدْقٍ","وَرَزَقْنَٰهُم","مِّنَ","ٱلطَّيِّبَٰتِ","فَمَا","ٱخْتَلَفُوا۟","حَتَّىٰ","جَآءَهُمُ","ٱلْعِلْمُ","إِنَّ","رَبَّكَ","يَقْضِى","بَيْنَهُمْ","يَوْمَ","ٱلْقِيَٰمَةِ","فِيمَا","كَانُوا۟","فِيهِ","يَخْتَلِفُونَ"],"marked":[6],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-2-254-5","words":["verb:razaqa"],"options":[{"bs":"opskrbili smo vas","en":"we provided you (all)"},{"bs":"i opskrbi nas!","en":"and provide us!"},{"bs":"opskrbljeni su","en":"they were provided"},{"bs":"opskrbljuje je","en":"he/it provides it"}],"ref":"2:254","answerWord":"رَزَقْنَٰكُم","answerSound":"audio/111d986b516306bb1bbb.m4a","quranTranslation":{"text":"O ye who believe! spend of that wherewith We have provided you ere a day come when there will be no trafficking, nor friendship, nor intercession. The disbelievers, they are the wrong-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓا۟","أَنفِقُوا۟","مِمَّا","رَزَقْنَٰكُم","مِّن","قَبْلِ","أَن","يَأْتِىَ","يَوْمٌ","لَّا","بَيْعٌ","فِيهِ","وَلَا","خُلَّةٌ","وَلَا","شَفَٰعَةٌ","وَٱلْكَٰفِرُونَ","هُمُ","ٱلظَّٰلِمُونَ"],"marked":[5],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-3-169-12","words":["verb:razaqa"],"options":[{"bs":"bivaju opskrbljeni","en":"they are provided"},{"bs":"i opskrbi!","en":"and provide!"},{"bs":"opskrbljuje vas","en":"he/it provides you (all)"},{"bs":"opskrbljujemo ih","en":"we provide them"}],"ref":"3:169","answerWord":"يُرْزَقُونَ","answerSound":"audio/df6f85a1f603a4659d6b.m4a","quranTranslation":{"text":"Think not of those, who are slain in the way of Allah, as dead. Nay, they are living. With their Lord they have provision.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَلَا","تَحْسَبَنَّ","ٱلَّذِينَ","قُتِلُوا۟","فِى","سَبِيلِ","ٱللَّهِ","أَمْوَٰتًۢا","بَلْ","أَحْيَآءٌ","عِندَ","رَبِّهِمْ","يُرْزَقُونَ"],"marked":[12],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-4-39-9","words":["verb:razaqa"],"options":[{"bs":"opskrbio ih je","en":"he/it provided them"},{"bs":"i opskrbio vas je","en":"and he/it provided you (all)"},{"bs":"i opskrbi!","en":"and provide!"},{"bs":"opskrbili smo ga","en":"we provided him"}],"ref":"4:39","answerWord":"رَزَقَهُمُ","answerSound":"audio/a89b7824e45df3c115fb.m4a","quranTranslation":{"text":"What have they (to fear) if they believe in Allah and the Last Day and spend (aright) of that which Allah hath bestowed upon them, when Allah is ever Aware of them (and all they do)?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَمَاذَا","عَلَيْهِمْ","لَوْ","ءَامَنُوا۟","بِٱللَّهِ","وَٱلْيَوْمِ","ٱلْءَاخِرِ","وَأَنفَقُوا۟","مِمَّا","رَزَقَهُمُ","ٱللَّهُ","وَكَانَ","ٱللَّهُ","بِهِمْ","عَلِيمًا"],"marked":[9],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-22-28-11","words":["verb:razaqa"],"options":[{"bs":"opskrbio ih je","en":"he/it provided them"},{"bs":"opskrbili smo vas","en":"we provided you (all)"},{"bs":"opskrbljeni su","en":"they were provided"},{"bs":"opskrbljujemo te","en":"we provide you"}],"ref":"22:28","answerWord":"رَزَقَهُم","answerSound":"audio/2698e97c360e685b8f08.m4a","quranTranslation":{"text":"That they may witness things that are of benefit to them, and mention the name of Allah on appointed days over the beast of cattle that He hath bestowed upon them. Then eat thereof and feed therewith the poor unfortunate.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["لِّيَشْهَدُوا۟","مَنَٰفِعَ","لَهُمْ","وَيَذْكُرُوا۟","ٱسْمَ","ٱللَّهِ","فِىٓ","أَيَّامٍ","مَّعْلُومَٰتٍ","عَلَىٰ","مَا","رَزَقَهُم","مِّنۢ","بَهِيمَةِ","ٱلْأَنْعَٰمِ","فَكُلُوا۟","مِنْهَا","وَأَطْعِمُوا۟","ٱلْبَآئِسَ","ٱلْفَقِيرَ"],"marked":[11],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-2-126-8","words":["verb:razaqa"],"options":[{"bs":"i opskrbi!","en":"and provide!"},{"bs":"opskrbljuje vas","en":"he/it provides you (all)"},{"bs":"opskrbio vas je","en":"he/it provided you (all)"},{"bs":"zaista će ih opskrbiti","en":"surely he/it will provide them"}],"ref":"2:126","answerWord":"وَٱرْزُقْ","answerSound":"audio/5bb631c3e5fc6720d0a5.m4a","quranTranslation":{"text":"And when Abraham prayed: My Lord! Make this a region of security and bestow upon its people fruits, such of them as believe in Allah and the Last Day, He answered: As for him who disbelieveth, I shall leave him in contentment for a while, then I shall compel him to the doom of Fire - a hapless journey's end!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَإِذْ","قَالَ","إِبْرَٰهِۦمُ","رَبِّ","ٱجْعَلْ","هَٰذَا","بَلَدًا","ءَامِنًا","وَٱرْزُقْ","أَهْلَهُۥ","مِنَ","ٱلثَّمَرَٰتِ","مَنْ","ءَامَنَ","مِنْهُم","بِٱللَّهِ","وَٱلْيَوْمِ","ٱلْءَاخِرِ","قَالَ","وَمَن","كَفَرَ","فَأُمَتِّعُهُۥ","قَلِيلًا","ثُمَّ","أَضْطَرُّهُۥٓ","إِلَىٰ","عَذَابِ","ٱلنَّارِ","وَبِئْسَ","ٱلْمَصِيرُ"],"marked":[8],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-4-5-9","words":["verb:razaqa"],"options":[{"bs":"i opskrbite ih!","en":"and (you all) provide them!"},{"bs":"opskrbljujemo ih","en":"we provide them"},{"bs":"opskrbio ih je","en":"he/it provided them"},{"bs":"bivaju opskrbljeni","en":"they are provided"}],"ref":"4:5","answerWord":"وَٱرْزُقُوهُمْ","answerSound":"audio/26bd3ad6b16e718ad602.m4a","quranTranslation":{"text":"Give not unto the foolish (what is in) your (keeping of their) wealth, which Allah hath given you to maintain; but feed and clothe them from it, and speak kindly unto them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَلَا","تُؤْتُوا۟","ٱلسُّفَهَآءَ","أَمْوَٰلَكُمُ","ٱلَّتِى","جَعَلَ","ٱللَّهُ","لَكُمْ","قِيَٰمًا","وَٱرْزُقُوهُمْ","فِيهَا","وَٱكْسُوهُمْ","وَقُولُوا۟","لَهُمْ","قَوْلًا","مَّعْرُوفًا"],"marked":[9],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-4-8-7","words":["verb:razaqa"],"options":[{"bs":"pa ih opskrbite!","en":"so (you all) provide them!"},{"bs":"i opskrbi ih!","en":"and provide them!"},{"bs":"opskrbljujemo vas","en":"we provide you (all)"},{"bs":"opskrbljuje vas","en":"he/it provides you (all)"}],"ref":"4:8","answerWord":"فَٱرْزُقُوهُم","answerSound":"audio/29b970f93bb9a059e6b7.m4a","quranTranslation":{"text":"And when kinsfolk and orphans and the needy are present at the division (of the heritage), bestow on them therefrom and speak kindly unto them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَإِذَا","حَضَرَ","ٱلْقِسْمَةَ","أُو۟لُوا۟","ٱلْقُرْبَىٰ","وَٱلْيَتَٰمَىٰ","وَٱلْمَسَٰكِينُ","فَٱرْزُقُوهُم","مِّنْهُ","وَقُولُوا۟","لَهُمْ","قَوْلًا","مَّعْرُوفًا"],"marked":[7],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-5-114-18","words":["verb:razaqa"],"options":[{"bs":"i opskrbi nas!","en":"and provide us!"},{"bs":"opskrbljeni su","en":"they were provided"},{"bs":"i opskrbio vas je","en":"and he/it provided you (all)"},{"bs":"pa ih opskrbite!","en":"so (you all) provide them!"}],"ref":"5:114","answerWord":"وَٱرْزُقْنَا","answerSound":"audio/d87782d17d77fceb9216.m4a","quranTranslation":{"text":"Jesus, son of Mary, said: O Allah, Lord of us! Send down for us a table spread with food from heaven, that it may be a feast for us, for the first of us and for the last of us, and a sign from Thee. Give us sustenance, for Thou art the Best of Sustainers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["قَالَ","عِيسَى","ٱبْنُ","مَرْيَمَ","ٱللَّهُمَّ","رَبَّنَآ","أَنزِلْ","عَلَيْنَا","مَآئِدَةً","مِّنَ","ٱلسَّمَآءِ","تَكُونُ","لَنَا","عِيدًا","لِّأَوَّلِنَا","وَءَاخِرِنَا","وَءَايَةً","مِّنكَ","وَٱرْزُقْنَا","وَأَنتَ","خَيْرُ","ٱلرَّٰزِقِينَ"],"marked":[18],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-14-37-21","words":["verb:razaqa"],"options":[{"bs":"i opskrbi ih!","en":"and provide them!"},{"bs":"opskrbljuje","en":"He provides (for)"},{"bs":"opskrbljuje vas","en":"he/it provides you (all)"},{"bs":"i opskrbili smo ih","en":"and we provided them"}],"ref":"14:37","answerWord":"وَٱرْزُقْهُم","answerSound":"audio/91d11c800e938ecb836f.m4a","quranTranslation":{"text":"Our Lord! Lo! I have settled some of my posterity in an uncultivable valley near unto Thy holy House, our Lord! that they may establish proper worship; so incline some hearts of men that they may yearn toward them, and provide Thou them with fruits in order that they may be thankful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["رَّبَّنَآ","إِنِّىٓ","أَسْكَنتُ","مِن","ذُرِّيَّتِى","بِوَادٍ","غَيْرِ","ذِى","زَرْعٍ","عِندَ","بَيْتِكَ","ٱلْمُحَرَّمِ","رَبَّنَا","لِيُقِيمُوا۟","ٱلصَّلَوٰةَ","فَٱجْعَلْ","أَفْـِٔدَةً","مِّنَ","ٱلنَّاسِ","تَهْوِىٓ","إِلَيْهِمْ","وَٱرْزُقْهُم","مِّنَ","ٱلثَّمَرَٰتِ","لَعَلَّهُمْ","يَشْكُرُونَ"],"marked":[21],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-16-75-10","words":["verb:razaqa"],"options":[{"bs":"opskrbili smo ga","en":"we provided him"},{"bs":"i opskrbi!","en":"and provide!"},{"bs":"opskrbljujemo te","en":"we provide you"},{"bs":"opskrbljuje vas","en":"he/it provides you (all)"}],"ref":"16:75","answerWord":"رَّزَقْنَٰهُ","answerSound":"audio/0a21832b91043f23f6ed.m4a","quranTranslation":{"text":"Allah coineth a similitude: (on the one hand) a (mere) chattel slave, who hath control of nothing, and (on the other hand) one on whom we have bestowed a fair provision from Us, and he spendeth thereof secretly and openly. Are they equal? Praise be to Allah! But most of them know not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["ضَرَبَ","ٱللَّهُ","مَثَلًا","عَبْدًا","مَّمْلُوكًا","لَّا","يَقْدِرُ","عَلَىٰ","شَىْءٍ","وَمَن","رَّزَقْنَٰهُ","مِنَّا","رِزْقًا","حَسَنًا","فَهُوَ","يُنفِقُ","مِنْهُ","سِرًّا","وَجَهْرًا","هَلْ","يَسْتَوُۥنَ","ٱلْحَمْدُ","لِلَّهِ","بَلْ","أَكْثَرُهُمْ","لَا","يَعْلَمُونَ"],"marked":[10],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-17-31-6","words":["verb:razaqa"],"options":[{"bs":"opskrbljujemo ih","en":"we provide them"},{"bs":"opskrbili smo ga","en":"we provided him"},{"bs":"bivaju opskrbljeni","en":"they are provided"},{"bs":"opskrbio ih je","en":"he/it provided them"}],"ref":"17:31","answerWord":"نَرْزُقُهُمْ","answerSound":"audio/0ab1fa08d1b5e1ed42ea.m4a","quranTranslation":{"text":"Slay not your children, fearing a fall to poverty, We shall provide for them and for you. Lo! the slaying of them is great sin.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَلَا","تَقْتُلُوٓا۟","أَوْلَٰدَكُمْ","خَشْيَةَ","إِمْلَٰقٍ","نَّحْنُ","نَرْزُقُهُمْ","وَإِيَّاكُمْ","إِنَّ","قَتْلَهُمْ","كَانَ","خِطْـًٔا","كَبِيرًا"],"marked":[6],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-20-132-9","words":["verb:razaqa"],"options":[{"bs":"opskrbljujemo te","en":"we provide you"},{"bs":"opskrbljujemo vas","en":"we provide you (all)"},{"bs":"opskrbio ih je","en":"he/it provided them"},{"bs":"i opskrbio vas je","en":"and he/it provided you (all)"}],"ref":"20:132","answerWord":"نَرْزُقُكَ","answerSound":"audio/4a57b3c6b533c60088a4.m4a","quranTranslation":{"text":"And enjoin upon thy people worship, and be constant therein. We ask not of thee a provision: We provided for thee. And the sequel is for righteousness.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَأْمُرْ","أَهْلَكَ","بِٱلصَّلَوٰةِ","وَٱصْطَبِرْ","عَلَيْهَا","لَا","نَسْـَٔلُكَ","رِزْقًا","نَّحْنُ","نَرْزُقُكَ","وَٱلْعَٰقِبَةُ","لِلتَّقْوَىٰ"],"marked":[9],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-22-58-9","words":["verb:razaqa"],"options":[{"bs":"zaista će ih opskrbiti","en":"surely he/it will provide them"},{"bs":"i opskrbi!","en":"and provide!"},{"bs":"opskrbljuje vas","en":"he/it provides you (all)"},{"bs":"i opskrbi nas!","en":"and provide us!"}],"ref":"22:58","answerWord":"لَيَرْزُقَنَّهُمُ","answerSound":"audio/f7bb777c27edb0d18729.m4a","quranTranslation":{"text":"Those who fled their homes for the cause of Allah and then were slain or died, Allah verily will provide for them a good provision. Lo! Allah, He verily is Best of all who make provision.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَٱلَّذِينَ","هَاجَرُوا۟","فِى","سَبِيلِ","ٱللَّهِ","ثُمَّ","قُتِلُوٓا۟","أَوْ","مَاتُوا۟","لَيَرْزُقَنَّهُمُ","ٱللَّهُ","رِزْقًا","حَسَنًا","وَإِنَّ","ٱللَّهَ","لَهُوَ","خَيْرُ","ٱلرَّٰزِقِينَ"],"marked":[9],"facts":{"verb":"رَزَقَ"}},{"id":"razaqa-29-60-7","words":["verb:razaqa"],"options":[{"bs":"opskrbljuje je","en":"he/it provides it"},{"bs":"bivaju opskrbljeni","en":"they are provided"},{"bs":"opskrbili smo vas","en":"we provided you (all)"},{"bs":"i opskrbi ih!","en":"and provide them!"}],"ref":"29:60","answerWord":"يَرْزُقُهَا","answerSound":"audio/327f9c8951bb644132f6.m4a","quranTranslation":{"text":"And how many an animal there is that beareth not its own provision! Allah provideth for it and for you. He is the Hearer, the Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"opskrbiti, darovati","en":"to provide, to bestow"},"passage":["وَكَأَيِّن","مِّن","دَآبَّةٍ","لَّا","تَحْمِلُ","رِزْقَهَا","ٱللَّهُ","يَرْزُقُهَا","وَإِيَّاكُمْ","وَهُوَ","ٱلسَّمِيعُ","ٱلْعَلِيمُ"],"marked":[7],"facts":{"verb":"رَزَقَ"}},{"id":"dharaa-23-79-2","words":["verb:dharaa"],"options":[{"bs":"rasijao vas je","en":"He spread you (all)"},{"bs":"stvorio je","en":"he/it created"},{"bs":"umnožava vas","en":"he/it multiplies you (all)"},{"bs":"stvorili smo","en":"we created"}],"ref":"23:79","answerWord":"ذَرَأَكُمْ","answerSound":"audio/863a881f0942012f1778.m4a","quranTranslation":{"text":"And He it is Who hath sown you broadcast in the earth, and unto Him ye will be gathered.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, rasijati, posijati","en":"to create, to spread, to sow"},"passage":["وَهُوَ","ٱلَّذِى","ذَرَأَكُمْ","فِى","ٱلْأَرْضِ","وَإِلَيْهِ","تُحْشَرُونَ"],"marked":[2],"facts":{"verb":"ذَرَأَ"}},{"id":"dharaa-7-179-1","words":["verb:dharaa"],"options":[{"bs":"stvorili smo","en":"we created"},{"bs":"umnožava vas","en":"he/it multiplies you (all)"},{"bs":"rasijao vas je","en":"He spread you (all)"},{"bs":"stvorio je","en":"he/it created"}],"ref":"7:179","answerWord":"ذَرَأْنَا","answerSound":"audio/4bc9219de691e823c515.m4a","quranTranslation":{"text":"Already have We urged unto hell many of the jinn and humankind, having hearts wherewith they understand not, and having eyes wherewith they see not, and having ears wherewith they hear not. These are as the cattle - nay, but they are worse! These are the neglectful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, rasijati, posijati","en":"to create, to spread, to sow"},"passage":["وَلَقَدْ","ذَرَأْنَا","لِجَهَنَّمَ","كَثِيرًا","مِّنَ","ٱلْجِنِّ","وَٱلْإِنسِ","لَهُمْ","قُلُوبٌ","لَّا","يَفْقَهُونَ","بِهَا","وَلَهُمْ","أَعْيُنٌ","لَّا","يُبْصِرُونَ","بِهَا","وَلَهُمْ","ءَاذَانٌ","لَّا","يَسْمَعُونَ","بِهَآ","أُو۟لَٰٓئِكَ","كَٱلْأَنْعَٰمِ","بَلْ","هُمْ","أَضَلُّ","أُو۟لَٰٓئِكَ","هُمُ","ٱلْغَٰفِلُونَ"],"marked":[1],"facts":{"verb":"ذَرَأَ"}},{"id":"dharaa-42-11-11","words":["verb:dharaa"],"options":[{"bs":"umnožava vas","en":"he/it multiplies you (all)"},{"bs":"rasijao vas je","en":"He spread you (all)"},{"bs":"stvorili smo","en":"we created"},{"bs":"stvorio je","en":"he/it created"}],"ref":"42:11","answerWord":"يَذْرَؤُكُمْ","answerSound":"audio/f3a9581773d9e861c4e6.m4a","quranTranslation":{"text":"The Creator of the heavens and the earth. He hath made for you pairs of yourselves, and of the cattle also pairs, whereby He multiplieth you. Naught is as His likeness; and He is the Hearer, the Seer.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, rasijati, posijati","en":"to create, to spread, to sow"},"passage":["فَاطِرُ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","جَعَلَ","لَكُم","مِّنْ","أَنفُسِكُمْ","أَزْوَٰجًا","وَمِنَ","ٱلْأَنْعَٰمِ","أَزْوَٰجًا","يَذْرَؤُكُمْ","فِيهِ","لَيْسَ","كَمِثْلِهِۦ","شَىْءٌ","وَهُوَ","ٱلسَّمِيعُ","ٱلْبَصِيرُ"],"marked":[11],"facts":{"verb":"ذَرَأَ"}}]