{"rank": 331, "root": "ظلل", "form": 1, "lemma": "ظَلَّ", "count": 9, "ayahCount": 9, "share": 0.05, "meaning": {"bs": "ostati, nastaviti", "en": "to remain, to keep doing", "tr": "kalmak, devam etmek", "fr": "rester, continuer à", "id": "tetap, terus melakukan", "ur": "رہنا، بدستور کرتے رہنا", "bn": "থেকে যাওয়া, করতে থাকা", "fa": "ماندن، همچنان انجام دادن"}, "lemmaSpoken": "audio/7942dfb14f42dd324d94.m4a", "animation": "<svg class=\"va va-vzll_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes vzll_1-0{from{transform:rotate(-24deg)}}@keyframes vzll_1-1{from{transform:rotate(24deg)}}@keyframes vzll_1-2{from{transform:translate(-80px,6px)}50%{transform:translate(-40px,-4px)}}@keyframes vzll_1-3{from{transform:translateX(30px)}}.va-vzll_1 .ll{transform:rotate(24deg);animation:vzll_1-0 0.50s ease-in-out 7 alternate both}.va-vzll_1 .rl{transform:rotate(-24deg);animation:vzll_1-1 0.50s ease-in-out 7 alternate both}.va-vzll_1 .ra{transform:rotate(24deg);animation:vzll_1-0 0.50s ease-in-out 7 alternate both}.va-vzll_1 .la{transform:rotate(-24deg);animation:vzll_1-1 0.50s ease-in-out 7 alternate both}.va-vzll_1 .su{animation:vzll_1-2 3.5s linear both}.va-vzll_1 .gm{animation:vzll_1-3 0.7s linear 5 both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-vzll_1.off,.va-vzll_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-vzll_1,.va-vzll_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><g transform=\"translate(60 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g><g class=\"su\"><circle class=\"q\" cx=\"100\" cy=\"12\" r=\"5\"/></g><path class=\"p gm\" d=\"M20 61h10M50 61h10M80 61h10\" stroke-width=\"5\"/></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "ظَلَّ", "plain": "ظَلَّ", "quran": true, "notUsed": false, "spoken": "audio/7942dfb14f42dd324d94.m4a", "recited": "audio/d99ba91f11709278ff76.m4a", "recitedText": "ظَلَّ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَظَلُّ", "plain": "يَظَلُّ", "quran": false, "notUsed": false, "spoken": "audio/bb17487aff083211e5bb.m4a", "recited": null, "recitedText": null}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "ظَلِلْتُ", "plain": "ظَلِلْتُ", "quran": false, "notUsed": false, "spoken": "audio/7570ef1eabe58135d76c.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "ظَلِلْنَا", "plain": "ظَلِلْنَا", "quran": false, "notUsed": false, "spoken": "audio/e26c6233d600dbc2c6aa.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "ظَلْتَ", "plain": "ظَلِلْتَ", "quran": true, "notUsed": false, "spoken": "audio/68f76a98dc38b0050d6f.m4a", "recited": "audio/8f0cc057740f437e4270.m4a", "recitedText": "ظَلْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "ظَلِلْتِ", "plain": "ظَلِلْتِ", "quran": false, "notUsed": false, "spoken": "audio/7c722ceee4711b4682be.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "ظَلِلْتُمَا", "plain": "ظَلِلْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/ba1e8967501ff606db77.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "ظَلْتُمْ", "plain": "ظَلِلْتُمْ", "quran": true, "notUsed": false, "spoken": "audio/c09bd5d24b734e8ce9d3.m4a", "recited": "audio/47d8ccd39d833349d554.m4a", "recitedText": "فَظَلْتُمْ"}, {"tense": "past", "pronoun": "antunna", "arabic": "ظ