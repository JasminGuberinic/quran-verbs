": "جَادِلْ", "quran": false, "notUsed": false, "spoken": "audio/f738bc3b413238aacd1f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "جَادِلِي", "plain": "جَادِلِي", "quran": false, "notUsed": false, "spoken": "audio/abff90cf8cd833e1d0c2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "جَادِلَا", "plain": "جَادِلَا", "quran": false, "notUsed": false, "spoken": "audio/d80fcc00bcd9e69cd36b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "جَادِلُوا", "plain": "جَادِلُوا", "quran": false, "notUsed": false, "spoken": "audio/111652e992e136fe3e8e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "جَادِلْنَ", "plain": "جَادِلْنَ", "quran": false, "notUsed": false, "spoken": "audio/71daadaa7a829c3999e1.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "42:35", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4307.mp3", "translation": {"en": {"text": "And that those who argue concerning Our revelations may know they have no refuge.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Âyetlerimiz hakkında mücadele edenler bilsinler ki kendileri için kaçacak bir yer yoktur.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جان جائیں وہ جو ہماری آیتوں میں جھگڑتے ہیں، کہ انہیں کہیں بھا گنے کی جگہ نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan supaya orang-orang yang membantah ayat-ayat (kekuasaan) Kami mengetahui bahwa mereka sekali-kali tidak akan memperoleh jalan ke luar (dari siksaan).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَعْلَمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُجَٰدِلُونَ", "hit": true, "audio": "audio/b6f5f02f518c1e21e6fe.m4a", "gloss": {"bs": "raspravljaju se", "en": "they dispute", "tr": "çekişirler", "fr": "ils disputent", "id": "mereka berbantahan", "ur": "وہ جھگڑتے ہیں", "bn": "তারা তর্ক করে", "fa": "مجادله می‌کنند"}}, {"text": "فِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "مَّحِيصٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "11:74", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1547.mp3", "translation": {"en": {"text": "And when the awe departed from Abraham, and the glad news reached him, he pleaded with Us on behalf of the folk of Lot.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İbrahim'den korku iyice geçip gidince, bu müjde de kendisine gelince, bizim (meleklerimiz)le Lut kavmi hakkında tartışmaya girişti:", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر جب ابراہیم کا خوف زائل ہوا اور اسے خوشخبری ملی ہم سے قوم لوط کے بارے میں جھگڑنے لگا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka tatkala rasa takut hilang dari Ibrahim dan berita gembira telah datang kepadanya, diapun bersoal jawab dengan (malaikat-malaikat) Kami tentang kaum Luth.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ذَهَبَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِبْرَٰهِيمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّوْعُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَجَآءَتْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبُشْرَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "يُجَٰدِلُنَا", "hit": true, "audio": "audio/565f38ddfe7d9e3588fc.m4a", "gloss": {"en": "he/it argues with us", "bs": "raspravlja se s nama", "tr": "bizimle tartışır", "fr": "il discute avec nous", "id": "dia berdebat dengan kami", "ur": "وہ ہم سے بحث کرتا ہے", "bn": "সে আমাদের সাথে তর্ক করে", "fa": "با ما بحث می‌کند"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "لُوطٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "22:68", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2663.mp3", "translation": {"en": {"text": "And if they wrangle with thee, say: Allah is Best Aware of what ye do.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer seninle tartışırlarsa, de ki: \"Allah yaptıklarınızı çok iyi bilir.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر وہ تم سے جھگڑیں تو فرمادو کہ اللہ خوب جانتا ہے تمہارے کوتک (تمہاری کرتوت)", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan jika mereka membantah kamu, maka katakanlah: \"Allah lebih mengetahui tentang apa yang kamu kerjakan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِن", "hit": false, "audio": null, "gloss": null}, {"text": "جَٰدَلُوكَ", "hit": true, "audio": "audio/dfeadae70af128c99c0f.m4a", "gloss": {"bs": "raspravljaju se s tobom", "en": "they argue with you", "tr": "seninle tartışırlar", "fr": "ils disputent avec toi", "id": "mereka berdebat denganmu", "ur": "وہ تم سے بحث کرتے ہیں", "bn": "তারা তোমার সাথে তর্ক করেছে", "fa": "با تو جدال کردند"}}, {"text": "فَقُلِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "