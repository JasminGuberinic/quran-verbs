َ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَسْتَجِبْنَ", "plain": "يَسْتَجِبْنَ", "quran": false, "notUsed": false, "spoken": "audio/777b4780527c2bde0c91.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِسْتَجِبْ", "plain": "اِسْتَجِبْ", "quran": false, "notUsed": false, "spoken": "audio/7a6bc92a547acc9e6569.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِسْتَجِيبِي", "plain": "اِسْتَجِيبِي", "quran": false, "notUsed": false, "spoken": "audio/4e8bdaaeacf80e8430d3.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِسْتَجِيبَا", "plain": "اِسْتَجِيبَا", "quran": false, "notUsed": false, "spoken": "audio/726939de08da31b5e425.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱسْتَجِيبُوا۟", "plain": "اِسْتَجِيبُوا", "quran": true, "notUsed": false, "spoken": "audio/2872bc07fe0a8217007d.m4a", "recited": "audio/ea493f2af110e1534288.m4a", "recitedText": "ٱسْتَجِيبُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِسْتَجِبْنَ", "plain": "اِسْتَجِبْنَ", "quran": false, "notUsed": false, "spoken": "audio/b0f03e0dbd03e699b172.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "42:38", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4310.mp3", "translation": {"en": {"text": "And those who answer the call of their Lord and establish worship, and whose affairs are a matter of counsel, and who spend of what We have bestowed on them,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, Rablerinin davetini kabul ederler ve namazı dosdoğru kılarlar. Onların işleri de kendi aralarında bir istişare iledir. Kendilerine verdiğimiz rızıktan onlar Allah yolunda harcarlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جنہوں نے اپنے رب کا حکم مانا اور نماز قائم رکھی اور ان کا کام ان کے آپس کے مشورے سے ہے اور ہمارے دیے سے کچھ ہماری راہ میں خرچ کرتے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan (bagi) orang-orang yang menerima (mematuhi) seruan Tuhannya dan mendirikan shalat, sedang urusan mereka (diputuskan) dengan musyawarat antara mereka; dan mereka menafkahkan sebagian dari rezeki yang Kami berikan kepada mereka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱسْتَجَابُوا۟", "hit": true, "audio": "audio/30e48c6478d6f65f0902.m4a", "gloss": {"en": "they answered", "bs": "odazvali su se", "tr": "cevap verdiler", "fr": "ils ont répondu", "id": "mereka telah menjawab", "ur": "انہوں نے جواب دیا", "bn": "তারা সাড়া দিল", "fa": "پاسخ دادند"}}, {"text": "لِرَبِّهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَقَامُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّلَوٰةَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَمْرُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "شُورَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "بَيْنَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمِمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "رَزَقْنَٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُنفِقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:88", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2571.mp3", "translation": {"en": {"text": "Then we heard his prayer and saved him from the anguish. Thus we save believers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz de duasını kabul ile icabet ettik, kendisini üzüntüden kurtardık. İşte biz iman edenleri böyle kurtarırız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ہم نے اس کی پکار سن لی اور سے غم سے نجات بخشی اور ایسی ہی نجات دیں گے مسلمانوں کو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Kami telah memperkenankan doanya dan menyelamatkannya dari pada kedukaan. Dan demikianlah Kami selamatkan orang-orang yang beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱسْتَجَبْنَا", "hit": true, "audio": "audio/c7e269dbff09cf976821.m4a", "gloss": {"bs": "pa smo se odazvali", "en": "so We answered", "tr": "bunun üzerine icabet ettik", "fr": "alors Nous avons exaucé", "id": "maka Kami mengabulkan", "ur": "پس ہم نے قبول کی (دعا)", "bn": "তখন আমরা সাড়া দিলাম", "fa": "پس اجابت کردیم"}}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَجَّيْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْغَمِّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَكَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نُۨجِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُؤْمِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:34", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1630.mp3", "translation": {"en": {"text": "So his Lord heard his prayer and fended off their wiles from him. Lo! He is Hearer, Knower.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine Rabbi, onun duasını kabul buyurdu da ondan onların tuzaklarını bertaraf etti. Muhakkak ki O, evet O, hakkiyle işiten, hakkiyle bilendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اس کے رب نے اس کی سن لی اور اس سے عورتوں کا مکر پھیردیا، بیشک وہی سنتا جانتا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Tuhannya memperkenankan doa Yusuf dan Dia menghindarkan Yusuf dari tipu daya mereka. Sesungguhnya Dialah Yang Maha Mendengar lagi Maha Mengetahui.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱسْتَجَابَ", "hit": true, "audio": "audio/7c8b11bfe412504dc7a1.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}]}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فَصَرَفَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "كَيْدَهُنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمِيعُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَلِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "6:36", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/825.mp3", "translation": {"en": {"text": "Only those can accept who hear. As for the dead, Allah will raise them up; then unto Him they will be returned.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Daveti ancak dinleyenler kabul ederler. Ölülere gelince, Allah onları diriltir, sonra O'na döndürülürler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "مانتے تو وہی ہیں جو سنتے ہیں اور ان مردہ دلوں کو اللہ اٹھائے گا پھر اس کی طرف ہانکے جائیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hanya mereka yang mendengar sajalah yang mematuhi (seruan Allah), dan orang-orang yang mati (hatinya), akan dibangkitkan oleh Allah, kemudian kepada-Nya-lah mereka dikembalikan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَجِيبُ", "hit": true, "audio": "audio/0278abdeef5a64116ac2.m4a", "gloss": {"en": "he/it answers", "bs": "odaziva se", "tr": "cevap verir", "fr": "il répond", "id": "dia menjawab", "ur": "وہ جواب دیتا ہے", "bn": "সে সাড়া দেয়", "fa": "پاسخ می‌دهد"}}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْمَعُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْمَوْتَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "يَبْعَثُهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "يُرْجَعُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "17:52", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2081.mp3", "translation": {"en": {"text": "A day when He will call you and ye will answer with His praise, and ye will think that ye have tarried but a little while.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Allah) sizi çağıracağı gün, tam bir hürmetle onun emrine koşacaksınız ve zannedeceksiniz ki, kabirlerinizde pek az bir müddet kaldınız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جس دن وہ تمہیں بُلائے گا تو تم اس کی حمد کرتے چلے آؤ گے اور سمجھو گے کہ نہ رہے (۱۰۸) تھے مگر تھوڑا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "yaitu pada hari Dia memanggil kamu, lalu kamu mematuhi-Nya sambil memuji-Nya dan kamu mengira, bahwa kamu tidak berdiam (di dalam kubur) kecuali sebentar saja.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَدْعُوكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَسْتَجِيبُونَ", "hit": true, "audio": "audio/b533c3182f4b2de35a81.m4a", "gloss": {"bs": "i vi ćete se odazvati", "en": "and you will respond", "tr": "ve siz de icabet edeceksiniz", "fr": "et vous répondrez", "id": "dan kamu akan memenuhi seruan", "ur": "اور تم قبول کرو گے", "bn": "এবং তোমরা সাড়া দেবে", "fa": "و پاسخ خواهید داد"}}, {"text": "بِحَمْدِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَظُنُّونَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّبِثْتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "قَلِيلًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَسْتَجِيبُوا۟", "count": 5, "first": "11:14", "audio": "audio/348f963be55e00dcc7eb.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "jussive"}, {"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "they answer", "bs": "odazivaju se", "tr": "cevap verirler", "fr": "qu'ils répondent", "id": "mereka menjawab", "ur": "وہ جواب دیتے ہیں", "bn": "তারা সাড়া দেয়", "fa": "پاسخ می‌دهند"}}, {"arabic": "ٱسْتَجَابُوا۟", "count": 4, "first": "3:172", "audio": "audio/6a98b22273db382322a2.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they answered", "bs": "odazvali su se", "tr": "cevap verdiler", "fr": "ils ont répondu", "id": "mereka telah menjawab", "ur": "انہوں نے جواب دیا", "bn": "তারা সাড়া দিল", "fa": "پاسخ دادند"}}, {"arabic": "فَٱسْتَجَبْنَا", "count": 4, "first": "21:76", "audio": "audio/c7e269dbff09cf976821.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"bs": "pa smo se odazvali", "en": "so We answered", "tr": "bunun üzerine icabet ettik", "fr": "alors Nous avons exaucé", "id": "maka Kami mengabulkan", "ur": "پس ہم نے قبول کی (دعا)", "bn": "তখন আমরা সাড়া দিলাম