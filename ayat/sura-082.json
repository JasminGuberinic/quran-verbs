{"ayat":[{"ref":"82:1","number":5830,"text":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","hits":[0,1]},{"ref":"82:2","number":5831,"text":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","hits":[1]},{"ref":"82:3","number":5832,"text":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","hits":[1,2]},{"ref":"82:4","number":5833,"text":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","hits":[1]},{"ref":"82:5","number":5834,"text":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","hits":[0,1,2,3,4]},{"ref":"82:6","number":5835,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","hits":[1,3,4,5]},{"ref":"82:7","number":5836,"text":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","hits":[0,1,2,3]},{"ref":"82:8","number":5837,"text":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ","hits":[0,4]},{"ref":"82:9","number":5838,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","hits":[0,1,2,3]},{"ref":"82:10","number":5839,"text":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","hits":[0,1]},{"ref":"82:11","number":5840,"text":"كِرَامًا كَٰتِبِينَ","hits":[1]},{"ref":"82:12","number":5841,"text":"يَعْلَمُونَ مَا تَفْعَلُونَ","hits":[2]},{"ref":"82:13","number":5842,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","hits":[1,3]},{"ref":"82:14","number":5843,"text":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ","hits":[]},{"ref":"82:15","number":5844,"text":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","hits":[0,1]},{"ref":"82:16","number":5845,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","hits":[1,2,3]},{"ref":"82:17","number":5846,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","hits":[1]},{"ref":"82:18","number":5847,"text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","hits":[0]},{"ref":"82:19","number":5848,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ","hits":[1,2,5,6]}]}