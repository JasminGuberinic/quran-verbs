{"rank": 85, "root": "ندي", "form": 3, "lemma": "نادَى", "count": 44, "ayahCount": 44, "share": 0.23, "meaning": {"bs": "pozvati, dozvati", "en": "to call, to call out", "tr": "çağırmak, seslenmek", "fr": "appeler, interpeller", "id": "menyeru, memanggil", "ur": "پکارنا، آواز دینا", "bn": "ডাকা, আহ্বান করা", "fa": "خواندن، صدا زدن"}, "lemmaSpoken": "audio/c41ea481e58044567434.m4a", "animation": "<svg class=\"va va-nada_3\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes nda{from{opacity:0}}.va-nada_3 .a0{animation:nda 0.45s ease-out 0s 2 both}.va-nada_3 .a1{animation:nda 0.45s ease-out 0.4s 2 both}.va-nada_3 .a2{animation:nda 0.45s ease-out 0.8s 2 both}.va-nada_3 .ra{transform:rotate(-152deg)}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-nada_3.off,.va-nada_3.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-nada_3,.va-nada_3 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><path class=\"p a0\" d=\"M56 16q3 2 0 5\"/><path class=\"p a1\" d=\"M64 13q5 5 0 10\"/><path class=\"p a2\" d=\"M72 11q7 7 0 15\"/><g transform=\"translate(40 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "نَادَىٰ", "plain": "نَادَى", "quran": true, "notUsed": false, "spoken": "audio/c41ea481e58044567434.m4a", "recited": "audio/06d1e603ab48634882af.m4a", "recitedText": "نَادَىٰ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُنَا