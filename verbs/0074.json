{"rank": 74, "root": "كتب", "form": 1, "lemma": "كَتَبَ", "count": 49, "ayahCount": 39, "share": 0.25, "meaning": {"bs": "pisati, propisati", "en": "to write, to prescribe", "tr": "yazmak, farz kılmak", "fr": "écrire, prescrire", "id": "menulis, mewajibkan", "ur": "لکھنا، فرض کرنا", "bn": "লেখা, ফরয করা", "fa": "نوشتن، مقرر کردن"}, "lemmaSpoken": "audio/d69bd1d9486bf49d3541.m4a", "animation": "<svg class=\"va va-kataba_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes kt-d{from{stroke-dashoffset:100}}@keyframes kt-p{from{transform:translateX(-62px)}}.va-kataba_1 .ln{stroke-dasharray:100;animation:kt-d 2.4s ease-in-out both}.va-kataba_1 .pn{animation:kt-p 2.4s ease-in-out both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-kataba_1.off,.va-kataba_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-kataba_1,.va-kataba_1 *{animation:none!important}}</style><path class=\"p\" d=\"M22 10h76v50H22z\"/><path class=\"p ln\" pathLength=\"100\" d=\"M32 34c4-9 8 9 12 0s8 9 12 0 8 9 12 0 8 9 12 0\"/><g class=\"pn\"><path class=\"p\" d=\"M92 34l8-16\"/></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "كَتَبَ", "plain": "كَتَبَ", "quran": true, "notUsed": false, "spoken": "audio/d69bd1d9486bf49d3541.m4a", "recited": "audio/30ca1bb79801c3232745.m4a", "recitedText": "كَتَبَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَكْتُبُ", "plain": "يَكْتُبُ", "quran": true, "notUsed": false, "spoken": "audio/f51c6b4542b8c99ba5f4.m4a", "recited": "audio/0a8ebe68caba0e0f9b9b.m4a", "recitedText": "يَكْتُبُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱكْتُبْ", "plain": "اُكْتُبْ", "quran": true, "notUsed": false, "spoken": "audio/761503a6ea981e9ba471.m4a", "recited": "audio/52ebe2165e777f671357.m4a", "recitedText": "وَٱكْتُبْ"}], "nouns": {"participle": {"lemma": "كاتِب", "count": 6, "spoken": "audio/522cf52b9b2d71924ab8.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "كَتَبْتُ", "plain": "كَتَبْتُ", "quran": false, "notUsed": false, "spoken": "audio/ef3ce679dc5305593adc.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "كَتَبْنَا", "plain": "كَتَبْنَا", "quran": true, "notUsed": false, "spoken": "audio/784f07246e7ee240ce0d.m4a", "recited": "audio/420034809d29866c9bfa.m4a", "recitedText": "كَتَبْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "كَتَبْتَ", "plain": "كَتَبْتَ", "quran": true, "notUsed": false, "spoken": "audio/be21c0c4631694b79aa4.m4a", "recited": "audio/82c0a63dbe929500a2a6.m4a", "recitedText": "كَتَبْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "كَتَبْتِ", "plain": "كَتَبْتِ", "quran": false, "notUsed": false, "spoken": "audio/67e4b3673578d75ab943.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "كَتَبْتُمَا", "plain": "كَتَبْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/947a92e8c97bf9416ebf.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "كَتَبْتُمْ", "plain": "كَتَبْتُمْ", "quran": false, "notUsed": false, "spoken": "audio/471b0d717dc33b8a66ad.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antunna", "arabic": "كَتَبْتُنَّ", "plain": "كَتَبْتُنَّ", "quran": false, "notUsed": false, "spoken": "audio/724a6386b6d774fa60cf.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huwa", "arabic": "كَتَبَ", "plain": "كَتَبَ", "quran": true, "notUsed": false, "spoken": "audio/d69bd1d9486bf49d3541.m4a", "recited": "audio/30ca1bb79801c3232745.m4a", "recitedText": "كَتَبَ"}, {"tense": "past", "pronoun": "hiya", "arabic": "كَتَبَتْ", "plain": "كَتَبَتْ", "quran": true, "notUsed": false, "spoken": "audio/4b3ef3eda08075556cfe.m4a", "recited": "audio/71d04aace0dd96584328.m4a", "recitedText": "كَتَبَتْ"}, {"tense": "past", "pronoun": "huma", "arabic": "كَتَبَا", "plain": "كَتَبَا", "quran": false, "notUsed": false, "spoken": "audio/d23c245f8c34bc312c3a.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hum", "arabic": "كَتَبُوا", "plain": "كَتَبُوا", "quran": false, "notUsed": false, "spoken": "audio/d1abd7ac921363c2574a.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hunna", "arabic": "كَتَبْنَ", "plain": "كَتَبْنَ", "quran": false, "notUsed": false, "spoken": "audio/f9306aa6cc2fe9c29521.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "ana", "arabic": "أَكْتُبُ", "plain": "أَكْتُبُ", "quran": false, "notUsed": false, "spoken": "audio/8b47457cd879bd95d729.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "nahnu", "arabic": "نَكْتُبُ", "plain": "نَكْتُبُ", "quran": true, "notUsed": false, "spoken": "audio/77d8ec46bb66bb5a6bd9.m4a", "recited": "audio/96268ed907a83a03fead.m4a", "recitedText": "سَنَكْتُبُ"}, {"tense": "present", "pronoun": "anta", "arabic": "تَكْتُبُ", "plain": "تَكْتُبُ", "quran": false, "notUsed": false, "spoken": "audio/ce12604055d0460d023a.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "anti", "arabic": "تَكْتُبِينَ", "plain": "تَكْتُبِينَ", "quran": false, "notUsed": false, "spoken": "audio/a514961e6b6b874813b4.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تَكْتُبَانِ", "plain": "تَكْتُبَانِ", "quran": false, "notUsed": false, "spoken": "audio/5599c9146d9f299a5e0c.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَكْتُبُونَ", "plain": "تَكْتُبُونَ", "quran": false, "notUsed": false, "spoken": "audio/d03633770be074912c9a.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antunna", "arabic": "تَكْتُبْنَ", "plain": "تَكْتُبْنَ", "quran": false, "notUsed": false, "spoken": "audio/b67c4b35484bca151a91.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَكْتُبُ", "plain": "يَكْتُبُ", "quran": true, "notUsed": false, "spoken": "audio/f51c6b4542b8c99ba5f4.m4a", "recited": "audio/0a8ebe68caba0e0f9b9b.m4a", "recitedText": "يَكْتُبُ"}, {"tense": "present", "pronoun": "hiya", "arabic": "تَكْتُبُ", "plain": "تَكْتُبُ", "quran": false, "notUsed": false, "spoken": "audio/ce12604055d0460d023a.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يَكْتُبَانِ", "plain": "يَكْتُبَانِ", "quran": false, "notUsed": false, "spoken": "audio/262646b67c1baad542d2.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَكْتُبُونَ", "plain": "يَكْتُبُونَ", "quran": true, "notUsed": false, "spoken": "audio/39c74443169c5c04f54a.m4a", "recited": "audio/9ef355231fdec539f29d.m4a", "recitedText": "يَكْتُبُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَكْتُبْنَ", "plain": "يَكْتُبْنَ", "quran": false, "notUsed": false, "spoken": "audio/dd2c922c12b58b3bd267.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱكْتُبْ", "plain": "اُكْتُبْ", "quran": true, "notUsed": false, "spoken": "audio/761503a6ea981e9ba471.m4a", "recited": "audio/52ebe2165e777f671357.m4a", "recitedText": "وَٱكْتُبْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُكْتُبِي", "plain": "اُكْتُبِي", "quran": false, "notUsed": false, "spoken": "audio/2cfc4ec700c9b53f975d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُكْتُبَا", "plain": "اُكْتُبَا", "quran": false, "notUsed": false, "spoken": "audio/9ff38ca1f6e1841a89bd.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُكْتُبُوا", "plain": "اُكْتُبُوا", "quran": false, "notUsed": false, "spoken": "audio/334cbde4bd9c90bfb842.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُكْتُبْنَ", "plain": "اُكْتُبْنَ", "quran": false, "notUsed": false, "spoken": "audio/66a9e04c30423d9e9625.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "58:21", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5125.mp3", "translation": {"en": {"text": "Allah hath decreed: Lo! I verily shall conquer, I and My messengers. Lo! Allah is Strong, Almighty.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah: \"Elbette ben ve elçilerim galip geleceğiz.\" diye yazmıştır. Şüphesiz Allah güçlüdür, galipdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ لکھ چکا کہ ضرور میں غالب آؤں گا اور میرے رسول بیشک اللہ قوت والا عزت والا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah telah menetapkan: \"Aku dan rasul-rasul-Ku pasti menang\". Sesungguhnya Allah Maha Kuat lagi Maha Perkasa.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَتَبَ", "hit": true, "audio": "audio/30ca1bb79801c3232745.m4a", "gloss": {"bs": "je odredio", "en": "has decreed", "tr": "hükmetti", "fr": "a prescrit", "id": "telah menetapkan", "ur": "اس نے لکھ دیا", "bn": "লিখে দিয়েছেন", "fa": "مقرر کرده است"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَأَغْلِبَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَا۠", "hit": false, "audio": null, "gloss": null}, {"text": "وَرُسُلِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "قَوِىٌّ", "hit": false, "audio": null, "gloss": null}, {"text": "عَزِيزٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:105", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2588.mp3", "translation": {"en": {"text": "And verily we have written in the Scripture, after the Reminder: My righteous slaves will inherit the earth:", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "And olsun ki, Tevrat'tan sonra Zebûr'da da yeryüzüne ancak iyi kullarımın mirasçı olduğunu yazmıştık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے زبور میں نصیحت کے بعد لکھ دیا کہ اس زمین کے وارث میرے نیک بندے ہوں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sungguh telah Kami tulis didalam Zabur sesudah (Kami tulis dalam) Lauh Mahfuzh, bahwasanya bumi ini dipusakai hamba-hamba-Ku yang saleh.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَتَبْنَا", "hit": true, "audio": "audio/b3e5311508423fabb4d1.m4a", "gloss": {"en": "we wrote", "bs": "napisali smo"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلزَّبُورِ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْدِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلذِّكْرِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَرِثُهَا", "hit": false, "audio": null, "gloss": null}, {"text": "عِبَادِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّٰلِحُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "52:41", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4776.mp3", "translation": {"en": {"text": "Or possess they the Unseen so that they can write (it) down?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yoksa gayb kendilerinin yanında da onlar mı yazıyorlar?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا ان کے پاس غیب ہیں جس سے وہ حکم لگاتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apakah ada pada sisi mereka pengetahuan tentang yang gaib lalu mereka menuliskannya?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عِندَهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْغَيْبُ", "hit": false, "audio": null, "gloss": null}, {"text": "فَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَكْتُبُونَ", "hit": true, "audio": "audio/9ef355231fdec539f29d.m4a", "gloss": {"bs": "zapisuju", "en": "they write (it down)", "tr": "(onu) yazarlar", "fr": "ils (le) mettent par écrit", "id": "mereka menuliskannya", "ur": "وہ لکھتے ہیں", "bn": "তারা (তা) লিখে রাখে", "fa": "(آن را) می‌نویسند"}}]}, {"ref": "3:53", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/346.mp3", "translation": {"en": {"text": "Our Lord! We believe in that which Thou hast revealed and we follow him whom Thou hast sent. Enrol us among those who witness (to the truth).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey Rabbimiz, senin indirdiğine iman ettik, o peygambere de uyduk. Artık bizi şahidlerle beraber yaz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے رب ہمارے! ہم اس پر ایمان لائے جو تو نے اتارا اور رسول کے تابع ہوئے تو ہمیں حق پر گواہی دینے والوں میں لکھ لے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ya Tuhan kami, kami telah beriman kepada apa yang telah Engkau turunkan dan telah kami ikuti rasul, karena itu masukanlah kami ke dalam golongan orang-orang yang menjadi saksi (tentang keesaan Allah)\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رَبَّنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنزَلْتَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱتَّبَعْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّسُولَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱكْتُبْنَا", "hit": true, "audio": "audio/f046c3894e8a00546638.m4a", "gloss": {"bs": "pa nas upiši!", "en": "so record us!", "tr": "bizi yaz!", "fr": "alors inscris-nous !", "id": "maka catatlah kami!", "ur": "پس ہمیں لکھ لے!", "bn": "অতএব আমাদের লিখে নাও!", "fa": "پس ما را ثبت کن!"}}, {"text": "مَعَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلشَّٰهِدِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:79", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2329.mp3", "translation": {"en": {"text": "Nay, but We shall record that which he saith and prolong for him a span of torment.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hayır, asla öyle değil; biz onun söylediklerini yazacağız ve azabını çoğalttıkça çoğaltacağız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہرگز نہیں اب ہم لکھ رکھیں گے جو وہ کہتا ہے اور اسے خوب لمبا عذاب دیں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "sekali-kali tidak, Kami akan menulis apa yang ia katakan, dan benar-benar Kami akan memperpanjang azab untuknya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "سَنَكْتُبُ", "hit": true, "audio": "audio/b2b9f9ceacdc1560d258.m4a", "gloss": {"en": "we will write", "bs": "napisat ćemo", "tr": "yazacağız", "fr": "nous écrirons", "id": "kami akan menulis", "ur": "ہم لکھیں گے", "bn": "আমরা লিখব", "fa": "خواهیم نوشت"}}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُولُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَمُدُّ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَذَابِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَدًّا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "كُتِبَ", "count": 13, "first": "2:178", "audio": "audio/8a28ee08882b701634b1.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "it was prescribed; it was decreed; it was written", "bs": "propisano je; određeno je; napisano je", "tr": "farz kılındı; yazıldı", "fr": "il a été prescrit ; il a été décrété ; il a été écrit", "id": "telah ditetapkan; telah ditulis", "ur": "فرض کیا گیا", "bn": "বিধিবদ্ধ করা হয়েছে; লিখিত হয়েছে", "fa": "مقرر شد؛ حکم شد؛ نوشته شد"}}, {"arabic": "كَتَبَ", "count": 8, "first": "2:187", "audio": "audio/30ca1bb79801c3232745.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "je odredio", "en": "has decreed", "tr": "hükmetti", "fr": "a prescrit", "id": "telah menetapkan", "ur": "اس نے لکھ دیا", "bn": "লিখে দিয়েছেন", "fa": "مقرر کرده است"}}, {"arabic": "يَكْتُبُونَ", "count": 5, "first": "2:79", "audio": "audio/9ef355231fdec539f29d.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "zapisuju", "en": "they write (it down)", "tr": "(onu) yazarlar", "fr": "ils (le) mettent par écrit", "id": "mereka menuliskannya", "ur": "وہ لکھتے ہیں", "bn": "তারা (তা) লিখে রাখে", "fa": "(آن را) می‌نویسند"}}, {"arabic": "كَتَبْنَا", "count": 3, "first": "4:66", "audio": "audio/420034809d29866c9bfa.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu",