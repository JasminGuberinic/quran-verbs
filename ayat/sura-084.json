{"ayat":[{"ref":"84:1","number":5885,"text":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","hits":[0,1,2]},{"ref":"84:2","number":5886,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","hits":[0,1,2]},{"ref":"84:3","number":5887,"text":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","hits":[1,2]},{"ref":"84:4","number":5888,"text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","hits":[0,1,2]},{"ref":"84:5","number":5889,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","hits":[]},{"ref":"84:6","number":5890,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَٰقِيهِ","hits":[1,2,4]},{"ref":"84:7","number":5891,"text":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ","hits":[0,1,2,3,4]},{"ref":"84:8","number":5892,"text":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا","hits":[0,2,3]},{"ref":"84:9","number":5893,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا","hits":[0,2]},{"ref":"84:10","number":5894,"text":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","hits":[5]},{"ref":"84:11","number":5895,"text":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا","hits":[1]},{"ref":"84:12","number":5896,"text":"وَيَصْلَىٰ سَعِيرًا","hits":[0]},{"ref":"84:13","number":5897,"text":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","hits":[1]},{"ref":"84:14","number":5898,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","hits":[1,2,3]},{"ref":"84:15","number":5899,"text":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا","hits":[0,4]},{"ref":"84:16","number":5900,"text":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","hits":[0,1]},{"ref":"84:17","number":5901,"text":"وَٱلَّيْلِ وَمَا وَسَقَ","hits":[0]},{"ref":"84:18","number":5902,"text":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","hits":[0]},{"ref":"84:19","number":5903,"text":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ","hits":[0,2]},{"ref":"84:20","number":5904,"text":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","hits":[1,3]},{"ref":"84:21","number":5905,"text":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ","hits":[1,2,5]},{"ref":"84:22","number":5906,"text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ","hits":[0,1,2,3]},{"ref":"84:23","number":5907,"text":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","hits":[]},{"ref":"84:24","number":5908,"text":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","hits":[0,1,2]},{"ref":"84:25","number":5909,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ","hits":[0,3,4,6]}]}