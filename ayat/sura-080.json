{"ayat":[{"ref":"80:1","number":5759,"text":"عَبَسَ وَتَوَلَّىٰٓ","hits":[1]},{"ref":"80:2","number":5760,"text":"أَن جَآءَهُ ٱلْأَعْمَىٰ","hits":[0,1,2]},{"ref":"80:3","number":5761,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","hits":[0,1,2,3]},{"ref":"80:4","number":5762,"text":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","hits":[0,1,2,3]},{"ref":"80:5","number":5763,"text":"أَمَّا مَنِ ٱسْتَغْنَىٰ","hits":[0,1,2]},{"ref":"80:6","number":5764,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","hits":[0,1]},{"ref":"80:7","number":5765,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","hits":[1]},{"ref":"80:8","number":5766,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","hits":[3]},{"ref":"80:9","number":5767,"text":"وَهُوَ يَخْشَىٰ","hits":[0,1]},{"ref":"80:10","number":5768,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ","hits":[1]},{"ref":"80:11","number":5769,"text":"كَلَّآ إِنَّهَا تَذْكِرَةٌ","hits":[0,1]},{"ref":"80:12","number":5770,"text":"فَمَن شَآءَ ذَكَرَهُۥ","hits":[1,2]},{"ref":"80:13","number":5771,"text":"فِى صُحُفٍ مُّكَرَّمَةٍ","hits":[0]},{"ref":"80:14","number":5772,"text":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ","hits":[]},{"ref":"80:15","number":5773,"text":"بِأَيْدِى سَفَرَةٍ","hits":[0]},{"ref":"80:16","number":5774,"text":"كِرَامٍۭ بَرَرَةٍ","hits":[0,1]},{"ref":"80:17","number":5775,"text":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","hits":[0,1]},{"ref":"80:18","number":5776,"text":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","hits":[0,2,3]},{"ref":"80:19","number":5777,"text":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","hits":[3]},{"ref":"80:20","number":5778,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","hits":[0,1,2]},{"ref":"80:21","number":5779,"text":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","hits":[1]},{"ref":"80:22","number":5780,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","hits":[1]},{"ref":"80:23","number":5781,"text":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","hits":[1,2,4]},{"ref":"80:24","number":5782,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","hits":[0,2,3]},{"ref":"80:25","number":5783,"text":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا","hits":[0,1,2]},{"ref":"80:26","number":5784,"text":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا","hits":[2]},{"ref":"80:27","number":5785,"text":"فَأَنۢبَتْنَا فِيهَا حَبًّا","hits":[0,2]},{"ref":"80:28","number":5786,"text":"وَعِنَبًا وَقَضْبًا","hits":[0]},{"ref":"80:29","number":5787,"text":"وَزَيْتُونًا وَنَخْلًا","hits":[0,1]},{"ref":"80:30","number":5788,"text":"وَحَدَآئِقَ غُلْبًا","hits":[0]},{"ref":"80:31","number":5789,"text":"وَفَٰكِهَةً وَأَبًّا","hits":[0]},{"ref":"80:32","number":5790,"text":"مَّتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ","hits":[0,2]},{"ref":"80:33","number":5791,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","hits":[]},{"ref":"80:34","number":5792,"text":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","hits":[0,1,2,4]},{"ref":"80:35","number":5793,"text":"وَأُمِّهِۦ وَأَبِيهِ","hits":[0,1]},{"ref":"80:36","number":5794,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","hits":[1]},{"ref":"80:37","number":5795,"text":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ","hits":[1,4,5]},{"ref":"80:38","number":5796,"text":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ","hits":[0]},{"ref":"80:39","number":5797,"text":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ","hits":[]},{"ref":"80:40","number":5798,"text":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","hits":[]},{"ref":"80:41","number":5799,"text":"تَرْهَقُهَا قَتَرَةٌ","hits":[0]},{"ref":"80:42","number":5800,"text":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","hits":[0,1,2]}]}