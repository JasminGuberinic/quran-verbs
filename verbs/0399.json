", "pronoun": "nahnu", "passive": false, "objects": ["hiya"], "mood": "indicative"}], "gloss": {"en": "we decrease it", "bs": "umanjujemo je", "tr": "onu azaltırız", "fr": "nous la diminuons", "id": "kami mengurangi", "ur": "ہم اسے کم کرتے ہیں", "bn": "আমরা তা হ্রাস করি", "fa": "آن را می‌کاهیم"}}, {"arabic": "يَنقُصُوكُمْ", "count": 1, "first": "9:4", "audio": "audio/a674b56766ff67a8a462.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["antum"], "mood": "jussive"}], "gloss": {"en": "they decrease you (all)", "bs": "umanjuju vas", "tr": "sizi azaltırlar", "fr": "ils vous diminuent", "id": "mereka mengurangi kalian", "ur": "وہ تم سب کو کم کرتے ہیں", "bn": "তারা তোমাদের হ্রাস করে", "fa": "شما را کم کنند"}}, {"arabic": "تَنقُصُوا۟", "count": 1, "first": "11:84", "audio": "audio/fd693959666aff20da35.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "you (all) diminish", "bs": "umanjujete", "tr": "azaltırsınız", "fr": "que vous diminuiez", "id": "kalian mengurangi", "ur": "تم سب کم کرتے ہو", "bn": "তোমরা হ্রাস কর", "fa": "کم کنید"}}, {"arabic": "يُنقَصُ", "count": 1, "first": "35:11", "audio": "audio/21059398e0dc9f0ca209.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it is decreased", "bs": "biva umanjen", "tr": "azaltılır", "fr": "il est diminué", "id": "dia dikurangi", "ur": "وہ کم کیا جاتا ہے", "bn": "তাকে হ্রাস করা হয়", "fa": "کاسته می‌شود"}}, {"arabic": "تَنقُصُ", "count": 1, "first": "50:4", "audio": "audio/6b4e15e62fde6b51c315.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "umanjuje", "en": "diminishes", "tr": "eksiltir", "fr": "diminue", "id": "ia mengurangi", "ur": "وہ گھٹاتی ہے", "bn": "সেটি কমিয়ে দেয়", "fa": "می‌کاهد"}}, {"arabic": "ٱنقُصْ", "count": 1, "first": "73:3", "audi