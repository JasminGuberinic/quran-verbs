ation": {"bs": "Izgubili su nadu da će popraviti auto.", "en": "They gave up hope of repairing the car.", "bn": "তারা গাড়ি মেরামতের আশা ছেড়ে দিল।", "fa": "آنان از تعمیر ماشین ناامید شدند.", "fr": "Ils ont perdu l'espoir de réparer la voiture.", "id": "Mereka berputus asa untuk memperbaiki mobil itu.", "tr": "Arabayı tamir etmekten ümidini kestiler.", "ur": "وہ گاڑی کی مرمت سے مایوس ہو گئے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَئِسُوا", "target": true, "translation": {"bs": "izgubili su nadu", "en": "they despaired", "bn": "তারা হতাশ হল", "fa": "ناامید شدند", "fr": "ils ont désespéré", "id": "mereka berputus asa", "tr": "ümidini kestiler", "ur": "وہ مایوس ہو گئے"}}, {"arabic": "مِنْ", "target": false, "translation": {"bs": "od", "en": "of", "bn": "-কে", "fa": "را", "fr": "de", "id": "terhadap", "tr": "-ile", "ur": "کا"}}, {"arabic": "إِصْلَاحِ", "target": false, "translation": {"bs": "popravke", "en": "restoration", "bn": "মেরামত", "fa": "تعمیر", "fr": "de réparer", "id": "memperbaiki", "tr": "tamir", "ur": "مرمت"}}, {"arabic": "السَّيَّارَةِ", "target": false, "translation": {"bs": "auta", "en": "the car", "bn": "গাড়ি", "fa": "ماشین", "fr": "la voiture", "id": "mobil itu", "tr": "araba", "ur": "گاڑی"}}]}]}