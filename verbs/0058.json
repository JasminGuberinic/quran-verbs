{"rank": 58, "root": "نصر", "form": 1, "lemma": "نَصَرَ", "count": 59, "ayahCount": 53, "share": 0.3, "meaning": {"bs": "pomoći, dati pobjedu", "en": "to help, to give victory", "tr": "yardım etmek, zafer vermek", "fr": "aider, accorder la victoire", "id": "menolong, memberi kemenangan", "ur": "مدد کرنا، فتح دینا", "bn": "সাহায্য করা, বিজয় দান করা", "fa": "یاری کردن، پیروز گرداندن"}, "lemmaSpoken": "audio/fc380d4bc3bdf7f5b06a.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "نَصَرَ", "plain": "نَصَرَ", "quran": false, "notUsed": false, "spoken": "audio/fc380d4bc3bdf7f5b06a.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَنصُرُ", "plain": "يَنْصُرُ", "quran": true, "notUsed": false, "spoken": "audio/10ab811aa4435367d79f.m4a", "recited": "audio/d5c03370baf6aa029cb6.m4a", "recitedText": "يَنصُرُ"}], "nouns": {"participle": {"lemma": "ناصِر", "count": 11, "spoken": "audio/78f801976436f17ad3ba.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "نَصَرْتُ", "plain": "نَصَرْتُ", "quran": false, "notUsed": false, "spoken": "audio/1e2c803bdba1ecda8e8f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "نَصَرْنَا", "plain": "نَصَرْنَا", "quran": false, "notUsed": false, "spoken": "audio/9a26ea80ecc7c8da6d58.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "نَصَرْتَ", "plain": "نَصَرْتَ", "quran": false, "notUsed": false, "spoken": "audio/92cac9032342fa8df63b.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "نَصَرْتِ", "plain": "نَصَرْتِ", "quran": false, "notUsed": false, "spoken": "audio/deb0d9e8b7318209b370.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "نَصَرْتُمَا", "plain": "نَصَرْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/719f823d3d63d2fd7f31.m4a", "recited": null, "recitedText": null}, {"tense": "past",