e, "notUsed": false, "spoken": "audio/52bf85fb2d8a599c3fba.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَنْشِئْ", "plain": "أَنْشِئْ", "quran": false, "notUsed": false, "spoken": "audio/3de91d193c4b375de919.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَنْشِئِي", "plain": "أَنْشِئِي", "quran": false, "notUsed": false, "spoken": "audio/638eba2b6cd5538ee6ad.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَنْشِئَا", "plain": "أَنْشِئَا", "quran": false, "notUsed": false, "spoken": "audio/f6441f570c69da26f6ac.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَنْشِئُوا", "plain": "أَنْشِئُوا", "quran": false, "notUsed": false, "spoken": "audio/e8ec1abac8d64c42c808.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَنْشِئْنَ", "plain": "أَنْشِئْنَ", "quran": false, "notUsed": false, "spoken": "audio/35ec30d32172781d968b.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "56:35", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5014.mp3", "translation": {"en": {"text": "Lo! We have created them a (new) creation", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz kadınları yeniden inşa ettik (yarattık).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک ہم نے ان عورتوں کو اچھی اٹھان اٹھایا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Kami menciptakan mereka (bidadari-bidadari) dengan langsung", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنشَأْنَٰهُنَّ", "hit": true, "audio": "audio/622d9e08c1b6772c8dae.m4a", "gloss": {"bs": "stvorili smo ih", "en": "We produced them", "tr": "onları çıkardık", "fr": "Nous les avons créées", "id": "Kami menumbuhkan mereka", "ur": "ہم نے انہیں پیدا کیا", "bn": "আমরা তাদের সৃষ্টি করেছি", "fa": "آنان را پدید آوردیم"}}, {"text": "إِنشَآءً", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:78", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2751.mp3", "translation": {"en": {"text": "He it is Who hath created for you ears and eyes and hearts. Small thanks give ye!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Halbuki sizin için o kulağı, o gözleri ve o gönülleri yaratan O'dur. Ne de az şükrediyorsunuz!", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہی ہے جس نے بنائے تمہارے لیے کان اور آنکھیں اور دل تم بہت ہی کم حق مانتے ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Dialah yang telah menciptakan bagi kamu sekalian, pendengaran, penglihatan dan hati. Amat sedikitlah kamu bersyukur.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنشَأَ", "hit": true, "audio": "audio/17a871e8ee3f47289f69.m4a", "gloss": {"en": "he/it produced", "bs": "stvorio je", "tr": "yarattı", "fr": "il a créé", "id": "dia telah menciptakan", "ur": "اُس نے پیدا کیا", "bn": "সে সৃষ্টি করেছে", "fa": "آفرید"}}, {"text": "لَكُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمْعَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْأَبْصَٰرَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْأَفْـِٔدَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "قَلِيلًا", "hit": false, "audio": null, "gloss": null}, {"text": "مَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تَشْكُرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "13:12", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1719.mp3", "translation": {"en": {"text": "He it is Who showeth you the lightning, a fear and a hope, and raiseth the heavy clouds.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Size korku ve ümit içinde şimşeği gösteren ve o yağmur yüklü bulutları meydana getiren O'dur.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہی ہے تمہیں بجلی دکھاتا ہے ڈر کو اور امید کو اور بھاری بدلیاں اٹھاتا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dialah Tuhan yang memperlihatkan kilat kepadamu untuk menimbulkan ketakutan dan harapan, dan Dia mengadakan awan mendung.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "يُرِيكُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبَرْقَ", "hit": false, "audio": null, "gloss": null}, {"text": "خَوْفًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَطَمَعًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَيُنشِئُ", "hit": true, "audio": "audio/fdff590dd50e4b7b1058.m4a", "gloss": {"bs": "i podiže", "en": "and He produces", "tr": "ve çıkarır", "fr": "et Il fait surgir", "id": "dan Dia menumbuhkan", "ur": "اور وہ اٹھاتا ہے", "bn": "এবং তিনি সৃষ্টি করেন", "fa": "و پدید می‌آورد"}}, {"text": "ٱلسَّحَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلثِّقَالَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "56:61", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5040.mp3", "translation": {"en": {"text": "That We may transfigure you and make you what ye know not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Böylece sizin yerinize benzerlerinizi getirelim ve sizi bilmediğiniz bir yaratılışta tekrar var edelim diye (böyle yapıyoruz).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ تم جیسے اور بدل دیں اور تمہاری صورتیں وہ کردیں جس کی تمہیں حبر نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "untuk menggantikan kamu dengan orang-orang yang seperti kamu (dalam dunia) dan menciptakan kamu kelak (di akhirat) dalam keadaan yang tidak kamu ketahui.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "نُّبَدِّلَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْثَٰلَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنُنشِئَكُمْ", "hit": true, "audio": "audio/9e8bdfedd8722f53c4ea.m4a", "gloss": {"en": "and we produce you (all)", "bs": "i stvaramo vas", "tr": "ve sizi yaratırız", "fr": "et nous vous créons", "id": "dan kami menciptakan kalian", "ur": "اور ہم تم سب کو پیدا کرتے ہیں", "bn": "এবং আমরা তোমাদের সৃষ্টি করি", "fa": "و شما را بیافرینیم"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْلَمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "56:72", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5051.mp3", "translation": {"en": {"text": "Was it ye who made the tree thereof to grow, or were We the grower?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onun ağacını siz mi yarattınız, yoksa yaratan biz miyiz?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا تم نے اس کا پیڑ پیدا کیا یا ہم ہیں پیدا کرنے والے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kamukah yang menjadikan kayu itu atau Kamikah yang menjadikannya?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ءَأَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنشَأْتُمْ", "hit": true, "audio": "audio/390d28fbf1b3d13efe7e.m4a", "gloss": {"en": "you (all) produced", "bs": "stvorili ste", "tr": "yarattınız", "fr": "vous avez créé", "id": "kalian telah menciptakan", "ur": "تم سب نے پیدا کیا", "bn": "তোমরা সৃষ্টি করেছ", "fa": "آفریدید"}}, {"text": "شَجَرَتَهَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُنشِـُٔونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَنشَأَكُم", "count": 4, "first": "6:98", "audio": "audio/21007d26c559b26ad4fa.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["antum"]}], "gloss": {"en": "he/it produced you (all)", "bs": "stvorio vas je", "tr": "sizi yarattı", "fr": "il vous a créés", "id": "dia telah menciptakan kalian", "ur": "اُس نے تم سب کو پیدا کیا", "bn": "সে তোমাদের সৃষ্টি করেছে", "fa": "شما را آفرید"}}, {"arabic": "أَنشَأْنَا", "count": 3, "first": "23:31", "audio": "audio/b8356330a3cf5d53a7e2.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "we produced", "bs": "stvorili smo", "tr": "yarattık", "fr": "nous avons créé", "id": "kami telah menciptakan", "ur": "ہم نے پیدا کیا", "bn": "আমরা সৃষ্টি করেছি", "fa": "آفریدیم"}}, {"arabic": "وَأَنشَأْنَا", "count": 2, "first": "6:6", "audio": "audio/ed65879e14f000bc9b99.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "and we produced", "bs": "i stvorili smo", "tr": "ve yarattık", "fr": "et nous avons créé", "id": "dan kami telah menciptakan", "ur": 