 "antuma", "arabic": "أَقْرِضَا", "plain": "أَقْرِضَا", "quran": false, "notUsed": false, "spoken": "audio/53ac929bde52f09d0701.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَقْرِضُوا۟", "plain": "أَقْرِضُوا", "quran": true, "notUsed": false, "spoken": "audio/2aef0706e02b2bff767f.m4a", "recited": "audio/44e4165d9f0aa316bd69.m4a", "recitedText": "وَأَقْرِضُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَقْرِضْنَ", "plain": "أَقْرِضْنَ", "quran": false, "notUsed": false, "spoken": "audio/0bd19d23ac6f5521baee.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "57:11", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5086.mp3", "translation": {"en": {"text": "Who is he that will lend unto Allah a goodly loan, that He may double it for him and his may be a rich reward?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kimdir o, Allah'a güzel bir borç verecek olan ki, Allah da onun verdiğini kat kat artırsın ve onun için şerefli bir mükafat da versin.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کون ہے جو اللہ کو قرض دے اچھا قرض تو وہ اس کے لیے دونے کرے اور اللہ کو عزت کا ثواب دے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Siapakah yang mau meminjamkan kepada Allah pinjaman yang baik, maka Allah akan melipat-gandakan (balasan) pinjaman itu untuknya, dan dia akan memperoleh pahala yang banyak.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَّن", "hit": false, "audio": null, "gloss": null}, {"text": "ذَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "يُقْرِضُ", "hit": true, "audio": "audio/3163efd0abbc228d188e.m4a", "gloss": {"bs": "daje zajam", "en": "(he) lends", "tr": "(o) ödünç verir", "fr": "(il) prête", "id": "(ia) meminjamkan", "ur": "(وہ) قرض دیتا ہے", "bn": "(সে) ধার দেয়", "fa": "(او) قرض می‌دهد"}}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "قَرْضًا", "hit": false, "audio": null, "gloss": null}, {"text": "حَسَنًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَيُضَٰعِفَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْرٌ", "hit": false, "audio": null, "gloss": null}, {"text": "كَرِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "57:18", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5093.mp3", "translation": {"en": {"text": "Lo! those who give alms, both men and women, and lend unto Allah a goodly loan, it will be doubled for them, and theirs will be a rich reward.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Şüphesiz sadaka veren erkeklere ve sadaka veren kadınlara ve Allah'a güzel bir ödünç verenlere, verdikleri kat kat artırılır ve onlara şerefli bir mükafat vardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک صدقہ دینے والے مرد اور صدقہ دینے والی عورتیں اور وہ جنہوں نے اللہ کو اچھا قرض دیا ان کے دونے ہیں اور ان کے لیے عزت کا ثواب ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya orang-orang yang membenarkan (Allah dan Rasul-Nya) baik laki-laki maupun perempuan dan meminjamkan kepada Allah pinjaman yang baik, niscaya akan dilipatgandakan (pembayarannya) kepada mereka; dan bagi mereka pahala yang banyak.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُصَّدِّقِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْمُصَّدِّقَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَقْرَضُوا۟", "hit": true, "audio": "audio/3a8729c7b6ff44a4dcc4.m4a", "gloss": {"bs": "i dali su zajam", "en": "and (they) lent", "tr": "ve (onlar) ödünç verdiler", "fr": "et (ils) ont prêté", "id": "dan (mereka) meminjamkan", "ur": "اور (انہوں نے) قرض دیا", "bn": "এবং (তারা) ধার দিল", "fa": "و (آنان) قرض دادند"}}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "قَرْضًا", "hit": false, "audio": null, "gloss": null}, {"text": "حَسَنًا", "hit": false, "audio": null, "gloss": null}, {"text": "يُضَٰعَفُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْرٌ", "hit": false, "audio": null, "gloss": null}, {"text": "كَرِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "64:17", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5216.mp3", "translation": {"en": {"text": "If ye lend unto Allah a goodly loan, He will double it for you and will forgive you, for Allah is Responsive, Clement,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer Allah'a güzel bir borç verirseniz, Allah onu sizin için kat kat yapar ve sizi bağışlar. Allah çok mükafat verendir, halimdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اگر تم اللہ کو اچھا قرض دو گے وہ تمہارے لیے اس کے دونے کردے گا اور تمہیں بخش دے گا اور اللہ قدر فرمانے والے حلم والا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Jika kamu meminjamkan kepada Allah pinjaman yang baik, niscaya Allah melipat gandakan balasannya kepadamu dan mengampuni kamu. Dan Allah Maha Pembalas Jasa lagi Maha Penyantun.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تُقْرِضُوا۟", "hit": true, "audio": "audio/5e8c7d541d87f1f59ac2.m4a", "gloss": {"en": "you (all) lend", "bs": "posuđujete", "tr": "ödünç verirsiniz", "fr": "que vous prêtiez", "id": "kalian meminjamkan", "ur": "تم سب قرض دیتے ہو", "bn": "তোমরা ধার দাও", "fa": "قرض دهید"}}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "قَرْضًا", "hit": false, "audio": null, "gloss": null}, {"text": "حَسَنًا", "hit": false, "audio": null, "gloss": null}, {"text": "يُضَٰعِفْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَغْفِرْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "شَكُورٌ", "hit": false, "audio": null, "gloss": null}, {"text": "حَلِيمٌ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُقْرِضُ", "count": 2, "first": "2:245", "audio": "audio/3163efd0abbc228d188e.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "daje zajam", "en": "(he) lends", "tr": "(o) ödünç verir", "fr": "(il) prête", "id": "(ia) meminjamkan", "ur": "(وہ) قرض دیتا ہے", "bn": "(সে) ধার দেয়", "fa": "(او) قرض می‌دهد"}}, {"arabic": "وَأَقْرَضْتُمُ", "count": 1, "first": "5:12", "audio": "audio/e80b6c62f85393866d02.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and you (all) lent", "bs": "i posudili ste", "tr": "ve ödünç verdiniz", "fr": "et vous avez prêté", "id": "dan kalian telah meminjamkan", "ur": "اور تم سب نے قرض دیا", "bn": "এবং তোমরা ধার দিয়েছ", "fa": "قرض دادید"}}, {"arabic": "وَأَقْرَضُوا۟", "count": 1, "first": "57:18", "audio": "audio/3a8729c7b6ff44a4dcc4.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "i dali su zajam", "en": "and (they) lent", "tr": "ve (onlar) ödünç verdiler", "fr": "et (ils) ont prêté", "id": "dan (mereka) meminjamkan", "ur": "اور (انہوں نے) قرض دیا", "bn": "এবং (তারা) ধার দিল", "fa": "و (آنان) قرض دادند"}}, {"arabic": "تُقْرِضُوا۟", "count": 1, "first": "64:17", "audio": "audio/5e8c7d541d87f1f59ac2.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "you (all) lend", "bs": "posuđujete", "tr": "ödünç verirsiniz", "fr": "que vous prêtiez", "id": "kalian meminjamkan", "ur": "تم سب قرض دیتے ہو", "bn": "তোমরা ধার দাও", "fa": "قرض دهید"}}, {"arabic": "وَأَقْرِضُوا۟", "count": 1, "first": "73:20", "audio": "audio/44e4165d9f0aa316bd69.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) lend!", "bs": "i posudite!", "tr": "ve ödünç verin!", "fr": "et prêtez !", "id": "dan pinjamkanlah!", "ur": "اور قرض دو!", "bn": "এবং ধার দাও!", "fa": "و قرض دهید!"}}], "ayatFile": "ayat/0429.json", "ayatTranslations": {"en": "ayat/0429.en.json", "tr": "ayat/0429.tr.json", "ur": "ayat/0429.ur.json", "id": "ayat/0429.id.json"}, "sentences": [{"arabic": "يُقْرِضُ الْبَنْكُ التُّجَّارَ", "spoken": "audio/df7b484b69903679aeba.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Banka daje zajam trgovcima.", "en": "The bank lends to the merchants.", "bn": "ব্যাংক ব্যবসায়ীদের ঋণ দেয়।", "fa": "بانک به تاجران قرض می‌دهد.", "fr": "La banque prête aux commerçants.", "id": "Bank meminjamkan uang kepada para pedagang.", "tr": "Banka tüccarlara ödünç verir.", "ur": "بینک تاجروں کو قرض دیتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يُقْرِضُ", "target": true, "translation": {"bs": "daje zajam", "en": "lends", "bn": "ধার দেয়", "fa": "قرض می‌دهد", "fr": "prête", "id": "meminjamkan", "tr": "ödünç verir", "ur": "قرض دیتا ہے"}}, {"arabic": "الْبَنْكُ", "target": false, "translation": {"bs": "banka", "en": "the bank", "bn": "ব্যাংক", "fa": "بانک", "fr": "la banque", "id": "bank", "tr": "banka", "ur": "بینک"}}, {"arabic": "التُّجَّارَ", "target": false, "translation": {"bs": "trgovcima", "en": "the merchants", "bn": "ব্যবসায়ীদের", "fa": "تاجران", "fr": "les commerçants", "id": "para pedagang", "tr": "tüccarlar", "ur": "تاجروں"}}]}, {"arabic": "أَقْرَضُوا صَدِيقَهُمْ مَالًا", "spoken": "audio/c4aad8c578dd07ba1e4a.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Posudili su svom prijatelju novac.", "en": "They lent their friend money.", "bn": "তারা তাদের বন্ধুকে টাকা ধার দিল।", "fa": "آنان به دوست خود مال قرض دادند.", "fr": "Ils ont prêté de l'argent à leur ami.", "id": "Mereka meminjamkan uang kepada teman mereka.", "tr": "Arkadaşlarına ödünç para verdiler.", "ur": "انہوں نے اپنے دوست کو مال قرض دیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَقْرَضُوا", "target": true, "translation": {"bs": "posudili su", "en": "they lent", "bn": "তারা ধার দিল", "fa": "آنان قرض دادند", "fr": "ils ont prêté", "id": "mereka meminjamkan", "tr": "ödünç verdiler", "ur": "انہوں نے قرض دیا"}}, {"arabic": "صَدِيقَهُمْ", "target": false, "translation": {"bs": "svom prijatelju", "en": "their friend", "bn": "তাদের বন্ধু", "fa": "دوستشان", "fr": "leur ami", "id": "teman mereka", "tr": "arkadaşları", "ur": "ان کا دوست"}}, {"arabic": "مَالًا", "target": false, "translation": {"bs": "novac", "en": "money", "bn": "টাকা", "fa": "مال", "fr": "de l'argent", "id": "uang", "tr": "para", "ur": "مال"}}]}, {"arabic": "أَقْرِضُوا جَارَكُمْ", "spoken": "audio/8c70297a02739ae51322.m4a", "tense": "imperative", "pronoun": "antum", "translation": {"bs": "Posudite svom komšiji.", "en": "Lend to your (pl.) neighbor.", "bn": "তোমরা সবাই তোমাদের প্রতিবেশীকে ধার দাও।", "fa": "به همسایه‌تان قرض بدهید.", "fr": "Prêtez à votre voisin.", "id": "Pinjamkanlah kepada tetangga kalian.", "tr": "Komşunuza ödünç verin.", "ur": "اپنے پڑوسی کو قرض دو، تم سب۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَقْرِضُوا", "target": true, "translation": {"bs": "posudite", "en": "lend (pl.)", "bn": "ধার দাও (তোমরা সবাই)", "fa": "قرض بدهید (شما همه)", "fr": "prêtez", "id": "pinjamkanlah, wahai kalian", "tr": "ödünç verin", "ur": "قرض دو (تم سب)"}}, {"arabic": "جَارَكُمْ", "target": false, "translation": {"bs": "svom komšiji", "en": "your (pl.) neighbor", "bn": "তোমাদের প্রতিবেশী", "fa": "همسایه شما", "fr": "votre voisin", "id": "tetangga kalian", "tr": "komşunuz", "ur": "تم سب کا پڑوسی"}}]}, {"arabic": "أَقْرَضْتُمْ أَخَاكُمْ مَالًا", "spoken": "audio/57e453b943dd364b5a1f.m4a", "tense": "past", "pronoun": "antum", "translation": {"bs": "Posudili ste svom bratu novac.", "en": "You (all) lent your (pl.) brother money.", "bn": "তোমরা সবাই তোমাদের ভাইকে টাকা ধার দিলে।", "fa": "شما به برادرتان مال قرض دادید.", "fr": "Vous avez prêté de l'argent à votre frère.", "id": "Kalian meminjamkan uang kepada saudara kalian.", "tr": "Kardeşinize ödünç para verdiniz.", "ur": "تم سب نے اپنے بھائی کو مال قرض دیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَقْرَضْتُمْ", "target": true, "translation": {"bs": "posudili ste", "en": "you (all) lent", "bn": "তোমরা সবাই ধার দিলে", "fa": "شما (همه) قرض دادید", "fr": "vous avez prêté", "id": "kalian meminjamkan", "tr": "ödünç verdiniz", "ur": "تم سب نے قرض دیا"}}, {"arabic": "أَخَاكُمْ", "target": false, "translation": {"bs": "svom bratu", "en": "your (pl.) brother", "bn": "তোমাদের ভাই", "fa": "برادر شما", "fr": "votre frère", "id": "saudara kalian", "tr": "kardeşiniz", "ur": "تم سب کا بھائی"}}, {"arabic": "مَالًا", "target": false, "translation": {"bs": "novac", "en": "money", "bn": "টাকা", "fa": "مال", "fr": "de l'argent", "id": "uang", "tr": "para", "ur": "مال"}}]}]}