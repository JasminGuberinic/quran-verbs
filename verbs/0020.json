": false, "spoken": "audio/89191016c7f4f78a0eaa.m4a", "recited": "audio/96b45fd9e910816ba572.m4a", "recitedText": "يَتَّبِعُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَتَّبِعْنَ", "plain": "يَتَّبِعْنَ", "quran": false, "notUsed": false, "spoken": "audio/53fbd8ca3db3eb40b96e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱتَّبِعْ", "plain": "اِتَّبِعْ", "quran": true, "notUsed": false, "spoken": "audio/552747e8d0aa5b263b3c.m4a", "recited": "audio/701b9cb82aef518bb26e.m4a", "recitedText": "ٱتَّبِعْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِتَّبِعِي", "plain": "اِتَّبِعِي", "quran": false, "notUsed": false, "spoken": "audio/571935bf09547bae083a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِتَّبِعَا", "plain": "اِتَّبِعَا", "quran": false, "notUsed": false, "spoken": "audio/a4a3dca291572e9bbc98.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱتَّبِعُوا۟", "plain": "اِتَّبِعُوا", "quran": true, "notUsed": false, "spoken": "audio/c44c963b0281470c7794.m4a", "recited": "audio/0ec3ac948262ea50a422.m4a", "recitedText": "ٱتَّبِعُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِتَّبِعْنَ", "plain": "اِتَّبِعْنَ", "quran": false, "notUsed": false, "spoken": "audio/a43bf6af1a6d02930b29.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "54:3", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4849.mp3", "translation": {"en": {"text": "They denied (the Truth) and followed their own lusts. Yet everything will come to a decision", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yalanladılar, nefislerinin arzularına uydular. Halbuki her iş yerini bulacaktır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور انہوں نے جھٹلایا اور اپنی خواہشوں کے پیچھے ہوئے اور ہر کام قرار پاچکا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka mendutakan (Nabi) dan mengikuti hawa nafsu mereka, sedang tiap-tiap urusan telah ada ketetapannya", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَكَذَّبُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱتَّبَعُوٓا۟", "hit": true, "audio": "audio/9341ccac0756424f9912.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}]}, {"text": "أَهْوَآءَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَكُلُّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْرٍ", "hit": false, "audio": null, "gloss": null}, {"text": "مُّسْتَقِرٌّ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:111", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3043.mp3", "translation": {"en": {"text": "They said: Shall we put faith in thee, when the lowest (of the people) follow thee?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Â, dediler, senin ardına hep düşük kimseler düşmüşken, biz sana hiç inanır mıyız?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے کیا ہم تم پر ایمان لے آئیں اور تمہارے ساتھ کمینے ہو ےٴ ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka berkata: \"Apakah kami akan beriman kepadamu, padahal yang mengikuti kamu ialah orang-orang yang hina?\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "أَنُؤْمِنُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱتَّبَعَكَ", "hit": true, "audio": "audio/5ea4a747932930c779e9.m4a", "gloss": {"bs": "a slijede te", "en": "and follow you", "tr": "ve sana uymuşlar", "fr": "et te suivent", "id": "dan mengikutimu", "ur": "اور تمہارے ساتھ ہوئے", "bn": "এবং তোমাকে অনুসরণ করে", "fa": "و از تو پیروی کرده‌اند"}}, {"text": "ٱلْأَرْذَلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:21", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3726.mp3", "translation": {"en": {"text": "Follow those who ask of you no fee, and who are rightly guided.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Uyun sizden hiçbir ücret istemeyen o zatlara ki, onlar hidayete ermişlerdir.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ایسوں کی پیروی کرو جو تم سے کچھ نیگ (اجر) نہیں مانگتے اور وہ راہ پر ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ikutilah orang yang tiada minta balasan kepadamu; dan mereka adalah orang-orang yang mendapat petunjuk.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱتَّبِعُوا۟", "hit": true, "audio": "audio/238200845381d85da5e6.m4a", "gloss": {"en": "(you all) follow!", "bs": "slijedite!", "tr": "izleyin!", "fr": "suivez !", "id": "Ikutilah!", "ur": "پیروی کرو!", "bn": "তোমরা অনুসরণ করো!", "fa": "پیروی کنید!"}}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْـَٔلُكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْرًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّهْتَدُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:193", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1147.mp3", "translation": {"en": {"text": "And if ye call them to the Guidance, they follow you not. Whether ye call them or are silent is all one for you.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer siz onları doğru yola çağırsanız, size uymazlar. Onları ha çağırmışsınız, ha çağırmayıp susmuşsunuz, hiç fark etmez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر تم انہیں راہ کی طرف بلاؤ تو تمہارے پیچھے نہ آئیں تم پر ایک سا ہے چاہے انہیں پکارو یا چپ رہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan jika kamu (hai orang-orang musyrik) menyerunya (berhala) untuk memberi petunjuk kepadamu, tidaklah berhala-berhala itu dapat memperkenankan seruanmu; sama saja (hasilnya) buat kamu menyeru mereka ataupun kamu herdiam diri.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَدْعُوهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْهُدَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَّبِعُوكُمْ", "hit": true, "audio": "audio/b0cc76aa4c03c3edfee6.m4a", "gloss": {"en": "they follow you (all)", "bs": "slijede vas", "tr": "sizi izlerler", "fr": "ils vous suivent", "id": "mereka mengikuti kalian", "ur": "وہ تم سب کی پیروی کریں", "bn": "তারা তোমাদের অনুসরণ করে", "fa": "از شما پیروی کنند"}}, {"text": "سَوَآءٌ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَدَعَوْتُمُوهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "صَٰمِتُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "75:18", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5569.mp3", "translation": {"en": {"text": "And when We read it, follow thou the reading;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O halde biz onu okuduğumuz zaman sen onun okunuşunu takip et.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو جب ہم اسے پڑھ چکیں اس وقت اس پڑھے ہوئے کی اتباع کرو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apabila Kami telah selesai membacakannya maka ikutilah bacaannya itu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "قَرَأْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱتَّبِعْ", "hit": true, "audio": "audio/6ac27bb2cc9ac56ee647.m4a", "gloss": {"bs": "pa slijedi", "en": "then follow", "tr": "sen de uy", "fr": "alors suis", "id": "maka ikutilah", "ur": "تو پیروی کرو", "bn": "তখন অনুসরণ কর", "fa": "پس پیروی کن"}}, {"text": "قُرْءَانَهُۥ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:224", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3156.mp3", "translation": {"en": {"text": "As for poets, the erring follow them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Şairler(e gelince), onlara da sapıklar uyar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور شاعروں کی پیرو ی گمراہ کرتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan penyair-penyair itu diikuti oleh orang-orang yang sesat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلشُّعَرَآءُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَّبِعُهُمُ", "hit": true, "audio": "audio/29812149d7932578be81.m4a", "gloss": {"bs": "slijede ih", "en": "follow them", "tr": "onlara uyar", "fr": "les suivent", "id": "mengikuti mereka", "ur": "ان کی پیروی کرتے ہیں", "bn": "তাদের অনুসরণ করে",