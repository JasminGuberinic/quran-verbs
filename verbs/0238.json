{"rank": 238, "root": "لقي", "form": 1, "lemma": "لَقِيَ", "count": 14, "ayahCount": 14, "share": 0.07, "meaning": {"bs": "sresti, susresti", "en": "to meet", "tr": "karşılaşmak, kavuşmak", "fr": "rencontrer", "id": "bertemu", "ur": "ملنا، ملاقات کرنا", "bn": "সাক্ষাৎ করা", "fa": "ملاقات کردن، دیدار کردن"}, "lemmaSpoken": "audio/a228752402a98c17f5e2.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "لَقِيَ", "plain": "لَقِيَ", "quran": false, "notUsed": false, "spoken": "audio/a228752402a98c17f5e2.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَلْقَى", "plain": "يَلْقَى", "quran": false, "notUsed": false, "spoken": "audio/63bd10bd92f6f973c421.m4a", "recited": null, "recitedText": null}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "لَقِيتُ", "plain": "لَقِيتُ", "quran": false, "notUsed": false, "spoken": "audio/2903f834da3c40d37dd8.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "لَقِينَا", "plain": "لَقِينَا", "quran": true, "notUsed": false, "spoken": "audio/d49925c33c30679da9f5.m4a", "recited": "audio/e69a4d6a53d612ce90a0.m4a", "recitedText": "لَقِينَا"}, {"tense": "past", "pronoun": "anta", "arabic": "لَقِيتَ", "plain": "لَقِيتَ", "quran": false, "notUsed": false, "spoken": "audio/5e0e7b09ebaa7acb95ff.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "لَقِيتِ", "plain": "لَقِيتِ", "quran": false, "notUsed": false, "spoken": "audio/bd924b3ac751f5363101.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "لَقِيتُمَا", "plain": "لَقِيتُمَا", "quran": false, "notUsed": false, "spoken": "audio/37fd94db1d2c33b0fc6e.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "لَقِيتُمُ", "plain": "لَقِيتُمْ", "quran": true, "notUsed": false, "spoken": "audio/b504417c90b9b42dceb5.m4a", "recited": "audio/d809a02110ae09eab