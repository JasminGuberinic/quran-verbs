af949e1f6e5283ac22f8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَتْبِعِي", "plain": "أَتْبِعِي", "quran": false, "notUsed": false, "spoken": "audio/e9f057efb7d9ab3a496b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَتْبِعَا", "plain": "أَتْبِعَا", "quran": false, "notUsed": false, "spoken": "audio/0f16de6cfb78b2745a43.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَتْبِعُوا", "plain": "أَتْبِعُوا", "quran": false, "notUsed": false, "spoken": "audio/3f1b925cf9e3a568ae75.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَتْبِعْنَ", "plain": "أَتْبِعْنَ", "quran": false, "notUsed": false, "spoken": "audio/2214d18250e2a968e151.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "18:89", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2229.mp3", "translation": {"en": {"text": "Then he followed a road", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra Zülkarneyn yine bir yol tuttu.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر ایک سامان کے پیچھے چلا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian dia menempuh jalan (yang lain).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَتْبَعَ", "hit": true, "audio": "audio/9920f363906aaf152cf4.m4a", "gloss": {"bs": "krenuo je", "en": "he followed", "tr": "peşine düştü", "fr": "il suivit", "id": "dia mengikuti", "ur": "وہ پیچھے چل پڑا", "bn": "সে অনুসরণ করল", "fa": "پیروی کرد"}}, {"text": "سَبَبًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "28:42", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3294.mp3", "translation": {"en": {"text": "And We made a curse to follow them in this world, and on the Day of Resurrection they will be among the hateful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bu dünyada arkalarına lanet taktık. Onlar, kıyamet gününde de kötülenmişler arasındadır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اس دنیا میں ہم نے ان کے پیچھے لعنت لگائی اور قیامت کے دن ان کا برا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami ikutkanlah laknat kepada mereka di dunia ini; dan pada hari kiamat mereka termasuk orang-orang yang dijauhkan (dari rahmat Allah).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَتْبَعْنَٰهُمْ", "hit": true, "audio": "audio/7c9c91f6fe097399d3a9.m4a", "gloss": {"en": "and we made (a curse) follow them", "bs": "i učinili smo da ih prati", "tr": "ve onların peşine taktık", "fr": "et nous leur avons fait suivre (une malédiction)", "id": "dan kami telah membuat mereka diikuti", "ur": "اور ہم نے لعنت ان کے پیچھے لگائی", "bn": "এবং আমরা তাদের অনুসরণ করিয়েছি", "fa": "و آنان را به دنبال گماشتیم"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذِهِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلدُّنْيَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَعْنَةً", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقِيَٰمَةِ", "hit": false, "audio": null, "gloss": null}, {"text": "هُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَقْبُوحِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "77:17", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5639.mp3", "translation": {"en": {"text": "Then caused the latter folk to follow after?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra geridekileri de onlara katarız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر پچھلوں کو ان کے پیچھے پہنچائیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Lalu Kami iringkan (azab Kami terhadap) mereka dengan (mengazab) orang-orang yang datang kemudian.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "نُتْبِعُهُمُ", "hit": true, "audio": "audio/913d717c6873abbd46a6.m4a", "gloss": {"bs": "dat ćemo da ih slijede", "en": "We make them follow", "tr": "onları peşinden gittiririz", "fr": "Nous les faisons suivre", "id": "Kami menyusulkan mereka", "ur": "ہم انہیں پیچھے لگا دیں گے", "bn": "আমরা তাদের অনুসরণ করাই", "fa": "آنان را از پی می‌فرستیم"}}, {"text": "ٱلْءَاخِرِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "فَأَتْبَعَهُمْ", "count": 2, "first": "10:90", "audio": "audio/a80905395ebd104502a9.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hum"]}], "gloss": {"en": "so he/it followed them", "bs": "pa ih je slijedio", "tr": "böylece onları izledi", "fr": "alors il les a suivis", "id": "maka dia telah mengikuti mereka", "ur": "پس اُس نے ان کی پیروی کی", "bn": "অতএব সে তাদের অনুসরণ করল", "fa": "پس آنان را پیروی کرد"}}, {"arabic": "وَأُتْبِعُوا۟", "count": 2, "first": "11:60", "audio": "audio/6ec15a778d723921a73e.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": true, "objects": []}], "gloss": {"en": "and they were followed", "bs": "i slijeđeni su", "tr": "ve izlendiler", "fr": "et ils ont été suivis", "id": "dan mereka telah diikuti", "ur": "اور ان کی پیروی کی گئی", "bn": "এবং তাদের অনুসরণ করা হলো", "fa": "و پیروی شدند"}}, {"arabic": "فَأَتْبَعَهُۥ", "count": 2, "first": "15:18", "a