"audio/30bfdaa0774e494e5409.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِسْبِقْ", "plain": "اِسْبِقْ", "quran": false, "notUsed": false, "spoken": "audio/11797ffbbc9482efff99.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِسْبِقِي", "plain": "اِسْبِقِي", "quran": false, "notUsed": false, "spoken": "audio/7ab039b18273bb64a96b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِسْبِقَا", "plain": "اِسْبِقَا", "quran": false, "notUsed": false, "spoken": "audio/c8eba11459a39493aec5.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِسْبِقُوا", "plain": "اِسْبِقُوا", "quran": false, "notUsed": false, "spoken": "audio/45b4acdd59fd656b0f3d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِسْبِقْنَ", "plain": "اِسْبِقْنَ", "quran": false, "notUsed": false, "spoken": "audio/75fab395bda73a0fba71.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "37:171", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3959.mp3", "translation": {"en": {"text": "And verily Our word went forth of old unto Our bondmen sent (to warn)", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun ki peygamberlikle gönderilen kullarımız hakkında şu sözümüz geçmiştir: \"Onlar var ya, elbette onlar muzaffer olacaklardır ve elbette bizim ordularımız mutlaka galip geleceklerdir.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہمارا کلام گزر چکا ہے ہمارے بھیجے ہوئے بندوں کے لیے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya telah tetap janji Kami kepada hamba-hamba Kami yang menjadi rasul,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "سَبَقَتْ", "hit": true, "audio": "audio/082cc8b9d509bc7034a2.m4a", "gloss": {"bs": "prethodila je", "en": "preceded", "tr": "geçmişti", "fr": "a précédé", "id": "telah mendahului", "ur": "آگے بڑھ چکی", "bn": "অগ্রগামী হয়েছে", "fa": "پیشی گرفت"}}, {"text": "كَلِمَتُنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لِعِبَادِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُرْسَلِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "8:68", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1228.mp3", "translation": {"en": {"text": "Had it not been for an ordinance of Allah which had gone before, an awful doom had come upon you on account of what ye took.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer Allah'dan bir yazı (hüküm) bulunmasa idi aldığınız fidyeden dolayı size mutlaka büyük bir azab dokunurdu.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اگراللہ پہلے ایک بات لکھ نہ چکا ہوتا تو اے مسلمانو! تم نے جو کافروں سے بدلے کا مال لے لیا اس میں تم پر بڑا عذاب آتا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kalau sekiranya tidak ada ketetapan yang telah terdahulu dari Allah, niscaya kamu ditimpa siksaan yang besar karena tebusan yang kamu ambil.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَّوْلَا", "hit": false, "audio": null, "gloss": null}, {"text": "كِتَٰبٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "سَبَقَ", "hit": true, "audio": "audio/3a22309da87e7ba9b6bf.m4a", "gloss": {"en": "he/it preceded", "bs": "pretekao je", "tr": "öne geçti", "fr": "il a devancé", "id": "dia telah mendahului", "ur": "اُس نے سبقت کی", "bn": "সে অগ্রগামী হলো", "fa": "پیشی گرفت"}}, {"text": "لَمَسَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخَذْتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابٌ", "hit": false, "audio": null, "gloss": null}, {"text": "عَظِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "8:59", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1219.mp3", "translation": {"en": {"text": "And let not those who disbelieve suppose that they can outstrip (Allah's Purpose). Lo! they cannot escape.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O kâfirler ileri geçip kurtulduklarını sanmasınlar. Onlar kesinlikle (bizi) aciz bırakamazlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہرگز کا فر اس گھمنڈ میں نہ رہیں کہ وہ ہاتھ سے نکل گئے بیشک وہ عاجز نہیں کرتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan janganlah orang-orang yang kafir itu mengira, bahwa mereka akan dapat lolos (dari kekuasaan Allah). Sesungguhnya mereka tidak dapat melemahkan (Allah).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَحْسَبَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "سَبَقُوٓا۟", "hit": true, "audio": "audio/d1b19bf57a3b1544ba00.m4a", "gloss": {"en": "they preceded", "bs": "pretekli su", "tr": "öne geçtiler", "fr": "ils ont devancé", "id": "mereka telah mendahului", "ur": "انہوں نے سبقت کی", "bn": "তারা আগে গেল", "fa": "پیشی گرفتند"}}, {"text": "إِنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُعْجِزُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:5", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1807.mp3", "translation": {"en": {"text": "No nation can outstrip its term nor can they lag behind.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hiçbir millet, ecelinin önüne geçemez ve onu geciktiremez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کو ئی گروہ اپنے وعدہ سے آگے نہ بڑھے نہ پیچھے ہٹے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tidak ada suatu umatpun yang dapat mendahului ajalnya, dan tidak (pula) dapat mengundurkan(nya).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْبِقُ", "hit": true, "audio": "audio/a29c728493a03886b674.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}, {"text": "مِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أُمَّةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجَلَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَـْٔخِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:27", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2510.mp3", "translation": {"en": {"text": "They speak not until He hath spoken, and they act by His command.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar Allah'ın sözünün önüne geçmezler, hep O'nun emriyle hareket ederler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بات میں اس سے سبقت نہیں کرتے اور وہ اسی کے حکم پر کاربند ہوتے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka itu tidak mendahului-Nya dengan perkataan dan mereka mengerjakan perintah-perintah-Nya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْبِقُونَهُۥ", "hit": true, "audio": "audio/e381b1b38e7f35790325.m4a", "gloss": {"bs": "pretiču Ga", "en": "they precede Him", "tr": "O'nun önüne geçmezler", "fr": "ils Le devancent", "id": "mereka mendahului-Nya", "ur": "وہ اس سے آگے نہیں بڑھتے", "bn": "তারা তাঁকে ছাড়িয়ে যায় না", "fa": "بر او پیشی نمی‌گیرند"}}, {"text": "بِٱلْقَوْلِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِأَمْرِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْمَلُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "سَبَقَتْ", "count": 7, "first": "10:19", "audio": "audio/082cc8b9d509bc7034a2.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"bs": "prethodila je", "en": "preceded", "tr": "geçmişti", "fr": "a précédé", "id": "telah mendahului", "ur": "آگے بڑھ چکی", "bn": "অগ্রগামী হয়েছে", "fa": "پیشی گرفت"}}, {"arabic": "سَبَقَ", "count": 4, "first": "8:68", "audio": "audio/3a22309da87e7ba9b6bf.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it preceded", "bs": "pretekao je", "tr": "öne geçti", "fr": "il a devancé", "id": "dia telah mendahului", "ur": "اُس نے سبقت کی", "bn": "সে অগ্রগামী হলো", "fa": "پیشی گرفت"}}, {"arabic": "سَبَقَكُم", "count": 2, "first": "7:80", "audio": "audio/1ced4a040e657c06ac73.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["antum"]}], "gloss": {"en": "he/it preceded you (all)", "bs": "pretekao vas je", "tr": "sizden öne geçti", "fr": "il vous a devancés", "id": "dia telah mendahului kalian", "ur": "اُس نے تم پر سبقت لی", "bn": "সে তোমাদের আগে গ