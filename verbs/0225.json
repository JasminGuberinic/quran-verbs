un": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1510.mp3", "translation": {"en": {"text": "Build the ship under Our eyes and by Our inspiration, and speak not unto Me on behalf of those who do wrong. Lo! they will be drowned.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bizim gözetimimiz altında ve vahyimize göre gemiyi yap. Zulüm yapanlar hakkında da bana bir şey söyleme. Çünkü onlar kesinlikle suda boğulacaklardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور کشتی بناؤ ہمارے سامنے اور ہمارے حکم سے اور ظالموں کے بارے میں مجھ سے بات نہ کرنا وہ ضرور ڈوبائے جائیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan buatlah bahtera itu dengan pengawasan dan petunjuk wahyu Kami, dan janganlah kamu bicarakan dengan Aku tentang orang-orang yang zalim itu; sesungguhnya mereka itu akan ditenggelamkan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱصْنَعِ", "hit": true, "audio": "audio/a7c1b0a2922e92c5029c.m4a", "gloss": {"bs": "i napravi", "en": "and build", "tr": "ve yap", "fr": "et construis", "id": "dan bangunlah", "ur": "اور بنا", "bn": "এবং তৈরি করো", "fa": "و بساز"}}, {"text": "ٱلْفُلْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِأَعْيُنِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَوَحْيِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُخَٰطِبْنِى", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ظَلَمُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّغْرَقُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَصْنَعُونَ", "count": 5, "first": "5:14", "audio": "audio/b38aa