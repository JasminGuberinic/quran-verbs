: "ذُرِّيَّتِى", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَقَبَّلْ", "hit": true, "audio": "audio/bc3ad4bfca0b0f27003c.m4a", "gloss": {"bs": "i primi", "en": "and accept", "tr": "ve kabul et", "fr": "et accepte", "id": "dan terimalah", "ur": "اور قبول کر", "bn": "এবং কবুল করো", "fa": "و بپذیر"}}, {"text": "دُعَآءِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تَقَبَّلْ", "count": 1, "first": "2:127", "audio": "audio/c687e95f15d5f099870e.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "accept!", "bs": "prihvati!", "tr": "kabul et!", "fr": "accepte !", "id": "terimalah!", "ur": "قبول کر!", "bn": "গ্রহণ কর!", "fa": "بپذیر!"}}, {"arabic": "فَتَقَبَّلْ", "count": 1, "first": "3:35", "audio": "audio/3fa26b9cca5d993f1120.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "so accept!", "bs": "pa prihvati!", "tr": "böylece kabul et!", "fr": "alors accepte !", "id": "maka terimalah!", "ur": "پس قبول کر!", "bn": "অতএব গ্রহণ কর!", "fa": "پس بپذیر!"}}, {"arabic": "فَتَقَبَّلَهَا", "count": 1, "first": "3:37", "audio": "audio/3b5e693078da6bb34cb2.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hiya"]}], "gloss": {"en": "so he/it accepted her", "bs": "pa ju je prihvatio", "tr": "böylece onu kabul etti", "fr": "alors il l'a accueillie", "id": "maka dia telah menerimanya", "ur": "پس اُس نے اسے قبول کیا", "bn": "অতএব সে তা গ্রহণ করল", "fa": "پس او را پذیرفت"}}, {"arabic": "فَتُقُبِّلَ", "count": 1, "first": "5:27", "audio": "audio/759b28e373ab1d469020.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "so he/it was accepted", "bs": "pa je prihvaćen", "tr": "böylece kabul edildi", "fr": "alors il a été accepté", "id": "maka dia telah diterima", "ur": "پس وہ قبول ک