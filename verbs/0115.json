unna", "arabic": "يَسْتَوِينَ", "plain": "يَسْتَوِينَ", "quran": false, "notUsed": false, "spoken": "audio/7d20d60793b5710f116f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِسْتَوِ", "plain": "اِسْتَوِ", "quran": false, "notUsed": false, "spoken": "audio/868146e148e91557299b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِسْتَوِي", "plain": "اِسْتَوِي", "quran": false, "notUsed": false, "spoken": "audio/7d7c0b59c8161a948097.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِسْتَوِيَا", "plain": "اِسْتَوِيَا", "quran": false, "notUsed": false, "spoken": "audio/a29dfc8b719420d9399c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِسْتَوُوا", "plain": "اِسْتَوُوا", "quran": false, "notUsed": false, "spoken": "audio/6238e4dfcc076e523efe.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِسْتَوِينَ", "plain": "اِسْتَوِينَ", "quran": false, "notUsed": false, "spoken": "audio/d140c12a0eb55a8c56cb.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "53:6", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4790.mp3", "translation": {"en": {"text": "One vigorous; and he grew clear to view", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Ki o) akıl ve görüşünde kuvvetli (bir melek)dir. Hemen (gerçek meleklik şekliyle) doğruldu.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر اس جلوہ نے قصد فرمایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "yang mempunyai akal yang cerdas; dan (Jibril itu) menampakkan diri dengan rupa yang asli.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ذُو", "hit": false, "audio": null, "gloss": null}, {"text": "مِرَّةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱسْتَوَىٰ", "hit": true, "audio": "audio/620b0d4891033fb9fff2.m4a", "gloss": {"bs": "pa se uspravio", "en": "and he rose", "tr": "ve doğruldu", "fr": "et il s'établit", "id": "dan dia bangkit", "ur": "پھر وہ سیدھا ہو گیا", "bn": "এবং সে আরোহণ করল", "fa": "و برآمد"}}]}, {"ref": "35:19", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3679.mp3", "translation": {"en": {"text": "The blind man is not equal with the seer;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ne kör ile gören eşit olur,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور برابر نہیں اندھا اور انکھیارا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan tidaklah sama orang yang buta dengan orang yang melihat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَوِى", "hit": true, "audio": "audio/7d7885cd13abf22a85a8.m4a", "gloss": {"bs": "(nisu) jednaki", "en": "(not) equal are", "tr": "(eşit) değildir", "fr": "(ne) sont (pas) égaux", "id": "(tidak) sama", "ur": "(برابر) نہیں ہوتے", "bn": "(সমান) নয়", "fa": "برابر نیستند"}}, {"text": "ٱلْأَعْمَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْبَصِيرُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "32:18", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3521.mp3", "translation": {"en": {"text": "Is he who is a believer like unto him who is an evil-liver? They are not alike.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Öyle ya iman eden kimse, fâsık olan gibi olur mu? Onlar eşit olamazlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو کیا جو ایمان والا ہے وہ اس جیسا ہوجائے گا جو بے حکم ہے یہ برابر نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apakah orang-orang beriman itu sama dengan orang-orang yang fasik? Mereka tidak sama.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَفَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "مُؤْمِنًا", "hit": false, "audio": null, "gloss": null}, {"text": "كَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَاسِقًا", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَوُۥنَ", "hit": true, "audio": "audio/25885e809fd3020fb2cb.m4a", "gloss": {"en": "they are equal", "bs": "jednaki su", "tr": "eşittirler", "fr": "ils sont égaux", "id": "mereka sama", "ur": "وہ برابر ہیں", "bn": "তারা সমান", "fa": "برابرند"}}]}, {"ref": "11:24", "tense": "present", "category": {"tense": "present", "pronoun": "huma", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1497.mp3", "translation": {"en": {"text": "The similitude of the two parties is as the blind and the deaf and the seer and the hearer. Are they equal in similitude? Will ye not then be admonished?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bu iki ayrı grubun meseli, kör ve sağır ile gören ve işiten gibidir. Bunlar hiç eşit olabilirler mi? Hâlâ düşünmeyecek misiniz?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "دونوں فریق کا حال ایسا ہے جیسے ایک اندھا اور بہرا اور دوسرا دیکھتا اور سنتا کيا ان دونوں حال کا ايک سا ہے تو کياتم دہيان نہيں کرتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Perbandingan kedua golongan itu (orang-orang kafir dan orang-orang mukmin), seperti orang buta dan tuli dengan orang yang dapat melihat dan dapat mendengar. Adakah kedua golongan itu sama keadaan dan sifatnya? Maka tidakkah kamu mengambil pelajaran (daripada perbandingan itu)?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَثَلُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْفَرِيقَيْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "كَٱلْأَعْمَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْأَصَمِّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْبَصِيرِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلسَّمِيعِ", "hit": false, "audio": null, "gloss": null}, {"text": "هَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَوِيَانِ", "hit": true, "audio": "audio/1c061554e4d29eedca1b.m4a", "gloss": {"en": "they (two) are equal", "bs": "jednaki su", "tr": "eşittirler", "fr": "ils (deux) sont égaux", "id": "mereka berdua sama", "ur": "وہ دونوں برابر ہیں", "bn": "তারা দুজন সমান", "fa": "آن دو برابرند"}}, {"text": "مَثَلًا", "hit": false, "audio": null, "gloss": null}, {"text": "أَفَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَذَكَّرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَسْتَوِى", "count": 11, "first": "4:95", "audio": "audio/1b840a87dc7762871673.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "(nisu) jednaki", "en": "(not) equal are", "tr": "(eşit) değildir", "fr": "(ne) sont (pas) égaux", "id": "(tidak) sama", "ur": "(برابر) نہیں ہوتے", "bn": "(সমান) নয়", "fa": "برابر نیستند"}}, {"arabic": "ٱسْتَوَىٰ", "count": 7, "first": "7:54", "audio": "audio/269202d904d5ad0e7b61.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it rose", "bs": "uzdigao se", "tr": "yükseldi", "fr": "il s'est élevé", "id": "dia telah naik", "ur": "وہ کھڑا ہوا", "bn": "সে উঠল", "fa": "برخاست"}}, {"arabic": "يَسْتَوُۥنَ", "count": 3, "first": "9:1