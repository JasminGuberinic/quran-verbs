": "قُوَّةً", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاوِىٓ", "hit": true, "audio": "audio/132b4cb58a909207635b.m4a", "gloss": {"bs": "sklonio bih se", "en": "I (could) take refuge", "tr": "(sığınabilirdim)", "fr": "je (pourrais) me réfugier", "id": "aku (dapat) berlindung", "ur": "میں پناہ لے لیتا", "bn": "আমি আশ্রয় নিতাম", "fa": "پناه می‌گرفتم"}}, {"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "رُكْنٍ", "hit": false, "audio": null, "gloss": null}, {"text": "شَدِيدٍ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "سَـَٔاوِىٓ", "count": 1, "first": "11:43", "audio": "audio/00c23b10018119d8406c.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "I will take refuge", "bs": "sklonit ću se", "tr": "sığınacağım", "fr": "je chercherai refuge", "id": "aku akan berlindung", "ur": "میں پناہ لیتا ہوں", "bn": "আমি আশ্রয় নেব", "fa": "پناه خواهم گرفت"}}, {"arabic": "ءَاوِىٓ", "count": 1, "first": "11:80", "audio": "audio/132b4cb58a909207635b.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "sklonio bih se", "en": "I (could) take refuge", "tr": "(sığınabilirdim)", "fr": "je (pourrais) me réfugier", "id": "aku (dapat) berlindung", "ur": "میں پناہ لے لیتا", "bn": "আমি আশ্রয় নিতাম", "fa": "پناه می‌گرفتم"}}, {"arabic": "أَوَى", "count": 1, "first": "18:10", "audio": "audio/55418d594c8240e1abef.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it took refuge", "bs": "sklonio se", "tr": "sığındı", "fr": "il s'est réfugié", "id": "dia telah berlindung", "ur": "اُس نے پناہ لی", "bn": "সে আশ্রয় নিল", "fa": "پناه گرفت"}}, {"arabic": "فَأْوُۥٓا۟", "count": 1, "first": "18:16", "audio": "audio/960a9657d0a46de0b12a.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) take refuge!", "bs": "pa se sklonite!", "tr": "böylece sığının!", "fr": "alors réfugiez-vous !", "id": "maka berlindunglah kalian!", "ur": "پس پناہ لو!", "bn": "অতএব তোমরা আশ্রয় নাও!", "fa": "پس پناه گیرید!"}}, {"arabic": "أَوَيْنَآ", "count": 1, "first": "18:63", "audio": "audio/5e96a2cd8d2530bff77e.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "we took refuge", "bs": "sklonili smo se", "tr": "sığındık", "fr": "nous nous sommes réfugiés", "id": "kami telah berlindung", "ur": "ہم نے پناہ لی", "bn": "আমরা আশ্রয় নিয়েছি", "fa": "پناه گرفتیم"}}], "ayatFile": "ayat/0445.json", "ayatTranslations": {"en": "ayat/0445.en.json", "tr": "ayat/0445.tr.json", "ur": "ayat/0445.ur.json", "id": "ayat/0445.id.json"}, "sentences": [{"arabic": "أَوَى الطَّائِرُ إِلَى عُشِّهِ", "spoken": "audio/b658f37c3e4b3f6ca6ad.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Ptica se sklonila u svoje gnijezdo.", "en": "The bird took shelter in its nest.", "bn": "পাখিটি তার বাসায় আশ্রয় নিল।", "fa": "پرنده به لانه‌اش پناه برد.", "fr": "L'oiseau s'est abrité dans son nid.", "id": "Burung itu berlindung di sarangnya.", "tr": "Kuş yuvasına sığındı.", "ur": "پرندے نے اپنے گھونسلے میں پناہ لی۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَوَى", "target": true, "translation": {"bs": "sklonila se", "en": "took shelter", "bn": "আশ্রয় নিল", "fa": "پناه گرفت", "fr": "s'est abrité", "id": "berlindung", "tr": "sığındı", "ur": "پناہ لی"}}, {"arabic": "الطَّائِرُ", "target": false, "translation": {"bs": "ptica", "en": "the bird", "bn": "পাখি", "fa": "پرنده", "fr": "l'oiseau", "id": "burung", "tr": "kuş", "ur": "پرندہ"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "u", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "عُشِّهِ", "target": false, "translation": {"bs": "svoje gnijezdo", "en": "its nest", "bn": "তার বাসা", "fa": "لانه‌اش", "fr": "son nid", "id": "sarangnya", "tr": "yuvasına", "ur": "اس کا گھونسلا"}}]}, {"arabic": "آوِي إِلَى فِرَاشِي مُبَكِّرًا", "spoken": "audio/ae56b5b3aeafedb52a86.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Rano liježem u krevet.", "en": "I go to bed early.", "bn": "আমি আগে-আগে বিছানায় যাই।", "fa": "من زود به بستر می‌روم.", "fr": "Je me retire tôt dans mon lit.", "id": "Aku pergi tidur pagi-pagi.", "tr": "Erken yatağıma çekilirim.", "ur": "میں جلدی اپنے بستر پر چلا جاتا ہوں۔"}, "independentlyReviewed": true, "words": [{"arabic": "آوِي", "target": true, "translation": {"bs": "liježem", "en": "I retire", "bn": "আমি যাই", "fa": "من می‌روم", "fr": "je me retire", "id": "aku beristirahat", "tr": "çekilirim", "ur": "میں جاتا ہوں"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "u", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "فِرَاشِي", "target": false, "translation": {"bs": "svoj krevet", "en": "my bed", "bn": "আমার বিছানা", "fa": "بستر من", "fr": "mon lit", "id": "tempat tidurku", "tr": "yatağım", "ur": "میرا بستر"}}, {"arabic": "مُبَكِّرًا", "target": false, "translation": {"bs": "rano", "en": "early", "bn": "আগে-আগে", "fa": "زود", "fr": "tôt", "id": "pagi-pagi", "tr": "erken", "ur": "جلدی"}}]}, {"arabic": "أَوَيْنَا إِلَى الْفُنْدُقِ", "spoken": "audio/a721e7eecfe4a4860c6d.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Sklonili smo se u hotel.", "en": "We took shelter in the hotel.", "bn": "আমরা হোটেলে আশ্রয় নিলাম।", "fa": "ما در هتل پناه گرفتیم.", "fr": "Nous nous sommes abrités à l'hôtel.", "id": "Kami berlindung di hotel.", "tr": "Otele sığındık.", "ur": "ہم نے ہوٹل میں پناہ لی۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَوَيْنَا", "target": true, "translation": {"bs": "sklonili smo se", "en": "we took shelter", "bn": "আমরা আশ্রয় নিলাম", "fa": "ما