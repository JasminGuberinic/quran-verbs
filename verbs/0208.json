ss": {"bs": "otvorili smo", "en": "We have opened", "tr": "açtık", "fr": "Nous avons ouvert", "id": "Kami telah membukakan", "ur": "ہم نے کھول دیے", "bn": "আমরা খুলে দিয়েছি", "fa": "گشوده‌ایم"}}, {"text": "لَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتْحًا", "hit": false, "audio": null, "gloss": null}, {"text": "مُّبِينًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:118", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3050.mp3", "translation": {"en": {"text": "Therefor judge Thou between us, a (conclusive) judgment, and save me and those believers who are with me.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Artık benimle onların arasında sen hükmünü ver. Beni ve beraberimdeki müminleri kurtar.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو مجھ میں اور ان میں پورا فیصلہ کردے اور مجھے اور میرے ساتھ والے مسلمانوں کو نجات دے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "maka itu adakanlah suatu keputusan antaraku dan antara mereka, dan selamatkanlah aku dan orang-orang yang mukmin besertaku\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱفْتَحْ", "hit": true, "audio": "audio/5a96024595b20e013f88.m4a", "gloss": {"bs": "zato presudi", "en": "so judge", "tr": "öyleyse hükmet", "fr": "alors juge", "id": "maka putuskanlah", "ur": "پس فیصلہ کر دے", "bn": "অতএব ফয়সালা করো", "fa": "پس داوری کن"}}, {"text": "بَيْنِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَبَيْنَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتْحًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَجِّنِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "مَّعِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُؤْمِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "34:26", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3632.mp3", "translation": {"en": {"text": "Say: Our Lord will bring us all together, then He will judge between us with truth. He is the All-knowing Judge.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki: \"Rabbimiz hepimizi bir araya toplayacak, sonra da hak hükmü ile aramızı ayıracaktır. Asıl hüküm veren ve her şeyi bilen O'dur.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ ہمارا رب ہم سب کو جمع کرے گا پھر ہم میں سچا فیصلہ فرمادے گا اور وہی ہے بڑا نیاؤ چکانے (درست فیصلہ کرنے) والا سب کچھ جانتا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah: \"Tuhan kita akan mengumpulkan kita semua, kemudian Dia memberi keputusan antara kita dengan benar. Dan Dialah Maha Pemberi keputusan lagi Maha Mengetahui\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَجْمَعُ", "hit": false, "audio": null, "gloss": null}, {"text": "بَيْنَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "يَفْتَحُ", "hit": true, "audio": "audio/75457bfc8fd93aa14f79.m4a", "gloss": {"bs": "presudit će", "en": "He will judge", "tr": "hükmedecek", "fr": "Il jugera", "id": "Dia akan memutuskan", "ur": "وہ فیصلہ کرے گا", "bn": "তিনি ফয়সালা করবেন", "fa": "داوری خواهد کرد"}}, {"text": "بَيْنَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْحَقِّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْفَتَّاحُ", "hit": false, "audio": null, "g