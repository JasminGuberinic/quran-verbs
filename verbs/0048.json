{"rank": 48, "root": "غفر", "form": 1, "lemma": "غَفَرَ", "count": 65, "ayahCount": 62, "share": 0.34, "meaning": {"bs": "oprostiti", "en": "to forgive", "tr": "bağışlamak, affetmek", "fr": "pardonner", "id": "mengampuni", "ur": "بخشنا، مغفرت کرنا", "bn": "ক্ষমা করা", "fa": "آمرزیدن"}, "lemmaSpoken": "audio/1064329c0c28d2125a38.m4a", "animation": "<svg class=\"va va-vghfr_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes vghfr_1-0{from{opacity:1}}@keyframes vghfr_1-1{from{transform:none}}.va-vghfr_1 .st{opacity:0;animation:vghfr_1-0 1s ease-out 0.6s both}.va-vghfr_1 .cl{transform:translateX(56px);animation:vghfr_1-1 1.6s ease-in-out both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-vghfr_1.off,.va-vghfr_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-vghfr_1,.va-vghfr_1 *{animation:none!important}}</style><rect class=\"p\" x=\"26\" y=\"12\" width=\"68\" height=\"44\" rx=\"2\"/><path class=\"q st\" d=\"M48 26q8-6 16 0q10 4 6 12q-6 8-16 4q-10-6-6-16z\"/><rect class=\"q cl\" x=\"24\" y=\"26\" width=\"12\" height=\"16\" rx=\"2\"/></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "غَفَرَ", "plain": "غَفَرَ", "quran": true, "notUsed": false, "spoken": "audio/1064329c0c28d2125a38.m4a", "recited": "audio/b899c4a2039d8611d7f7.m4a", "recitedText": "غَفَرَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَغْفِرُ", "plain": "يَغْفِرُ", "quran": true, "notUsed": false, "spoken": "audio/fba6129c71da376043d8.m4a", "recited": "audio/b50b8b299ba60482b3ca.m4a", "recitedText": "يَغْفِرُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱغْفِرْ", "plain": "اِغْفِرْ", "quran": true, "notUsed": false, "spoken": "audio/c4f5c52bb489116530d7.m4a", "recited": "audio/9dbad23506f022a31532.m4a", "recitedText": "ٱغْفِرْ"}], "nouns": {"participle": {"