{"ayat":[{"ref":"92:1","number":6059,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰ","hits":[0,1,2]},{"ref":"92:2","number":6060,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","hits":[0]},{"ref":"92:3","number":6061,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","hits":[0,1,2,3]},{"ref":"92:4","number":6062,"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","hits":[0,1]},{"ref":"92:5","number":6063,"text":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","hits":[0,1,2,3]},{"ref":"92:6","number":6064,"text":"وَصَدَّقَ بِٱلْحُسْنَىٰ","hits":[0]},{"ref":"92:7","number":6065,"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","hits":[0]},{"ref":"92:8","number":6066,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","hits":[2,3]},{"ref":"92:9","number":6067,"text":"وَكَذَّبَ بِٱلْحُسْنَىٰ","hits":[0]},{"ref":"92:10","number":6068,"text":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","hits":[]},{"ref":"92:11","number":6069,"text":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","hits":[1,2,3]},{"ref":"92:12","number":6070,"text":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","hits":[1,2]},{"ref":"92:13","number":6071,"text":"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ","hits":[1]},{"ref":"92:14","number":6072,"text":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ","hits":[0,1]},{"ref":"92:15","number":6073,"text":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","hits":[0,1,2]},{"ref":"92:16","number":6074,"text":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","hits":[0,2]},{"ref":"92:17","number":6075,"text":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","hits":[]},{"ref":"92:18","number":6076,"text":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","hits":[1,3]},{"ref":"92:19","number":6077,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ","hits":[3,4,5]},{"ref":"92:20","number":6078,"text":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","hits":[2,3]},{"ref":"92:21","number":6079,"text":"وَلَسَوْفَ يَرْضَىٰ","hits":[0,1]}]}