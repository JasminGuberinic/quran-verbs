: "imperative", "pronoun": "anti", "arabic": "رُدِّي", "plain": "رُدِّي", "quran": false, "notUsed": false, "spoken": "audio/725417caba005ab19af1.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "رُدَّا", "plain": "رُدَّا", "quran": false, "notUsed": false, "spoken": "audio/82f97d18a4db5c0df95f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "رُدُّوا", "plain": "رُدُّوا", "quran": false, "notUsed": false, "spoken": "audio/434ad2d62f67d29ff595.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُرْدُدْنَ", "plain": "اُرْدُدْنَ", "quran": false, "notUsed": false, "spoken": "audio/1720e442d5945b109252.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "3:149", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/442.mp3", "translation": {"en": {"text": "O ye who believe! if ye obey those who disbelieve, they will make you turn back on your heels, and ye turn back as losers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey iman edenler! Siz eğer kâfir olanlara uyarsanız, sizi topuklarınız üstünde gerisin geriye çevirirler. O zaman büsbütün kaybedersiniz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے ایمان والو! اگر تم کافروں کے کہے پر چلے تو وہ تمہیں الٹے پاؤں لوٹادیں گے پھر ٹوٹا کھا کے پلٹ جاؤ گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hai orang-orang yang beriman, jika kamu mentaati orang-orang yang kafir itu, niscaya mereka mengembalikan kamu ke belakang (kepada kekafiran), lalu jadilah kamu orang-orang yang rugi.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَٰٓأَيُّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تُطِيعُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَرُدُّوكُمْ", "hit": true, "audio": "audio/42384fef766c99d3455c.m4a", "gloss": {"bs": "vratit će vas", "en": "they will turn you back", "tr": "sizi geri çevirecekler", "fr": "ils vous feront revenir en arrière", "id": "mereka akan membalikkanmu", "ur": "وہ تمہیں لوٹا دیں گے", "bn": "তারা তোমাদের ফিরিয়ে দেবে", "fa": "شما را برمی‌گردانند"}}, {"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْقَٰبِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَنقَلِبُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "خَٰسِرِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "38:33", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4003.mp3", "translation": {"en": {"text": "(Then he said): Bring them back to me, and fell to slashing (with his sword their) legs and necks.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Geri getirin onları bana!\" dedi ve artık onların bacaklarını, boyunlarını silmeye başladı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر حکم دیا کہ انہیں میرے پاس واپس لاؤ تو ان کی پنڈلیوں اور گردنوں پر ہاتھ پھیرنے لگا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "\"Bawalah kuda-kuda itu kembali kepadaku\". Lalu ia potong kaki dan leher kuda itu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رُدُّوهَا", "hit": true, "audio": "audio/911675d0a7df533546b5.m4a", "gloss": {"bs": "vratite ih", "en": "return them", "tr": "onları geri çevirin", "fr": "ramenez-les", "id": "kembalikanlah mereka", "ur": "انہیں لوٹا دو", "bn": "তোমরা সেগুলো ফিরিয়ে দাও", "fa": "آنها را برگردانید"}}, {"text": "عَلَىَّ", "hit": false, "audio": null, "gloss": null}, {"text": "فَطَفِقَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَسْحًۢا", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلسُّوقِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْأَعْنَاقِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "95:5", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6103.mp3", "translation": {"en": {"text": "Then we reduced him to the lowest of the low,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra da çevirdik aşağıların aşağısına attık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر اسے ہر نیچی سے نیچی حالت کی طرف پھیردیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian Kami kembalikan dia ke tempat yang serendah-rendahnya (neraka),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "رَدَدْنَٰهُ", "hit": true, "audio": "audio/137963238e7a61a5a46c.m4a", "gloss": {"bs": "vratili smo ga", "en": "We returned him", "tr": "onu geri çevirdik", "fr": "Nous l'avons ramené", "id": "Kami mengembalikannya", "ur": "ہم نے اسے لوٹا دیا", "bn": "আমরা তাকে ফিরিয়ে দিয়েছি", "fa": "او را بازگرداندیم"}}, {"text": "أَسْفَلَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَٰفِلِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُرَدُّ", "count": 6, "first": "6:147", "audio": "audio/d4213ac103c3e190f44b.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it is returned", "bs": "biva vraćen", "tr": "geri çevrilir", "fr": "il est renvoyé", "id": "dia dikembalikan", "ur"