abic": "عَلَى", "target": false, "translation": {"bs": "nego", "en": "over", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "atas", "tr": "üzerinde", "ur": "کے اوپر"}}, {"arabic": "الْجَبَلِ", "target": false, "translation": {"bs": "planinu", "en": "the mountain", "bn": "পাহাড়", "fa": "کوه", "fr": "la montagne", "id": "gunung", "tr": "dağ", "ur": "پہاڑ"}}]}, {"arabic": "نُفَضِّلُ الْمَشْيَ صَبَاحًا", "spoken": "audio/a96c519889be2eafccd0.m4a", "tense": "present", "pronoun": "nahnu", "translation": {"bs": "Više volimo šetati ujutro.", "en": "We prefer walking in the morning.", "bn": "আমরা সকালে হাঁটা বেশি পছন্দ করি।", "fa": "پیاده‌روی صبحگاهی را ترجیح می‌دهیم.", "fr": "Nous préférons marcher le matin.", "id": "Kami lebih suka berjalan kaki di pagi hari.", "tr": "Sabah yürüyüşünü tercih ederiz.", "ur": "ہم صبح پیدل چلنے کو ترجیح دیتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "نُفَضِّلُ", "target": true, "translation": {"bs": "više volimo", "en": "we prefer", "bn": "আমরা অগ্রাধিকার দিই", "fa": "ترجیح می‌دهیم", "fr": "nous préférons", "id": "kami lebih menyukai", "tr": "tercih ederiz", "ur": "ہم ترجیح دیتے ہیں"}}, {"arabic": "الْمَشْيَ", "target": false, "translation": {"bs": "šetati", "en": "the walking", "bn": "হাঁটা", "fa": "پیاده‌روی", "fr": "marcher", "id": "berjalan kaki", "tr": "yürüyüş", "ur": "پیدل چلنا"}}, {"arabic": "صَبَاحًا", "target": false, "translation": {"bs": "ujutro", "en": "in the morning", "bn": "সকালে", "fa": "صبح", "fr": "le matin", "id": "pagi hari", "tr": "sabahleyin", "ur": "صبح"}}]}]}