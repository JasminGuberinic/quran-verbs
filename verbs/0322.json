un": "antuma", "arabic": "اِرْكَبَا", "plain": "اِرْكَبَا", "quran": false, "notUsed": false, "spoken": "audio/3abf7ff5441b36038a67.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱرْكَبُوا۟", "plain": "اِرْكَبُوا", "quran": true, "notUsed": false, "spoken": "audio/a04a2107beaf924961b4.m4a", "recited": "audio/168b7276f45577fe587d.m4a", "recitedText": "ٱرْكَبُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِرْكَبْنَ", "plain": "اِرْكَبْنَ", "quran": false, "notUsed": false, "spoken": "audio/78781bc5e25f26fa7f36.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "84:19", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5903.mp3", "translation": {"en": {"text": "That ye shall journey on from plane to plane.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ki, siz elbette halden hale geçeceksiniz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ضرور تم منزل بہ منزل چڑھو گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "sesungguhnya kamu melalui tingkat demi tingkat (dalam kehidupan),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَتَرْكَبُنَّ", "hit": true, "audio": "audio/21e082a433ad11d83df6.m4a", "gloss": {"bs": "sigurno ćete prelaziti", "en": "you will surely pass (from stage to stage)", "tr": "mutlaka (aşamadan aşamaya) geçeceksiniz", "fr": "vous passerez certes (d'étape en étape)", "id": "kamu pasti akan melewati (tahap demi tahap)", "ur": "تم ضرور چڑھو گے (درجہ بدرجہ)", "bn": "তোমরা অবশ্যই (এক স্তর থেকে আরেক স্তরে) আরোহণ করবে", "fa": "قطعاً از حالی به حالی می‌روید"}}, {"text": "طَبَقًا", "hit": false, "audio": null, "gloss": null}, {"text": "عَن", "hit": false, "audio": null, "gloss": null}, {"text": "طَبَقٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "11:41", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1514.mp3", "translation": {"en": {"text": "And he said: Embark therein! In the name of Allah be its course and its mooring. Lo! my Lord is Forgiving, Merciful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Nuh dedi ki; \"Allah'ın adıyla binin içine. Onun akışı da, duruşu da (O'nun adıyladır). Hiç şüphesiz Rabbim gerçekten çok bağışlayıcı, çok esirgeyicidir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بولا اس میں سوار ہو اللہ کے نام پر اس کا چلنا اور اس کا ٹھہرنا بیشک میرا رب ضرور بخشنے والا مہربان ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Nuh berkata: \"Naiklah kamu sekalian ke dalamnya dengan menyebut nama Allah di waktu berlayar dan berlabuhnya\". Sesungguhnya Tuhanku benar-benar Maha Pengampun lagi Maha Penyayang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱرْكَبُوا۟", "hit": true, "audio": "audio/168b7276f45577fe587d.m4a", "gloss": {"bs": "ukrcajte se", "en": "embark", "tr": "binin", "fr": "embarquez", "id": "naiklah", "ur": "سوار ہو جاؤ", "bn": "আরোহণ করো", "fa": "سوار شوید"}}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "بِسْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَجْر۪ىٰهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَمُرْسَىٰهَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّى", "hit": false, "audio": null, "gloss": null}, {"text": "لَغَفُورٌ", "hit": false, "audio": null, "gloss": null}, {"text": "رَّحِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:42", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3747.mp3", "translation": {"en": {"text": "And have created for them of the like thereof whereon they ride.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yine kendileri için onun gibi binecek şeyler yaratmamızdır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان کے لیے ویسی ہی کشتیاں بنادیں جن پر سوار ہوتے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan Kami ciptakan untuk mereka yang akan mereka kendarai seperti bahtera itu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَخَلَقْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "مِّثْلِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَرْكَبُونَ", "hit": true, "audio": "audio/628da32d40c51b1148d5.m4a", "gloss": {"en": "they ride", "bs": "jašu", "tr": "binerler", "fr": "ils montent", "id": "mereka menunggang", "ur": "وہ سوار ہوتے ہیں", "bn": "তারা আরোহণ করে", "fa": "سوار می‌شوند"}}]}], "forms": [{"arabic": "ٱرْكَبُوا۟", "count": 1, "first": "11:41", "audio": "audio/168b7276f45577fe587d.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"bs": "ukrcajte se", "en": "embark", "tr": "binin", "fr": "embarquez", "id": "naiklah", "ur": "سوار ہو جاؤ", "bn": "আরোহণ করো", "fa": "سوار شوید"}}, {"arabic": "ٱرْكَب", "count": 1, "first": "11:42", "audio": "audio/ef41b2caa9cc3a0db01f.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "ride!", "bs": "jaši!", "tr": "bin!", "fr": "monte !", "id": "naiklah!", "ur": "سوار ہو!", "bn": "আরোহণ কর!", "fa": "سوار شو!"}}, {"arabic": "لِتَرْكَبُوهَا", "count": 1, "firs