[{"id":"itada-2-190-7","words":["verb:itada"],"options":[{"bs":"prekoračujete granice","en":"you (all) transgress"},{"bs":"prekoračio je granice","en":"he/it transgressed"},{"bs":"prekršili su","en":"they transgressed"},{"bs":"pa napadnite!","en":"so (you all) attack!"}],"ref":"2:190","answerWord":"تَعْتَدُوٓا۟","answerSound":"audio/fc7800ce7bfa241bf363.m4a","quranTranslation":{"text":"Fight in the way of Allah against those who fight against you, but begin not hostilities. Lo! Allah loveth not aggressors.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"prekoračiti granice","en":"to transgress"},"passage":["وَقَٰتِلُوا۟","فِى","سَبِيلِ","ٱللَّهِ","ٱلَّذِينَ","يُقَٰتِلُونَكُمْ","وَلَا","تَعْتَدُوٓا۟","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","ٱلْمُعْتَدِينَ"],"marked":[7],"facts":{"verb":"اعْتَدَى"}},{"id":"itada-2-65-3","words":["verb:itada"],"options":[{"bs":"prekršili su","en":"they transgressed"},{"bs":"prekoračuju granice","en":"they transgress"},{"bs":"pa napadnite!","en":"so (you all) attack!"},{"bs":"prekoračujete granice","en":"you (all) transgress"}],"ref":"2:65","answerWord":"ٱعْتَدَوْا۟","answerSound":"audio/d0c9dc335af7c948ebea.m4a","quranTranslation":{"text":"And ye know of those of you who broke the Sabbath, how We said unto them: Be ye apes, despised and hated!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"prekoračiti granice","en":"to transgress"},"passage":["وَلَقَدْ","عَلِمْتُمُ","ٱلَّذِينَ","ٱعْتَدَوْا۟","مِنكُمْ","فِى","ٱلسَّبْتِ","فَقُلْنَا","لَهُمْ","كُونُوا۟","قِرَدَةً","خَٰسِـِٔينَ"],"marked":[3],"facts":{"verb":"اعْتَدَى"}},{"id":"itada-2-194-9","words":["verb:itada"],"options":[{"bs":"pa napadnite!","en":"so (you all) attack!"},{"bs":"prekoračujete granice","en":"you (all) transgress"},{"bs":"prekoračio je granice","en":"he/it transgressed"},{"bs":"prekoračujete ih","en":"you (all) transgress them"}],"ref":"2:194","answerWord":"فَٱعْتَدُوا۟","answerSound":"audio/38e524b85495993237ac.m4a","quranTranslation":{"text":"The forbidden month for the forbidden month, and forbidden things in retaliation. And one who attacketh you, attack him in like manner as he attacked you. Observe your duty to Allah, and know that Allah is with those who ward off (evil).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"prekoračiti granice","en":"to transgress"},"passage":["ٱلشَّهْرُ","ٱلْحَرَامُ","بِٱلشَّهْرِ","ٱلْحَرَامِ","وَٱلْحُرُمَٰتُ","قِصَاصٌ","فَمَنِ","ٱعْتَدَىٰ","عَلَيْكُمْ","فَٱعْتَدُوا۟","عَلَيْهِ","بِمِثْلِ","مَا","ٱعْتَدَىٰ","عَلَيْكُمْ","وَٱتَّقُوا۟","ٱللَّهَ","وَٱعْلَمُوٓا۟","أَنَّ","ٱللَّهَ","مَعَ","ٱلْمُتَّقِينَ"],"marked":[9],"facts":{"verb":"اعْتَدَى"}},{"id":"itada-5-107-21","words":["verb:itada"],"options":[{"bs":"prekoračili smo granice","en":"we transgressed"},{"bs":"prekoračuju granice","en":"they transgress"},{"bs":"prekoračio je granice","en":"he/it transgressed"},{"bs":"prekoračujete granice","en":"you (all) transgress"}],"ref":"5:107","answerWord":"ٱعْتَدَيْنَآ","answerSound":"audio/1525a3f8eba7b3bc34f0.m4a","quranTranslation":{"text":"But then, if it is afterwards ascertained that both of them merit (the suspicion of) sin, let two others take their place of those nearly concerned, and let them swear by Allah, (saying): Verily our testimony is truer than their testimony and we have not transgressed (the bounds of duty), for them indeed we should be of the evil-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"prekoračiti granice","en":"to transgress"},"passage":["فَإِنْ","عُثِرَ","عَلَىٰٓ","أَنَّهُمَا","ٱسْتَحَقَّآ","إِثْمًا","فَـَٔاخَرَانِ","يَقُومَانِ","مَقَامَهُمَا","مِنَ","ٱلَّذِينَ","ٱسْتَحَقَّ","عَلَيْهِمُ","ٱلْأَوْلَيَٰنِ","فَيُقْسِمَانِ","بِٱللَّهِ","لَشَهَٰدَتُنَآ","أَحَقُّ","مِن","شَهَٰدَتِهِمَا","وَمَا","ٱعْتَدَيْنَآ","إِنَّآ","إِذًا","لَّمِنَ","ٱلظَّٰلِمِينَ"],"marked":[21],"facts":{"verb":"اعْتَدَى"}},{"id":"khada-74-45-1","words":["verb:khada"],"options":[{"bs":"upuštali smo se","en":"we used to indulge (in falsehood)"},{"bs":"i upustili ste se","en":"and you (all) waded"},{"bs":"upuštaju se","en":"they wade"},{"bs":"upustili su se","en":"they waded"}],"ref":"74:45","answerWord":"نَخُوضُ","answerSound":"audio/cf4426a4085fc7b08418.m4a","quranTranslation":{"text":"We used to wade (in vain dispute) with (all) waders,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zagaziti, upustiti se","en":"to wade, to plunge into"},"passage":["وَكُنَّا","نَخُوضُ","مَعَ","ٱلْخَآئِضِينَ"],"marked":[1],"facts":{"verb":"خَاضَ"}},{"id":"khada-6-68-3","words":["verb:khada"],"options":[{"bs":"upuštaju se","en":"they wade"},{"bs":"upuštali smo se","en":"we used to indulge (in falsehood)"},{"bs":"i upustili ste se","en":"and you (all) waded"},{"bs":"upustili su se","en":"they waded"}],"ref":"6:68","answerWord":"يَخُوضُونَ","answerSound":"audio/89c0a26408eb5a17973c.m4a","quranTranslation":{"text":"And when thou seest those who meddle with Our revelations, withdraw from them until they meddle with another topic. And if the devil cause thee to forget, sit not, after the remembrance, with the congregation of wrong-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zagaziti, upustiti se","en":"to wade, to plunge into"},"passage":["وَإِذَا","رَأَيْتَ","ٱلَّذِينَ","يَخُوضُونَ","فِىٓ","ءَايَٰتِنَا","فَأَعْرِضْ","عَنْهُمْ","حَتَّىٰ","يَخُوضُوا۟","فِى","حَدِيثٍ","غَيْرِهِۦ","وَإِمَّا","يُنسِيَنَّكَ","ٱلشَّيْطَٰنُ","فَلَا","تَقْعُدْ","بَعْدَ","ٱلذِّكْرَىٰ","مَعَ","ٱلْقَوْمِ","ٱلظَّٰلِمِينَ"],"marked":[3],"facts":{"verb":"خَاضَ"}}]