tedText": null}], "ayat": [{"ref": "53:27", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4811.mp3", "translation": {"en": {"text": "Lo! it is those who disbelieve in the Hereafter who name the angels with the names of females.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ahirete iman etmeyenler meleklere dişilerin adlarını takıp duruyorlar", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک وہ جو آخرت پر ایمان رکھتے نہیں ملائکہ کا نام عورتوں کا سا رکھتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya orang-orang yang tiada beriman kepada kehidupan akhirat, mereka benar-benar menamakan malaikat itu dengan nama perempuan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُؤْمِنُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْءَاخِرَةِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَيُسَمُّونَ", "hit": true, "audio": "audio/66e326d1e6af574946ef.m4a", "gloss": {"bs": "zaista nazivaju", "en": "they surely name", "tr": "onlara mutlaka isim verirler", "fr": "ils nomment certes", "id": "mereka sungguh menamai", "ur": "وہ ضرور نام رکھتے ہیں", "bn": "তারা অবশ্যই নাম রাখে", "fa": "قطعاً نام می‌گذارند"}}, {"text": "ٱلْمَلَٰٓئِكَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْمِيَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأُنثَىٰ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "سَمَّيْتُمُوهَآ", "count": 3, "first": "7:71", "audio": "audio/c0945eef4c69e243774f.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": ["hiya"]}], "gloss": {"en": "you (all) named them", "bs": "nazvali ste ih", "tr": "onları adlandırdınız", "fr": "vous les avez nommés", "id": "kalian telah menamai mereka", "ur": "تم سب نے ان کے نام رکھے", "bn": "তোমরা তাদের নাম দিয়েছ", "fa": "آنان را نامیدید"}}, {"arabic": "سَمَّيْتُهَا", "count": 1, "first": "3:36", "audio": "audio/07d318e1618d922b8f0f.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": false, "objects": ["hiya"]}], "gloss": {"en": "I named her", "bs": "nazvao sam je", "tr": "onu adlandırdım", "fr": "je l'ai nommée", "id": "aku telah menamainya", "ur": "میں نے اس کا نام رکھا", "bn": "আমি তার নাম দিয়েছি", "fa": "آن را نامیدم"}}, {"arabic": "سَمُّوهُمْ", "count": 1, "first": "13:33", "audio": "audio/3e344d02c2285056b8b7.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["hum"]}], "gloss": {"en": "(you all) name them!", "bs": "nazovite ih!", "tr": "onları adlandırın!", "fr": "nommez-les !", "id": "namailah mereka!", "ur": "ان کے نام رکھو!", "bn": "তাদের নাম দাও!", "fa": "آنان را بنامید!"}}, {"arabic": "سَمَّىٰكُمُ", "count": 1, "first": "22:78", "audio": "audio/9ba8ad4eea56241d457f.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["antum"]}], "gloss": {"en": "he/it named you (all)", "bs": "nazvao vas je", "tr": "sizi adlandırdı", "fr": "il vous a nommés", "id": "dia telah menamai kalian", "ur": "اُس نے تم سب کا نام رکھا", "bn": "সে তোমাদের নাম দিয়েছে", "fa": "شما را نامید"}}, {"arabic": "لَيُسَمُّونَ", "count": 1, "first": "53:27", "audio": "audio/66e326d1e6af574946ef.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "zaista nazivaju", "en": "they surely name", "tr": "onlara mutlaka isim verirler", "fr": "ils nomment certes", "id": "mereka sungguh menamai", "ur": "وہ ضرور نام رکھتے ہیں", "bn": "তারা অবশ্যই নাম রাখে", "fa": "قطعاً نام می‌گذارند"}}, {"arabic": "تُسَمَّىٰ", "count": 1, "first": "76:18", "audio": "audio/f36dcd21