a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they were arrogant", "bs": "uzoholili su se", "tr": "kibirlendiler", "fr": "ils se sont enorgueillis", "id": "mereka telah menyombongkan diri", "ur": "انہوں نے تکبر کیا", "bn": "তারা অহংকার করল", "fa": "تکبر کردند"}}, {"arabic": "وَٱسْتَكْبَرَ", "count": 3, "first": "2:34", "audio": "audio/7f63a0fa11351ba173e2.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "i uzoholio se", "en": "and was arrogant", "tr": "ve kibirlendi", "fr": "et s'enorgueillit", "id": "dan dia menyombongkan diri", "ur": "اور اس نے تکبر کیا", "bn": "এবং সে অহংকার করল", "fa": "و تکبر ورزید"}}, {"arabic": "تَسْتَكْبِرُونَ", "count": 3, "first": "6:93", "audio": "audio/82362f71e7e89deecc93.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "you (all) are arrogant", "bs": "oholite se", "tr": "kibirleniyorsunuz", "fr": "vous vous enorgueillissez", "id": "kalian menyombongkan diri", "ur": "تم سب تکبر کرتے ہو", "bn": "তোমরা অহংকার কর", "fa": "تکبر می‌کنید"}}, {"arabic": "ٱسْتَكْبَرْتُمْ", "count": 1, "first": "2:87", "audio": "audio/9b23fdd6bf8723722495.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) were arrogant", "bs": "uzoholili ste se", "tr": "kibirlendiniz", "fr": "vous vous êtes enorgueillis", "id": "kalian telah menyombongkan diri", "ur": "تم سب نے تکبر کیا", "bn": "তোমরা অহংকার করেছিলে", "fa": "تکبر کردید"}}, {"arabic": "وَيَسْتَكْبِرْ", "count": 1, "first": "4:172", "audio": "audio/75ab8adc90959c057c5a.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "and he/it is arrogant", "bs": "i oholi se", "tr": "ve kibirlenir", "fr": "et il s'enorgueillit", "id": "dan dia menyombongkan diri", "ur": "اور وہ تکبر کرتا ہے", "bn": "এবং সে অহংকার করে", "fa": "و تکبر کند"}}, {"arabic": "ٱسْتَكْبَرَ", "count": 1, "first": "38:74", "audio": "audio/65763b461f067ad56be6.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it was arrogant", "bs": "uzoholio se", "tr": "kibirlendi", "fr": "il s'est enorgueilli", "id": "dia telah menyombongkan diri", "ur": "اُس نے تکبر کیا", "bn": "সে অহংকার করেছিল", "fa": "تکبر کرد"}}, {"arabic": "أَسْتَكْبَرْتَ", "count": 1, "first": "38:75", "audio": "audio/03dd46a783898a2edad4.m4a", "grammar": [{"tense": "past", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "were you arrogant?", "bs": "zar si se uzoholio?", "tr": "kibirlendin mi?", "fr": "t'es-tu enorgueilli ?", "id": "apakah kamu telah menyombongkan diri?", "ur": "کیا تم نے تکبر کیا؟", "bn": "তুমি কি অহংকার করেছিলে?", "fa": "آیا تکبر کردی؟"}}, {"arabic": "وَٱسْتَكْبَرْتَ", "count": 1, "first": "39:59", "audio": "audio/678d1e51f5eb9a05107a.m4a", "grammar": [{"tense": "past", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "and you were arrogant", "bs": "i uzoholio si se", "tr": "ve kibirlendin", "fr": "et tu t'es enorgueilli", "id": "dan kamu telah menyombongkan diri", "ur": "اور تم نے تکبر کیا", "bn": "এবং তুমি অহংকার করেছিলে", "fa": "و تکبر کردی"}}, {"arabic": "فَٱسْتَكْبَرْتُمْ", "count": 1, "first": "45:31", "audio": "audio/49be30e73ef2b518c1f1.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so you (all) were arrogant", "bs": "pa ste se uzoholili", "tr": "böylece kibirlendiniz", "fr": "alors vous vous êtes enorgueillis", "id": "maka kalian telah menyombongkan diri", "ur": "پس تم سب نے تکبر کیا", "bn": "অতএব তোমরা অহংকার করেছিলে", "fa": "پس تکبر کردید"}}, {"arabic": "وَٱسْتَكْبَرْتُمْ", "count": 1, "first": "46:10", "audio": "audio/f0356d09c81892685d75.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}]}], "ayatFile": "ayat/0097.json", "ayatTranslations": {"en": "ayat/0097.en.json", "tr": "ayat/0097.tr.json", "ur": "ayat/0097.ur.json", "id": "ayat/0097.id.json"}, "sentences": [{"arabic": "اسْتَكْبَرَ الْغَنِيُّ عَلَى الْفَقِيرِ", "spoken": "audio/c12147fb83a7c070533c.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Bogataš se oholio prema siromahu.", "en": "The rich man was arrogant toward the poor man.", "bn": "ধনী লোকটি গরিব লোকটির প্রতি অহংকার করল।", "fa": "ثروتمند بر فقیر تکبر ورزید.", "fr": "Le riche s'est montré arrogant envers le pauvre.", "id": "Orang kaya itu menyombongkan diri terhadap orang miskin.", "tr": "Zengin adam fakire karşı kibirlendi.", "ur": "امیر آدمی نے غریب آدمی کے سامنے تکبر کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "اسْتَكْبَرَ", "target": true, "translation": {"bs": "oholio se", "en": "was arrogant", "bn": "অহংকার করল", "fa": "تکبر ورزید", "fr": "s'est enorgueilli", "id": "menyombongkan diri", "tr": "kibirlendi", "ur": "اس نے تکبر کیا"}}, {"arabic": "الْغَنِيُّ", "target": false, "translation": {"bs": "bogataš", "en": "the rich man", "bn": "ধনী লোক", "fa": "ثروتمند", "fr": "le riche", "id": "orang kaya", "tr": "zengin adam", "ur": "امیر آدمی"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "prema", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "الْفَقِيرِ", "target": false, "translation": {"bs": "siromahu", "en": "the poor man", "bn": "গরিব মানুষ", "fa": "فقیر", "fr": "le pauvre", "id": "orang miskin itu", "tr": "fakir", "ur": "غریب"}}]}, {"arabic": "اسْتَكْبَرُوا عَلَى جِيرَانِهِمْ", "spoken": "audio/573a4ea96cf6d8f1a9fe.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Oholili su se prema svojim komšijama.", "en": "They were arrogant toward their neighbors.", "bn": "তারা তাদের প্রতিবেশীদের প্রতি অহংকার করল।", "fa": "بر همسایگانشان تکبر ورزیدند.", "fr": "Ils se sont montrés arrogants envers leurs voisins.", "id": "Mereka menyombongkan diri terhadap tetangga mereka.", "tr": "Komşularına karşı kibirlendiler.", "ur": "انہوں نے اپنے پڑوسیوں کے سامنے تکبر کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "اسْتَكْبَرُوا", "target": true, "translation": {"bs": "oholili su se", "en": "they were arrogant", "bn": "তারা অহংকার করল", "fa": "تکبر ورزیدند", "fr": "se sont enorgueillis", "id": "mereka menyombongkan diri", "tr": "kibirlendiler", "ur": "انہوں نے تکبر کیا"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "prema", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "جِيرَانِهِمْ", "target": false, "translation": {"bs": "svojim komšijama", "en": "their neighbors", "bn": "তাদের প্রতিবেশীরা", "fa": "همسایگانشان", "fr": "à leurs voisins", "id": "tetangga mereka", "tr": "komşuları", "ur": "ان کے پڑوسی"}}]}, {"arabic": "لَا يَسْتَكْبِرُونَ عَلَى النَّاسِ", "spoken": "audio/a16390a788fc4b8c921c.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Ne ohole se prema ljudima.", "en": "They are not arrogant toward people.", "bn": "তারা মানুষের প্রতি অহংকার করে না।", "fa": "بر مردم تکبر نمی‌ورزند.", "fr": "Ils ne sont pas arrogants envers les gens.", "id": "Mereka tidak menyombongkan diri terhadap orang lain.", "tr": "İnsanlara karşı kibirlenmezler.", "ur": "وہ لوگوں کے سامنے تکبر نہیں کرتے۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "يَسْتَكْبِرُونَ", "target": true, "translation": {"bs": "ohole se", "en": "they are arrogant", "bn": "তারা অহংকার করে", "fa": "تکبر می‌ورزند", "fr": "s'enorgueillissent", "id": "mereka menyombongkan diri", "tr": "kibirlenirler", "ur": "وہ تکبر کرتے ہیں"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "prema", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "النَّاسِ", "target": false, "translation": {"bs": "ljudima", "en": "people", "bn": "মানুষ", "fa": "مردم", "fr": "les gens", "id": "orang-orang", "tr": "insanlar", "ur": "لوگ"}}]}, {"arabic": "اسْتَكْبَرْتُمْ عَلَى أَصْدِقَائِكُمْ", "spoken": "audio/818a071da17c9568fc05.m4a", "tense": "past", "pronoun": "antum", "translation": {"bs": "Oholili ste se prema svojim prijateljima.", "en": "You were arrogant toward your friends.", "bn": "তোমরা তোমাদের বন্ধুদের প্রতি অহংকার করেছিলে।", "fa": "بر دوستانتان تکبر ورزیدید.", "fr": "Vous avez été arrogants envers vos amis.", "id": "Kalian menyombongkan diri terhadap teman-teman kalian.", "tr": "Arkadaşlarınıza karşı kibirlendiniz.", "ur": "تم نے اپنے دوستوں کے سامنے تکبر کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "اسْتَكْبَرْتُمْ", "target": true, "translation": {"bs": "oholili ste se", "en": "you were arrogant", "bn": "তোমরা অহংকার করেছিলে", "fa": "تکبر ورزیدید", "fr": "vous vous êtes enorgueillis", "id": "kalian menyombongkan diri", "tr": "kibirlendiniz", "ur": "تم نے تکبر کیا"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "prema", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "أَصْدِقَائِكُمْ", "target": false, "translation": {"bs": "svojim prijateljima", "en": "your friends", "bn": "তোমাদের বন্ধুরা", "fa": "دوستانتان", "fr": "à vos amis", "id": "teman-teman kalian", "tr": "arkadaşlarınız", "ur": "تمہارے دوست"}}]}, {"arabic": "لَا تَسْتَكْبِرُونَ عَلَى جِيرَانِكُمْ", "spoken": "audio/11e09135b643ce53c7b4.m4a", "tense": "present", "pronoun": "antum", "translation": {"bs": "Ne oholite se prema svojim komšijama.", "en": "You are not arrogant toward your neighbors.", "bn": "তোমরা তোমাদের প্রতিবেশীদের প্রতি অহংকার করো না।", "fa": "بر همسایگانتان تکبر نمی‌ورزید.", "fr": "Vous n'êtes pas arrogants envers vos voisins.", "id": "Kalian tidak menyombongkan diri terhadap tetangga-tetangga kalian.", "tr": "Komşularınıza karşı kibirlenmezsiniz.", "ur": "تم اپنے پڑوسیوں کے سامنے تکبر نہیں کرتے۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "تَسْتَكْبِرُونَ", "target": true, "translation": {"bs": "oholite se", "en": "you are arrogant", "bn": "তোমরা অহংকার করো", "fa": "تکبر می‌ورزید", "fr": "vous vous enorgueillissez", "id": "kalian menyombongkan diri", "tr": "kibirlenirsiniz", "ur": "تم تکبر کرتے ہو"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "prema", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "جِيرَانِكُمْ", "target": false, "translation": {"bs": "svojim komšijama", "en": "your neighbors", "bn": "তোমাদের প্রতিবেশীরা", "fa": "همسایگانتان", "fr": "à vos voisins", "id": "tetangga-tetangga kalian", "tr": "komşularınız", "ur": "تمہارے پڑوسی"}}]}]}