: "anti", "arabic": "اِعْقِلِي", "plain": "اِعْقِلِي", "quran": false, "notUsed": false, "spoken": "audio/c5890bb6b6d39606ba76.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِعْقِلَا", "plain": "اِعْقِلَا", "quran": false, "notUsed": false, "spoken": "audio/06d2b6b948ffb55d8865.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِعْقِلُوا", "plain": "اِعْقِلُوا", "quran": false, "notUsed": false, "spoken": "audio/e0494fb5ca953aaf11b6.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِعْقِلْنَ", "plain": "اِعْقِلْنَ", "quran": false, "notUsed": false, "spoken": "audio/a13ec7ac6688300484c3.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "37:138", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3926.mp3", "translation": {"en": {"text": "And at night-time; have ye then no sense?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve siz elbette sabahleyin ve geceleyin onlara uğrar ve üzerlerinden geçersiniz. Hâlâ akıl edip düşünmez misiniz?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور رات میں تو کیا تمہیں عقل نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan di waktu malam. Maka apakah kamu tidak memikirkan?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَبِٱلَّيْلِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَفَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْقِلُونَ", "hit": true, "audio": "audio/3b3c9e1aa3d7748371fe.m4a", "gloss": {"bs": "(zar ne) razumijete", "en": "(will you not) understand", "tr": "akletmez misiniz", "fr": "(ne) comprenez-vous (pas)", "id": "(tidakkah kamu) memahami", "ur": "(کیا) تم نہیں سمجھتے", "bn": "(তোমরা কি) বুঝবে না", "fa": "(آیا) نمی‌اندیشید"}}]}, {"ref": "29:35", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3375.mp3", "translation": {"en": {"text": "And verily of that We have left a clear sign for people who have sense.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun ki biz, aklını kullanacak bir kavim için oradan apaçık bir ibret nişanesi bırakmışızdır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے اس سے روشن نشانی باقی رکھی عقل والوں کے لیے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya Kami tinggalkan daripadanya satu tanda yang nyata bagi orang-orang yang berakal.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَد", "hit": false, "audio": null, "gloss": null}, {"text": "تَّرَكْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْهَآ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَةًۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بَيِّنَةً", "hit": false, "audio": null, "gloss": null}, {"text": "لِّقَوْمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْقِلُونَ", "hit": true, "audio": "audio/ce8bd7be77dbb3264fe0.m4a", "gloss": {"en": "they understand", "bs": "razumiju", "tr": "anlarlar", "fr": "ils comprennent", "id": "mereka memahami", "ur": "وہ سمجھتے ہیں", "bn": "তারা বোঝে", "fa": "می‌فهمند"}}]}, {"ref": "29:43", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3383.mp3", "translation": {"en": {"text": "As for these similitudes, We coin them for mankind, but none will grasp their meaning save the wise.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte biz bu temsilleri insanlar için getiriyoruz; fakat onları ancak bilenler düşünüp anlayabilir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ مثالیں ہم لوگوں کے لیے بیان فرماتے ہیں، اور انہیں نہیں سمجھتے مگر علم والے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan perumpamaan-perumpamaan ini Kami buat untuk manusia; dan tiada yang memahaminya kecuali orang-orang yang berilmu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَتِلْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَمْثَٰلُ", "hit": false, "audio": null, "gloss": null}, {"text": "نَضْرِبُهَا", "hit": false, "audio": null, "gloss": null}, {"text": "لِلنَّاسِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْقِلُهَآ", "hit": true, "audio": "audio/ff6cc7ab54640ffb9d94.m4a", "gloss": {"en": "he/it understands them", "bs": "razumije ih", "tr": "onları anlar", "fr": "il les comprend", "id": "dia memahami mereka", "ur": "وہ انہیں سمجھتا ہے", "bn": "সে তাদের বোঝে", "fa": "آنان را می‌فهمد"}}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَٰلِمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "67:10", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5251.mp3", "translation": {"en": {"text": "And they say: Had we been wont to listen or have sense, we had not been among the dwellers in the flames.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve derler ki: \"Eğer biz dinleseydik, yahut düşünüp anlasaydık şu çılgın ateşin halkı arasında bulunmazdık!\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور کہیں گے اگر ہم سنتے یا سمجھتے تو دوزخ والوں میں نہ ہوتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka berkata: \"Sekiranya kami mendengarkan atau memikirkan (peringatan itu) niscaya tidaklah kami termasuk penghuni-penghuni neraka 