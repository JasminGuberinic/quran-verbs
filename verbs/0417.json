", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "جِيرَانِكُمْ", "target": false, "translation": {"bs": "svoje komšije", "en": "your (pl.) neighbors", "bn": "তোমাদের প্রতিবেশীরা", "fa": "همسایگانتان", "fr": "vos voisins", "id": "tetangga kalian", "tr": "komşularınız", "ur": "تم سب کے پڑوسی"}}]}, {"arabic": "سَلَّمْتُمُ الْمَفَاتِيحَ لِلْحَارِسِ", "spoken": "audio/404b1989fbe0bab8f432.m4a", "tense": "past", "pronoun": "antum", "translation": {"bs": "Predali ste (svi) ključeve čuvaru.", "en": "You (all) handed over the keys to the guard.", "bn": "তোমরা (সবাই) প্রহরীর কাছে চাবিগুলো হস্তান্তর করেছ।", "fa": "شما (همگی) کلیدها را به نگهبان تحویل دادید.", "fr": "Vous avez remis les clés au gardien, vous tous.", "id": "Kalian menyerahkan kunci-kunci itu kepada penjaga, wahai kalian semua.", "tr": "Anahtarları bekçiye teslim ettiniz.", "ur": "تم سب نے چابیاں پہرے دار کے حوالے کر دیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "سَلَّمْتُمُ", "target": true, "translation": {"bs": "predali ste", "en": "handed over (you all)", "bn": "তোমরা (সবাই) হস্তান্তর করেছ", "fa": "تحویل دادید (شما همگی)", "fr": "vous avez remis (vous tous)", "id": "menyerahkan (kalian semua)", "tr": "teslim ettiniz", "ur": "تم سب نے سپرد کیا"}}, {"arabic": "الْمَفَاتِيحَ", "target": false, "translation": {"bs": "ključeve", "en": "the keys", "bn": "চাবিগুলো", "fa": "کلیدها", "fr": "les clés", "id": "kunci-kunci itu", "tr": "anahtarlar", "ur": "چابیاں"}}, {"arabic": "لِلْحَارِسِ", "target": false, "translation": {"bs": "čuvaru", "en": "to the guard", "bn": "প্রহরীকে", "fa": "به نگهبان", "fr": "au gardien", "id": "kepada penjaga itu", "tr": "bekçiye", "ur": "پہرے دار کو"}}]}]}