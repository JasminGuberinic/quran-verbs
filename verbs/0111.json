": "بَيِّنَا", "plain": "بَيِّنَا", "quran": false, "notUsed": false, "spoken": "audio/67cc8a88d0541bd02a7c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "بَيِّنُوا", "plain": "بَيِّنُوا", "quran": false, "notUsed": false, "spoken": "audio/29cfb0e0fecbb1e41a11.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "بَيِّنَّ", "plain": "بَيِّنَّ", "quran": false, "notUsed": false, "spoken": "audio/8f9e08342254724ab022.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "2:242", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/249.mp3", "translation": {"en": {"text": "Thus Allah expoundeth unto you His revelations so that ye may understand.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte akıllarınız ersin diye, Allah size âyetlerini böylece açıklıyor.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ یونہی بیان کرتا ہے تمہارے لئے اپنی آیتیں کہ کہیں تمہیں سمجھ ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Demikianlah Allah menerangkan kepadamu ayat-ayat-Nya (hukum-hukum-Nya) supaya kamu memahaminya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُبَيِّنُ", "hit": true, "audio": "audio/66c9999092edbf1de221.m4a", "gloss": {"bs": "pojašnjava", "en": "makes clear", "tr": "açıklar", "fr": "explique clairement", "id": "menjelaskan", "ur": "وہ واضح کرتا ہے", "bn": "স্পষ্ট করে দেন", "fa": "روشن می‌کند"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْقِلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "6:105", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/894.mp3", "translation": {"en": {"text": "Thus do We display Our revelations that they may say (unto thee, Muhammad): \"Thou hast studied,\" and that We may make (it) clear for people who have knowledge.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte böylece âyetleri türlü türlü çevirip açıklıyoruz ki, onlar sana: \"Sen bunları bir yerlerden okuyup öğrenmişsin\" desinler ve bilen bir toplum için de onu iyice beyan edelim.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم اسی طرح آیتیں طرح طرح سے بیان کرتے اور اس لیے کہ کافر بول اٹھیں کہ تم تو پڑھے ہو اور اس لیے کہ اسے علم والوں پر واضح کردیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Demikianlah Kami mengulang-ulangi ayat-ayat Kami supaya (orang-orang yang beriman mendapat petunjuk) dan supaya orang-orang musyrik mengatakan: \"Kamu telah mempelajari ayat-ayat itu (dari Ahli Kitab)\", dan supaya Kami menjelaskan Al Quran itu kepada orang-orang yang mengetahui.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَكَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نُصَرِّفُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْءَايَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلِيَقُولُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "دَرَسْتَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلِنُبَيِّنَهُۥ", "hit": true, "audio": "audio/7b7e62e67ff75ce0f109.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["huwa"], "mood": "subjunctive"}]}, {"text": "لِقَوْمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْلَمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "16:44", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1945.mp3", "translation": {"en": {"text": "With clear proofs and writings; and We have revealed unto thee the Remembrance that thou mayst explain to mankind that which hath been revealed for them, and that haply they may reflect.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz o peygamberleri mucizelerle ve kitaplarla gönderdik. Ey Peygamberim! Sana da Kur'ân'ı indirdik ki, insanlara vahyedileni açıklayasın. Belki onlar da düşünürler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "روشن دلیلیں اور کتابیں لے کر اور اے محبوب ہم نے تمہاری ہی طرف یہ یاد گار اتاری کہ تم لوگوں سے بیان کردو جو ان کی طرف اترا اور کہیں وہ دھیان کریں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "keterangan-keterangan (mukjizat) dan kitab-kitab. Dan Kami turunkan kepadamu Al Quran, agar kamu menerangkan pada umat manusia apa yang telah diturunkan kepada mereka dan supaya mereka memikirkan,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "بِٱلْبَيِّنَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلزُّبُرِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنزَلْنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلذِّكْرَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِتُبَيِّنَ", "hit": true, "audio": "audio/1f614f0dbe3d4f8e4724.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "subjunctive"}]}, {"text": "لِلنَّاسِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "نُزِّلَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَعَلَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَفَكَّرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:160", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/167.mp3", "translation": {"en": {"text": "Except those who repent and amend and make manifest (the truth). These it is toward whom I relent. I am the Relenting, the Merciful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ancak tevbe edip halini düzelterek gerçeği söyleyenler başka. İşte onları ben bağışlarım. Ben çok merhamet ediciyim, tevbeleri çokça kabul ederim.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "مگر وہ جو توبہ کریں اور سنواریں اور ظاہر کریں تو میں ان کی توبہ قبول فرماؤں گا اور میں ہی ہوں بڑا توبہ قبول فرمانے والا مہربان،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "kecuali mereka yang telah taubat dan mengadakan perbaikan dan menerangkan (kebenaran), maka terhadap mereka itulah Aku menerima taubatnya dan Akulah Yang Maha Menerima taubat lagi Maha Penyayang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَابُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَصْلَحُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَبَيَّنُوا۟", "hit": true, "audio": "audio/a18a47d0482f28d7d7c5.m4a", "gloss": {"bs": "i pojasne", "en": "and make clear", "tr": "ve açıklasınlar", "fr": "et expliquent clairement", "id": "dan jelaskanlah", "ur": "اور وہ واضح کر دیں", "bn": "এবং তারা স্পষ্ট করে দিয়েছে", "fa": "و روشن کردند"}}, {"text": "فَأُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَتُوبُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلتَّوَّابُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّحِيمُ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُبَيِّنُ", "count": 12, "first": "2:187", "audio": "audio/66c9999092edbf1de221.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "pojašnjava", "en": "makes clear", "tr": "açıklar", "fr": "explique clairement", "id": "menjelaskan", "ur": "وہ واضح کرتا ہے", "bn": "স্পষ্ট করে দেন", "fa": "روشن می‌کند"}}, {"arabic": "يُبَيِّن", "count": 3, "first": "2:68", "audio": "audio/caf25581de67062a7998.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "he/it makes clear", "bs": "pojašnjava", "tr": "açıklar", "fr": "il explique", "id": "dia menjelaskan", "ur": "وہ واضح کرتا ہے", "bn": "সে স্পষ্ট করে", "fa": "روشن کند"}}, {"arabic": "بَيَّنَّا", "count": 3, "first": "2:118", "audio": "audio/59e0dc5bb91a36e05abc.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "we made clear", "bs": "pojasnili smo", "tr": "açıkladık", "fr": "nous avons expliqué", "id": "kami telah menjelaskan", "ur": "ہم نے واضح کیا", "bn": "আমরা স্পষ্ট করেছি", "fa": "روشن کردیم"}}, {"arabic": "لِيُبَيِّنَ", "count": 3, "first": "4:26", "audio": "audio/d5809c2bb72ef6e99184.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "so that he/it may make clear", "bs": "da pojasni", "tr": "açıklasın diye", "fr": "qu'il explique", "id": "agar dia menjelaskan", "ur": "تاکہ وہ واضح کرے", "bn": "যাতে সে স্পষ্ট করে", "fa": "تا روشن کند"}}, {"arabic": "وَيُبَيِّنُ", "count": 2, "first": "2:221", "audio": "audio/0958bca18195a421bcb2.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and he/it makes clear", "bs": "i pojašnjava", "tr": "ve açıklar", "fr": "et il explique", "id": "dan dia menjelaskan", "ur": "اور وہ واضح کرتا ہے", "bn": "এবং সে স্পষ্ট করে", "fa": "و روشن می‌کند"}}, {"arabic": "لِتُبَيِّنَ", "count": 2, "first": "16:44", "audio": "audio/1f614f0dbe3d4f8e4724.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "subjunctive"}]}, {"arabic": "بَيَّنَّٰهُ", "count": 1, "first": "2:159", "audio": "audio/cf27a8d4d14b284c9069.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "we made it clear", "bs": "pojasnili smo ga", "tr": "onu açıkladık", "fr": "nous l'avons expliqué", "id": "kami telah menjelaskannya", "ur": "ہم نے اسے واضح کیا", "bn": "আমরা তা স্পষ্ট করেছি", "fa": "آن را روشن کردیم"}}, {"arabic": "وَبَيَّنُوا۟", "count": 1, "first": "2:160", "audio": "audio/a18a47d0482f28d7d7c5.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "i pojasne", "en": "and make clear", "tr": "ve açıklasınlar", "fr": "et expliquent clairement", "id": "dan jelaskanlah", "ur": "اور وہ واضح کر دیں", "bn": "এবং তারা স্পষ্ট করে দিয়েছে", "fa": "و روشن کردند"}}, {"arabic": "يُبَيِّنُهَا", "count": 1, "first": "2:230", "audio": "audio/059f1ead75b16a80340d.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["hiya"], "mood": "indicative"}], "gloss": {"en": "he/it makes them clear", "bs": "pojašnjava ih", "tr": "onları açıklar", "fr": "il les explique", "id": "dia menjelaskan mereka", "ur": "وہ انہیں واضح کرتا ہے", "bn": "সে তাদের স্পষ্ট করে", "fa": "آنان را روشن می‌کند"}}, {"arabic": "لَتُبَيِّنُنَّهُۥ", "count": 1, "first": "3:187", "audio": "audio/7abba737537efa47b842.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": ["huwa"], "mood": "indicative"}], "gloss": {"en": "surely you (all) will m