/664073f3c132b4762764.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "nahnu", "arabic": "نُخْرِجُ", "plain": "نُخْرِجُ", "quran": true, "notUsed": false, "spoken": "audio/d16cc3022541d34f1d71.m4a", "recited": "audio/63720aef7a54eec75f7d.m4a", "recitedText": "نُخْرِجُ"}, {"tense": "present", "pronoun": "anta", "arabic": "تُخْرِجُ", "plain": "تُخْرِجُ", "quran": true, "notUsed": false, "spoken": "audio/b3c09fd195f31b0db3da.m4a", "recited": "audio/421b8ada48e7c44c8e95.m4a", "recitedText": "تُخْرِجُ"}, {"tense": "present", "pronoun": "anti", "arabic": "تُخْرِجِينَ", "plain": "تُخْرِجِينَ", "quran": false, "notUsed": false, "spoken": "audio/de98c1e3c552ee812475.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تُخْرِجَانِ", "plain": "تُخْرِجَانِ", "quran": false, "notUsed": false, "spoken": "audio/a4afb69235118787e7e5.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تُخْرِجُونَ", "plain": "تُخْرِجُونَ", "quran": true, "notUsed": false, "spoken": "audio/f538bd1967793faa86c3.m4a", "recited": "audio/f29bc6dce04abe85a470.m4a", "recitedText": "تُخْرِجُونَ"}, {"tense": "present", "pronoun": "antunna", "arabic": "تُخْرِجْنَ", "plain": "تُخْرِجْنَ", "quran": false, "notUsed": false, "spoken": "audio/94a46bb97d06e79338f9.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يُخْرِجُ", "plain": "يُخْرِجُ", "quran": true, "notUsed": false, "spoken": "audio/b9907e483a788f943bc4.m4a", "recited": "audio/5379c6f3ee16ff1aef88.m4a", "recitedText": "يُخْرِجُ"}, {"tense": "present", "pronoun": "hiya", "arabic": "تُخْرِجُ", "plain": "تُخْرِجُ", "quran": false, "notUsed": false, "spoken": "audio/b3c09fd195f31b0db3da.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يُخْرِجَانِ", "plain": "يُخْرِجَانِ", "quran": false, "notUsed": false, "spoken": "audio/579ddae068c2b2cc47a1.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يُخْرِجُونَ", "plain": "يُخْرِجُونَ", "quran": true, "notUsed": false, "spoken": "audio/379b798cf6a54ca5a8c8.m4a", "recited": "audio/df92dab8f163531fca34.m4a", "recitedText": "يُخْرِجُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يُخْرِجْنَ", "plain": "يُخْرِجْنَ", "quran": false, "notUsed": false, "spoken": "audio/fda445eeb5ad6e7fc177.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَخْرِجْ", "plain": "أَخْرِجْ", "quran": true, "notUsed": false, "spoken": "audio/e67e6e76ca5fb731f20a.m4a", "recited": "audio/c9f26146614f1ebe708f.m4a", "recitedText": "أَخْرِجْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَخْرِجِي", "plain": "أَخْرِجِي", "quran": false, "notUsed": false, "spoken": "audio/d89919dd25ac7406f861.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَخْرِجَا", "plain": "أَخْرِجَا", "quran": false, "notUsed": false, "spoken": "audio/032fbef2379db7bda946.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَخْرِجُوٓا۟", "plain": "أَخْرِجُوا", "quran": true, "notUsed": false, "spoken": "audio/fa8bb070cd5fb6acd08d.m4a", "recited": "audio/33d73bf7568a6c9b707c.m4a", "recitedText": "أَخْرِجُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَخْرِجْنَ", "plain": "أَخْرِجْنَ", "quran": false, "notUsed": false, "spoken": "audio/70fe4d86c22f885dfaf5.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "71:18", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5437.mp3", "translation": {"en": {"text": "And afterward He maketh you return thereto, and He will bring you forth again, a (new) forthbringing.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra sizi tekrar oraya geri çevirecek ve tekrar çıkaracaktır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر تمہیں اسی میں لے جائے گا اور دبارہ نکالے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "kemudian Dia mengembalikan kamu ke dalam tanah dan mengeluarkan kamu (daripadanya pada hari kiamat) dengan sebenar-benarnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "يُعِيدُكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَيُخْرِجُكُمْ", "hit": true, "audio": "audio/6a8cf848e37c7d2c81af.m4a", "gloss": {"en": "and he/it brings you (all) out", "bs": "i izvodi vas", "tr": "ve sizi çıkarır", "fr": "et il vous fait sortir", "id": "dan dia mengeluarkan kalian", "ur": "اور وہ تم سب کو نکالتا ہے", "bn": "এবং সে তোমাদের বের করে", "fa": "و شما را بیرون می‌آورد"}}, {"text": "إِخْرَاجًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "87:4", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5952.mp3", "translation": {"en": {"text": "Who bringeth forth the pasturage,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Otlağı çıkaran,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جس نے چارہ نکالا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan yang menumbuhkan rumput-rumputan,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخْرَجَ", "hit": true, "audio": "audio/f959a9dbf806f0b06802.m4a", "gloss": {"bs": "izveo je", "en": "brought out", "tr": "çıkardı", "fr": "a fait sortir", "id": "mengeluarkan", "ur": "اس نے نکالا", "bn": "বের করে এনেছেন", "fa": "بیرون آورد"}}, {"text": "ٱلْمَرْعَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:57", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2989.mp3", "translation": {"en": {"text": "Thus did We take them away from gardens and watersprings,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ama (sonunda) biz, onları (Firavun ve kavmini) bahçelerden, pınarlardan,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ہم نے انہیں باہر نکالا باغوں اور چشموں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Kami keluarkan Fir'aun dan kaumnya dari taman-taman dan mata air,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَخْرَجْنَٰهُم", "hit": true, "audio": "audio/d1c92b514c8d14c2ab5c.m4a", "gloss": {"en": "so we expelled them", "bs": "pa smo ih istjerali", "tr": "böylece onları sürdük", "fr": "alors nous les avons expulsés", "id": "maka kami telah mengusir mereka", "ur": "پس ہم نے انہیں نکالا", "bn": "অতএব আমরা তাদের বহিষ্কার করলাম", "fa": "پس آنان را بیرون راندیم"}}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "جَنَّٰتٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَعُيُونٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "78:15", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5687.mp3", "translation": {"en": {"text": "Thereby to produce grain and plant,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onunla taneler ve otlar çıkaralım diye.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ اس سے پیدا فرمائیں اناج اور سبزہ،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "supaya Kami tumbuhkan dengan air itu biji-bijian dan tumbuh-tumbuhan,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لِّنُخْرِجَ", "hit": true, "audio": "audio/d5199327b81e06f76eee.m4a", "gloss": {"bs": "da izvedemo", "en": "so that We bring out", "tr": "çıkarmamız için", "fr": "afin que Nous fassions sortir", "id": "agar Kami keluarkan", "ur": "تاکہ ہم نکالیں", "bn": "যাতে আমরা বের করে আনি", "fa": "تا بیرون آوریم"}}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "حَبًّا", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَبَاتًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:57", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2405.mp3", "translation": {"en": {"text": "He said: Hast come to drive us out from our land by thy magic, O Moses?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Firavun Musa'ya şöyle) dedi: \"Ey Musa! Sen sihrinle bizi yerimizden çıkarmak için mi geldin bize?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولا کیا تم ہمارے پاس اس لیے آئے ہو کہ ہمیں اپنے جادو کے سبب ہماری زمین سے نکال دو اے موسیٰ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berkata Fir'aun: \"Adakah kamu datang kepada kami untuk mengusir kami dari negeri kami (ini) dengan sihirmu, hai Musa?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجِئْتَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لِتُخْرِجَنَا", "hit": true, "audio": "audio/8fb5e8c38c1539978591.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": ["nahnu"], "mood": "subjunctive"}]}, {"text": "مِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْضِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "بِسِحْرِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰمُوسَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:107", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2780.mp3", "translation": {"en": {"text": "Our Lord! Oh, bring us forth from hence! If we return (to evil) then indeed we shall be wrong-doers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbimiz! Bizi buradan çıkar. Eğer bir daha (ettiklerimize) dönersek, artık belli ki biz zalim insanlarız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے رب ہمارے ہم کو دوزخ سے نکال دے پھر اگر ہم ویسے ہی کریں تو ہم ظالم ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ya Tuhan kami, keluarkanlah kami daripadanya (dan kembalikanlah kami ke dunia), maka jika kami kembali (juga kepada kekafiran), sesungguhnya kami adalah orang-orang yang zalim\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رَبَّنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخْرِجْنَا", "hit": true, "audio": "audio/9bff52a1dd19ac3ff210.m4a", "gloss": {"bs": "izvedi nas!", "en": "bring us out!", "tr": "bizi çıkar!", "fr": "fais-nous sortir !", "id": "keluarkanlah kami!", "ur": "ہمیں نکال لے!", "bn": "আমাদের বের করে আনো!", "fa": "ما را بیرون ببر!"}}, {"text": "مِنْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عُدْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ظَٰلِمُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَخْرَجَ", "count": 7, "first": "7:27", "audio": "audio/f959a9dbf806f0b06802.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "izveo je", "en": "brought out", "tr": "çıkardı", "fr": "a fait sortir", "id": "mengeluarkan", "ur": "اس نے نکالا", "bn": "বের করে এনেছেন", "fa": "بیرون آورد"}}, {"arabic": "فَأَخْرَجْنَا", "count": 6, "first": "6:99", "audio": "audio/b8c8dd9424a3e7d6f138.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "so we brought out", "bs": "pa smo izveli", "tr": "böylece çıkardık", "fr": "alors nous avons fait sortir", "id": "maka kami telah mengeluarkan", "ur": "پس ہم نے نکالا", "bn": "অতএব আমরা বের করলাম", "fa": "پس بیرون آوردیم"}}, {"arabic": "يُخْرِجُ", "count": 5, "first": "6:95", "audio": "audio/5379c6f3ee16ff1aef88.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it brings out", "bs": "izvodi", "tr": "çıkarır", "fr": "il fait sortir", "id": "dia mengeluarkan", "ur": "وہ نکالتا ہے", "bn": "সে বের করে", "fa": "بیرون می‌آورد"}}, {"arabic": "فَأَخْرَجَ", "count": 3, "first": "2:22", "audio": "audio/39537d1913e0ddccda46.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "so he/it brought out", "bs": "pa je izveo", "tr": "böylece çıkardı", "fr": "alors il a fait sortir", "id": "maka dia telah mengeluarkan", "ur": "پس اُس نے نکالا", "bn": "অতঃপর সে বের করল", "fa": "پس بیرون آورد"}}, {"arabic": "أَخْرِجْنَا", "count": 3, "first": "4:75", "audio": "audio/fc57a539c919c4652c98.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": ["nahnu"]}], "gloss": {"bs": "izvedi nas!", "en": "bring us out!", "tr": "bizi çıkar!", "fr": "fais-nous sortir !", "id": "keluarkanlah kami!", "ur": "ہمیں نکال لے!", "bn": "আমাদের বের করে আনো!", "fa": "ما را بیرون ببر!"}}, {"arabic": "تُخْرَجُونَ", "count": 3, "first": "7:25", "audio": "audio/42fbcbd4d3208da30a9a.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "you (all) are brought out", "bs": "bivate izvedeni", "tr": "size çıkarılır", "fr": "vous êtes conduits dehors", "id": "kalian dikeluar