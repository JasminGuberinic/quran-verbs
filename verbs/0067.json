alse, "spoken": "audio/d93bd0c6a842a94c0b02.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hunna", "arabic": "يَبْعَثْنَ", "plain": "يَبْعَثْنَ", "quran": false, "notUsed": false, "spoken": "audio/2ae8663dc4895479fc28.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱبْعَثْ", "plain": "اِبْعَثْ", "quran": true, "notUsed": false, "spoken": "audio/c50732a9e8302798c6b4.m4a", "recited": "audio/c224675519a53b67ef1c.m4a", "recitedText": "ٱبْعَثْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِبْعَثِي", "plain": "اِبْعَثِي", "quran": false, "notUsed": false, "spoken": "audio/07a74d8363addd0feb94.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِبْعَثَا", "plain": "اِبْعَثَا", "quran": false, "notUsed": false, "spoken": "audio/a21a66dfec8a16e7effc.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱبْعَثُوا۟", "plain": "اِبْعَثُوا", "quran": true, "notUsed": false, "spoken": "audio/bf2d4442061f25e37fa5.m4a", "recited": "audio/9bfb3b7aa749461f7932.m4a", "recitedText": "فَٱبْعَثُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِبْعَثْنَ", "plain": "اِبْعَثْنَ", "quran": false, "notUsed": false, "spoken": "audio/4eb93e569fe9a09759ac.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "72:7", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5454.mp3", "translation": {"en": {"text": "And indeed they supposed, even as ye suppose, that Allah would not raise anyone (from the dead) -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Doğrusu onlar sizin zannettiğiniz gibi, zannetmişlerdi ki, Allah asla kimseyi Peygamber göndermeyecek.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ کہ انہوں نے گمان کیا جیسا تمہیں گمان ہے کہ اللہ ہرگز کوئی رسول نہ بھیجے گا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya mereka (jin) menyangka sebagaimana persangkaan kamu (orang-orang kafir Mekah), bahwa Allah sekali-kali tidak akan membangkitkan seorang (rasul)pun,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ظَنُّوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "كَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "ظَنَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّن", "hit": false, "audio": null, "gloss": null}, {"text": "يَبْعَثَ", "hit": true, "audio": "audio/5a95230be93f12a622f9.m4a", "gloss": {"bs": "(Allah neće) proživjeti", "en": "(God will never) raise", "tr": "(Allah) diriltmeyecek", "fr": "(Dieu ne) ressuscitera (jamais)", "id": "(Allah tidak akan) membangkitkan", "ur": "(اللہ ہرگز) نہیں اٹھائے گا", "bn": "(আল্লাহ কখনও) পুনরুত্থিত করবেন (না)", "fa": "(خدا هرگز) برنخواهد انگیخت"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَحَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:56", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/63.mp3", "translation": {"en": {"text": "Then We revived you after your extinction, that ye might give thanks.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra şükredesiniz diye sizi ölümünüzün ardından yeniden diriltmiştik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر مرے پیچھے ہم نے تمہیں زندہ کیا کہ کہیں تم احسان مانو-", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Setelah itu Kami bangkitkan kamu sesudah kamu mati, supaya kamu bersyukur.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "بَعَثْنَٰكُم", "hit": true, "audio": "audio/40ed7b77cf654dc9e8c2.m4a", "gloss": {"bs": "proživjeli smo vas", "en": "We raised you", "tr": "sizi diriltmiştik", "fr": "Nous vous avons ressuscités", "id": "Kami mengutusmu", "ur": "ہم نے تمہیں اٹھایا", "bn": "আমরা তোমাদের পুনরুত্থিত করেছি", "fa": "شما را برانگیختیم"}}, {"text": "مِّنۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْدِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَوْتِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَشْكُرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "25:41", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2896.mp3", "translation": {"en": {"text": "And when they see thee (O Muhammad) they treat thee only as a jest (saying): Is this he whom Allah sendeth as a messenger?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Seni gördükleri zaman \"Bu mu Allah'ın Peygamber olarak gönderdiği?\" diye hep seni alaya alıyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جب تمہیں دیکھتے ہیں تو تمہیں نہیں ٹھہراتے مگر ٹھٹھا کیا یہ ہیں جن کو اللہ نے رسول بناکر بھیجا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan apabila mereka melihat kamu (Muhammad), mereka hanyalah menjadikan kamu sebagai ejekan (dengan mengatakan): \"Inikah orangnya yang di utus Allah sebagai Rasul?.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "رَأَوْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَّخِذُونَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "هُزُوًا", "hit": false, "audio": null, "gloss": null}, {"text": "أَهَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "بَعَثَ", "hit": true, "audio": "audio/d96e5ddee2a46e1d825f.m4a", "gloss": {"en": "he/it sent", "bs": "poslao je", "tr": "gönderdi", "fr": "il a envoyé", "id": "dia telah mengutus", "ur": "اُس نے بھیجا", "bn": "সে পাঠাল", "fa": "فرستاد"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "رَسُولًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:36", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2968.mp3", "translation": {"en": {"text": "They said: Put him off, (him) and his brother, and send into the cities summoners", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Dediler ki: \"Bunu ve kardeşini eğle, şehirlere de toplayıcılar gönder.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ بولے انہیں ان کے بھائی کو ٹھہرائے رہو اور شہروں میں جمع کرنے والے بھیجو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka menjawab: \"Tundalah (urusan) dia dan saudaranya dan kirimkanlah ke seluruh negeri orang-orang yang akan mengumpulkan (ahli sihir),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْجِهْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَخَاهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱبْعَثْ", "hit": true, "audio": "audio/829984296b2adfe4e1aa.m4a", "gloss": {"bs": "i pošalji!", "en": "and send!", "tr": "ve gönder!", "fr": "et envoie !", "id": "dan utuslah!", "ur": "اور بھیج!", "bn": "এবং প্রেরণ করো!", "fa": "و بفرست!"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَ