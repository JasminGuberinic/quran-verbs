citedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "مَسَّا", "plain": "مَسَّا", "quran": false, "notUsed": false, "spoken": "audio/75b1159dae6d9bca531a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "مَسُّوا", "plain": "مَسُّوا", "quran": false, "notUsed": false, "spoken": "audio/a2312f225b6e5d9284a0.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِمْسَسْنَ", "plain": "اِمْسَسْنَ", "quran": false, "notUsed": false, "spoken": "audio/2ee9cdf28d6a85eabcdb.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "70:20", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5395.mp3", "translation": {"en": {"text": "Fretful when evil befalleth him", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kendisine kötülük dokundu mu sızlanır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جب اسے برائی پہنچے تو سخت گھبرانے والا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apabila ia ditimpa kesusahan ia berkeluh kesah,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَسَّهُ", "hit": true, "audio": "audio/fff0639e84a8ef7da788.m4a", "gloss": {"bs": "(kad ga) zadesi (zlo)", "en": "(when evil) touches him", "tr": "(kötülük) ona dokunduğunda", "fr": "(lorsque le mal) le touche", "id": "(ketika keburukan) menimpanya", "ur": "(جب اسے) تکلیف چھوئے", "bn": "(যখন অনিষ্ট) তাকে স্পর্শ করে", "fa": "(وقتی بدی) به او رسد"}}, {"text": "ٱلشَّرُّ", "hit": false, "audio": null, "gloss": null}, {"text": "جَزُوعًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "56:79", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5058.mp3", "translation": {"en": {"text": "Which none toucheth save the purified,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ona temizlenenlerden başkası el süremez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اسے نہ چھوئیں مگر باوضو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "tidak menyentuhnya kecuali orang-orang yang disucikan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَمَسُّهُۥٓ", "hit": true, "audio": "audio/a64ecdbba200526b42ae.m4a", "gloss": {"bs": "(niko) ga ne dotiče", "en": "(none) touches it", "tr": "(hiç kimse) ona dokunmaz", "fr": "(nul) ne le touche", "id": "(tidak ada yang) menyentuhnya", "ur": "(کوئی) اسے نہیں چھوتا", "bn": "(কেউ) তা স্পর্শ করে না", "fa": "(هیچ‌کس) به آن دست نمی‌زند"}}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُطَهَّرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:156", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3088.mp3", "translation": {"en": {"text": "And touch her not with ill lest there come on you the retribution of an awful day.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Sakın ona bir kötülükle ilişmeyin, yoksa sizi büyük bir günün azabı yakalayıverir.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اسے برائی کے ساتھ نہ چھوؤ کہ تمہیں بڑے دن کا عذاب آلے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan janganlah kamu sentuh unta betina itu dengan sesuatu kejahatan, yang menyebabkan kamu akan ditimpa oleh azab hari yang besar\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَمَسُّوهَا", "hit": true, "audio": "audio/c9e9f3875a8ca733a0aa.m4a", "gloss": {"en": "you (all) touch her", "bs": "dotičete je", "tr": "ona dokunursunuz", "fr": "que vous la touchiez", "id": "kalian menyentuhnya", "ur": "تم سب اسے چھوتے ہو", "bn": "তোমরা তাকে স্পর্শ কর", "fa": "آن را لمس کنید"}}, {"text": "بِسُوٓءٍ", "hit": false, "audio": null, "gloss": null}, {"text": "فَيَأْخُذَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "عَظِيمٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:46", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2529.mp3", "translation": {"en": {"text": "And if a breath of thy Lord's punishment were to touch them, they assuredly would say: Alas for us! Lo! we were wrong-doers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yemin olsun ki, Rabbinin azabından az bir şey onlara dokunursa, muhakkak \"Vay bizlere, biz gerçekten zalimlerdik\" diyeceklerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر انہیں تمہارے رب کے عذاب کی ہوا چھو جائے تو ضرور کہیں گے ہائے خرابی ہماری بیشک ہم ظالم تھے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya, jika mereka ditimpa sedikit saja dari azab Tuhan-mu, pastilah mereka berkata: \"Aduhai, celakalah kami, bahwasanya kami adalah orang yang menganiaya diri sendiri\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَئِن", "hit": false, "audio": null, "gloss": null}, {"text": "مَّسَّتْهُمْ", "hit": true, "audio": "audio/8d8434aadaa9984d0af9.m4a", "gloss": {"en": "she/it touched them", "bs": "dotaknula ih je", "tr": "onlara dokundu", "fr": "elle les a touchés", "id": "dia telah menyentuh mereka", "ur": "اُس نے انہیں چھوا", "bn": "সে তাদের স্পর্শ করল", "fa": "آنان را لمس کرد"}}, 