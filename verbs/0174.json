se, "spoken": "audio/2bb37e27a3fbc31b1523.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱقْصُصِ", "plain": "اُقْصُصْ", "quran": true, "notUsed": false, "spoken": "audio/4d57572ea7d28c8558d7.m4a", "recited": "audio/ee54a30b2d2c30bc6081.m4a", "recitedText": "فَٱقْصُصِ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "قُصِّي", "plain": "قُصِّي", "quran": false, "notUsed": false, "spoken": "audio/c09e86f9c394461735b6.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "قُصَّا", "plain": "قُصَّا", "quran": false, "notUsed": false, "spoken": "audio/d3fbd1cfa533920e2c20.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "قُصُّوا", "plain": "قُصُّوا", "quran": false, "notUsed": false, "spoken": "audio/63e38c7bc96fbf8a9e91.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُقْصُصْنَ", "plain": "اُقْصُصْنَ", "quran": false, "notUsed": false, "spoken": "audio/c125c454698e8cd50913.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "7:7", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/961.mp3", "translation": {"en": {"text": "Then verily We shall narrate unto them (the event) with knowledge, for We were not absent (when it came to pass).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve elbette onlara, olanbiten herşeyi bir bilgi ile anlatacağız; çünkü biz onlardan uzak değiliz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ضرور ہم ان کو بتادیں گے اپنے علم سے اور ہم کچھ غائب نہ تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "maka sesungguhnya akan Kami kabarkan kepada mereka (apa-apa yang telah mereka perbuat), sedang (Kami) mengetahui (keadaan mereka), dan Kami sekali-kali tidak jauh (dari mereka).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَنَقُصَّنَّ", "hit": true, "audio": "audio/d6fb8f3031c0540b0c45.m4a", "gloss": {"bs": "pa ćemo sigurno kazivati", "en": "then We will surely narrate", "tr": "sonra mutlaka anlatacağız", "fr": "alors Nous raconterons certes", "id": "kemudian sungguh Kami akan menceritakan", "ur": "پھر ہم ضرور بیان کریں گے", "bn": "তখন আমরা অবশ্যই বর্ণনা করব", "fa": "پس قطعاً حکایت خواهیم کرد"}}, {"text": "عَلَيْهِم", "hit": false, "audio": null, "gloss": null}, {"text": "بِعِلْمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "غَآئِبِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "27:76", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3235.mp3", "translation": {"en": {"text": "Lo! this Qur'an narrateth unto the Children of Israel most of that concerning which they differ.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Haberiniz olsun ki bu Kur'ân, İsrail oğullarına, hakkında ihtilaf edegeldikleri şeylerin pek çoğunu anlatmaktadır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک یہ قرآن ذکر فرماتا ہے بنی اسرائیل سے اکثر وہ باتیں جس میں وہ اختلاف کرتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Al Quran ini menjelaskan kepada Bani lsrail sebahagian besar dari (perkara-perkara) yang mereka berselisih tentangnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقُرْءَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُصُّ", "hit": true, "audio": "audio/f709cddfc07d98474ea1.m4a", "gloss": {"en": "he/it narrates", "bs": "kazuje", "tr": "anlatır", "fr": "il raconte", "id": "dia menceritakan", "ur": "وہ بیان کرتا ہے", "bn": "সে বর্ণনা করে", "fa": "روایت می‌کند"}}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "بَنِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِسْرَٰٓءِيلَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَكْثَرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "هُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَخْتَلِفُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "28:11", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anti", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3263.mp3", "translation": {"en": {"text": "And she said unto his sister: Trace him. So she observed him from afar, and they perceived not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Annesi Musa'nın ablasına, \"Onun izini takip et\" dedi. O da, onlar farkına varmadan uzaktan kardeşini gözetledi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اس کی ماں نے اس کی بہن سے کہا اس کے پیچھے چلی جا تو وہ اسے دور سے دیکھتی رہی اور ان کو خبر نہ تھی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan berkatalah ibu Musa kepada saudara Musa yang perempuan: \"Ikutilah dia\" Maka kelihatanlah olehnya Musa dari jauh, sedang mereka tidak mengetahuinya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَالَتْ", "hit": false, "audio": null, "gloss": null}, {"text": "لِأُخْتِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "قُصِّيهِ", "hit": true, "audio": "audio/757d2143c3c85951e56a.m4a", "gloss": {"bs": "prati ga", "en": "follow him", "tr": "onu izle", "fr": "suis-le !", "id": "ikutilah dia", "ur": "اس