": false, "notUsed": false, "spoken": "audio/0507c9bf4011ac6627c5.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "26:82", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3014.mp3", "translation": {"en": {"text": "And Who, I ardently hope, will forgive me my sin on the Day of Judgment.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ve hesap günü, hatamı bağışlayacağını umduğumdur.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جس کی مجھے آس لگی ہے کہ میری خطائیں قیامت کے دن بخشے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan Yang amat kuinginkan akan mengampuni kesalahanku pada hari kiamat\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَطْمَعُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَغْفِرَ", "hit": true, "audio": "audio/6c13008db62b129b0cc8.m4a", "gloss": {"bs": "da (mi) oprosti", "en": "(that) He will forgive", "tr": "bana bağışlaması için", "fr": "(qu')Il pardonne", "id": "(bahwa) Dia akan mengampuni", "ur": "(کہ) وہ بخش دے", "bn": "(যে) তিনি ক্ষমা করবেন", "fa": "(که) خواهد آمرزید"}}, {"text": "لِى", "hit": false, "audio": null, "gloss": null}, {"text": "خَطِيٓـَٔتِى", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلدِّينِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:86", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3018.mp3", "translation": {"en": {"text": "And forgive my father. Lo! he is of those who err.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Babamı da bağışla, çünkü o yanlış gidenlerdendir. \"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور میرے باپ کو بخش دے بیشک وہ گمراہ،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan ampunilah bapakku, karena sesungguhnya ia adalah termasuk golongan orang-orang yang sesat,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱغْفِرْ", "hit": true, "audio": "audio/a1eaac49303640891a92.m4a", "gloss": {"bs": "i oprosti!", "en": "and forgive!", "tr": "ve bağışla!", "fr": "et pardonne !", "id": "dan ampunilah!", "ur": "اور بخش دے!", "bn": "এবং ক্ষমা করো!", "fa": "و بیامرز!"}}, {"text": "لِأَبِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلضَّآلِّينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "5:118", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/787.mp3", "translation": {"en": {"text": "If Thou punish them, lo! they are Thy slaves, and if Thou forgive them (lo! they are Thy slaves). Lo! Thou, only Thou, art the Mighty, the Wise.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Eğer onlara azab edersen, onlar senin kullarındır, eğer onları bağışlarsan, şüphesiz sen daima üstünsün, hikmet sahibisin\".", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اگر تو انہیں عذاب کرے تو وہ تیرے بندے ہیں، اور اگر تو انہیں بخش دے تو بیشک تو ہی ہے غالب حکمت والا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Jika Engkau menyiksa mereka, maka sesungguhnya mereka adalah hamba-hamba Engkau, dan jika Engkau mengampuni mereka, maka sesungguhnya Engkaulah Yang Maha Perkasa lagi Maha Bijaksana.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تُعَذِّبْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عِبَادُكَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَغْفِرْ", "hit": true, "audio": "audio/f1d95640a1188802d500.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "jussive"}]}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَزِيزُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَكِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:27", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3732.mp3", "translation": {"en": {"text": "With what (munificence) my Lord hath pardoned me and made me of the honoured ones!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Rabbimin beni bağışladığını ve beni kendilerine ikram edilen kullarından kıldığını.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جیسی میرے رب نے میری مغفرت کی اور مجھے عزت والوں میں کیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apa yang menyebabkan Tuhanku memberi ampun kepadaku dan menjadikan aku termasuk orang-orang yang dimuliakan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "غَفَرَ", "hit": true, "audio": "audio/b899c4a2039d8611d7f7.m4a", "gloss": {"bs": "(što) je oprostio", "en": "(that) He forgave", "tr": "(ki) bağışladı", "fr": "(que) Il a pardonné", "id": "(bahwa) Dia mengampuni", "ur": "(جو) اس نے بخش دیا", "bn": "(যে) তিনি ক্ষমা করেছেন", "fa": "(که) آمرزید"}}, {"text": "لِى", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّى", "hit": false, "audio": null, "gloss": null}, {"text": "وَجَعَلَنِى", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُكْرَمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "42:37", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4309.mp3", "translation": {"en": {"text": "And those who shun the worst of sins and indecencies and, when they are wroth, forgive,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O iman edenler, büyük günahlardan ve hayasızlıktan kaçınırlar. Onlar öfkelendikleri zaman da kusurları bağışlarlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جو بڑے بڑے گناہوں اور بے حیائیوں سے بچتے ہیں اور جب غصہ آئے معاف کردیتے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan (bagi) orang-orang yang menjauhi dosa-dosa besar dan perbuatan-perbuatan keji, dan apabila mereka marah mereka memberi maaf.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَجْتَنِبُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَبَٰٓئِرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْإِثْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْفَوَٰحِشَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "غَضِبُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "هُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَغْفِرُونَ", "hit": true, "audio": "audio/e0e0a53304c4c69c6c94.m4a", "gloss": {"en": "they forgive", "bs": "opraštaju", "tr": "bağışlarlar", "fr": "ils pardonnent", "id": "mereka mengampuni", "ur": "وہ معاف کرتے ہیں", "bn": "তারা ক্ষমা করে", "fa": "می‌آمرزند"}}]}, {"ref": "38:25", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3995.mp3", "translation": {"en": {"text": "So We forgave him that; and lo! he had access to Our presence and a happy journey's end.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz de o zannettiği şeyi kendisine bağışladık. Şüphesiz yanımızda onun bir yakınlığı ve güzel bir dönüş yeri vardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ہم نے اسے یہ معاف فرمایا، اور بیشک اس کے لیے ہماری بارگاہ میں ضرور قرب اور اچھا ٹھکانا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Kami ampuni baginya kesalahannya itu. Dan sesungguhnya dia mempunyai kedudukan dekat pada sisi Kami dan tempat kembali yang baik.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَغَفَرْنَا", "hit": true, "audio": "audio/7e4c455ac3abf072c42e.m4a", "gloss": {"en": "so we forgave", "bs": "pa smo oprostili", "tr": "böylece bağışladık", "fr": "alors nous avons pardonné", "id": "maka kami telah mengampuni", "ur": "پس ہم نے معاف کیا", "bn": "অতএব আমরা ক্ষমা করলাম", "fa": "پس آمرزیدیم"}}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "ذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "عِندَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَزُلْفَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "وَحُسْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَـَٔابٍ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَغْفِرُ", "count": 8, "f