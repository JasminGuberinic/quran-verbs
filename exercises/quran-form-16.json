[{"id":"hashara-2-203-24","words":["verb:hashara"],"options":[{"bs":"okupljate se","en":"you (all) are gathered"},{"bs":"sakupite","en":"gather"},{"bs":"biva okupljen","en":"he/it is gathered"},{"bs":"i okupljen je","en":"and he/it was gathered"}],"ref":"2:203","answerWord":"تُحْشَرُونَ","answerSound":"audio/568f8553ba0d5bb20718.m4a","quranTranslation":{"text":"Remember Allah through the appointed days. Then whoso hasteneth (his departure) by two days, it is no sin for him, and whoso delayeth, it is no sin for him; that is for him who wardeth off (evil). Be careful of your duty to Allah, and know that unto Him ye will be gathered.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَٱذْكُرُوا۟","ٱللَّهَ","فِىٓ","أَيَّامٍ","مَّعْدُودَٰتٍ","فَمَن","تَعَجَّلَ","فِى","يَوْمَيْنِ","فَلَآ","إِثْمَ","عَلَيْهِ","وَمَن","تَأَخَّرَ","فَلَآ","إِثْمَ","عَلَيْهِ","لِمَنِ","ٱتَّقَىٰ","وَٱتَّقُوا۟","ٱللَّهَ","وَٱعْلَمُوٓا۟","أَنَّكُمْ","إِلَيْهِ","تُحْشَرُونَ"],"marked":[24],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-15-25-3","words":["verb:hashara"],"options":[{"bs":"okuplja ih","en":"he/it gathers them"},{"bs":"okupljaju se","en":"they are gathered"},{"bs":"i okupljamo","en":"and we gather"},{"bs":"i okupljate se","en":"and you (all) are gathered"}],"ref":"15:25","answerWord":"يَحْشُرُهُمْ","answerSound":"audio/7aa825d23226b71d4a0e.m4a","quranTranslation":{"text":"Lo! thy Lord will gather them together. Lo! He is Wise, Aware.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَإِنَّ","رَبَّكَ","هُوَ","يَحْشُرُهُمْ","إِنَّهُۥ","حَكِيمٌ","عَلِيمٌ"],"marked":[3],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-6-38-21","words":["verb:hashara"],"options":[{"bs":"okupljaju se","en":"they are gathered"},{"bs":"pa je okupio","en":"so he/it gathered"},{"bs":"pa će ih okupiti","en":"so he/it will gather them"},{"bs":"okupljamo ih","en":"we gather them"}],"ref":"6:38","answerWord":"يُحْشَرُونَ","answerSound":"audio/59e7f9d24d3aacd418c7.m4a","quranTranslation":{"text":"There is not an animal in the earth, nor a flying creature flying on two wings, but they are peoples like unto you. We have neglected nothing in the Book (of Our decrees). Then unto their Lord they will be gathered.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَمَا","مِن","دَآبَّةٍ","فِى","ٱلْأَرْضِ","وَلَا","طَٰٓئِرٍ","يَطِيرُ","بِجَنَاحَيْهِ","إِلَّآ","أُمَمٌ","أَمْثَالُكُم","مَّا","فَرَّطْنَا","فِى","ٱلْكِتَٰبِ","مِن","شَىْءٍ","ثُمَّ","إِلَىٰ","رَبِّهِمْ","يُحْشَرُونَ"],"marked":[21],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-6-22-1","words":["verb:hashara"],"options":[{"bs":"okupljamo ih","en":"we gather them"},{"bs":"i okupili smo ih","en":"and we gathered them"},{"bs":"okupljaju se","en":"they are gathered"},{"bs":"i okupljamo ga","en":"and we gather him"}],"ref":"6:22","answerWord":"نَحْشُرُهُمْ","answerSound":"audio/beea5a30d67734e327aa.m4a","quranTranslation":{"text":"And on the day We gather them together We shall say unto those who ascribed partners (unto Allah): Where are (now) those partners of your make-believe?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَيَوْمَ","نَحْشُرُهُمْ","جَمِيعًا","ثُمَّ","نَقُولُ","لِلَّذِينَ","أَشْرَكُوٓا۟","أَيْنَ","شُرَكَآؤُكُمُ","ٱلَّذِينَ","كُنتُمْ","تَزْعُمُونَ"],"marked":[1],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-19-85-1","words":["verb:hashara"],"options":[{"bs":"sakupit ćemo","en":"We will gather"},{"bs":"i okupljamo ih","en":"and we gather them"},{"bs":"pa je okupio","en":"so he/it gathered"},{"bs":"i okupljate se","en":"and you (all) are gathered"}],"ref":"19:85","answerWord":"نَحْشُرُ","answerSound":"audio/75b2a541dc784702041f.m4a","quranTranslation":{"text":"On the day when We shall gather the righteous unto the Beneficent, a goodly company.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["يَوْمَ","نَحْشُرُ","ٱلْمُتَّقِينَ","إِلَى","ٱلرَّحْمَٰنِ","وَفْدًا"],"marked":[1],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-3-12-4","words":["verb:hashara"],"options":[{"bs":"i okupljate se","en":"and you (all) are gathered"},{"bs":"biva okupljen","en":"he/it is gathered"},{"bs":"i okupili smo","en":"and we gathered"},{"bs":"okupljen je","en":"he/it was gathered"}],"ref":"3:12","answerWord":"وَتُحْشَرُونَ","answerSound":"audio/d8026383dabb9dc21f80.m4a","quranTranslation":{"text":"Say (O Muhammad) unto those who disbelieve: Ye shall be overcome and gathered unto Hell, an evil resting-place.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["قُل","لِّلَّذِينَ","كَفَرُوا۟","سَتُغْلَبُونَ","وَتُحْشَرُونَ","إِلَىٰ","جَهَنَّمَ","وَبِئْسَ","ٱلْمِهَادُ"],"marked":[4],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-4-172-15","words":["verb:hashara"],"options":[{"bs":"pa će ih okupiti","en":"so he/it will gather them"},{"bs":"okupljena je","en":"she/it was gathered"},{"bs":"biva okupljen","en":"he/it is gathered"},{"bs":"okupljaju se","en":"they are gathered"}],"ref":"4:172","answerWord":"فَسَيَحْشُرُهُمْ","answerSound":"audio/c1f168ca2843ba215d9d.m4a","quranTranslation":{"text":"The Messiah will never scorn to be a slave unto Allah, nor will the favoured angels. Whoso scorneth His service and is proud, all such will He assemble unto Him;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["لَّن","يَسْتَنكِفَ","ٱلْمَسِيحُ","أَن","يَكُونَ","عَبْدًا","لِّلَّهِ","وَلَا","ٱلْمَلَٰٓئِكَةُ","ٱلْمُقَرَّبُونَ","وَمَن","يَسْتَنكِفْ","عَنْ","عِبَادَتِهِۦ","وَيَسْتَكْبِرْ","فَسَيَحْشُرُهُمْ","إِلَيْهِ","جَمِيعًا"],"marked":[15],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-6-51-5","words":["verb:hashara"],"options":[{"bs":"okupljaju se","en":"they are gathered"},{"bs":"biva okupljen","en":"he/it is gathered"},{"bs":"sakupite","en":"gather"},{"bs":"okupljate se","en":"you (all) are gathered"}],"ref":"6:51","answerWord":"يُحْشَرُوٓا۟","answerSound":"audio/348814fcccd8323cc4e1.m4a","quranTranslation":{"text":"Warn hereby those who fear (because they know) that they will be gathered unto their Lord, for whom there is no protecting ally nor intercessor beside Him, that they may ward off (evil).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَأَنذِرْ","بِهِ","ٱلَّذِينَ","يَخَافُونَ","أَن","يُحْشَرُوٓا۟","إِلَىٰ","رَبِّهِمْ","لَيْسَ","لَهُم","مِّن","دُونِهِۦ","وَلِىٌّ","وَلَا","شَفِيعٌ","لَّعَلَّهُمْ","يَتَّقُونَ"],"marked":[5],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-6-111-7","words":["verb:hashara"],"options":[{"bs":"i okupili smo","en":"and we gathered"},{"bs":"okupljena je","en":"she/it was gathered"},{"bs":"i okupili smo ih","en":"and we gathered them"},{"bs":"sakupite","en":"gather"}],"ref":"6:111","answerWord":"وَحَشَرْنَا","answerSound":"audio/61240357149fc6685738.m4a","quranTranslation":{"text":"And though We should send down the angels unto them, and the dead should speak unto them, and We should gather against them all things in array, they would not believe unless Allah so willed. Howbeit, most of them are ignorant.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَلَوْ","أَنَّنَا","نَزَّلْنَآ","إِلَيْهِمُ","ٱلْمَلَٰٓئِكَةَ","وَكَلَّمَهُمُ","ٱلْمَوْتَىٰ","وَحَشَرْنَا","عَلَيْهِمْ","كُلَّ","شَىْءٍ","قُبُلًا","مَّا","كَانُوا۟","لِيُؤْمِنُوٓا۟","إِلَّآ","أَن","يَشَآءَ","ٱللَّهُ","وَلَٰكِنَّ","أَكْثَرَهُمْ","يَجْهَلُونَ"],"marked":[7],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-17-97-13","words":["verb:hashara"],"options":[{"bs":"i okupljamo ih","en":"and we gather them"},{"bs":"i okupljate se","en":"and you (all) are gathered"},{"bs":"i okupljamo ga","en":"and we gather him"},{"bs":"okupljena je","en":"she/it was gathered"}],"ref":"17:97","answerWord":"وَنَحْشُرُهُمْ","answerSound":"audio/f168e82cd6da32fc3529.m4a","quranTranslation":{"text":"And he whom Allah guideth, he is led aright; while, as for him whom He sendeth astray, for them thou wilt find no protecting friends beside Him, and We shall assemble them on the Day of Resurrection on their faces, blind, dumb and deaf; their habitation will be hell; whenever it abateth, We increase the flame for them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَمَن","يَهْدِ","ٱللَّهُ","فَهُوَ","ٱلْمُهْتَدِ","وَمَن","يُضْلِلْ","فَلَن","تَجِدَ","لَهُمْ","أَوْلِيَآءَ","مِن","دُونِهِۦ","وَنَحْشُرُهُمْ","يَوْمَ","ٱلْقِيَٰمَةِ","عَلَىٰ","وُجُوهِهِمْ","عُمْيًا","وَبُكْمًا","وَصُمًّا","مَّأْوَىٰهُمْ","جَهَنَّمُ","كُلَّمَا","خَبَتْ","زِدْنَٰهُمْ","سَعِيرًا"],"marked":[13],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-18-47-6","words":["verb:hashara"],"options":[{"bs":"i okupili smo ih","en":"and we gathered them"},{"bs":"okupljate se","en":"you (all) are gathered"},{"bs":"biva okupljen","en":"he/it is gathered"},{"bs":"okupljaju se","en":"they are gathered"}],"ref":"18:47","answerWord":"وَحَشَرْنَٰهُمْ","answerSound":"audio/6bf01695d2de0c38a3a8.m4a","quranTranslation":{"text":"And (bethink you of) the Day when we remove the hills and ye see the earth emerging, and We gather them together so as to leave not one of them behind.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَيَوْمَ","نُسَيِّرُ","ٱلْجِبَالَ","وَتَرَى","ٱلْأَرْضَ","بَارِزَةً","وَحَشَرْنَٰهُمْ","فَلَمْ","نُغَادِرْ","مِنْهُمْ","أَحَدًا"],"marked":[6],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-19-68-1","words":["verb:hashara"],"options":[{"bs":"zaista ćemo ih okupiti","en":"surely we will gather them"},{"bs":"i okupljate se","en":"and you (all) are gathered"},{"bs":"sakupit ćemo","en":"We will gather"},{"bs":"okuplja ih","en":"he/it gathers them"}],"ref":"19:68","answerWord":"لَنَحْشُرَنَّهُمْ","answerSound":"audio/d68385aec9b323c5fb6e.m4a","quranTranslation":{"text":"And, by thy Lord, verily We shall assemble them and the devils, then We shall bring them, crouching, around hell.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["فَوَرَبِّكَ","لَنَحْشُرَنَّهُمْ","وَٱلشَّيَٰطِينَ","ثُمَّ","لَنُحْضِرَنَّهُمْ","حَوْلَ","جَهَنَّمَ","جِثِيًّا"],"marked":[1],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-20-59-5","words":["verb:hashara"],"options":[{"bs":"biva okupljen","en":"he/it is gathered"},{"bs":"okupljena je","en":"she/it was gathered"},{"bs":"sakupite","en":"gather"},{"bs":"i okupljamo ih","en":"and we gather them"}],"ref":"20:59","answerWord":"يُحْشَرَ","answerSound":"audio/ffe52a6f61f771999876.m4a","quranTranslation":{"text":"(Moses) said: Your tryst shall be the day of the feast, and let the people assemble when the sun hath risen high.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["قَالَ","مَوْعِدُكُمْ","يَوْمُ","ٱلزِّينَةِ","وَأَن","يُحْشَرَ","ٱلنَّاسُ","ضُحًى"],"marked":[5],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-20-102-4","words":["verb:hashara"],"options":[{"bs":"i okupljamo","en":"and we gather"},{"bs":"i okupljamo ga","en":"and we gather him"},{"bs":"biva okupljen","en":"he/it is gathered"},{"bs":"i okupljamo ih","en":"and we gather them"}],"ref":"20:102","answerWord":"وَنَحْشُرُ","answerSound":"audio/167cb50882efb5e2c651.m4a","quranTranslation":{"text":"The day when the Trumpet is blown. On that day we assemble the guilty white-eyed (with terror),","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["يَوْمَ","يُنفَخُ","فِى","ٱلصُّورِ","وَنَحْشُرُ","ٱلْمُجْرِمِينَ","يَوْمَئِذٍ","زُرْقًا"],"marked":[4],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-20-124-8","words":["verb:hashara"],"options":[{"bs":"i okupljamo ga","en":"and we gather him"},{"bs":"i okupljamo","en":"and we gather"},{"bs":"pa je okupio","en":"so he/it gathered"},{"bs":"okupljaju se","en":"they are gathered"}],"ref":"20:124","answerWord":"وَنَحْشُرُهُۥ","answerSound":"audio/3fe98e669d0fef52f666.m4a","quranTranslation":{"text":"But he who turneth away from remembrance of Me, his will be a narrow life, and I shall bring him blind to the assembly on the Day of Resurrection.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَمَنْ","أَعْرَضَ","عَن","ذِكْرِى","فَإِنَّ","لَهُۥ","مَعِيشَةً","ضَنكًا","وَنَحْشُرُهُۥ","يَوْمَ","ٱلْقِيَٰمَةِ","أَعْمَىٰ"],"marked":[8],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-27-17-0","words":["verb:hashara"],"options":[{"bs":"i okupljen je","en":"and he/it was gathered"},{"bs":"okupljamo ih","en":"we gather them"},{"bs":"i okupljamo","en":"and we gather"},{"bs":"biva okupljen","en":"he/it is gathered"}],"ref":"27:17","answerWord":"وَحُشِرَ","answerSound":"audio/e43b0588fbb7bc7d81c4.m4a","quranTranslation":{"text":"And there were gathered together unto Solomon his armies of the jinn and humankind, and of the birds, and they were set in battle order;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَحُشِرَ","لِسُلَيْمَٰنَ","جُنُودُهُۥ","مِنَ","ٱلْجِنِّ","وَٱلْإِنسِ","وَٱلطَّيْرِ","فَهُمْ","يُوزَعُونَ"],"marked":[0],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-37-22-0","words":["verb:hashara"],"options":[{"bs":"sakupite","en":"gather"},{"bs":"pa je okupio","en":"so he/it gathered"},{"bs":"i okupili smo","en":"and we gathered"},{"bs":"i okupljamo ih","en":"and we gather them"}],"ref":"37:22","answerWord":"ٱحْشُرُوا۟","answerSound":"audio/5c6e5e491a33f45e304f.m4a","quranTranslation":{"text":"(And it is said unto the angels): Assemble those who did wrong, together with their wives and what they used to worship","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["ٱحْشُرُوا۟","ٱلَّذِينَ","ظَلَمُوا۟","وَأَزْوَٰجَهُمْ","وَمَا","كَانُوا۟","يَعْبُدُونَ"],"marked":[0],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-41-19-1","words":["verb:hashara"],"options":[{"bs":"biva okupljen","en":"he/it is gathered"},{"bs":"okupljamo ih","en":"we gather them"},{"bs":"i okupljen je","en":"and he/it was gathered"},{"bs":"pa je okupio","en":"so he/it gathered"}],"ref":"41:19","answerWord":"يُحْشَرُ","answerSound":"audio/a03abfb685eb8eeed40b.m4a","quranTranslation":{"text":"And (make mention of) the day when the enemies of Allah are gathered unto the Fire, they are driven on","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَيَوْمَ","يُحْشَرُ","أَعْدَآءُ","ٱللَّهِ","إِلَى","ٱلنَّارِ","فَهُمْ","يُوزَعُونَ"],"marked":[1],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-46-6-1","words":["verb:hashara"],"options":[{"bs":"okupljen je","en":"he/it was gathered"},{"bs":"okupljate se","en":"you (all) are gathered"},{"bs":"okupljena je","en":"she/it was gathered"},{"bs":"biva okupljen","en":"he/it is gathered"}],"ref":"46:6","answerWord":"حُشِرَ","answerSound":"audio/5d4d2bbf80f5676b3850.m4a","quranTranslation":{"text":"And when mankind are gathered (to the Judgment) will become enemies for them, and will become deniers of having been worshipped.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["وَإِذَا","حُشِرَ","ٱلنَّاسُ","كَانُوا۟","لَهُمْ","أَعْدَآءً","وَكَانُوا۟","بِعِبَادَتِهِمْ","كَٰفِرِينَ"],"marked":[1],"facts":{"verb":"حَشَرَ"}},{"id":"hashara-79-23-0","words":["verb:hashara"],"options":[{"bs":"pa je okupio","en":"so he/it gathered"},{"bs":"i okupljate se","en":"and you (all) are gathered"},{"bs":"i okupili smo ih","en":"and we gathered them"},{"bs":"zaista ćemo ih okupiti","en":"surely we will gather them"}],"ref":"79:23","answerWord":"فَحَشَرَ","answerSound":"audio/897460e3890075b145a4.m4a","quranTranslation":{"text":"Then gathered he and summoned","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to assemble"},"passage":["فَحَشَرَ","فَنَادَىٰ"],"marked":[0],"facts":{"verb":"حَشَرَ"}},{"id":"anama-4-69-7","words":["verb:anama"],"options":[{"bs":"podario je blagodat","en":"he/it bestowed favour"},{"bs":"podario joj je blagodat","en":"he/it bestowed favour on it"},{"bs":"podario sam blagodat","en":"I bestowed favour"},{"bs":"podarili smo blagodat","en":"we bestowed favour"}],"ref":"4:69","answerWord":"أَنْعَمَ","answerSound":"audio/4fc20cc950d36dc73a36.m4a","quranTranslation":{"text":"Whoso obeyeth Allah and the messenger, they are with those unto whom Allah hath shown favour, of the prophets and the saints and the martyrs and the righteous. The best of company are they!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"podariti blagodat","en":"to bestow favour"},"passage":["وَمَن","يُطِعِ","ٱللَّهَ","وَٱلرَّسُولَ","فَأُو۟لَٰٓئِكَ","مَعَ","ٱلَّذِينَ","أَنْعَمَ","ٱللَّهُ","عَلَيْهِم","مِّنَ","ٱلنَّبِيِّۦنَ","وَٱلصِّدِّيقِينَ","وَٱلشُّهَدَآءِ","وَٱلصَّٰلِحِينَ","وَحَسُنَ","أُو۟لَٰٓئِكَ","رَفِيقًا"],"marked":[7],"facts":{"verb":"أَنْعَمَ"}},{"id":"anama-2-47-5","words":["verb:anama"],"options":[{"bs":"podario sam blagodat","en":"I bestowed favour"},{"bs":"podarili smo blagodat","en":"we bestowed favour"},{"bs":"i podario si blagodat","en":"and you bestowed favour"},{"bs":"podario je blagodat","en":"he/it bestowed favour"}],"ref":"2:47","answerWord":"أَنْعَمْتُ","answerSound":"audio/c0883b20bcfed20dacbc.m4a","quranTranslation":{"text":"O Children of Israel! Remember My favour wherewith I favoured you and how I preferred you to (all) creatures.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"podariti blagodat","en":"to bestow favour"},"passage":["يَٰبَنِىٓ","إِسْرَٰٓءِيلَ","ٱذْكُرُوا۟","نِعْمَتِىَ","ٱلَّتِىٓ","أَنْعَمْتُ","عَلَيْكُمْ","وَأَنِّى","فَضَّلْتُكُمْ","عَلَى","ٱلْعَٰلَمِينَ"],"marked":[5],"facts":{"verb":"أَنْعَمَ"}},{"id":"anama-43-59-4","words":["verb:anama"],"options":[{"bs":"podarili smo blagodat","en":"we bestowed favour"},{"bs":"podario je blagodat","en":"he/it bestowed favour"},{"bs":"podario sam blagodat","en":"I bestowed favour"},{"bs":"i podario si blagodat","en":"and you bestowed favour"}],"ref":"43:59","answerWord":"أَنْعَمْنَا","answerSound":"audio/e0bb36c55c06eb141c86.m4a","quranTranslation":{"text":"He is nothing but a slave on whom We bestowed favour, and We made him a pattern for the Children of Israel.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"podariti blagodat","en":"to bestow favour"},"passage":["إِنْ","هُوَ","إِلَّا","عَبْدٌ","أَنْعَمْنَا","عَلَيْهِ","وَجَعَلْنَٰهُ","مَثَلًا","لِّبَنِىٓ","إِسْرَٰٓءِيلَ"],"marked":[4],"facts":{"verb":"أَنْعَمَ"}},{"id":"anama-8-53-7","words":["verb:anama"],"options":[{"bs":"podario joj je blagodat","en":"he/it bestowed favour on it"},{"bs":"podarili smo blagodat","en":"we bestowed favour"},{"bs":"podario sam blagodat","en":"I bestowed favour"},{"bs":"podario je blagodat","en":"he/it bestowed favour"}],"ref":"8:53","answerWord":"أَنْعَمَهَا","answerSound":"audio/712d7e9dfe270bf91d7a.m4a","quranTranslation":{"text":"That is because Allah never changeth the grace He hath bestowed on any people until they first change that which is in their hearts, and (that is) because Allah is Hearer, Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"podariti blagodat","en":"to bestow favour"},"passage":["ذَٰلِكَ","بِأَنَّ","ٱللَّهَ","لَمْ","يَكُ","مُغَيِّرًا","نِّعْمَةً","أَنْعَمَهَا","عَلَىٰ","قَوْمٍ","حَتَّىٰ","يُغَيِّرُوا۟","مَا","بِأَنفُسِهِمْ","وَأَنَّ","ٱللَّهَ","سَمِيعٌ","عَلِيمٌ"],"marked":[7],"facts":{"verb":"أَنْعَمَ"}},{"id":"batasha-7-195-7","words":["verb:batasha"],"options":[{"bs":"nasilno hvataju","en":"they seize violently"},{"bs":"nasrćete","en":"you (all) seize"},{"bs":"udarit ćemo","en":"We strike"},{"bs":"nasilno hvata","en":"he/it seizes violently"}],"ref":"7:195","answerWord":"يَبْطِشُونَ","answerSound":"audio/5302c9d859f33199b7fe.m4a","quranTranslation":{"text":"Have they feet wherewith they walk, or have they hands wherewith they hold, or have they eyes wherewith they see, or have they ears wherewith they hear? Say: Call upon your (so-called) partners (of Allah), and then contrive against me, spare me not!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nasilno zgrabiti, udariti silom","en":"to seize violently, to strike with force"},"passage":["أَلَهُمْ","أَرْجُلٌ","يَمْشُونَ","بِهَآ","أَمْ","لَهُمْ","أَيْدٍ","يَبْطِشُونَ","بِهَآ","أَمْ","لَهُمْ","أَعْيُنٌ","يُبْصِرُونَ","بِهَآ","أَمْ","لَهُمْ","ءَاذَانٌ","يَسْمَعُونَ","بِهَا","قُلِ","ٱدْعُوا۟","شُرَكَآءَكُمْ","ثُمَّ","كِيدُونِ","فَلَا","تُنظِرُونِ"],"marked":[7],"facts":{"verb":"بَطَشَ"}},{"id":"batasha-26-130-1","words":["verb:batasha"],"options":[{"bs":"nasrnete","en":"you (all) seize"},{"bs":"nasilno hvata","en":"he/it seizes violently"},{"bs":"udarit ćemo","en":"We strike"},{"bs":"nasilno hvataju","en":"they seize violently"}],"ref":"26:130","answerWord":"بَطَشْتُم","answerSound":"audio/101fa07dceaf06462bd7.m4a","quranTranslation":{"text":"And if ye seize by force, seize ye as tyrants?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nasilno zgrabiti, udariti silom","en":"to seize violently, to strike with force"},"passage":["وَإِذَا","بَطَشْتُم","بَطَشْتُمْ","جَبَّارِينَ"],"marked":[1],"facts":{"verb":"بَطَشَ"}},{"id":"batasha-26-130-2","words":["verb:batasha"],"options":[{"bs":"nasrćete","en":"you (all) seize"},{"bs":"nasilno hvataju","en":"they seize violently"},{"bs":"udarit ćemo","en":"We strike"},{"bs":"nasilno hvata","en":"he/it seizes violently"}],"ref":"26:130","answerWord":"بَطَشْتُمْ","answerSound":"audio/0c9df80bab4d176b7107.m4a","quranTranslation":{"text":"And if ye seize by force, seize ye as tyrants?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nasilno zgrabiti, udariti silom","en":"to seize violently, to strike with force"},"passage":["وَإِذَا","بَطَشْتُم","بَطَشْتُمْ","جَبَّارِينَ"],"marked":[2],"facts":{"verb":"بَطَشَ"}},{"id":"batasha-44-16-1","words":["verb:batasha"],"options":[{"bs":"udarit ćemo","en":"We strike"},{"bs":"nasrnete","en":"you (all) seize"},{"bs":"nasilno hvata","en":"he/it seizes violently"},{"bs":"nasilno hvataju","en":"they seize violently"}],"ref":"44:16","answerWord":"نَبْطِشُ","answerSound":"audio/69cad686115a10d553cd.m4a","quranTranslation":{"text":"On the day when We shall seize them with the greater seizure, (then) in truth We shall punish.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nasilno zgrabiti, udariti silom","en":"to seize violently, to strike with force"},"passage":["يَوْمَ","نَبْطِشُ","ٱلْبَطْشَةَ","ٱلْكُبْرَىٰٓ","إِنَّا","مُنتَقِمُونَ"],"marked":[1],"facts":{"verb":"بَطَشَ"}},{"id":"istabaqa-2-148-4","words":["verb:istabaqa"],"options":[{"bs":"pa se takmičite!","en":"so (you all) race!"},{"bs":"pa bi pohrlili","en":"then they would race"},{"bs":"i takmičili su se","en":"and they (two) raced"},{"bs":"takmičimo se","en":"we race"}],"ref":"2:148","answerWord":"فَٱسْتَبِقُوا۟","answerSound":"audio/7a025dbc479f471b301c.m4a","quranTranslation":{"text":"And each one hath a goal toward which he turneth; so vie with one another in good works. Wheresoever ye may be, Allah will bring you all together. Lo! Allah is Able to do all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"takmičiti se, utrkivati se","en":"to race, to compete"},"passage":["وَلِكُلٍّ","وِجْهَةٌ","هُوَ","مُوَلِّيهَا","فَٱسْتَبِقُوا۟","ٱلْخَيْرَٰتِ","أَيْنَ","مَا","تَكُونُوا۟","يَأْتِ","بِكُمُ","ٱللَّهُ","جَمِيعًا","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَىْءٍ","قَدِيرٌ"],"marked":[4],"facts":{"verb":"اسْتَبَقَ"}},{"id":"istabaqa-12-17-4","words":["verb:istabaqa"],"options":[{"bs":"takmičimo se","en":"we race"},{"bs":"i takmičili su se","en":"and they (two) raced"},{"bs":"pa bi pohrlili","en":"then they would race"},{"bs":"pa se takmičite!","en":"so (you all) race!"}],"ref":"12:17","answerWord":"نَسْتَبِقُ","answerSound":"audio/7c46b495c26a490a8cf2.m4a","quranTranslation":{"text":"Saying: O our father! We went racing one with another, and left Joseph by our things, and the wolf devoured him, and thou believest not our saying even when we speak the truth.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"takmičiti se, utrkivati se","en":"to race, to compete"},"passage":["قَالُوا۟","يَٰٓأَبَانَآ","إِنَّا","ذَهَبْنَا","نَسْتَبِقُ","وَتَرَكْنَا","يُوسُفَ","عِندَ","مَتَٰعِنَا","فَأَكَلَهُ","ٱلذِّئْبُ","وَمَآ","أَنتَ","بِمُؤْمِنٍ","لَّنَا","وَلَوْ","كُنَّا","صَٰدِقِينَ"],"marked":[4],"facts":{"verb":"اسْتَبَقَ"}},{"id":"istabaqa-12-25-0","words":["verb:istabaqa"],"options":[{"bs":"i takmičili su se","en":"and they (two) raced"},{"bs":"takmičimo se","en":"we race"},{"bs":"pa se takmičite!","en":"so (you all) race!"},{"bs":"pa bi pohrlili","en":"then they would race"}],"ref":"12:25","answerWord":"وَٱسْتَبَقَا","answerSound":"audio/80f08f42ca3f911faf13.m4a","quranTranslation":{"text":"And they raced with one another to the door, and she tore his shirt from behind, and they met her lord and master at the door. She said: What shall be his reward, who wisheth evil to thy folk, save prison or a painful doom?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"takmičiti se, utrkivati se","en":"to race, to compete"},"passage":["وَٱسْتَبَقَا","ٱلْبَابَ","وَقَدَّتْ","قَمِيصَهُۥ","مِن","دُبُرٍ","وَأَلْفَيَا","سَيِّدَهَا","لَدَا","ٱلْبَابِ","قَالَتْ","مَا","جَزَآءُ","مَنْ","أَرَادَ","بِأَهْلِكَ","سُوٓءًا","إِلَّآ","أَن","يُسْجَنَ","أَوْ","عَذَابٌ","أَلِيمٌ"],"marked":[0],"facts":{"verb":"اسْتَبَقَ"}},{"id":"istabaqa-36-66-5","words":["verb:istabaqa"],"options":[{"bs":"pa bi pohrlili","en":"then they would race"},{"bs":"takmičimo se","en":"we race"},{"bs":"pa se takmičite!","en":"so (you all) race!"},{"bs":"i takmičili su se","en":"and they (two) raced"}],"ref":"36:66","answerWord":"فَٱسْتَبَقُوا۟","answerSound":"audio/93ef60a3a6bb61646515.m4a","quranTranslation":{"text":"And had We willed, We verily could have quenched their eyesight so that they should struggle for the way. Then how could they have seen?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"takmičiti se, utrkivati se","en":"to race, to compete"},"passage":["وَلَوْ","نَشَآءُ","لَطَمَسْنَا","عَلَىٰٓ","أَعْيُنِهِمْ","فَٱسْتَبَقُوا۟","ٱلصِّرَٰطَ","فَأَنَّىٰ","يُبْصِرُونَ"],"marked":[5],"facts":{"verb":"اسْتَبَقَ"}}]