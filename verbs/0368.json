": "থেকে", "fa": "از", "fr": "de", "id": "dari", "tr": "-den", "ur": "سے"}}, {"arabic": "الضَّجِيجِ", "target": false, "translation": {"bs": "buke", "en": "the noise", "bn": "কোলাহল", "fa": "سر و صدا", "fr": "le bruit", "id": "kebisingan", "tr": "gürültü", "ur": "شور"}}]}]}