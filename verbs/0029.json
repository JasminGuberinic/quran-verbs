", "recited": "audio/2bd2931fa8a98c3b9f9e.m4a", "recitedText": "كُلُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "كُلْنَ", "plain": "كُلْنَ", "quran": false, "notUsed": false, "spoken": "audio/f41c5a551cd608e82ffa.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "77:46", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5668.mp3", "translation": {"en": {"text": "Eat and take your ease (on earth) a little. Lo! ye are guilty.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yiyin, zevklenin biraz, çünkü siz suçlularsınız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کچھ دن کھالو اور برت لو ضرور تم مجرم ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Dikatakan kepada orang-orang kafir): \"Makanlah dan bersenang-senanglah kamu (di dunia dalam waktu) yang pendek; sesungguhnya kamu adalah orang-orang yang berdosa\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كُلُوا۟", "hit": true, "audio": "audio/34a63d7f4c10c82fe764.m4a", "gloss": {"bs": "jedite!", "en": "eat!", "tr": "yiyin!", "fr": "mangez !", "id": "makanlah!", "ur": "کھاؤ!", "bn": "তোমরা খাও!", "fa": "بخورید!"}}, {"text": "وَتَمَتَّعُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "قَلِيلًا", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّكُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّجْرِمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "89:19", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6012.mp3", "translation": {"en": {"text": "And ye devour heritages with devouring greed.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Oysa mirası öyle bir yiyorsunuz ki, haramhelal gözetmeden.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور میراث کا مال ہپ ہپ کھاتے ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan kamu memakan harta pusaka dengan cara mencampur baurkan (yang halal dan yang bathil),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَتَأْكُلُونَ", "hit": true, "audio": "audio/95a22b7eb2c0bea142d1.m4a", "gloss": {"en": "and you (all) eat", "bs": "i jedete", "tr": "ve yiyorsunuz", "fr": "et vous mangez", "id": "dan kalian makan", "ur": "اور تم سب کھاتے ہو", "bn": "এবং তোমরা খাও", "fa": "و می‌خورید"}}, {"text": "ٱلتُّرَاثَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَكْلًا", "hit": false, "audio": null, "gloss": null}, {"text": "لَّمًّا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:72", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3777.mp3", "translation": {"en": {"text": "And have subdued them unto them, so that some of them they have for riding, some for food?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onları, kendilerinin hizmetine vermişiz de, hem onlardan binekleri var, hem de onlardan yiyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور انہیں ان کے لیے نرم کردیا تو کسی پر سوار ہوتے ہیں اور کسی کو کھاتے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami tundukkan binatang-binatang itu untuk mereka; maka sebahagiannya menjadi tunggangan mereka dan sebahagiannya mereka makan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَذَلَّلْنَٰهَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَمِنْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "رَكُوبُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمِنْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَأْكُلُونَ", "hit": true, "audio": "audio/e0fd6960f78bf69412f0.m4a", "gloss": {"en": "they eat", "bs": "jedu", "tr": "yiyorlar", "fr": "ils mangent", "id": "mereka makan", "ur": "وہ کھاتے ہیں", "bn": "তারা খায়", "fa": "می‌خورند"}}]}, {"ref": "69:37", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5360.mp3", "translation": {"en": {"text": "Which none but sinners eat.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onu günahkârlardan başkası yemez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اسے نہ کھائیں گے مگر خطاکار", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tidak ada yang memakannya kecuali orang-orang yang berdosa.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَأْكُلُهُۥٓ", "hit": true, "audio": "audio/f5cee613519ef2170d15.m4a", "gloss": {"bs": "(niko) je ne jede", "en": "(none) eats it", "tr": "(hiçbir kimse) onu yemez", "fr": "(nul) ne le mange", "id": "(tidak ada yang) memakannya", "ur": "(کوئی) اسے نہیں کھاتا", "bn": "(কেউ) তা খায় না", "fa": "(هیچ‌کس) آن را نمی‌خورد"}}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَٰطِـُٔونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:14", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1610.mp3", "translation": {"en": {"text": "They said: If the wolf should devour him when we are (so strong) a band, then surely we should have already perished.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Dediler ki: \"Vallahi biz böyle güçlü kuvvetli bir topluluk iken, buna rağmen onu kurt yerse, o zaman biz kesinlikle hüsrana uğrayanlardan olmuş oluruz.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے اگر اسے بھیڑیا کھا جائے اور ہم ایک جماعت ہیں جب تو ہم کسی مصرف کے نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka berkata: \"Jika ia benar-benar dimakan serigala, sedang kami golongan (yang kuat), sesungguhnya kami kalau demikian adalah orang-orang yang merugi\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَئِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَكَلَهُ", "hit": true, "audio": "audio/420a3a317d78ec6452e0.m4a", "gloss": {"bs": "(ako) ga vuk pojede", "en": "(if) the wolf ate him", "tr": "(eğer) onu kurt yerse", "fr": "(si) le loup l'a dévoré", "id": "(jika) serigala memakannya", "ur": "(اگر) بھیڑیا اسے کھا جائے", "bn": "(যদি) নেকড়ে তাকে খেয়ে ফেলে", "fa": "(اگر) گرگ او را بخورد"}}, {"text": "ٱلذِّئْبُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "عُصْبَةٌ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذًا", "hit": false, "audio": null, "gloss": null}, {"text": "لَّخَٰسِرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "كُلُوا۟", "count": 15, "first": "2:57", "audio": "audio/2bd2931fa8a98c3b9f9e.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"bs": "jedite!", "en": "eat!", "tr": "yiyin!", "fr": "mangez !", "id": "makanlah!", "ur": "کھاؤ!", "bn": "তোমরা খাও!", "fa": "بخورید!"}}, {"arabic": "تَأْكُلُونَ", "count": 11, "first": "3:49", "audio": "audio/92f6fb064323442001e3.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "you (all) eat", "bs": "jedete", "tr": "yiyorsunuz", "fr": "vous mangez", "id": "kalian makan", "ur": "تم سب کھاتے