ecitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "عَلِّمِي", "plain": "عَلِّمِي", "quran": false, "notUsed": false, "spoken": "audio/e655965a1e6c840a417f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "عَلِّمَا", "plain": "عَلِّمَا", "quran": false, "notUsed": false, "spoken": "audio/f24d708ed7b9fae2daa1.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "عَلِّمُوا", "plain": "عَلِّمُوا", "quran": false, "notUsed": false, "spoken": "audio/799b159ab453971a53a7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "عَلِّمْنَ", "plain": "عَلِّمْنَ", "quran": false, "notUsed": false, "spoken": "audio/c96b4a69e920d90cdd15.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "53:5", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4789.mp3", "translation": {"en": {"text": "Which one of mighty powers hath taught him,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onu, müthiş kuvvetleri olan biri öğretti", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "انہیں سکھایا سخت قوتوں والے طاقتور نے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "yang diajarkan kepadanya oleh (Jibril) yang sangat kuat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "عَلَّمَهُۥ", "hit": true, "audio": "audio/b1adc8a22a46fab0fd96.m4a", "gloss": {"bs": "poučio ga je", "en": "taught him", "tr": "ona öğretti", "fr": "lui a enseigné", "id": "mengajarinya", "ur": "اس نے اسے سکھایا", "bn": "তাকে শিখিয়েছেন", "fa": "او را آموخت"}}, {"text": "شَدِيدُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقُوَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:48", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/341.mp3", "translation": {"en": {"text": "And He will teach him the Scripture and wisdom, and the Torah and the Gospel,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah ona kitab (okuma ve yazmay)ı, hikmeti ve Tevrat ile İncil'i öğretir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اللہ سکھائے گا کتاب اور حکمت اور توریت اور انجیل،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Allah akan mengajarkan kepadanya Al Kitab, Hikmah, Taurat dan Injil.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيُعَلِّمُهُ", "hit": true, "audio": "audio/925a4f3448712de9fbdb.m4a", "gloss": {"bs": "i poučit će ga", "en": "and He will teach him", "tr": "ve ona öğretecek", "fr": "et Il lui enseignera", "id": "dan Dia akan mengajarinya", "ur": "اور وہ اسے سکھائے گا", "bn": "এবং তিনি তাকে শেখাবেন", "fa": "و به او می‌آموزد"}}, {"text": "ٱلْكِتَٰبَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْحِكْمَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلتَّوْرَىٰةَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْإِنجِيلَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:80", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2563.mp3", "translation": {"en": {"text": "And We taught him the art of making garments (of mail) to protect you in your daring. Are ye then thankful?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ona, sizi savaşta korumak için zırh yapma sanatını öğrettik, artık şükreder misiniz?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے اسے تمہارا ایک پہناوا بنانا سکھایا کہ تمہیں تمہاری آنچ سے (زخمی ہونے سے) بچائے تو کیا تم شکر کروگے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan telah Kami ajarkan kepada Daud membuat baju besi untuk kamu, guna memelihara kamu dalam peperanganmu; Maka hendaklah kamu bersyukur (kepada Allah).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَعَلَّمْنَٰهُ", "hit": true, "audio": "audio/db42a21c8e7cd5261c52.m4a", "gloss": {"en": "and we taught him", "bs": "i naučili smo ga", "tr": "ve ona öğrettik", "fr": "et nous l'avons enseigné", "id": "dan kami telah mengajarinya", "ur": "اور ہم نے اسے سکھایا", "bn": "এবং আমরা তাকে শিক্ষা দিয়েছি", "fa": "و او را آموختیم"}}, {"text": "صَنْعَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَبُوسٍ", "hit": false, "audio": null, "gloss": null}, {"text": "لَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لِتُحْصِنَكُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بَأْسِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَهَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "شَٰكِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:32", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/39.mp3", "translation": {"en": {"text": "They said: Be glorified! We have no knowledge saving that which Thou hast taught us. Lo! Thou, only Thou, art the Knower, the Wise.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Dediler ki: \"Yücesin sen (ya Rab!). Bizim, senin bize öğrettiğinden başka bir bilgimiz yoktur. Şüphesiz sen bilensin, hakîmsin\".", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے پاکی ہے تجھے ہمیں کچھ علم نہیں مگر جتنا تو نے ہمیں سکھایا بے شک تو ہی علم و حکمت والا ہے -", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka menjawab: \"Maha Suci Engkau, tidak ada yang kami ketahui selain dari apa yang telah Engkau ajarkan kepada kami; sesungguhnya Engkaulah Yang Maha Mengetahui lagi Maha Bijaksana\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "سُبْحَٰنَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "عِلْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَّمْتَنَآ", "hit": true, "audio": "audio/d7deffb572c7e72fae5f.m4a", "gloss": {"en": "you taught us", "bs": "naučio si nas", "tr": "bize öğrettin", "fr": "tu nous as enseigné", "id": "kamu telah mengajari kami", "ur": "تم نے ہمیں سکھایا", "bn": "তুমি আমাদের শিক্ষা দিয়েছ", "fa": "به ما آموختی"}}, {"text": "إِنَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَلِيمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَكِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:66", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2206.mp3", "translation": {"en": {"text": "Moses said unto him: May I follow thee, to the end that thou mayst teach me right conduct of that which thou hast been taught?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa ona: \"Allah'ın sana öğrettiği ilim ve hikmetten bana da öğretmen için sana tabi olabilir miyim?\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس سے موسیٰ نے کہا کیا میں تمہارے ساتھ رہوں اس شرط پر کہ تم مجھے سکھادو گے نیک بات جو تمہیں تعلیم ہوئی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Musa berkata kepada Khidhr: \"Bolehkah aku mengikutimu supaya kamu mengajarkan kepadaku ilmu yang benar di antara ilmu-ilmu yang telah diajarkan kepadamu?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "مُوسَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "هَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَتَّبِعُكَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "تُعَلِّمَنِ", "hit": true, "audio": "audio/4a29ad82056330d84d33.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": ["ana"], "mood": "subjunctive"}]}, {"text": "مِمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "عُلِّمْتَ", "hit": false, "audio": null, "gloss": null}, {"text": "رُشْدًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَيُعَلِّمُهُمُ", "count": 3, "first": "2:129", "audio": "audio/9e61ffa396475a6039b7.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"en": "and he/it teaches them", "bs": "i poučava ih", "tr": "ve onlara öğretir", "fr": "et il leur enseigne", "id": "dan dia mengajari mereka", "ur": "اور وہ انہیں سکھاتا ہے", "bn": "এবং সে তাদের শিক্ষা দেয়", "fa": "و آنان را آموزش می‌دهد"}}, {"arabic": "عَلَّمَكُمُ", "count": 3, "first": "5:4", "audio": "audio/2c70cd2d9d70cab5d116.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["antum"]}], "gloss": {"en": "he/it taught you (all)", "bs": "naučio vas je", "tr": "size öğretti", "fr": "il vous a enseigné", "id": "dia telah mengajari kalian", "ur": "اُس نے تمہیں سکھایا", "bn": "সে তোমাদের শিক্ষা দিয়েছে", "fa": "شما را آموخت"}}, {"arabic": "عَلَّمَ", "c