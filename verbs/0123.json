: null}, {"text": "ٱلْمُنذَرِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "25:66", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2921.mp3", "translation": {"en": {"text": "Lo! it is wretched as abode and station;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Orası cidden ne kötü bir uğrak, ne kötü bir konaktır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک وہ بہت ہی بری ٹھہرنے کی جگہ ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya jahannam itu seburuk-buruk tempat menetap dan tempat kediaman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "سَآءَتْ", "hit": true, "audio": "audio/ee50e19abc32307e2249.m4a", "gloss": {"bs": "ružno je", "en": "evil it is", "tr": "ne kötüdür", "fr": "quelle mauvaise est", "id": "buruklah ia", "ur": "برا ہے", "bn": "মন্দ হয়েছে", "fa": "بد است"}}, {"text": "مُسْتَقَرًّا", "hit": false, "audio": null, "gloss": null}, {"text": "وَمُقَامًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "سَآءَ", "count": 11, "first": "5:66", "audio": "audio/110b1dfeeeb4140ef66f.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}]}, {"arabic": "فَسَآءَ", "count": 4, "first": "4:38", "audio": "audio/18ce4d61c990df2d55e0.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}]}, {"arabic": "وَسَآءَتْ", "count": 4, "first": "4:97", "audio": "audio/1c72c62e1b8b94eee3dc.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}]}, {"arabic": "وَسَآءَ", "count": 3, "first": "4:22", "audio": "audio/85d5e5f3ba09bc1f5e8d.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}]}, {"arabic": "تَسُؤْهُمْ", "count": 2, "f