t", "pronoun": "hunna", "arabic": "يُكَفِّرْنَ", "plain": "يُكَفِّرْنَ", "quran": false, "notUsed": false, "spoken": "audio/b59de437d4bfed284d1a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "كَفِّرْ", "plain": "كَفِّرْ", "quran": true, "notUsed": false, "spoken": "audio/23714d6c36205dc6e321.m4a", "recited": "audio/ac1cee4d693ceb7477d3.m4a", "recitedText": "وَكَفِّرْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "كَفِّرِي", "plain": "كَفِّرِي", "quran": false, "notUsed": false, "spoken": "audio/2efe4800d64ca3b726ae.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "كَفِّرَا", "plain": "كَفِّرَا", "quran": false, "notUsed": false, "spoken": "audio/09c77284b4bfc9f03314.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "كَفِّرُوا", "plain": "كَفِّرُوا", "quran": false, "notUsed": false, "spoken": "audio/45ab791a4415f3a45c5a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "كَفِّرْنَ", "plain": "كَفِّرْنَ", "quran": false, "notUsed": false, "spoken": "audio/268d3433d91f1748a945.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "39:35", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4093.mp3", "translation": {"en": {"text": "That Allah will remit from them the worst of what they did, and will pay them for reward the best they used to do.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Çünkü Allah, onların önceden yaptıkları amelin en kötüsünü bile keffaretle örtüp, işlemekte bulundukları güzel amellerin en güzeline göre mükafatlarını kendilerine verecektir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تاکہ اللہ ان سے اتار دے برے سے برا کام جو انہوں نے کیا اور انہیں ان کے ثواب کا صلہ دے اچھے سے اچھے کام پر جو وہ کرتے تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "agar Allah akan menutupi (mengampuni) bagi mereka perbuatan yang paling buruk yang mereka kerjakan dan membalas mereka dengan upah yang lebih baik dari apa yang telah mereka kerjakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لِيُكَفِّرَ", "hit": true, "audio": "audio/9b278c5dcba913c3c51f.m4a", "gloss": {"en": "so that he/it may remove (sins)", "bs": "da izbriše grijehe", "tr": "günahları silsin diye", "fr": "qu'il efface (les péchés)", "id": "agar dia menghapus", "ur": "تاکہ وہ دور کرے", "bn": "যাতে সে পাপ মোচন করে", "fa": "تا گناهان را محو کند"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَسْوَأَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "عَمِلُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَجْزِيَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْرَهُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِأَحْسَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْمَلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "4:31", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/524.mp3", "translation": {"en": {"text": "If ye avoid the great (things) which ye are forbidden, We will remit from you your evil deeds and make you enter at a noble gate.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer siz, yasaklandığınız büyük günahlardan sakınırsanız, diğer kusurlarınızı örter, sizi güzel bir makama koyarız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اگر بچتے رہو کبیرہ گناہوں سے جن کی تمہیں ممانعت ہے تو تمہارے اور گناہ ہم بخش دیں گے اور تمہیں عزت کی جگہ داخل کریں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Jika kamu menjauhi dosa-dosa besar di antara dosa-dosa yang dilarang kamu mengerjakannya, niscaya Kami hapus kesalahan-kesalahanmu (dosa-dosamu yang kecil) dan Kami masukkan kamu ke tempat yang mulia (surga).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَجْتَنِبُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "كَبَآئِرَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُنْهَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "نُكَفِّرْ", "hit": true, "audio": "audio/ebfcce3362cf6ee60bd3.m4a", "gloss": {"bs": "izbrisat ćemo", "en": "We will remove", "tr": "sileceğiz", "fr": "Nous effacerons", "id": "Kami akan menyingkap", "ur": "ہم مٹا دیں گے", "bn": "আমরা মোচন করব", "fa": "می‌زداییم"}}, {"text": "عَنكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "سَيِّـَٔاتِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنُدْخِلْكُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّدْخَلًا", "hit": false, "audio": null, "gloss": null}, {"text": "كَرِيمًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "5:65", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/734.mp3", "translation": {"en": {"text": "If only the People of the Scripture would believe and ward off (evil), surely We should remit their sins from them and surely We should bring them into Gardens of Delight.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer kitap ehli iman etmiş ve layıkıyla korunmuş olsalardı, onların kötülüklerini örter, nimeti bol olan cennetlere koyardık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر کتاب والے ایمان لاتے اور پرہیزگاری کرتے تو ضرور ہم ان کے گناہ اتار دیتے اور ضرور انہیں چین کے باغوں میں لے جاتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sekiranya Ahli Kitab beriman dan bertakwa, tentulah Kami tutup (hapus) kesalahan-kesalahan mereka dan tentulah Kami masukkan mereka kedalam surga-surga yang penuh kenikmatan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَهْلَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكِتَٰبِ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱتَّقَوْا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَكَفَّرْنَا", "hit": true, "audio": "audio/022862504a1b4b0da5a6.m4a", "gloss": {"bs": "izbrisali bismo", "en": "We would have removed", "tr": "silerdik", "fr": "Nous aurions effacé", "id": "niscaya Kami menghilangkan", "ur": "ہم ضرور مٹا دیتے", "bn": "আমরা অবশ্যই মোচন করতাম", "fa": "قطعاً می‌زدودیم"}}, {"text": "عَنْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "سَيِّـَٔاتِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَأَدْخَلْنَٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "جَنَّٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلنَّعِيمِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُكَفِّرْ", "count": 2, "first": "64:9", "audio": "audio/4c486ce297629aa7387f.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "he/it removes (sins)", "bs": "briše grijehe", "tr": "günahları siler", "fr": "il efface (les péchés)", "id": "dia menghapus", "ur"