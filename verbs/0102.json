nse": "present", "pronoun": "hunna", "arabic": "يُبَشِّرْنَ", "plain": "يُبَشِّرْنَ", "quran": false, "notUsed": false, "spoken": "audio/657910e41d57d8130b63.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "بَشِّرِ", "plain": "بَشِّرْ", "quran": true, "notUsed": false, "spoken": "audio/78fa1f4331e1185edf1e.m4a", "recited": "audio/070bde09d0682ab4cf90.m4a", "recitedText": "بَشِّرِ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "بَشِّرِي", "plain": "بَشِّرِي", "quran": false, "notUsed": false, "spoken": "audio/a01e7d1e829b03a304ba.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "بَشِّرَا", "plain": "بَشِّرَا", "quran": false, "notUsed": false, "spoken": "audio/d7413a240ee334ae2377.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "بَشِّرُوا", "plain": "بَشِّرُوا", "quran": false, "notUsed": false, "spoken": "audio/121b7690e15596f4330b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "بَشِّرْنَ", "plain": "بَشِّرْنَ", "quran": false, "notUsed": false, "spoken": "audio/b984c22fe2f5a2c607d5.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "84:24", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5908.mp3", "translation": {"en": {"text": "So give them tidings of a painful doom,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onun için onlara elem verici bir azabı müjdele.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو تم انہیں دردناک عذاب کی بشارت دو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka beri kabar gembiralah mereka dengan azab yang pedih,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَبَشِّرْهُم", "hit": true, "audio": "audio/73ebdd3c177dd3bbcb73.m4a", "gloss": {"bs": "pa ih obavijesti", "en": "so give them tidings", "tr": "öyleyse onlara müjde ver", "fr": "annonce-leur donc la nouvelle", "id": "maka beri kabar gembira kepada mereka", "ur": "پس انہیں خوشخبری دو", "bn": "অতএব তাদের সুসংবাদ দাও", "fa": "پس به آنان مژده بده"}}, {"text": "بِعَذَابٍ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلِيمٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "9:21", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1256.mp3", "translation": {"en": {"text": "Their Lord giveth them good tidings of mercy from Him, and acceptance, and Gardens where enduring pleasure will be theirs;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rab'leri, onları kendi katından bir rahmet, bir rıza ve bir cennetle müjdeler ki o cennette onlar için bitmez tükenmez nimetler vardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ان کا رب انہیں خوشی سنا تا ہے اپنی رحمت اور اپنی رضا کی اور ان باغوں کی جن میں انہیں دائمی نعمت ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tuhan mereka menggembirakan mereka dengan memberikan rahmat dari pada-Nya, keridhaan dan surga, mereka memperoleh didalamnya kesenangan yang kekal,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يُبَشِّرُهُمْ", "hit": true, "audio": "audio/4117ac8a9eba22d82aa8.m4a", "gloss": {"en": "he/it gives them good news", "bs": "raduje ih", "tr": "onları müjdeler", "fr": "il les réjouit", "id": "dia memberi kabar gembira kepada mereka", "ur": "وہ انہیں خوشخبری دیتا ہے", "bn": "সে তাদের সুসংবাদ দেয়", "fa": "آنان را مژده می‌دهد"}}, {"text": "رَبُّهُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِرَحْمَةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَرِضْوَٰنٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَجَنَّٰتٍ", "hit": false, "audio": null, "gloss": null}, {"text": "لَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "نَعِيمٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مُّقِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:101", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3889.mp3", "translation": {"en": {"text": "So We gave him tidings of a gentle son.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz de kendisine yumuşak huylu bir oğul müjdeledik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ہم نے اسے خوشخبری سنائی ایک عقل مند لڑکے کی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Kami beri dia khabar gembira dengan seorang anak yang amat sabar.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَبَشَّرْنَٰهُ", "hit": true, "audio": "audio/d832e777666033f65fb6.m4a", "gloss": {"bs": "pa smo ga obradovali", "en": "so We gave him good news", "tr": "böylece ona müjde verdik", "fr": "alors Nous lui avons annoncé la bonne nouvelle", "id": "maka Kami memberinya kabar gembira", "ur": "پھر ہم نے اسے خوشخبری دی", "bn": "তখন আমরা তাকে সুসংবাদ দিলাম", "fa": "پس به او بشارت دادیم"}}, {"text": "بِغُلَٰمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "حَلِيمٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:53", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1855.mp3", "translation": {"en": {"text": "They said: Be not afraid! Lo! we bring thee good tidings of a boy possessing wisdom.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Melekler: \"Korkma! Gerçekten biz sana bilgin bir oğul müjdeliyoruz\" dediler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "انہوں نے کہا ڈریے نہیں ہم آپ کو ایک علم والے لڑکے کی بشارت دیتے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka berkata: \"Janganlah kamu merasa takut, sesungguhnya kami memberi kabar gembira kepadamu dengan (kelahiran seorang) anak laki-laki (yang akan menjadi) orang yang alim\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَوْجَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "نُبَشِّرُكَ", "hit": true, "audio": "audio/d79f42ee864477e06d85.m4a", "gloss": {"bs": "donosimo ti radosnu vijest", "en": "we give you good news", "tr": "sana müjde veriyoruz", "fr": "nous t'annonçons la bonne nouvelle", "id": "kami memberimu kabar gembira", "ur": "ہم تمہیں خوشخبری دیتے ہیں", "bn": "আমরা তোমাকে সুসংবাদ দিচ্ছি", "fa": "به تو بشارت می‌دهیم"}}, {"text": "بِغُلَٰمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلِيمٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:54", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1856.mp3", "translation": {"en": {"text": "He said: Bring ye me good tidings (of a son) when old age hath overtaken me? Of what then can ye bring good tidings?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İbrahim dedi ki: \"Bana ihtiyarlık gelmişken, beni mi müjdeliyorsunuz, neye dayanarak beni müjdeliyorsunuz?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہا کیا اس پر مجھے بشارت دیتے ہو کہ مجھے بڑھاپا پہنچ گیا اب کاہے پر بشارت دیتے ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berkata Ibrahim: \"Apakah kamu memberi kabar gembira kepadaku padahal usiaku telah lanjut, maka dengan cara bagaimanakah (terlaksananya) berita gembira yang kamu kabarkan ini?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَبَشَّرْتُمُونِى", "hit": true, "audio": "audio/dce8b628847e0b3820a8.m4a", "gloss": {"en": "did you (all) give me good news?", "bs": "zar ste me obradovali?", "tr": "beni müjdelediniz mi?", "fr": "nous avez-vous réjouis ?", "id": "apakah kalian telah memberiku kabar gembira?", "ur": "کیا تم مجھے خوشخبری دیتے ہو؟", "bn": "তোমরা কি আমাকে সুসংবাদ দিয়েছ?", "fa": "آیا مرا مژده دادید؟"}}, {"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "مَّسَّنِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكِبَرُ", "hit": false, "audio": null, "gloss": null}, {"text": "فَبِمَ", "hit": false, "audio": null, "gloss": null}, {"text": "تُبَشِّرُونَ", "hit": true, "audio": "audio/2a71611f12630638a918.m4a", "gloss": {"en": "you (all) give good news", "bs": "radujete", "tr": "müjdelersiniz", "fr": "vous réjouissez", "id": "kalian memberi kabar gembira", "ur": "تم سب خوشخبری دیتے ہو", "bn": "তোমরা সুসংবাদ দাও", "fa": "مژده می‌دهید"}}]}, {"ref": "19:97", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2347.mp3", "translation": {"en": {"text": "And We make (this Scripture) easy in thy tongue, (O Muhammad) only that thou mayst bear good tidings therewith unto those who ward off (evil), and warn therewith the froward folk.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Ey Muhammed!) Biz Kur'ân'ı senin dilin üzere kolaylaştırdık ki, onunla Allah'tan korkup sakınanları müjdeleyesin, inat edenleri de korkutasın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ہم نے یہ قرآن تمہاری زبان میں یونہی آسان فرمایا کہ تم اس سے ڈر والوں کو خوشخبری دو اور جھگڑالو لوگوں کو اس سے ڈر سناؤ،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka sesungguhnya telah Kami mudahkan Al Quran itu dengan bahasamu, agar kamu dapat memberi kabar gembira dengan Al Quran itu kepada orang-orang yang bertakwa, dan agar kamu memberi peringatan dengannya kepada kaum yang membangkang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَإِنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسَّرْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "بِلِسَانِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِتُبَشِّرَ", "hit": true, "audio": "audio/f313f8956dcf3194a75a.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "subjunctive"}]}, {"text": "بِهِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُتَّقِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتُنذِرَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "لُّدًّا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَبَشِّرِ", "count": 11, "first": "2:25", "audio": "audio/9c916678833fb767de34.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "and give good news!", "bs": "i obraduj!", "tr": "ve müjdele!", "fr": "et annonce la bonne nouvelle !", "id": "dan berilah kabar gembira!", "ur": "اور خوشخبری دے!", "bn": "এবং সুসংবাদ দাও!", "fa": "و مژده بده!"}}, {"arabic": "فَبَشِّرْهُم", "count": 3, "first": "3:21", "audio": "audio/267d849bce2cf3a1bb85.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": ["hum"]}], "gloss": {"bs": "pa ih obavijesti", "en": "so give them tidings", "tr": "öyleyse onlara müjde ver", "fr": "annonce-leur donc la nouvelle", "id": "maka beri kabar gembira kepada mereka", "ur": "پس انہیں خوشخبری دو", "bn": "অতএব তাদের সুসংবাদ দাও", "fa": "پس به آنان مژده بده"}}, {"arabic": "بُشِّرَ", "count": 3, "first": "16:58", "audio": "audio/c53dbb886ee14a840b08.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "he/it was given good news", "bs": "obradovan je", "tr": "müjdelendi", "fr": "il a reçu la bonne nouvelle", "id": "dia telah diberi kabar gembira", "ur": "اسے خوشخبری دی گئی", "bn": "তাকে সুসংবাদ দেওয়া হয়েছিল", "fa": "مژده داده شد"}}, {"arabic": "فَبَشِّرْهُ", "count": 3, "first": "31:7", "audio": "audio/caee4015b51f5573b41e.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "so give him good news!", "bs": "pa ga obraduj!", "tr": "böylece onu müjdele!", "fr": "alors annonce-lui la bonne nouvelle !", "id": "maka berilah dia kabar gembira!", "ur": "پس اسے خوشخبری دے!", "bn": "অতএব তাকে সুসংবাদ দাও!", "fa": "پس او را مژده بده!"}}, {"arabic": "نُبَشِّرُكَ", "count": 2, "first": "15:53", "audio": "audio/d79f42ee864477e06d85.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["anta"], "mood": "indicative"}], "gloss": {"bs": "donosimo ti radosnu vijest", "en": "we give you good news", "tr": "sana müjde veriyoruz", "fr": "nous t'annonçons la bonne nouvelle", "id": "kami memberimu kabar gembira", "ur": "ہم تمہیں خوشخبری دیتے ہیں", "bn": "আমরা তোমাকে সুসংবাদ দিচ্ছি", "fa": "به تو بشارت می‌دهیم"}}, {"arabic": "يُبَشِّرُكَ", "count": 1, "first": "3:39", "audio": "audio/7c294a0df85bfcb38282.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["anta"], "mood": "indicative"}], "gloss": {"en": "he/it gives you good news", "bs": "raduje te", "tr": "seni müjdeler", "fr": "il te réjouit", "id": "dia memberi kabar gembira kepadamu", "ur": "وہ تمہیں خوشخبری 