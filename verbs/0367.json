asy/3533.mp3", "translation": {"en": {"text": "So withdraw from them (O Muhammad), and await (the event). Lo! they (also) are awaiting (it).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Şimdi sen onlardan yüz çevir de gözet. Çünkü onlar da gözetmektedirler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ان سے منہ پھیرلو اور انتظار کرو بیشک انہیں بھی انتظار کرنا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka berpalinglah kamu dari mereka dan tunggulah, sesungguhnya mereka (juga) menunggu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَعْرِضْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱنتَظِرْ", "hit": true, "audio": "audio/00923e53683883220056.m4a", "gloss": {"en": "and wait!", "bs": "i čekaj!", "tr": "ve bekle!", "fr": "et attends !", "id": "dan tunggulah!", "ur": "اور انتظار کرو!", "bn": "এবং অপেক্ষা কর!", "fa": "و انتظار بکش!"}}, {"text": "إِنَّهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّنتَظِرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "فَٱنتَظِرُوٓا۟", "count": 3, "first": "7:71", "audio": "audio/b8e24163bde036b2a7fe.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) wait!", "bs": "pa čekajte!", "tr": "böylece bekleyin!", "fr": "alors attendez !", "id": "maka tunggulah kalian!", "ur": "پس تم سب انتظار کرو!", "bn": "অতএব অপেক্ষা কর!", "fa": "پس انتظار بکشید!"}}, {"arabic": "ٱنتَظِرُوٓا۟", "count": 1, "first": "6:158", "audio": "audio/a717d74d84ccd6509d7d.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "(you all) wait!", "bs": "čekajte!", "tr": "bekleyin!", "fr": "attendez !", "id": "tunggulah kalian!", "ur": "انتظار کرو!", "bn": "অপেক্ষা কর!", "fa": "انتظار بکشید!"}}, {"arabic": "يَنتَظِرُونَ", "c