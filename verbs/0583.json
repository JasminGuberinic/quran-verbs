": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1884.mp3", "translation": {"en": {"text": "And they used to hew out dwellings from the hills, (wherein they dwelt) secure.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, dağlardan emniyetli emniyetli evler yontuyorlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ پہاڑوں میں گھر تراشتے تھے بے خوف", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan mereka memahat rumah-rumah dari gunung-gunung batu (yang didiami) dengan aman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَكَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَنْحِتُونَ", "hit": true, "audio": "audio/afb49a068711cb7ed132.m4a", "gloss": {"bs": "klešu", "en": "hew", "tr": "yontuyorlar", "fr": "ils taillent", "id": "mereka memahat", "ur": "وہ تراشتے ہیں", "bn": "তারা খোদাই করে", "fa": "می‌تراشند"}}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْجِبَالِ", "hit": false, "audio": null, "gloss": null}, {"text": "بُيُوتًا", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامِنِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَتَنْحِتُونَ", "count": 2, "first": "7:74", "audio": "audio/1027e4822ed08006fae1.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and you (all) carve", "bs": "i klešete", "tr": "ve oyarsınız", "fr": "et vous sculptez", "id": "dan kalian memahat", "ur": "اور تم سب تراشتے ہو", "bn": "এবং তোমরা খোদাই কর", "fa": "و می‌تراشید"}}, {"arabic": "يَنْحِتُونَ", "count": 1, "first": "15:82", "audio": "audio/afb49a068711cb7ed132.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "klešu", "en": "hew", "tr": "oyarlar", "fr": "ils ta