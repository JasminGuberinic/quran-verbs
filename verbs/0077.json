"tr": "sizi haberdar ederim", "fr": "je vous informe", "id": "aku memberitahu kalian", "ur": "میں تمہیں خبر دیتا ہوں", "bn": "আমি তোমাদের জানাই", "fa": "شما را آگاه می‌کنم"}}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَنَزَّلُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلشَّيَٰطِينُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:103", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2243.mp3", "translation": {"en": {"text": "Say: Shall We inform you who will be the greatest losers by their works?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki: Amelleri en çok boşa gidenleri size bildirelim mi?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ کیا ہم تمہیں بتادیں کہ سب سے بڑھ کر ناقص عمل کن کے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah: \"Apakah akan Kami beritahukan kepadamu tentang orang-orang yang paling merugi perbuatannya?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "هَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "نُنَبِّئُكُم", "hit": true, "audio": "audio/f306c33e43f8913bfee7.m4a", "gloss": {"bs": "da vas obavijestimo", "en": "shall we inform you", "tr": "size haber verelim mi", "fr": "vous informerons-nous", "id": "apakah kami beri tahu kamu", "ur": "کیا ہم تمہیں خبر دیں", "bn": "আমরা কি তোমাদের জানাব", "fa": "(آیا) به شما خبر دهیم"}}, {"text": "بِٱلْأَخْسَرِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْمَٰلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:51", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1853.mp3", "translation": {"en": {"text": "And tell them of Abraham's guests,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hem o kullara, İbrahim'in misafirlerinden de haber ver.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور انہیں احوال سناؤ ابراہیم کے مہمانوں کا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan kabarkanlah kepada mereka tentang tamu-tamu Ibrahim.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَنَبِّئْهُمْ", "hit": true, "audio": "audio/b4f08c05c8232cd35405.m4a", "gloss": {"bs": "i obavijesti ih!", "en": "and inform them!", "tr": "ve onlara haber ver!", "fr": "et informe-les !", "id": "dan beri tahulah mereka!", "ur": "اور انہیں خبر دو!", "bn": "এবং তাদের জানিয়ে দাও!", "fa": "و به آنان خبر ده!"}}, {"text": "عَن", "hit": false, "audio": null, "gloss": null}, {"text": "ضَيْفِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِبْرَٰهِيمَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "فَيُنَبِّئُكُم", "count": 7, "first": "5:48", "audio": "audio/e440daa5810011af24cf.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "so he/it informs you (all)", "bs": "pa vas obavještava", "tr": "böylece sizi haberdar eder", "fr": "alors il vous informe", "id": "maka dia memberitahu kalian", "ur": "پس وہ تمہیں خبر دیتا ہے", "bn": "অতএব সে তোমাদের জানায়", "fa": "پس شما را آگاه می‌کند"}}, {"arabic": "فَيُنَبِّئُهُم", "count": 3, "first": "6:108", "audio": "audio/87f97184997706e118ae.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"en": "so he/it informs them", "bs": "pa ih obavještava", "tr": "böylece onları haberdar eder", "fr": "alors il les informe", "id": "maka dia memberitahu mereka", "ur": "پس وہ انہیں خبر دیتا ہے", "bn": "অতএব সে তাদের জানা