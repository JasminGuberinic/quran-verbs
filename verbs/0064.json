a7fb677e7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَقِيمَا", "plain": "أَقِيمَا", "quran": false, "notUsed": false, "spoken": "audio/e72f367c8026f6aa91ec.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَقِيمُوا۟", "plain": "أَقِيمُوا", "quran": true, "notUsed": false, "spoken": "audio/01d541a1dcbfab718ce6.m4a", "recited": "audio/cdab6dfa18f50c7c0fb5.m4a", "recitedText": "أَقِيمُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَقِمْنَ", "plain": "أَقِمْنَ", "quran": true, "notUsed": false, "spoken": "audio/4c67647241eb21caae19.m4a", "recited": "audio/e7ceb2d51ec599c751e0.m4a", "recitedText": "وَأَقِمْنَ"}], "ayat": [{"ref": "55:9", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4910.mp3", "translation": {"en": {"text": "But observe the measure strictly, nor fall short thereof.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Tartıyı adaletle yapın, terazide eksiklik yapmayın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور انصاف کے ساتھ تول قائم کرو اور وزن نہ گھٹاؤ،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan tegakkanlah timbangan itu dengan adil dan janganlah kamu mengurangi neraca itu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَقِيمُوا۟", "hit": true, "audio": "audio/24fe2138a4b432bc6379.m4a", "gloss": {"bs": "i uspostavite!", "en": "and establish!", "tr": "ve ikame edin!", "fr": "et établissez !", "id": "dan dirikanlah!", "ur": "اور قائم کرو!", "bn": "এবং কায়েম করো!", "fa": "و برپا دارید!"}}, {"text": "ٱلْوَزْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْقِسْطِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُخْسِرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمِيزَانَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:170", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1124.mp3", "translation": {"en": {"text": "And as for those who make (men) keep the Scripture, and establish worship - lo! We squander not the wages of reformers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kitaba sarılanlara ve namazı kılmaya devam edenlere gelince, biz o iyilerin ecrini hiçbir zaman yitirmeyiz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جو کتاب کو مضبوط تھامتے ہیں اور انہوں نے نماز قائم رکھی، ہم نیکوں کا نیگ (اجر) نہیں گنواتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang berpegang teguh dengan Al Kitab (Taurat) serta mendirikan shalat, (akan diberi pahala) karena sesungguhnya Kami tidak menyia-nyiakan pahala orang-orang yang mengadakan perbaikan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُمَسِّكُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْكِتَٰبِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَقَامُوا۟", "hit": true, "audio": "audio/4e8bcc1e794b8bb18703.m4a", "gloss": {"bs": "i obavljali su", "en": "and kept up", "tr": "ve dosdoğru kıldılar", "fr": "et ont accompli", "id": "dan mereka menegakkan", "ur": "اور انہوں نے قائم کی", "bn": "এবং তারা কায়েম করল", "fa": "و برپا داشتند"}}, {"text": "ٱلصَّلَوٰةَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "نُضِيعُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُصْلِحِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "8:3", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1163.mp3", "translation": {"en": {"text": "Who establish worship and spend of that We have bestowed on them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar ki, namazı gereği gibi kılarlar ve kendilerine rızık olarak verdiğimiz şeylerden Allah yoluna harcarlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ جو نماز قائم رکھیں اور ہمارے دیے سے کچھ ہماری راہ میں خرچ کریں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yaitu) orang-orang yang mendirikan shalat dan yang menafkahkan sebagian dari rezeki yang Kami berikan kepada mereka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُقِيمُونَ", "hit": true, "audio": "audio/24a08345ffc0363b5860.m4a", "gloss": {"bs": "obavljaju", "en": "keep up", "tr": "dosdoğru kılarlar", "fr": "accomplissent", "id": "tegakkanlah", "ur": "وہ قائم کرتے ہیں", "bn": "তারা কায়েম করে", "fa": "برپا می‌دارند"}}, {"text": "ٱلصَّلَوٰةَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمِمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "رَزَقْنَٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُنفِقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "10:105", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1469.mp3", "translation": {"en": {"text": "And, (O Muhammad) set thy purpose resolutely for religion, as a man by nature upright, and be not of those who ascribe partners (to Allah).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ayrıca yüzünü tevhid dininden ayırma ve sakın müşriklerden olma!\" (diye emrolundum).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ کہ اپنا منہ دین کے لیے سیدھا رکھ سب سے الگ ہوکر اور ہرگز شرک والوں میں نہ ہونا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan (aku telah diperintah): \"Hadapkanlah mukamu kepada agama dengan tulus dan ikhlas dan janganlah kamu termasuk orang-orang yang musyrik.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَقِمْ", "hit": true, "audio": "audio/7a769da97225a302d620.m4a", "gloss": {"en": "direct!", "bs": "usmjeri!", "tr": "yönelt!", "fr": "dirige !", "id": "arahkanlah!", "ur": "سیدھا کر!", "bn": "পরিচালিত কর!", "fa": "روی بیاور!"}}, {"text": "وَجْهَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلدِّينِ", "hit": false, "audio": null, "gloss": null}, {"text": "حَنِيفًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَكُونَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُشْرِكِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَأَقِيمُوا۟", "count": 11, "first": "2:43", "audio": "audio/a9982e09bffdbf41a483.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"bs": "i uspostavite!", "en": "and establish!", "tr": "ve ikame edin!", "fr": "et établissez !", "id": "dan dirikanlah!", "ur": "اور قائم کرو!", "bn": "এবং কায়েম করো!", "fa": "و برپا دارید!"}}, {"arabic": "وَأَقَامُوا۟", "count": 8, "first": "2:277", "audio": "audio/a5de0175be8a40cf6402.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "i obavljali su", "en": "and kept up", "tr": "ve dosdoğru kıldılar", "fr": "et ont accompli", "id": "dan mereka menegakkan", "ur": "اور انہوں نے قائم کی", "bn": "এবং তারা কায