/6fa78e4ff93f614256db.m4a", "gloss": {"bs": "su se klonili", "en": "avoided", "tr": "kaçındılar", "fr": "évitèrent", "id": "menghindari", "ur": "وہ بچے رہے", "bn": "বেঁচে থাকল", "fa": "دوری کردند"}}, {"text": "ٱلطَّٰغُوتَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْبُدُوهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنَابُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبُشْرَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "فَبَشِّرْ", "hit": false, "audio": null, "gloss": null}, {"text": "عِبَادِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَٱجْتَنِبُوا۟", "count": 2, "first": "16:36", "audio": "audio/2505b4772f401f643305.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) avoid!", "bs": "i izbjegavajte!", "tr": "ve kaçının!", "fr": "et évitez !", "id": "dan jauhilah!", "ur": "اور بچو!", "bn": "এবং তোমরা এড়িয়ে চল!", "fa": "و دوری کنید!"}}, {"arabic": "يَجْتَنِبُونَ", "count": 2, "first": "42:37", "audio": "audio/b55d77e15837695f9dbd.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "se klone", "en": "avoid", "tr": "kaçınırlar", "fr": "ils évitent", "id": "jauhilah", "ur": "وہ بچتے ہیں", "bn": "এড়িয়ে চলে", "fa": "دوری می‌کنند"}}, {"arabic": "تَجْتَنِبُوا۟", "count": 1, "first": "4:31", "audio": "audio/7cf4cf90331467000fce.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "you (all) avoid", "bs": "izbjegavate", "tr": "kaçınırsınız", "fr": "vous évitez", "id": "kalian menjauhi", "ur": "تم بچتے ہو",