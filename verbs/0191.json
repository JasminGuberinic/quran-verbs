"recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "وَفِّينَ", "plain": "وَفِّينَ", "quran": false, "notUsed": false, "spoken": "audio/9bdcecdaca4056536ed0.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "35:30", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3690.mp3", "translation": {"en": {"text": "That He will pay them their wages and increase them of His grace. Lo! He is Forgiving, Responsive.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Çünkü Allah mükafatlarını kendilerine tamamen ödedikten başka, lütfundan onlara fazlasını da verecektir. Çünkü O çok bağışlayıcı ve şükrün karşılığını vericidir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تاکہ ان کے ثواب انہیں بھرپور دے اور اپنے فضل سے اور زیادہ عطا کرے، بیشک وہ بخشنے والا قدر فرمانے والا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "agar Allah menyempurnakan kepada mereka pahala mereka dan menambah kepada mereka dari karunia-Nya. Sesungguhnya Allah Maha Pengampun lagi Maha Mensyukuri.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لِيُوَفِّيَهُمْ", "hit": true, "audio": "audio/c1ad2cbcb6122f2b2ef8.m4a", "gloss": {"bs": "da im u potpunosti isplati", "en": "so that He may pay them in full", "tr": "onlara tam olarak ödemesi için", "fr": "afin qu'Il les rétribue pleinement", "id": "agar Dia membalas mereka dengan sempurna", "ur": "تاکہ وہ انہیں پورا پورا دے", "bn": "যাতে তিনি তাদের পূর্ণ প্রতিদান দেন", "fa": "تا به آنان تمام و کمال بدهد"}}, {"text": "أُجُورَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَزِيدَهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "فَضْلِهِۦٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "غَفُورٌ", "hit": false, "audio": null, "gloss": null}, {"text": "شَكُورٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "53:37", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4821.mp3", "translation": {"en": {"text": "And Abraham who paid his debt:", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve çok vefakâr olan İbrahim'in sahifelerindekiler?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ابراہیم کے جو پورے احکام بجالایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan lembaran-lembaran Ibrahim yang selalu menyempurnakan janji?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِبْرَٰهِيمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَفَّىٰٓ", "hit": true, "audio": "audio/d4f04d0499123866472b.m4a", "gloss": {"bs": "je ispunio", "en": "fulfilled", "tr": "yerine getirdi", "fr": "a accompli pleinement", "id": "telah menepati", "ur": "اس نے پورا کیا", "bn": "পূর্ণ করেছে", "fa": "وفا کرد"}}]}], "forms": [{"arabic": "يُوَفَّ", "count": 2, "first": "2:272", "audio": "audio/f824f0a6bcd9cc999fc9.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "jussive"}], "gloss": {"en": "he/it is paid in full", "bs": "biva isplaćen u potpunosti", "tr": "tamamen ödenir", "fr": "il est payé en plein", "id": "dia dibayar penuh", "ur": "اسے پورا دیا جاتا ہے", "bn": "তাকে পূর্ণ মাত্রায় দেওয়া হয়", "fa": "به‌طور کامل پرداخت می‌شود"}}, {"arabic": "تُوَفَّىٰ", "count": 2, "first": "2:281", "audio": "audio/e129227bcb798216f8ac.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": true, "objects": [], "mood": "indicative"}]}, {"arabic": "وَوُفِّيَتْ", "count": 2, "first": "3:25", "audio": "audio/c6993432f058d7187792.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": true, "objects": []}], "gloss": {"en": "and she/it was paid in full", "bs": "i isplaćena je u potpunosti", "tr": "ve tamamen ödendi", "fr": "et elle a été payée en plein", "id": "dan dia dibayar penuh", "ur": "اور اسے پورا دیا گیا", "bn": "এবং তাকে পূর্ণ মাত্রায় দেওয়া হলো", "fa": "و به‌طور کامل پرداخت شد"}}, {"arabic": "فَيُوَفِّيهِمْ", "count": 2, "first": "3:57", "audio": "audio/c576fe2fc5780e20a0da.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"en": "so he/it pays them in full", "bs": "pa im isplaćuje u potpunosti", "tr": "böylece onlara tamamen öder", "fr": "alors il leur paie en plein", "id": "maka dia membayar mereka penuh", "ur": "پس وہ انہیں پورا دیتا ہے", "bn": "অতএব সে তাদের পূর্ণ মাত্রায় দেয়", "fa": "پس به‌طور کامل به آنان می‌دهد"}}, {"arabic": "تُوَفَّوْنَ", "count": 1, "first": "3:185", "audio": "audio/8c06f07cc60de0a04cf3.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "you (all) are paid in full", "bs": "isplaćuje vam se u potpunosti", "tr": "tamamen ödenirsiniz", "fr": "il vous est payé en plein", "id": "kalian dibayar penuh", "ur": "تم سب کو پورا دیا جاتا ہے", "bn": "তোমাদের পূর্ণ মাত্রায় দেওয়া হয়", "fa": "به‌طور کامل به شما داده می‌شود"}}, {"arabic": "نُوَفِّ", "count": 1, "first": "11:15", "audio": "audio/a48e3a11913a0efa96c3.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "we pay in full", "bs": "isplaćujemo u potpunosti", "tr": "tamamen öderiz", "fr": "nous payons en plein", "id": "kami membayar penuh", "ur": "ہم پورا دیتے ہیں", "bn": "আমরা পূর্ণ মাত্রায় দিই", "fa": "به‌طور کامل بپردازیم"}}, {"arabic": "لَيُوَفِّيَنَّهُمْ", "count": 1, "first": "11:111", "audio": "audio/7c378f5d8329a1d120e6.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"en": "surely he/it will pay them in full", "bs": "zaista će im isplatiti u potpunosti", "tr": "kesinlikle onlara tamamen ödeyecek", "fr": "il leur payera assurément en plein", "id": "sungguh dia akan membayar mereka penuh", "ur": "یقیناً وہ انہیں پورا دے گا", "bn": "নিশ্চয়ই সে তাদের পূর্ণ মাত্রায় দেবে", "fa": "قطعاً به‌طور کامل به آنان خواهد داد"}}, {"arabic": "وَتُوَفَّىٰ", "count": 1, "first": "16:111", "audio": "audio/545f93fa429ca1420f4c.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": true, "objects": [], "mood": "indicative"}]}, {"arabic": "يُوَفِّيهِمُ", "count": 1, "first": "24:25", "audio": "audio/f3c374401a0949bb0809.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"en": "he/it pays them in full", "bs": "isplaćuje im u potpunosti", "tr": "onlara tamamen öder", "fr": "il leur paie en plein", "id": "dia membayar mereka penuh", "ur": "وہ انہیں پورا دیتا ہے", "bn": "সে তাদের পূর্ণ মাত্রায় দেয়", "fa": "به‌طور کامل به آنان می‌دهد"}}, {"arabic": "فَوَفَّىٰهُ", "count": 1, "first": "24:39", "audio": "audio/3332d08b4fadd004ee65.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "so he/it paid him in full", "bs": "pa mu je isplatio u potpunosti", "tr": "böylece ona tamamen ödedi", "fr": "alors il lui a payé en plein", "id": "maka dia telah membayarnya penuh", "ur": "پس اُس نے اسے پورا دیا", "bn": "অতএব সে তাকে পূর্ণ মাত্রায় দিল", "fa": "پس به‌طور کامل به او داد"}}, {"arabic": "لِيُوَفِّيَهُمْ", "count": 1, "first": "35:30", "audio": "audio/c1ad2cbcb6122f2b2ef8.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["hum"], "mood": "subjunctive"}], "gloss": {"bs": "da im u potpunosti isplati", "en": "so that He may pay them in full", "tr": "onlara tam olarak ödemesi için", "fr": "afin qu'Il le