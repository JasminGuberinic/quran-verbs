rative", "pronoun": "antuma", "arabic": "اُدْخُلَا", "plain": "اُدْخُلَا", "quran": false, "notUsed": false, "spoken": "audio/758ddfcc053680214fe4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱدْخُلُوا۟", "plain": "اُدْخُلُوا", "quran": true, "notUsed": false, "spoken": "audio/bda9775d24709d8eff95.m4a", "recited": "audio/3089d5a9afedd81b3da6.m4a", "recitedText": "ٱدْخُلُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُدْخُلْنَ", "plain": "اُدْخُلْنَ", "quran": false, "notUsed": false, "spoken": "audio/86233c5e4655379e9c18.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "15:46", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1848.mp3", "translation": {"en": {"text": "(And it is said unto them): Enter them in peace, secure.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlara: \"Selametle güven içinde oraya girin\" denir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ان میں داخل ہو سلامتی کے ساتھ امان میں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Dikatakan kepada mereka): \"Masuklah ke dalamnya dengan sejahtera lagi aman\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱدْخُلُوهَا", "hit": true, "audio": "audio/8016ceec28e21d86a1a5.m4a", "gloss": {"bs": "uđite u njih!", "en": "enter it!", "tr": "girin onlara!", "fr": "entrez-y !", "id": "masukilah!", "ur": "اس میں داخل ہو جاؤ!", "bn": "তোমরা তাতে প্রবেশ করো!", "fa": "وارد آن شوید!"}}, {"text": "بِسَلَٰمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "110:2", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6215.mp3", "translation": {"en": {"text": "And thou seest mankind entering the religion of Allah in troops,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve insanların dalga dalga Allah'ın dinine girdiklerini gördüğünde,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور لوگوں کو تم دیکھو کہ اللہ کے دین میں فوج فوج داخل ہوتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan kamu lihat manusia masuk agama Allah dengan berbondong-bondong,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَرَأَيْتَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلنَّاسَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَدْخُلُونَ", "hit": true, "audio": "audio/789764165442709094ca.m4a", "gloss": {"en": "they enter", "bs": "ulaze", "tr": "girerler", "fr": "ils entrent", "id": "mereka masuk", "ur": "وہ داخل ہوتے ہیں", "bn": "তারা প্রবেশ করে", "fa": "وارد می‌شوند"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "دِينِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَفْوَاجًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:58", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1654.mp3", "translation": {"en": {"text": "And Joseph's brethren came and presented themselves before him, and he knew them but they knew him not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Bir gün) Yusuf'un kardeşleri çıkageldiler ve onun yanına girdiler. O, onları görür görmez tanıdı, oysa onlar onu tanıyamamışlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یوسف کے بھائی آئے تو اس کے پاس حاضر ہوئے تو یوسف نے انہیں پہچان لیا اور وہ اس سے انجان رہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan saudara-saudara Yusuf datang (ke Mesir} lalu mereka masuk ke (tempat)nya. Maka Yusuf mengenal mereka, sedang mereka tidak kenal (lagi) kepadanya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَجَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِخْوَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "يُوسُفَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَدَخَلُوا۟", "hit": true, "audio": "audio/2e9eea25d4f91978479d.m4a", "gloss": {"bs": "pa su ušli", "en": "and they entered", "tr": "ve girdiler", "fr": "et ils entrèrent", "id": "dan mereka masuk", "ur": "پھر وہ داخل ہوئے", "bn": "এবং তারা প্রবেশ করল", "fa": "و وارد شدند"}}, {"text": "عَلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَعَرَفَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "مُنكِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:35", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2175.mp3", "translation": {"en": {"text": "And he went into his garden, while he (thus) wronged himself. He said: I think not that all this will ever perish.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Adam, bu şekilde kendine zulmederek bağına girdi ve şöyle dedi: \"Bunun hiç yok olacağını sanmıyorum\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اپنے باغ میں گیا اور اپنی جان پر ظلم کرتا ہوا بولا مجھے گمان نہیں کہ یہ کبھی فنا ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan dia memasuki kebunnya sedang dia zalim terhadap dirinya sendiri; ia berkata: \"Aku kira kebun ini tidak akan binasa selama-lamanya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَدَخَلَ", "hit": true, "audio": "audio/44db033166459d3b8565.m4a", "gloss": {"en": "and he/it entered", "bs": "i ušao je", "tr": "ve girdi", "fr": "et il est entré", "id": "dan dia telah masuk", "ur": "اور وہ داخل ہوا", "bn": "এবং সে প্রবেশ করল", "fa": "و وارد شد"}}, {"text": "جَنَّتَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ظَالِمٌ", "hit": false, "audio": null, "gloss": null}, {"text": "لِّنَفْسِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَظُنُّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَبِيدَ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذِهِۦٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَبَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "68:24", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5295.mp3", "translation": {"en": {"text": "No needy man shall enter it to-day against you.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Sakın bugün hiçbir yoksul bahçeye girip yanınıza sokulmasın\" diyorlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہرگز آج کوئی مسکین تمہارے باغ میں آنے نہ پائے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "\"Pada hari ini janganlah ada seorang miskinpun masuk ke dalam kebunmu\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَدْخُلَنَّهَا", "hit": true, "audio": "audio/558dc8e98b6c736e597a.m4a", "gloss": {"bs": "(niko) neće ući u nju", "en": "(no one) shall enter it", "tr": "(hiç kimse) ona girmeyecek", "fr": "(que nul) n'y entre", "id": "(tidak seoran