{"rank": 8, "root": "عمل", "form": 1, "lemma": "عَمِلَ", "count": 276, "ayahCount": 255, "share": 1.43, "meaning": {"bs": "raditi, činiti", "en": "to do, to work", "tr": "yapmak, amel etmek", "fr": "faire, œuvrer", "id": "mengerjakan, beramal", "ur": "عمل کرنا", "bn": "করা, কাজ করা", "fa": "عمل کردن، کار کردن"}, "lemmaSpoken": "audio/c2c4a9b1b1fbccd9168c.m4a", "animation": "<svg class=\"va va-amila_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes amila_1-a{from{transform:rotate(-150deg)}}@keyframes amila_1-k{from{opacity:0}}.va-amila_1 .ra{transform:rotate(-70deg);animation:amila_1-a .35s ease-in 7 alternate both}.va-amila_1 .kk{animation:amila_1-k .35s step-end 7 alternate both}.va-amila_1 .hm{stroke-width:4}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-amila_1.off,.va-amila_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-amila_1,.va-amila_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><path class=\"p\" d=\"M66 44h32M70 44v17M94 44v17\"/><rect class=\"q\" x=\"73\" y=\"38\" width=\"9\" height=\"6\"/><path class=\"p kk\" d=\"M86 36l4-3M86 40h5\"/><g transform=\"translate(56 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"p\" d=\"M0 13v8\"/><path class=\"p hm\" d=\"M-4 21h8\"/><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "عَمِلَ", "plain": "عَمِلَ", "quran": true, "notUsed": false, "spoken": "audio/c2c4a9b1b1fbccd9168c.m4a", "rec