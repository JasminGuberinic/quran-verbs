{"rank": 236, "root": "كشف", "form": 1, "lemma": "كَشَفَ", "count": 14, "ayahCount": 14, "share": 0.07, "meaning": {"bs": "otkloniti, otkriti", "en": "to remove, to uncover", "tr": "gidermek, açmak", "fr": "lever, dévoiler", "id": "menyingkap, menghilangkan", "ur": "دور کرنا، کھول دینا", "bn": "দূর করা, উন্মোচন করা", "fa": "برطرف کردن، آشکار کردن"}, "lemmaSpoken": "audio/5ac9b41ce1e1901df6c4.m4a", "animation": "<svg class=\"va va-kashafa_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes kc{from{transform:translate(0,0)}}.va-kashafa_1 .cl{transform:translate(30px,-8px);animation:kc 1.2s ease-in-out both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-kashafa_1.off,.va-kashafa_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-kashafa_1,.va-kashafa_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><circle class=\"q\" cx=\"60\" cy=\"56\" r=\"4.5\"/><path class=\"q cl\" d=\"M48 61q0-18 12-18t12 18z\"/></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "كَشَفَ", "plain": "كَشَفَ", "quran": true, "notUsed": false, "spoken": "audio/5ac9b41ce1e1901df6c4.m4a", "recited": "audio/dbad03cc269bbbefdb42.m4a", "recitedText": "كَشَفَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَكْشِفُ", "plain": "يَكْشِفُ", "quran": true, "notUsed": false, "spoken": "audio/90b96daf888761db9b1e.m4a", "recited": "audio/f6a3cf36354b5a9a2ede.m4a", "recitedText": "فَيَكْشِفُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱكْشِفْ", "plain": "اِكْشِفْ", "quran": true, "notUsed": false, "spoken": "audio/e5b12a79fa1c2bbe8fe2.m4a", "recited": "audio/e06e5b7ae8d0cc7d77ce.m4a", "recitedText": "ٱكْشِفْ"}], "nouns": {"participle": {"lemma": "كاشِف", "count": 3, "spoken": "audio/ce1e786c0076c6f34bb4.m4a"}}, "cells": [{"tense": "past", "pronoun"