{"ayat":[{"ref":"102:1","number":6169,"text":"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","hits":[0]},{"ref":"102:2","number":6170,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","hits":[0]},{"ref":"102:3","number":6171,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","hits":[0,1,2]},{"ref":"102:4","number":6172,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","hits":[0]},{"ref":"102:5","number":6173,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","hits":[1,3,4]},{"ref":"102:6","number":6174,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","hits":[0]},{"ref":"102:7","number":6175,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","hits":[2]},{"ref":"102:8","number":6176,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","hits":[1,2,3,4]}]}