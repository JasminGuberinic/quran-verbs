in": "قَدِّرْنَ", "quran": false, "notUsed": false, "spoken": "audio/325603b862386eb04ff0.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "74:18", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5513.mp3", "translation": {"en": {"text": "For lo! he did consider; then he planned -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Çünkü o bir düşündü, ölçtü, biçti.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک وہ سوچا اور دل میں کچھ بات ٹھہرائی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya dia telah memikirkan dan menetapkan (apa yang ditetapkannya),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فَكَّرَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَقَدَّرَ", "hit": true, "audio": "audio/74232c9ffb87aa12f3e7.m4a", "gloss": {"bs": "i odmjeravao je", "en": "and he determined", "tr": "ve takdir etti", "fr": "et il a déterminé", "id": "dan dia menentukan", "ur": "اور اس نے اندازہ کیا", "bn": "এবং সে নির্ধারণ করল", "fa": "و اندازه گرفت"}}]}, {"ref": "15:60", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1862.mp3", "translation": {"en": {"text": "Except his wife, of whom We had decreed that she should be of those who stay behind.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yalnız Lût'un karısı müstesnâ, çünkü onun helak edilenlerle birlikte yok edilmesini takdir ettik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "مگر اس کی عورت ہم ٹھہراچکے ہیں کہ وہ پیچھے رہ جانے والوں میں ہے، ف۶۵)", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "kecuali istrinya. Kami telah menentukan, bahwa sesungguhnya ia itu termasuk orang-orang yang tertinggal (bersama-sama dengan orang kafir lainnya)\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱمْرَأَتَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "قَدَّرْنَآ", "hit": true, "audio": "audio/c67d9bf407ead50dc857.m4a", "gloss": {"en": "we decreed", "bs": "odredili smo", "tr": "takdir ettik", "fr": "nous avons décrété", "id": "kami telah menetapkan", "ur": "ہم نے مقرر کیا", "bn": "আমরা নির্ধারণ করেছি", "fa": "مقدر کردیم"}}, {"text": "إِنَّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَمِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْغَٰبِرِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "34:11", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3617.mp3", "translation": {"en": {"text": "Saying: Make thou long coats of mail and measure the links (thereof). And do ye right. Lo! I am Seer of what ye do.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bol bol zırhlar yap ve biçimlemede ölçüyü gözet dedik. Siz de iyi işler yapın, çünkü ben her yapacağınızı gözetiyorum.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ وسیع زِر ہیں بنا اور بنانے میں اندازے کا لحاظ رکھ اور تم سب نیکی کرو، بیشک تمہارے کام دیکھ رہا ہوں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yaitu) buatlah baju besi yang besar-besar dan ukurlah anyamannya; dan kerjakanlah amalan yang saleh. Sesungguhnya Aku melihat apa yang kamu kerjakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱعْمَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "سَٰبِغَٰتٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَقَدِّرْ", "hit": true, "audio": "audio/016b9ad3cdb0e8a6f6b2.m4a", "gloss": {"bs": "i odmjeri", "en": "and measure", "tr": "ve takdir et", "fr": "et mesure", "id": "dan takarlah", "ur": "اور اندازہ کر", "bn": "এবং পরিমাপ করো", "fa": "و اندازه بگیر"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّرْدِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱعْمَلُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "صَٰلِحًا", "hit": false, "audio": null, "gloss": null}, {"text": "إِنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْمَلُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "بَصِيرٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "76:16", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5607.mp3", "translation": {"en": {"text": "(Bright as) glass but (made) of silver, which they (themselves) have measured to the measure (of their deeds).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Gümüşten öyle kadehler ki onları türlü türlü biçimlere koymuşlardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیسے شیشے چاندی کے ساقیوں نے انہیں پورے اندازہ پر رکھا ہوگا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yaitu) kaca-kaca (yang terbuat) dari perak yang telah diukur mereka dengan sebaik-baiknya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَوَارِيرَا۟", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "فِضَّةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "قَدَّرُوهَا", "hit": true, "audio": "audio/e7814338054f37141a00.m4a", "gloss": {"en": "they measured them", "bs": "odmjerili su ih", "tr": "onları ölçtüler", "fr": "ils les ont mesurés", "id": "mereka telah mengukur mereka", "ur": "انہوں نے ان کا اندازہ کیا", "bn": "তারা তাদের পরিমাপ করল", "fa": "آنان را اندازه گرفتند"}}, {"text": "تَقْدِيرًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "قَدَّرَ", "count": 3, "first": "74:19", "audio": "audio/c3d526d3546d22158454.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it determined", "bs": "odredio je", "tr": "belirledi", "fr": "il a déterminé", "id": "dia telah menetapkan", "ur": "اُس نے مقرر کیا", "bn": "সে নির্ধারণ করল", "fa": "مقدر کرد"}}, {"arabic": "فَقَدَّرَهُۥ", "count": 2, "first": "25:2", "audio": "audio/d78179f53f305e80aa32.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "so he/it measured him/it", "bs": "pa ga je odmjerio", "tr": "böylece onu ölçtü", "fr": "alors il l'a mesuré", "id": "maka dia telah mengukurnya", "ur": "پس اُس نے اس کا اندازہ کیا", "bn": "অতএব সে তা পরিমাপ করল", "fa": "پس آن را اندازه کرد"}}, {"arabic": "وَقَدَّرَ", "count": 2, "first": "41:10", "audio": "audio/47596837ee6d813c7adf.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "i odmjeravao je", "en": "and he determined", "tr": "ve takdir etti", "fr": "et il a déterminé", "id": "dan dia menentukan", "ur": "اور اس نے اندازہ کیا", "bn": "এবং সে নির্ধারণ করল", "fa": "و اندازه گرفت"}}, {"arabic": "وَقَدَّرَهُۥ", "count": 1, "first": "10:5", "audio": "audio/11f433ffc461816defc9.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "and he/it determined it", "bs": "i odredio ga je", "tr": "ve onu belirledi", "fr": "et il l'a déterminé", "id": "dan dia telah menetapkannya", "ur": "اور اُس نے اسے مقرر کیا", "bn": "এবং সে তা নির্ধারণ করল", "fa": "و آن را مقدر کرد"}}, {"arabic": "قَدَّرْنَآ", "count": 1, "first": "15:60", "audio": "audio/c67d9bf407ead50dc857.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": fa