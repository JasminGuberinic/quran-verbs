: "huwa", "translation": {"bs": "Gužva prisiljava vozača da čeka.", "en": "The crowding forces the driver to wait.", "bn": "ভিড় চালককে অপেক্ষা করতে বাধ্য করে।", "fa": "ازدحام راننده را به انتظار ناچار می‌کند.", "fr": "L'embouteillage contraint le conducteur à attendre.", "id": "Kerumunan memaksa sopir itu untuk menunggu.", "tr": "Kalabalık şoförü beklemeye mecbur eder.", "ur": "بھیڑ ڈرائیور کو انتظار پر مجبور کرتی ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَضْطَرُّ", "target": true, "translation": {"bs": "prisiljava", "en": "forces", "bn": "বাধ্য করে", "fa": "مجبور می‌کند", "fr": "contraint", "id": "memaksa", "tr": "zorlar", "ur": "مجبور کرتا ہے"}}, {"arabic": "الزِّحَامُ", "target": false, "translation": {"bs": "gužva", "en": "the crowding", "bn": "ভিড়", "fa": "ازدحام", "fr": "l'embouteillage", "id": "kerumunan itu", "tr": "kalabalık", "ur": "بھیڑ"}}, {"arabic": "السَّائِقَ", "target": false, "translation": {"bs": "vozača", "en": "the driver", "bn": "চালক", "fa": "راننده", "fr": "le conducteur", "id": "sopir itu", "tr": "şoför", "ur": "ڈرائیور"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "da", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "الِانْتِظَارِ", "target": false, "translation": {"bs": "čeka", "en": "waiting", "bn": "অপেক্ষা করা", "fa": "انتظار", "fr": "l'attente", "id": "menunggu", "tr": "beklemek", "ur": "انتظار"}}]}, {"arabic": "لَا أَضْطَرُّ أَحَدًا إِلَى الْبَقَاءِ", "spoken": "audio/3efa401ecc0e0cff3f73.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Ne prisiljavam nikoga da ostane.", "en": "I do not force anyone to remain.", "bn": "আমি কাউকে থেকে যেতে বাধ্য করি না।", "fa": "من هیچ‌کس را به ماندن ناچار نمی‌کنم.", "fr": "Je ne contrains personne à rester.", "id": "Aku tidak memaksa siapa pun untuk tetap tinggal.", "tr": "Hiç kimseyi kalmaya zorlamam.", "ur": "میں کسی کو رکنے پر مجبور نہیں کرتا۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "أَضْطَرُّ", "target": true, "translation": {"bs": "prisiljavam", "en": "force", "bn": "আমি বাধ্য করি", "fa": "مجبور می‌کنم", "fr": "je suis contraint de", "id": "aku terpaksa", "tr": "zorlarım", "ur": "میں مجبور کرتا ہوں"}}, {"arabic": "أَحَدًا", "target": false, "translation": {"bs": "nikoga", "en": "one", "bn": "কাউকে", "fa": "هیچ‌کس", "fr": "quelqu'un", "id": "seorang pun", "tr": "hiç kimse", "ur": "کسی کو"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "da", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "الْبَقَاءِ", "target": false, "translation": {"bs": "ostane", "en": "remaining", "bn": "থেকে যাওয়া", "fa": "ماندن", "fr": "rester", "id": "tetap tinggal", "tr": "kalmak", "ur": "رکنے"}}]}, {"arabic": "اِضْطَرُّوا الْمُدِيرَ إِلَى الِاسْتِقَالَةِ", "spoken": "audio/1b6161eda47a6a4b4461.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Prisilili su direktora na ostavku.", "en": "They forced the manager to resign.", "bn": "তারা ব্যবস্থাপককে পদত্যাগ করতে বাধ্য করল।", "fa": "آنان مدیر را به استعفا ناچار کردند.", "fr": "Ils ont contraint le directeur à démissionner.", "id": "Mereka memaksa manajer itu untuk mengundurkan diri.", "tr": "Müdürü istifaya zorladılar.", "ur": "انہوں نے مینیجر کو استعفیٰ دینے پر مجبور کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِضْطَرُّوا", "target": true, "translation": {"bs": "prisilili su", "en": "forced", "bn": "তারা বাধ্য করল", "fa": "مجبور کردند", "fr": "ils ont contraint", "id": "mereka terpaksa", "tr": "zorladılar", "ur": "انہوں نے مجبور کیا"}}, {"arabic": "الْمُدِيرَ", "target": false, "translation": {"bs": "direktora", "en": "the manager", "bn": "পরিচালককে", "fa": "مدیر", "fr": "le directeur", "id": "direktur itu", "tr": "müdür", "ur": "منیجر"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "na", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "الِاسْتِقَالَةِ", "target": false, "translation": {"bs": "ostavku", "en": "the resignation", "bn": "পদত্যাগ", "fa": "استعفا", "fr": "la démission", "id": "pengunduran diri", "tr": "istifa", "ur": "استعفیٰ"}}]}]}