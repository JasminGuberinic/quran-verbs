[{"id":"jaza-37-110-1","words":["verb:jaza"],"options":[{"bs":"nagrađujemo","en":"We reward"},{"bs":"da te nagradi","en":"so that he/it may reward you"},{"bs":"uzvratit će im","en":"he/it will repay them"},{"bs":"i nagradit će","en":"and he/it will reward"}],"ref":"37:110","answerWord":"نَجْزِى","answerSound":"audio/1ebe9880cd91fb37ed34.m4a","quranTranslation":{"text":"Thus do We reward the good.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["كَذَٰلِكَ","نَجْزِى","ٱلْمُحْسِنِينَ"],"marked":[1],"facts":{"verb":"جَزَى"}},{"id":"jaza-14-51-0","words":["verb:jaza"],"options":[{"bs":"da nagradi","en":"so that he/it may reward"},{"bs":"da te nagradi","en":"so that he/it may reward you"},{"bs":"i nagradio ih je","en":"and He rewarded them"},{"bs":"da ih nagradi","en":"so that he/it may reward them"}],"ref":"14:51","answerWord":"لِيَجْزِىَ","answerSound":"audio/1bdaa79a3369ae328b52.m4a","quranTranslation":{"text":"That Allah may repay each soul what it hath earned. Lo! Allah is swift at reckoning.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["لِيَجْزِىَ","ٱللَّهُ","كُلَّ","نَفْسٍ","مَّا","كَسَبَتْ","إِنَّ","ٱللَّهَ","سَرِيعُ","ٱلْحِسَابِ"],"marked":[0],"facts":{"verb":"جَزَى"}},{"id":"jaza-7-147-8","words":["verb:jaza"],"options":[{"bs":"biva im uzvraćeno","en":"they are repaid"},{"bs":"i zaista ćemo nagraditi","en":"and surely we will reward"},{"bs":"uzvratili smo im","en":"we repaid them"},{"bs":"i nagrađuje","en":"and he/it rewards"}],"ref":"7:147","answerWord":"يُجْزَوْنَ","answerSound":"audio/901ecbb0905f4c1ec54a.m4a","quranTranslation":{"text":"Those who deny Our revelations and the meeting of the Hereafter, their works are fruitless. Are they requited aught save what they used to do?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["وَٱلَّذِينَ","كَذَّبُوا۟","بِـَٔايَٰتِنَا","وَلِقَآءِ","ٱلْءَاخِرَةِ","حَبِطَتْ","أَعْمَٰلُهُمْ","هَلْ","يُجْزَوْنَ","إِلَّا","مَا","كَانُوا۟","يَعْمَلُونَ"],"marked":[8],"facts":{"verb":"جَزَى"}},{"id":"jaza-12-88-19","words":["verb:jaza"],"options":[{"bs":"nagrađuje","en":"he/it rewards"},{"bs":"nagrađujemo","en":"We reward"},{"bs":"da ih nagradi","en":"so that he/it may reward them"},{"bs":"i nagradio ih je","en":"and He rewarded them"}],"ref":"12:88","answerWord":"يَجْزِى","answerSound":"audio/89579cff478a9494d06c.m4a","quranTranslation":{"text":"And when they came (again) before him (Joseph) they said: O ruler! Misfortune hath touched us and our folk, and we bring but poor merchandise, so fill for us the measure and be charitable unto us. Lo! Allah will requite the charitable,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["فَلَمَّا","دَخَلُوا۟","عَلَيْهِ","قَالُوا۟","يَٰٓأَيُّهَا","ٱلْعَزِيزُ","مَسَّنَا","وَأَهْلَنَا","ٱلضُّرُّ","وَجِئْنَا","بِبِضَٰعَةٍ","مُّزْجَىٰةٍ","فَأَوْفِ","لَنَا","ٱلْكَيْلَ","وَتَصَدَّقْ","عَلَيْنَآ","إِنَّ","ٱللَّهَ","يَجْزِى","ٱلْمُتَصَدِّقِينَ"],"marked":[19],"facts":{"verb":"جَزَى"}},{"id":"jaza-16-97-12","words":["verb:jaza"],"options":[{"bs":"i zaista ćemo ih nagraditi","en":"and surely we will reward them"},{"bs":"nagradio sam ih","en":"I rewarded them"},{"bs":"uzvraćamo mu","en":"we repay him"},{"bs":"nagrađuje","en":"he/it rewards"}],"ref":"16:97","answerWord":"وَلَنَجْزِيَنَّهُمْ","answerSound":"audio/47f8dc992e3ab6a63bd2.m4a","quranTranslation":{"text":"Whosoever doeth right, whether male or female, and is a believer, him verily we shall quicken with good life, and We shall pay them a recompense in proportion to the best of what they used to do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["مَنْ","عَمِلَ","صَٰلِحًا","مِّن","ذَكَرٍ","أَوْ","أُنثَىٰ","وَهُوَ","مُؤْمِنٌ","فَلَنُحْيِيَنَّهُۥ","حَيَوٰةً","طَيِّبَةً","وَلَنَجْزِيَنَّهُمْ","أَجْرَهُم","بِأَحْسَنِ","مَا","كَانُوا۟","يَعْمَلُونَ"],"marked":[12],"facts":{"verb":"جَزَى"}},{"id":"jaza-6-120-8","words":["verb:jaza"],"options":[{"bs":"bit će im uzvraćeno","en":"they will be repaid"},{"bs":"nagradio sam ih","en":"I rewarded them"},{"bs":"i nagrađuje ih","en":"and he/it rewards them"},{"bs":"uzvratili smo im","en":"we repaid them"}],"ref":"6:120","answerWord":"سَيُجْزَوْنَ","answerSound":"audio/8da7796818281cf2dfd0.m4a","quranTranslation":{"text":"Forsake the outwardness of sin and the inwardness thereof. Lo! those who garner sin will be awarded that which they have earned.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["وَذَرُوا۟","ظَٰهِرَ","ٱلْإِثْمِ","وَبَاطِنَهُۥٓ","إِنَّ","ٱلَّذِينَ","يَكْسِبُونَ","ٱلْإِثْمَ","سَيُجْزَوْنَ","بِمَا","كَانُوا۟","يَقْتَرِفُونَ"],"marked":[8],"facts":{"verb":"جَزَى"}},{"id":"jaza-34-17-1","words":["verb:jaza"],"options":[{"bs":"uzvratili smo im","en":"we repaid them"},{"bs":"uzvraćamo mu","en":"we repay him"},{"bs":"i zaista ćemo ih nagraditi","en":"and surely we will reward them"},{"bs":"nagrađuje","en":"he/it rewards"}],"ref":"34:17","answerWord":"جَزَيْنَٰهُم","answerSound":"audio/e0c2a98685ffccb2e2b3.m4a","quranTranslation":{"text":"This We awarded them because of their ingratitude. Punish We ever any save the ingrates?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["ذَٰلِكَ","جَزَيْنَٰهُم","بِمَا","كَفَرُوا۟","وَهَلْ","نُجَٰزِىٓ","إِلَّا","ٱلْكَفُورَ"],"marked":[1],"facts":{"verb":"جَزَى"}},{"id":"jaza-6-160-10","words":["verb:jaza"],"options":[{"bs":"uzvraća mu se","en":"he/it is repaid"},{"bs":"da te nagradi","en":"so that he/it may reward you"},{"bs":"i zaista ćemo ih nagraditi","en":"and surely we will reward them"},{"bs":"biva im uzvraćeno","en":"they are repaid"}],"ref":"6:160","answerWord":"يُجْزَىٰٓ","answerSound":"audio/9eaf01f863ed0663a8cb.m4a","quranTranslation":{"text":"Whoso bringeth a good deed will receive tenfold the like thereof, while whoso bringeth an ill-deed will be awarded but the like thereof; and they will not be wronged.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["مَن","جَآءَ","بِٱلْحَسَنَةِ","فَلَهُۥ","عَشْرُ","أَمْثَالِهَا","وَمَن","جَآءَ","بِٱلسَّيِّئَةِ","فَلَا","يُجْزَىٰٓ","إِلَّا","مِثْلَهَا","وَهُمْ","لَا","يُظْلَمُونَ"],"marked":[10],"facts":{"verb":"جَزَى"}},{"id":"jaza-9-121-12","words":["verb:jaza"],"options":[{"bs":"da ih nagradi","en":"so that he/it may reward them"},{"bs":"da nagradi","en":"so that he/it may reward"},{"bs":"biva vam uzvraćeno","en":"you (all) are repaid"},{"bs":"biva im uzvraćeno","en":"they are repaid"}],"ref":"9:121","answerWord":"لِيَجْزِيَهُمُ","answerSound":"audio/1231dde86a72ad7ebbf9.m4a","quranTranslation":{"text":"Nor spend they any spending, small or great, nor do they cross a valley, but it is recorded for them, that Allah may repay them the best of what they used to do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["وَلَا","يُنفِقُونَ","نَفَقَةً","صَغِيرَةً","وَلَا","كَبِيرَةً","وَلَا","يَقْطَعُونَ","وَادِيًا","إِلَّا","كُتِبَ","لَهُمْ","لِيَجْزِيَهُمُ","ٱللَّهُ","أَحْسَنَ","مَا","كَانُوا۟","يَعْمَلُونَ"],"marked":[12],"facts":{"verb":"جَزَى"}},{"id":"jaza-33-24-0","words":["verb:jaza"],"options":[{"bs":"da nagradi","en":"so that he/it may reward"},{"bs":"uzvratili smo im","en":"we repaid them"},{"bs":"uzvraćamo mu","en":"we repay him"},{"bs":"biva im uzvraćeno","en":"they are repaid"}],"ref":"33:24","answerWord":"لِّيَجْزِىَ","answerSound":"audio/c4d1246210027bcc2f0d.m4a","quranTranslation":{"text":"That Allah may reward the true men for their truth, and punish the hypocrites if He will, or relent toward them (if He will). Lo! Allah is Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["لِّيَجْزِىَ","ٱللَّهُ","ٱلصَّٰدِقِينَ","بِصِدْقِهِمْ","وَيُعَذِّبَ","ٱلْمُنَٰفِقِينَ","إِن","شَآءَ","أَوْ","يَتُوبَ","عَلَيْهِمْ","إِنَّ","ٱللَّهَ","كَانَ","غَفُورًا","رَّحِيمًا"],"marked":[0],"facts":{"verb":"جَزَى"}},{"id":"jaza-3-144-24","words":["verb:jaza"],"options":[{"bs":"i nagradit će","en":"and he/it will reward"},{"bs":"da ih nagradi","en":"so that he/it may reward them"},{"bs":"biva vam uzvraćeno","en":"you (all) are repaid"},{"bs":"uzvratili smo im","en":"we repaid them"}],"ref":"3:144","answerWord":"وَسَيَجْزِى","answerSound":"audio/100c7bf2ab179515b72f.m4a","quranTranslation":{"text":"Muhammad is but a messenger, messengers (the like of whom) have passed away before him. Will it be that, when he dieth or is slain, ye will turn back on your heels? He who turneth back on his heels doth no hurt to Allah, and Allah will reward the thankful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["وَمَا","مُحَمَّدٌ","إِلَّا","رَسُولٌ","قَدْ","خَلَتْ","مِن","قَبْلِهِ","ٱلرُّسُلُ","أَفَإِي۟ن","مَّاتَ","أَوْ","قُتِلَ","ٱنقَلَبْتُمْ","عَلَىٰٓ","أَعْقَٰبِكُمْ","وَمَن","يَنقَلِبْ","عَلَىٰ","عَقِبَيْهِ","فَلَن","يَضُرَّ","ٱللَّهَ","شَيْـًٔا","وَسَيَجْزِى","ٱللَّهُ","ٱلشَّٰكِرِينَ"],"marked":[24],"facts":{"verb":"جَزَى"}},{"id":"jaza-3-145-22","words":["verb:jaza"],"options":[{"bs":"i nagradit ćemo","en":"and we will reward"},{"bs":"uzvraćamo mu","en":"we repay him"},{"bs":"biva vam uzvraćeno","en":"you (all) are repaid"},{"bs":"i nagrađuje","en":"and he/it rewards"}],"ref":"3:145","answerWord":"وَسَنَجْزِى","answerSound":"audio/2c2557558af86a4ae479.m4a","quranTranslation":{"text":"No soul can ever die except by Allah's leave and at a term appointed. Whoso desireth the reward of the world, We bestow on him thereof; and whoso desireth the reward of the Hereafter, We bestow on him thereof. We shall reward the thankful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["وَمَا","كَانَ","لِنَفْسٍ","أَن","تَمُوتَ","إِلَّا","بِإِذْنِ","ٱللَّهِ","كِتَٰبًا","مُّؤَجَّلًا","وَمَن","يُرِدْ","ثَوَابَ","ٱلدُّنْيَا","نُؤْتِهِۦ","مِنْهَا","وَمَن","يُرِدْ","ثَوَابَ","ٱلْءَاخِرَةِ","نُؤْتِهِۦ","مِنْهَا","وَسَنَجْزِى","ٱلشَّٰكِرِينَ"],"marked":[22],"facts":{"verb":"جَزَى"}},{"id":"jaza-4-123-9","words":["verb:jaza"],"options":[{"bs":"uzvraća mu se","en":"he/it is repaid"},{"bs":"nagrađujemo","en":"We reward"},{"bs":"biva im uzvraćeno","en":"they are repaid"},{"bs":"i nagradio ih je","en":"and He rewarded them"}],"ref":"4:123","answerWord":"يُجْزَ","answerSound":"audio/6445971c04d32965c70a.m4a","quranTranslation":{"text":"It will not be in accordance with your desires, nor the desires of the People of the Scripture. He who doeth wrong will have the recompense thereof, and will not find against Allah any protecting friend or helper.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["لَّيْسَ","بِأَمَانِيِّكُمْ","وَلَآ","أَمَانِىِّ","أَهْلِ","ٱلْكِتَٰبِ","مَن","يَعْمَلْ","سُوٓءًا","يُجْزَ","بِهِۦ","وَلَا","يَجِدْ","لَهُۥ","مِن","دُونِ","ٱللَّهِ","وَلِيًّا","وَلَا","نَصِيرًا"],"marked":[9],"facts":{"verb":"جَزَى"}},{"id":"jaza-6-138-22","words":["verb:jaza"],"options":[{"bs":"uzvratit će im","en":"he/it will repay them"},{"bs":"biva im uzvraćeno","en":"they are repaid"},{"bs":"i nagrađuje","en":"and he/it rewards"},{"bs":"uzvraća mu se","en":"he/it is repaid"}],"ref":"6:138","answerWord":"سَيَجْزِيهِم","answerSound":"audio/0b0a927ffb47214c17af.m4a","quranTranslation":{"text":"And they say: Such cattle and crops are forbidden. No-one is to eat of them save whom we will - in their make-believe - cattle whose backs are forbidden, cattle over which they mention not the name of Allah. (All that is) a lie against Him. He will repay them for that which they invent.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["وَقَالُوا۟","هَٰذِهِۦٓ","أَنْعَٰمٌ","وَحَرْثٌ","حِجْرٌ","لَّا","يَطْعَمُهَآ","إِلَّا","مَن","نَّشَآءُ","بِزَعْمِهِمْ","وَأَنْعَٰمٌ","حُرِّمَتْ","ظُهُورُهَا","وَأَنْعَٰمٌ","لَّا","يَذْكُرُونَ","ٱسْمَ","ٱللَّهِ","عَلَيْهَا","ٱفْتِرَآءً","عَلَيْهِ","سَيَجْزِيهِم","بِمَا","كَانُوا۟","يَفْتَرُونَ"],"marked":[22],"facts":{"verb":"جَزَى"}},{"id":"jaza-6-139-17","words":["verb:jaza"],"options":[{"bs":"uzvratit će im","en":"he/it will repay them"},{"bs":"uzvratili smo im","en":"we repaid them"},{"bs":"uzvraća mu se","en":"he/it is repaid"},{"bs":"nagrađuje","en":"he/it rewards"}],"ref":"6:139","answerWord":"سَيَجْزِيهِمْ","answerSound":"audio/59c4fe1db2c9805d2473.m4a","quranTranslation":{"text":"And they say: That which is in the bellies of such cattle is reserved for our males and is forbidden to our wives; but if it be born dead, then they (all) may be partakers thereof. He will reward them for their attribution (of such ordinances unto Him). Lo, He is Wise, Aware.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["وَقَالُوا۟","مَا","فِى","بُطُونِ","هَٰذِهِ","ٱلْأَنْعَٰمِ","خَالِصَةٌ","لِّذُكُورِنَا","وَمُحَرَّمٌ","عَلَىٰٓ","أَزْوَٰجِنَا","وَإِن","يَكُن","مَّيْتَةً","فَهُمْ","فِيهِ","شُرَكَآءُ","سَيَجْزِيهِمْ","وَصْفَهُمْ","إِنَّهُۥ","حَكِيمٌ","عَلِيمٌ"],"marked":[17],"facts":{"verb":"جَزَى"}},{"id":"jaza-16-96-7","words":["verb:jaza"],"options":[{"bs":"i zaista ćemo nagraditi","en":"and surely we will reward"},{"bs":"da nagradi","en":"so that he/it may reward"},{"bs":"nagradio sam ih","en":"I rewarded them"},{"bs":"da ih nagradi","en":"so that he/it may reward them"}],"ref":"16:96","answerWord":"وَلَنَجْزِيَنَّ","answerSound":"audio/b9df81794bdf97840a79.m4a","quranTranslation":{"text":"That which ye have wasteth away, and that which Allah hath remaineth. And verily We shall pay those who are steadfast a recompense in proportion to the best of what they used to do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["مَا","عِندَكُمْ","يَنفَدُ","وَمَا","عِندَ","ٱللَّهِ","بَاقٍ","وَلَنَجْزِيَنَّ","ٱلَّذِينَ","صَبَرُوٓا۟","أَجْرَهُم","بِأَحْسَنِ","مَا","كَانُوا۟","يَعْمَلُونَ"],"marked":[7],"facts":{"verb":"جَزَى"}},{"id":"jaza-21-29-8","words":["verb:jaza"],"options":[{"bs":"uzvraćamo mu","en":"we repay him"},{"bs":"da nagradi","en":"so that he/it may reward"},{"bs":"nagradio sam ih","en":"I rewarded them"},{"bs":"uzvraća mu se","en":"he/it is repaid"}],"ref":"21:29","answerWord":"نَجْزِيهِ","answerSound":"audio/2807699283217aff4f52.m4a","quranTranslation":{"text":"And one of them who should say: Lo! I am a god beside Him, that one We should repay with hell. Thus We Repay wrong-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["وَمَن","يَقُلْ","مِنْهُمْ","إِنِّىٓ","إِلَٰهٌ","مِّن","دُونِهِۦ","فَذَٰلِكَ","نَجْزِيهِ","جَهَنَّمَ","كَذَٰلِكَ","نَجْزِى","ٱلظَّٰلِمِينَ"],"marked":[8],"facts":{"verb":"جَزَى"}},{"id":"jaza-23-111-1","words":["verb:jaza"],"options":[{"bs":"nagradio sam ih","en":"I rewarded them"},{"bs":"uzvratit će im","en":"he/it will repay them"},{"bs":"biva vam uzvraćeno","en":"you (all) are repaid"},{"bs":"i nagradio ih je","en":"and He rewarded them"}],"ref":"23:111","answerWord":"جَزَيْتُهُمُ","answerSound":"audio/0cc58d2d34ede47b673b.m4a","quranTranslation":{"text":"Lo! I have rewarded them this day forasmuch as they were steadfast in that they, even they, are the triumphant.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["إِنِّى","جَزَيْتُهُمُ","ٱلْيَوْمَ","بِمَا","صَبَرُوٓا۟","أَنَّهُمْ","هُمُ","ٱلْفَآئِزُونَ"],"marked":[1],"facts":{"verb":"جَزَى"}},{"id":"jaza-28-25-9","words":["verb:jaza"],"options":[{"bs":"da te nagradi","en":"so that he/it may reward you"},{"bs":"i nagrađuje","en":"and he/it rewards"},{"bs":"i nagradio ih je","en":"and He rewarded them"},{"bs":"i nagradit ćemo","en":"and we will reward"}],"ref":"28:25","answerWord":"لِيَجْزِيَكَ","answerSound":"audio/3938c046e37f6818b145.m4a","quranTranslation":{"text":"Then there came unto him one of the two women, walking shyly. She said: Lo! my father biddeth thee, that he may reward thee with a payment for that thou didst water (the flock) for us. Then, when he came unto him and told him the (whole) story, he said: Fear not! Thou hast escaped from the wrongdoing folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["فَجَآءَتْهُ","إِحْدَىٰهُمَا","تَمْشِى","عَلَى","ٱسْتِحْيَآءٍ","قَالَتْ","إِنَّ","أَبِى","يَدْعُوكَ","لِيَجْزِيَكَ","أَجْرَ","مَا","سَقَيْتَ","لَنَا","فَلَمَّا","جَآءَهُۥ","وَقَصَّ","عَلَيْهِ","ٱلْقَصَصَ","قَالَ","لَا","تَخَفْ","نَجَوْتَ","مِنَ","ٱلْقَوْمِ","ٱلظَّٰلِمِينَ"],"marked":[9],"facts":{"verb":"جَزَى"}},{"id":"jaza-28-84-10","words":["verb:jaza"],"options":[{"bs":"uzvraća mu se","en":"he/it is repaid"},{"bs":"biva vam uzvraćeno","en":"you (all) are repaid"},{"bs":"da ih nagradi","en":"so that he/it may reward them"},{"bs":"nagradio sam ih","en":"I rewarded them"}],"ref":"28:84","answerWord":"يُجْزَى","answerSound":"audio/b6ee468849eac7f6fe46.m4a","quranTranslation":{"text":"Whoso bringeth a good deed, he will have better than the same; while as for him who bringeth an ill-deed, those who do ill-deeds will be requited only what they did.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nagraditi, nadoknaditi","en":"to reward, to repay"},"passage":["مَن","جَآءَ","بِٱلْحَسَنَةِ","فَلَهُۥ","خَيْرٌ","مِّنْهَا","وَمَن","جَآءَ","بِٱلسَّيِّئَةِ","فَلَا","يُجْزَى","ٱلَّذِينَ","عَمِلُوا۟","ٱلسَّيِّـَٔاتِ","إِلَّا","مَا","كَانُوا۟","يَعْمَلُونَ"],"marked":[10],"facts":{"verb":"جَزَى"}},{"id":"aslama-72-14-6","words":["verb:aslama"],"options":[{"bs":"predao se","en":"he/it submitted"},{"bs":"predajete se","en":"you (all) submit"},{"bs":"zar ste se predali?","en":"did you (all) submit?"},{"bs":"i predao sam se","en":"and I submitted"}],"ref":"72:14","answerWord":"أَسْلَمَ","answerSound":"audio/cc7aef106dd085cf9607.m4a","quranTranslation":{"text":"And there are among us some who have surrendered (to Allah) and there are among us some who are unjust. And whoso hath surrendered to Allah, such have taken the right path purposefully.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["وَأَنَّا","مِنَّا","ٱلْمُسْلِمُونَ","وَمِنَّا","ٱلْقَٰسِطُونَ","فَمَنْ","أَسْلَمَ","فَأُو۟لَٰٓئِكَ","تَحَرَّوْا۟","رَشَدًا"],"marked":[6],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-3-20-15","words":["verb:aslama"],"options":[{"bs":"predali su se","en":"they submitted"},{"bs":"predajem se","en":"I submit"},{"bs":"da se predamo","en":"so that we may submit"},{"bs":"zar ste se predali?","en":"did you (all) submit?"}],"ref":"3:20","answerWord":"أَسْلَمُوا۟","answerSound":"audio/83136805f654a326cd96.m4a","quranTranslation":{"text":"And if they argue with thee, (O Muhammad), say: I have surrendered my purpose to Allah and (so have) those who follow me. And say unto those who have received the Scripture and those who read not: Have ye (too) surrendered? If they surrender, then truly they are rightly guided, and if they turn away, then it is thy duty only to convey the message (unto them). Allah is Seer of (His) bondmen.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["فَإِنْ","حَآجُّوكَ","فَقُلْ","أَسْلَمْتُ","وَجْهِىَ","لِلَّهِ","وَمَنِ","ٱتَّبَعَنِ","وَقُل","لِّلَّذِينَ","أُوتُوا۟","ٱلْكِتَٰبَ","وَٱلْأُمِّيِّۦنَ","ءَأَسْلَمْتُمْ","فَإِنْ","أَسْلَمُوا۟","فَقَدِ","ٱهْتَدَوا۟","وَّإِن","تَوَلَّوْا۟","فَإِنَّمَا","عَلَيْكَ","ٱلْبَلَٰغُ","وَٱللَّهُ","بَصِيرٌۢ","بِٱلْعِبَادِ"],"marked":[15],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-2-131-6","words":["verb:aslama"],"options":[{"bs":"predao sam se","en":"I have submitted"},{"bs":"predaje se","en":"he/it submits"},{"bs":"predali smo se","en":"we submitted"},{"bs":"predao se","en":"he/it submitted"}],"ref":"2:131","answerWord":"أَسْلَمْتُ","answerSound":"audio/594d072d532220bffb92.m4a","quranTranslation":{"text":"When his Lord said unto him: Surrender! he said: I have surrendered to the Lord of the Worlds.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["إِذْ","قَالَ","لَهُۥ","رَبُّهُۥٓ","أَسْلِمْ","قَالَ","أَسْلَمْتُ","لِرَبِّ","ٱلْعَٰلَمِينَ"],"marked":[6],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-2-131-4","words":["verb:aslama"],"options":[{"bs":"predaj se","en":"submit"},{"bs":"i predao sam se","en":"and I submitted"},{"bs":"predali su se","en":"they submitted"},{"bs":"predajte se!","en":"(you all) submit!"}],"ref":"2:131","answerWord":"أَسْلِمْ","answerSound":"audio/4782f642b0a8d464979c.m4a","quranTranslation":{"text":"When his Lord said unto him: Surrender! he said: I have surrendered to the Lord of the Worlds.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["إِذْ","قَالَ","لَهُۥ","رَبُّهُۥٓ","أَسْلِمْ","قَالَ","أَسْلَمْتُ","لِرَبِّ","ٱلْعَٰلَمِينَ"],"marked":[4],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-3-20-13","words":["verb:aslama"],"options":[{"bs":"zar ste se predali?","en":"did you (all) submit?"},{"bs":"predajete se","en":"you (all) submit"},{"bs":"predaj se","en":"submit"},{"bs":"obojica su se predala","en":"they both submitted"}],"ref":"3:20","answerWord":"ءَأَسْلَمْتُمْ","answerSound":"audio/91578c2747070dfa3a87.m4a","quranTranslation":{"text":"And if they argue with thee, (O Muhammad), say: I have surrendered my purpose to Allah and (so have) those who follow me. And say unto those who have received the Scripture and those who read not: Have ye (too) surrendered? If they surrender, then truly they are rightly guided, and if they turn away, then it is thy duty only to convey the message (unto them). Allah is Seer of (His) bondmen.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["فَإِنْ","حَآجُّوكَ","فَقُلْ","أَسْلَمْتُ","وَجْهِىَ","لِلَّهِ","وَمَنِ","ٱتَّبَعَنِ","وَقُل","لِّلَّذِينَ","أُوتُوا۟","ٱلْكِتَٰبَ","وَٱلْأُمِّيِّۦنَ","ءَأَسْلَمْتُمْ","فَإِنْ","أَسْلَمُوا۟","فَقَدِ","ٱهْتَدَوا۟","وَّإِن","تَوَلَّوْا۟","فَإِنَّمَا","عَلَيْكَ","ٱلْبَلَٰغُ","وَٱللَّهُ","بَصِيرٌۢ","بِٱلْعِبَادِ"],"marked":[13],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-16-81-24","words":["verb:aslama"],"options":[{"bs":"predajete se","en":"you (all) submit"},{"bs":"predaju se","en":"they submit"},{"bs":"predao sam se","en":"I have submitted"},{"bs":"predajte se!","en":"(you all) submit!"}],"ref":"16:81","answerWord":"تُسْلِمُونَ","answerSound":"audio/5dc6fda63d29d884701c.m4a","quranTranslation":{"text":"And Allah hath given you, of that which He hath created, shelter from the sun; and hath given you places of refuge in the mountains, and hath given you coats to ward off the heat from you, and coats (of armour) to save you from your own foolhardiness. Thus doth He perfect His favour unto you, in order that ye may surrender (unto Him).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["وَٱللَّهُ","جَعَلَ","لَكُم","مِّمَّا","خَلَقَ","ظِلَٰلًا","وَجَعَلَ","لَكُم","مِّنَ","ٱلْجِبَالِ","أَكْنَٰنًا","وَجَعَلَ","لَكُمْ","سَرَٰبِيلَ","تَقِيكُمُ","ٱلْحَرَّ","وَسَرَٰبِيلَ","تَقِيكُم","بَأْسَكُمْ","كَذَٰلِكَ","يُتِمُّ","نِعْمَتَهُۥ","عَلَيْكُمْ","لَعَلَّكُمْ","تُسْلِمُونَ"],"marked":[24],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-22-34-17","words":["verb:aslama"],"options":[{"bs":"predajte se!","en":"(you all) submit!"},{"bs":"predali su se","en":"they submitted"},{"bs":"predajem se","en":"I submit"},{"bs":"i predao sam se","en":"and I submitted"}],"ref":"22:34","answerWord":"أَسْلِمُوا۟","answerSound":"audio/a3b002350aea097f6ee9.m4a","quranTranslation":{"text":"And for every nation have We appointed a ritual, that they may mention the name of Allah over the beast of cattle that He hath given them for food; and your god is One God, therefor surrender unto Him. And give good tidings (O Muhammad) to the humble,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["وَلِكُلِّ","أُمَّةٍ","جَعَلْنَا","مَنسَكًا","لِّيَذْكُرُوا۟","ٱسْمَ","ٱللَّهِ","عَلَىٰ","مَا","رَزَقَهُم","مِّنۢ","بَهِيمَةِ","ٱلْأَنْعَٰمِ","فَإِلَٰهُكُمْ","إِلَٰهٌ","وَٰحِدٌ","فَلَهُۥٓ","أَسْلِمُوا۟","وَبَشِّرِ","ٱلْمُخْبِتِينَ"],"marked":[17],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-27-44-22","words":["verb:aslama"],"options":[{"bs":"i predao sam se","en":"and I submitted"},{"bs":"obojica su se predala","en":"they both submitted"},{"bs":"predaju se","en":"they submit"},{"bs":"predajem se","en":"I submit"}],"ref":"27:44","answerWord":"وَأَسْلَمْتُ","answerSound":"audio/ebc8762e18e646663a79.m4a","quranTranslation":{"text":"It was said unto her: Enter the hall. And when she saw it she deemed it a pool and bared her legs. (Solomon) said: Lo! it is a hall, made smooth, of glass. She said: My Lord! Lo! I have wronged myself, and I surrender with Solomon unto Allah, the Lord of the Worlds.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["قِيلَ","لَهَا","ٱدْخُلِى","ٱلصَّرْحَ","فَلَمَّا","رَأَتْهُ","حَسِبَتْهُ","لُجَّةً","وَكَشَفَتْ","عَن","سَاقَيْهَا","قَالَ","إِنَّهُۥ","صَرْحٌ","مُّمَرَّدٌ","مِّن","قَوَارِيرَ","قَالَتْ","رَبِّ","إِنِّى","ظَلَمْتُ","نَفْسِى","وَأَسْلَمْتُ","مَعَ","سُلَيْمَٰنَ","لِلَّهِ","رَبِّ","ٱلْعَٰلَمِينَ"],"marked":[22],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-31-22-1","words":["verb:aslama"],"options":[{"bs":"predaje se","en":"he/it submits"},{"bs":"predaj se","en":"submit"},{"bs":"obojica su se predala","en":"they both submitted"},{"bs":"predao se","en":"he/it submitted"}],"ref":"31:22","answerWord":"يُسْلِمْ","answerSound":"audio/1cd0fbff2badde820e0c.m4a","quranTranslation":{"text":"Whosoever surrendereth his purpose to Allah while doing good, he verily hath grasped the firm hand-hold. Unto Allah belongeth the sequel of all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["وَمَن","يُسْلِمْ","وَجْهَهُۥٓ","إِلَى","ٱللَّهِ","وَهُوَ","مُحْسِنٌ","فَقَدِ","ٱسْتَمْسَكَ","بِٱلْعُرْوَةِ","ٱلْوُثْقَىٰ","وَإِلَى","ٱللَّهِ","عَٰقِبَةُ","ٱلْأُمُورِ"],"marked":[1],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-37-103-1","words":["verb:aslama"],"options":[{"bs":"obojica su se predala","en":"they both submitted"},{"bs":"predao se","en":"he/it submitted"},{"bs":"predajte se!","en":"(you all) submit!"},{"bs":"predajem se","en":"I submit"}],"ref":"37:103","answerWord":"أَسْلَمَا","answerSound":"audio/2a9831eace94610a4cc0.m4a","quranTranslation":{"text":"Then, when they had both surrendered (to Allah), and he had flung him down upon his face,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["فَلَمَّآ","أَسْلَمَا","وَتَلَّهُۥ","لِلْجَبِينِ"],"marked":[1],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-39-54-3","words":["verb:aslama"],"options":[{"bs":"i predajte se!","en":"and (you all) submit!"},{"bs":"i predao sam se","en":"and I submitted"},{"bs":"predaju se","en":"they submit"},{"bs":"predao se","en":"he/it submitted"}],"ref":"39:54","answerWord":"وَأَسْلِمُوا۟","answerSound":"audio/5c16034a92be966a012c.m4a","quranTranslation":{"text":"Turn unto your Lord repentant, and surrender unto Him, before there come unto you the doom, when ye cannot be helped.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["وَأَنِيبُوٓا۟","إِلَىٰ","رَبِّكُمْ","وَأَسْلِمُوا۟","لَهُۥ","مِن","قَبْلِ","أَن","يَأْتِيَكُمُ","ٱلْعَذَابُ","ثُمَّ","لَا","تُنصَرُونَ"],"marked":[3],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-40-66-17","words":["verb:aslama"],"options":[{"bs":"predajem se","en":"I submit"},{"bs":"i predao sam se","en":"and I submitted"},{"bs":"predaje se","en":"he/it submits"},{"bs":"obojica su se predala","en":"they both submitted"}],"ref":"40:66","answerWord":"أُسْلِمَ","answerSound":"audio/ffcfeacb41335d6cf5e7.m4a","quranTranslation":{"text":"Say (O Muhammad): I am forbidden to worship those unto whom ye cry beside Allah since there have come unto me clear proofs from my Lord, and I am commanded to surrender to the Lord of the Worlds.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["قُلْ","إِنِّى","نُهِيتُ","أَنْ","أَعْبُدَ","ٱلَّذِينَ","تَدْعُونَ","مِن","دُونِ","ٱللَّهِ","لَمَّا","جَآءَنِىَ","ٱلْبَيِّنَٰتُ","مِن","رَّبِّى","وَأُمِرْتُ","أَنْ","أُسْلِمَ","لِرَبِّ","ٱلْعَٰلَمِينَ"],"marked":[17],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-48-16-12","words":["verb:aslama"],"options":[{"bs":"predaju se","en":"they submit"},{"bs":"predajete se","en":"you (all) submit"},{"bs":"predao sam se","en":"I have submitted"},{"bs":"predaje se","en":"he/it submits"}],"ref":"48:16","answerWord":"يُسْلِمُونَ","answerSound":"audio/ae00f91ee024e4af3225.m4a","quranTranslation":{"text":"Say unto those of the wandering Arabs who were left behind: Ye will be called against a folk of mighty prowess, to fight them until they surrender; and if ye obey, Allah will give you a fair reward; but if ye turn away as ye did turn away before, He will punish you with a painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["قُل","لِّلْمُخَلَّفِينَ","مِنَ","ٱلْأَعْرَابِ","سَتُدْعَوْنَ","إِلَىٰ","قَوْمٍ","أُو۟لِى","بَأْسٍ","شَدِيدٍ","تُقَٰتِلُونَهُمْ","أَوْ","يُسْلِمُونَ","فَإِن","تُطِيعُوا۟","يُؤْتِكُمُ","ٱللَّهُ","أَجْرًا","حَسَنًا","وَإِن","تَتَوَلَّوْا۟","كَمَا","تَوَلَّيْتُم","مِّن","قَبْلُ","يُعَذِّبْكُمْ","عَذَابًا","أَلِيمًا"],"marked":[12],"facts":{"verb":"أَسْلَمَ"}},{"id":"aslama-49-14-8","words":["verb:aslama"],"options":[{"bs":"predali smo se","en":"we submitted"},{"bs":"predao sam se","en":"I have submitted"},{"bs":"predajem se","en":"I submit"},{"bs":"i predajte se!","en":"and (you all) submit!"}],"ref":"49:14","answerWord":"أَسْلَمْنَا","answerSound":"audio/b466d54492a349572dbb.m4a","quranTranslation":{"text":"The wandering Arabs say: We believe. Say (unto them, O Muhammad): Ye believe not, but rather say \"We submit,\" for the faith hath not yet entered into your hearts. Yet, if ye obey Allah and His messenger, He will not withhold from you aught of (the reward of) your deeds. Lo! Allah is Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"predati se, pokoriti se","en":"to submit, to surrender"},"passage":["قَالَتِ","ٱلْأَعْرَابُ","ءَامَنَّا","قُل","لَّمْ","تُؤْمِنُوا۟","وَلَٰكِن","قُولُوٓا۟","أَسْلَمْنَا","وَلَمَّا","يَدْخُلِ","ٱلْإِيمَٰنُ","فِى","قُلُوبِكُمْ","وَإِن","تُطِيعُوا۟","ٱللَّهَ","وَرَسُولَهُۥ","لَا","يَلِتْكُم","مِّنْ","أَعْمَٰلِكُمْ","شَيْـًٔا","إِنَّ","ٱللَّهَ","غَفُورٌ","رَّحِيمٌ"],"marked":[8],"facts":{"verb":"أَسْلَمَ"}},{"id":"sharaha-16-106-14","words":["verb:sharaha"],"options":[{"bs":"otvorio je","en":"he/it opened"},{"bs":"otvori","en":"expand"},{"bs":"otvara","en":"he/it opens"},{"bs":"(zar) nismo otvorili","en":"(did) We (not) expand"}],"ref":"16:106","answerWord":"شَرَحَ","answerSound":"audio/e218a2ddd29afe1faf20.m4a","quranTranslation":{"text":"Whoso disbelieveth in Allah after his belief - save him who is forced thereto and whose heart is still content with the Faith - but whoso findeth ease in disbelief: On them is wrath from Allah. Theirs will be an awful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"otvoriti, proširiti; objasniti","en":"to open, to expand; to explain"},"passage":["مَن","كَفَرَ","بِٱللَّهِ","مِنۢ","بَعْدِ","إِيمَٰنِهِۦٓ","إِلَّا","مَنْ","أُكْرِهَ","وَقَلْبُهُۥ","مُطْمَئِنٌّۢ","بِٱلْإِيمَٰنِ","وَلَٰكِن","مَّن","شَرَحَ","بِٱلْكُفْرِ","صَدْرًا","فَعَلَيْهِمْ","غَضَبٌ","مِّنَ","ٱللَّهِ","وَلَهُمْ","عَذَابٌ","عَظِيمٌ"],"marked":[14],"facts":{"verb":"شَرَحَ"}},{"id":"sharaha-6-125-5","words":["verb:sharaha"],"options":[{"bs":"otvara","en":"he/it opens"},{"bs":"(zar) nismo otvorili","en":"(did) We (not) expand"},{"bs":"otvori","en":"expand"},{"bs":"otvorio je","en":"he/it opened"}],"ref":"6:125","answerWord":"يَشْرَحْ","answerSound":"audio/4666b5ce078f820d566a.m4a","quranTranslation":{"text":"And whomsoever it is Allah's will to guide, He expandeth his bosom unto the Surrender, and whomsoever it is His Will to send astray, He maketh his bosom close and narrow as if he were engaged in sheer ascent. Thus Allah layeth ignominy upon those who believe not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"otvoriti, proširiti; objasniti","en":"to open, to expand; to explain"},"passage":["فَمَن","يُرِدِ","ٱللَّهُ","أَن","يَهْدِيَهُۥ","يَشْرَحْ","صَدْرَهُۥ","لِلْإِسْلَٰمِ","وَمَن","يُرِدْ","أَن","يُضِلَّهُۥ","يَجْعَلْ","صَدْرَهُۥ","ضَيِّقًا","حَرَجًا","كَأَنَّمَا","يَصَّعَّدُ","فِى","ٱلسَّمَآءِ","كَذَٰلِكَ","يَجْعَلُ","ٱللَّهُ","ٱلرِّجْسَ","عَلَى","ٱلَّذِينَ","لَا","يُؤْمِنُونَ"],"marked":[5],"facts":{"verb":"شَرَحَ"}},{"id":"sharaha-20-25-2","words":["verb:sharaha"],"options":[{"bs":"otvori","en":"expand"},{"bs":"(zar) nismo otvorili","en":"(did) We (not) expand"},{"bs":"otvara","en":"he/it opens"},{"bs":"otvorio je","en":"he/it opened"}],"ref":"20:25","answerWord":"ٱشْرَحْ","answerSound":"audio/213a65a5e0cc4a67cc1e.m4a","quranTranslation":{"text":"(Moses) said: My Lord! relieve my mind","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"otvoriti, proširiti; objasniti","en":"to open, to expand; to explain"},"passage":["قَالَ","رَبِّ","ٱشْرَحْ","لِى","صَدْرِى"],"marked":[2],"facts":{"verb":"شَرَحَ"}},{"id":"sharaha-94-1-1","words":["verb:sharaha"],"options":[{"bs":"(zar) nismo otvorili","en":"(did) We (not) expand"},{"bs":"otvara","en":"he/it opens"},{"bs":"otvorio je","en":"he/it opened"},{"bs":"otvori","en":"expand"}],"ref":"94:1","answerWord":"نَشْرَحْ","answerSound":"audio/19ea62d963c3fa15fa40.m4a","quranTranslation":{"text":"Have We not caused thy bosom to dilate,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"otvoriti, proširiti; objasniti","en":"to open, to expand; to explain"},"passage":["أَلَمْ","نَشْرَحْ","لَكَ","صَدْرَكَ"],"marked":[1],"facts":{"verb":"شَرَحَ"}}]