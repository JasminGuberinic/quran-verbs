ss": null}, {"text": "سِنِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱزْدَادُوا۟", "hit": true, "audio": "audio/5cc043e8f0eb848339fa.m4a", "gloss": {"bs": "i dodali su", "en": "and they added", "tr": "ve (bilgiyi) artırdılar", "fr": "et ils ont ajouté", "id": "dan mereka menambah", "ur": "اور انہوں نے اضافہ کیا", "bn": "এবং তারা বৃদ্ধি করল", "fa": "و افزودند"}}, {"text": "تِسْعًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ٱزْدَادُوا۟", "count": 2, "first": "3:90", "audio": "audio/c153ced8f0df86f3f85c.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they increased", "bs": "povećali su se", "tr": "çoğaldılar", "fr": "ils se sont multipliés", "id": "mereka telah bertambah", "ur": "وہ بڑھ گئے", "bn": "তারা বৃদ্ধি পেয়েছে", "fa": "افزون شدند"}}, {"arabic": "لِيَزْدَادُوٓا۟", "count": 2, "first": "3:178", "audio": "audio/7bfbfbd0e5f2e98444ea.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "so that they may increase", "bs": "da se povećaju", "tr": "çoğalsınlar diye", "fr": "qu'ils se multiplient", "id": "agar mereka bertambah", "ur": "تاکہ وہ بڑھیں", "bn": "যাতে তারা বৃদ্ধি পায়", "fa": "تا افزون شوند"}}, {"arabic": "وَنَزْدَادُ", "count": 1, "first": "12:65", "audio": "audio/e9a882a8d89a737d0886.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and we increase", "bs": "i povećavamo se", "tr": "ve çoğaltırız", "fr": "et nous nous multiplions", "id": "dan kami bertambah", "ur": "اور ہم بڑھاتے ہیں", "bn": "এবং আমরা বৃদ্ধি করি", "fa": "و افزون می‌کنیم"}}, {"arabic": "تَزْدَادُ", "count": 1, "first": "13:8", "audio": "audio/6feb360e3028bf737601.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}, {"arabic": "وَٱزْدَادُوا۟", "count": 1, "first": "18:25", "audio": "audio/5cc043e8f0eb848339fa.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "i dodali su", "en": "and they added", "tr": "ve (bilgiyi) artırdılar", "fr": "et ils ont ajouté", "id": "dan mereka menambah", "ur": "اور انہوں نے اضافہ کیا", "bn": "এবং তারা বৃদ্ধি করল", "fa": "و افزودند"}}, {"arabic": "وَيَزْدَادَ", "count": 1, "first": "74:31", "audio": "audio/7690d6197853f3c61ba4.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "and he/it increases", "bs": "i povećava se", "tr": "ve çoğaltır", "fr": "et qu'il se multiplie", "id": "dan dia bertambah", "ur": "اور وہ بڑھاتا ہے", "bn": "এবং সে বৃদ্ধি করে", "fa": "و افزون کند"}}], "ayatFile": "ayat/0351.json", "ayatTranslations": {"en": "ayat/0351.en.json", "tr": "ayat/0351.tr.json", "ur": "ayat/0351.ur.json", "id": "ayat/0351.id.json"}, "sentences": [{"arabic": "اِزْدَادُوا عِلْمًا وَخِبْرَةً", "spoken": "audio/c6babd0445646b46c7bd.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Povećali su svoje znanje i iskustvo.", "en": "They grew in knowledge and experience.", "bn": "তারা জ্ঞান ও অভিজ্ঞতায় সমৃদ্ধ হল।", "fa": "آنان در دانش و تجربه پیشرفت کردند.", "fr": "Ils ont grandi en savoir et en expérience.", "id": "Mereka bertambah dalam ilmu dan pengalaman.", "tr": "Bilgide ve tecrübede arttılar.", "ur": "وہ علم اور تجربے میں بڑھ گئے۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِزْدَادُوا", "target": true, "translation": {"bs": "povećali su", "en": "they increased", "bn": "তারা বৃদ্ধি পেল", "fa": "افزایش یافتند", "fr": "ils ont augmenté", "id": "mereka bertambah", "tr": "arttılar", "ur": "وہ بڑھ گئے"}}, {"arabic": "عِلْمًا", "target": false, "translation": {"bs": "znanje", "en": "knowledge", "bn": "জ্ঞান", "fa": "دانش", "fr": "savoir", "id": "ilmu", "tr": "bilgi", "ur": "علم"}}, {"arabic": "وَخِبْرَةً", "target": false, "translation": {"bs": "i iskustvo", "en": "and experience", "bn": "এবং অভিজ্ঞতা", "fa": "و تجربه", "fr": "et expérience", "id": "dan pengalaman", "tr": "ve tecrübe", "ur": "اور تجربہ"}}]}, {"arabic": "نَزْدَادُ قُوَّةً كُلَّ يَوْمٍ", "spoken": "audio/fa4c3c09916838c67ddd.m4a", "tense": "present", "pronoun": "nahnu", "translation": {"bs": "Svakim danom smo sve jači.", "en": "We grow stronger every day.", "bn": "আমরা প্রতিদিন আরও শক্তিশালী হচ্ছি।", "fa": "ما هر روز نیرومندتر می‌شویم.", "fr": "Nous devenons plus forts chaque jour.", "id": "Kami bertambah kuat setiap hari.", "tr": "Her gün daha da güçleniyoruz.", "ur": "ہم روز بروز طاقتور ہوتے جاتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "نَزْدَادُ", "target": true, "translation": {"bs": "postajemo", "en": "we increase", "bn": "আমরা বৃদ্ধি পাই", "fa": "افزایش می‌یابیم", "fr": "nous augmentons", "id": "kami bertambah", "tr": "artarız", "ur": "ہم بڑھتے ہیں"}}, {"arabic": "قُوَّةً", "target": false, "translation": {"bs": "snagom", "en": "strength", "bn": "শক্তিতে", "fa": "نیرو", "fr": "en force", "id": "kekuatan", "tr": "güç", "ur": "طاقت"}}, {"arabic": "كُلَّ", "target": false, "translation": {"bs": "svaki", "en": "every", "bn": "প্রতিটি", "fa": "هر", "fr": "chaque", "id": "setiap", "tr": "her", "ur": "ہر"}}, {"arabic": "يَوْمٍ", "target": false, "translation": {"bs": "dan", "en": "day", "bn": "দিন", "fa": "روز", "fr": "jour", "id": "hari", "tr": "gün", "ur": "دن"}}]}, {"arabic": "تَزْدَادُ الْحَرَارَةُ صَيْفًا", "spoken": "audio/cb758cbbfe5d5da01b8f.m4a", "tense": "present", "pronoun": "hiya", "translation": {"bs": "Ljeti se vrućina povećava.", "en": "The heat increases in summer.", "bn": "গ্রীষ্মে গরম বেড়ে যায়।", "fa": "گرما در تابستان افزایش می‌یابد.", "fr": "La chaleur augmente en été.", "id": "Panas bertambah di musim panas.", "tr": "Yazın sıcaklık artar.", "ur": "گرمیوں میں گرمی بڑھ جاتی ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "تَزْدَادُ", "target": true, "translation": {"bs": "povećava se", "en": "increases", "bn": "বৃদ্ধি পায়", "fa": "افزایش می‌یابد", "fr": "augmente", "id": "bertambah", "tr": "artar", "ur": "بڑھتی ہے"}}, {"arabic": "الْحَرَارَةُ", "target": false, "translation": {"bs": "vrućina", "en": "the heat", "bn": "গরম", "fa": "گرما", "fr": "la chaleur", "id": "panas", "tr": "sıcaklık", "ur": "گرمی"}}, {"arabic": "صَيْفًا", "target": false, "translation": {"bs": "ljeti", "en": "in summer", "bn": "গ্রীষ্মে", "fa": "در تابستان", "fr": "en été", "id": "di musim panas", "tr": "yazın", "ur": "گرمیوں میں"}}]}]}