{"ayat":[{"ref":"81:1","number":5801,"text":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","hits":[0,1]},{"ref":"81:2","number":5802,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","hits":[1]},{"ref":"81:3","number":5803,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","hits":[1,2]},{"ref":"81:4","number":5804,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","hits":[]},{"ref":"81:5","number":5805,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","hits":[2]},{"ref":"81:6","number":5806,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","hits":[1]},{"ref":"81:7","number":5807,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","hits":[1,2]},{"ref":"81:8","number":5808,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","hits":[2]},{"ref":"81:9","number":5809,"text":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","hits":[1,2]},{"ref":"81:10","number":5810,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","hits":[]},{"ref":"81:11","number":5811,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","hits":[1]},{"ref":"81:12","number":5812,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","hits":[]},{"ref":"81:13","number":5813,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","hits":[1,2]},{"ref":"81:14","number":5814,"text":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","hits":[0,2]},{"ref":"81:15","number":5815,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","hits":[0,1]},{"ref":"81:16","number":5816,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","hits":[]},{"ref":"81:17","number":5817,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","hits":[0]},{"ref":"81:18","number":5818,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","hits":[0]},{"ref":"81:19","number":5819,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","hits":[0,1,2,3]},{"ref":"81:20","number":5820,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","hits":[1,4]},{"ref":"81:21","number":5821,"text":"مُّطَاعٍ ثَمَّ أَمِينٍ","hits":[2]},{"ref":"81:22","number":5822,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","hits":[1,2]},{"ref":"81:23","number":5823,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","hits":[0,1,2,3]},{"ref":"81:24","number":5824,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","hits":[1,2,3]},{"ref":"81:25","number":5825,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍ رَّجِيمٍ","hits":[]},{"ref":"81:26","number":5826,"text":"فَأَيْنَ تَذْهَبُونَ","hits":[0,1]},{"ref":"81:27","number":5827,"text":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ","hits":[0,2,3,4]},{"ref":"81:28","number":5828,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","hits":[0,1,2,3,4]},{"ref":"81:29","number":5829,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","hits":[6]}]}