at/0437.ur.json", "id": "ayat/0437.id.json"}, "sentences": [{"arabic": "لَا يَنْتَقِمُ الْحَلِيمُ", "spoken": "audio/d7a0a150a960ff4f7d4e.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Strpljiv čovjek se ne sveti.", "en": "The patient man does not take revenge.", "bn": "ধৈর্যশীল লোক প্রতিশোধ নেয় না।", "fa": "مرد بردبار انتقام نمی‌گیرد.", "fr": "L'homme patient ne se venge pas.", "id": "Orang yang penyabar tidak membalas dendam.", "tr": "Yumuşak huylu adam intikam almaz.", "ur": "بردبار آدمی بدلہ نہیں لیتا۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "يَنْتَقِمُ", "target": true, "translation": {"bs": "sveti se", "en": "takes revenge", "bn": "প্রতিশোধ নেয়", "fa": "انتقام می‌گیرد", "fr": "se venge", "id": "membalas dendam", "tr": "intikam alır", "ur": "بدلہ لیتا ہے"}}, {"arabic": "الْحَلِيمُ", "target": false, "translation": {"bs": "strpljiv čovjek", "en": "the patient man", "bn": "ধৈর্যশীল লোক", "fa": "مرد بردبار", "fr": "l'homme patient", "id": "orang yang penyabar", "tr": "yumuşak huylu adam", "ur": "بردبار آدمی"}}]}, {"arabic": "اِنْتَقَمْنَا مِنَ الْفَرِيقِ فِي الْمُبَارَاةِ", "spoken": "audio/aa9c22ddfa4121f858e5.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Osvetili smo se ekipi na utakmici.", "en": "We took revenge on the team in the match.", "bn": "আমরা ম্যাচে দলটির উপর প্রতিশোধ নিলাম।", "fa": "ما در مسابقه از تیم انتقام گرفتیم.", "fr": "Nous nous sommes vengés de l'équipe pendant le match.", "id": "Kami membalas dendam terhadap tim itu dalam pertandingan.", "tr": "Maçta takımdan intikamımızı aldık.", "ur": "ہم نے میچ میں ٹیم سے بدلہ لیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِنْتَقَمْنَا", "target": true, "translation": {"bs": "osvetili smo se", "en": "we took revenge", "bn": "আমরা প্রতিশোধ নিলাম", "fa": "ما انتقام گرفتیم", "f