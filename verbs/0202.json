": "ayat/0202.tr.json", "ur": "ayat/0202.ur.json", "id": "ayat/0202.id.json"}, "sentences": [{"arabic": "أَفَكَ الْبَائِعُ فِي السِّعْرِ", "spoken": "audio/04764878cc2f8298afb2.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Prodavač je slagao o cijeni.", "en": "The vendor lied about the price.", "bn": "বিক্রেতা দাম নিয়ে মিথ্যা বলল।", "fa": "فروشنده درباره قیمت دروغ گفت.", "fr": "Le vendeur a menti sur le prix.", "id": "Penjual itu berbohong soal harga.", "tr": "Satıcı fiyat konusunda yalan söyledi.", "ur": "دکاندار نے قیمت کے بارے میں جھوٹ بولا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَفَكَ", "target": true, "translation": {"bs": "slagao je", "en": "lied", "bn": "মিথ্যা বলল", "fa": "دروغ گفت", "fr": "a menti", "id": "berbohong", "tr": "yalan söyledi", "ur": "اس نے جھوٹ بولا"}}, {"arabic": "الْبَائِعُ", "target": false, "translation": {"bs": "prodavač", "en": "the vendor", "bn": "বিক্রেতা", "fa": "فروشنده", "fr": "le vendeur", "id": "penjual", "tr": "satıcı", "ur": "دکاندار"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "o", "en": "about", "bn": "সম্পর্কে", "fa": "بر سر", "fr": "à propos de", "id": "tentang", "tr": "hakkında", "ur": "میں"}}, {"arabic": "السِّعْرِ", "target": false, "translation": {"bs": "cijeni", "en": "the price", "bn": "দাম", "fa": "قیمت", "fr": "le prix", "id": "harga", "tr": "fiyat", "ur": "قیمت"}}]}, {"arabic": "لَا يَأْفِكُ الصَّادِقُ", "spoken": "audio/6aa2dee3237eeb75a577.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Iskren čovjek ne laže.", "en": "The truthful man does not lie.", "bn": "সত্যবাদী লোক মিথ্যা বলে না।", "fa": "مرد راستگو دروغ نمی‌گوید.", "fr": "L'homme sincère ne ment pas.", "id": "Orang yang jujur tidak berbohong.", "tr": "Doğru sözlü adam yalan söylemez.", "ur": "سچا آدمی جھوٹ نہیں بولتا۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "يَأْفِكُ", "target": true, "translation": {"bs": "laže", "en": "lies", "bn": "মিথ্যা বলে", "fa": "دروغ می‌گوید", "fr": "ment", "id": "berbohong", "tr": "yalan söyler", "ur": "وہ جھوٹ بولتا ہے"}}, {"arabic": "الصَّادِقُ", "target": false, "translation": {"bs": "iskren čovjek", "en": "the truthful man", "bn": "সত্যবাদী লোক", "fa": "مرد راستگو", "fr": "l'homme sincère", "id": "orang yang jujur", "tr": "doğru sözlü adam", "ur": "سچا آدمی"}}]}, {"arabic": "لَا آفِكُ أَبَدًا", "spoken": "audio/5bbe9d771950b00548c6.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Nikad ne lažem.", "en": "I never lie.", "bn": "আমি কখনও মিথ্যা বলি না।", "fa": "هرگز دروغ نمی‌گویم.", "fr": "Je ne mens jamais.", "id": "Aku tidak pernah berbohong.", "tr": "Asla yalan söylemem.", "ur": "میں کبھی جھوٹ نہیں بولتا۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "آفِكُ", "target": true, "translation": {"bs": "lažem", "en": "I lie", "bn": "আমি মিথ্যা বলি", "fa": "دروغ می‌گویم", "fr": "je mens", "id": "aku berbohong", "tr": "yalan söylerim", "ur": "میں جھوٹ بولتا ہوں"}}, {"arabic": "أَبَدًا", "target": false, "translation": {"bs": "nikad", "en": "never", "bn": "কখনোই না", "fa": "هرگز", "fr": "jamais", "id": "tidak pernah", "tr": "asla", "ur": "کبھی نہیں"}}]}, {"arabic": "أَفَكُوا فِي شَهَادَتِهِمْ", "spoken": "audio/c0d9a55aad2219a9a1b4.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Slagali su u svom svjedočenju.", "en": "They lied in their testimony.", "bn": "তারা তাদের সাক্ষ্যে মিথ্যা বলল।", "fa": "در شهادتشان دروغ گفتند.", "fr": "Ils ont menti dans leur témoignage.", "id": "Mereka berdusta dalam kesaksian mereka.", "tr": "Şahitliklerinde yalan söylediler.", "ur": "انہوں نے اپنی گواہی میں جھوٹ بولا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَفَكُوا", "target": true, "translation": {"bs": "slagali su", "en": "they lied", "bn": "তারা মিথ্যা বলল", "fa": "دروغ گفتند", "fr": "ont menti", "id": "mereka berdusta", "tr": "yalan söylediler", "ur": "انہوں نے جھوٹ بولا"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "u", "en": "in", "bn": "মধ্যে", "fa": "در", "fr": "dans", "id": "di", "tr": "içinde", "ur": "میں"}}, {"arabic": "شَهَادَتِهِمْ", "target": false, "translation": {"bs": "svom svjedočenju", "en": "their testimony", "bn": "তাদের সাক্ষ্য", "fa": "شهادتشان", "fr": "dans leur témoignage", "id": "kesaksian mereka", "tr": "şahitliklerinde", "ur": "ان کی گواہی"}}]}]}