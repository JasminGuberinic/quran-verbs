Used": false, "spoken": "audio/a8d7d7508306e5a48532.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ذَرُوا۟", "plain": "ذَرُوا", "quran": true, "notUsed": false, "spoken": "audio/2506af745ddd3663419e.m4a", "recited": "audio/dd95ec049a0011336612.m4a", "recitedText": "وَذَرُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "ذَرْنَ", "plain": "ذَرْنَ", "quran": false, "notUsed": false, "spoken": "audio/6975f0d918d6da606447.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "74:11", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5506.mp3", "translation": {"en": {"text": "Leave Me (to deal) with him whom I created lonely,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Tek olarak yarattığım o kimseyi bana bırak.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اسے مجھ پر چھوڑ جسے میں نے اکیلا پیدا کیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Biarkanlah Aku bertindak terhadap orang yang Aku telah menciptakannya sendirian.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ذَرْنِى", "hit": true, "audio": "audio/02073ad2af0be77f26c2.m4a", "gloss": {"bs": "ostavi Mene!", "en": "leave Me!", "tr": "beni bırak!", "fr": "laisse-Moi !", "id": "biarkanlah Aku!", "ur": "مجھے چھوڑ دو!", "bn": "আমাকে ছেড়ে দাও!", "fa": "مرا واگذار!"}}, {"text": "وَمَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقْتُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَحِيدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "6:120", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/909.mp3", "translation": {"en": {"text": "Forsake the outwardness of sin and the inwardness thereof. Lo! those who garner sin will be awarded that which they have earned.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Günahın açığını da, gizlisini de bırakın! Günah kazananlar, yaptıklarının cezasını çekecekler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور چھوڑ دو کھلا اور چھپا گناہ، وہ جو گناہ کماتے ہیں عنقریب اپنی کمائی کی سزا پائیں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan tinggalkanlah dosa yang nampak dan yang tersembunyi. Sesungguhnya orang yang mengerjakan dosa, kelak akan diberi pembalasan (pada hari kiamat), disebabkan apa yang mereka telah kerjakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَذَرُوا۟", "hit": true, "audio": "audio/50f84eec1b23385f254e.m4a", "gloss": {"en": "and (you all) leave!", "bs": "i ostavite!", "tr": "ve bırakın!", "fr": "et laissez !", "id": "dan tinggalkanlah kalian!", "ur": "اور تم سب چھوڑو!", "bn": "এবং তোমরা ছেড়ে দাও!", "fa": "و رها کنید!"}}, {"text": "ظَٰهِرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْإِثْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَبَاطِنَهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَكْسِبُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْإِثْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَيُجْزَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَقْتَرِفُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:125", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3913.mp3", "translation": {"en": {"text": "Will ye cry unto Baal and forsake the Best of creators,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hani o kavmine: \"Siz Allah'tan korkmaz mısınız? Yaratanların en güzeli olan, sizin de Rabbiniz, daha önceki atalarınızın da Rabbi bulunan Allah'ı bırakıp da \"Ba'l'e\" (Ba'l ismindeki puta) mi yalvarıyorsunuz?\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا بعل کو پوجتے ہو اور چھوڑتے ہو سب سے اچھا پیدا کرنے والے اللہ کو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Patutkah kamu menyembah Ba'l dan kamu tinggalkan sebaik-baik Pencipta,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَتَدْعُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْلًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَذَرُونَ", "hit": true, "audio": "audio/bc9767dd1e87ec0a06d5.m4a", "gloss": {"en": "and you (all) leave", "bs": "i ostavljate", "tr": "ve bırakırsınız", "fr": "et vous laissez", "id": "dan kalian meninggalkan", "ur": "اور تم سب چھوڑتے ہو", "bn": "এবং তোমরা ছেড়ে দাও", "fa": "و رها می‌کنید"}}, {"text": "أَحْسَنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَٰلِقِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:106", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2454.mp3", "translation": {"en": {"text": "And leave it as an empty plain,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Böylece yerlerini dümdüz boş bir halde bırakacak.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو زمین کو پٹ پر (چٹیل میدان) ہموار کر چھوڑے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "maka Dia akan menjadikan (bekas) gunung-gunung itu datar sama sekali,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَيَذَرُهَا", "hit": true, "audio": "audio/71cc6eff334d0bb0f485.m4a", "gloss": {"bs": "i ostavit će je", "en": "and He will leave it", "tr": "ve onu bırakacak", "fr": "et Il la laissera", "id": "dan Dia akan membiarkannya", "ur": "اور وہ اسے چھوڑ دے گا", "bn": "এবং তিনি তা ছেড়ে দেবেন", "fa": "و آن را وامی‌گذارد"}}, {"text": "قَاعًا", "hit": false, "audio": null, "gloss": null}, {"text": "صَفْصَفًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:72", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2322.mp3", "translation": {"en": {"text": "Then We shall rescue those who kept from evil, and leave the evil-doers crouching there.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra Allah'dan korkup, sakınanları kurtaracağız ve zalimleri de toptan cehennemde bırakacağız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر ہم ڈر والوں کو بچالیں گے اور ظالموں کو اس میں چھوڑ دیں گے گھٹنوں کے بل گرے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian Kami akan menyelamatkan orang-orang yang bertakwa dan membiarkan orang-orang yang zalim di dalam neraka dalam keadaan berlutut.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "نُنَجِّى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱتَّقَوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَّنَذَرُ", "hit": true, "audio": "audio/5b5baf9dfa993704d1a4.m4a", "gloss": {"en": "and we leave", "bs": "i ostavljamo", "tr": "ve bırakırız", "fr": "et nous laissons", "id": "dan kami meninggalkan", "ur": "اور ہم چھوڑتے ہیں", "bn": "এবং আমরা ছেড়ে দিই", "fa": "و رها می‌کنیم"}}, {"text": "ٱلظَّٰلِمِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "جِثِيًّا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "76:27", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5618.mp3", "translation": {"en": {"text": "Lo! these love fleeting life, and put behind them (the remembrance of) a grievous day.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Çünkü onlar bu dünyayı seviyorlar ve önlerindeki ağır bir günü arkaya atıyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک یہ لوگ پاؤں تلے کی (دنیاوی فائدے کو) عزیز رکھتے ہیں اور اپنے پیچھے ایک بھاری دن کو چھوڑ بیٹھے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya mereka (orang kafir) menyukai kehidupan dunia dan mereka tidak memperdulikan kesudahan mereka, pada hari yang berat (hari akhirat).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰٓؤُلَآءِ", "hit": false, "audio": null, "gloss": null}, {"text": "يُحِبُّونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَاجِلَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَذَرُونَ", "hit": true, "audio": "audio/acb1ba76b04367672621.m4a", "gloss": {"en": "and they leave", "bs": "i ostavljaju", "tr": "ve bırakırlar", "fr": "et ils laissent", "id": "dan mereka meninggalkan", "ur": "اور وہ چھوڑتے ہیں", "bn": "এবং তারা ছেড়ে দেয়", "fa": "و رها می‌کنند"}}, {"text": "وَرَآءَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "ثَقِيلًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "فَذَرْهُمْ", "count": 6, "first": "6:112", "audio": "audio/da6716d78a542de06ab4.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": ["hum"]}], "gloss": {"en": "so leave them!", "bs": "pa ih ostavi!", "tr": "böylece o