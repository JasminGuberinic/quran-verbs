wed", "bn": "তারা অনুসরণ করল", "fa": "دنبال کردند", "fr": "ont suivi", "id": "mereka mengikuti", "tr": "izlediler", "ur": "وہ پیچھے چلے"}}, {"arabic": "الدَّلِيلَ", "target": false, "translation": {"bs": "vodiča", "en": "the guide", "bn": "গাইড", "fa": "راهنما", "fr": "le guide", "id": "pemandu", "tr": "rehber", "ur": "گائیڈ"}}]}]}