, "id": "Allah", "tr": "Allah", "ur": "اللہ"}}, {"arabic": "الْأَرْضَ", "target": false, "translation": {"bs": "zemlju", "en": "the earth", "bn": "পৃথিবী", "fa": "زمین", "fr": "la terre", "id": "bumi", "tr": "yeryüzü", "ur": "زمین"}}, {"arabic": "بِالْمَطَرِ", "target": false, "translation": {"bs": "kišom", "en": "with rain", "bn": "বৃষ্টি দিয়ে", "fa": "با باران", "fr": "par la pluie", "id": "dengan hujan", "tr": "yağmurla", "ur": "بارش سے"}}]}, {"arabic": "أَحْيَيْنَا اللَّيْلَ بِالصَّلَاةِ", "spoken": "audio/79202d97f5187b6f2f6f.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Proveli smo noć u namazu.", "en": "We spent the night in prayer.", "bn": "আমরা সালাতে রাত কাটালাম।", "fa": "شب را به نماز گذراندیم.", "fr": "Nous avons passé la nuit en prière.", "id": "Kami menghidupkan malam dengan salat.", "tr": "Geceyi namazla geçirdik.", "ur": "ہم نے رات نماز میں گزاری۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَحْيَيْنَا", "target": true, "translation": {"bs": "proveli smo", "en": "we enlivened", "bn": "আমরা জীবিত করলাম", "fa": "زنده کردیم", "fr": "nous avons fait revivre", "id": "kami menghidupkan", "tr": "diriltiyoruz", "ur": "ہم نے زندہ کیا"}}, {"arabic": "اللَّيْلَ", "target": false, "translation": {"bs": "noć", "en": "the night", "bn": "রাত", "fa": "شب", "fr": "la nuit", "id": "malam", "tr": "gece", "ur": "رات"}}, {"arabic": "بِالصَّلَاةِ", "target": false, "translation": {"bs": "u namazu", "en": "with prayer", "bn": "সালাতের মাধ্যমে", "fa": "با نماز", "fr": "dans la prière", "id": "dengan salat", "tr": "namazla", "ur": "نماز سے"}}]}]}