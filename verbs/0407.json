text": "مَّنْ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلْفَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَذَّكَّرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ثَقِفْتُمُوهُمْ", "count": 2, "first": "2:191", "audio": "audio/e0e255c94bdc5c5f0436.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": ["hum"]}], "gloss": {"en": "you (all) came upon them", "bs": "zatekli ste ih", "tr": "onlara rastladınız", "fr": "vous les avez surpris", "id": "kalian telah menemui mereka", "ur": "تم سب ان پر آ پہنچے", "bn": "তোমরা তাদের কাছে গিয়ে পড়েছ", "fa": "آنان را یافتید"}}, {"arabic": "ثُقِفُوٓا۟", "count": 2, "first": "3:112", "audio": "audio/d64d88e2bb959b077be3.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": true, "objects": []}], "gloss": {"en": "they were found", "bs": "zatečeni su", "tr": "bulundular", "fr": "ils ont été trouvés", "id": "mereka telah ditemukan", "ur": "وہ پائے گئے", "bn": "তারা খুঁজে পাওয়া গেছে", "fa": "یافته شدند"}}, {"arabic": "تَثْقَفَنَّهُمْ", "count": 1, "first": "8:57", "audio": "audio/80393fa8eceebf9dafba.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"bs": "zatekneš ih", "en": "you come upon them", "tr": "onları yakalarsan", "fr": "tu les surprends", "id": "kamu menjumpai mereka", "ur": "تم انہیں پا لو", "bn": "তুমি তাদের পেয়ে যাও", "fa": "آنان را بیابی"}}, {"arabic": "يَثْقَفُوكُمْ", "count": 1, "first": "60:2", "audio": "audio/fe09352bb68f1fe98838.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["antum"], "mood": "jussive"}], "gloss": {"en": "they overpower you (all)", "bs": "svladaju vas", "tr": "sizi alt ederler", "fr": "qu'ils vous dominent", "id": "mereka mengalahkan kalian", "ur": "وہ تم سب پر غالب آتے ہیں", "bn": "তারা তোমাদের পরাভূত করে", "f