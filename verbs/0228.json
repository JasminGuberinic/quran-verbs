"hit": false, "audio": null, "gloss": null}, {"text": "بَعْدِ", "hit": false, "audio": null, "gloss": null}, {"text": "غَلَبِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "سَيَغْلِبُونَ", "hit": true, "audio": "audio/914b9a03958616732ffc.m4a", "gloss": {"bs": "pobijedit će", "en": "they will overcome", "tr": "galip gelecekler", "fr": "ils vaincront", "id": "mereka akan mengalahkan", "ur": "وہ غالب آ جائیں گے", "bn": "তারা অচিরেই জয়ী হবে", "fa": "چیره خواهند شد"}}]}, {"ref": "23:106", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2779.mp3", "translation": {"en": {"text": "They will say: Our Lord! Our evil fortune conquered us, and we were erring folk.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Derler ki: Rabbimiz! Azgınlığımız bizi altetti; biz, bir sapıklar topluluğu idik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہیں گے اے ہمارے رب ہم پر ہماری بدبختی غالب آئی اور ہم گمراہ لوگ تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka berkata: \"Ya Tuhan kami, kami telah dikuasai oleh kejahatan kami, dan adalah kami orang-orang yang sesat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّنَا", "hit": false, "audio": null, "gloss": null}, {"text": "غَلَبَتْ", "hit": true, "audio": "audio/84912b2de372bb761d81.m4a", "gloss": {"bs": "nadvladala je", "en": "overcame", "tr": "galip geldi", "fr": "a vaincu", "id": "mengalahkan", "ur": "غالب آ گئے", "bn": "জয়ী হলো", "fa": "چیره شد"}}, {"text": "عَلَيْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "شِقْوَتُنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَكُنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "ضَآلِّينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "41:26", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4244.mp3", "translation": {"en": {"text": "Those who disbelieve say: Heed not this Qur'an, and drown the hearing of it; haply ye may conquer.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İnkâr edenler: \"Bu Kur'ânı dinlemeyin, okunurken gürültü yapın, belki üstün gelirsiniz\" dediler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور کافر بولے یہ قرآن نہ سنو اور اس میں بیہودہ غل کرو شاید یونہی تم غالب آؤ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang kafir berkata: \"Janganlah kamu mendengar dengan sungguh-sungguh akan Al Quran ini dan buatlah hiruk-pikuk terhadapnya, supaya kamu dapat mengalahkan mereka\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْمَعُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لِهَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقُرْءَانِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْغَوْا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَغْلِبُونَ", "hit": true, "audio": "audio/2706d6a1a577a96e72d4.m4a", "gloss": {"en": "you (all) overcome", "bs": "pobjeđujete", "tr": "galip gelirsiniz", "fr": "vous vainquez", "id": "kalian mengalahkan", "ur": "تم سب غالب آتے ہو", "bn": "তোমরা জয়ী হও", "fa": "پیروز می‌شوید"}}]}, {"ref": "58:21", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5125.mp3", "translation": {"en": {"text": "Allah hath decreed: Lo! I verily shall conquer, I and My messengers. Lo! Allah is Strong, Almighty.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah: \"Elbette ben ve elçilerim galip geleceğiz.\" diye yazmıştır. Şüphesiz Allah güçlüdür, galipdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ لکھ چکا کہ ضرور میں غالب آؤں گا اور میرے رسول بیشک اللہ قوت والا عزت والا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah telah menetapkan: \"Aku dan rasul-rasul-Ku pasti menang\". Sesungguhnya Allah Maha Kuat lagi Maha Perkasa.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَتَبَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَأَغْلِبَنَّ", "hit": true, "audio": "audio/35d9266a80df2e3f8b90.m4a", "gloss": {"en": "surely I will overcome", "bs": "zaista ću pobijediti", "tr": "kesinlikle galip geleceğim", "fr": "je vaincrai assurément", "id": "sungguh aku akan mengalahkan", "ur": "یقیناً میں غالب آؤں گا", "bn": "নিশ্চয়ই আমি জয়ী হব", "fa": "قطعاً پیروز خواهم شد"}}, {"text": "أَنَا۠", "hit": false, "audio": null, "gloss": null}, {"text": "وَرُسُلِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "قَوِىٌّ", "hit": false, "audio": null, "gloss": null}, {"text": "عَزِيزٌ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "غَلَبَتْ", "count": 2, "first": "2:249", "audio": "audio/84912b2de372bb761d81.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"bs": "nadvladala je", "en": "overcame", "tr": "galip geldi", "fr": "a vaincu", "id": "mengalahkan",