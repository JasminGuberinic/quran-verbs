{"rank": 243, "root": "سمع", "form": 4, "lemma": "أَسْمَعَ", "count": 13, "ayahCount": 10, "share": 0.07, "meaning": {"bs": "dati da čuje", "en": "to make hear", "tr": "işittirmek", "fr": "faire entendre", "id": "memperdengarkan", "ur": "سنانا", "bn": "শোনানো", "fa": "شنوانیدن"}, "lemmaSpoken": "audio/8f20e535041e16cf207e.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَسْمَعَ", "plain": "أَسْمَعَ", "quran": false, "notUsed": false, "spoken": "audio/8f20e535041e16cf207e.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يُسْمِعُ", "plain": "يُسْمِعُ", "quran": true, "notUsed": false, "spoken": "audio/665e0480362ad0ce9757.m4a", "recited": "audio/f15cbf269b308495f0ef.m4a", "recitedText": "يُسْمِعُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَسْمِعْ", "plain": "أَسْمِعْ", "quran": true, "notUsed": false, "spoken": "audio/0348f61e03a54659e787.m4a", "recited": "audio/e8af2ba0d6dd14487071.m4a", "recitedText": "أَسْمِعْ"}], "nouns": {"participle": {"lemma": "مُسْمِع", "count": 1, "spoken": "audio/08b8fad685758e67edcf.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَسْمَعْتُ", "plain": "أَسْمَعْتُ", "quran": false, "notUsed": false, "spoken": "audio/8bb06702de8c45b94892.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَسْمَعْنَا", "plain": "أَسْمَعْنَا", "quran": false, "notUsed": false, "spoken": "audio/86385553bd823997c5c2.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "أَسْمَعْتَ", "plain": "أَسْمَعْتَ", "quran": false, "notUsed": false, "spoken": "audio/718625963c227e9d4855.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "أَسْمَعْتِ", "plain": "أَسْمَعْتِ", "quran": false, "notUsed": false, "spoken": "audio/20d9653af702caf83ae7.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "أَسْمَعْتُمَا", "pla