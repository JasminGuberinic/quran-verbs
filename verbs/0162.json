tr": "ayat/0162.tr.json", "ur": "ayat/0162.ur.json", "id": "ayat/0162.id.json"}, "sentences": [{"arabic": "جَدِّي يَمْشِي كُلَّ صَبَاحٍ", "spoken": "audio/c0761a744b2ccf2bee45.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Moj djed šeta svako jutro.", "en": "My grandfather walks every morning.", "bn": "আমার দাদা প্রতি সকালে হাঁটেন।", "fa": "پدربزرگم هر صبح راه می‌رود.", "fr": "Mon grand-père marche chaque matin.", "id": "Kakekku berjalan setiap pagi.", "tr": "Dedem her sabah yürür.", "ur": "میرے دادا ہر صبح چہل قدمی کرتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "جَدِّي", "target": false, "translation": {"bs": "moj djed", "en": "my grandfather", "bn": "আমার দাদা", "fa": "پدربزرگم", "fr": "mon grand-père", "id": "kakekku", "tr": "dedem", "ur": "میرے دادا"}}, {"arabic": "يَمْشِي", "target": true, "translation": {"bs": "šeta", "en": "walks", "bn": "হাঁটে", "fa": "راه می‌رود", "fr": "se promène", "id": "berjalan", "tr": "yürür", "ur": "وہ چلتا ہے"}}, {"arabic": "كُلَّ", "target": false, "translation": {"bs": "svako", "en": "every", "bn": "প্রতিটি", "fa": "هر", "fr": "chaque", "id": "setiap", "tr": "her", "ur": "ہر"}}, {"arabic": "صَبَاحٍ", "target": false, "translation": {"bs": "jutro", "en": "morning", "bn": "সকাল", "fa": "صبح", "fr": "le matin", "id": "pagi", "tr": "sabah", "ur": "صبح"}}]}, {"arabic": "مَشَوْا إِلَى الْمَسْجِدِ", "spoken": "audio/aad97b245d85c041f61d.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Pješice su otišli do džamije.", "en": "They walked to the mosque.", "bn": "তারা হেঁটে মসজিদে গেল।", "fa": "پیاده به مسجد رفتند.", "fr": "Ils sont allés à pied à la mosquée.", "id": "Mereka berjalan ke masjid.", "tr": "Mescide yürüdüler.", "ur": "وہ مسجد کی طرف چلے۔"}, "independentlyReviewed": true, "words": [{"arabic": "مَشَوْا", "target": true, "translation": {"bs": "pješice su otišli", "en": "they walked", "bn": "তারা হাঁটল", "fa": "راه رفتند", "fr": "sont partis à pied", "id": "mereka berjalan", "tr": "yürüdüler", "ur": "وہ چلے"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "do", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "الْمَسْجِدِ", "target": false, "translation": {"bs": "džamije", "en": "the mosque", "bn": "মসজিদ", "fa": "مسجد", "fr": "la mosquée", "id": "masjid itu", "tr": "cami", "ur": "مسجد"}}]}, {"arabic": "الْأَطْفَالُ يَمْشُونَ إِلَى الْمَدْرَسَةِ", "spoken": "audio/2702434d91f0dc4a159f.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Djeca idu pješice u školu.", "en": "The children walk to school.", "bn": "শিশুরা হেঁটে স্কুলে যায়।", "fa": "بچه‌ها پیاده به مدرسه می‌روند.", "fr": "Les enfants vont à l'école à pied.", "id": "Anak-anak berjalan ke sekolah.", "tr": "Çocuklar okula yürüyerek gider.", "ur": "بچے اسکول پیدل جاتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "الْأَطْفَالُ", "target": false, "translation": {"bs": "djeca", "en": "the children", "bn": "শিশুরা", "fa": "بچه‌ها", "fr": "les enfants", "id": "anak-anak", "tr": "çocuklar", "ur": "بچے"}}, {"arabic": "يَمْشُونَ", "target": true, "translation": {"bs": "idu pješice", "en": "walk", "bn": "হাঁটো", "fa": "راه می‌روند", "fr": "vont à pied", "id": "berjalanlah", "tr": "yürür", "ur": "وہ چلتے ہیں"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "u", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "الْمَدْرَسَةِ", "target": false, "translation": {"bs": "školu", "en": "the school", "bn": "স্কুল", "fa": "مدرسه", "fr": "l'école", "id": "sekolah itu", "tr": "okul", "ur": "اسکول"}}]}, {"arabic": "الْقِطَّةُ تَمْشِي بِهُدُوءٍ", "spoken": "audio/cb2ec00d9bd04f8e4779.m4a", "tense": "present", "pronoun": "hiya", "translation": {"bs": "Mačka hoda mirno.", "en": "The cat walks calmly.", "bn": "বিড়ালটি শান্তভাবে হাঁটে।", "fa": "گربه آرام راه می‌رود.", "fr": "Le chat marche calmement.", "id": "Kucing itu berjalan dengan te