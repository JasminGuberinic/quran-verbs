"audio/de9dc89ed2704eddaa01.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُبْلُوَا", "plain": "اُبْلُوَا", "quran": false, "notUsed": false, "spoken": "audio/5ecbb1ca011743abe1bd.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُبْلُوا", "plain": "اُبْلُوا", "quran": false, "notUsed": false, "spoken": "audio/f9ded0bff009692fad81.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُبْلُونَ", "plain": "اُبْلُونَ", "quran": false, "notUsed": false, "spoken": "audio/775a0b79abdf79dfd524.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "67:2", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5243.mp3", "translation": {"en": {"text": "Who hath created life and death that He may try you which of you is best in conduct; and He is the Mighty, the Forgiving,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O, hanginizin daha güzel iş yapacağınızı denemek için ölümü ve hayatı yarattı. O, üstündür, bağışlayandır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ جس نے موت اور زندگی پیدا کی کہ تمہاری جانچ ہو تم میں کس کا کام زیادہ اچھا ہے اور وہی عزت والا بخشش والا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Yang menjadikan mati dan hidup, supaya Dia menguji kamu, siapa di antara kamu yang lebih baik amalnya. Dan Dia Maha Perkasa lagi Maha Pengampun,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَوْتَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْحَيَوٰةَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِيَبْلُوَكُمْ", "hit": true, "audio": "audio/7f162f262f0e4db17c52.m4a", "gloss": {"en": "so that he/it may test you (all)", "bs": "da vas iskuša", "tr": "sizi imtihan etsin diye", "fr": "qu'il vous éprouve", "id": "agar dia menguji kalian", "ur": "تاکہ وہ تمہیں آزمائے", "bn": "যাতে সে তোমাদের পরীক্ষা করে", "fa": "تا شما را بیازماید"}}, {"text": "أَيُّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَحْسَنُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَمَلًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَزِيزُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْغَفُورُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "47:31", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4576.mp3", "translation": {"en": {"text": "And verily We shall try you till We know those of you who strive hard (for the cause of Allah) and the steadfast, and till We test your record.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun ki, biz içinizden cihad edenlerle sabredenleri ortaya çıkarıncaya ve yaptıklarınızla ilgili haberlerinizi açıklayıncaya kadar sizi deneyeceğiz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ضرور ہم تمہیں جانچیں گے یہاں تک کہ دیکھ لیں تمہارے جہاد کرنے والوں اور صابروں کو اور تمہاری خبریں آزمالیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya Kami benar-benar akan menguji kamu agar Kami mengetahui orang-orang yang berjihad dan bersabar di antara kamu, dan agar Kami menyatakan (baik buruknya) hal ihwalmu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَنَبْلُوَنَّكُمْ", "hit": true, "audio": "audio/849e95467ff399a8b034.m4a", "gloss": {"bs": "i sigurno ćemo vas iskušati", "en": "and We will surely test you", "tr": "ve sizi mutlaka deneyeceğiz", "fr": "et Nous vous éprouverons certes", "id": "dan sungguh Kami akan menguji kamu", "ur": "اور ہم ضرور تمہیں آزمائیں گے", "bn": "এবং আমরা অবশ্যই তোমাদের পরীক্ষা করব", "fa": "و قطعاً شما را خواهیم آزمود"}}, {"text": "حَتَّىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "نَعْلَمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُجَٰهِدِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلصَّٰبِرِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَبْلُوَا۟", "hit": true, "audio": "audio/6579f7fff72e8bc5e852.m4a", "gloss": {"bs": "i da provjerimo", "en": "and We test", "tr": "ve deneriz", "fr": "et Nous éprouvons", "id": "dan Kami menguji", "ur": "اور ہم آزمائیں", "bn": "এবং আমরা পরীক্ষা করি", "fa": "و می‌آزماییم"}}, {"text": "أَخْبَارَكُمْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "68:17", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5288.mp3", "translation": {"en": {"text": "Lo! We have tried them as We tried the owners of the garden when they vowed that they would pluck its fruit next morning,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz onlara da belâ verdik, bahçe sahiplerine verdiğimiz gibi. Hani onlar sabah olunca bahçeyi mutlaka devşireceklerine yemin etmişlerdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک ہم نے انہیں جانچا جیسا اس باغ والوں کو جانچا تھا جب انہوں نے قسم کھائی کہ ضرور صبح ہوتے اس کھیت کو کاٹ لیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Kami telah mencobai mereka (musyrikin Mekah) sebagaimana Kami telah mencobai pemilik-pemilik kebun, ketika mereka bersumpah bahwa mereka sungguh-sungguh akanmemetik (hasil)nya di pagi hari,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "بَلَوْنَٰهُمْ", "hit": true, "audio": "audio/fc5b355ecb00ae3726df.m4a", "gloss": {"bs": "iskušali smo ih", "en": "We tested them", "tr": "onları denedik", "fr": "Nous les avons éprouvés", "id": "Kami menguji mereka", "ur": "ہم نے انہیں آزمایا", "bn": "আমরা তাদের পরীক্ষা করেছি", "fa": "آنان را آزمودیم"}}, {"text": "كَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "بَلَوْنَآ", "hit": true, "audio": "audio/be25ac41014980d672d2.m4a", "gloss": {"bs": "iskušali smo", "en": "We tested", "tr": "denedik", "fr": "Nous avons éprouvé", "id": "Kami menguji", "ur": "ہم نے آزمایا", "bn": "আমরা পরীক্ষা করেছি", "fa": "ما آزمودیم"}}, {"text": "أَصْحَٰبَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْجَنَّةِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَقْسَمُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَيَصْرِمُنَّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "مُصْبِحِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "لِّيَبْلُوَكُمْ", "count": 2, "first": "5:48", "audio": "audio/7e4d0d4affb32ee1839a.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "subjunctive"}], "gloss": {"en": "so that he/it may test you (all)", "bs": "da vas iskuša", "tr": "sizi imtihan etsin diye", "fr": "qu'il vous éprouve", "id": "agar dia menguji kalian", "ur": "تاکہ وہ تمہیں آزمائے", "bn": "যাতে সে তোমাদের পরীক্ষা করে", "fa": "تا شما را بیازماید"}}, {"arabic": "لِيَبْلُوَكُمْ", "count": 2, "first": "11:7", "audio": "audio/261ed83cb4e91f98c379.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "subjunctive"}], "gloss": {"en": "so that he/it may test you (all)", "bs": "da vas iskuša", "tr": "sizi imtihan etsin diye", "fr": "qu'il vous éprouve", "id": "agar dia menguji kalian", "ur": "تاکہ وہ تمہیں آزمائے", "bn": "যাতে সে তোমাদের পরীক্ষা করে", "fa": "تا شما را بیازماید"}}, {"arabic": "وَلَنَبْلُوَنَّكُم", "count": 1, "first": "2:155", "audio": "audio/8ecfbe85531ad4af8277.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["antum"], "mood": "indicative"}]}, {"arabic": "لَيَبْلُوَنَّكُمُ", "count": 1, "first": "5:94", "audio": "audio/94b8252c56da06c52d5d.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "surely he/it will test you (all)", "bs": "zaista će vas iskušati", "tr": "kesinlikle sizi imtihan edecek", "fr": "il vous éprouvera assurément", "id": "sungguh dia akan menguji kalian", "ur": "یقیناً وہ تمہیں آزمائے گا", "bn": "নিশ্চয়ই সে তোমাদের পরীক্ষা করবে", "fa": "قطعاً شما را خواهد آزمود"}}, {"arabic": "نَبْلُوهُم", "count": 1, "first": "7:163", "audio": "audio/55aa4835f011de1b4f5d.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"en": "we test them", "bs": "iskušavamo ih", "tr": "onları imtihan ederiz", "fr": "nous les éprouvons", "id": "kami menguji mereka", "ur": "ہم انہیں آزماتے ہیں", "bn": "আমরা তাদের পরীক্ষা করি", "fa": "آنان را می‌آزماییم"}}, {"arabic": "وَبَلَوْنَٰهُم", "count": 1, "first": "7:168", "audio": "audio/a1f3c23bee2deafd0106.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["hum"]}], "gloss": {"en": "and we tested them", "bs": "i iskušali smo ih", "tr": "ve onları imtihan ettik", "fr": "et nous les avons éprouvés", "id": "dan kami telah menguji mereka", "ur": "اور ہم نے انہیں آزمایا", "bn": "এবং আমরা তাদের পরীক্ষা করেছি", "fa": "و آنان را آزمودیم"}}, {"arabic": "تَبْلُوا۟", "count": 1, "first": "10:30", "audio": "audio/b7384353129f281fd81a.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}, {"arabic": "يَبْلُوكُمُ", "count": 1, "first": "16:92", "audio": "aud