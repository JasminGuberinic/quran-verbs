{"rank": 45, "root": "لقي", "form": 4, "lemma": "أَلْقَى", "count": 71, "ayahCount": 67, "share": 0.37, "meaning": {"bs": "baciti", "en": "to throw", "tr": "atmak, fırlatmak", "fr": "jeter", "id": "melempar", "ur": "ڈالنا، پھینکنا", "bn": "নিক্ষেপ করা", "fa": "افکندن، انداختن"}, "lemmaSpoken": "audio/88deaa877d4321528230.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَلْقَىٰ", "plain": "أَلْقَى", "quran": true, "notUsed": false, "spoken": "audio/88deaa877d4321528230.m4a", "recited": "audio/195e086f972458054f7d.m4a", "recitedText": "أَلْقَىٰ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُلْقِى", "plain": "يُلْقِي", "quran": true, "notUsed": false, "spoken": "audio/076c66e636b8fbcceca3.m4a", "recited": "audio/ce516edc340147808dcf.m4a", "recitedText": "يُلْقِى"}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَلْقِ", "plain": "أَلْقِ", "quran": true, "notUsed": false, "spoken": "audio/3992c8aae0ba4d6948e0.m4a", "recited": "audio/0782468f6c058d9ccd51.m4a", "recitedText": "أَلْقِ"}], "nouns": {"participle": {"lemma": "مُلْقي", "count": 3, "spoken": "audio/2c6b029cdf9134b90a81.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَلْقَيْتُ", "plain": "أَلْقَيْتُ", "quran": true, "notUsed": false, "spoken": "audio/8e49846573510adcf7af.m4a", "recited": "audio/f0b724e91181392b0f94.m4a", "recitedText": "وَأَلْقَيْتُ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَلْقَيْنَا", "plain": "أَلْقَيْنَا", "quran": true, "notUsed": false, "spoken": "audio/f7b61f529ab1bd3bdc20.m4a", "recited": "audio/28477877155e9ddf1b83.m4a", "recitedText": "وَأَلْقَيْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "أَلْقَيْتَ", "plain": "أَلْقَيْتَ", "quran": false, "notUsed": false, "spoken": "audio/a4c888bc84f4622ca046.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "أَلْقَيْتِ", "plain": "أَلْقَيْتِ", "quran": false, "notUsed": false, "spoken": "audio/a1b8bddb3d96131fcfff.m4a", "recited": nu