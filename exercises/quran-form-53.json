[{"id":"sadda-4-61-12","words":["verb:sadda"],"options":[{"bs":"odvraćaju","en":"they turn away"},{"bs":"i odvraćali su","en":"and turned (others) away"},{"bs":"i odvratili su vas","en":"and they turned you (all) away"},{"bs":"pa ih je odvratio","en":"so he/it turned them away"}],"ref":"4:61","answerWord":"يَصُدُّونَ","answerSound":"audio/5ec6c9618f2772b3dcbc.m4a","quranTranslation":{"text":"And when it is said unto them: Come unto that which Allah hath revealed and unto the messenger, thou seest the hypocrites turn from thee with aversion.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["وَإِذَا","قِيلَ","لَهُمْ","تَعَالَوْا۟","إِلَىٰ","مَآ","أَنزَلَ","ٱللَّهُ","وَإِلَى","ٱلرَّسُولِ","رَأَيْتَ","ٱلْمُنَٰفِقِينَ","يَصُدُّونَ","عَنكَ","صُدُودًا"],"marked":[12],"facts":{"verb":"صَدَّ"}},{"id":"sadda-47-1-2","words":["verb:sadda"],"options":[{"bs":"i odvraćali su","en":"and turned (others) away"},{"bs":"da odvrate","en":"so that they may hinder (others)"},{"bs":"odvraća vas","en":"he/it turns you (all) away"},{"bs":"odvratili ste","en":"you (all) turned away"}],"ref":"47:1","answerWord":"وَصَدُّوا۟","answerSound":"audio/cc689ed1ba7b5ea5e70f.m4a","quranTranslation":{"text":"Those who disbelieve and turn (men) from the way of Allah, He rendereth their actions vain.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["ٱلَّذِينَ","كَفَرُوا۟","وَصَدُّوا۟","عَن","سَبِيلِ","ٱللَّهِ","أَضَلَّ","أَعْمَٰلَهُمْ"],"marked":[2],"facts":{"verb":"صَدَّ"}},{"id":"sadda-9-9-5","words":["verb:sadda"],"options":[{"bs":"pa su odvratili","en":"so they hindered (others)"},{"bs":"i odvratio ju je","en":"and he/it turned her away"},{"bs":"odvraćate nas","en":"you (all) turn us away"},{"bs":"da odvrate","en":"so that they may hinder (others)"}],"ref":"9:9","answerWord":"فَصَدُّوا۟","answerSound":"audio/d2781d9f7e839452d7c4.m4a","quranTranslation":{"text":"They have purchased with the revelations of Allah a little gain, so they debar (men) from His way. Lo! evil is that which they are wont to do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["ٱشْتَرَوْا۟","بِـَٔايَٰتِ","ٱللَّهِ","ثَمَنًا","قَلِيلًا","فَصَدُّوا۟","عَن","سَبِيلِهِۦٓ","إِنَّهُمْ","سَآءَ","مَا","كَانُوا۟","يَعْمَلُونَ"],"marked":[5],"facts":{"verb":"صَدَّ"}},{"id":"sadda-27-24-11","words":["verb:sadda"],"options":[{"bs":"pa ih je odvratio","en":"so he/it turned them away"},{"bs":"odvraća vas","en":"he/it turns you (all) away"},{"bs":"i odvratio ju je","en":"and he/it turned her away"},{"bs":"odvraćate","en":"you (all) hinder (others)"}],"ref":"27:24","answerWord":"فَصَدَّهُمْ","answerSound":"audio/bd5bb200fe2dba1f28d6.m4a","quranTranslation":{"text":"I found her and her people worshipping the sun instead of Allah; and Satan maketh their works fairseeming unto them, and debarreth them from the way (of Truth), so that they go not aright;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["وَجَدتُّهَا","وَقَوْمَهَا","يَسْجُدُونَ","لِلشَّمْسِ","مِن","دُونِ","ٱللَّهِ","وَزَيَّنَ","لَهُمُ","ٱلشَّيْطَٰنُ","أَعْمَٰلَهُمْ","فَصَدَّهُمْ","عَنِ","ٱلسَّبِيلِ","فَهُمْ","لَا","يَهْتَدُونَ"],"marked":[11],"facts":{"verb":"صَدَّ"}},{"id":"sadda-3-99-4","words":["verb:sadda"],"options":[{"bs":"odvraćate","en":"you (all) hinder (others)"},{"bs":"odvratili smo vas","en":"we turned you (all) away"},{"bs":"pa ih je odvratio","en":"so he/it turned them away"},{"bs":"odvratio je","en":"he/it turned away"}],"ref":"3:99","answerWord":"تَصُدُّونَ","answerSound":"audio/ff8f72378088ee314be0.m4a","quranTranslation":{"text":"Say: O People of the Scripture! Why drive ye back believers from the way of Allah, seeking to make it crooked, when ye are witnesses (to Allah's guidance)? Allah is not unaware of what ye do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["قُلْ","يَٰٓأَهْلَ","ٱلْكِتَٰبِ","لِمَ","تَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","مَنْ","ءَامَنَ","تَبْغُونَهَا","عِوَجًا","وَأَنتُمْ","شُهَدَآءُ","وَمَا","ٱللَّهُ","بِغَٰفِلٍ","عَمَّا","تَعْمَلُونَ"],"marked":[4],"facts":{"verb":"صَدَّ"}},{"id":"sadda-4-55-6","words":["verb:sadda"],"options":[{"bs":"odvratio je","en":"he/it turned away"},{"bs":"odvratili ste","en":"you (all) turned away"},{"bs":"pa ih je odvratio","en":"so he/it turned them away"},{"bs":"odvraćate","en":"you (all) hinder (others)"}],"ref":"4:55","answerWord":"صَدَّ","answerSound":"audio/936f9597d1473774bf0f.m4a","quranTranslation":{"text":"And of them were (some) who believed therein and of them were (some) who turned away from it. Hell is sufficient for (their) burning.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["فَمِنْهُم","مَّنْ","ءَامَنَ","بِهِۦ","وَمِنْهُم","مَّن","صَدَّ","عَنْهُ","وَكَفَىٰ","بِجَهَنَّمَ","سَعِيرًا"],"marked":[6],"facts":{"verb":"صَدَّ"}},{"id":"sadda-5-91-11","words":["verb:sadda"],"options":[{"bs":"i odvraća vas","en":"and he/it turns you (all) away"},{"bs":"i odvratili su vas","en":"and they turned you (all) away"},{"bs":"dižu viku","en":"they cry out"},{"bs":"odvratili smo vas","en":"we turned you (all) away"}],"ref":"5:91","answerWord":"وَيَصُدَّكُمْ","answerSound":"audio/572b09a82c33009acef8.m4a","quranTranslation":{"text":"Satan seeketh only to cast among you enmity and hatred by means of strong drink and games of chance, and to turn you from remembrance of Allah and from (His) worship. Will ye then have done?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["إِنَّمَا","يُرِيدُ","ٱلشَّيْطَٰنُ","أَن","يُوقِعَ","بَيْنَكُمُ","ٱلْعَدَٰوَةَ","وَٱلْبَغْضَآءَ","فِى","ٱلْخَمْرِ","وَٱلْمَيْسِرِ","وَيَصُدَّكُمْ","عَن","ذِكْرِ","ٱللَّهِ","وَعَنِ","ٱلصَّلَوٰةِ","فَهَلْ","أَنتُم","مُّنتَهُونَ"],"marked":[11],"facts":{"verb":"صَدَّ"}},{"id":"sadda-7-86-5","words":["verb:sadda"],"options":[{"bs":"i odvraćate","en":"and you (all) hinder (others)"},{"bs":"i odvraća vas","en":"and he/it turns you (all) away"},{"bs":"odvratili su vas","en":"they turned you (all) away"},{"bs":"pa su odvratili","en":"so they hindered (others)"}],"ref":"7:86","answerWord":"وَتَصُدُّونَ","answerSound":"audio/69a9f290edb1ae826594.m4a","quranTranslation":{"text":"Lurk not on every road to threaten (wayfarers), and to turn away from Allah's path him who believeth in Him, and to seek to make it crooked. And remember, when ye were but few, how He did multiply you. And see the nature of the consequence for the corrupters!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["وَلَا","تَقْعُدُوا۟","بِكُلِّ","صِرَٰطٍ","تُوعِدُونَ","وَتَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","مَنْ","ءَامَنَ","بِهِۦ","وَتَبْغُونَهَا","عِوَجًا","وَٱذْكُرُوٓا۟","إِذْ","كُنتُمْ","قَلِيلًا","فَكَثَّرَكُمْ","وَٱنظُرُوا۟","كَيْفَ","كَانَ","عَٰقِبَةُ","ٱلْمُفْسِدِينَ"],"marked":[5],"facts":{"verb":"صَدَّ"}},{"id":"sadda-8-36-5","words":["verb:sadda"],"options":[{"bs":"da odvrate","en":"so that they may hinder (others)"},{"bs":"i odvratili su vas","en":"and they turned you (all) away"},{"bs":"odvratili ste","en":"you (all) turned away"},{"bs":"odvraćate nas","en":"you (all) turn us away"}],"ref":"8:36","answerWord":"لِيَصُدُّوا۟","answerSound":"audio/15f60d786d86dddd690e.m4a","quranTranslation":{"text":"Lo! those who disbelieve spend their wealth in order that they may debar (men) from the way of Allah. They will spend it, then it will become an anguish for them, then they will be conquered. And those who disbelieve will be gathered unto hell,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["إِنَّ","ٱلَّذِينَ","كَفَرُوا۟","يُنفِقُونَ","أَمْوَٰلَهُمْ","لِيَصُدُّوا۟","عَن","سَبِيلِ","ٱللَّهِ","فَسَيُنفِقُونَهَا","ثُمَّ","تَكُونُ","عَلَيْهِمْ","حَسْرَةً","ثُمَّ","يُغْلَبُونَ","وَٱلَّذِينَ","كَفَرُوٓا۟","إِلَىٰ","جَهَنَّمَ","يُحْشَرُونَ"],"marked":[5],"facts":{"verb":"صَدَّ"}},{"id":"sadda-16-94-12","words":["verb:sadda"],"options":[{"bs":"odvratili ste","en":"you (all) turned away"},{"bs":"i odvraćali su","en":"and turned (others) away"},{"bs":"i odvratili su vas","en":"and they turned you (all) away"},{"bs":"odvraćate nas","en":"you (all) turn us away"}],"ref":"16:94","answerWord":"صَدَدتُّمْ","answerSound":"audio/0a9ac3e3e885721590e6.m4a","quranTranslation":{"text":"Make not your oaths a deceit between you, lest a foot should slip after being firmly planted and ye should taste evil forasmuch as ye debarred (men) from the way of Allah, and yours should be an awful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["وَلَا","تَتَّخِذُوٓا۟","أَيْمَٰنَكُمْ","دَخَلًۢا","بَيْنَكُمْ","فَتَزِلَّ","قَدَمٌۢ","بَعْدَ","ثُبُوتِهَا","وَتَذُوقُوا۟","ٱلسُّوٓءَ","بِمَا","صَدَدتُّمْ","عَن","سَبِيلِ","ٱللَّهِ","وَلَكُمْ","عَذَابٌ","عَظِيمٌ"],"marked":[12],"facts":{"verb":"صَدَّ"}},{"id":"sadda-27-43-0","words":["verb:sadda"],"options":[{"bs":"i odvratio ju je","en":"and he/it turned her away"},{"bs":"da odvrate","en":"so that they may hinder (others)"},{"bs":"i odvraća vas","en":"and he/it turns you (all) away"},{"bs":"pa ih je odvratio","en":"so he/it turned them away"}],"ref":"27:43","answerWord":"وَصَدَّهَا","answerSound":"audio/86cedd9dac4651a57baf.m4a","quranTranslation":{"text":"And (all) that she was wont to worship instead of Allah hindered her, for she came of disbelieving folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["وَصَدَّهَا","مَا","كَانَت","تَّعْبُدُ","مِن","دُونِ","ٱللَّهِ","إِنَّهَا","كَانَتْ","مِن","قَوْمٍ","كَٰفِرِينَ"],"marked":[0],"facts":{"verb":"صَدَّ"}},{"id":"sadda-34-32-6","words":["verb:sadda"],"options":[{"bs":"odvratili smo vas","en":"we turned you (all) away"},{"bs":"pa ih je odvratio","en":"so he/it turned them away"},{"bs":"i odvratili su vas","en":"and they turned you (all) away"},{"bs":"odvraćate","en":"you (all) hinder (others)"}],"ref":"34:32","answerWord":"صَدَدْنَٰكُمْ","answerSound":"audio/738e68744edf2eb6ccee.m4a","quranTranslation":{"text":"Those who were proud say unto those who were despised: Did we drive you away from the guidance after it had come unto you? Nay, but ye were guilty.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["قَالَ","ٱلَّذِينَ","ٱسْتَكْبَرُوا۟","لِلَّذِينَ","ٱسْتُضْعِفُوٓا۟","أَنَحْنُ","صَدَدْنَٰكُمْ","عَنِ","ٱلْهُدَىٰ","بَعْدَ","إِذْ","جَآءَكُم","بَلْ","كُنتُم","مُّجْرِمِينَ"],"marked":[6],"facts":{"verb":"صَدَّ"}},{"id":"sadda-43-37-1","words":["verb:sadda"],"options":[{"bs":"sigurno ih odvraćaju","en":"surely they turn them away"},{"bs":"odvraćate nas","en":"you (all) turn us away"},{"bs":"i odvraća vas","en":"and he/it turns you (all) away"},{"bs":"odvratili smo vas","en":"we turned you (all) away"}],"ref":"43:37","answerWord":"لَيَصُدُّونَهُمْ","answerSound":"audio/11da0c54bc468ac66c1b.m4a","quranTranslation":{"text":"And lo! they surely turn them from the way of Allah, and yet they deem that they are rightly guided;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["وَإِنَّهُمْ","لَيَصُدُّونَهُمْ","عَنِ","ٱلسَّبِيلِ","وَيَحْسَبُونَ","أَنَّهُم","مُّهْتَدُونَ"],"marked":[1],"facts":{"verb":"صَدَّ"}},{"id":"sadda-43-57-8","words":["verb:sadda"],"options":[{"bs":"dižu viku","en":"they cry out"},{"bs":"i odvratio ju je","en":"and he/it turned her away"},{"bs":"odvratio je","en":"he/it turned away"},{"bs":"i odvraća vas","en":"and he/it turns you (all) away"}],"ref":"43:57","answerWord":"يَصِدُّونَ","answerSound":"audio/e01a718ede8850e5d93d.m4a","quranTranslation":{"text":"And when the son of Mary is quoted as an example, behold! the folk laugh out,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odvratiti, spriječiti","en":"to turn away, to hinder"},"passage":["وَلَمَّا","ضُرِبَ","ٱبْنُ","مَرْيَمَ","مَثَلًا","إِذَا","قَوْمُكَ","مِنْهُ","يَصِدُّونَ"],"marked":[8],"facts":{"verb":"صَدَّ"}},{"id":"istawa-35-19-1","words":["verb:istawa"],"options":[{"bs":"(nisu) jednaki","en":"(not) equal are"},{"bs":"uzdigao se","en":"he/it rose"},{"bs":"jednaki su","en":"they (two) are equal"},{"bs":"ustalili ste se","en":"you (all) settled"}],"ref":"35:19","answerWord":"يَسْتَوِى","answerSound":"audio/1b840a87dc7762871673.m4a","quranTranslation":{"text":"The blind man is not equal with the seer;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustaliti se, uzdići se","en":"to be level, to settle, to rise"},"passage":["وَمَا","يَسْتَوِى","ٱلْأَعْمَىٰ","وَٱلْبَصِيرُ"],"marked":[1],"facts":{"verb":"اسْتَوَى"}},{"id":"istawa-32-18-7","words":["verb:istawa"],"options":[{"bs":"jednaki su","en":"they are equal"},{"bs":"ustalili ste se","en":"you (all) settled"},{"bs":"jednak je","en":"he/it is equal"},{"bs":"uzdigao se","en":"he/it rose"}],"ref":"32:18","answerWord":"يَسْتَوُۥنَ","answerSound":"audio/d72c7523363b4ed452ed.m4a","quranTranslation":{"text":"Is he who is a believer like unto him who is an evil-liver? They are not alike.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustaliti se, uzdići se","en":"to be level, to settle, to rise"},"passage":["أَفَمَن","كَانَ","مُؤْمِنًا","كَمَن","كَانَ","فَاسِقًا","لَّا","يَسْتَوُۥنَ"],"marked":[7],"facts":{"verb":"اسْتَوَى"}},{"id":"istawa-2-29-9","words":["verb:istawa"],"options":[{"bs":"uzdigao se","en":"he/it rose"},{"bs":"i ustalila se","en":"and she/it settled"},{"bs":"ustalili ste se","en":"you (all) settled"},{"bs":"jednaki su","en":"they are equal"}],"ref":"2:29","answerWord":"ٱسْتَوَىٰٓ","answerSound":"audio/e9848d4e97cb4b4c4fa7.m4a","quranTranslation":{"text":"He it is Who created for you all that is in the earth. Then turned He to the heaven, and fashioned it as seven heavens. And He is knower of all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustaliti se, uzdići se","en":"to be level, to settle, to rise"},"passage":["هُوَ","ٱلَّذِى","خَلَقَ","لَكُم","مَّا","فِى","ٱلْأَرْضِ","جَمِيعًا","ثُمَّ","ٱسْتَوَىٰٓ","إِلَى","ٱلسَّمَآءِ","فَسَوَّىٰهُنَّ","سَبْعَ","سَمَٰوَٰتٍ","وَهُوَ","بِكُلِّ","شَىْءٍ","عَلِيمٌ"],"marked":[9],"facts":{"verb":"اسْتَوَى"}},{"id":"istawa-53-6-2","words":["verb:istawa"],"options":[{"bs":"pa se uspravio","en":"and he rose"},{"bs":"jednaki su","en":"they (two) are equal"},{"bs":"jednak je","en":"he/it is equal"},{"bs":"i ustalila se","en":"and she/it settled"}],"ref":"53:6","answerWord":"فَٱسْتَوَىٰ","answerSound":"audio/9f464365070709b50971.m4a","quranTranslation":{"text":"One vigorous; and he grew clear to view","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustaliti se, uzdići se","en":"to be level, to settle, to rise"},"passage":["ذُو","مِرَّةٍ","فَٱسْتَوَىٰ"],"marked":[2],"facts":{"verb":"اسْتَوَى"}},{"id":"istawa-11-44-10","words":["verb:istawa"],"options":[{"bs":"i ustalila se","en":"and she/it settled"},{"bs":"uzdigao se","en":"he/it rose"},{"bs":"jednak je","en":"he/it is equal"},{"bs":"ustalio si se","en":"you settled"}],"ref":"11:44","answerWord":"وَٱسْتَوَتْ","answerSound":"audio/cc0ec8ef6d4ed6c162b1.m4a","quranTranslation":{"text":"And it was said: O earth! Swallow thy water and, O sky! be cleared of clouds! And the water was made to subside. And the commandment was fulfilled. And it (the ship) came to rest upon (the mount) Al-Judi and it was said: A far removal for wrongdoing folk!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustaliti se, uzdići se","en":"to be level, to settle, to rise"},"passage":["وَقِيلَ","يَٰٓأَرْضُ","ٱبْلَعِى","مَآءَكِ","وَيَٰسَمَآءُ","أَقْلِعِى","وَغِيضَ","ٱلْمَآءُ","وَقُضِىَ","ٱلْأَمْرُ","وَٱسْتَوَتْ","عَلَى","ٱلْجُودِىِّ","وَقِيلَ","بُعْدًا","لِّلْقَوْمِ","ٱلظَّٰلِمِينَ"],"marked":[10],"facts":{"verb":"اسْتَوَى"}},{"id":"istawa-23-28-1","words":["verb:istawa"],"options":[{"bs":"ustalio si se","en":"you settled"},{"bs":"(nisu) jednaki","en":"(not) equal are"},{"bs":"uzdigao se","en":"he/it rose"},{"bs":"i ustalila se","en":"and she/it settled"}],"ref":"23:28","answerWord":"ٱسْتَوَيْتَ","answerSound":"audio/e21f86d14eb6f410ab00.m4a","quranTranslation":{"text":"And when thou art on board the ship, thou and whoso is with thee, then say: Praise be to Allah Who hath saved us from the wrongdoing folk!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustaliti se, uzdići se","en":"to be level, to settle, to rise"},"passage":["فَإِذَا","ٱسْتَوَيْتَ","أَنتَ","وَمَن","مَّعَكَ","عَلَى","ٱلْفُلْكِ","فَقُلِ","ٱلْحَمْدُ","لِلَّهِ","ٱلَّذِى","نَجَّىٰنَا","مِنَ","ٱلْقَوْمِ","ٱلظَّٰلِمِينَ"],"marked":[1],"facts":{"verb":"اسْتَوَى"}},{"id":"istawa-28-14-3","words":["verb:istawa"],"options":[{"bs":"i dostigao je zrelost","en":"and he/it reached maturity"},{"bs":"da se ustalite","en":"so that you (all) may settle"},{"bs":"i ustalila se","en":"and she/it settled"},{"bs":"(nisu) jednaki","en":"(not) equal are"}],"ref":"28:14","answerWord":"وَٱسْتَوَىٰٓ","answerSound":"audio/d65fc5bae76a2e92f8c1.m4a","quranTranslation":{"text":"And when he reached his full strength and was ripe, We gave him wisdom and knowledge. Thus do We reward the good.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustaliti se, uzdići se","en":"to be level, to settle, to rise"},"passage":["وَلَمَّا","بَلَغَ","أَشُدَّهُۥ","وَٱسْتَوَىٰٓ","ءَاتَيْنَٰهُ","حُكْمًا","وَعِلْمًا","وَكَذَٰلِكَ","نَجْزِى","ٱلْمُحْسِنِينَ"],"marked":[3],"facts":{"verb":"اسْتَوَى"}},{"id":"istawa-43-13-0","words":["verb:istawa"],"options":[{"bs":"da se ustalite","en":"so that you (all) may settle"},{"bs":"jednak je","en":"he/it is equal"},{"bs":"jednaki su","en":"they are equal"},{"bs":"uzdigao se","en":"he/it rose"}],"ref":"43:13","answerWord":"لِتَسْتَوُۥا۟","answerSound":"audio/a8e1b853609fd89f0e9b.m4a","quranTranslation":{"text":"That ye may mount upon their backs, and may remember your Lord's favour when ye mount thereon, and may say: Glorified be He Who hath subdued these unto us, and we were not capable (of subduing them);","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustaliti se, uzdići se","en":"to be level, to settle, to rise"},"passage":["لِتَسْتَوُۥا۟","عَلَىٰ","ظُهُورِهِۦ","ثُمَّ","تَذْكُرُوا۟","نِعْمَةَ","رَبِّكُمْ","إِذَا","ٱسْتَوَيْتُمْ","عَلَيْهِ","وَتَقُولُوا۟","سُبْحَٰنَ","ٱلَّذِى","سَخَّرَ","لَنَا","هَٰذَا","وَمَا","كُنَّا","لَهُۥ","مُقْرِنِينَ"],"marked":[0],"facts":{"verb":"اسْتَوَى"}},{"id":"istawa-43-13-8","words":["verb:istawa"],"options":[{"bs":"ustalili ste se","en":"you (all) settled"},{"bs":"(nisu) jednaki","en":"(not) equal are"},{"bs":"uzdigao se","en":"he/it rose"},{"bs":"ustalio si se","en":"you settled"}],"ref":"43:13","answerWord":"ٱسْتَوَيْتُمْ","answerSound":"audio/8f2ee18fdbf205222bf9.m4a","quranTranslation":{"text":"That ye may mount upon their backs, and may remember your Lord's favour when ye mount thereon, and may say: Glorified be He Who hath subdued these unto us, and we were not capable (of subduing them);","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustaliti se, uzdići se","en":"to be level, to settle, to rise"},"passage":["لِتَسْتَوُۥا۟","عَلَىٰ","ظُهُورِهِۦ","ثُمَّ","تَذْكُرُوا۟","نِعْمَةَ","رَبِّكُمْ","إِذَا","ٱسْتَوَيْتُمْ","عَلَيْهِ","وَتَقُولُوا۟","سُبْحَٰنَ","ٱلَّذِى","سَخَّرَ","لَنَا","هَٰذَا","وَمَا","كُنَّا","لَهُۥ","مُقْرِنِينَ"],"marked":[8],"facts":{"verb":"اسْتَوَى"}},{"id":"istawa-59-20-1","words":["verb:istawa"],"options":[{"bs":"jednak je","en":"he/it is equal"},{"bs":"i dostigao je zrelost","en":"and he/it reached maturity"},{"bs":"da se ustalite","en":"so that you (all) may settle"},{"bs":"ustalili ste se","en":"you (all) settled"}],"ref":"59:20","answerWord":"يَسْتَوِىٓ","answerSound":"audio/b90d44018647ffb32c04.m4a","quranTranslation":{"text":"Not equal are the owners of the Fire and the owners of the Garden. The owners of the Garden, they are the victorious.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ustaliti se, uzdići se","en":"to be level, to settle, to rise"},"passage":["لَا","يَسْتَوِىٓ","أَصْحَٰبُ","ٱلنَّارِ","وَأَصْحَٰبُ","ٱلْجَنَّةِ","أَصْحَٰبُ","ٱلْجَنَّةِ","هُمُ","ٱلْفَآئِزُونَ"],"marked":[1],"facts":{"verb":"اسْتَوَى"}}]