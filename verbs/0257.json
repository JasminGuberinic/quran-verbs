": null}, {"text": "ٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنُرِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِرْعَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهَٰمَٰنَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَجُنُودَهُمَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَحْذَرُونَ", "hit": true, "audio": "audio/eda9626f6fc330021c0a.m4a", "gloss": {"bs": "pribojavali su se", "en": "they feared", "tr": "korktular", "fr": "ils craignaient", "id": "mereka takut", "ur": "وہ ڈرتے تھے", "bn": "তারা ভয় করেছিল", "fa": "می‌ترسیدند"}}]}], "forms": [{"arabic": "يَحْذَرُ", "count": 2, "first": "9:64", "audio": "audio/e67f4d92251f8aff6655.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it bewares", "bs": "čuva se", "tr": "sakınır", "fr": "il se garde", "id": "dia menjaga diri", "ur": "وہ خبردار رہتا ہے", "bn": "সে সতর্ক থাকে", "fa": "پرهیز می‌کند"}}, {"arabic": "يَحْذَرُونَ", "count": 2, "first": "9:122", "audio": "audio/eda9626f6fc330021c0a.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "pribojavali su se", "en": "they feared", "tr": "korktular", "fr": "ils craignaient", "id": "mereka takut", "ur": "وہ ڈرتے تھے", "bn": "তারা ভয় করেছিল", "fa": "می‌ترسیدند"}}, {"arabic": "فَٱحْذَرُوهُ", "count": 1, "first": "2:235", "audio": "audio/8696de00e87c05ec727f.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "so (you all) beware of him!", "bs": "pa ga se čuvajte!", "tr": "böylece ondan sakının!", "fr": "gardez-vous-en donc !", "id": "maka waspadalah kalian terhadapnya!", "