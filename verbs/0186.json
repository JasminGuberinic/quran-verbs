, {"tense": "imperative", "pronoun": "anti", "arabic": "عُودِي", "plain": "عُودِي", "quran": false, "notUsed": false, "spoken": "audio/4fbaac0e79b754bf3fda.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "عُودَا", "plain": "عُودَا", "quran": false, "notUsed": false, "spoken": "audio/66d11734573bcd1ccf87.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "عُودُوا", "plain": "عُودُوا", "quran": false, "notUsed": false, "spoken": "audio/9b093fba1ec4f29ab998.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "عُدْنَ", "plain": "عُدْنَ", "quran": false, "notUsed": false, "spoken": "audio/6d8e51d6bbd7e387aecf.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "24:17", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2808.mp3", "translation": {"en": {"text": "Allah admonisheth you that ye repeat not the like thereof ever, if ye are (in truth) believers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer inanmış insanlarsanız, Allah, bir daha buna benzer tutumu tekrarlamaktan sizi sakındırıp uyarıyor.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ تمہیں نصیحت فرماتا ہے کہ اب کبھی ایسا نہ کہنا اگر ایمان رکھتے ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah memperingatkan kamu agar (jangan) kembali memperbuat yang seperti itu selama-lamanya, jika kamu orang-orang yang beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَعِظُكُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَعُودُوا۟", "hit": true, "audio": "audio/4cadca3ba5cba573a4ca.m4a", "gloss": {"bs": "se vratite", "en": "you return", "tr": "dönersiniz", "fr": "vous reviendrez", "id": "kamu kembali", "ur": "تم لوٹو", "bn": "তোমরা ফিরে এসো", "fa": "بازگردید"}}, {"text": "لِمِثْلِهِۦٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَبَدًا", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّؤْمِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:39", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3744.mp3", "translation": {"en": {"text": "And for the moon We have appointed mansions till she return like an old shrivelled palm-leaf.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ay'a gelince, ona menziller tayin ettik. Nihayet o eski hurma salkımının çöpü gibi (yay haline) dönmüştür.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور چاند کے لیے ہم نے منزلیں مقرر کیں یہاں تک کہ پھر ہوگیا جیسے کھجور کی پرانی ڈال (ٹہنی)", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan telah Kami tetapkan bagi bulan manzilah-manzilah, sehingga (setelah dia sampai ke manzilah yang terakhir) kembalilah dia sebagai bentuk tandan yang tua.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلْقَمَرَ", "hit": false, "audio": null, "gloss": null}, {"text": "قَدَّرْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَنَازِلَ", "hit": false, "audio": null, "gloss": null}, {"text": "حَتَّىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "عَادَ", "hit": true, "audio": "audio/a9ea2b265cdec6dae785.m4a", "gloss": {"en": "he/it returned", "bs": "vratio se", "tr": "döndü", "fr": "il est revenu", "id": "dia kembali", "ur": "وہ لوٹا", "bn": "সে ফিরল", "fa": "بازگشت"}}, {"text": "كَٱلْعُرْجُونِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَدِيمِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:107", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2780.mp3", "translation": {"en": {"text": "Our Lord! Oh, bring us forth from hence! If we return (to evil) then indeed we shall be wrong-doers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbimiz! Bizi buradan çıkar. Eğer bir daha (ettiklerimize) dönersek, artık belli ki biz zalim insanlarız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے رب ہمارے ہم کو دوزخ سے نکال دے پھر اگر ہم ویسے ہی کریں تو ہم ظالم ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ya Tuhan kami, keluarkanlah kami daripadanya (dan kembalikanlah kami ke dunia), maka jika kami kembali (juga kepada kekafiran), sesungguhnya kami adalah orang-orang yang zalim\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رَبَّنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخْرِجْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عُدْنَا", "hit": true, "audio": "audio/053116a585fc6463fe6e.m4a", "gloss": {"bs": "se vratimo", "en": "we return", "tr": "döneriz", "fr": "nous reviendrons", "id": "kami kembali", "ur": "ہم لوٹیں", "bn": "আমরা ফিরে আসি", "fa": "بازمی‌گردیم"}}, {"text": "فَإِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ظَٰلِمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "17:8", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2037.mp3", "translation": {"en": {"text": "It may be that your Lord will have mercy on you, but if ye repeat (the crime) We shall repeat (the punishment), and We have appointed hell a dungeon for the disbelievers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Olur ki Rabbiniz size merhamet eder. Ama siz tekrar dönerseniz biz de döneriz. Cehennemi, kâfirler için kuşatıcı bir zindan yaptık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "قریب ہے کہ تمہارا رب تم پر رحم کرے اور اگر تم پھر شرارت کرو تو ہم پھر عذاب کریں گے اور ہم نے جہنم کو کافروں کا قید خانہ بنایا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mudah-mudahan Tuhanmu akan melimpahkan rahmat(Nya) kepadamu; dan sekiranya kamu kembali kepada (kedurhakaan) niscaya Kami kembali (mengazabmu) dan Kami jadikan neraka Jahannam penjara bagi orang-orang yang tidak beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "عَسَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَرْحَمَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عُدتُّمْ", "hit": true, "audio": "audio/fe8c278b9bc0743071dd.m4a", "gloss": {"en": "you (all) returned", "bs": "vratili ste se", "tr": "döndünüz", "fr": "vous êtes revenus", "id": "kalian telah kembali", "ur": "تم سب لوٹے", "bn": "তোমরা ফিরে গেছ", "fa": "بازگشتید"}}, {"text": "عُدْنَا", "hit": true, "audio": "audio/6b09540eb5836387a448.m4a", "gloss": {"bs": "se vratimo", "en": "we return", "tr": "döneriz", "fr": "nous reviendrons", "id": "kami kembali", "ur": "ہم لوٹیں", "bn": "আমরা ফিরে আসি", "fa": "بازمی‌گردیم"}}, {"text": "وَجَعَلْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "جَهَنَّمَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلْكَٰفِرِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "حَصِيرًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "عَادَ", "count": 3, "first": "2:275", "audio": "audio/75ffe5be849add47d895.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it returned", "bs": "vratio se", "tr": "döndü", "fr": "il est revenu", "id": "dia kembali", "ur": "وہ لوٹا", "bn": "সে ফিরল", "fa": "بازگشت"}}, {"arabic": "عُدْنَا", "count": 3, "first": "7:89", "audio": "audio/053116a585fc6463fe6e.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"bs": "se vratimo", "en": "we return", "tr": "döneriz", "fr": "nous reviendrons", "id": "kami kembali", "ur": "ہم لوٹیں", "bn": "আমরা ফিরে আসি", "fa": "بازمی‌گردیم"}}, {"arabic": "لَتَعُودُنَّ", "count": 2, "first": "7:88", "audio": "audio/15e292d6ad141964f637.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "surely you (all) will return", "bs": "zaista ćete se vratiti", "tr": "kesinlikle döneceksiniz", "fr": "vous reviendrez assurément", "id": "sungguh kalian akan kembali", "ur": "یقیناً تم سب لوٹو گے", "bn": "নিশ্চয়ই তোমরা ফিরে যাবে", "fa": "قطعاً بازخواهید گشت"}}, {"arabic": "تَعُودُوا۟", "count": 2, "first": "8:19", "audio": "audio/2553ab558439ce530af0.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}, {"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"bs": "se vratite", "en": "you return", "tr": "dönersiniz", "fr": "vous reviendrez", "id": "kamu kembali", "ur": "تم لوٹو", "bn": "তোমরা ফিরে এসো", "fa": "بازگردید"}}, {"arabic": "يَعُودُونَ", "count": 2, "first": "58:3", "audio": "audio/b5c81b6def0d1464f495.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they return", "bs": "vraćaju se", "tr": "dönerler", "fr": "ils reviennent", "id": "mereka kembali", "ur": "وہ لوٹتے ہیں", "bn": "তারা ফিরে যায়", "fa": "بازمی