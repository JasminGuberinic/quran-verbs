 [], "mood": "jussive"}], "gloss": {"en": "he/it asks forgiveness", "bs": "traži oprost", "tr": "bağışlanma diler", "fr": "il demande pardon", "id": "dia memohon ampun", "ur": "وہ معافی مانگتا ہے", "bn": "সে ক্ষমা চায়", "fa": "آمرزش بخواهد"}}, {"arabic": "أَسْتَغْفَرْتَ", "count": 1, "first": "63:6", "audio": "audio/908d8c18b9235d8ca233.m4a", "grammar": [{"tense": "past", "pronoun": "anta", "passive": false, "objects": []}]}, {"arabic": "وَٱسْتَغْفِرْهُ", "count": 1, "first": "110:3", "audio": "audio/4a822320e13430a285df.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "and ask him forgiveness!", "bs": "i traži mu oprost!", "tr": "ve ondan bağışlanma dile!", "fr": "et demande-lui pardon !", "id": "dan mohonlah ampun kepadanya!", "ur": "اور اس سے معافی مانگ!", "bn": "এবং তার কাছে ক্ষমা চাও!", "fa": "و از او آمرزش بخواه!"}}], "ayatFile": "ayat/0096.json", "ayatTranslations": {"en": "ayat/0096.en.json", "tr": "ayat/0096.tr.json", "ur": "ayat/0096.ur.json", "id": "ayat/0096.id.json"}, "sentences": [{"arabic": "اسْتَغْفَرَ الرَّجُلُ رَبَّهُ", "spoken": "audio/4a2fe7edb46fc194dc8a.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Čovjek je tražio oprost od svog Gospodara.", "en": "The man asked his Lord for forgiveness.", "bn": "লোকটি তার রবের কাছে ক্ষমা চাইল।", "fa": "مرد از پروردگارش آمرزش خواست.", "fr": "L'homme a demandé pardon à son Seigneur.", "id": "Laki-laki itu memohon ampun kepada Tuhannya.", "tr": "Adam Rabbinden bağışlanma diledi.", "ur": "آدمی نے اپنے رب سے مغفرت مانگی۔"}, "independentlyReviewed": true, "words": [{"arabic": "اسْتَغْفَرَ", "target": true, "translation": {"bs": "tražio je oprost", "en": "asked forgiveness", "bn": "ক্ষমা চাইল", "fa": "آمرزش خواست", "fr": "a demandé pardon", "id": "memohon ampun", "tr": "bağışlanma diledi", "ur": "اس نے مغفرت مانگی"}}, {"arabic": "الرَّجُلُ", "target": false, "translation": {"bs": "čovjek", "en": "the man", "bn": "লোকটি", "fa": "