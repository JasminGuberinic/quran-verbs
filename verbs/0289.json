{"rank": 289, "root": "نوب", "form": 4, "lemma": "أَنابَ", "count": 11, "ayahCount": 11, "share": 0.06, "meaning": {"bs": "obratiti se (s pokajanjem), opunomoćiti", "en": "to turn (in repentance), to deputize", "tr": "yönelmek (tövbe ile), vekil kılmak", "fr": "revenir (par le repentir), déléguer", "id": "bertobat, mewakilkan", "ur": "رجوع کرنا، توبہ کرنا", "bn": "তাওবা করে ফিরে আসা, প্রতিনিধিত্ব করা", "fa": "بازگشتن (با توبه)، جانشین قرار دادن"}, "lemmaSpoken": "audio/2d5bccc5a4ed31487e69.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَنَابَ", "plain": "أَنَابَ", "quran": true, "notUsed": false, "spoken": "audio/2d5bccc5a4ed31487e69.m4a", "recited": "audio/8ca36562fc38bf48d0fa.m4a", "recitedText": "أَنَابَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُنِيبُ", "plain": "يُنِيبُ", "quran": true, "notUsed": false, "spoken": "audio/57c0fff77c6e9db797a6.m4a", "recited": "audio/5df437f009fed34e955e.m4a", "recitedText": "يُنِيبُ"}], "nouns": {"participle": {"lemma": "مُنِيب", "count": 7, "spoken": "audio/f359694f8eb504798a71.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَنَبْتُ", "plain": "أَنَبْتُ", "quran": false, "notUsed": false, "spoken": "audio/a629f9c8928e86e926ff.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَنَبْنَا", "plain": "أَنَبْنَا", "quran": true, "notUsed": false, "spoken": "audio/d3afad334d62800c7a0b.m4a", "recited": "audio/30d299a102dbbe5cc7ce.m4a", "recitedText": "أَنَبْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "أَنَبْتَ", "plain": "أَنَبْتَ", "quran": false, "notUsed": false, "spoken": "audio/29f0a1786a653d0e180f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "أَنَبْتِ", "plain": "أَنَبْتِ", "quran": false, "notUsed": false, "spoken": "audio/4736f4a454bc83847282.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "أَنَبْتُمَا", "plain": "أَنَبْتُمَا", "qu