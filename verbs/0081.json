: null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِحْسَبْ", "plain": "اِحْسَبْ", "quran": false, "notUsed": false, "spoken": "audio/7afed2bf90f4ea993feb.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِحْسَبِي", "plain": "اِحْسَبِي", "quran": false, "notUsed": false, "spoken": "audio/684904679b6edd6bb8af.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِحْسَبَا", "plain": "اِحْسَبَا", "quran": false, "notUsed": false, "spoken": "audio/b66b989030bec4b77a60.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِحْسَبُوا", "plain": "اِحْسَبُوا", "quran": false, "notUsed": false, "spoken": "audio/453152950b98bef633e7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِحْسَبْنَ", "plain": "اِحْسَبْنَ", "quran": false, "notUsed": false, "spoken": "audio/f4df9268de545170dba7.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "104:3", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6182.mp3", "translation": {"en": {"text": "He thinketh that his wealth will render him immortal.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Malının, kendisini ebedi yaşatacağını sanır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا یہ سمجھتا ہے کہ اس کا مال اسے دنیا میں ہمیشہ رکھے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dia mengira bahwa hartanya itu dapat mengkekalkannya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَحْسَبُ", "hit": true, "audio": "audio/cd636bf693c3973020b2.m4a", "gloss": {"bs": "misli", "en": "he thinks", "tr": "sanır", "fr": "il pense", "id": "dia mengira", "ur": "وہ سمجھتا ہے", "bn": "সে মনে করে", "fa": "گمان می‌کند"}}, {"text": "أَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "مَالَهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخْلَدَهُۥ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "14:47", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1797.mp3", "translation": {"en": {"text": "So think not that Allah will fail to keep His promise to His messengers. Lo! Allah is Mighty, Able to Requite (the wrong).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O halde sakın Allah'ın peygamberlerine olan vaadinden cayacağını sanma! Şüphesiz Allah her şeye galiptir, intikam sahibidir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ہر گز خیال نہ کرنا کہ اللہ اپنے رسولوں سے وعدہ خلاف کرے گا بیشک اللہ غالب ہے بدلہ لینے والا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Karena itu janganlah sekali-kali kamu mengira Allah akan menyalahi janji-Nya kepada rasul-raaul-Nya; sesungguhnya Allah Maha Perkasa, lagi mempunyai pembalasan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَحْسَبَنَّ", "hit": true, "audio": "audio/bd05643b6e7dabef3e0a.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "indicative"}]}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "مُخْلِفَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَعْدِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "رُسُلَهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَزِيزٌ", "hit": false, "audio": null, "gloss": null}, {"text": "ذُو", "hit": false, "audio": null, "gloss": null}, {"text": "ٱنتِقَامٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:55", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2728.mp3", "translation": {"en": {"text": "Think they that in the wealth and sons wherewith We provide them", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sanıyorlar mı ki, onlara verdiğimiz servet ve oğullar ile,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا یہ خیال کررہے ہیں کہ وہ جو ہم ان کی مدد کررہے ہیں مال اور بیٹوں سے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apakah mereka mengira bahwa harta dan anak-anak yang Kami berikan kepada mereka itu (berarti bahwa),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَيَحْسَبُونَ", "hit": true, "audio": "audio/67856f328dce80bf9322.m4a", "gloss": {"en": "do they think?", "bs": "zar misle?", "tr": "sanırlar mı?", "fr": "pensent-ils ?", "id": "apakah mereka mengira?", "ur": "کیا وہ سمجھتے ہیں؟", "bn": "তারা কি মনে করে?", "fa": "آیا گمان می‌کنند؟"}}, {"text": "أَنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "نُمِدُّهُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "مَّالٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَبَنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "29:2", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3342.mp3", "translation": {"en": {"text": "Do men imagine that they will be left (at ease) because they say, We believe, and will not be tested with affliction?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İnsanlar, imtihandan geçirilmeden, sadece \"İman ettik\" demeleriyle bırakılıvereceklerini mi sandılar?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا لوگ اس گھمنڈ میں ہیں کہ اتنی بات پر چھوڑ دیے جائیں گے کہ کہیں ہم ایمان لائے، اور ان کی آزمائش نہ ہوگی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apakah manusia itu mengira bahwa mereka dibiarkan (saja) mengatakan: \"Kami telah beriman\", sedang mereka tidak diuji lagi?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَحَسِبَ", "hit": true, "audio": "audio/d4d40f67c8469e2d3fa7.m4a", "gloss": {"en": "did he/it think?", "bs": "zar je mislio?", "tr": "sandı mı?", "fr": "a-t-il pensé ?", "id": "apakah dia telah mengira?", "ur": "کیا اُس نے سمجھا؟", "bn": "সে কি মনে করেছিল?", "fa": "آیا گمان کرد؟"}}, {"text": "ٱلنَّاسُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يُتْرَكُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُولُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُفْتَنُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:115", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2788.mp3", "translation": {"en": {"text": "Deemed ye then that We had created you for naught, and that ye would not be returned unto Us?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sizi sadece boş yere yarattığımızı ve sizin hakikaten huzurumuza geri getirilmeyeceğinizi mi sandınız?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو کیا یہ سمجھتے ہو کہ ہم نے تمہیں بیکار بنایا اور تمہیں ہماری طرف پھرنا نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka apakah kamu mengira, bahwa sesungguhnya Kami menciptakan kamu secara main-main (saja), dan bahwa kamu tidak akan dikembalikan kepada Kami?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَفَحَسِبْتُمْ", "hit": true, "audio": "audio/d65a87e595d5b9447314.m4a", "gloss": {"bs": "zar ste mislili", "en": "did you then think", "tr": "siz mi sandınız", "fr": "pensiez-vous donc", "id": "apakah kamu mengira", "ur": "کیا پھر تم نے سمجھا", "bn": "তোমরা কি তাহলে মনে করেছিলে", "fa": "آیا پس گمان کردید"}}, {"text": "أَنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقْنَٰكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَبَثًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُرْجَعُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "76:19", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5610.mp3", "translation": {"en": {"text": "There wait on them immortal youths, whom, when thou seest, thou wouldst take for scattered pearls.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Etraflarında ölümsüz hizmetçiler dolaşır, onları görünce saçılmış inciler sanırsın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان کے آس پاس خدمت میں پھریں گے ہمیشہ رہنے والے لڑکے جب تو انہیں دیکھے تو انہیں سمجھے کہ موتی ہیں بکھیرے ہوئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka dikelilingi oleh pelayan-pelayan muda yang tetap muda. Apabila kamu melihat mereka, kamu akan mengira mereka, mutiara yang bertaburan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَطُوفُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وِلْدَٰنٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مُّخَلَّدُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "رَأَيْتَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "حَسِبْتَهُمْ", "hit": true, "audio": "audio/9a5ecb0d18180f774602.m4a", "gloss": {"en": "you thought them", "bs": "smatrao si ih", "tr": "onları saydın", "fr": "tu les as tenus pour", "id": "kamu telah menganggap mereka", "ur": "تم نے انہیں سمجھا", "bn": "তুমি তাদের গণ্য করেছিলে", "fa": "آنان را پنداشتی"}}, {"text": "لُؤْلُؤًا", "hit": false, "audio": null, "gloss": null}, {"text": "مَّنثُورًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تَحْسَبَنَّ", "count": 5, "first": "3:169", "audio": "audio/488af4723f4ebaaf5ad3.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "indicative"}, {"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "jussive"}]}, {"arabic": "يَحْسَبُونَ", "count": 4, "first": "18:104", "audio": "audio/01b61d865a9bb099631b.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they think", "bs": "misle", "tr": "sanırlar", "fr": "ils pensent", "id": "mereka mengira", "ur": "وہ سمجھتے ہیں", "bn": "তারা মনে করে", "fa": "گمان می‌کنند"}}, {"arabic": "أَيَحْسَبُ", "count": 4, "first": "75:3", "audio": "audio/beefe5d1d6301713069d.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "does he/it think?", "bs": "zar misli?", "tr": "sanır mı?", "fr": "pense-t-il ?", "id": "apakah dia mengira?", "ur": "کیا وہ سمجھتا ہے؟", "bn": "সে কি মনে করে?", "fa": "آیا گمان می‌کند؟"}}, {"arabic": "حَسِبْتُمْ", "count": 3, "first": "2:214", 