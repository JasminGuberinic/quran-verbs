arabic": "الطُّلَّابُ يَعْرِفُونَ الْقَاعِدَةَ", "spoken": "audio/3bcde545b6e255603dd2.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Učenici znaju pravilo.", "en": "The students know the rule.", "bn": "ছাত্ররা নিয়মটি জানে।", "fa": "دانش‌آموزان قاعده را می‌دانند.", "fr": "Les élèves connaissent la règle.", "id": "Para siswa tahu aturannya.", "tr": "Öğrenciler kuralı bilir.", "ur": "طلبہ قاعدہ جانتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "الطُّلَّابُ", "target": false, "translation": {"bs": "učenici", "en": "the students", "bn": "ছাত্ররা", "fa": "دانش‌آموزان", "fr": "des étudiants", "id": "para siswa", "tr": "öğrenciler", "ur": "طلبہ"}}, {"arabic": "يَعْرِفُونَ", "target": true, "translation": {"bs": "znaju", "en": "know", "bn": "জানো", "fa": "می‌دانند", "fr": "savent", "id": "ketahuilah", "tr": "bilir", "ur": "وہ جانتے ہیں"}}, {"arabic": "الْقَاعِدَةَ", "target": false, "translation": {"bs": "pravilo", "en": "the rule", "bn": "নিয়ম", "fa": "قاعده", "fr": "la règle", "id": "aturan", "tr": "kural", "ur": "قاعدہ"}}]}, {"arabic": "تَعْرِفُ اسْمَ جَارِكَ", "spoken": "audio/0871a43948438b03280f.m4a", "tense": "present", "pronoun": "anta", "translation": {"bs": "Znaš ime svog komšije.", "en": "You know your neighbor's name.", "bn": "তুমি তোমার প্রতিবেশীর নাম জানো।", "fa": "نام همسایه‌ات را می‌دانی.", "fr": "Tu connais le nom de ton voisin.", "id": "Kamu tahu nama tetanggamu.", "tr": "Komşunun adını biliyorsun.", "ur": "تم اپنے پڑوسی کا نام جانتے ہو۔"}, "independentlyReviewed": true, "words": [{"arabic": "تَعْرِفُ", "target": true, "translation": {"bs": "znaš", "en": "you know", "bn": "তুমি জানো", "fa": "می‌دانی", "fr": "tu connais", "id": "kamu tahu", "tr": "bilirsin", "ur": "تم جانتے ہو"}}, {"arabic": "اسْمَ", "target": false, "translation": {"bs": "ime", "en": "the name", "bn": "নাম", "fa": "نام", "fr": "le nom", "id": "nama", "tr": "isim", "ur": "نام"}}, {"arabic": "جَارِكَ", "target": false, "translation": {"bs": "svog komšije", "en": "of your neighbor", "bn": "তোমার প্রতিবেশীর", "fa": "همسایه‌ات", "fr": "de ton voisin", "id": "tetanggamu", "tr": "komşunun", "ur": "تمہارے پڑوسی کا"}}]}]}