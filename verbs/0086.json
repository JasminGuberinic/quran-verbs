"pronoun": "anta", "arabic": "أَدْخِلْ", "plain": "أَدْخِلْ", "quran": true, "notUsed": false, "spoken": "audio/9a9a681beaf930344ce2.m4a", "recited": "audio/6db8100d031f7a6a5d5c.m4a", "recitedText": "وَأَدْخِلْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَدْخِلِي", "plain": "أَدْخِلِي", "quran": false, "notUsed": false, "spoken": "audio/d83aea34cb228358aea5.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَدْخِلَا", "plain": "أَدْخِلَا", "quran": false, "notUsed": false, "spoken": "audio/10109706c4f22b3667b5.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَدْخِلُوٓا۟", "plain": "أَدْخِلُوا", "quran": true, "notUsed": false, "spoken": "audio/77d32d7dd16720d6997f.m4a", "recited": "audio/d8a3596ffc0d9cf3c65a.m4a", "recitedText": "أَدْخِلُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَدْخِلْنَ", "plain": "أَدْخِلْنَ", "quran": false, "notUsed": false, "spoken": "audio/51e6e6836f6228c7e4a8.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "47:6", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4551.mp3", "translation": {"en": {"text": "And bring them in unto the Garden which He hath made known to them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onları, kendilerine tanıttığı cennete koyacaktır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور انہیں جنت میں لے جائے گا انہیں اس کی پہچان کرادی ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan memasukkan mereka ke dalam jannah yang telah diperkenankan-Nya kepada mereka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيُدْخِلُهُمُ", "hit": true, "audio": "audio/c029a5949cde3f294db7.m4a", "gloss": {"bs": "i uvest će ih", "en": "and He will admit them", "tr": "ve onları sokacak", "fr": "et Il les fera entrer", "id": "dan Dia akan memasukkan mereka", "ur": "اور وہ انہیں داخل کرے گا", "bn": "এবং তিনি তাদের প্রবেশ করাবেন", "fa": "و آنان را وارد خواهد کرد"}}, {"text": "ٱلْجَنَّةَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَرَّفَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "29:9", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3349.mp3", "translation": {"en": {"text": "And as for those who believe and do good works, We verily shall make them enter in among the righteous.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İman edip iyi işler yapanları, muhakkak salihler (zümresi) içine katarız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جو ایمان لائے اور اچھے کام کیے ضرور ہم انہیں نیکوں میں شامل کریں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang beriman dan mengerjakan amal saleh benar-benar akan Kami masukkan mereka ke dalam (golongan) orang-orang yang saleh.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَعَمِلُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّٰلِحَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَنُدْخِلَنَّهُمْ", "hit": true, "audio": "audio/ddfafa08e166f9fd8ebf.m4a", "gloss": {"en": "surely we will admit them", "bs": "zaista ćemo ih uvesti", "tr": "kesinlikle onları içeri alacağız", "fr": "nous les introduirons assurément", "id": "sungguh kami akan memasukkan mereka", "ur": "یقیناً ہم انہیں داخل کریں گے", "bn": "নিশ্চয়ই আমরা তাদের প্রবেশ করাব", "fa": "قطعاً آنان را وارد خواهیم کرد"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّٰلِحِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:151", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1105.mp3", "translation": {"en": {"text": "He said: My Lord! Have mercy on me and on my brother; bring us into Thy mercy, Thou the Most Merciful of all who show mercy.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa dedi ki: \"Ey Rabbim! Beni ve kardeşimi bağışla! Bizi rahmetinin içine al. Sen merhametlilerin en merhametlisisin.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "عرض کی اے میرے رب! مجھے اور میرے بھائی کو بخش دے اور ہمیں اپنی رحمت کے اندر لے لے اور تو سب مہر والوں سے بڑھ کر مہر والا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Musa berdoa: \"Ya Tuhanku, ampunilah aku dan saudaraku dan masukkanlah kami ke dalam rahmat Engkau, dan Engkau adalah Maha Penyayang di antara para penyayang\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱغْفِرْ", "hit": false, "audio": null, "gloss": null}, {"text": "لِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَلِأَخِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَدْخِلْنَا", "hit": true, "audio": "audio/99115d1e467cd4ea0b49.m4a", "gloss": {"bs": "i uvedi nas!", "en": "and admit us!", "tr": "ve bizi sok!", "fr": "et fais-nous entrer !", "id": "dan masukkanlah kami!", "ur": "اور ہمیں داخل کر!", "bn": "এবং আমাদের প্রবেশ করাও!", "fa": "و ما را وارد کن!"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "رَحْمَتِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنتَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْحَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّٰحِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:75", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2558.mp3", "translation": {"en": {"text": "And We brought him in unto Our mercy. Lo! he was of the righteous.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onu ise rahmetimizin içine aldık. Çünkü o salihlerdendi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے اسے اپنی رحمت میں داخل کیا، بیشک وہ ہمارے قرب خاص سزاواروں میں ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan Kami masukkan dia ke dalam rahmat Kami; karena sesungguhnya dia termasuk orang-orang yang saleh.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَدْخَلْنَٰهُ", "hit": true, "audio": "audio/c4ae6639c52c2c89a310.m4a", "gloss": {"bs": "i uveli smo ga", "en": "and We admitted him", "tr": "ve onu soktuk", "fr": "et Nous l'avons fait entrer", "id": "dan Kami memasukkannya", "ur": "اور ہم نے اسے داخل کیا", "bn": "এবং আমরা তাকে প্রবেশ করালাম", "fa": "و او را وارد کردیم"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "رَحْمَتِنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّٰلِحِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:192", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/485.mp3", "translation": {"en": {"text": "Our Lord! Whom Thou causest to enter the Fire: him indeed Thou hast confounded. For evil-doers there will be no helpers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Rabbimiz! Sen kimi cehennem ateşine sokarsan onu rezil etmişsindir. Zalimlerin hiç yardımcıları yoktur\".", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے رب ہمارے! بیشک جسے تو دوزخ میں لے جائے اسے ضرور تو نے رسوائی دی اور ظالموں کا کوئی مددگار نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ya Tuhan kami, sesungguhnya barangsiapa yang Engkau masukkan ke dalam neraka, maka sungguh telah Engkau hinakan ia, dan tidak ada bagi orang-orang yang zalim seorang penolongpun.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رَبَّنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "تُدْخِلِ", "hit": true, "audio": "audio/04d8d4acf816b01106a3.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "jussive"}]}, {"text": "ٱلنَّارَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَخْزَيْتَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "لِلظَّٰلِمِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنصَارٍ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُدْخِلُ", "count": 5, "first": "22:14", "audio": "audio/a2361be7143f4c6bb714.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it admits", "bs": "uvodi", "tr": "içeri alır", "fr": "il introduit", "id": "dia memasukkannya", "ur": "وہ داخل کرتا ہے", "bn": "সে প্রবেশ করায়", "fa": "وارد می‌کند"}}, {"arabic": "يُدْخِلْهُ", "count": 4, "first": "4:13", "audio": "audio/74248f23de028f2df252.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["huwa"], "mood": "jussive"}], 