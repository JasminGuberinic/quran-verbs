lyReviewed": true, "words": [{"arabic": "يَنَالُونَ", "target": true, "translation": {"bs": "stiču", "en": "they attain", "bn": "তারা অর্জন করে", "fa": "به دست می‌آورند", "fr": "obtiennent", "id": "mereka meraih", "tr": "elde ederler", "ur": "وہ پاتے ہیں"}}, {"arabic": "احْتِرَامَ", "target": false, "translation": {"bs": "poštovanje", "en": "respect", "bn": "সম্মান", "fa": "احترام", "fr": "le respect", "id": "rasa hormat", "tr": "saygı", "ur": "عزت"}}, {"arabic": "النَّاسِ", "target": false, "translation": {"bs": "ljudi", "en": "the people", "bn": "মানুষের", "fa": "مردم", "fr": "les gens", "id": "orang-orang itu", "tr": "insanlar", "ur": "لوگ"}}]}]}