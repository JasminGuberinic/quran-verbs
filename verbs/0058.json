quran": false, "notUsed": false, "spoken": "audio/cc06bf8085591031db2e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُنْصُرِي", "plain": "اُنْصُرِي", "quran": false, "notUsed": false, "spoken": "audio/828c6e882bac87925874.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُنْصُرَا", "plain": "اُنْصُرَا", "quran": false, "notUsed": false, "spoken": "audio/fff717309aac321ad368.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱنصُرُوٓا۟", "plain": "اُنْصُرُوا", "quran": true, "notUsed": false, "spoken": "audio/cc0e0c3230d7c4ae95cb.m4a", "recited": "audio/c104c343cf9374167a2c.m4a", "recitedText": "وَٱنصُرُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُنْصُرْنَ", "plain": "اُنْصُرْنَ", "quran": false, "notUsed": false, "spoken": "audio/5d73c238939b2166eb60.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "48:3", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4586.mp3", "translation": {"en": {"text": "And that Allah may help thee with strong help -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve sana Allah, şanlı bir zaferle yardım eder.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اللہ تمہاری زبردست مدد فرمائے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan supaya Allah menolongmu dengan pertolongan yang kuat (banyak).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَنصُرَكَ", "hit": true, "audio": "audio/2770e990a641444a5254.m4a", "gloss": {"bs": "i (da) ti pomogne", "en": "and (that God) may help you", "tr": "ve (Allah) sana yardım etsin diye", "fr": "et (que Dieu) t'accorde la victoire", "id": "dan (agar Allah) menolongmu", "ur": "اور (کہ اللہ) تمہاری مدد کرے", "bn": "এবং (আল্লাহ) তোমাকে সাহায্য করবেন (যাতে)", "fa": "و (تا خدا) تو را یاری کند"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "نَصْرًا", "hit": false, "audio": null, "gloss": null}, {"text": "عَزِيزًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:192", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1146.mp3", "translation": {"en": {"text": "And cannot give them help, nor can they help themselves?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bu putlar, ne o tapınanlara, ne de kendi kendilerine yardım edebilirler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور نہ وہ ان کو کوئی مدد پہنچاسکیں اور نہ اپنی جانو ں کی مدد کریں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan berhala-berhala itu tidak mampu memberi pertolongan kepada penyembah-penyembahnya dan kepada dirinya sendiripun berhala-berha]a itu tidak dapat memberi pertolongan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَطِيعُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَصْرًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنفُسَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَنصُرُونَ", "hit": true, "audio": "audio/44517e4dee9063fcda1a.m4a", "gloss": {"en": "they help", "bs": "pomažu", "tr": "yardım ederler", "fr": "ils secourent", "id": "mereka menolong", "ur": "وہ مدد کرتے ہیں", "bn": "তারা সাহায্য করে", "fa": "یاری می‌کنند"}}]}, {"ref": "23:26", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2699.mp3", "translation": {"en": {"text": "He said: My Lord! Help me because they deny me.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Nuh: \"Rabbim! dedi, beni yalana çıkarmalarına karşı bana yardım et!\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "نوح نے عرض کی اے میرے رب! میری مدد فرما اس پر کہ انہوں نے مجھے جھٹلایا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Nuh berdoa: \"Ya Tuhanku, tolonglah aku, karena mereka mendustakan aku\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱنصُرْنِى", "hit": true, "audio": "audio/be56d5c42a8f69b8c071.m4a", "gloss": {"bs": "pomozi mi!", "en": "help me!", "tr": "bana yardım et!", "fr": "aide-moi !", "id": "tolonglah aku!", "ur": "میری مدد کر!", "bn": "আমাকে সাহায্য করো!", "fa": "مرا یاری کن!"}}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَذَّبُونِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:123", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/416.mp3", "translation": {"en": {"text": "Allah had already given you the victory at Badr, when ye were contemptible. So observe your duty to Allah in order that ye may be thankful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun, sizler güçsüz olduğunuz halde Allah size Bedir'de yardım etmişti. Allah'tan sakının ki, O'na şükretmiş olasınız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک اللہ نے بدر میں تمہاری مدد کی جب تم بالکل بے سر و سامان تھے تو اللہ سے ڈرو کہیں تم شکر گزار ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sungguh Allah telah menolong kamu dalam peperangan Badar, padahal kamu adalah (ketika itu) orang-orang yang lemah. Karena itu bertakwalah kepada Allah, supaya kamu mensyukuri-Nya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَصَرَكُمُ", "hit": true, "audio": "audio/1880fc6e9fe657a7ca1e.m4a", "gloss": {"en": "he/it helped you (all)", "bs": "pomogao vam je", "tr": "size yardım etti", "fr": "il vous a secourus", "id": "dia telah menolong kalian", "ur": "اُس نے تمہاری مدد کی", "bn": "সে তোমাদের সাহায্য করেছে", "fa": "به شما یاری داد"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "بِبَدْرٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَذِلَّةٌ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱتَّقُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَشْكُرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "47:7", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4552.mp3", "translation": {"en": {"text": "O ye who believe! If ye help Allah, He will help you and will make your foothold firm.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey iman edenler! Eğer siz Allah'ın dinine yardım ederseniz Allah da size yardım eder ve ayaklarınızı sabit tutar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے ایمان والو اگر تم دین خدا کی مدد کرو گے اللہ تمہاری مدد کرے گا اور تمہارے قدم جمادے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hai orang-orang mukmin, jika kamu menolong (agama) Allah, niscaya Dia akan menolongmu dan meneguhkan kedudukanmu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَٰٓأَيُّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَنصُرُوا۟", "hit": true, "audio": "audio/d9c9383069b7b8d7878b.m4a", "gloss": {"en": "you (all) help", "bs": "pomažete", "tr": "yardım edersiniz", "fr": "vous secourez", "id": "kalian menolong", "ur": "تم سب مدد کرو", "bn": "তোমরা সাহায্য কর", "fa": "یاری کنید"}}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَنصُرْكُمْ", "hit": true, "audio": "audio/540aecea064bf5ecbc82.m4a", "gloss": {"en": "he/it helps you (all)", "bs": "pomaže vam", "tr": "size yardım eder", "fr": "il vous secourt", "id": "dia menolong kalian", "ur": "وہ تمہاری مدد کرتا ہے", "bn": "সে তোমাদের সাহায্য করে", "fa": "به شما یاری کند"}}, {"text": "وَيُثَبِّتْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَقْدَامَكُمْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:116", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3904.mp3", "translation": {"en": {"text": "And helped them so that they became the victors.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hem yardım ettik onlara da, galip gelenler onlar oldular.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان کی ہم نے مدد فرمائی تو وہی غالب ہوئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami tolong mereka, maka jadilah mereka orang-orang yang menang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَنَصَرْنَٰهُمْ", "hit": true, "audio": "audio/05bb3226124fb9405994.m4a", "gloss": {"bs": "i pomogli smo im", "en": "and We helped them", "tr": "ve onlara yardım ettik", "fr": "et Nous les avons aidés", "id": "dan Kami menolong mereka", "ur": "اور ہم نے ان کی مدد کی", "bn": "এবং আম