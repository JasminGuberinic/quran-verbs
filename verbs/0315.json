un": "hunna", "arabic": "يُؤْوِينَ", "plain": "يُؤْوِينَ", "quran": false, "notUsed": false, "spoken": "audio/a43397133c778f839aa9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "آوِ", "plain": "آوِ", "quran": false, "notUsed": false, "spoken": "audio/8ec2a60f544b210516cb.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "آوِي", "plain": "آوِي", "quran": false, "notUsed": false, "spoken": "audio/ce328a2269e6764fa48c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "آوِيَا", "plain": "آوِيَا", "quran": false, "notUsed": false, "spoken": "audio/6c87be651cb78c221d19.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "آوُوا", "plain": "آوُوا", "quran": false, "notUsed": false, "spoken": "audio/71a913420e0ac805f3c7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "آوِينَ", "plain": "آوِينَ", "quran": false, "notUsed": false, "spoken": "audio/3d26be5a2c128c086678.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "93:6", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6085.mp3", "translation": {"en": {"text": "Did He not find thee an orphan and protect (thee)?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O seni yetim bulup da barındırmadı mı?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا اس نے تمہیں یتیم نہ پایا پھر جگہ دی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Bukankah Dia mendapatimu sebagai seorang yatim, lalu Dia melindungimu?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَلَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَجِدْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتِيمًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَـَٔاوَىٰ", "hit": true, "audio": "audio/4ad3aee75dfe3dc100bd.m4a", "gloss": {"bs": "pa te je zaklonio", "en": "and He sheltered (you)", "tr": "ve seni barındırdı", "fr": "et Il (t')a abrité", "id": "dan Dia melindungi (kamu)", "ur": "پھر اس نے پناہ دی", "bn": "এবং তিনি (তোমাকে) আশ্রয় দিলেন", "fa": "پس پناه داد"}}]}, {"ref": "23:50", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2723.mp3", "translation": {"en": {"text": "And We made the son of Mary and his mother a portent, and We gave them refuge on a height, a place of flocks and watersprings.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Meryemoğlunu ve annesini de (kudretimize) bir alâmet kıldık; onları, yerleşmeye elverişli, sulu bir tepeye yerleştirdik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے مریم اور اس کے بیٹے کو نشانی کیا اور انہیں ٹھکانا دیا ایک بلند زمین جہاں بسنے کا مقام اور نگاہ کے سامنے بہتا پانی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan telah Kami jadikan (Isa) putera Maryam beserta ibunya suatu bukti yang nyata bagi (kekuasaan Kami), dan Kami melindungi mereka di suatu tanah tinggi yang datar yang banyak terdapat padang-padang rumput dan sumber-sumber air bersih yang mengalir.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَجَعَلْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱبْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَرْيَمَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأُمَّهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَةً", "hit": false, "audio": null, "gloss": null}, {"text": "وَءَاوَيْنَٰهُمَآ", "hit": true, "audio": "audio/21480c6cd22cd7b41422.m4a", "gloss": {"en": "and we sheltered them (two)", "bs": "i sklonili smo ih", "tr": "ve onları barındırdık", "fr": "et nous les avons abrités (deux)", "id": "dan kami telah melindungi mereka berdua", "ur": "اور ہم نے ان دونوں کو پناہ دی", "bn": "এবং আমরা তাদের দুজনকে আশ্রয় দিয়েছি", "fa": "و آنان را پناه دادیم"}}, {"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبْوَةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "ذَاتِ", "hit": false, "audio": null, "gloss": null}, {"text": "قَرَارٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَعِينٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "70:13", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5388.mp3", "translation": {"en": {"text": "And his kin that harboured him", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kendisini barındıran, içinde yetiştiği tüm ailesini,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اپنا کنبہ جس میں اس کی جگہ ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan kaum familinya yang melindunginya (di dunia).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَفَصِيلَتِهِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّتِى", "hit": false, "audio": null, "gloss": null}, {"text": "تُـْٔوِيهِ", "hit": true, "audio": "audio/0d4c1f0a556439629e6a.m4a", "gloss": {"bs": "koja ga je štitila", "en": "that sheltered him", "tr": "onu barındıran", "fr": "qui l'abritait", "id": "yang melindunginya", "ur": "جو اسے پناہ دیتا تھا", "bn": "যা তাকে আশ্রয় দিত", "fa": "که او را پناه داد"}}]}], "forms": [{"arabic": "ءَاوَوا۟", "count": 2, "first": "8:72", "audio": "audio/985c02a01045abbdbec3.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they sheltered", "bs": "sklonili su", "tr": "barındırdılar", "fr": "ils ont abrité", "id": "mereka telah berlindung", "ur": "انہوں نے پناہ 