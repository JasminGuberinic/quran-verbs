rative", "pronoun": "antunna", "arabic": "اُبْسُطْنَ", "plain": "اُبْسُطْنَ", "quran": false, "notUsed": false, "spoken": "audio/469393cf5b7227937e78.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "17:30", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2059.mp3", "translation": {"en": {"text": "Lo! thy Lord enlargeth the provision for whom He will, and straiteneth (it for whom He will). Lo, He was ever Knower, Seer of His slaves.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Gerçekten senin Rabbin, kullarından dilediğinin rızkını genişletir ve dilediğini kısar. Şüphesiz ki Allah, kullarının durumlarından haberdardır, her şeyi görendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک تمہارا رب جسے چاہے رزق کشادہ دیتا اور کستا ہے (تنگی دیتا ہے) بیشک وہ اپنے بندوں کو خوب جانتا دیکھتا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Tuhanmu melapangkan rezeki kepada siapa yang Dia kehendaki dan menyempitkannya; sesungguhnya Dia Maha Mengetahui lagi Maha Melihat akan hamba-hamba-Nya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَبْسُطُ", "hit": true, "audio": "audio/e1544ed27015dd7c34c5.m4a", "gloss": {"bs": "daje obilno", "en": "He extends", "tr": "verir (bol bol)", "fr": "Il étend", "id": "Dia membentangkan", "ur": "وہ کشادہ کرتا ہے", "bn": "তিনি প্রসারিত করেন", "fa": "می‌گستراند"}}, {"text": "ٱلرِّزْقَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِمَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَشَآءُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَقْدِرُ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِعِبَادِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "خَبِيرًۢا", "hit": false, "audio": null, "gloss": null}, {"text": "بَصِيرًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَبْسُطُ", "count": 9, "first": "13:26", "audio": "audio/fb468d6f394aad28592b.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "daje obilno", "en": "He extends", "tr": "verir (bol bol)", "fr": "Il étend", "id": "Dia membentangkan", "ur": "وہ کشادہ کرتا ہے", "bn": "তিনি প্রসারিত করেন", "fa": "می‌گستراند"}}, {"arabic": "وَيَبْصُۜطُ", "count": 1, "first": "2:245", "audio": "audio/8aaa9386fcf8c940eba1.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and he/it spreads", "bs": "i širi", "tr": "ve yayar", "fr": "et il étend", "id": "dan dia menyebarkan", "ur": "اور وہ پھیلاتا ہے", "bn": "এবং সে বিস্তৃত করে", "fa": "و گسترش می‌دهد"}}, {"arabic": "يَبْسُطُوٓا۟", "count": 1, "first": "5:11", "audio": "audio/28b51671d26b0b6e4e9f.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "they spread", "bs": "šire", "tr": "yayarlar", "fr": "qu'ils étendent", "id": "mereka menyebarkan", "ur": "وہ پھیلاتے ہیں", "bn": "তারা বিস্তার করে", "fa": "گسترش دهند"}}, {"arabic": "بَسَطتَ", "count": 1, "first": "5:28", "audio": "audio/ccf534334c33c6e0d690.m4a", "grammar": [{"tense": "past", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "you spread", "bs": "raširio si", "tr": "yaydın", "fr": "tu as étendu", "id": "kamu telah menyebarkan", "ur": "تم پھیلاتے ہو", "bn": "তুমি বিস্তার করেছ", "fa": "گستردی"}}, {"arabic": "تَبْسُطْهَا", "count": 1, "first": "17:29", "audio": "audio/532a1d5429f3eb0bd8fc.m4a", "grammar": [{"tense": "present", "pronoun": "