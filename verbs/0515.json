 "pronoun": "anti", "arabic": "جَاوِزِي", "plain": "جَاوِزِي", "quran": false, "notUsed": false, "spoken": "audio/28d4604d957ff0318997.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "جَاوِزَا", "plain": "جَاوِزَا", "quran": false, "notUsed": false, "spoken": "audio/c252371ae74fddd2f1c4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "جَاوِزُوا", "plain": "جَاوِزُوا", "quran": false, "notUsed": false, "spoken": "audio/d16f511dde28bec56496.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "جَاوِزْنَ", "plain": "جَاوِزْنَ", "quran": false, "notUsed": false, "spoken": "audio/f29ae8fca33d6178c62e.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "18:62", "tense": "past", "category": {"tense": "past", "pronoun": "huma", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2202.mp3", "translation": {"en": {"text": "And when they had gone further, he said unto his servant: Bring us our breakfast. Verily we have found fatigue in this our journey.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İki denizin birleştiği yeri geçtikleri zaman, Musa genç arkadaşına: \"Kuşluk yemeğimizi getir. Gerçekten biz bu yolculuğumuzda epey yorulduk\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر جبب وہاں سے گزر گئے موسیٰ نے خادم سے کہا ہمارا صبح کا کھانا لاؤ بیشک ہمیں اپنے اس سفر میں بڑی مشقت کا سامنا ہوا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka tatkala mereka berjalan lebih jauh, berkatalah Musa kepada muridnya: \"Bawalah kemari makanan kita; sesungguhnya kita telah merasa letih karena perjalanan kita ini\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "جَاوَزَا", "hit": true, "audio": "audio/aafe44b224896a2b0ca1.m4a", "gloss": {"bs": "njih dvojica su prošli dalje", "en": "they had gone further", "tr": "ikisi de ilerledi", "fr": "ils eurent dépassé", "id": "keduanya telah melewati lebih jauh", "ur": "وہ دونوں آگے نکل گئے تھے", "bn": "তারা দু'জন এগিয়ে গিয়েছিল", "fa": "آن دو فراتر رفته بودند"}}, {"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِفَتَىٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاتِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "غَدَآءَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَقِينَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "سَفَرِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "نَصَبًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَجَٰوَزْنَا", "count": 2, "first": "7:138", "audio": "audio/6f47e5f4edc8ef6d7cb3.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "and we brought across", "bs": "i preveli smo", "tr": "ve geçirdik", "fr": "et nous avons fait traverser", "id": "dan kami telah menyeberangkan", "ur": "اور ہم نے پار کیا", "bn": "এবং আমরা পার করালাম", "fa": "و عبور دادیم"}}, {"arabic": "جَاوَزَهُۥ", "count": 1, "first": "2:249", "audio": "audio/8f4c70335e70e5be4fe3.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "he/it crossed it", "bs": "prešao ju je", "tr": "onu geçti", "fr": "il l'a traversée", "id": "dia telah menyeberanginya", "ur": "اُس نے اسے پار کیا", "bn": "সে তা পার হলো", "fa": "از آن گذشت"}}, {"arabic": "جَاوَزَا", "count": 1, "first": "18:62", "audio": "audio/aafe44b224896a2b0ca1.m4a", "grammar": [{"tense": "past", "pronoun": "huma", "passive": false, "objects": []}], "gloss": {"bs": "njih dvojica su prošli dalje", "en": "they had gone further", "tr": "ikisi daha ileri gitmişti", "fr": "les deux sont allés plus loin", "id": "mereka berdua telah maju lebih jauh", "ur": "وہ آگے بڑھ گئے", "bn": "তারা দুজন অতিক্রম করেছিল", "fa": "آن دو فراتر رفتند"}}], "ayatFile": "ayat/0515.json", "ayatTranslations": {"en": "ayat/0515.en.json", "tr": "ayat/0515.tr.json", "ur": "ayat/0515.ur.json", "id": "ayat/0515.id.json"}, "sentences": [{"arabic": "جَاوَزَ الْقِطَارُ الْمَحَطَّةَ", "spoken": "audio/902006157e68ac0f3a9d.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Voz je prošao stanicu.", "en": "The train passed the station.", "bn": "ট্রেনটি স্টেশন পার হয়ে গেছে।", "fa": "قطار از ایستگاه گذشت.", "fr": "Le train a dépassé la gare.", "id": "Kereta itu melewati stasiun.", "tr": "Tren istasyonu geçti.", "ur": "ریل گاڑی اسٹیشن سے گزر گئی۔"}, "independentlyReviewed": true, "words": [{"arabic": "جَاوَزَ", "target": true, "translation": {"bs": "prošao je", "en": "passed", "bn": "পার হয়েছে", "fa": "گذر کرد", "fr": "est passé", "id": "dia melewati", "tr": "geçti", "ur": "گزرا"}}, {"arabic": "الْقِطَارُ", "target": false, "translation": {"bs": "voz", "en": "the train", "bn": "ট্রেনটি", "fa": "قطار", "fr": "le train", "id": "kereta itu", "tr": "tren", "ur": "ریل گاڑی"}}, {"arabic": "الْمَحَطَّةَ", "target": false, "translation": {"bs": "stanicu", "en": "the station", "bn": "স্টেশন", "fa": "ایستگاه", "fr": "la gare", "id": "stasiun itu", "tr": "istasyon", "ur": "اسٹیشن"}}]}, {"arabic": "يُجَاوِزُ الْعَدَّاءُ الْخَطَّ", "spoken": "audio/2149ab9dc75b038cc9fb.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Trkač prelazi liniju.", "en": "The runner passes the line.", "bn": "দৌড়বিদ লাইনটি পার হয়।", "fa": "دونده از خط عبور می‌کند.", "fr": "Le coureur franchit la ligne.", "id": "Pelari itu melewati garis itu.", "tr": "Koşucu çizgiyi geçer.", "ur": "دوڑنے والا لکیر پار کرتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يُجَاوِزُ", "target": true, "translation": {"bs": "prelazi", "en": "passes", "bn": "পার হয়", "fa": "می‌گذرد", "fr": "passe", "id": "dia melewati", "tr": "geçer", "ur": "گزرتا ہے"}}, {"arabic": "الْعَدَّاءُ", "target": false, "translation": {"bs": "trkač", "en": "the runner", "bn": "দৌড়বিদ", "fa": "دونده", "fr": "le coureur", "id": "pelari itu", "tr": "koşucu", "ur": "دوڑنے والا"}}, {"arabic": "الْخَطَّ", "target": false, "translation": {"bs": "liniju", "en": "the line", "bn": "রেখা", "fa": "خط", "fr": "la ligne", "id": "garis itu", "tr": "çizgi", "ur": "لکیر"}}]}, {"arabic": "أُجَاوِزُ الْقَرْيَةَ مَسَاءً", "spoken": "audio/aadf4a00b57cee310f94.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Navečer prolazim pored sela.", "en": "I pass the village in the evening.", "bn": "আমি সন্ধ্যায় গ্রামটি পার হই।", "fa": "عصرها از کنار روستا می‌گذرم.", "fr": "Je passe devant le village le soir.", "id": "Aku melewati desa itu pada sore hari.", "tr": "Akşamları köyün yanından geçerim.", "ur": "میں شام کو گاؤں سے گزرتا ہوں۔"}, "independentlyReviewed": true, "words": [{"arabic": "أُجَاوِزُ", "target": true, "translation": {"bs": "prolazim pored", "en": "pass", "bn": "পার হই", "fa": "می‌گذرم", "fr": "je passe devant", "id": "aku melewati", "tr": "geçerim", "ur": "گزرتا ہوں"}}, {"arabic": "الْقَرْيَةَ", "target": false, "translation": {"bs": "sela", "en": "the village", "bn": "গ্রাম", "fa": "روستا", "fr": "le village", "id": "desa itu", "tr": "köy", "ur": "گاؤں"}}, {"arabic": "مَسَاءً", "target": false, "translation": {"bs": "navečer", "en": "in the evening", "bn": "সন্ধ্যায়", "fa": "عصر", "fr": "le soir", "id": "pada sore hari", "tr": "akşamleyin", "ur": "شام کو"}}]}, {"arabic": "جَاوَزُوا الْجَبَلَ", "spoken": "audio/2328139ea28c1d5fdd12.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Prešli su planinu.", "en": "They passed the mountain.", "bn": "তারা পাহাড়টি পার হয়েছে।", "fa": "از کوه گذشتند.", "fr": "Ils ont traversé la montagne.", "id": "Mereka melewati gunung itu.", "tr": "Dağı aştılar.", "ur": "وہ پہاڑ سے آگے نکل گئے۔"}, "independentlyReviewed": true, "words": [{"arabic": "جَاوَزُوا", "target": true, "translation": {"bs": "prešli su", "en": "passed", "bn": "পার হয়েছে", "fa": "گذشتند", "fr": "ont traversé", "id": "mereka melewati", "tr": "geçtiler", "ur": "گزرے"}}, {"arabic": "الْجَبَلَ", "target": false, "translation": {"bs": "planinu", "en": "the mountain", "bn": "পাহাড়", "fa": "کوه", "fr": "la montagne", "id": "gunung itu", "tr": "dağ", "ur": "پہاڑ"}}]}, {"arabic": "جَاوِزْ هَذِهِ الْعَقَبَةَ", "spoken": "audio/8e72912c8f57c6591346.m4a", "tense": "imperative", "pronoun": "anta", "translation": {"bs": "Prevaziđi ovu prepreku.", "en": "Get past this obstacle.", "bn": "এই বাধাটি পার হয়ে যাও।", "fa": "از این مانع بگذر.", "fr": "Surmonte cet obstacle.", "id": "Lewatilah rintangan ini.", "tr": "Bu engeli aş.", "ur": "اس رکاوٹ کو پار کرو۔"}, "independentlyReviewed": true, "words": [{"arabic": "جَاوِزْ", "target": true, "translation": {"bs": "prevaziđi", "en": "get past", "bn": "পার হয়ে যাও", "fa": "بگذر", "fr": "dépasse", "id": "lewatilah", "tr": "aş", "ur": "گزر جاؤ"}}, {"arabic": "هَذِهِ", "target": false, "translation": {"bs": "ovu", "en": "this", "bn": "এই", "fa": "این", "fr": "ce", "id": "ini", "tr": "bu", "ur": "یہ"}}, {"arabic": "الْعَقَبَةَ", "target": false, "translation": {"bs": "prepreku", "en": "the obstacle", "bn": "বাধা", "fa": "مانع", "fr": "l'obstacle", "id": "rintangan itu", "tr": "engel", "ur": "رکاوٹ"}}]}]}