nna", "arabic": "أَنْسِينَ", "plain": "أَنْسِينَ", "quran": false, "notUsed": false, "spoken": "audio/99133e8042a58cfdb4f4.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "59:19", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5145.mp3", "translation": {"en": {"text": "And be not ye as those who forgot Allah, therefor He caused them to forget their souls. Such are the evil-doers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah'ı unutup da Allah'ın da kendilerini unutturduğu kimseler gibi olmayın onlar, yoldan çıkan kimselerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان جیسے نہ ہو جو اللہ کو بھول بیٹھے تو اللہ نے انہیں بلا میں ڈالا کہ اپنی جانیں یاد نہ رہیں وہی فاسق ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan janganlah kamu seperti orang-orang yang lupa kepada Allah, lalu Allah menjadikan mereka lupa kepada mereka sendiri. Mereka itulah orang-orang yang fasik.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَكُونُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "كَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَسُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَنسَىٰهُمْ", "hit": true, "audio": "audio/b49719c12039896e33c1.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hum"]}]}, {"text": "أَنفُسَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْفَٰسِقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:110", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2783.mp3", "translation": {"en": {"text": "But ye chose them for a laughing-stock until they caused you to forget remembrance of Me, while ye laughed at them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte siz onları alaya aldınız; sonunda bu davranışınız size beni yâd etmeyi unutturdu; çünkü siz onlara gülüyordunuz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو تم نے انہیں ٹھٹھا بنالیا یہاں تک کہ انہیں بنانے کے شغل میں میری یاد بھول گئے اور تم ان سے ہنسا کرتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Lalu kamu menjadikan mereka buah ejekan, sehingga (kesibukan) kamu mengejek mereka, menjadikan kamu lupa mengingat Aku, dan adalah kamu selalu mentertawakan mereka,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱتَّخَذْتُمُوهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "سِخْرِيًّا", "hit": false, "audio": null, "gloss": null}, {"text": "حَتَّىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنسَوْكُمْ", "hit": true, "audio": "audio/1f334410036c896c4191.m4a", "gloss": {"bs": "natjerali su vas da zaboravite", "en": "they made you (all) forget", "tr": "size unutturdular", "fr": "ils vous ont fait oublier", "id": "mereka membuat kalian lupa", "ur": "انہوں نے تم سب کو بھلا دیا", "bn": "তারা তোমাদের ভুলিয়ে দিয়েছে", "fa": "شما را به فراموشی انداختند"}}, {"text": "ذِكْرِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَكُنتُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَضْحَكُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "فَأَنسَىٰهُمْ", "count": 2, "first": "58:19", "audio": "audio/8494dff59a5c47a93cc5.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hum"]}]}, {"arabic": "نُ