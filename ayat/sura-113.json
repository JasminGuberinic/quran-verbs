{"ayat":[{"ref":"113:1","number":6226,"text":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","hits":[0,1,2]},{"ref":"113:2","number":6227,"text":"مِن شَرِّ مَا خَلَقَ","hits":[0,1,2,3]},{"ref":"113:3","number":6228,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","hits":[3]},{"ref":"113:4","number":6229,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","hits":[3,4]},{"ref":"113:5","number":6230,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","hits":[]}]}