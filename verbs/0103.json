ran": false, "notUsed": false, "spoken": "audio/e36dd6e346cbd943909e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِرْضَ", "plain": "اِرْضَ", "quran": false, "notUsed": false, "spoken": "audio/b0e53a4f6e942285e7a2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِرْضَيْ", "plain": "اِرْضَيْ", "quran": false, "notUsed": false, "spoken": "audio/7684c8d5915a8ed127a3.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِرْضَيَا", "plain": "اِرْضَيَا", "quran": false, "notUsed": false, "spoken": "audio/a63864bcbaa8ae52093c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِرْضَوْا", "plain": "اِرْضَوْا", "quran": false, "notUsed": false, "spoken": "audio/4c22ad799723e7983097.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِرْضَيْنَ", "plain": "اِرْضَيْنَ", "quran": false, "notUsed": false, "spoken": "audio/b3c218ef9cf3babdaa54.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "9:87", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1322.mp3", "translation": {"en": {"text": "They are content that they should be with the useless and their hearts are sealed, so that they apprehend not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, oturanlarla beraber oturmaktan hoşlandılar. Kalblerine mühür vuruldu. Bundan dolayı onlar anlayışsızdırlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "انہیں پسند آیا کہ پیچھے رہنے والی عورتوں کے ساتھ ہوجائیں اور ان کے دلوں پر مہُر کردی گئیں تو وہ کچھ نہیں سمجھتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka rela berada bersama orang-orang yang tidak berperang, dan hati mereka telah dikunci mati maka mereka tidak mengetahui (kebahagiaan beriman dan berjihad).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رَضُوا۟", "hit": true, "audio": "audio/a7cff995b7981037cbb1.m4a", "gloss": {"bs": "zadovoljili su se", "en": "they were satisfied", "tr": "razı oldular", "fr": "ils furent satisfaits", "id": "mereka rida", "ur": "وہ راضی ہو گئے", "bn": "তারা সন্তুষ্ট হয়েছে", "fa": "راضی شدند"}}, {"text": "بِأَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَكُونُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "مَعَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَوَالِفِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَطُبِعَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "قُلُوبِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَفْقَهُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "93:5", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6084.mp3", "translation": {"en": {"text": "And verily thy Lord will give unto thee so that thou wilt be content.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbın sana verecek ve sen hoşnut olacaksın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک قریب ہے کہ تمہارا رب تمہیں اتنا دے گا کہ تم راضی ہوجاؤ گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan kelak Tuhanmu pasti memberikan karunia-Nya kepadamu, lalu (hati) kamu menjadi puas.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَسَوْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُعْطِيكَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَرْضَىٰٓ", "hit": true, "audio": "audio/90350d425bdea25fbe39.m4a", "gloss": {"bs": "pa ćeš biti zadovoljan", "en": "and you will be satisfied", "tr": "ve hoşnut olacaksın", "fr": "et tu seras satisfait", "id": "dan kamu akan puas", "ur": "پھر تم راضی ہو جاؤ گے", "bn": "এবং তুমি সন্তুষ্ট হবে", "fa": "پس خشنود خواهی شد"}}]}, {"ref": "20:109", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2457.mp3", "translation": {"en": {"text": "On that day no intercession availeth save (that of) him unto whom the Beneficent hath given leave and whose word He accepteth.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O gün, Rahmân'ın kendisine izin verdiği ve sözünden hoşnud olduğu kimselerden başkasının şefaatı fayda vermez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس دن کسی کی شفاعت کام نہ دے گی، مگر اس کی جسے رحمن نے اذن دے دیا ہے اور اس کی بات پسند فرمائی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Pada hari itu tidak berguna syafa'at, kecuali (syafa'at) orang yang Allah Maha Pemurah telah memberi izin kepadanya, dan Dia telah meridhai perkataannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَوْمَئِذٍ", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تَنفَعُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلشَّفَٰعَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَذِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّحْمَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَرَضِىَ", "hit": true, "audio": "audio/f655685f73e06e4b1993.m4a", "gloss": {"en": "and he/it was pleased", "bs": "i bio je zadovoljan", "tr": "ve razı oldu", "fr": "et il était content", "id": "dan dia telah merasa senang", "ur": "اور وہ راضی ہوا", "bn": "এবং সে সন্তুষ্ট ছিল", "fa": "و خشنود بود"}}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "22:59", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2654.mp3", "translation": {"en": {"text": "Assuredly He will cause them to enter by an entry that they will love. Lo! Allah verily is Knower, Indulgent.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah onları hoşnud olacakları bir yere (cennete) elbette koyacaktır. Şüphesiz Allah Alîmdir (herşeyi bilir) Halîmdir, (Kullarına yumuşak davranır.).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ضرور انہیں ایسی جگہ لے جائے گا جسے وہ پسند کریں گے اور بیشک اللہ علم اور حلم والا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Allah akan memasukkan mereka ke dalam suatu tempat (surga) yang mereka menyukainya. Dan sesungguhnya Allah Maha mengetahui lagi Maha Penyantun.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَيُدْخِلَنَّهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّدْخَلًا", "hit": false, "audio": null, "gloss": null}, {"text": "يَرْضَوْنَهُۥ", "hit": true, "audio": "audio/4493e568a058e11f4569.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["huwa"], "mood": "indicative"}]}, {"text": "وَإِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلِيمٌ", "hit": false, "audio": null, "gloss": null}, {"text": "حَلِيمٌ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"ara