"ayat": [{"ref": "35:16", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3676.mp3", "translation": {"en": {"text": "If He will, He can be rid of you and bring (instead of you) some new creation.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer O dilerse sizi yok eder ve yerinize yeni bir halk getirir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ چاہے تو تمہیں لے جائے اور نئی مخلوق لے آئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Jika Dia menghendaki, niscaya Dia memusnahkan kamu dan mendatangkan makhluk yang baru (untuk menggantikan kamu).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "يَشَأْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُذْهِبْكُمْ", "hit": true, "audio": "audio/df821b6297d5e788e51a.m4a", "gloss": {"bs": "uklonio bi vas", "en": "He would remove you", "tr": "sizi kaldırırdı", "fr": "Il vous ferait disparaître", "id": "Dia akan menyingkirkanmu", "ur": "وہ تمہیں لے جائے", "bn": "তিনি তোমাদের সরিয়ে দিতে পারেন", "fa": "شما را می‌برد"}}, {"text": "وَيَأْتِ", "hit": false, "audio": null, "gloss": null}, {"text": "بِخَلْقٍ", "hit": false, "audio": null, "gloss": null}, {"text": "جَدِيدٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "35:34", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3694.mp3", "translation": {"en": {"text": "And they say: Praise be to Allah Who hath put grief away from us. Lo! Our Lord is Forgiving, Bountiful,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar orada şöyle derler: \"Hamd olsun Allah'a, bizden o üzüntüyü giderdi. Gerçekten Rabbimiz çok bağışlayıcı ve şükrün karşılığını vericidir.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور کہیں گے سب خوبیاں اللہ کو جس نے ہمارا غم دور کیا بیشک ہمارا رب بخشنے والا قدر فرمانے والا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka berkata: \"Segala puji bagi Allah yang telah menghilangkan duka cita dari kami. Sesungguhnya Tuhan kami benar-benar Maha Pengampum lagi Maha Mensyukuri.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَمْدُ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَذْهَبَ", "hit": true, "audio": "audio/308adf2f928e6482a079.m4a", "gloss": {"bs": "je uklonio", "en": "removed", "tr": "kaldırdı", "fr": "a ôté", "id": "menghilangkan", "ur": "اس نے دور کر دیا", "bn": "দূর করলেন", "fa": "برد"}}, {"text": "عَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَزَنَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَغَفُورٌ", "hit": false, "audio": null, "gloss": null}, {"text": "شَكُورٌ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُذْهِبْكُمْ", "count": 4, "first": "4:133", "audio": "audio/b400c4f9a89e96c97512.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "jussive"}], "gloss": {"bs": "uklonio bi vas", "en": "He would remove you", "tr": "sizi kaldırırdı", "fr": "Il vous ferait disparaître", "id": "Dia akan menyingkirkanmu", "ur": "وہ تمہیں لے جائے", "bn": "তিনি তোমাদের সরিয়ে দিতে পারেন", "fa": "شما را می‌برد"}}, {"arabic": "وَيُذْهِبَ", "count": 1, "first": "8:11", "audio": "audio/76fd4e7993393ca04fd5.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": []