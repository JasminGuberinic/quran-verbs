{"rank": 81, "root": "حسب", "form": 1, "lemma": "حَسِبَ", "count": 44, "ayahCount": 43, "share": 0.23, "meaning": {"bs": "misliti, smatrati", "en": "to think, to reckon", "tr": "sanmak, zannetmek", "fr": "penser, estimer", "id": "mengira, menduga", "ur": "گمان کرنا، سمجھنا", "bn": "মনে করা, গণ্য করা", "fa": "گمان کردن، پنداشتن"}, "lemmaSpoken": "audio/da6e81abbf3027f7b44e.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "حَسِبَ", "plain": "حَسِبَ", "quran": true, "notUsed": false, "spoken": "audio/da6e81abbf3027f7b44e.m4a", "recited": "audio/7744c3bd9756e3c4c7a9.m4a", "recitedText": "حَسِبَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَحْسَبُ", "plain": "يَحْسَبُ", "quran": true, "notUsed": false, "spoken": "audio/442eeb1ce22f76757317.m4a", "recited": "audio/cd636bf693c3973020b2.m4a", "recitedText": "يَحْسَبُ"}], "nouns": {"participle": {"lemma": "حاسِب", "count": 2, "spoken": "audio/d48907d2b66f0cbad9fa.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "حَسِبْتُ", "plain": "حَسِبْتُ", "quran": false, "notUsed": false, "spoken": "audio/98271e4d9d0adcd17840.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "حَسِبْنَا", "plain": "حَسِبْنَا", "quran": false, "notUsed": false, "spoken": "audio/24a5847dcba39892d3ea.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "حَسِبْتَ", "plain": "حَسِبْتَ", "quran": true, "notUsed": false, "spoken": "audio/f48561e1d60a5abc1ff7.m4a", "recited": "audio/2d929351348c776fa3f4.m4a", "recitedText": "حَسِبْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "حَسِبْتِ", "plain": "حَسِبْتِ", "quran": false, "notUsed": false, "spoken": "audio/d081669091104ad8b91f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "حَسِبْتُمَا", "plain": "حَسِبْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/24a8c5ce203821b9c1d9.m4a", "recited": null, "recitedText": null}, {"tense"