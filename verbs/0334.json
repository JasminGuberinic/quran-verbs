: "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4297.mp3", "translation": {"en": {"text": "And He it is Who accepteth repentance from His bondmen, and pardoneth the evil deeds, and knoweth what ye do,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kullarının tevbesini kabul eden, kötülükleri affeden ve sizin yaptıklarınızı bilen O'dur.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہی ہے جو اپنے بندوں کی توبہ قبول فرماتا اور گناہوں سے درگزر فرماتا ہے اور جانتا ہے جو کچھ تم کرتے ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Dialah yang menerima taubat dari hamba-hamba-Nya dan memaafkan kesalahan-kesalahan dan mengetahui apa yang kamu kerjakan,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "يَقْبَلُ", "hit": true, "audio": "audio/9469d5ae5072488d2a17.m4a", "gloss": {"bs": "prima", "en": "accepts", "tr": "kabul eder", "fr": "accepte", "id": "menerima", "ur": "قبول کرتا ہے", "bn": "কবুল করেন", "fa": "می‌پذیرد"}}, {"text": "ٱلتَّوْبَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عِبَادِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَعْفُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "عَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّيِّـَٔاتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَعْلَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَفْعَلُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُقْبَلُ", "count": 2, "first": "2:48", "audio": "audio/cd4a7ba4f247792c4ea3.m4a", "grammar": [{"tense": "present