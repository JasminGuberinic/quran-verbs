 "ana", "translation": {"bs": "Ne posjedujem auto.", "en": "I do not own a car.", "bn": "আমার কোনো গাড়ি নেই।", "fa": "ماشین ندارم.", "fr": "Je ne possède pas de voiture.", "id": "Aku tidak punya mobil.", "tr": "Arabam yok.", "ur": "میرے پاس گاڑی نہیں ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "أَمْلِكُ", "target": true, "translation": {"bs": "posjedujem", "en": "I possess", "bn": "আমার আছে", "fa": "دارم", "fr": "je possède", "id": "aku memiliki", "tr": "sahibim", "ur": "میں رکھتا ہوں"}}, {"arabic": "سَيَّارَةً", "target": false, "translation": {"bs": "auto", "en": "a car", "bn": "একটি গাড়ি", "fa": "ماشینی", "fr": "une voiture", "id": "sebuah mobil", "tr": "bir araba", "ur": "ایک گاڑی"}}]}, {"arabic": "مَلَكَتْ جَدَّتِي بَيْتًا جَمِيلًا", "spoken": "audio/1b1ed9fc1754b9151659.m4a", "tense": "past", "pronoun": "hiya", "translation": {"bs": "Moja nana je posjedovala lijepu kuću.", "en": "My grandmother owned a beautiful house.", "bn": "আমার দাদির একটি সুন্দর বাড়ি ছিল।", "fa": "مادربزرگم خانه زیبایی داشت.", "fr": "Ma grand-mère possédait une belle maison.", "id": "Nenekku dulu memiliki rumah yang indah.", "tr": "Büyükannemin güzel bir evi vardı.", "ur": "میری دادی کا ایک خوبصورت گھر تھا۔"}, "independentlyReviewed": true, "words": [{"arabic": "مَلَكَتْ", "target": true, "translation": {"bs": "posjedovala je", "en": "had", "bn": "ছিল", "fa": "داشت", "fr": "possédait", "id": "memiliki", "tr": "sahipti", "ur": "اس کے پاس تھی"}}, {"arabic": "جَدَّتِي", "target": false, "translation": {"bs": "moja nana", "en": "my grandmother", "bn": "আমার দাদি", "fa": "مادربزرگم", "fr": "ma grand-mère", "id": "nenekku", "tr": "büyükannem", "ur": "میری دادی"}}, {"arabic": "بَيْتًا", "target": false, "translation": {"bs": "kuću", "en": "a house", "bn": "একটি বাড়ি", "fa": "یک خانه", "fr": "une maison", "id": "sebua