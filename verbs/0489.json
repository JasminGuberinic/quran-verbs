: "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3773.mp3", "translation": {"en": {"text": "He whom we bring unto old age, We reverse him in creation (making him go back to weakness after strength). Have ye then no sense?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bununla beraber kimin ömrünü uzatıyorsak, yaratılışta onu (güç ve kuvvetini alarak) tersine çeviriyoruz. Hâlâ akıllanmayacaklar mı?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جسے ہم بڑی عمر کا کریں اسے پیدائش میں الٹا پھیریں تو کیا سمجھے نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan barangsiapa yang Kami panjangkan umurnya niscaya Kami kembalikan dia kepada kejadian(nya). Maka apakah mereka tidak memikirkan?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "نُّعَمِّرْهُ", "hit": true, "audio": "audio/8cbc1b2184aa812e0540.m4a", "gloss": {"bs": "mu dug život podarimo", "en": "We grant him long life", "tr": "ona uzun ömür veririz", "fr": "Nous lui accordons une longue vie", "id": "Kami panjangkan umurnya", "ur": "ہم اسے لمبی عمر دیتے ہیں", "bn": "আমি তাকে দীর্ঘ জীবন দিই", "fa": "ما به او عمر دراز می‌دهیم"}}, {"text": "نُنَكِّسْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَلْقِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَفَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْقِلُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُعَمَّرُ", "count": 2, "first": "2:96", "audio": "audio/7844a3df737391c9965c.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it is granted a long life", "bs": "biva mu dat dug život", "tr": "uzun ömür verilir", "fr": "il lui est accordé une longue vie", "id": "dia diberi umur panjang", "ur": "وہ لمبی عمر دیا جاتا ہے", "bn": "তাকে দীর্ঘায়ু দেওয়া হয়", "fa": "عمر طولانی داده می‌شود"}}, {"arabic": "يُعَمَّرَ", "count": 1, "first": "2:96", "audio": "audio/b1251ecf272fad67197b.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "he/it is granted a long life", "bs": "biva mu dat dug život", "tr": "uzun ömür verilir", "fr": "qu'il lui soit accordé une longue vie", "id": "dia diberi umur panjang", "ur": "وہ لمبی عمر دیا جاتا ہے", "bn": "তাকে দীর্ঘায়ু দেওয়া হয়", "fa": "عمر طولانی داده شود"}}, {"arabic": "نُعَمِّرْكُم", "count": 1, "first": "35:37", "audio": "audio/49ea0deb2a76c2441941.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["antum"], "mood": "jussive"}], "gloss": {"en": "we grant you (all) a long life", "bs": "dajemo vam dug život", "tr": "size uzun ömür veririz", "fr": "nous vous accordons une longue vie", "id": "kami memberi kalian umur panjang", "ur": "ہم تم سب کو لمبی عمر دیتے ہیں", "bn": "আমরা তোমাদের দীর্ঘায়ু দিই", "fa": "به شما عمر طولانی می‌دهیم"}}, {"arabic": "نُّعَمِّرْهُ", "count": 1, "first": "36:68", "audio": "audio/8cbc1b2184aa812e0540.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["huwa"], "mood": "jussive"}], "gloss": {"bs": "mu dug život podarimo", "en": "We grant him long life", "tr": "ona uzun ömür veririz", "fr": "Nous lui accordons une longue vie", "id": "Kami panjangkan umurnya", "ur": "ہم اسے لمبی عمر دیتے ہیں", "bn": "আমি তাকে দীর্ঘ জীবন দিই", "fa": "ما به او عمر دراز می‌دهیم"}}], "ayatFile": "ayat/0489.json", "ayatTranslations": {"en": "ayat/0489.en.json", "tr": "ayat/0489.tr.json", "ur": "ayat/0489.ur.json", "id": "ayat/0489.id.json"}, "sentences": [{"arabic": "عَمَّرَ الرَّجُلُ بَيْتَ أَبِيهِ", "spoken": "audio/a4675cdb7a5443f6b40c.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Čovjek je obnovio očevu kuću.", "en": "The man renovated his father's house.", "bn": "লোকটি তার বাবার বাড়ি সংস্কার করল।", "fa": "مرد خانه‌ی پدرش را بازسازی کرد.", "fr": "L'homme a rénové la maison de son père.", "id": "Laki-laki itu merenovasi rumah ayahnya.", "tr": "Adam babasının evini onardı.", "ur": "آدمی نے اپنے والد کا گھر تعمیر کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "عَمَّرَ", "target": true, "translation": {"bs": "obnovio je", "en": "renovated", "bn": "সে সংস্কার করল", "fa": "بازسازی کرد", "fr": "a rénové", "id": "merenovasi", "tr": "onardı", "ur": "اس نے تعمیر کی"}}, {"arabic": "الرَّجُلُ", "target": false, "translation": {"bs": "čovjek", "en": "the man", "bn": "লোকটি", "fa": "مرد", "fr": "l'homme", "id": "laki-laki itu", "tr": "adam", "ur": "آدمی"}}, {"arabic": "بَيْتَ", "target": false, "translation": {"bs": "kuću", "en": "house", "bn": "বাড়ি", "fa": "خانه", "fr": "maison", "id": "rumah", "tr": "ev", "ur": "گھر"}}, {"arabic": "أَبِيهِ", "target": false, "translation": {"bs": "očevu", "en": "his father", "bn": "তার বাবা", "fa": "پدرش", "fr": "son père", "id": "ayahnya", "tr": "babası", "ur": "اس کے والد"}}]}, {"arabic": "يُعَمِّرُ الْعُمَّالُ الْقَرْيَةَ", "spoken": "audio/9bc5e57b3bd9bc753ac3.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Radnici obnavljaju selo.", "en": "The workers are renovating the village.", "bn": "শ্রমিকরা গ্রামটি সংস্কার করছে।", "fa": "کارگران روستا را بازسازی می‌کنند.", "fr": "Les ouvriers rénovent le village.", "id": "Para pekerja merenovasi desa itu.", "tr": "İşçiler köyü onarıyor.", "ur": "مزدور گاؤں کی تعمیر کر رہے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "يُعَمِّرُ", "target": true, "translation": {"bs": "obnavljaju", "en": "renovate", "bn": "সে সংস্কার করে", "fa": "بازسازی می‌کند", "fr": "rénove", "id": "merenovasi", "tr": "onarırlar", "ur": "وہ تعمیر کرتا ہے"}}, {"arabic": "الْعُمَّالُ", "target": false, "translation": {"bs": "radnici