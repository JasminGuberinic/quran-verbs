": "Anne çocuklarının mutluluğu için çabalar.", "ur": "ماں اپنے بچوں کی خوشی کے لیے کوشش کرتی ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "الْأُمُّ", "target": false, "translation": {"bs": "majka", "en": "the mother", "bn": "মা", "fa": "مادر", "fr": "la mère", "id": "ibu itu", "tr": "anne", "ur": "ماں"}}, {"arabic": "تَسْعَى", "target": true, "translation": {"bs": "se trudi", "en": "strives", "bn": "চেষ্টা করে", "fa": "می‌کوشد", "fr": "s'efforce", "id": "berusaha", "tr": "çabalar", "ur": "وہ کوشش کرتی ہے"}}, {"arabic": "لِسَعَادَةِ", "target": false, "translation": {"bs": "za sreću", "en": "for the happiness", "bn": "সুখের জন্য", "fa": "برای شادی", "fr": "pour le bonheur", "id": "untuk kebahagiaan", "tr": "mutluluğu için", "ur": "خوشی کے لیے"}}, {"arabic": "أَوْلَادِهَا", "target": false, "translation": {"bs": "svoje djece", "en": "of her children", "bn": "তার সন্তানদের", "fa": "فرزندانش", "fr": "de ses enfants", "id": "anak-anaknya", "tr": "çocuklarının", "ur": "اپنے بچوں کی"}}]}]}