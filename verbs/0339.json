ent", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4787.mp3", "translation": {"en": {"text": "Nor doth he speak of (his own) desire.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O, hevâdan (arzularına göre) konuşmaz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ کوئی بات اپنی خواہش سے نہیں کرتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan tiadalah yang diucapkannya itu (Al-Quran) menurut kemauan hawa nafsunya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَنطِقُ", "hit": true, "audio": "audio/0bbd3777091af3559b92.m4a", "gloss": {"en": "he/it speaks", "bs": "govori", "tr": "konuşur", "fr": "il parle", "id": "dia berbicara", "ur": "وہ بولتا ہے", "bn": "সে বলে", "fa": "سخن می‌گوید"}}, {"text": "عَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْهَوَىٰٓ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:92", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3880.mp3", "translation": {"en": {"text": "What aileth you that ye speak not?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Cevap vermediklerini görünce de): \"Neyiniz var da konuşmuyorsunuz?\" (dedi).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تمہیں کیا ہوا کہ نہیں بولتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kenapa kamu tidak menjawab?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَنطِقُونَ", "hit": true, "audio": "audio/c7f98271869c020b64fd.m4a", "gloss": {"bs":