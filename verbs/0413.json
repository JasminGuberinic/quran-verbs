e", "id": "menyusui", "tr": "emziririm", "ur": "دودھ پلاتی ہوں"}}, {"arabic": "طِفْلِي", "target": false, "translation": {"bs": "svoje dijete", "en": "my child", "bn": "আমার শিশু", "fa": "کودکم", "fr": "mon enfant", "id": "anakku", "tr": "çocuğum", "ur": "میرا بچہ"}}, {"arabic": "كُلَّ", "target": false, "translation": {"bs": "svako", "en": "every", "bn": "প্রতিটি", "fa": "هر", "fr": "chaque", "id": "setiap", "tr": "her", "ur": "ہر"}}, {"arabic": "صَبَاحٍ", "target": false, "translation": {"bs": "jutro", "en": "morning", "bn": "সকাল", "fa": "صبح", "fr": "le matin", "id": "pagi", "tr": "sabah", "ur": "صبح"}}]}, {"arabic": "أَرْضَعَتِ الْأُمُّ طِفْلَهَا", "spoken": "audio/8fd2ce1f504ad1c5eb91.m4a", "tense": "past", "pronoun": "hiya", "translation": {"bs": "Majka je podojila svoje dijete.", "en": "The mother breast-fed her child.", "bn": "মা তার শিশুকে দুধ পান করাল।", "fa": "مادر به کودکش شیر داد.", "fr": "La mère a allaité son enfant.", "id": "Sang ibu menyusui anaknya.", "tr": "Anne çocuğunu emzirdi.", "ur": "ماں نے اپنے بچے کو دودھ پلایا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَرْضَعَتِ", "target": true, "translation": {"bs": "podojila je", "en": "breast-fed", "bn": "দুধ পান করাল", "fa": "شیر داد", "fr": "a allaité", "id": "menyusui", "tr": "emzirdi", "ur": "اس نے دودھ پلایا"}}, {"arabic": "الْأُمُّ", "target": false, "translation": {"bs": "majka", "en": "the mother", "bn": "মা", "fa": "مادر", "fr": "la mère", "id": "ibu itu", "tr": "anne", "ur": "ماں"}}, {"arabic": "طِفْلَهَا", "target": false, "translation": {"bs": "svoje dijete", "en": "her child", "bn": "তার শিশু", "fa": "کودکش", "fr": "son enfant", "id": "anaknya", "tr": "çocuğu", "ur": "اس کا بچہ"}}]}, {"arabic": "تُرْضِعُ الْمَرْأَةُ ابْنَهَا", "spoken": "audio/f4d3cb20021ab29eaf7e.m4a", "tense": "present", "pronoun": "hiya", "translation": {"bs": "Žena doji svog sina.", "en": "The woman breast-feeds her son.", "bn": "নারী তার ছেলেকে দুধ পান করায়।", "fa": "زن به پسرش شیر می‌دهد.", "fr": "La