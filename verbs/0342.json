 null}], "ayat": [{"ref": "89:16", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6009.mp3", "translation": {"en": {"text": "But whenever He trieth him by straitening his means of life, he saith: My Lord despiseth me.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ama her ne zaman da sınayıp rızkını daraltırsa, o vakit de, \"Rabbim beni zillete düşürdü.\" der.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر آزمائے اور اس کا رزق اس پر تنگ کرے، تو کہتا ہے میرے رب نے مجھے خوار کیا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Adapun bila Tuhannya mengujinya lalu membatasi rezekinya maka dia berkata: \"Tuhanku menghinakanku\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَمَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱبْتَلَىٰهُ", "hit": true, "audio": "audio/25c43bc12a9864c9eddd.m4a", "gloss": {"bs": "iskuša ga", "en": "He tries him", "tr": "onu dener", "fr": "Il l'éprouve", "id": "Dia mengujinya", "ur": "وہ اسے آزماتا ہے", "bn": "তিনি তাকে পরীক্ষা করেন", "fa": "او را می‌آزماید"}}, {"text": "فَقَدَرَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "رِزْقَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فَيَقُولُ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَهَٰنَنِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "76:2", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5593.mp3", "translation": {"en": {"text": "Lo! We create man from a drop of thickened fluid to test him; so We make him hearing, knowing.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Doğrusu biz insanı, imtihan etmek için karışık bir nutfeden (erkek ve kadın sularından) yarattık da onu işitici, görücü yaptık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک ہم نے آدمی کو کیا ملی ہوئی منی سے کہ وہ اسے جانچیں تو اسے سنتا دیکھتا کردیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Kami telah menciptakan manusia dari setetes mani yang bercampur yang Kami hendak mengujinya (dengan perintah dan larangan), karena itu Kami jadikan dia mendengar dan melihat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْإِنسَٰنَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "نُّطْفَةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْشَاجٍ", "hit": false, "audio": null, "gloss": null}, {"text": "نَّبْتَلِيهِ", "hit": true, "audio": "audio/f29b48fed784a94af0dd.m4a", "gloss": {"bs": "iskušavamo ga", "en": "We test him", "tr": "onu deneriz", "fr": "Nous l'éprouvons", "id": "Kami mengujinya", "ur": "ہم اسے آزماتے ہیں", "bn": "আমরা তাকে পরীক্ষা করি", "fa": "او را می‌آزماییم"}}, {"text": "فَجَعَلْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "سَمِيعًۢا", "hit": false, "audio": null, "gloss": null}, {"text": "بَصِيرًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ٱبْتَلَىٰهُ", "count": 2, "first": "89:15", "audio": "audio/20428425cc141fafdfd7.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["huwa"]}], "gloss": {"bs": "iskuša ga", "en": "He tries him", "tr": "onu dener", "fr": "Il l'éprouve", "id": "Dia mengujinya", "ur": "وہ اسے آزماتا ہے", "bn": "তিনি তাকে পরীক্ষা করেন", "fa": "او را می‌آزماید"}}, {"arabic": "ٱبْتَلَىٰٓ", "count": 1, "first": "2:124", "audio": "audio/03b069a70f28343be753.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it tested", "bs": "iskušao je", "tr": "imtihan etti", "fr": "il a éprouvé", "id": "dia telah menguji", "ur": "اُس نے آزمایا", "bn": "সে পরীক্ষা করেছে", "fa": "آزمود"}}, {"arabic": "لِيَبْتَلِيَكُمْ", "count": 1, "first": "3:152", "audio": "audio/f035134e7e4914c5615b.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "subjunctive"}], "gloss": {"en": "so that he/it may test you (all)", "bs": "da vas iskuša", "tr": "sizi imtihan etsin diye", "fr": "qu'il vous éprouve", "id": "agar dia menguji kalian", "ur": "تاکہ وہ تم سب کو آزمائے", "bn": "যাতে সে তোমাদের পরীক্ষা করে", "fa": "تا شما را بیازماید"}}, {"arabic": "وَلِيَبْتَلِىَ", "count": 1, "first": "3:154", "audio": "audio/ad10a827222f4f3e8aea.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "and so that he/it may test", "bs": "i da iskuša", "tr": "ve imtihan etsin diye", "fr": "et qu'il éprouve", "id": "dan agar dia menguji", "ur": "اور تاکہ وہ آزمائے", "bn": "এবং যাতে সে পরীক্ষা করে", "fa": "و تا بیازماید"}}, {"arabic": "وَٱبْتَلُوا۟", "count": 1, "first": "4:6", "audio": "audio/c809f74eea69083564ed.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) test!", "bs": "i iskušajte!", "tr": "ve imtihan et!", "fr": "et éprouvez !", "id": "dan ujilah kalian!", "ur": "اور آزماؤ!", "bn": "এবং পরীক্ষা কর!", "fa": "و بیازمایید!"}}, {"arabic": "ٱبْتُلِىَ", "count": 1, "first": "33:11", "audio": "audio/70259070763525cbf052.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "he/it was tested", "bs": "iskušan je", "tr": "imtihan edildi", "fr": "il a été éprouvé", "id": "dia telah diuji", "ur": "اسے آزمایا گیا", "bn": "তাকে পরীক্ষা করা হয়েছে", "fa": "آزموده شد"}}, {"arabic": "نَّبْتَلِيهِ", "count": 1, "first": "76:2", "audio": "audio/f29b48fed784a94af0dd.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["huwa"], "mood": "indicative"}], "gloss": {"bs": "iskušavamo ga", "en": "We test him", "tr": "onu deneriz", "fr": "Nous l'éprouvons", "id": "Kami mengujinya", "ur": "ہم اسے آزماتے ہیں", "bn": "আমরা তাকে পরীক্ষা করি", "fa": "او را می‌آزماییم"}}], "ayatFile": "ayat/0342.json", "ayatTranslations": {"en": "ayat/0342.en.json", "tr": "ayat/0342.tr.json", "ur": "ayat/0342.ur.json", "id": "ayat/0342.id.json"}, "sentences": []}