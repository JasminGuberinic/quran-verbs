", "pronoun": "antum", "passive": false, "objects": ["nahnu"], "mood": "indicative"}], "gloss": {"en": "do you (all) argue with us?", "bs": "zar se prepirete s nama?", "tr": "bizimle mi tartışıyorsunuz?", "fr": "vous disputez-vous avec nous ?", "id": "apakah kalian berdebat dengan kami?", "ur": "کیا تم ہم سے بحث کرتے ہو؟", "bn": "তোমরা কি আমাদের সাথে তর্ক কর?", "fa": "آیا با ما مجادله می‌کنید؟"}}, {"arabic": "حَآجَّ", "count": 1, "first": "2:258", "audio": "audio/b4119bc87ae6472ea230.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it argued", "bs": "prepirao se", "tr": "tartıştı", "fr": "il s'est disputé", "id": "dia berdebat", "ur": "اُس نے بحث کی", "bn": "সে তর্ক করল", "fa": "مجادله کرد"}}, {"arabic": "حَآجُّوكَ", "count": 1, "first": "3:20", "audio": "audio/2eb4f06d52be15ce783c.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": ["anta"]}], "gloss": {"en": "they argued with you", "bs": "prepirali su se s tobom", "tr": "seninle tartıştılar", "fr": "ils se sont disputés avec toi", "id": "mereka telah berdebat denganmu", "ur": "انہوں نے تم سے بحث کی", "bn": "তারা তোমার সাথে তর্ক করেছে", "fa": "با تو مجادله کردند"}}, {"arabic": "حَآجَّكَ", "count": 1, "first": "3:61", "audio": "audio/7d4e312529b037565fef.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["anta"]}], "gloss": {"en": "he/it argued with you", "bs": "prepirao se s tobom", "tr": "seninle tartıştı", "fr": "il s'est disputé avec toi", "id": "dia telah berdebat denganmu", "ur": "اُس نے تم سے بحث کی", "bn": "সে তোমার সাথে তর্ক করেছে", "fa": "با تو مجادله کرد"}}, {"arabic": "حَٰجَجْتُمْ", "count": 1, "first": "3:66", "audio": "audio/dc174bd0acf946d4d253.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) argued", "bs": "prepirali ste se", "tr": "tartıştınız", "fr": "vous vous êtes disputés", "id": "kalian telah berdeba