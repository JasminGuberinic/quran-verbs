s": [{"arabic": "تُؤْثِرُونَ", "target": true, "translation": {"bs": "više volite", "en": "you (all) prefer", "bn": "তোমরা সবাই অগ্রাধিকার দাও", "fa": "شما (همه) ترجیح می‌دهید", "fr": "vous préférez", "id": "kalian lebih memilih", "tr": "tercih edersiniz", "ur": "تم سب ترجیح دیتے ہو"}}, {"arabic": "الْبَيْتَ", "target": false, "translation": {"bs": "kuću", "en": "the house", "bn": "বাড়ি", "fa": "خانه", "fr": "la maison", "id": "rumah itu", "tr": "ev", "ur": "گھر"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "nego", "en": "to", "bn": "প্রতি", "fa": "به", "fr": "à", "id": "untuk", "tr": "-mek için", "ur": "کو"}}, {"arabic": "السَّفَرِ", "target": false, "translation": {"bs": "putovanje", "en": "the travel", "bn": "ভ্রমণ", "fa": "سفر", "fr": "le voyage", "id": "bepergian", "tr": "seyahat", "ur": "سفر"}}]}]}