pronoun": "anti", "arabic": "اُنْفُخِي", "plain": "اُنْفُخِي", "quran": false, "notUsed": false, "spoken": "audio/b03b02489a40d4cba06f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُنْفُخَا", "plain": "اُنْفُخَا", "quran": false, "notUsed": false, "spoken": "audio/2b5645f5a42182108b6c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱنفُخُوا۟", "plain": "اُنْفُخُوا", "quran": true, "notUsed": false, "spoken": "audio/24e777a5bf0f92a68675.m4a", "recited": "audio/7497097404534fddd23c.m4a", "recitedText": "ٱنفُخُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُنْفُخْنَ", "plain": "اُنْفُخْنَ", "quran": false, "notUsed": false, "spoken": "audio/7b966e3f63ff612e1386.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "15:29", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1831.mp3", "translation": {"en": {"text": "So, when I have made him and have breathed into him of My Spirit, do ye fall down, prostrating yourselves unto him.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ben, onun yaratılışını tamamladığım ve ona ruhumdan üflediğim zaman, siz hemen onun için secdeye kapanın.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو جب میں اسے ٹھیک کرلوں اور اور میں اپنی طرف کی خاص معز ز ر وح پھونک دوں تو اس کے لیے سجدے میں گر پڑنا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka apabila Aku telah menyempurnakan kejadiannya, dan telah meniup kan kedalamnya ruh (ciptaan)-Ku, maka tunduklah kamu kepadanya dengan bersujud.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "سَوَّيْتُهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَفَخْتُ", "hit": true, "audio": "audio/ca2107dfd822bae5bef2.m4a", "gloss": {"bs": "i udahnem", "en": "and I have breathed", "tr": "ve üflerim", "fr": "et j'ai insufflé", "id": "dan Aku telah meniupkan", "ur": "اور میں پھونک دوں", "bn": "এবং আমি ফুঁ দিয়েছি", "fa": "و دمیدم"}}, {"text": "فِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "رُّوحِى", "hit": false, "audio": null, "gloss": null}, {"text": "فَقَعُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "سَٰجِدِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:91", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2574.mp3", "translation": {"en": {"text": "And she who was chaste, therefor We breathed into her (something) of Our Spirit and made her and her son a token for (all) peoples.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Irzını koruyan Meryem'e ruhumuzdan üflemiş, onu ve oğlunu, âlemler için bir mucize kılmıştık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اس عورت کو اس نے اپنی پارسائی نگاہ رکھی تو ہم نے اس میں اپنی روح پھونکی اور اسے اور اس کے بیٹے کو سارے جہاں کے لیے نشانی بنایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan (ingatlah kisah) Maryam yang telah memelihara kehormatannya, lalu Kami tiupkan ke dalam (tubuh)nya ruh dari Kami dan Kami jadikan dia dan anaknya tanda (kekuasaan Allah) yang besar bagi semesta alam.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّتِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَحْصَنَتْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَرْجَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَنَفَخْنَا", "hit": true, "audio": "audio/9861e3d7edee42966715.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}]}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "رُّوحِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَجَعَلْنَٰهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱبْنَهَآ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَةً", "hit": false, "audio": null, "gloss": null}, {"text": "لِّلْعَٰلَمِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُنفَخُ", "count": 4, "first": "6:73", "audio": "audio/b7474ad2ef20b6e0ccd7.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "it is blown", "bs": "puše se", "tr": "üflenir", "fr": "il est soufflé", "id": "dia ditiup", "ur": "پھونکا جاتا ہے", "bn": "তা ফুঁ দেওয়া হয়", "fa": "دمیده می‌شود"}}, {"arabic": "وَنُفِخَ", "count": 4, "first": "18:99", "audio": "audio/06cc9faae23e6dcc76e6.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "and it was blown", "bs": "i puhnuto je", "tr": "ve üflendi", "fr": "et il a été soufflé", "id": "dan dia ditiup", "ur": "اور پھونکا گیا", "bn": "এবং তা ফুঁ দেওয়া হলো", "fa": "و دمیده شد"}}, {"arabic": "نُفِخَ", "count": 3, "first": "23:101", "audio": "audio/a7ff1f6ef6d7800a5fae.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "it was blown", "bs": "puhnuto je", "tr": "üflendi", "fr": "il a été soufflé", "id": "dia ditiup", "ur": "پھونکا گیا", "bn": "তা ফুঁ দেওয়া হয়েছিল", "fa": "دمیده شد"}}, {"arabic": "وَنَفَخْتُ", "count": 2, "first": "15:29", "audio": "audio/ca2107dfd822bae5bef2.m4a", "grammar": [{"tense": "past", "pronoun": "ana", "passive": false, "objects": []}], "gloss": {"bs": "i udahnem", "en": "and I have breathed", "tr": "ve üflerim", "fr": "et j'ai insufflé", "id": "dan Aku telah meniupkan", "ur": "اور