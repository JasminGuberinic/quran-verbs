Text": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "عَذِّبِي", "plain": "عَذِّبِي", "quran": false, "notUsed": false, "spoken": "audio/828d97c1433f5f847f84.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "عَذِّبَا", "plain": "عَذِّبَا", "quran": false, "notUsed": false, "spoken": "audio/0ca8f3f0074187bf2a89.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "عَذِّبُوا", "plain": "عَذِّبُوا", "quran": false, "notUsed": false, "spoken": "audio/39f72cebc5de4de3a69c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "عَذِّبْنَ", "plain": "عَذِّبْنَ", "quran": false, "notUsed": false, "spoken": "audio/babaa9e56a2d1777c565.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "88:24", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5991.mp3", "translation": {"en": {"text": "Allah will punish him with direst punishment.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah ona en büyük azap ile azap edecek.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اسے اللہ بڑا عذاب دے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "maka Allah akan mengazabnya dengan azab yang besar.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَيُعَذِّبُهُ", "hit": true, "audio": "audio/7bbb76f672297af98b57.m4a", "gloss": {"bs": "pa će ga (Allah) kazniti", "en": "then (God) will punish him", "tr": "sonra (Allah) onu azaplandıracak", "fr": "alors (Dieu) le châtiera", "id": "kemudian (Allah) akan menyiksanya", "ur": "پھر (اللہ) اسے عذاب دے گا", "bn": "তখন (আল্লাহ) তাকে শাস্তি দেবেন", "fa": "آنگاه (خدا) او را عذاب می‌کند"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَذَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَكْبَرَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "27:21", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3180.mp3", "translation": {"en": {"text": "I verily will punish him with hard punishment or I verily will slay him, or he verily shall bring me a plain excuse.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ya bana (mazeretini gösteren) apaçık bir delil getirecek, ya da onu şiddetli bir azaba uğratacağım, yahut boğazlıyacağım!\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ضرور میں اسے سخت عذاب کرو ں گا یا ذبح کردوں گا یا کوئی روشن سند میرے پاس لائے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sungguh aku benar-benar akan mengazabnya dengan azab yang keras atau benar-benar menyembelihnya kecuali jika benar-benar dia datang kepadaku dengan alasan yang terang\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَأُعَذِّبَنَّهُۥ", "hit": true, "audio": "audio/d900661813dc5b7c740a.m4a", "gloss": {"en": "surely I will punish him", "bs": "zaista ću ga kazniti", "tr": "kesinlikle onu cezalandıracağım", "fr": "je le châtierai assurément", "id": "sungguh aku akan menghukumnya", "ur": "یقیناً میں اسے عذاب دوں گا", "bn": "নিশ্চয়ই আমি তাকে শাস্তি দেব", "fa": "قطعاً او را کیفر خواهم داد"}}, {"text": "عَذَابًا", "hit": false, "audio": null, "gloss": null}, {"text": "شَدِيدًا", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَأَا۟ذْبَحَنَّهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَيَأْتِيَنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "بِسُلْطَٰنٍ", "hit": false, "audio": null, "gloss": null}, {"text": "مُّبِينٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "5:118", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/787.mp3", "translation": {"en": {"text": "If Thou punish them, lo! they are Thy slaves, and if Thou forgive them (lo! they are Thy slaves). Lo! Thou, only Thou, art the Mighty, the Wise.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Eğer onlara azab edersen, onlar senin kullarındır, eğer onları bağışlarsan, şüphesiz sen daima üstünsün, hikmet sahibisin\".", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اگر تو انہیں عذاب کرے تو وہ تیرے بندے ہیں، اور اگر تو انہیں بخش دے تو بیشک تو ہی ہے غالب حکمت والا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Jika Engkau menyiksa mereka, maka sesungguhnya mereka adalah hamba-hamba Engkau, dan jika Engkau mengampuni mereka, maka sesungguhnya Engkaulah Yang Maha Perkasa lagi Maha Bijaksana.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تُعَذِّبْهُمْ", "hit": true, "audio": "audio/9c10b9708597bdf6225a.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": ["hum"], "mood": "jussive"}]}, {"text": "فَإِنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عِبَادُكَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَغْفِرْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَزِيزُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَكِيمُ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَيُعَذِّبُ", "count": 4, "first": "2:284", "audio": "audio/69a88f8822bd40f9955f.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and he/it punishes", "bs": "i kažnjava", "tr": "ve cezalandırır", "fr": "et il châtie", "id": "dan dia menghukum", "ur": "اور وہ عذاب دیتا ہے", "bn": "এবং সে শাস্তি দেয়", "fa": "و کیفر می‌دهد"}}, {"arabic": "يُعَذِّبُ", "count": 3, "first": "5:40", "audio": "audio/cc8a7f1b21aac714b0df.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it punishes", "bs": "kažnjava", "tr": "cezalandırır", "fr": "il châtie", "id": "dia menghukum", "ur": "وہ عذاب دیتا ہے", "bn": "সে শাস্তি দেয়", "fa": "کیفر می‌دهد"}}, {"arabic": "يُعَذِّبْكُمْ", "count": 3, "first": "9:39", "audio": "audio/c96b45ba108e928d9093.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "jussive"}], "gloss": {"en": "he/it punishes you (all)", "bs": "kažnjava vas", "tr": "sizi cezalandırır", "fr": "il vous châtie", "id": "dia menghukum kalian", "ur": "وہ تمہیں عذاب دیتا ہے", "bn": "সে তোমাদের শাস্তি দেয়", "fa": "شما را کیفر می‌دهد"}}, {"arabic": "تُعَذِّبْهُمْ", "count": 2, "first": "5:118", "audio": "audio/9c10b9708597bdf6225a.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": ["hum"], "mood": "jussive"}]}, {"arabic": "يُعَذِّبْهُمُ", "count": 2, "first": "9:14", "audio": "audio/505f5be5ff7a407fff00.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["hum"], "mood": "jussive"}], "gloss": {"en": "he/it punishes them", "bs": "kažnjava ih", "tr": "onları cezalandırır", "fr": "il les châtie", "id": "dia menghukum mereka", "ur": "وہ انہیں عذاب دیتا ہے", "bn": "সে তাদের শাস্তি দেয়", "fa": "آنان را کیفر می‌دهد"}}, {"arabic": "وَيُعَذِّبَ", "count": 2, "first": "33:24", "audio": "audio/982c04d4b34cfc11db64.m4a", "grammar": [{"tense": "present", "pronoun": 