{"rank": 52, "root": "توب", "form": 1, "lemma": "تابَ", "count": 63, "ayahCount": 56, "share": 0.33, "meaning": {"bs": "pokajati se", "en": "to repent, to turn in repentance", "tr": "tövbe etmek", "fr": "se repentir, revenir par le repentir", "id": "bertobat, kembali bertobat", "ur": "توبہ کرنا، رجوع کرنا", "bn": "তাওবা করা, অনুতপ্ত হয়ে ফিরে আসা", "fa": "توبه کردن، بازگشتن به سوی خدا"}, "lemmaSpoken": "audio/8ecedb16c48a3e35f8d3.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "تَابَ", "plain": "تَابَ", "quran": true, "notUsed": false, "spoken": "audio/8ecedb16c48a3e35f8d3.m4a", "recited": "audio/8f03a74fa1e17e8bea04.m4a", "recitedText": "تَابَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَتُوبُ", "plain": "يَتُوبُ", "quran": true, "notUsed": false, "spoken": "audio/8c7c7a719310f498a6e9.m4a", "recited": "audio/b29922de8c94d5d9f194.m4a", "recitedText": "يَتُوبُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "تُبْ", "plain": "تُبْ", "quran": true, "notUsed": false, "spoken": "audio/382b402f957ae9a67468.m4a", "recited": "audio/1082ea5cf43eb70c1884.m4a", "recitedText": "وَتُبْ"}], "nouns": {"participle": {"lemma": "تَوّاب", "count": 12, "spoken": "audio/4e71cf20031d1a654c67.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "تُبْتُ", "plain": "تُبْتُ", "quran": true, "notUsed": false, "spoken": "audio/129194bc7ad2914be349.m4a", "recited": "audio/df9b2d58d2ce677d3943.m4a", "recitedText": "تُبْتُ"}, {"tense": "past", "pronoun": "nahnu", "arabic": "تُبْنَا", "plain": "تُبْنَا", "quran": false, "notUsed": false, "spoken": "audio/3f77effb9d845c133dc5.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "تُبْتَ", "plain": "تُبْتَ", "quran": false, "notUsed": false, "spoken": "audio/19c5ec9348767ce0e6d5.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "تُبْتِ", "plain": "تُبْتِ", "quran": false, "notUsed": false, "spoken": "audio/a0519bebfd285574be52.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "تُبْتُمَا", "plain": "تُبْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/f448ea886f041400769f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "تُبْتُمْ", "plain": "تُبْتُمْ", "quran": true, "notUsed": false, "spoken": "audio/f05c0b27d9bf13f374d8.m4a", "recited": "audio/796e4ead114fc7b709b7.m4a", "recitedText": "تُبْتُمْ"}, {"tense": "past", "pronoun": "antunna", "arabic": "تُبْتُنَّ", "plain": "تُبْتُنَّ", "quran": false, "notUsed": false, "spoken": "audio/fc5fb34a34b7d55ba0ba.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huwa", "arabic": "تَابَ", "plain": "تَابَ", "quran": true, "notUsed": false, "spoken": "audio/8ecedb16c48a3e35f8d3.m4a", "recited": "audio/8f03a74fa1e17e8bea04.m4a", "recitedText": "تَابَ"}, {"tense": "past", "pronoun": "hiya", "arabic": "تَابَتْ", "plain": "تَابَتْ", "quran": false, "notUsed": false, "spoken": "audio/a0b2ec72167526dfec96.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huma", "arabic": "تَابَا", "plain": "تَابَا", "quran": true, "notUsed": false, "spoken": "audio/b56596adf2b5b7a310cb.m4a", "recited": "audio/82ca2f5e612d5a28c1ea.m4a", "recitedText": "تَابَا"}, {"tense": "past", "pronoun": "hum", "arabic": "تَابُوا۟", "plain": "تَابُوا", "quran": true, "notUsed": false, "spoken": "audio/9f9e9ac41cce9a8d2755.m4a", "recited": "audio/17bbf52eeb8a2471fa8e.m4a", "recitedText": "تَابُوا۟"}, {"tense": "past", "pronoun": "hunna", "arabic": "تُبْنَ", "plain": "تُبْنَ", "quran": false, "notUsed": false, "spoken": "audio/e48ba89ebc3fd6966ff5.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "ana", "arabic": "أَتُوبُ", "plain": "أَتُوبُ", "quran": true, "notUsed": false, "spoken": "audio/980a2f00aa9f6840e489.m4a", "recited": "audio/23156cec7ef62da609c2.m4a", "recitedText": "أَتُوبُ"}, {"tense": "present", "pronoun": "nahnu", "arabic": "نَتُوبُ", "plain": "نَتُوبُ", "quran": false, "notUsed": false, "spoken": "audio/eaf5c1dc519dd43d6b43.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "anta", "arabic": "تَتُوبُ", "plain": "تَتُوبُ", "quran": false, "notUsed": false, "spoken": "audio/5e224ef888208ec0b2bf.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "anti", "arabic": "تَتُوبِينَ", "plain": "تَتُوبِينَ", "quran": false, "notUsed": false, "spoken": "audio/3c16a1dbd137d647801c.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تَتُوبَانِ", "plain": "تَتُوبَانِ", "quran": false, "notUsed": false, "spoken": "audio/887939acd477360bca97.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَتُوبُونَ", "plain": "تَتُوبُونَ", "quran": false, "notUsed": false, "spoken": "audio/1d63253fc09d630b3284.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antunna", "arabic": "تَتُبْنَ", "plain": "تَتُبْنَ", "quran": false, "notUsed": false, "spoken": "audio/5738842c824f0eb6e672.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَتُوبُ", "plain": "يَتُوبُ", "quran": true, "notUsed": false, "spoken": "audio/8c7c7a719310f498a6e9.m4a", "recited": "audio/b29922de8c94d5d9f194.m4a", "recitedText": "يَتُوبُ"}, {"tense": "present", "pronoun": "hiya", "arabic": "تَتُوبُ", "plain": "تَتُوبُ", "quran": false, "notUsed": false, "spoken": "audio/5e224ef888208ec0b2bf.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يَتُوبَانِ", "plain": "يَتُوبَانِ", "quran": false, "notUsed": false, "spoken": "audio/f23980ce294f8359ec20.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَتُوبُونَ", "plain": "يَتُوبُونَ", "quran": true, "notUsed": false, "spoken": "audio/2e65f6ee86a35bd8c4a9.m4a", "recited": "audio/8103846da2dfb4b495a1.m4a", "recitedText": "يَتُوبُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَتُبْنَ", "plain": "يَتُبْنَ", "quran": false, "notUsed": false, "spoken": "audio/b48e50b7f36b1d303ca2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "تُبْ", "plain": "تُبْ", "quran": true, "notUsed": false, "spoken": "audio/382b402f957ae9a67468.m4a", "recited": "audio/1082ea5cf43eb70c1884.m4a", "recitedText": "وَتُبْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "تُوبِي", "plain": "تُوبِي", "quran": false, "notUsed": false, "spoken": "audio/32cf7f8bc90b054aaa78.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "تُوبَا", "plain": "تُوبَا", "quran": false, "notUsed": false, "spoken": "audio/f79a30150e970ceb0bba.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "تُوبُوٓا۟", "plain": "تُوبُوا", "quran": true, "notUsed": false, "spoken": "audio/8f226712f7ba238ea041.m4a", "recited": "audio/20e6dbf5be3e5c01f755.m4a", "recitedText": "تُوبُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "تُبْنَ", "plain": "تُبْنَ", "quran": false, "notUsed": false, "spoken": "audio/e48ba89ebc3fd6966ff5.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "20:122", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2470.mp3", "translation": {"en": {"text": "Then his Lord chose him, and relented toward him, and guided him.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra Rabbi, onu seçti de tevbesini kabul buyurdu ve ona doğru yolu gösterdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر اس کے رب نے چن لیا تو اس پر اپنی رحمت سے رجوع فرمائی اور اپنے قرب خاص کی راہ دکھائی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian Tuhannya memilihnya maka Dia menerima taubatnya dan memberinya petunjuk.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱجْتَبَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَابَ", "hit": true, "audio": "audio/b1b2c8d0def8347f1a9a.m4a", "gloss": {"bs": "pa mu je primio pokajanje", "en": "so He accepted (his) repentance", "tr": "tövbesini kabul etti", "fr": "alors Il accepta (son) repentir", "id": "maka Dia menerima tobatnya", "ur": "پھر اس نے اس کی توبہ قبول کی", "bn": "অতঃপর তিনি তার তাওবা কবুল করলেন", "fa": "پس توبه‌اش را پذیرفت"}}, {"text": "عَلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَهَدَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "25:71", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2926.mp3", "translation": {"en": {"text": "And whosoever repenteth and doeth good, he verily repenteth toward Allah with true repentance -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve her kim tevbe edip iyi davranış gösterirse, şüphesiz o, tevbesi kabul edilmiş olarak Allah'a döner.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جو توبہ کرے اور اچھا کام کرے تو وہ اللہ کی طرف رجوع لایا جیسی چاہیے تھی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang bertaubat dan mengerjakan amal saleh, maka sesungguhnya dia bertaubat kepada Allah dengan taubat yang sebenar-benarnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَابَ", "hit": true, "audio": "audio/3f66c174942ab19d2772.m4a", "gloss": {"en": "he/it repented", "bs": "pokajao se"}}, {"text": "وَعَمِلَ", "hit": false, "audio": null, "gloss": null}, {"text": "صَٰلِحًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتُوبُ", "hit": true, "audio": "audio/bc54db90fa037d2a1792.m4a", "gloss": {"en": "he/it repents", "bs": "kaje se"}}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَتَابًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:160", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/167.mp3", "translation": {"en": {"text": "Except those who repent and amend and make manifest (the truth). These it is toward whom I relent. I am the Relenting, the Merciful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ancak tevbe edip halini düzelterek gerçeği söyleyenler başka. İşte onları ben bağışlarım. Ben çok merhamet ediciyim, tevbeleri çokça kabul ederim.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "مگر وہ جو توبہ کریں اور سنواریں اور ظاہر کریں تو میں ان کی توبہ قبول فرماؤں گا اور میں ہی ہوں بڑا توبہ قبول فرمانے والا مہربان،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "kecuali mereka yang telah taubat dan mengadakan perbaikan dan menerangkan (kebenaran), maka terhadap mereka itulah Aku menerima taubatnya dan Akulah Yang Maha Menerima taubat lagi Maha Penyayang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَابُوا۟", "hit": true, "audio": "audio/17bbf52eeb8a2471fa8e.m4a", "gloss": {"en": "they repented", "bs": "pokajali su se", "tr": "tövbe ettiler", "fr": "ils se sont repentis", "id": "mereka telah bertobat", "ur": "انہوں نے توبہ کی", "bn": "তারা তাওবা করল", "fa": "توبه کردند"}}, {"text": "وَأَصْلَحُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَبَيَّنُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فَأُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَتُوبُ", "hit": true, "audio": "audio/23156cec7ef62da609c2.m4a", "gloss": {"en": "I accept repentance", "bs": "primam pokajanje", "tr": "tövbeyi kabul ederim", "fr": "j'accepte le repentir", "id": "aku menerima tobat", "ur": "میں توبہ قبول کرتا ہوں", "bn": "আমি তাওবা কবুল করি", "fa": "توبه را می‌پذیرم"}}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلتَّوَّابُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّحِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "11:90", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1563.mp3", "translation": {"en": {"text": "Ask pardon of your Lord and then turn unto Him (repentant). Lo! my Lord is Merciful, Loving.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rabbinizden mağfiret dileyin, sonra O'na tevbe ile yönelin. Şüphesiz ki, benim Rabbim çok merhametlidir, çok sevendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اپنے رب سے معافی چاہو پھر اس کی طرف رجوع لاؤ، بیشک میرا رب مہربان محبت والا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mohonlah ampun kepada Tuhanmu kemudian bertaubatlah kepada-Nya. Sesungguhnya Tuhanku Maha Penyayang lagi Maha Pengasih.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱسْتَغْفِرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "تُوبُوٓا۟", "hit": true, "audio": "audio/20e6dbf5be3e5c01f755.m4a", "gloss": {"bs": "pokajte se!", "en": "repent!", "tr": "tövbe edin!", "fr": "repentez-vous !", "id": "bertobatlah!", "ur": "توبہ کرو!", "bn": "তোমরা তাওবা করো!", "fa": "توبه کنید!"}}, {"text": "إِلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّى", "hit": false, "audio": null, "gloss": null}, {"text": "رَحِيمٌ", "hit": false, "audio": null, "gloss": null}, {"text": "وَدُودٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "5:74", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/743.mp3", "translation": {"en": {"text": "Will they not rather turn unto Allah and seek forgiveness of Him? For Allah is Forgiving, Merciful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hâlâ Allah'a tevbe edip O'ndan af dilemiyorlar mı? Allah çok bağışlayandır, çok merhamet edendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو کیوں نہیں رجوع کرتے اللہ کی طرف اور اس سے بخشش مانگتے، اور اللہ بخشنے والا مہربان،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka mengapa mereka tidak bertaubat kepada Allah dan memohon ampun kepada-Nya?. Dan Allah Maha Pengampun lagi Maha Penyayang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَفَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَتُوبُونَ", "hit": true, "audio": "audio/8103846da2dfb4b495a1.m4a", "gloss": {"bs": "(zar se neće) pokajati", "en": "(will they not) repent", "tr": "tövbe etmeyecekler mi", "fr": "(ne) se repentiront-ils (pas)", "id": "(tidakkah mereka) bertobat", "ur": "(کیا) وہ توبہ نہیں کریں گے", "bn": "(তারা কি) তাওবা করবে না", "fa": "(آیا) توبه نمی‌کنند"}}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَسْتَغْفِرُونَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "غَفُورٌ", "hit": false, "audio": null, "gloss": null}, {"text": "رَّحِيمٌ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تَابَ", "count": 11, "first": "5:39", "audio": "audio/8f03a74fa1e17e8bea04.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it repented; he/it accepted repentance", "bs": "pokajao se; primio je pokajanje", "tr": "tövbe etti; tövbeyi kabul etti", "fr": "il s'est repenti ; il a accepté le repentir", "id": "dia bertobat; dia menerima tobat", "ur": "اُس نے توبہ قبول کی", "bn": "সে তাওবা করল; সে তাওবা কবুল করল", "fa": "توبه کرد؛ توبه را پذیرفت"}}, {"arabic": "تَابُوا۟", "count": 10, "first": "2:160", "audio": "audio/17bbf52eeb8a2471fa8e.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they repented", "bs": "pokajali su se", "tr": "tövbe ettiler", "fr": "ils se sont repentis", "id": "mereka telah bertobat", "ur": "انہوں نے توبہ کی", "bn": "তারা তাওবা করল", "fa": "توبه کردند"}}, {"arabic": "فَتَابَ", "count": 5, "first": "2:37", "audio": "audio/621b9cfa7d232bcfe91f.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "pa mu je primio pokajanje", "en": "so He accepted (his) repentance", "tr": "tövbesini kabul etti", "fr": "alors Il accepta (son) repentir", "id": "maka Dia menerima tobatnya", "ur": "پھر اس نے اس کی توبہ قبول کی", "bn": "অতঃপর তিনি তার তাওবা কবুল করলেন", "fa": "پس توبه‌اش را پذیرفت"}}, {"arabic": "يَتُوبُ", "count": 5, "first": "4:17", "audio": "audio/b29922de8c94d5d9f194.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it accepts repentance; he/it repents", "bs": "prima pokajanje; kaje se", "tr": "tövbeyi kabul eder; tövbe eder", "fr": "il accepte le repentir ; il se repent", 