gloss": null}, {"text": "أَيْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَوْصَٰنِى", "hit": true, "audio": "audio/e44eb8212abb3a21c963.m4a", "gloss": {"bs": "i naložio mi je", "en": "and He enjoined me", "tr": "ve bana tavsiye etti", "fr": "et Il m'a enjoint", "id": "dan Dia mewasiatkan kepadaku", "ur": "اور اس نے مجھے تاکید کی", "bn": "এবং তিনি আমাকে নির্দেশ দিয়েছেন", "fa": "و مرا سفارش کرد"}}, {"text": "بِٱلصَّلَوٰةِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلزَّكَوٰةِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "دُمْتُ", "hit": false, "audio": null, "gloss": null}, {"text": "حَيًّا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُوصِيكُمُ", "count": 1, "first": "4:11", "audio": "audio/3adb07cb4b80e88171b7.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "he/it enjoins you (all)", "bs": "oporučuje vam", "tr": "size vasiyet eder", "fr": "il vous enjoint", "id": "dia berwasiat kepada kalian", "ur": "وہ تم سب کو حکم دیتا ہے", "bn": "সে তোমাদের ওসিয়ত করে", "fa": "به شما وصیت می‌کند"}}, {"arabic": "يُوصِى", "count": 1, "first": "4:11", "audio": "audio/40e10357f9c28f0daccd.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it bequeaths", "bs": "oporučuje", "tr": "vasiyet eder", "fr": "il lègue", "id": "dia berwasiat", "ur": "وہ وارث بناتا ہے", "bn": "সে ওসিয়ত করে", "fa": "وصیت می‌کند"}}, {"arabic": "يُوصِينَ", "count": 1, "first": "4:12", "audio": "audio/a0034934f45229237fb5.m4a", "grammar": [{"tense": "present", "pronoun": "hunna", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they bequeath", "bs": "oporučuju", "tr": "vasiyet ederler", "fr": "elles lèguent", "id": "mereka berwasiat", "ur": "وہ وارث بناتے ہیں", "bn": "তারা ওসিয়ত করে", "fa": "وصیت می‌کنند"}}, {"arabic": "تُوصُونَ", "count": 1, "first": "4:12", "audio": "audio/fe528dd45f73bb047bdc.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "you (all) bequeath", "bs": "oporučujete", "tr": "vasiyet edersiniz", "fr": "vous léguez", "id": "kalian berwasiat", "ur": "تم سب وارث بناتے ہو", "bn": "তোমরা ওসিয়ত কর", "fa": "وصیت می‌کنید"}}, {"arabic": "يُوصَىٰ", "count": 1, "first": "4:12", "audio": "audio/5cda50238a0ff36dd40c.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it is bequeathed", "bs": "biva oporučen", "tr": "vasiyet edilir", "fr": "il est légué", "id": "dia diwasiatkan", "ur": "وہ وصیت کیا جاتا ہے", "bn": "তাকে ওসিয়ত করা হয়", "fa": "وصیت داده می‌شود"}}, {"arabic": "وَأَوْصَٰنِى", "count": 1, "first": "19:31", "audio": "audio/e44eb8212abb3a21c963.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["ana"]}], "gloss": {"bs": "i naložio mi je", "en": "and He enjoined me", "tr": "ve bana tavsiye etti", "fr": "et Il m'a enjoint", "id": "dan Dia mewasiatkan kepadaku", "ur": "اور اس نے مجھے تاکید کی", "bn": "এবং তিনি আমাকে নির্দেশ দিয়েছেন", "fa": "و مرا سفارش کرد"}}], "ayatFile": "ayat/0440.json", "ayatTranslations": {"en": "ayat/0440.en.json", "tr": "ayat/0440.tr.json", "ur": "ayat/0440.ur.json", "id": "ayat/0440.id.json"}, "sentences": [{"arabic": "يُوصِي الْأَبُ أَوْلَادَهُ بِالصِّدْقِ", "spoken": "audio/61db88bfe3ac9f3a037f.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Otac savjetuje svoju djecu da budu iskreni.", "en": "The father advises his children to be sincere.", "bn": "বাবা তার সন্তানদের সততার উপদেশ দেন।", "fa": "پدر فرزندانش را به راستگویی سفارش می‌کند.", "fr": "Le père recommande la sincérité à ses enfants.", "id": "Sang ayah berwasiat kepada anak-anaknya agar jujur.", "tr": "Baba çocuklarına doğruluğu tavsiye eder.", "ur": "باپ اپنے بچوں کو سچائی کی نصیحت کرتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يُوصِي", "target": true, "translation": {"bs": "savjetuje", "en": "advises", "bn": "উপদেশ দেয়", "fa": "سفارش می‌کند", "fr": "recommande", "id": "berwasiat", "tr": "tavsiye eder", "ur": "نصیحت کرتا ہے"}}, {"arabic": "الْأَبُ", "target": false, "translation": {"bs": "otac", "en": "the father", "bn": "বাবা", "fa": "پدر", "fr": "le père", "id": "ayah itu", "tr": "baba", "ur": "باپ"}}, {"arabic": "أَوْلَادَهُ", "target": false, "translation": {"bs": "svoju djecu", "en": "his children", "bn": "তার সন্তানেরা", "fa": "فرزندانش", "fr": "ses enfants", "id": "anak-anaknya", "tr": "çocukları", "ur": "اس کے بچے"}}, {"arabic": "بِالصِّدْقِ", "target": false, "translation": {"bs": "na iskrenost", "en": "to sincerity", "bn": "সততার প্রতি", "fa": "به راستی", "fr": "à la sincérité", "id": "pada kejujuran", "tr": "doğruluğa", "ur": "سچائی کی طرف"}}]}, {"arabic": "تُوصُونَ الْأَطْفَالَ بِالنَّظَافَةِ", "spoken": "audio/e1f1510bc74dc500d384.m4a", "tense": "present", "pronoun": "antum", "translation": {"bs": "Savjetujete djecu da održavaju čistoću.", "en": "You (all) advise the children to keep clean.", "bn": "তোমরা সবাই শিশুদের পরিচ্ছন্নতার উপদেশ দাও।", "fa": "شما کودکان را به پاکیزگی سفارش می‌کنید.", "fr": "Vous recommandez la propreté aux enfants.", "id": "Kalian berwasiat kepada anak-anak agar menjaga kebersihan.", "tr": "Siz çocuklara temizliği tavsiye edersiniz.", "ur": "تم سب بچوں کو صفائی کی نصیحت کرتے ہو۔"}, "independentlyReviewed": true, "words": [{"arabic": "تُوصُونَ", "target": true, "translation": {"bs": "savjetujete", "en": "you (all) advise", "bn": "তোমরা সবাই উপদেশ দাও", "fa": "شما (همه) سفارش می‌کنید", "fr": "vous recommandez", "id": "kalian berwasiat", "tr": "tavsiye edersiniz", "ur": "تم سب نصیحت کرتے ہو"}}, {"arabic": "الْأَطْفَالَ", "target": false, "translation": {"bs": "djecu", "en": "the children", "bn": "শিশুরা", "fa": "کودکان", "fr": "les enfants", "id": "anak-anak itu", "tr": "çocuklar", "ur": "بچے"}}, {"arabic": "بِالنَّظَافَةِ", "target": false, "translation": {"bs": "da održavaju čistoću", "en": "to cleanliness", "bn": "পরিচ্ছন্নতার প্রতি", "fa": "به پاکیزگی", "fr": "à la propreté", "id": "pada kebersihan", "tr": "temizliğe", "ur": "صفائی"}}]}]}