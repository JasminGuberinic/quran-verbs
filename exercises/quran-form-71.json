[{"id":"adhaqa-11-9-1","words":["verb:adhaqa"],"options":[{"bs":"damo da okusi","en":"We let taste"},{"bs":"i dajemo mu da okusi","en":"and we make him taste"},{"bs":"i sigurno ćemo im dati da okuse","en":"and We will surely make them taste"},{"bs":"pa zaista ćemo dati da okusi","en":"so surely we will make taste"}],"ref":"11:9","answerWord":"أَذَقْنَا","answerSound":"audio/c3e663ec3533080aaede.m4a","quranTranslation":{"text":"And if we cause man to taste some mercy from Us and afterward withdraw it from him, lo! he is despairing, thankless.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["وَلَئِنْ","أَذَقْنَا","ٱلْإِنسَٰنَ","مِنَّا","رَحْمَةً","ثُمَّ","نَزَعْنَٰهَا","مِنْهُ","إِنَّهُۥ","لَيَـُٔوسٌ","كَفُورٌ"],"marked":[1],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-11-10-1","words":["verb:adhaqa"],"options":[{"bs":"dali smo mu da okusi","en":"we made him taste"},{"bs":"dajemo mu da okusi","en":"we make him taste"},{"bs":"pa zaista ćemo dati da okusi","en":"so surely we will make taste"},{"bs":"da im dadne da okuse","en":"so that he/it may make them taste"}],"ref":"11:10","answerWord":"أَذَقْنَٰهُ","answerSound":"audio/37faa38430634f191098.m4a","quranTranslation":{"text":"And if We cause him to taste grace after some misfortune that had befallen him, he saith: The ills have gone from me. Lo! he is exultant, boastful;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["وَلَئِنْ","أَذَقْنَٰهُ","نَعْمَآءَ","بَعْدَ","ضَرَّآءَ","مَسَّتْهُ","لَيَقُولَنَّ","ذَهَبَ","ٱلسَّيِّـَٔاتُ","عَنِّىٓ","إِنَّهُۥ","لَفَرِحٌ","فَخُورٌ"],"marked":[1],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-25-19-12","words":["verb:adhaqa"],"options":[{"bs":"dajemo mu da okusi","en":"we make him taste"},{"bs":"da im damo da okuse","en":"so that we may make them taste"},{"bs":"da im dadne da okuse","en":"so that he/it may make them taste"},{"bs":"pa im je dao da okuse","en":"so he/it made them taste"}],"ref":"25:19","answerWord":"نُذِقْهُ","answerSound":"audio/b6e645f9b082eb2dd93c.m4a","quranTranslation":{"text":"Thus they will give you the lie regarding what ye say, then ye can neither avert (the doom) nor obtain help. And whoso among you doeth wrong, We shall make him taste great torment.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["فَقَدْ","كَذَّبُوكُم","بِمَا","تَقُولُونَ","فَمَا","تَسْتَطِيعُونَ","صَرْفًا","وَلَا","نَصْرًا","وَمَن","يَظْلِم","مِّنكُمْ","نُذِقْهُ","عَذَابًا","كَبِيرًا"],"marked":[12],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-32-21-0","words":["verb:adhaqa"],"options":[{"bs":"i sigurno ćemo im dati da okuse","en":"and We will surely make them taste"},{"bs":"dajemo mu da okusi","en":"we make him taste"},{"bs":"i daje da okusi","en":"and he/it makes taste"},{"bs":"damo da okusi","en":"We let taste"}],"ref":"32:21","answerWord":"وَلَنُذِيقَنَّهُم","answerSound":"audio/0f84a6be444a199e8aa2.m4a","quranTranslation":{"text":"And verily We make them taste the lower punishment before the greater, that haply they may return.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["وَلَنُذِيقَنَّهُم","مِّنَ","ٱلْعَذَابِ","ٱلْأَدْنَىٰ","دُونَ","ٱلْعَذَابِ","ٱلْأَكْبَرِ","لَعَلَّهُمْ","يَرْجِعُونَ"],"marked":[0],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-6-65-17","words":["verb:adhaqa"],"options":[{"bs":"i daje da okusi","en":"and he/it makes taste"},{"bs":"da im damo da okuse","en":"so that we may make them taste"},{"bs":"dajemo mu da okusi","en":"we make him taste"},{"bs":"pa joj je dao da okusi","en":"so he/it made it taste"}],"ref":"6:65","answerWord":"وَيُذِيقَ","answerSound":"audio/f14d6caebd5aa5b4da1b.m4a","quranTranslation":{"text":"Say: He is able to send punishment upon you from above you or from beneath your feet, or to bewilder you with dissension and make you taste the tyranny one of another. See how We display the revelations so that they may understand.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["قُلْ","هُوَ","ٱلْقَادِرُ","عَلَىٰٓ","أَن","يَبْعَثَ","عَلَيْكُمْ","عَذَابًا","مِّن","فَوْقِكُمْ","أَوْ","مِن","تَحْتِ","أَرْجُلِكُمْ","أَوْ","يَلْبِسَكُمْ","شِيَعًا","وَيُذِيقَ","بَعْضَكُم","بَأْسَ","بَعْضٍ","ٱنظُرْ","كَيْفَ","نُصَرِّفُ","ٱلْءَايَٰتِ","لَعَلَّهُمْ","يَفْقَهُونَ"],"marked":[17],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-10-70-7","words":["verb:adhaqa"],"options":[{"bs":"dajemo im da okuse","en":"we make them taste"},{"bs":"i daje da okusi","en":"and he/it makes taste"},{"bs":"pa zaista ćemo dati da okusi","en":"so surely we will make taste"},{"bs":"damo da okusi","en":"We let taste"}],"ref":"10:70","answerWord":"نُذِيقُهُمُ","answerSound":"audio/e1096430644e806d8d04.m4a","quranTranslation":{"text":"This world's portion (will be theirs), then unto Us is their return. Then We make them taste a dreadful doom because they used to disbelieve.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["مَتَٰعٌ","فِى","ٱلدُّنْيَا","ثُمَّ","إِلَيْنَا","مَرْجِعُهُمْ","ثُمَّ","نُذِيقُهُمُ","ٱلْعَذَابَ","ٱلشَّدِيدَ","بِمَا","كَانُوا۟","يَكْفُرُونَ"],"marked":[7],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-16-112-16","words":["verb:adhaqa"],"options":[{"bs":"pa joj je dao da okusi","en":"so he/it made it taste"},{"bs":"da im dadne da okuse","en":"so that he/it may make them taste"},{"bs":"da im damo da okuse","en":"so that we may make them taste"},{"bs":"dao im je da okuse","en":"he/it made them taste"}],"ref":"16:112","answerWord":"فَأَذَٰقَهَا","answerSound":"audio/c2b2709ad546389612c4.m4a","quranTranslation":{"text":"Allah coineth a similitude: a township that dwelt secure and well content, its provision coming to it in abundance from every side, but it disbelieved in Allah's favours, so Allah made it experience the garb of dearth and fear because of what they used to do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["وَضَرَبَ","ٱللَّهُ","مَثَلًا","قَرْيَةً","كَانَتْ","ءَامِنَةً","مُّطْمَئِنَّةً","يَأْتِيهَا","رِزْقُهَا","رَغَدًا","مِّن","كُلِّ","مَكَانٍ","فَكَفَرَتْ","بِأَنْعُمِ","ٱللَّهِ","فَأَذَٰقَهَا","ٱللَّهُ","لِبَاسَ","ٱلْجُوعِ","وَٱلْخَوْفِ","بِمَا","كَانُوا۟","يَصْنَعُونَ"],"marked":[16],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-22-9-10","words":["verb:adhaqa"],"options":[{"bs":"i dajemo mu da okusi","en":"and we make him taste"},{"bs":"pa im je dao da okuse","en":"so he/it made them taste"},{"bs":"pa joj je dao da okusi","en":"so he/it made it taste"},{"bs":"i sigurno ćemo im dati da okuse","en":"and We will surely make them taste"}],"ref":"22:9","answerWord":"وَنُذِيقُهُۥ","answerSound":"audio/60e61840c32dd9f22e69.m4a","quranTranslation":{"text":"Turning away in pride to beguile (men) from the way of Allah. For him in this world is ignominy, and on the Day of Resurrection We make him taste the doom of burning.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["ثَانِىَ","عِطْفِهِۦ","لِيُضِلَّ","عَن","سَبِيلِ","ٱللَّهِ","لَهُۥ","فِى","ٱلدُّنْيَا","خِزْىٌ","وَنُذِيقُهُۥ","يَوْمَ","ٱلْقِيَٰمَةِ","عَذَابَ","ٱلْحَرِيقِ"],"marked":[10],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-22-25-21","words":["verb:adhaqa"],"options":[{"bs":"dajemo mu da okusi","en":"we make him taste"},{"bs":"i daje da okusi","en":"and he/it makes taste"},{"bs":"pa im je dao da okuse","en":"so he/it made them taste"},{"bs":"dali smo mu da okusi","en":"we made him taste"}],"ref":"22:25","answerWord":"نُّذِقْهُ","answerSound":"audio/5834c7a2094b52974c66.m4a","quranTranslation":{"text":"Lo! those who disbelieve and bar (men) from the way of Allah and from the Inviolable Place of Worship, which We have appointed for mankind together, the dweller therein and the nomad: whosoever seeketh wrongful partiality therein, him We shall cause to taste a painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["إِنَّ","ٱلَّذِينَ","كَفَرُوا۟","وَيَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","وَٱلْمَسْجِدِ","ٱلْحَرَامِ","ٱلَّذِى","جَعَلْنَٰهُ","لِلنَّاسِ","سَوَآءً","ٱلْعَٰكِفُ","فِيهِ","وَٱلْبَادِ","وَمَن","يُرِدْ","فِيهِ","بِإِلْحَادٍۭ","بِظُلْمٍ","نُّذِقْهُ","مِنْ","عَذَابٍ","أَلِيمٍ"],"marked":[21],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-30-33-10","words":["verb:adhaqa"],"options":[{"bs":"dao im je da okuse","en":"he/it made them taste"},{"bs":"da im dadne da okuse","en":"so that he/it may make them taste"},{"bs":"pa joj je dao da okusi","en":"so he/it made it taste"},{"bs":"dajemo mu da okusi","en":"we make him taste"}],"ref":"30:33","answerWord":"أَذَاقَهُم","answerSound":"audio/aa6103d10ce1db735540.m4a","quranTranslation":{"text":"And when harm toucheth men they cry unto their Lord, turning to Him in repentance; then, when they have tasted of His mercy, behold! some of them attribute partners to their Lord","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["وَإِذَا","مَسَّ","ٱلنَّاسَ","ضُرٌّ","دَعَوْا۟","رَبَّهُم","مُّنِيبِينَ","إِلَيْهِ","ثُمَّ","إِذَآ","أَذَاقَهُم","مِّنْهُ","رَحْمَةً","إِذَا","فَرِيقٌ","مِّنْهُم","بِرَبِّهِمْ","يُشْرِكُونَ"],"marked":[10],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-30-41-9","words":["verb:adhaqa"],"options":[{"bs":"da im dadne da okuse","en":"so that he/it may make them taste"},{"bs":"dajemo mu da okusi","en":"we make him taste"},{"bs":"da im damo da okuse","en":"so that we may make them taste"},{"bs":"i daje da okusi","en":"and he/it makes taste"}],"ref":"30:41","answerWord":"لِيُذِيقَهُم","answerSound":"audio/3cd54f7edd5d67d434ce.m4a","quranTranslation":{"text":"Corruption doth appear on land and sea because of (the evil) which men's hands have done, that He may make them taste a part of that which they have done, in order that they may return.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["ظَهَرَ","ٱلْفَسَادُ","فِى","ٱلْبَرِّ","وَٱلْبَحْرِ","بِمَا","كَسَبَتْ","أَيْدِى","ٱلنَّاسِ","لِيُذِيقَهُم","بَعْضَ","ٱلَّذِى","عَمِلُوا۟","لَعَلَّهُمْ","يَرْجِعُونَ"],"marked":[9],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-39-26-0","words":["verb:adhaqa"],"options":[{"bs":"pa im je dao da okuse","en":"so he/it made them taste"},{"bs":"damo da okusi","en":"We let taste"},{"bs":"dajemo im da okuse","en":"we make them taste"},{"bs":"i dajemo mu da okusi","en":"and we make him taste"}],"ref":"39:26","answerWord":"فَأَذَاقَهُمُ","answerSound":"audio/e933386a8cae171a6fbe.m4a","quranTranslation":{"text":"Thus Allah made them taste humiliation in the life of the world, and verily the doom of the Hereafter will be greater if they did but know.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["فَأَذَاقَهُمُ","ٱللَّهُ","ٱلْخِزْىَ","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","وَلَعَذَابُ","ٱلْءَاخِرَةِ","أَكْبَرُ","لَوْ","كَانُوا۟","يَعْلَمُونَ"],"marked":[0],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-41-16-7","words":["verb:adhaqa"],"options":[{"bs":"da im damo da okuse","en":"so that we may make them taste"},{"bs":"dali smo mu da okusi","en":"we made him taste"},{"bs":"pa zaista ćemo dati da okusi","en":"so surely we will make taste"},{"bs":"da im dadne da okuse","en":"so that he/it may make them taste"}],"ref":"41:16","answerWord":"لِّنُذِيقَهُمْ","answerSound":"audio/953fb290cf1464326bc1.m4a","quranTranslation":{"text":"Therefor We let loose on them a raging wind in evil days, that We might make them taste the torment of disgrace in the life of the world. And verily the doom of the Hereafter will be more shameful, and they will not be helped.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["فَأَرْسَلْنَا","عَلَيْهِمْ","رِيحًا","صَرْصَرًا","فِىٓ","أَيَّامٍ","نَّحِسَاتٍ","لِّنُذِيقَهُمْ","عَذَابَ","ٱلْخِزْىِ","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","وَلَعَذَابُ","ٱلْءَاخِرَةِ","أَخْزَىٰ","وَهُمْ","لَا","يُنصَرُونَ"],"marked":[7],"facts":{"verb":"أَذاقَ"}},{"id":"adhaqa-41-27-0","words":["verb:adhaqa"],"options":[{"bs":"pa zaista ćemo dati da okusi","en":"so surely we will make taste"},{"bs":"i daje da okusi","en":"and he/it makes taste"},{"bs":"dajemo im da okuse","en":"we make them taste"},{"bs":"da im dadne da okuse","en":"so that he/it may make them taste"}],"ref":"41:27","answerWord":"فَلَنُذِيقَنَّ","answerSound":"audio/745f28769f4dde2f6683.m4a","quranTranslation":{"text":"But verily We shall cause those who disbelieve to taste an awful doom, and verily We shall requite them the worst of what they used to do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"dati da okusi","en":"to make taste"},"passage":["فَلَنُذِيقَنَّ","ٱلَّذِينَ","كَفَرُوا۟","عَذَابًا","شَدِيدًا","وَلَنَجْزِيَنَّهُمْ","أَسْوَأَ","ٱلَّذِى","كَانُوا۟","يَعْمَلُونَ"],"marked":[0],"facts":{"verb":"أَذاقَ"}},{"id":"salaka-16-69-5","words":["verb:salaka"],"options":[{"bs":"pa idi putem!","en":"so follow a path!"},{"bs":"zavuci!","en":"thrust in!"},{"bs":"šalje","en":"he/it sends along"},{"bs":"pa ga uvedite","en":"then insert him"}],"ref":"16:69","answerWord":"فَٱسْلُكِى","answerSound":"audio/8eecf0eddea6c7dbffa3.m4a","quranTranslation":{"text":"Then eat of all fruits, and follow the ways of thy Lord, made smooth (for thee). There cometh forth from their bellies a drink divers of hues, wherein is healing for mankind. Lo! herein is indeed a portent for people who reflect.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ići putem, uvesti","en":"to follow a path, to insert"},"passage":["ثُمَّ","كُلِى","مِن","كُلِّ","ٱلثَّمَرَٰتِ","فَٱسْلُكِى","سُبُلَ","رَبِّكِ","ذُلُلًا","يَخْرُجُ","مِنۢ","بُطُونِهَا","شَرَابٌ","مُّخْتَلِفٌ","أَلْوَٰنُهُۥ","فِيهِ","شِفَآءٌ","لِّلنَّاسِ","إِنَّ","فِى","ذَٰلِكَ","لَءَايَةً","لِّقَوْمٍ","يَتَفَكَّرُونَ"],"marked":[5],"facts":{"verb":"سَلَكَ"}},{"id":"salaka-20-53-5","words":["verb:salaka"],"options":[{"bs":"i provukao je","en":"and he/it threaded"},{"bs":"da biste hodili","en":"so that you may walk"},{"bs":"pa ga uvedite","en":"then insert him"},{"bs":"šalje","en":"he/it sends along"}],"ref":"20:53","answerWord":"وَسَلَكَ","answerSound":"audio/2ca6a824b796158354c3.m4a","quranTranslation":{"text":"Who hath appointed the earth as a bed and hath threaded roads for you therein and hath sent down water from the sky and thereby We have brought forth divers kinds of vegetation,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ići putem, uvesti","en":"to follow a path, to insert"},"passage":["ٱلَّذِى","جَعَلَ","لَكُمُ","ٱلْأَرْضَ","مَهْدًا","وَسَلَكَ","لَكُمْ","فِيهَا","سُبُلًا","وَأَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَأَخْرَجْنَا","بِهِۦٓ","أَزْوَٰجًا","مِّن","نَّبَاتٍ","شَتَّىٰ"],"marked":[5],"facts":{"verb":"سَلَكَ"}},{"id":"salaka-28-32-0","words":["verb:salaka"],"options":[{"bs":"zavuci!","en":"thrust in!"},{"bs":"šalje","en":"he/it sends along"},{"bs":"pa idi putem!","en":"so follow a path!"},{"bs":"i provukao je","en":"and he/it threaded"}],"ref":"28:32","answerWord":"ٱسْلُكْ","answerSound":"audio/88103a2e00a404f71077.m4a","quranTranslation":{"text":"Thrust thy hand into the bosom of thy robe it will come forth white without hurt. And guard thy heart from fear. Then these shall be two proofs from your Lord unto Pharaoh and his chiefs. Lo! they are evil-living folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ići putem, uvesti","en":"to follow a path, to insert"},"passage":["ٱسْلُكْ","يَدَكَ","فِى","جَيْبِكَ","تَخْرُجْ","بَيْضَآءَ","مِنْ","غَيْرِ","سُوٓءٍ","وَٱضْمُمْ","إِلَيْكَ","جَنَاحَكَ","مِنَ","ٱلرَّهْبِ","فَذَٰنِكَ","بُرْهَٰنَانِ","مِن","رَّبِّكَ","إِلَىٰ","فِرْعَوْنَ","وَمَلَإِي۟هِۦٓ","إِنَّهُمْ","كَانُوا۟","قَوْمًا","فَٰسِقِينَ"],"marked":[0],"facts":{"verb":"سَلَكَ"}},{"id":"salaka-69-32-6","words":["verb:salaka"],"options":[{"bs":"pa ga uvedite","en":"then insert him"},{"bs":"da biste hodili","en":"so that you may walk"},{"bs":"šalje","en":"he/it sends along"},{"bs":"pa idi putem!","en":"so follow a path!"}],"ref":"69:32","answerWord":"فَٱسْلُكُوهُ","answerSound":"audio/d0aadfabb7b5e1437fa4.m4a","quranTranslation":{"text":"And then insert him in a chain whereof the length is seventy cubits.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ići putem, uvesti","en":"to follow a path, to insert"},"passage":["ثُمَّ","فِى","سِلْسِلَةٍ","ذَرْعُهَا","سَبْعُونَ","ذِرَاعًا","فَٱسْلُكُوهُ"],"marked":[6],"facts":{"verb":"سَلَكَ"}},{"id":"salaka-71-20-0","words":["verb:salaka"],"options":[{"bs":"da biste hodili","en":"so that you may walk"},{"bs":"pa idi putem!","en":"so follow a path!"},{"bs":"uvelo vas je","en":"led you"},{"bs":"i provukao je","en":"and he/it threaded"}],"ref":"71:20","answerWord":"لِّتَسْلُكُوا۟","answerSound":"audio/27676ecbd4e68c649d69.m4a","quranTranslation":{"text":"That ye may thread the valley-ways thereof.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ići putem, uvesti","en":"to follow a path, to insert"},"passage":["لِّتَسْلُكُوا۟","مِنْهَا","سُبُلًا","فِجَاجًا"],"marked":[0],"facts":{"verb":"سَلَكَ"}},{"id":"salaka-72-27-6","words":["verb:salaka"],"options":[{"bs":"šalje","en":"he/it sends along"},{"bs":"pa uvedi!","en":"so introduce!"},{"bs":"da biste hodili","en":"so that you may walk"},{"bs":"i provukao je","en":"and he/it threaded"}],"ref":"72:27","answerWord":"يَسْلُكُ","answerSound":"audio/53d730c2d2e5fdae2600.m4a","quranTranslation":{"text":"Save unto every messenger whom He hath chosen, and then He maketh a guard to go before him and a guard behind him","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ići putem, uvesti","en":"to follow a path, to insert"},"passage":["إِلَّا","مَنِ","ٱرْتَضَىٰ","مِن","رَّسُولٍ","فَإِنَّهُۥ","يَسْلُكُ","مِنۢ","بَيْنِ","يَدَيْهِ","وَمِنْ","خَلْفِهِۦ","رَصَدًا"],"marked":[6],"facts":{"verb":"سَلَكَ"}},{"id":"salaka-74-42-1","words":["verb:salaka"],"options":[{"bs":"uvelo vas je","en":"led you"},{"bs":"šalje","en":"he/it sends along"},{"bs":"da biste hodili","en":"so that you may walk"},{"bs":"pa uvedi!","en":"so introduce!"}],"ref":"74:42","answerWord":"سَلَكَكُمْ","answerSound":"audio/59d934e508972c142f71.m4a","quranTranslation":{"text":"What hath brought you to this burning?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ići putem, uvesti","en":"to follow a path, to insert"},"passage":["مَا","سَلَكَكُمْ","فِى","سَقَرَ"],"marked":[1],"facts":{"verb":"سَلَكَ"}}]