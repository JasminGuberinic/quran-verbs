dio/8872059538f21c53ed60.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَخِّرِي", "plain": "أَخِّرِي", "quran": false, "notUsed": false, "spoken": "audio/5be3189095c36386fce7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَخِّرَا", "plain": "أَخِّرَا", "quran": false, "notUsed": false, "spoken": "audio/d37b9fbf73701ec8507e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَخِّرُوا", "plain": "أَخِّرُوا", "quran": false, "notUsed": false, "spoken": "audio/680f6ea6ceb775aa3d27.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَخِّرْنَ", "plain": "أَخِّرْنَ", "quran": false, "notUsed": false, "spoken": "audio/5e9e1bc61dfe29bc489b.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "63:11", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5199.mp3", "translation": {"en": {"text": "But Allah reprieveth no soul when its term cometh, and Allah is Informed of what ye do.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah süresi geldiği zaman hiç bir canı ertelemez. Allah yaptıklarınızdan haberdardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہرگز اللہ کسی جان کو مہلت نہ دے گا جب اس کا وعدہ آجائے اور اللہ کو تمہارے کاموں کی خبر ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Allah sekali-kali tidak akan menangguhkan (kematian) seseorang apabila telah datang waktu kematiannya. Dan Allah Maha Mengenal apa yang kamu kerjakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَن", "hit": false, "audio": null, "gloss": null}, {"text": "يُؤَخِّرَ", "hit": true, "audio": "audio/5c48c9e9917f635e20f8.m4a", "gloss": {"en": "he/it delays", "bs": "odgađa", "tr": "erteler", "fr": "il retarde", "id": "dia menunda", "ur": "وہ مہلت دیتا ہے", "bn": "সে বিলম্বিত করে", "fa": "به تأخیر اندازد"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "نَفْسًا", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "جَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجَلُهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "خَبِيرٌۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْمَلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "11:104", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1577.mp3", "translation": {"en": {"text": "And We defer it only to a term already reckoned.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz onu sadece belli bir süreye kadar geciktiriyoruz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم اسے پیچھے نہیں ہٹاتے مگر ایک گنی ہوئی مدت کے لیئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami tiadalah mengundurkannya, melainkan sampai waktu yang tertentu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "نُؤَخِّرُهُۥٓ", "hit": true, "audio": "audio/46942c783104e525eeb9.m4a", "gloss": {"bs": "odgađamo ga", "en": "We delay it", "tr": "onu erteleriz", "fr": "Nous le retardons", "id": "Kami menunda", "ur": "ہم اسے ٹال دیتے ہیں", "bn": "আমরা তা বিলম্বিত করি", "fa": "آن را به تأخیر می‌اندازیم"}}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لِأَجَلٍ", "hit": false, "audio": null, "gloss": null}, {"text": "مَّعْدُودٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "75:13", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5564.mp3", "translation": {"en": {"text": "On that day man is told the tale of that which he hath sent before and left behind.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O gün insana, yapıp öne sürdüğü ve geri bıraktığı ne varsa bildirilir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس دن آدمی کو اس کا سب اگلا پچھلا جتادیا جائے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Pada hari itu diberitakan kepada manusia apa yang telah dikerjakannya dan apa yang dilalaikannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يُنَبَّؤُا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْإِنسَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَئِذٍۭ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "قَدَّمَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَخَّرَ", "hit": true, "audio": "audio/8a6e136a2a1a7ff07a00.m4a", "gloss": {"en": "and he/it delayed", "bs": "i odgodio je", "tr": "ve erteledi", "fr": "et il a retardé", "id": "dan dia telah menunda", "ur": "اور اُس نے مہلت دی", "bn": "এবং সে বিলম্বিত করল", "fa": "و به تأخیر انداخت"}}]}, {"ref": "82:5", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5834.mp3", "translation": {"en": {"text": "A soul will know what it hath sent before (it) and what left behind.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Herkes neyi önünden gönderdiğini ve neyi geri bıraktığını bilir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہر جان، جان لے گی جو اس نے آگے بھیجا اور جو پیچھے", "by": "احمد رضا خ