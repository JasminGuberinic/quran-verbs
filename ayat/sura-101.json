{"ayat":[{"ref":"101:1","number":6158,"text":"ٱلْقَارِعَةُ","hits":[]},{"ref":"101:2","number":6159,"text":"مَا ٱلْقَارِعَةُ","hits":[0]},{"ref":"101:3","number":6160,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","hits":[1]},{"ref":"101:4","number":6161,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","hits":[0,1,2]},{"ref":"101:5","number":6162,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","hits":[1]},{"ref":"101:6","number":6163,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","hits":[0,1,2,3]},{"ref":"101:7","number":6164,"text":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","hits":[0,1]},{"ref":"101:8","number":6165,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","hits":[]},{"ref":"101:9","number":6166,"text":"فَأُمُّهُۥ هَاوِيَةٌ","hits":[0]},{"ref":"101:10","number":6167,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","hits":[3]},{"ref":"101:11","number":6168,"text":"نَارٌ حَامِيَةٌۢ","hits":[0]}]}