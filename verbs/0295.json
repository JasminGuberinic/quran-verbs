bic": "ثَبِّتِي", "plain": "ثَبِّتِي", "quran": false, "notUsed": false, "spoken": "audio/4f250eb2293b4af64410.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "ثَبِّتَا", "plain": "ثَبِّتَا", "quran": false, "notUsed": false, "spoken": "audio/324827ba48f272e5ecf9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ثَبِّتُوا۟", "plain": "ثَبِّتُوا", "quran": true, "notUsed": false, "spoken": "audio/80260d5a24ea14ee1f90.m4a", "recited": "audio/54c51c63906419962c00.m4a", "recitedText": "فَثَبِّتُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "ثَبِّتْنَ", "plain": "ثَبِّتْنَ", "quran": false, "notUsed": false, "spoken": "audio/83fc7e31020b04022bb6.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "47:7", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4552.mp3", "translation": {"en": {"text": "O ye who believe! If ye help Allah, He will help you and will make your foothold firm.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey iman edenler! Eğer siz Allah'ın dinine yardım ederseniz Allah da size yardım eder ve ayaklarınızı sabit tutar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے ایمان والو اگر تم دین خدا کی مدد کرو گے اللہ تمہاری مدد کرے گا اور تمہارے قدم جمادے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hai orang-orang mukmin, jika kamu menolong (agama) Allah, niscaya Dia akan menolongmu dan meneguhkan kedudukanmu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَٰٓأَيُّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَنصُرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَنصُرْكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيُثَبِّتْ", "hit": true, "audio": "audio/54390877fec1844f063f.m4a", "gloss": {"bs": "i učvrstit će", "en": "and He will make firm", "tr": "ve sağlamlaştıracak", "fr": "et Il raffermira", "id": "dan Dia akan meneguhkan", "ur": "اور وہ ثابت قدم رکھے گا", "bn": "এবং তিনি দৃঢ় করবেন", "fa": "و استوار می‌کند"}}, {"text": "أَقْدَامَكُمْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "17:74", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2103.mp3", "translation": {"en": {"text": "And if We had not made thee wholly firm thou mightest almost have inclined unto them a little.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer biz sana sebat vermemiş olsaydık, nerdeyse sen onlara birazcık meyledecektin.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر ہم تمہیں ثابت قدم نہ رکھتے تو قریب تھا کہ تم ان کی طرف کچھ تھوڑا سا جھکتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan kalau Kami tidak memperkuat (hati)mu, niscaya kamu hampir-hampir condong sedikit kepada mereka,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَوْلَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "ثَبَّتْنَٰكَ", "hit": true, "audio": "audio/3c07d5c3708d371579fd.m4a", "gloss": {"bs": "učvrstili smo te", "en": "We made you firm", "tr": "seni sağlamlaştırdık", "fr": "Nous t'avons raffermi", "id": "Kami meneguhkanmu", "ur": "ہم نے تمہیں ثابت قدم رکھا", "bn": "আমরা তোমাকে দৃঢ় করেছি", "fa": "تو را استوار کردیم"}}, {"text": "لَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "كِدتَّ", "hit": false, "audio": null, "gloss":