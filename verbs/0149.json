io/6f5829c683c72a120b9a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَنْجِي", "plain": "أَنْجِي", "quran": false, "notUsed": false, "spoken": "audio/fd358a5250fe0fd8aac8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَنْجِيَا", "plain": "أَنْجِيَا", "quran": false, "notUsed": false, "spoken": "audio/10c8e7fa792872609bf1.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَنْجُوا", "plain": "أَنْجُوا", "quran": false, "notUsed": false, "spoken": "audio/266093c9d6ca47155814.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَنْجِينَ", "plain": "أَنْجِينَ", "quran": false, "notUsed": false, "spoken": "audio/09868da1af50dc17f344.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "26:65", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2997.mp3", "translation": {"en": {"text": "And We saved Moses and those with him, every one;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa ve beraberindekilerin hepsini kurtardık,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے بچالیا موسیٰ اور اس کے سب ساتھ والوں کو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami selamatkan Musa dan orang-orang yang besertanya semuanya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنجَيْنَا", "hit": true, "audio": "audio/0cf4d64e04dc1eeb07ae.m4a", "gloss": {"bs": "i spasili smo", "en": "and We saved", "tr": "ve kurtardık", "fr": "et Nous avons sauvé", "id": "dan Kami menyelamatkan", "ur": "اور ہم نے نجات دی", "bn": "এবং আমরা মুক্তি দিলাম", "fa": "و نجات دادیم"}}, {"text": "مُوسَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "مَّعَهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْمَعِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:88", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2571.mp3", "translation": {"en": {"text": "Then we heard his prayer and saved him from the anguish. Thus we save believers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz de duasını kabul ile icabet ettik, kendisini üzüntüden kurtardık. İşte biz iman edenleri böyle kurtarırız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ہم نے اس کی پکار سن لی اور سے غم سے نجات بخشی اور ایسی ہی نجات دیں گے مسلمانوں کو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Kami telah memperkenankan doanya dan menyelamatkannya dari pada kedukaan. Dan demikianlah Kami selamatkan orang-orang yang beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱسْتَجَبْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَجَّيْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْغَمِّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَكَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نُۨجِى", "hit": true, "audio": "audio/1219e01cb8318206a1bd.m4a", "gloss": {"en": "we save", "bs": "spašavamo", "tr": "kurtarırız", "fr": "nous sauvons", "id": "kami menyelamatkan", "ur": "ہم نجات دیتے ہیں", "bn": "আমরা রক্ষা করি", "fa": "نجات می‌دهیم"}}, {"text": "ٱلْمُؤْمِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "61:10", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5173.mp3", "translation": {"en": {"text": "O ye who believe! Shall I show you a commerce that will save you from a painful doom?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey İman edenler! Sizi acı bir azabdan kurtaracak ticareti size göstereyim mi?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے ایمان والو کیا میں بتادوں وہ تجارت جو تمہیں دردناک عذاب سے بچالے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hai orang-orang yang beriman, sukakah kamu aku tunjukkan suatu perniagaan yang dapat menyelamatkanmu dari azab yang pedih?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَٰٓأَيُّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "هَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَدُلُّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "تِجَٰرَةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "تُنجِيكُم", "hit": true, "audio": "audio/658fc64081d6934430d6.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": ["antum"], "mood": "indicative"}]}, {"text": "مِّنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابٍ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلِيمٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "70:14", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5389.mp3", "translation": {"en": {"text": "And all that are in the earth, if then it might deliver him.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve yeryüzünde bulunanların hepsini ki, tek kendini kurtarabilsin.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جتنے زمین میں ہیں سب پھر یہ بدلہ دنیا اسے بچالے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang di atas bumi seluruhnya kemudian (mengharapkan) tebusan itu dapat menyelamatkannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "جَمِيعًا", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "يُنجِيهِ", "hit": true, "audio": "audio/62afd0c7779cb5724fa5.m4a", "gloss": {"bs": "spasi ga", "en": "it saves him", "tr": "onu kurtarır", "fr": "cela le sauve", "id": "ia menyelamatkannya", "ur": "وہ اسے بچا لے", "bn": "তা তাকে মুক্তি দেয়", "fa": "او را نجات می‌دهد"}}]}], "forms": [{"arabic": "فَأَنجَيْنَٰهُ", "count": 6, "first": "7:64", "audio": "audio/69472273a5d681a44345.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["huwa"]}], "gloss": {"en": "so we saved him", "bs": "pa smo ga spasili", "tr": "böylece onu kurtardık", "fr": "alors nous l'avons sauvé", "id": "maka kami telah menyelamatkannya", "ur": "پس ہم نے اسے نجات دی", "bn": "অতএব আমরা তাকে রক্ষা করলাম", "fa": "پس او را نجات دادیم"}}, {"arabic": "أَنجَيْنَٰكُم", "count": 2, "first": "7:141", "audio": "audio/4f4bafaaef668d715c11.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["antum"]}], "gloss": {"en": "we saved you (all)", "bs": "spasili smo vas", "tr": "sizi kurtardık", "fr": "nous vous avons sauvés", "id": "kami telah menyelamatkan kalian", "ur": "ہم نے تمہیں نجات دی", "bn": "আমরা তোমাদের রক্ষা করেছি", "fa": "شما را نجات دادیم"}}, {"arabic": "أَنجَيْنَا", "count": 2, "first": "7:165", "audio": "audio/e4c505d8bf7b9953c0d2.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "glo