[{"id":"aflaha-3-200-9","words":["verb:aflaha"],"options":[{"bs":"uspijevate","en":"you (all) succeed"},{"bs":"uspijevaju","en":"they succeed"},{"bs":"uspijeva","en":"he/it succeeds"},{"bs":"uspjeli su","en":"has succeeded"}],"ref":"3:200","answerWord":"تُفْلِحُونَ","answerSound":"audio/143593dd168aea2e8bba.m4a","quranTranslation":{"text":"O ye who believe! Endure, outdo all others in endurance, be ready, and observe your duty to Allah, in order that ye may succeed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uspjeti, biti uspješan","en":"to succeed, to prosper"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","ٱصْبِرُوا۟","وَصَابِرُوا۟","وَرَابِطُوا۟","وَٱتَّقُوا۟","ٱللَّهَ","لَعَلَّكُمْ","تُفْلِحُونَ"],"marked":[9],"facts":{"verb":"أَفْلَحَ"}},{"id":"aflaha-10-77-9","words":["verb:aflaha"],"options":[{"bs":"uspijeva","en":"he/it succeeds"},{"bs":"uspijevaju","en":"they succeed"},{"bs":"uspjeli su","en":"has succeeded"},{"bs":"uspijevate","en":"you (all) succeed"}],"ref":"10:77","answerWord":"يُفْلِحُ","answerSound":"audio/cc160b516bc22ac9d512.m4a","quranTranslation":{"text":"Moses said: Speak ye (so) of the Truth when it hath come unto you? Is this magic? Now magicians thrive not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uspjeti, biti uspješan","en":"to succeed, to prosper"},"passage":["قَالَ","مُوسَىٰٓ","أَتَقُولُونَ","لِلْحَقِّ","لَمَّا","جَآءَكُمْ","أَسِحْرٌ","هَٰذَا","وَلَا","يُفْلِحُ","ٱلسَّٰحِرُونَ"],"marked":[9],"facts":{"verb":"أَفْلَحَ"}},{"id":"aflaha-23-1-1","words":["verb:aflaha"],"options":[{"bs":"uspjeli su","en":"has succeeded"},{"bs":"uspijeva","en":"he/it succeeds"},{"bs":"uspijevate","en":"you (all) succeed"},{"bs":"uspijevaju","en":"they succeed"}],"ref":"23:1","answerWord":"أَفْلَحَ","answerSound":"audio/af20e16c1637749a7f15.m4a","quranTranslation":{"text":"Successful indeed are the believers","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uspjeti, biti uspješan","en":"to succeed, to prosper"},"passage":["قَدْ","أَفْلَحَ","ٱلْمُؤْمِنُونَ"],"marked":[1],"facts":{"verb":"أَفْلَحَ"}},{"id":"aflaha-10-69-8","words":["verb:aflaha"],"options":[{"bs":"uspijevaju","en":"they succeed"},{"bs":"uspijevate","en":"you (all) succeed"},{"bs":"uspjeli su","en":"has succeeded"},{"bs":"uspijeva","en":"he/it succeeds"}],"ref":"10:69","answerWord":"يُفْلِحُونَ","answerSound":"audio/b7de3c5370f495457e8c.m4a","quranTranslation":{"text":"Say: Verily those who invent a lie concerning Allah will not succeed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uspjeti, biti uspješan","en":"to succeed, to prosper"},"passage":["قُلْ","إِنَّ","ٱلَّذِينَ","يَفْتَرُونَ","عَلَى","ٱللَّهِ","ٱلْكَذِبَ","لَا","يُفْلِحُونَ"],"marked":[8],"facts":{"verb":"أَفْلَحَ"}},{"id":"aflaha-18-20-10","words":["verb:aflaha"],"options":[{"bs":"uspijevate","en":"you (all) succeed"},{"bs":"uspijevaju","en":"they succeed"},{"bs":"uspjeli su","en":"has succeeded"},{"bs":"uspijeva","en":"he/it succeeds"}],"ref":"18:20","answerWord":"تُفْلِحُوٓا۟","answerSound":"audio/c7a2894d43faafe467a7.m4a","quranTranslation":{"text":"For they, if they should come to know of you, will stone you or turn you back to their religion; then ye will never prosper.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uspjeti, biti uspješan","en":"to succeed, to prosper"},"passage":["إِنَّهُمْ","إِن","يَظْهَرُوا۟","عَلَيْكُمْ","يَرْجُمُوكُمْ","أَوْ","يُعِيدُوكُمْ","فِى","مِلَّتِهِمْ","وَلَن","تُفْلِحُوٓا۟","إِذًا","أَبَدًا"],"marked":[10],"facts":{"verb":"أَفْلَحَ"}},{"id":"bala-67-2-4","words":["verb:bala"],"options":[{"bs":"da vas iskuša","en":"so that he/it may test you (all)"},{"bs":"iskušali smo ih","en":"We tested them"},{"bs":"da me iskuša","en":"so that he/it may test me"},{"bs":"da ih iskušamo","en":"so that we may test them"}],"ref":"67:2","answerWord":"لِيَبْلُوَكُمْ","answerSound":"audio/261ed83cb4e91f98c379.m4a","quranTranslation":{"text":"Who hath created life and death that He may try you which of you is best in conduct; and He is the Mighty, the Forgiving,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"iskušati","en":"to test, to try"},"passage":["ٱلَّذِى","خَلَقَ","ٱلْمَوْتَ","وَٱلْحَيَوٰةَ","لِيَبْلُوَكُمْ","أَيُّكُمْ","أَحْسَنُ","عَمَلًا","وَهُوَ","ٱلْعَزِيزُ","ٱلْغَفُورُ"],"marked":[4],"facts":{"verb":"بَلَا"}},{"id":"bala-5-94-3","words":["verb:bala"],"options":[{"bs":"zaista će vas iskušati","en":"surely he/it will test you (all)"},{"bs":"da me iskuša","en":"so that he/it may test me"},{"bs":"i iskušavamo vas","en":"and we test you (all)"},{"bs":"da ih iskušamo","en":"so that we may test them"}],"ref":"5:94","answerWord":"لَيَبْلُوَنَّكُمُ","answerSound":"audio/94b8252c56da06c52d5d.m4a","quranTranslation":{"text":"O ye who believe! Allah will surely try you somewhat (in the matter) of the game which ye take with your hands and your spears, that Allah may know him who feareth Him in secret. Whoso transgresseth after this, for him there is a painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"iskušati","en":"to test, to try"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","لَيَبْلُوَنَّكُمُ","ٱللَّهُ","بِشَىْءٍ","مِّنَ","ٱلصَّيْدِ","تَنَالُهُۥٓ","أَيْدِيكُمْ","وَرِمَاحُكُمْ","لِيَعْلَمَ","ٱللَّهُ","مَن","يَخَافُهُۥ","بِٱلْغَيْبِ","فَمَنِ","ٱعْتَدَىٰ","بَعْدَ","ذَٰلِكَ","فَلَهُۥ","عَذَابٌ","أَلِيمٌ"],"marked":[3],"facts":{"verb":"بَلَا"}},{"id":"bala-7-163-23","words":["verb:bala"],"options":[{"bs":"iskušavamo ih","en":"we test them"},{"bs":"da me iskuša","en":"so that he/it may test me"},{"bs":"da vas iskuša","en":"so that he/it may test you (all)"},{"bs":"i iskušavamo vas","en":"and we test you (all)"}],"ref":"7:163","answerWord":"نَبْلُوهُم","answerSound":"audio/55aa4835f011de1b4f5d.m4a","quranTranslation":{"text":"Ask them (O Muhammad) of the township that was by the sea, how they did break the Sabbath, how their big fish came unto them visibly upon their Sabbath day and on a day when they did not keep Sabbath came they not unto them. Thus did We try them for that they were evil-livers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"iskušati","en":"to test, to try"},"passage":["وَسْـَٔلْهُمْ","عَنِ","ٱلْقَرْيَةِ","ٱلَّتِى","كَانَتْ","حَاضِرَةَ","ٱلْبَحْرِ","إِذْ","يَعْدُونَ","فِى","ٱلسَّبْتِ","إِذْ","تَأْتِيهِمْ","حِيتَانُهُمْ","يَوْمَ","سَبْتِهِمْ","شُرَّعًا","وَيَوْمَ","لَا","يَسْبِتُونَ","لَا","تَأْتِيهِمْ","كَذَٰلِكَ","نَبْلُوهُم","بِمَا","كَانُوا۟","يَفْسُقُونَ"],"marked":[23],"facts":{"verb":"بَلَا"}},{"id":"bala-7-168-9","words":["verb:bala"],"options":[{"bs":"i iskušali smo ih","en":"and we tested them"},{"bs":"iskušava vas","en":"he/it tests you (all)"},{"bs":"i sigurno ćemo vas iskušati","en":"and We will surely test you"},{"bs":"da iskuša","en":"so that he/it may test"}],"ref":"7:168","answerWord":"وَبَلَوْنَٰهُم","answerSound":"audio/a1f3c23bee2deafd0106.m4a","quranTranslation":{"text":"And We have sundered them in the earth as (separate) nations. Some of them are righteous, and some far from that. And We have tried them with good things and evil things that haply they might return.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"iskušati","en":"to test, to try"},"passage":["وَقَطَّعْنَٰهُمْ","فِى","ٱلْأَرْضِ","أُمَمًا","مِّنْهُمُ","ٱلصَّٰلِحُونَ","وَمِنْهُمْ","دُونَ","ذَٰلِكَ","وَبَلَوْنَٰهُم","بِٱلْحَسَنَٰتِ","وَٱلسَّيِّـَٔاتِ","لَعَلَّهُمْ","يَرْجِعُونَ"],"marked":[9],"facts":{"verb":"بَلَا"}},{"id":"bala-18-7-7","words":["verb:bala"],"options":[{"bs":"da ih iskušamo","en":"so that we may test them"},{"bs":"da iskuša","en":"so that he/it may test"},{"bs":"da me iskuša","en":"so that he/it may test me"},{"bs":"i iskušavamo vas","en":"and we test you (all)"}],"ref":"18:7","answerWord":"لِنَبْلُوَهُمْ","answerSound":"audio/1634cb45d89d13db0ce3.m4a","quranTranslation":{"text":"Lo! We have placed all that is on the earth as an ornament thereof that We may try them: which of them is best in conduct.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"iskušati","en":"to test, to try"},"passage":["إِنَّا","جَعَلْنَا","مَا","عَلَى","ٱلْأَرْضِ","زِينَةً","لَّهَا","لِنَبْلُوَهُمْ","أَيُّهُمْ","أَحْسَنُ","عَمَلًا"],"marked":[7],"facts":{"verb":"بَلَا"}},{"id":"bala-21-35-4","words":["verb:bala"],"options":[{"bs":"i iskušavamo vas","en":"and we test you (all)"},{"bs":"iskušali smo ih","en":"We tested them"},{"bs":"da iskuša","en":"so that he/it may test"},{"bs":"da me iskuša","en":"so that he/it may test me"}],"ref":"21:35","answerWord":"وَنَبْلُوكُم","answerSound":"audio/75163b6a2e24bd11fd33.m4a","quranTranslation":{"text":"Every soul must taste of death, and We try you with evil and with good, for ordeal. And unto Us ye will be returned.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"iskušati","en":"to test, to try"},"passage":["كُلُّ","نَفْسٍ","ذَآئِقَةُ","ٱلْمَوْتِ","وَنَبْلُوكُم","بِٱلشَّرِّ","وَٱلْخَيْرِ","فِتْنَةً","وَإِلَيْنَا","تُرْجَعُونَ"],"marked":[4],"facts":{"verb":"بَلَا"}},{"id":"bala-47-31-0","words":["verb:bala"],"options":[{"bs":"i sigurno ćemo vas iskušati","en":"and We will surely test you"},{"bs":"da vas iskuša","en":"so that he/it may test you (all)"},{"bs":"da ih iskušamo","en":"so that we may test them"},{"bs":"i iskušali smo ih","en":"and we tested them"}],"ref":"47:31","answerWord":"وَلَنَبْلُوَنَّكُمْ","answerSound":"audio/849e95467ff399a8b034.m4a","quranTranslation":{"text":"And verily We shall try you till We know those of you who strive hard (for the cause of Allah) and the steadfast, and till We test your record.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"iskušati","en":"to test, to try"},"passage":["وَلَنَبْلُوَنَّكُمْ","حَتَّىٰ","نَعْلَمَ","ٱلْمُجَٰهِدِينَ","مِنكُمْ","وَٱلصَّٰبِرِينَ","وَنَبْلُوَا۟","أَخْبَارَكُمْ"],"marked":[0],"facts":{"verb":"بَلَا"}},{"id":"bala-47-31-6","words":["verb:bala"],"options":[{"bs":"i da provjerimo","en":"and We test"},{"bs":"da ih iskušamo","en":"so that we may test them"},{"bs":"iskušali smo ih","en":"We tested them"},{"bs":"i iskušavamo vas","en":"and we test you (all)"}],"ref":"47:31","answerWord":"وَنَبْلُوَا۟","answerSound":"audio/6579f7fff72e8bc5e852.m4a","quranTranslation":{"text":"And verily We shall try you till We know those of you who strive hard (for the cause of Allah) and the steadfast, and till We test your record.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"iskušati","en":"to test, to try"},"passage":["وَلَنَبْلُوَنَّكُمْ","حَتَّىٰ","نَعْلَمَ","ٱلْمُجَٰهِدِينَ","مِنكُمْ","وَٱلصَّٰبِرِينَ","وَنَبْلُوَا۟","أَخْبَارَكُمْ"],"marked":[6],"facts":{"verb":"بَلَا"}},{"id":"bala-68-17-1","words":["verb:bala"],"options":[{"bs":"iskušali smo ih","en":"We tested them"},{"bs":"da vas iskuša","en":"so that he/it may test you (all)"},{"bs":"iskušavamo ih","en":"we test them"},{"bs":"da me iskuša","en":"so that he/it may test me"}],"ref":"68:17","answerWord":"بَلَوْنَٰهُمْ","answerSound":"audio/fc5b355ecb00ae3726df.m4a","quranTranslation":{"text":"Lo! We have tried them as We tried the owners of the garden when they vowed that they would pluck its fruit next morning,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"iskušati","en":"to test, to try"},"passage":["إِنَّا","بَلَوْنَٰهُمْ","كَمَا","بَلَوْنَآ","أَصْحَٰبَ","ٱلْجَنَّةِ","إِذْ","أَقْسَمُوا۟","لَيَصْرِمُنَّهَا","مُصْبِحِينَ"],"marked":[1],"facts":{"verb":"بَلَا"}},{"id":"bala-68-17-3","words":["verb:bala"],"options":[{"bs":"iskušali smo","en":"We tested"},{"bs":"da me iskuša","en":"so that he/it may test me"},{"bs":"i iskušavamo vas","en":"and we test you (all)"},{"bs":"zaista će vas iskušati","en":"surely he/it will test you (all)"}],"ref":"68:17","answerWord":"بَلَوْنَآ","answerSound":"audio/be25ac41014980d672d2.m4a","quranTranslation":{"text":"Lo! We have tried them as We tried the owners of the garden when they vowed that they would pluck its fruit next morning,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"iskušati","en":"to test, to try"},"passage":["إِنَّا","بَلَوْنَٰهُمْ","كَمَا","بَلَوْنَآ","أَصْحَٰبَ","ٱلْجَنَّةِ","إِذْ","أَقْسَمُوا۟","لَيَصْرِمُنَّهَا","مُصْبِحِينَ"],"marked":[3],"facts":{"verb":"بَلَا"}},{"id":"yaisa-29-23-6","words":["verb:yaisa"],"options":[{"bs":"očajali su","en":"they despaired"},{"bs":"očajao je","en":"he/it despaired"},{"bs":"očajava","en":"he/it despairs"},{"bs":"očajavate","en":"you (all) despair"}],"ref":"29:23","answerWord":"يَئِسُوا۟","answerSound":"audio/44c32e7b3a544103860c.m4a","quranTranslation":{"text":"Those who disbelieve in the revelations of Allah and in (their) Meeting with Him, such have no hope of My mercy. For such there is a painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"očajavati, izgubiti nadu","en":"to despair, to give up hope"},"passage":["وَٱلَّذِينَ","كَفَرُوا۟","بِـَٔايَٰتِ","ٱللَّهِ","وَلِقَآئِهِۦٓ","أُو۟لَٰٓئِكَ","يَئِسُوا۟","مِن","رَّحْمَتِى","وَأُو۟لَٰٓئِكَ","لَهُمْ","عَذَابٌ","أَلِيمٌ"],"marked":[6],"facts":{"verb":"يَئِسَ"}},{"id":"yaisa-12-87-7","words":["verb:yaisa"],"options":[{"bs":"očajavate","en":"you (all) despair"},{"bs":"očajali su","en":"they despaired"},{"bs":"očajava","en":"he/it despairs"},{"bs":"očajao je","en":"he/it despaired"}],"ref":"12:87","answerWord":"تَا۟يْـَٔسُوا۟","answerSound":"audio/6865423981ffe179b4aa.m4a","quranTranslation":{"text":"Go, O my sons, and ascertain concerning Joseph and his brother, and despair not of the Spirit of Allah. Lo! none despaireth of the Spirit of Allah save disbelieving folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"očajavati, izgubiti nadu","en":"to despair, to give up hope"},"passage":["يَٰبَنِىَّ","ٱذْهَبُوا۟","فَتَحَسَّسُوا۟","مِن","يُوسُفَ","وَأَخِيهِ","وَلَا","تَا۟يْـَٔسُوا۟","مِن","رَّوْحِ","ٱللَّهِ","إِنَّهُۥ","لَا","يَا۟يْـَٔسُ","مِن","رَّوْحِ","ٱللَّهِ","إِلَّا","ٱلْقَوْمُ","ٱلْكَٰفِرُونَ"],"marked":[7],"facts":{"verb":"يَئِسَ"}},{"id":"yaisa-12-87-13","words":["verb:yaisa"],"options":[{"bs":"očajava","en":"he/it despairs"},{"bs":"očajale su","en":"they despaired"},{"bs":"očajao je","en":"he/it despaired"},{"bs":"očajavate","en":"you (all) despair"}],"ref":"12:87","answerWord":"يَا۟يْـَٔسُ","answerSound":"audio/238870bceb7ed4ae524a.m4a","quranTranslation":{"text":"Go, O my sons, and ascertain concerning Joseph and his brother, and despair not of the Spirit of Allah. Lo! none despaireth of the Spirit of Allah save disbelieving folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"očajavati, izgubiti nadu","en":"to despair, to give up hope"},"passage":["يَٰبَنِىَّ","ٱذْهَبُوا۟","فَتَحَسَّسُوا۟","مِن","يُوسُفَ","وَأَخِيهِ","وَلَا","تَا۟يْـَٔسُوا۟","مِن","رَّوْحِ","ٱللَّهِ","إِنَّهُۥ","لَا","يَا۟يْـَٔسُ","مِن","رَّوْحِ","ٱللَّهِ","إِلَّا","ٱلْقَوْمُ","ٱلْكَٰفِرُونَ"],"marked":[13],"facts":{"verb":"يَئِسَ"}},{"id":"yaisa-65-4-1","words":["verb:yaisa"],"options":[{"bs":"očajale su","en":"they despaired"},{"bs":"očajava","en":"he/it despairs"},{"bs":"očajavate","en":"you (all) despair"},{"bs":"očajao je","en":"he/it despaired"}],"ref":"65:4","answerWord":"يَئِسْنَ","answerSound":"audio/64f9b18cc15fcd9cc258.m4a","quranTranslation":{"text":"And for such of your women as despair of menstruation, if ye doubt, their period (of waiting) shall be three months, along with those who have it not. And for those with child, their period shall be till they bring forth their burden. And whosoever keepeth his duty to Allah, He maketh his course easy for him.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"očajavati, izgubiti nadu","en":"to despair, to give up hope"},"passage":["وَٱلَّٰٓـِٔى","يَئِسْنَ","مِنَ","ٱلْمَحِيضِ","مِن","نِّسَآئِكُمْ","إِنِ","ٱرْتَبْتُمْ","فَعِدَّتُهُنَّ","ثَلَٰثَةُ","أَشْهُرٍ","وَٱلَّٰٓـِٔى","لَمْ","يَحِضْنَ","وَأُو۟لَٰتُ","ٱلْأَحْمَالِ","أَجَلُهُنَّ","أَن","يَضَعْنَ","حَمْلَهُنَّ","وَمَن","يَتَّقِ","ٱللَّهَ","يَجْعَل","لَّهُۥ","مِنْ","أَمْرِهِۦ","يُسْرًا"],"marked":[1],"facts":{"verb":"يَئِسَ"}}]