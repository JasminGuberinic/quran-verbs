xt": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَضِيعِي", "plain": "أَضِيعِي", "quran": false, "notUsed": false, "spoken": "audio/d2b8228e2d4fc36e49df.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَضِيعَا", "plain": "أَضِيعَا", "quran": false, "notUsed": false, "spoken": "audio/2b66734454636cf0b02b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَضِيعُوا", "plain": "أَضِيعُوا", "quran": false, "notUsed": false, "spoken": "audio/3f69a03954706483c535.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَضِعْنَ", "plain": "أَضِعْنَ", "quran": false, "notUsed": false, "spoken": "audio/3c6eaf21587033a55879.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "11:115", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1588.mp3", "translation": {"en": {"text": "And have patience, (O Muhammad), for lo! Allah loseth not the wages of the good.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve sabret! Çünkü Allah iyilik edenlerin mükafatını yitirmez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور صبر کرو کہ اللہ نیکوں کا نیگ (اجر) ضائع نہیں کرتا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan bersabarlah, karena sesungguhnya Allah tiada menyia-nyiakan pahala orang-orang yang berbuat kebaikan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱصْبِرْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُضِيعُ", "hit": true, "audio": "audio/000b4b7976083b06c163.m4a", "gloss": {"bs": "ne dopušta da propadne", "en": "does not let be lost", "tr": "boşa gitmesine izin vermez", "fr": "ne laisse pas perdre", "id": "tidak menyia-nyiakan", "ur": "ضائع نہیں کرتا", "bn": "নষ্ট হতে দেন না", "fa": "ضایع نمی‌کند"}}, {"text": "أَجْرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُحْسِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:170", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1124.mp3", "translation": {"en": {"text": "And as for those who make (men) keep the Scripture, and establish worship - lo! We squander not the wages of reformers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kitaba sarılanlara ve namazı kılmaya devam edenlere gelince, biz o iyilerin ecrini hiçbir zaman yitirmeyiz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جو کتاب کو مضبوط تھامتے ہیں اور انہوں نے نماز قائم رکھی، ہم نیکوں کا نیگ (اجر) نہیں گنواتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang berpegang teguh dengan Al Kitab (Taurat) serta mendirikan shalat, (akan diberi pahala) karena sesungguhnya Kami tidak menyia-nyiakan pahala orang-orang yang mengadakan perbaikan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُمَسِّكُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْكِتَٰبِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَقَامُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّلَوٰةَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "نُضِيعُ", "hit": true, "audio": "audio/b406dbc5277b90eeb6b9.m4a", "gloss": {"en": "we lose", "bs": "gubimo", "tr": "kaybederiz", "fr": "nous perdons", "id": "kami merugi", "ur": "ہم کھو دیتے ہیں", "bn": "আমরা হারাই", "fa": "از دست می‌دهیم"}}, {"text": "أَجْرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُصْلِحِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:59", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2309.mp3", "translation": {"en": {"text": "Now there hath succeeded them a later generation whom have ruined worship and have followed lusts. But they will meet deception.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra bunların ardından öyle bir nesil geldi ki, namazı terkettiler, heva ve heveslerine uydular; onlar bu taşkınlıklarının karşılığını mutlaka göreceklerdir. (Cehennemdeki \"Gayya\" vadisini boylayacaklardır.)", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ان کے بعد ان کی جگہ وہ ناخلف آئے جنہوں نے نمازیں گنوائیں اور اپنی خواہشوں کے پیچھے ہوئے تو عنقریب وہ دوزخ میں غی کا جنگل پائیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka datanglah sesudah mereka, pengganti (yang jelek) yang menyia-nyiakan shalat dan memperturutkan hawa nafsunya, maka mereka kelak akan menemui kesesatan,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَخَلَفَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْدِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلْفٌ", "hit": false, "audio": null, "gloss": null}, {"text": "أَضَاعُوا۟", "hit": true, "audio": "audio/52b69c19214b4b691d79.m4a", "gloss": {"bs": "su zapustili", "en": "they neglected", "tr": "ihmal ettiler", "fr": "ils ont négligé", "id": "mereka menyia-nyiakan", "ur": "انہوں نے ضائع کر دیا", "bn": "তারা অবহেলা করেছে", "fa": "ضایع کردند"}}, {"text": "ٱلصَّلَوٰةَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱتَّبَعُوا۟", "hit": fals