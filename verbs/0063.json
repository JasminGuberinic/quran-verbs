udio/e92b702ed25b9c9ca8c4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "قَٰتِلْ", "plain": "قَاتِلْ", "quran": true, "notUsed": false, "spoken": "audio/cfa66e929eb6ae2f1c57.m4a", "recited": "audio/9c81e532cf50bedbef5a.m4a", "recitedText": "فَقَٰتِلْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "قَاتِلِي", "plain": "قَاتِلِي", "quran": false, "notUsed": false, "spoken": "audio/96167a852b1d6a5f191d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "قَاتِلَا", "plain": "قَاتِلَا", "quran": false, "notUsed": false, "spoken": "audio/b2e228bd67002491d709.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "قَٰتِلُوا۟", "plain": "قَاتِلُوا", "quran": true, "notUsed": false, "spoken": "audio/7374f4a805a7796bcdbe.m4a", "recited": "audio/490e70491c695d58d031.m4a", "recitedText": "قَٰتِلُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "قَاتِلْنَ", "plain": "قَاتِلْنَ", "quran": false, "notUsed": false, "spoken": "audio/64245dd3d8154cc0d827.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "3:111", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/404.mp3", "translation": {"en": {"text": "They will not harm you save a trifling hurt, and if they fight against you they will turn and flee. And afterward they will not be helped.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar size eziyetten başka bir zarar veremezler. Eğer sizinle savaşmaya kalkışsalar, size arkalarını dönüp kaçarlar. Sonra kendilerine yardım da edilmez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ تمہارے کچھ نہ بگاڑیں گے مگر یہی ستانا اور اگر تم سے لڑیں تو تمہارے سامنے سے پیٹھ پھیر جائیں گے پھر ان کی مدد نہ ہوگی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka sekali-kali tidak akan dapat membuat mudharat kepada kamu, selain dari gangguan-gangguan celaan saja, dan jika mereka berperang dengan kamu, pastilah mereka berbalik melarikan diri ke belakang (kalah). Kemudian mereka tidak mendapat pertolongan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَضُرُّوكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَذًى", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِن", "hit": false, "audio": null, "gloss": null}, {"text": "يُقَٰتِلُوكُمْ", "hit": true, "audio": "audio/1e072b1b79c9570e1af9.m4a", "gloss": {"bs": "(ako) se budu borili protiv vas", "en": "(if) they fight you", "tr": "(eğer) sizinle savaşırlarsa", "fr": "(s'ils) vous combattent", "id": "(jika) mereka memerangimu", "ur": "(اگر) وہ تم سے لڑیں", "bn": "(যদি) তারা তোমাদের সাথে যুদ্ধ করে", "fa": "(اگر) با شما بجنگند"}}, {"text": "يُوَلُّوكُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَدْبَارَ", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُنصَرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:244", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/251.mp3", "translation": {"en": {"text": "Fight in the way of Allah, and know that Allah is Hearer, Knower.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O halde Allah yolunda çarpışın ve bilin ki Allah, her şeyi işitir ve bilir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور لڑو اللہ کی راہ میں اور جان لو کہ اللہ سنتا جانتا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan berperanglah kamu sekalian di jalan Allah, dan ketahuilah sesungguhnya Allah Maha Mendengar lagi Maha Mengetahui.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَٰتِلُوا۟", "hit": true, "audio": "audio/31d6ba43bdda99c66217.m4a", "gloss": {"bs": "i borite se!", "en": "and fight!", "tr": "ve savaşın!", "fr": "et combattez !", "id": "dan perangilah!", "ur": "اور لڑو!", "bn": "এবং যুদ্ধ করো!", "fa": "و بجنگید!"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "سَبِيلِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱعْلَمُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَمِيعٌ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "48:22", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4605.mp3", "translation": {"en": {"text": "And if those who disbelieve join battle with you they will take to flight, and afterward they will find no protecting friend nor helper.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer kâfirler sizinle savaşsalardı arkalarına dönüp kaçarlardı. Sonra bir dost ve yardımcı da bulamazlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر کافر تم سے لڑیں تو ضرور تمہارے مقابلہ سے پیٹھ پھیردیں گے پھر کوئی حمایتی نہ پائیں گے نہ مددگار،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sekiranya orang-orang kafir itu memerangi kamu pastilah mereka berbalik melarikan diri ke belakang (kalah) kemudian mereka tiada memperoleh pelindung dan tidak (pula) penolong.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَوْ", "hit": false