": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "ظَلَّا", "plain": "ظَلَّا", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ظَلُّوا", "plain": "ظَلُّوا", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِظْلَلْنَ", "plain": "اِظْلَلْنَ", "quran": false, "notUsed": true, "spoken": null, "recited": null, "recitedText": null}], "ayat": [{"ref": "15:14", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1816.mp3", "translation": {"en": {"text": "And even if We opened unto them a gate of heaven and they kept mounting through it,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlara gökten bir kapı açsak da oradan yukarı çıksalar,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر ہم ان کے لیے آسمان میں کوئی دروازہ کھول دیں کہ دن کو اس میں چڑھتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan jika seandainya Kami membukakan kepada mereka salah satu dari (pintu-pintu) langit, lalu mereka terus menerus naik ke atasnya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَحْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِم", "hit": false, "audio": null, "gloss": null}, {"text": "بَابًا", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمَآءِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَظَلُّوا۟", "hit": true, "audio": "audio/e1ce4f2690db67dbedb5.m4a", "gloss": {"en": "so they remained", "bs": "pa su ostali", "tr": "böylece kaldılar", "fr": "alors ils sont restés", "id": "maka mereka tetap", "ur": "پس وہ ٹھہرے", "bn": "অতএব তারা থাকল", "fa": "پس ماندند"}}, {"text": "فِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْرُجُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "16:58", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1959.mp3", "translation": {"en": {"text": "When if one of them receiveth tidings of the birth of a female, his face remaineth darkened, and he is wroth inwardly.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Halbuki onlardan birine, kız doğum haberi müjdelendiği zaman içi öfkeyle dolar, yüzü kapkara kesilir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جب ان میں کسی کو بیٹی ہونے کی خوشخبری دی جاتی ہے تو دن بھر اس کا منہ کالا رہتا ہے اور وہ غصہ کھا تا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan apabila seseorang dari mereka diberi kabar dengan (kelahiran) anak perempuan, hitamlah (merah padamlah) mukanya, dan dia sangat marah.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "بُشِّرَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَحَدُهُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْأُنثَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "ظَلَّ", "hit": true, "audio": "audio/d99ba91f11709278ff76.m4a", "gloss": {"en": "he/it remained", "bs": "ostao je", "tr": "kaldı", "fr": "il est resté", "id": "dia tetap", "ur": "وہ ٹھہرا", "bn": "সে থাকল", "fa": "ماند"}}, {"text": "وَجْهُهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "مُسْوَدًّا", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَظِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:4", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2936.mp3", "translation": {"en": {"text": "If We will, We can send down on them from the sky a portent so that their necks would remain bowed before it.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz dilersek onların üzerlerine gökten bir âyet (mucize) indiririz de, ona boyunları eğilekalır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اگر ہم چاہیں تو آسمان سے ان پر کوئی نشانی اتاریں کہ ان کے اونچے اونچے اس کے حضور جھکے رہ جائیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Jika kami kehendaki niscaya Kami menurunkan kepada mereka mukjizat dari langit, maka senantiasa kuduk-kuduk mereka tunduk kepadanya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "نَّشَأْ", "hit": false, "audio": null, "gloss": null}, {"text": "نُنَزِّلْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمَآءِ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَةً", "hit": false, "audio": null, "gloss": null}, {"text": "فَظَلَّتْ", "hit": true, "audio": "audio/07f5db1d409cc1a6c9f7.m4a", "gloss": {"en": "so she/it remained", "bs": "pa je ostala", "tr": "böylece kaldı", "fr": "alors elle est restée", "id": "maka dia tetap", "ur": "پس وہ ٹھہری", "bn": "অতএব সে থাকল", "fa": "پس ماند"}}, {"text": "أَعْنَٰقُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "خَٰضِعِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:71", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3003.mp3", "translation": {"en": {"text": "They said: We worship idols, and are ever devoted unto them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Birtakım putlara taparız da onlar sayesinde toplanırız\" dediler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے ہم بتوں کو پوجتے ہیں پھر ان کے سامنے آسن مارے رہتے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka menjawab: \"Kami menyembah berhala-berhala dan kami senantiasa tekun menyembahnya\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "نَعْبُدُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَصْنَامًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَنَظَلُّ", "hit": true, "audio": "audio/d7338de18bd93e591c84.m4a", "gloss": {"bs": "i ostajemo", "en": "and we remain", "tr": "ve kalırız", "fr": "et nous restons", "id": "dan kami tetap", "ur": "اور ہم رہ جاتے ہیں", "bn": "এবং আমরা থেকে যাই", "fa": "پس می‌مانیم"}}, {"text": "لَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "عَٰكِفِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "56:65", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5044.mp3", "translation": {"en": {"text": "If We willed, We verily could make it chaff, then would ye cease not to exclaim:", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Dileseydik, onu kuru bir çöp yapardık. Hayret eder dururdunuz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہم چاہیں تو اسے روندن (پامال) کردیں پھر تم باتیں بناتے رہ جاؤ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kalau Kami kehendaki, benar-benar Kami jadikan dia hancur dan kering, maka jadilah kamu heran dan tercengang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{