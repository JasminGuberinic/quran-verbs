bn": "আমি প্রায়", "fa": "نزدیک است من", "fr": "j'ai failli", "id": "aku hampir", "tr": "neredeyse", "ur": "قریب ہوں"}}, {"arabic": "أَنَامُ", "target": false, "translation": {"bs": "ne zaspim", "en": "sleep", "bn": "ঘুমিয়ে পড়ি", "fa": "بخوابم", "fr": "m'endormir", "id": "tertidur", "tr": "uykuya dalıyorum", "ur": "سو جاؤں"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "u", "en": "in", "bn": "মধ্যে", "fa": "در", "fr": "dans", "id": "di", "tr": "içinde", "ur": "میں"}}, {"arabic": "الْقِطَارِ", "target": false, "translation": {"bs": "vozu", "en": "the train", "bn": "ট্রেনে", "fa": "قطار", "fr": "le train", "id": "kereta itu", "tr": "tren", "ur": "ریل گاڑی"}}]}, {"arabic": "كَادُوا يَتَأَخَّرُونَ", "spoken": "audio/d1bf60942e7ef3d30d03.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Zamalo su zakasnili.", "en": "They were almost late.", "bn": "তারা প্রায় দেরি করে ফেলেছিল।", "fa": "نزدیک بود دیر کنند.", "fr": "Ils ont failli être en retard.", "id": "Mereka hampir terlambat.", "tr": "Neredeyse geç kalıyorlardı.", "ur": "وہ دیر کرنے کے قریب تھے۔"}, "independentlyReviewed": true, "words": [{"arabic": "كَادُوا", "target": true, "translation": {"bs": "zamalo su", "en": "they almost", "bn": "তারা প্রায়", "fa": "نزدیک بود آنان", "fr": "ils ont failli", "id": "mereka hampir", "tr": "neredeyse", "ur": "قریب تھے"}}, {"arabic": "يَتَأَخَّرُونَ", "target": false, "translation": {"bs": "zakasnili", "en": "are late", "bn": "দেরি করে", "fa": "دیر می‌کنند", "fr": "être en retard", "id": "terlambat", "tr": "geç kalırlar", "ur": "دیر کریں"}}]}, {"arabic": "الْكَأْسُ كَادَتْ تَسْقُطُ", "spoken": "audio/5e2d40d115ceca8ae730.m4a", "tense": "past", "pronoun": "hiya", "translation": {"bs": "Šolja je zamalo pala.", "en": "The cup almost fell.", "bn": "কাপটি প্রায় পড়ে গিয়েছিল।", "fa": "لیوان نزدیک بود بیفتد.", "fr": "La tasse a failli tomber.", "id": "Cangkir itu hampir jatuh.", "tr": "Bardak az kalsın düşüyordu.", "ur": "پیالہ گرنے کو تھا۔"}, "independentlyReviewed": true, "words": [{"arabic": "الْكَأْسُ", "target": false, "translation": {"bs": "šolja", "en": "the cup", "bn": "কাপ", "fa": "لیوان", "fr": "la tasse", "id": "cangkir", "tr": "bardak", "ur": "پیالہ"}}, {"arabic": "كَادَتْ", "target": true, "translation": {"bs": "zamalo", "en": "almost", "bn": "প্রায়", "fa": "نزدیک بود", "fr": "presque", "id": "hampir", "tr": "neredeyse", "ur": "قریب تھی"}}, {"arabic": "تَسْقُطُ", "target": false, "translation": {"bs": "je pala", "en": "falls", "bn": "পড়ে যায়", "fa": "بیفتد", "fr": "est tombée", "id": "jatuh", "tr": "düşer", "ur": "گر جائے"}}]}]}