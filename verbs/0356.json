ords": [{"arabic": "الْكَرِيمُ", "target": false, "translation": {"bs": "plemenit čovjek", "en": "the noble man", "bn": "সম্ভ্রান্ত ব্যক্তি", "fa": "مرد بزرگوار", "fr": "l'homme généreux", "id": "orang mulia itu", "tr": "cömert adam", "ur": "شریف آدمی"}}, {"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "يَسْتَضْعِفُ", "target": true, "translation": {"bs": "smatra slabim", "en": "considers weak", "bn": "দুর্বল মনে করে", "fa": "ناتوان می‌شمارد", "fr": "considère comme faible", "id": "menganggap lemah", "tr": "zayıf sayar", "ur": "کمزور سمجھتا ہے"}}, {"arabic": "أَحَدًا", "target": false, "translation": {"bs": "nikoga", "en": "one", "bn": "কাউকে", "fa": "هیچ‌کس", "fr": "quelqu'un", "id": "seorang pun", "tr": "hiç kimse", "ur": "کسی کو"}}]}]}