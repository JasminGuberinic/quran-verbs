": {"bs": "sam se pokajao", "en": "I felt regret", "bn": "আমি অনুতপ্ত হলাম", "fa": "پشیمان شدم", "fr": "j'ai regretté", "id": "aku menyesal", "tr": "pişman oldum", "ur": "میں پشیمان ہوا"}}]}, {"arabic": "لَا يَعْصُونَ وَالِدَيْهِمْ", "spoken": "audio/2a0b7596013b547084d4.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Nisu neposlušni prema svojim roditeljima.", "en": "They do not disobey their parents.", "bn": "তারা তাদের পিতামাতার অবাধ্য হয় না।", "fa": "از پدر و مادرشان نافرمانی نمی‌کنند.", "fr": "Ils ne désobéissent pas à leurs parents.", "id": "Mereka tidak mendurhakai orang tua mereka.", "tr": "Anne babalarına karşı gelmezler.", "ur": "وہ اپنے والدین کی نافرمانی نہیں کرتے۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "يَعْصُونَ", "target": true, "translation": {"bs": "su neposlušni", "en": "they disobey", "bn": "তারা অবাধ্য হয়", "fa": "نافرمانی می‌کنند", "fr": "désobéissent", "id": "mereka melanggar", "tr": "karşı gelmezler", "ur": "وہ نافرمانی کرتے ہیں"}}, {"arabic": "وَالِدَيْهِمْ", "target": false, "translation": {"bs": "prema svojim roditeljima", "en": "their parents", "bn": "তাদের পিতামাতার", "fa": "پدر و مادرشان", "fr": "à leurs parents", "id": "orang tua mereka", "tr": "anne babalarına", "ur": "ان کے والدین"}}]}]}