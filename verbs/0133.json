, "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "عَصَيْتُم", "plain": "عَصَيْتُمْ", "quran": true, "notUsed": false, "spoken": "audio/0fefe7bd1a67f8f28cdf.m4a", "recited": "audio/1322f7992fbbcdf8a40c.m4a", "recitedText": "وَعَصَيْتُم"}, {"tense": "past", "pronoun": "antunna", "arabic": "عَصَيْتُنَّ", "plain": "عَصَيْتُنَّ", "quran": false, "notUsed": false, "spoken": "audio/bcc2d6e888d14920d49c.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huwa", "arabic": "عَصَىٰ", "plain": "عَصَى", "quran": true, "notUsed": false, "spoken": "audio/756bd13be64176e03b39.m4a", "recited": "audio/f6fd188e38927b67aece.m4a", "recitedText": "فَعَصَىٰ"}, {"tense": "past", "pronoun": "hiya", "arabic": "عَصَتْ", "plain": "عَصَتْ", "quran": false, "notUsed": false, "spoken": "audio/86fc643be2469a689c43.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "huma", "arabic": "عَصَيَا", "plain": "عَصَيَا", "quran": false, "notUsed": false, "spoken": "audio/f344def21698f785dd9c.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "hum", "arabic": "عَصَوا۟", "plain": "عَصَوْا", "quran": true, "notUsed": false, "spoken": "audio/e8894f1d1237330829cf.m4a", "recited": "audio/3a3f035e427521fd1308.m4a", "recitedText": "عَصَوا۟"}, {"tense": "past", "pronoun": "hunna", "arabic": "عَصَيْنَ", "plain": "عَصَيْنَ", "quran": false, "notUsed": false, "spoken": "audio/a30762b75cf06904e333.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "ana", "arabic": "أَعْصِى", "plain": "أَعْصِي", "quran": true, "notUsed": false, "spoken": "audio/8a3914af98b66b09a7a5.m4a", "recited": "audio/d276aeea6a4827b5a43b.m4a", "recitedText": "أَعْصِى"}, {"tense": "present", "pronoun": "nahnu", "arabic": "نَعْصِي", "plain": "نَعْصِي", "quran": false, "notUsed": false, "spoken": "audio/117c981301411405b981.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "anta", "arabic": "