ain": "يَسْتَغْفِرَانِ", "quran": false, "notUsed": false, "spoken": "audio/815e2843804d3a36677b.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَسْتَغْفِرُونَ", "plain": "يَسْتَغْفِرُونَ", "quran": true, "notUsed": false, "spoken": "audio/190028fecbb9bec8d405.m4a", "recited": "audio/522b47f64b898d4e0eff.m4a", "recitedText": "يَسْتَغْفِرُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَسْتَغْفِرْنَ", "plain": "يَسْتَغْفِرْنَ", "quran": false, "notUsed": false, "spoken": "audio/f4452cbb5702e8059198.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱسْتَغْفِرْ", "plain": "اِسْتَغْفِرْ", "quran": true, "notUsed": false, "spoken": "audio/4c5be135fb56728cea04.m4a", "recited": "audio/34b009a456c72c8de7b8.m4a", "recitedText": "ٱسْتَغْفِرْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "ٱسْتَغْفِرِى", "plain": "اِسْتَغْفِرِي", "quran": true, "notUsed": false, "spoken": "audio/e7fbb3b11cb178d0728e.m4a", "recited": "audio/abe6f9312deb6dcc86c7.m4a", "recitedText": "وَٱسْتَغْفِرِى"}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِسْتَغْفِرَا", "plain": "اِسْتَغْفِرَا", "quran": false, "notUsed": false, "spoken": "audio/1a4fcdf2a40f6f72fb3b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱسْتَغْفِرُوا۟", "plain": "اِسْتَغْفِرُوا", "quran": true, "notUsed": false, "spoken": "audio/a034570f362703920c67.m4a", "recited": "audio/d52551e079d9f24c0d99.m4a", "recitedText": "ٱسْتَغْفِرُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِسْتَغْفِرْنَ", "plain": "اِسْتَغْفِرْنَ", "quran": false, "notUsed": false, "spoken": "audio/4642d04c5a6fc375c349.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "4:106", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/599.mp3", "translation": {"en": {"text": "And seek forgiveness of Allah. Lo! Allah is ever Forgiving, Merciful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah'tan bağışlanmanı dile. Şüphesiz, Allah bağışlayıcıdır, esirgeyicidir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اللہ سے معافی چاہو بیشک اللہ بخشنے والا مہربان ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan mohonlah ampun kepada Allah. Sesungguhnya Allah Maha Pengampun lagi Maha Penyayang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱسْتَغْفِرِ", "hit": true, "audio": "audio/8387d145456871da746a.m4a", "gloss": {"en": "and ask forgiveness!", "bs": "i traži oprost!", "tr": "ve bağışlanma dile!", "fr": "et demande pardon !", "id": "dan mohonlah ampun!", "ur": "اور معافی مانگ!", "bn": "এবং ক্ষমা চাও!", "fa": "و آمرزش بخواه!"}}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "غَفُورًا", "hit": false, "audio": null, "gloss": null}, {"text": "رَّحِيمًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "71:10", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5429.mp3", "translation": {"en": {"text": "And I have said: Seek pardon of your Lord. Lo! He was ever Forgiving.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Gelin, dedim, Rabbinizin sizi bağışlamasını isteyin. Çünkü o çok bağışlayıcıdır.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو میں نے کہا اپنے رب سے معافی مانگو وہ بڑا معاف فرمانے والا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "maka aku katakan kepada mereka: 'Mohonlah ampun kepada Tuhanmu, -sesungguhnya Dia adalah Maha Pengampun-,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَقُلْتُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱسْتَغْفِرُوا۟", "hit": true, "audio": "audio/d52551e079d9f24c0d99.m4a", "gloss": {"bs": "tražite oprost!", "en": "ask forgiveness!", "tr": "bağışlanma dileyin!", "fr": "demandez pardon !", "id": "mohonlah ampun!", "ur": "مغفرت مانگو!", "bn": "ক্ষমা প্রার্থনা করো!", "fa": "آمرزش بخواهید!"}}, {"text": "رَبَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "غَفَّارًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "51:18", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4693.mp3", "translation": {"en": {"text": "And ere the dawning of each day would seek forgiveness,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar seher vakitlerinde Allah'tan bağışlanma dilerlerdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور پچھلی رات استغفار کرتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan selalu memohonkan ampunan diwaktu pagi sebelum fajar.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَبِٱلْأَسْحَارِ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَغْفِرُونَ", "hit": true, "audio": "audio/522b47f64b898d4e0eff.m4a", "gloss": {"bs": "traže oprost", "en": "they ask forgiveness", "tr": "bağışlanma dilerler", "fr": "ils demandent pardon", "id": "mereka memohon ampun", "ur": "وہ مغفرت مانگتے ہیں", "bn": "তারা ক্ষমা প্রার্থনা করে", "fa": "آمرزش می‌خواهند"}}]}, {"ref": "12:98", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1694.mp3", "translation": {"en": {"text": "He said: I shall ask forgiveness for you of my Lord. Lo! He is the Forgiving, the Merciful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Dedi ki: \"Sizin için Rabbimden ilerde bağışlanma dileyeceğim. Şüphesiz o çok bağışlayıcıdır, çok merhamet edicidir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہا جلد میں تمہاری بخشش اپنے رب سے چاہو ں گا، بیشک وہی بخشنے والا مہربان ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ya'qub berkata: \"Aku akan memohonkan ampun bagimu kepada Tuhanku. Sesungguhnya Dialah Yang Maha Pengampun lagi Maha Penyayang\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَوْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَسْتَغْفِرُ", "hit": true, "audio": "audio/46850a6074c20a3cc93d.m4a", "gloss": {"en": "I ask forgiveness", "bs": "tražim oprost", "tr": "bağışlanma dilerim", "fr": "je demande pardon", "id": "aku memohon ampun", "ur": "میں معافی مانگتا ہوں", "bn": "আমি ক্ষমা চাই", "fa": "آمرزش می‌خواهم"}}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْغَفُورُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّحِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "12:29", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anti", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1625.mp3", "translation": {"en": {"text": "O Joseph! Turn away from this, and thou, (O woman), ask forgiveness for thy sin. Lo! thou art of the faulty.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Yusuf! Sakın sen bundan bahsetme! Kadın! Sen de günahından dolayı istiğfar et. Sen gerçekten günahkarlardan oldun\".", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے یوسف! تم اس کا خیال نہ کرو اور اے عورت! تو اپنے گناہ کی معافی مانگ بیشک تو خطاواروں میں ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Hai) Yusuf: \"Berpalinglah dari ini, dan (kamu hai isteriku) mohon ampunlah atas dosamu itu, karena kamu sesungguhnya termasuk orang-orang yang berbuat salah\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يُوسُفُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْرِضْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "هَٰذَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱسْتَغْفِرِى", "hit": true, "audio": "audio/abe6f9312deb6dcc86c7.m4a", "gloss": {"en": "and ask forgiveness!", "bs": "i traži oprost!", "tr": "ve bağışlanma dile!", "fr": "et demande pardon !", "id": "dan mohonlah ampun!", "ur": "اور معافی مانگ!", "bn": "এবং ক্ষমা চাও!", "fa": "و آمرزش بخواه!"}}, {"text": "لِذَنۢبِكِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّكِ", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتِ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخَاطِـِٔينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "27:46", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3205.mp3", "translation": {"en": {"text": "He said: O my people! Why will ye hasten on the evil rather than the good? Why will ye not ask pardon of Allah, that ye may receive mercy.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Salih dedi ki: \"Ey benim kavmim! İyilik dururken niçin kötülüğe koşuyorsunuz? Ne olur Allah'a istiğfar etseniz, belki rahmetine ulaşırdınız.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "صا لح نے فرمایا اے میری قوم! کیوں برائی کی جلدی کرتے ہو بھلائی سے پہلے اللہ سے بخشش کیوں نہیں مانگتے شاید تم پر رحم ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dia berkata: \"Hai kaumku mengapa kamu minta disegerakan keburukan sebelum (kamu minta) kebaikan? Hendaklah kamu meminta ampun kepada Allah, agar kamu mendapat rahmat\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰقَوْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "لِمَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْتَعْجِلُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلسَّيِّئَةِ", "hit": false, "audio": null, "gloss": null}, {"text": "قَبْلَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَسَنَةِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَوْلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْتَغْفِرُونَ", "hit": true, "audio": "audio/4b73fb24879506508e5f.m4a", "gloss": {"en": "you (all) ask forgiveness", "bs": "tražite oprost", "tr": "bağışlanma dilersiniz", "fr": "vous demandez pardon", "id": "kalian memohon ampun", "ur": "تم سب معافی مانگتے ہو", "bn": "তোমরা ক্ষমা চাও", "fa": "آمرزش می‌خواهید"}}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تُرْحَمُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَٱسْتَغْفِرْ", "count": 5, "first": "3:159", "audio": "audio/23864bb06525cb347bbc.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "and ask forgiveness!", "bs": "i traži oprost!", "tr": "ve bağışlanma dile!", "fr": "et demande pardon !", "id": "dan mohonlah ampun!", "ur": "اور معافی مانگ