lation": {"bs": "dijete", "en": "the child", "bn": "শিশুটি", "fa": "کودک", "fr": "l'enfant", "id": "anak itu", "tr": "çocuk", "ur": "بچہ"}}, {"arabic": "عَنِ", "target": false, "translation": {"bs": "od", "en": "from", "bn": "থেকে", "fa": "از", "fr": "de", "id": "dari", "tr": "-den", "ur": "سے"}}, {"arabic": "الْبُكَاءِ", "target": false, "translation": {"bs": "plakanja", "en": "crying", "bn": "কান্না", "fa": "گریه", "fr": "les pleurs", "id": "menangis", "tr": "ağlama", "ur": "رونے"}}]}, {"arabic": "كَفَفْتُ عَنِ الشَّكْوَى", "spoken": "audio/c9adaec1308b18f33e4d.m4a", "tense": "past", "pronoun": "ana", "translation": {"bs": "Prestao sam se žaliti.", "en": "I stopped complaining.", "bn": "আমি অভিযোগ করা থেকে বিরত হলাম।", "fa": "من از شکایت دست کشیدم.", "fr": "J'ai cessé de me plaindre.", "id": "Aku berhenti mengeluh.", "tr": "Şikâyet etmekten vazgeçtim.", "ur": "میں شکایت کرنے سے باز آ گیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "كَفَفْتُ", "target": true, "translation": {"bs": "prestao sam", "en": "I refrained", "bn": "আমি বিরত হলাম", "fa": "دست کشیدم", "fr": "je me suis abstenu de", "id": "aku berhenti", "tr": "vazgeçtim", "ur": "میں باز رہا"}}, {"arabic": "عَنِ", "target": false, "translation": {"bs": "od", "en": "from", "bn": "থেকে", "fa": "از", "fr": "de", "id": "dari", "tr": "-den", "ur": "سے"}}, {"arabic": "الشَّكْوَى", "target": false, "translation": {"bs": "žaljenja", "en": "the complaint", "bn": "অভিযোগ", "fa": "شکایت", "fr": "la plainte", "id": "keluhan itu", "tr": "şikâyet", "ur": "شکایت"}}]}, {"arabic": "يَكُفُّونَ عَنِ الْكَلَامِ", "spoken": "audio/0a0fdd6c7f1f88738473.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Prestaju pričati.", "en": "They stop talking.", "bn": "তারা কথা বলা থেকে বিরত হয়।", "fa": "آنان از سخن گفتن دست می‌کشند.", "fr": "Ils cessent de parler.", "id": "Mereka berhenti berbicara.", "tr": "Konuşmaktan vazgeçerler.", "ur": "وہ بات کرنے سے رک جاتے ہیں۔"}, "independentlyReviewed": true, "words": [{"