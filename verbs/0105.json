نِي", "quran": false, "notUsed": false, "spoken": "audio/7b956f2028376b2fa93a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِحْزَنَا", "plain": "اِحْزَنَا", "quran": false, "notUsed": false, "spoken": "audio/77aa24290a8f015b5814.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِحْزَنُوا", "plain": "اِحْزَنُوا", "quran": false, "notUsed": false, "spoken": "audio/a4c7fdb65e4695ab8410.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِحْزَنَّ", "plain": "اِحْزَنَّ", "quran": false, "notUsed": false, "spoken": "audio/367c819a01d36b52388c.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "10:62", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1426.mp3", "translation": {"en": {"text": "Lo! verily the friends of Allah are (those) on whom fear (cometh) not, nor do they grieve?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Açın gözünüzü! Allah'ın dostları üzerine ne korku vardır, ne de onlar mahzun olurlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "سن لو بیشک اللہ کے ولیوں پر نہ کچھ خو ف ہے نہ کچھ غم", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ingatlah, sesungguhnya wali-wali Allah itu, tidak ada kekhawatiran terhadap mereka dan tidak (pula) mereka bersedih hati.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَلَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْلِيَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "خَوْفٌ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "هُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَحْزَنُونَ", "hit": true, "audio": "audio/c8908072c48eb29a6177.m4a", "gloss": {"en": "they grieve", "bs": "tuguju", "tr": "üzülürler", "fr": "ils s'affligent", "id": "mereka bersedih", "ur": "وہ غمگین ہوتے ہیں", "bn": "তারা দুঃখ করে", "fa": "اندوهگین می‌شوند"}}]}, {"ref": "36:76", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3781.mp3", "translation": {"en": {"text": "So let not their speech grieve thee (O Muhammad). Lo! We know what they conceal and what proclaim.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O halde onların sözleri seni üzmesin. Biz onların içlerini de biliriz, dışlarını da.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو تم ان کی بات کا غم نہ کرو بیشک ہم جانتے ہیں جو وہ چھپاتے ہیں اور ظاہر کرتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka janganlah ucapan mereka menyedihkan kamu. Sesungguhnya Kami mengetahui apa yang mereka rahasiakan dan apa yang mereka nyatakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَحْزُنكَ", "hit": true, "audio": "audio/18b739364cfe94a18e2d.m4a", "gloss": {"en": "he/it grieves you", "bs": "žalosti te", "tr": "seni üzer", "fr": "il t'afflige", "id": "dia membuat kamu bersedih", "ur": "وہ تمہیں غمگین کرتا ہے", "bn": "সে তোমাকে দুঃখ দেয়", "fa": "تو را اندوهگین می‌کند"}}, {"text": "قَوْلُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "نَعْلَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُسِرُّونَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُعْلِنُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "43:68", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4393.mp3", "translation": {"en": {"text": "O My slaves! For you there is no fear this day, nor is it ye who grieve;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah, takva sahiplerine şöyle nida eder: \"Ey âyetlerimize imân edip müslüman olan kullarım! Bugün size hiçbir korku yoktur ve siz üzülmeyeceksiniz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ان سے فرمایا جائے گا اے میرے بندو آج نہ تم پر خوف نہ تم کو غم ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "\"Hai hamba-hamba-Ku, tiada kekhawatiran terhadapmu pada hari ini dan tidak pula kamu bersedih hati.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَٰعِبَادِ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "خَوْفٌ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْكُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْيَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَحْزَنُونَ", "hit": true, "audio": "audio/749d0fd93d51cafa0d64.m4a", "gloss": {"bs": "(niti ćete) tugovati", "en": "(nor will) you grieve", "tr": "(siz de) üzülmeyeceksiniz", "fr": "(vous ne) vous affligerez (pas)", "id": "(dan tidak pula) kamu bersedih", "ur": "(نہ) تم غم کرو گے", "bn": "(তোমরা) দুঃখ করবে (না)", "fa": "اندوهگین نمی‌شوید"}}]}, {"ref": "27:70", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3229.mp3", "translation": {"en": {"text": "And grieve thou not for them, nor be in distress because of what they plot (against thee).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Habibim!) Onlara karşı mahzun olma, kurmakta oldukları tuzaklardan ötürü de sıkıntı duyma!", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور تم ان پر غم نہ کھاؤ اور ان کے مکر سے دل تنگ نہ ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan janganlah kamu berduka cita terhadap mereka, dan janganlah (dadamu) merasa sempit terhadap apa yang mereka tipudayakan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَحْزَنْ", "hit": true, "audio": "audio/feff13666c41bf7409a8.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "jussive"}]}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَكُن", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ضَيْقٍ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَمْكُرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:24", "tense": "present", "category": {"tense": "present", "pronoun": "anti", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2274.mp3", "translation": {"en": {"text": "Then (one) cried unto her from below her, saying: Grieve not! Thy Lord hath placed a rivulet beneath thee,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Melek, Meryem'e, aşağı tarafından şöyle seslendi. \"Sakın üzülme, Rabbin alt tarafında bir ırmak akıttı.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اسے اس کے تلے سے پکارا کہ غم نہ کھا بیشک تیرے رب نے نیچے ایک نہر بہادی ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Jibril menyerunya dari tempat yang rendah: \"Janganlah kamu bersedih hati, sesungguhnya Tuhanmu telah menjadikan anak sungai di bawahmu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَنَادَىٰهَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَحْتِهَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تَحْزَنِى", "hit": true, "audio": "audio/e57c05605e37a3bfbcf8.m4a", "gloss": {"en": "you grieve", "bs": "tuguješ", "tr": "üzülürsün", "fr": "tu t'affliges", "id": "kamu bersedih", "ur": "تم غمگین ہوتے ہو", "bn": "তুমি দুঃখ কর", "fa": "اندوهگین شوی"}}, {"text": "قَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "جَعَلَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّكِ", "hit": false, "audio": null, "gloss": null}, {"text": "تَحْتَكِ", "hit": false, "audio": null, "gloss": null}, {"text": "سَرِيًّا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَحْزَنُونَ", "count": 13, "first": "2:38", "audio": "audio/5d128efe10c22974d31a.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they grieve", "bs": "tuguju", "tr": "üzülürler", "fr": "ils s'affligent", "id": "mereka bersedih", "ur": "وہ غمگین ہوتے ہیں", "bn": "তারা দুঃখ করে", "fa": "اندوهگین می‌شوند"}}, {"arabic": "يَحْزُنكَ", "count": 5, "first": "3:176", "audio": "audio/4196e118e0d5c7e715a2.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["anta"], "mood": "jussive"}], "gloss": {"en": "he/it grieves you", "bs": "žalosti te", "tr": "seni üzer", "fr": "il t'afflige", "id": "dia membuat kamu bersedih", "ur": "وہ تمہیں غمگین کرتا ہے", "bn": "সে 