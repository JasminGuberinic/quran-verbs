34.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Ono što je Allah htio.", "en": "What God willed.", "bn": "আল্লাহ যা চেয়েছেন।", "fa": "آنچه خدا خواست.", "fr": "Ce qu'Allah a voulu.", "id": "Apa yang Allah kehendaki.", "tr": "Allah'ın dilediği şey.", "ur": "جو اللہ نے چاہا۔"}, "independentlyReviewed": true, "words": [{"arabic": "مَا", "target": false, "translation": {"bs": "ono što", "en": "what", "bn": "যা", "fa": "آنچه", "fr": "ce que", "id": "apa", "tr": "ne", "ur": "جو / کیا"}}, {"arabic": "شَاءَ", "target": true, "translation": {"bs": "je htio", "en": "wished, willed", "bn": "চেয়েছেন, ইচ্ছা করেছেন", "fa": "خواست", "fr": "a voulu", "id": "menghendaki", "tr": "diledi", "ur": "چاہا"}}, {"arabic": "اللَّهُ", "target": false, "translation": {"bs": "Allah", "en": "God", "bn": "আল্লাহ", "fa": "خدا", "fr": "Allah", "id": "Allah", "tr": "Allah", "ur": "اللہ"}}]}, {"arabic": "يَفْعَلُ اللَّهُ مَا يَشَاءُ", "spoken": "audio/42859b11eef8d4518937.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Allah čini što hoće.", "en": "God does what He wills.", "bn": "আল্লাহ যা ইচ্ছা করেন তা-ই করেন।", "fa": "خدا هر چه بخواهد انجام می‌دهد.", "fr": "Allah fait ce qu'Il veut.", "id": "Allah melakukan apa yang Dia kehendaki.", "tr": "Allah dilediğini yapar.", "ur": "اللہ جو چاہتا ہے کرتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَفْعَلُ", "target": false, "translation": {"bs": "čini", "en": "does", "bn": "করে", "fa": "می‌کند", "fr": "fait", "id": "melakukan", "tr": "yapar", "ur": "کرتا ہے"}}, {"arabic": "اللَّهُ", "target": false, "translation": {"bs": "Allah", "en": "God", "bn": "আল্লাহ", "fa": "خدا", "fr": "Allah", "id": "Allah", "tr": "Allah", "ur": "اللہ"}}, {"arabic": "مَا", "target": false, "translation": {"bs": "što", "en": "what", "bn": "যা", "fa": "آنچه", "fr": "ce que", "id": "apa", "tr": "ne", "ur": "جو / کیا"}}, {"arabic": "يَشَاءُ", "target": true, "translation": {"bs": "hoće", "en": "wishes, wills", "bn": "চান, ইচ্ছা ক