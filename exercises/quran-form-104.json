[{"id":"ittabaa-3-162-1","words":["verb:ittabaa"],"options":[{"bs":"slijedio je","en":"he/it followed"},{"bs":"slijedite me!","en":"(you all) follow me!"},{"bs":"i slijedi","en":"and he/it follows"},{"bs":"slijedio te je","en":"he/it followed you"}],"ref":"3:162","answerWord":"ٱتَّبَعَ","answerSound":"audio/7a361e97f6b5c5065a9a.m4a","quranTranslation":{"text":"Is one who followeth the pleasure of Allah as one who hath earned condemnation from Allah, whose habitation is the Fire, a hapless journey's end?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["أَفَمَنِ","ٱتَّبَعَ","رِضْوَٰنَ","ٱللَّهِ","كَمَنۢ","بَآءَ","بِسَخَطٍ","مِّنَ","ٱللَّهِ","وَمَأْوَىٰهُ","جَهَنَّمُ","وَبِئْسَ","ٱلْمَصِيرُ"],"marked":[1],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-4-27-7","words":["verb:ittabaa"],"options":[{"bs":"slijede","en":"they follow"},{"bs":"slijedili ste","en":"you (all) followed"},{"bs":"slijedili su","en":"they followed"},{"bs":"pa me slijedite!","en":"so (you all) follow me!"}],"ref":"4:27","answerWord":"يَتَّبِعُونَ","answerSound":"audio/96b45fd9e910816ba572.m4a","quranTranslation":{"text":"And Allah would turn to you in mercy; but those who follow vain desires would have you go tremendously astray.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["وَٱللَّهُ","يُرِيدُ","أَن","يَتُوبَ","عَلَيْكُمْ","وَيُرِيدُ","ٱلَّذِينَ","يَتَّبِعُونَ","ٱلشَّهَوَٰتِ","أَن","تَمِيلُوا۟","مَيْلًا","عَظِيمًا"],"marked":[7],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-2-168-9","words":["verb:ittabaa"],"options":[{"bs":"slijedite","en":"you (all) follow"},{"bs":"slijedio si me","en":"you followed me"},{"bs":"slijedi","en":"he/it follows"},{"bs":"slijedio te je","en":"he/it followed you"}],"ref":"2:168","answerWord":"تَتَّبِعُوا۟","answerSound":"audio/1c70c92c2e18bba639d8.m4a","quranTranslation":{"text":"O mankind! Eat of that which is lawful and wholesome in the earth, and follow not the footsteps of the devil. Lo! he is an open enemy for you.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["يَٰٓأَيُّهَا","ٱلنَّاسُ","كُلُوا۟","مِمَّا","فِى","ٱلْأَرْضِ","حَلَٰلًا","طَيِّبًا","وَلَا","تَتَّبِعُوا۟","خُطُوَٰتِ","ٱلشَّيْطَٰنِ","إِنَّهُۥ","لَكُمْ","عَدُوٌّ","مُّبِينٌ"],"marked":[9],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-36-21-0","words":["verb:ittabaa"],"options":[{"bs":"slijedite!","en":"(you all) follow!"},{"bs":"slijedili su ga","en":"they followed him"},{"bs":"pa me slijedite!","en":"so (you all) follow me!"},{"bs":"i slijedio sam","en":"and I followed"}],"ref":"36:21","answerWord":"ٱتَّبِعُوا۟","answerSound":"audio/0ec3ac948262ea50a422.m4a","quranTranslation":{"text":"Follow those who ask of you no fee, and who are rightly guided.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["ٱتَّبِعُوا۟","مَن","لَّا","يَسْـَٔلُكُمْ","أَجْرًا","وَهُم","مُّهْتَدُونَ"],"marked":[0],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-2-166-6","words":["verb:ittabaa"],"options":[{"bs":"slijedili su","en":"they followed"},{"bs":"slijede ih","en":"follow them"},{"bs":"i slijedi","en":"and he/it follows"},{"bs":"slijedite nas","en":"you (all) follow us"}],"ref":"2:166","answerWord":"ٱتَّبَعُوا۟","answerSound":"audio/89074524b7d9a30a0dfd.m4a","quranTranslation":{"text":"(On the day) when those who were followed disown those who followed (them), and they behold the doom, and all their aims collapse with them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["إِذْ","تَبَرَّأَ","ٱلَّذِينَ","ٱتُّبِعُوا۟","مِنَ","ٱلَّذِينَ","ٱتَّبَعُوا۟","وَرَأَوُا۟","ٱلْعَذَابَ","وَتَقَطَّعَتْ","بِهِمُ","ٱلْأَسْبَابُ"],"marked":[6],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-4-125-9","words":["verb:ittabaa"],"options":[{"bs":"i slijedio je","en":"and he/it followed"},{"bs":"slijedite","en":"you (all) follow"},{"bs":"pa me slijedite!","en":"so (you all) follow me!"},{"bs":"slijedimo vas","en":"we follow you (all)"}],"ref":"4:125","answerWord":"وَٱتَّبَعَ","answerSound":"audio/4cf4bae6fbb14d2b8918.m4a","quranTranslation":{"text":"Who is better in religion than he who surrendereth his purpose to Allah while doing good (to men) and followeth the tradition of Abraham, the upright? Allah (Himself) chose Abraham for friend.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["وَمَنْ","أَحْسَنُ","دِينًا","مِّمَّنْ","أَسْلَمَ","وَجْهَهُۥ","لِلَّهِ","وَهُوَ","مُحْسِنٌ","وَٱتَّبَعَ","مِلَّةَ","إِبْرَٰهِيمَ","حَنِيفًا","وَٱتَّخَذَ","ٱللَّهُ","إِبْرَٰهِيمَ","خَلِيلًا"],"marked":[9],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-6-50-16","words":["verb:ittabaa"],"options":[{"bs":"slijedim","en":"I follow"},{"bs":"i slijedite ga!","en":"and (you all) follow him!"},{"bs":"slijede vas","en":"they follow you (all)"},{"bs":"pa su slijedili","en":"so they followed"}],"ref":"6:50","answerWord":"أَتَّبِعُ","answerSound":"audio/75596ebd015fee8dcf67.m4a","quranTranslation":{"text":"Say (O Muhammad, to the disbelievers): I say not unto you (that) I possess the treasures of Allah, nor that I have knowledge of the Unseen; and I say not unto you: Lo! I am an angel. I follow only that which is inspired in me. Say: Are the blind man and the seer equal? Will ye not then take thought?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["قُل","لَّآ","أَقُولُ","لَكُمْ","عِندِى","خَزَآئِنُ","ٱللَّهِ","وَلَآ","أَعْلَمُ","ٱلْغَيْبَ","وَلَآ","أَقُولُ","لَكُمْ","إِنِّى","مَلَكٌ","إِنْ","أَتَّبِعُ","إِلَّا","مَا","يُوحَىٰٓ","إِلَىَّ","قُلْ","هَلْ","يَسْتَوِى","ٱلْأَعْمَىٰ","وَٱلْبَصِيرُ","أَفَلَا","تَتَفَكَّرُونَ"],"marked":[16],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-8-64-5","words":["verb:ittabaa"],"options":[{"bs":"slijedio te je","en":"he/it followed you"},{"bs":"pa su ga slijedili","en":"so they followed him"},{"bs":"slijedite","en":"you (all) follow"},{"bs":"i slijedili su","en":"and they followed"}],"ref":"8:64","answerWord":"ٱتَّبَعَكَ","answerSound":"audio/0cd9b736aacf6fff6888.m4a","quranTranslation":{"text":"O Prophet! Allah is Sufficient for thee and those who follow thee of the believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["يَٰٓأَيُّهَا","ٱلنَّبِىُّ","حَسْبُكَ","ٱللَّهُ","وَمَنِ","ٱتَّبَعَكَ","مِنَ","ٱلْمُؤْمِنِينَ"],"marked":[5],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-10-109-0","words":["verb:ittabaa"],"options":[{"bs":"i slijedi!","en":"and follow!"},{"bs":"slijedim je","en":"I follow it"},{"bs":"i slijedite me!","en":"and (you all) follow me!"},{"bs":"slijedili su","en":"they followed"}],"ref":"10:109","answerWord":"وَٱتَّبِعْ","answerSound":"audio/358d7dc59e837e4ff3d0.m4a","quranTranslation":{"text":"And (O Muhammad) follow that which is inspired in thee, and forbear until Allah give judgment. And He is the Best of Judges.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["وَٱتَّبِعْ","مَا","يُوحَىٰٓ","إِلَيْكَ","وَٱصْبِرْ","حَتَّىٰ","يَحْكُمَ","ٱللَّهُ","وَهُوَ","خَيْرُ","ٱلْحَٰكِمِينَ"],"marked":[0],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-2-170-9","words":["verb:ittabaa"],"options":[{"bs":"slijedimo","en":"we follow"},{"bs":"slijede vas","en":"they follow you (all)"},{"bs":"i slijedio je","en":"and he/it followed"},{"bs":"i slijedila ih je","en":"and she/it followed them"}],"ref":"2:170","answerWord":"نَتَّبِعُ","answerSound":"audio/411c632869d03879ff24.m4a","quranTranslation":{"text":"And when it is said unto them: Follow that which Allah hath revealed, they say: We follow that wherein we found our fathers. What! Even though their fathers were wholly unintelligent and had no guidance?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["وَإِذَا","قِيلَ","لَهُمُ","ٱتَّبِعُوا۟","مَآ","أَنزَلَ","ٱللَّهُ","قَالُوا۟","بَلْ","نَتَّبِعُ","مَآ","أَلْفَيْنَا","عَلَيْهِ","ءَابَآءَنَآ","أَوَلَوْ","كَانَ","ءَابَآؤُهُمْ","لَا","يَعْقِلُونَ","شَيْـًٔا","وَلَا","يَهْتَدُونَ"],"marked":[9],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-3-68-5","words":["verb:ittabaa"],"options":[{"bs":"slijedili su ga","en":"they followed him"},{"bs":"slijedio vas je","en":"he/it followed you (two)"},{"bs":"i slijedio je","en":"and he/it followed"},{"bs":"slijedite nas","en":"you (all) follow us"}],"ref":"3:68","answerWord":"ٱتَّبَعُوهُ","answerSound":"audio/0481145c6026e73e9cd0.m4a","quranTranslation":{"text":"Lo! those of mankind who have the best claim to Abraham are those who followed him, and this Prophet and those who believe (with him); and Allah is the Protecting Guardian of the believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["إِنَّ","أَوْلَى","ٱلنَّاسِ","بِإِبْرَٰهِيمَ","لَلَّذِينَ","ٱتَّبَعُوهُ","وَهَٰذَا","ٱلنَّبِىُّ","وَٱلَّذِينَ","ءَامَنُوا۟","وَٱللَّهُ","وَلِىُّ","ٱلْمُؤْمِنِينَ"],"marked":[5],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-3-31-5","words":["verb:ittabaa"],"options":[{"bs":"pa me slijedite!","en":"so (you all) follow me!"},{"bs":"a slijede te","en":"and follow you"},{"bs":"slijedio me je","en":"he/it followed me"},{"bs":"slijedili su ih","en":"they followed them"}],"ref":"3:31","answerWord":"فَٱتَّبِعُونِى","answerSound":"audio/c06b01d07794244ed18b.m4a","quranTranslation":{"text":"Say, (O Muhammad, to mankind): If ye love Allah, follow me; Allah will love you and forgive you your sins. Allah is Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["قُلْ","إِن","كُنتُمْ","تُحِبُّونَ","ٱللَّهَ","فَٱتَّبِعُونِى","يُحْبِبْكُمُ","ٱللَّهُ","وَيَغْفِرْ","لَكُمْ","ذُنُوبَكُمْ","وَٱللَّهُ","غَفُورٌ","رَّحِيمٌ"],"marked":[5],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-6-106-0","words":["verb:ittabaa"],"options":[{"bs":"slijedi!","en":"follow!"},{"bs":"i slijedimo","en":"and we follow"},{"bs":"slijedio je","en":"he/it followed"},{"bs":"i slijedi","en":"and he/it follows"}],"ref":"6:106","answerWord":"ٱتَّبِعْ","answerSound":"audio/701b9cb82aef518bb26e.m4a","quranTranslation":{"text":"Follow that which is inspired in thee from thy Lord; there is no Allah save Him; and turn away from the idolaters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["ٱتَّبِعْ","مَآ","أُوحِىَ","إِلَيْكَ","مِن","رَّبِّكَ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","وَأَعْرِضْ","عَنِ","ٱلْمُشْرِكِينَ"],"marked":[0],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-2-166-3","words":["verb:ittabaa"],"options":[{"bs":"slijeđeni su","en":"they were followed"},{"bs":"pa me slijedi!","en":"so follow me!"},{"bs":"slijedio si","en":"you followed"},{"bs":"slijedimo vas","en":"we follow you (all)"}],"ref":"2:166","answerWord":"ٱتُّبِعُوا۟","answerSound":"audio/ce07f3f850d3fa8f5623.m4a","quranTranslation":{"text":"(On the day) when those who were followed disown those who followed (them), and they behold the doom, and all their aims collapse with them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["إِذْ","تَبَرَّأَ","ٱلَّذِينَ","ٱتُّبِعُوا۟","مِنَ","ٱلَّذِينَ","ٱتَّبَعُوا۟","وَرَأَوُا۟","ٱلْعَذَابَ","وَتَقَطَّعَتْ","بِهِمُ","ٱلْأَسْبَابُ"],"marked":[3],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-3-20-7","words":["verb:ittabaa"],"options":[{"bs":"slijedio me je","en":"he/it followed me"},{"bs":"i slijedi!","en":"and follow!"},{"bs":"slijedio si","en":"you followed"},{"bs":"slijedili ste","en":"you (all) followed"}],"ref":"3:20","answerWord":"ٱتَّبَعَنِ","answerSound":"audio/49f21fd5ca5ed5ecc7fb.m4a","quranTranslation":{"text":"And if they argue with thee, (O Muhammad), say: I have surrendered my purpose to Allah and (so have) those who follow me. And say unto those who have received the Scripture and those who read not: Have ye (too) surrendered? If they surrender, then truly they are rightly guided, and if they turn away, then it is thy duty only to convey the message (unto them). Allah is Seer of (His) bondmen.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["فَإِنْ","حَآجُّوكَ","فَقُلْ","أَسْلَمْتُ","وَجْهِىَ","لِلَّهِ","وَمَنِ","ٱتَّبَعَنِ","وَقُل","لِّلَّذِينَ","أُوتُوا۟","ٱلْكِتَٰبَ","وَٱلْأُمِّيِّۦنَ","ءَأَسْلَمْتُمْ","فَإِنْ","أَسْلَمُوا۟","فَقَدِ","ٱهْتَدَوا۟","وَّإِن","تَوَلَّوْا۟","فَإِنَّمَا","عَلَيْكَ","ٱلْبَلَٰغُ","وَٱللَّهُ","بَصِيرٌۢ","بِٱلْعِبَادِ"],"marked":[7],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-3-53-4","words":["verb:ittabaa"],"options":[{"bs":"i slijedili smo","en":"and we followed"},{"bs":"slijedili su te","en":"they followed you"},{"bs":"slijedimo","en":"we follow"},{"bs":"i slijedili su","en":"and they followed"}],"ref":"3:53","answerWord":"وَٱتَّبَعْنَا","answerSound":"audio/2f7416584628afed2b88.m4a","quranTranslation":{"text":"Our Lord! We believe in that which Thou hast revealed and we follow him whom Thou hast sent. Enrol us among those who witness (to the truth).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["رَبَّنَآ","ءَامَنَّا","بِمَآ","أَنزَلْتَ","وَٱتَّبَعْنَا","ٱلرَّسُولَ","فَٱكْتُبْنَا","مَعَ","ٱلشَّٰهِدِينَ"],"marked":[4],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-3-55-14","words":["verb:ittabaa"],"options":[{"bs":"slijedili su te","en":"they followed you"},{"bs":"slijedimo","en":"we follow"},{"bs":"pa slijedi","en":"then follow"},{"bs":"slijedite nas","en":"you (all) follow us"}],"ref":"3:55","answerWord":"ٱتَّبَعُوكَ","answerSound":"audio/af1f617ade242346e57f.m4a","quranTranslation":{"text":"(And remember) when Allah said: O Jesus! Lo! I am gathering thee and causing thee to ascend unto Me, and am cleansing thee of those who disbelieve and am setting those who follow thee above those who disbelieve until the Day of Resurrection. Then unto Me ye will (all) return, and I shall judge between you as to that wherein ye used to differ.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["إِذْ","قَالَ","ٱللَّهُ","يَٰعِيسَىٰٓ","إِنِّى","مُتَوَفِّيكَ","وَرَافِعُكَ","إِلَىَّ","وَمُطَهِّرُكَ","مِنَ","ٱلَّذِينَ","كَفَرُوا۟","وَجَاعِلُ","ٱلَّذِينَ","ٱتَّبَعُوكَ","فَوْقَ","ٱلَّذِينَ","كَفَرُوٓا۟","إِلَىٰ","يَوْمِ","ٱلْقِيَٰمَةِ","ثُمَّ","إِلَىَّ","مَرْجِعُكُمْ","فَأَحْكُمُ","بَيْنَكُمْ","فِيمَا","كُنتُمْ","فِيهِ","تَخْتَلِفُونَ"],"marked":[14],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-3-95-3","words":["verb:ittabaa"],"options":[{"bs":"pa slijedite!","en":"so (you all) follow!"},{"bs":"i slijedi!","en":"and follow!"},{"bs":"slijedi","en":"he/it follows"},{"bs":"slijedili su","en":"they followed"}],"ref":"3:95","answerWord":"فَٱتَّبِعُوا۟","answerSound":"audio/eef3b4fd971177bf4dc6.m4a","quranTranslation":{"text":"Say: Allah speaketh truth. So follow the religion of Abraham, the upright. He was not of the idolaters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["قُلْ","صَدَقَ","ٱللَّهُ","فَٱتَّبِعُوا۟","مِلَّةَ","إِبْرَٰهِيمَ","حَنِيفًا","وَمَا","كَانَ","مِنَ","ٱلْمُشْرِكِينَ"],"marked":[3],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-4-115-9","words":["verb:ittabaa"],"options":[{"bs":"i slijedi","en":"and he/it follows"},{"bs":"slijedio je","en":"he/it followed"},{"bs":"pa ga slijedi!","en":"so follow it!"},{"bs":"slijedimo vas","en":"we follow you (all)"}],"ref":"4:115","answerWord":"وَيَتَّبِعْ","answerSound":"audio/b6cf3fd919071f754ccf.m4a","quranTranslation":{"text":"And whoso opposeth the messenger after the guidance (of Allah) hath been manifested unto him, and followeth other than the believer's way, We appoint for him that unto which he himself hath turned, and expose him unto hell - a hapless journey's end!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["وَمَن","يُشَاقِقِ","ٱلرَّسُولَ","مِنۢ","بَعْدِ","مَا","تَبَيَّنَ","لَهُ","ٱلْهُدَىٰ","وَيَتَّبِعْ","غَيْرَ","سَبِيلِ","ٱلْمُؤْمِنِينَ","نُوَلِّهِۦ","مَا","تَوَلَّىٰ","وَنُصْلِهِۦ","جَهَنَّمَ","وَسَآءَتْ","مَصِيرًا"],"marked":[9],"facts":{"verb":"اتَّبَعَ"}},{"id":"ittabaa-5-77-10","words":["verb:ittabaa"],"options":[{"bs":"slijedite","en":"you (all) follow"},{"bs":"slijedi","en":"he/it follows"},{"bs":"slijedimo ga","en":"we follow him"},{"bs":"i slijedimo","en":"and we follow"}],"ref":"5:77","answerWord":"تَتَّبِعُوٓا۟","answerSound":"audio/c39dc6b1932f941fba0b.m4a","quranTranslation":{"text":"Say: O People of the Scripture! Stress not in your religion other than the truth, and follow not the vain desires of folk who erred of old and led many astray, and erred from a plain road.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"slijediti","en":"to follow"},"passage":["قُلْ","يَٰٓأَهْلَ","ٱلْكِتَٰبِ","لَا","تَغْلُوا۟","فِى","دِينِكُمْ","غَيْرَ","ٱلْحَقِّ","وَلَا","تَتَّبِعُوٓا۟","أَهْوَآءَ","قَوْمٍ","قَدْ","ضَلُّوا۟","مِن","قَبْلُ","وَأَضَلُّوا۟","كَثِيرًا","وَضَلُّوا۟","عَن","سَوَآءِ","ٱلسَّبِيلِ"],"marked":[10],"facts":{"verb":"اتَّبَعَ"}}]