a7b107.m4a", "gloss": {"bs": "pa je izlio", "en": "so he poured", "tr": "böylece döktü", "fr": "alors il a versé", "id": "maka dia menuangkan", "ur": "پس اس نے انڈیل دیا", "bn": "অতঃপর সে ঢেলে দিল", "fa": "پس ریخت"}}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَوْطَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابٍ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُصَبُّ", "count": 1, "first": "22:19", "audio": "audio/8cac74f512e1a355c188.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it is poured", "bs": "lije se", "tr": "dökülür", "fr": "il est versé", "id": "dia dituangkan", "ur": "وہ بہایا جاتا ہے", "bn": "তা ঢেলে দেওয়া হয়", "fa": "ریخته می‌شود"}}, {"arabic": "صُبُّوا۟", "count": 1, "first": "44:48", "audio": "audio/413700b3c5f4fa345c91.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"bs": "izlijte", "en": "pour", "tr": "dökün!", "fr": "versez !", "id": "tuangkanlah!", "ur": "بہا دو!", "bn": "ঢেলে দাও", "fa": "بریزید"}}, {"arabic": "صَبَبْنَا", "count": 1, "first": "80:25", "audio": "audio/130457a339d3ef0b1865.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"bs": "izlili smo", "en": "we poured", "tr": "döktük", "fr": "nous avons versé", "id": "kami telah menuangkan", "ur": "ہم نے بہایا", "bn": "আমরা ঢেলেছি", "fa": "ریختیم"}}, {"arabic": "فَصَبَّ", "count": 1, "first": "89:13", "audio": "audio/3300c7a9f6ef80a7b107.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "pa je izlio", "en": "so he poured", "tr": "böylece döktü", "fr": "alors il versa", "id": "maka dia telah menuangkan", "ur": "پس اُس نے بہایا", "bn": "অতএব সে ঢেলে দিল", "fa": "پس ریخت"}}], "ayatFile": "ayat/0544.json", "ayatTranslations": {"en": "ayat/0544.en.json", "tr": "ayat/0544.tr.json", "ur": "ayat/0544.ur.json", "id": "ayat/0544.id.json"}, "sentences": [{"arabic": "صَبَّ الطَّبَّاخُ الْمَاءَ فِي الْقِدْرِ", "spoken": "audio/d32f15e419f3a47a1568.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Kuhar je sipao vodu u lonac.", "en": "The cook poured the water into the pot.", "bn": "বাবুর্চি হাঁড়িতে পানি ঢেলেছে।", "fa": "آشپز آب را در دیگ ریخت.", "fr": "Le cuisinier a versé l'eau dans la marmite.", "id": "Juru masak itu menuangkan air ke dalam periuk.", "tr": "Aşçı suyu tencereye döktü.", "ur": "باورچی نے ہانڈی میں پانی انڈیلا۔"}, "independentlyReviewed": true, "words": [{"arabic": "صَبَّ", "target": true, "translation": {"bs": "sipao je", "en": "poured", "bn": "ঢেলেছে", "fa": "ریخت", "fr": "a versé", "id": "dia menuangkan", "tr": "döktü", "ur": "انڈیلا"}}, {"arabic": "الطَّبَّاخُ", "target": false, "translation": {"bs": "kuhar", "en": "the cook", "bn": "বাবুর্চি", "fa": "آشپز", "fr": "le cuisinier", "id": "juru masak itu", "tr": "aşçı", "ur": "باورچی"}}, {"arabic": "الْمَاءَ", "target": false, "translation": {"bs": "vodu", "en": "the water", "bn": "পানি", "fa": "آب", "fr": "l'eau", "id": "air itu", "tr": "su", "ur": "پانی"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "u", "en": "into", "bn": "মধ্যে", "fa": "به درون", "fr": "dans", "id": "ke dalam", "tr": "içine", "ur": "میں"}}, {"arabic": "الْقِدْرِ", "target": false, "translation": {"bs": "lonac", "en": "the pot", "bn": "পাতিল", "fa": "دیگ", "fr": "la marmite", "id": "periuk itu", "tr": "tencere", "ur": "ہانڈی"}}]}, {"arabic": "صَبَبْنَا الشَّايَ لِلضُّيُوفِ", "spoken": "audio/5f6886f21a08e75ddfaa.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Sipali smo čaj gostima.", "en": "We poured tea for the guests.", "bn": "আমরা অতিথিদের চা ঢেলেছিলাম।", "fa": "برای مهمانان چای ریختیم.", "fr": "Nous avons versé du thé aux invités.", "id": "Kami menuangkan teh untuk para tamu.", "tr": "Misafirlere çay döktük.", "ur": "ہم نے مہمانوں کے لیے چائے انڈیلی۔"}, "independentlyReviewed": true, "words": [{"arabic": "صَبَبْنَا", "target": true, "translation": {"bs": "sipali smo", "en": "poured", "bn": "ঢেলেছিলাম", "fa": "ریختیم", "fr": "nous avons versé", "id": "kami menuangkan", "tr": "döktük", "ur": "انڈیلا"}}, {"arabic": "الشَّايَ", "target": false, "translation": {"bs": "čaj", "en": "tea", "bn": "চা", "fa": "چای", "fr": "thé", "id": "teh", "tr": "çay", "ur": "چائے"}}, {"arabic": "لِلضُّيُوفِ", "target": false, "translation": {"bs": "gostima", "en": "for the guests", "bn": "অতিথিদের জন্য", "fa": "برای مهمانان", "fr": "pour les invités", "id": "untuk para tamu", "tr": "misafirler için", "ur": "مہمانوں کے لیے"}}]}, {"arabic": "صُبُّوا الْعَصِيرَ فِي الْأَكْوَابِ", "spoken": "audio/88e899caf2942fe26990.m4a", "tense": "imperative", "pronoun": "antum", "translation": {"bs": "Sipajte sok u čaše.", "en": "Pour the juice into the glasses.", "bn": "গ্লাসগুলোতে রস ঢালো।", "fa": "آبمیوه را در لیوان‌ها بریزید.", "fr": "Versez le jus dans les verres.", "id": "Tuangkanlah, kalian, jus itu ke dalam gelas-gelas.", "tr": "Meyve suyunu bardaklara dökün.", "ur": "جوس گلاسوں میں انڈیل دو۔"}, "independentlyReviewed": true, "words": [{"arabic": "صُبُّوا", "target": true, "translation": {"bs": "sipajte", "en": "pour", "bn": "ঢালো", "fa": "بریزید", "fr": "versez", "id": "tuangkanlah", "tr": "dökün", "ur": "انڈیلو"}}, {"arabic": "الْعَصِيرَ", "target": false, "translation": {"bs": "sok", "en": "the juice", "bn": "রস", "fa": "آبمیوه", "fr": "le jus", "id": "jus itu", "tr": "meyve suyu", "ur": "جوس"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "u", "en": "into", "bn": "মধ্যে", "fa": "به درون", "fr": "dans", "id": "ke dalam", "tr": "içine", "ur": "میں"}}, {"arabic": "الْأَكْوَابِ", "target": false, "translation": {"bs": "čaše", "en": "the glasses", "bn": "গ্লাসগুলো", "fa": "لیوان‌ها", "fr": "les verres", "id": "gelas-gelas itu", "tr": "bardaklar", "ur": "گلاس"}}]}]