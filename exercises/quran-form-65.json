[{"id":"dakhala-2-58-2","words":["verb:dakhala"],"options":[{"bs":"uđite!","en":"(you all) enter!"},{"bs":"uđi!","en":"enter!"},{"bs":"ulaze","en":"they enter"},{"bs":"i ušao je","en":"and he/it entered"}],"ref":"2:58","answerWord":"ٱدْخُلُوا۟","answerSound":"audio/3089d5a9afedd81b3da6.m4a","quranTranslation":{"text":"And when We said: Go into this township and eat freely of that which is therein, and enter the gate prostrate, and say: \"Repentance.\" We will forgive you your sins and will increase (reward) for the right-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["وَإِذْ","قُلْنَا","ٱدْخُلُوا۟","هَٰذِهِ","ٱلْقَرْيَةَ","فَكُلُوا۟","مِنْهَا","حَيْثُ","شِئْتُمْ","رَغَدًا","وَٱدْخُلُوا۟","ٱلْبَابَ","سُجَّدًا","وَقُولُوا۟","حِطَّةٌ","نَّغْفِرْ","لَكُمْ","خَطَٰيَٰكُمْ","وَسَنَزِيدُ","ٱلْمُحْسِنِينَ"],"marked":[2],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-12-68-1","words":["verb:dakhala"],"options":[{"bs":"ušli su","en":"they entered"},{"bs":"uđi!","en":"enter!"},{"bs":"pa uđite u njega!","en":"so (you all) enter it!"},{"bs":"i uđite!","en":"and (you all) enter!"}],"ref":"12:68","answerWord":"دَخَلُوا۟","answerSound":"audio/e47ecf894377e610f6da.m4a","quranTranslation":{"text":"And when they entered in the manner which their father had enjoined, it would have naught availed them as against Allah; it was but a need of Jacob's soul which he thus satisfied; and lo! he was a lord of knowledge because We had taught him; but most of mankind know not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["وَلَمَّا","دَخَلُوا۟","مِنْ","حَيْثُ","أَمَرَهُمْ","أَبُوهُم","مَّا","كَانَ","يُغْنِى","عَنْهُم","مِّنَ","ٱللَّهِ","مِن","شَىْءٍ","إِلَّا","حَاجَةً","فِى","نَفْسِ","يَعْقُوبَ","قَضَىٰهَا","وَإِنَّهُۥ","لَذُو","عِلْمٍ","لِّمَا","عَلَّمْنَٰهُ","وَلَٰكِنَّ","أَكْثَرَ","ٱلنَّاسِ","لَا","يَعْلَمُونَ"],"marked":[1],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-110-2-2","words":["verb:dakhala"],"options":[{"bs":"ulaze","en":"they enter"},{"bs":"ušli ste kroz njih","en":"you (all) entered it"},{"bs":"ulaze u njih","en":"they enter them"},{"bs":"ušli su","en":"they entered"}],"ref":"110:2","answerWord":"يَدْخُلُونَ","answerSound":"audio/c3c6213b9bec5f5393d1.m4a","quranTranslation":{"text":"And thou seest mankind entering the religion of Allah in troops,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["وَرَأَيْتَ","ٱلنَّاسَ","يَدْخُلُونَ","فِى","دِينِ","ٱللَّهِ","أَفْوَاجًا"],"marked":[2],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-2-58-10","words":["verb:dakhala"],"options":[{"bs":"i uđite!","en":"and (you all) enter!"},{"bs":"ulazi","en":"he/it enters"},{"bs":"ušao je u njega","en":"he/it entered it"},{"bs":"ušlo se","en":"she/it was entered"}],"ref":"2:58","answerWord":"وَٱدْخُلُوا۟","answerSound":"audio/52d984ff5cd6f6ea89ec.m4a","quranTranslation":{"text":"And when We said: Go into this township and eat freely of that which is therein, and enter the gate prostrate, and say: \"Repentance.\" We will forgive you your sins and will increase (reward) for the right-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["وَإِذْ","قُلْنَا","ٱدْخُلُوا۟","هَٰذِهِ","ٱلْقَرْيَةَ","فَكُلُوا۟","مِنْهَا","حَيْثُ","شِئْتُمْ","رَغَدًا","وَٱدْخُلُوا۟","ٱلْبَابَ","سُجَّدًا","وَقُولُوا۟","حِطَّةٌ","نَّغْفِرْ","لَكُمْ","خَطَٰيَٰكُمْ","وَسَنَزِيدُ","ٱلْمُحْسِنِينَ"],"marked":[10],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-18-35-0","words":["verb:dakhala"],"options":[{"bs":"i ušao je","en":"and he/it entered"},{"bs":"ušli su","en":"they entered"},{"bs":"ulaze u njih","en":"they enter them"},{"bs":"pa uđite!","en":"so (you all) enter!"}],"ref":"18:35","answerWord":"وَدَخَلَ","answerSound":"audio/830bdbb2b43615f0fae1.m4a","quranTranslation":{"text":"And he went into his garden, while he (thus) wronged himself. He said: I think not that all this will ever perish.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["وَدَخَلَ","جَنَّتَهُۥ","وَهُوَ","ظَالِمٌ","لِّنَفْسِهِۦ","قَالَ","مَآ","أَظُنُّ","أَن","تَبِيدَ","هَٰذِهِۦٓ","أَبَدًا"],"marked":[0],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-13-23-2","words":["verb:dakhala"],"options":[{"bs":"ulaze u njih","en":"they enter them"},{"bs":"uđite u njih!","en":"enter it!"},{"bs":"ušli su","en":"they entered"},{"bs":"pa uđite!","en":"so (you all) enter!"}],"ref":"13:23","answerWord":"يَدْخُلُونَهَا","answerSound":"audio/34adcb34a391d729d7e9.m4a","quranTranslation":{"text":"Gardens of Eden which they enter, along with all who do right of their fathers and their helpmeets and their seed. The angels enter unto them from every gate,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["جَنَّٰتُ","عَدْنٍ","يَدْخُلُونَهَا","وَمَن","صَلَحَ","مِنْ","ءَابَآئِهِمْ","وَأَزْوَٰجِهِمْ","وَذُرِّيَّٰتِهِمْ","وَٱلْمَلَٰٓئِكَةُ","يَدْخُلُونَ","عَلَيْهِم","مِّن","كُلِّ","بَابٍ"],"marked":[2],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-15-46-0","words":["verb:dakhala"],"options":[{"bs":"uđite u njih!","en":"enter it!"},{"bs":"ulaze","en":"they enter"},{"bs":"ulazi","en":"he/it enters"},{"bs":"ulazimo u nju","en":"we enter it"}],"ref":"15:46","answerWord":"ٱدْخُلُوهَا","answerSound":"audio/8016ceec28e21d86a1a5.m4a","quranTranslation":{"text":"(And it is said unto them): Enter them in peace, secure.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["ٱدْخُلُوهَا","بِسَلَٰمٍ","ءَامِنِينَ"],"marked":[0],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-39-72-1","words":["verb:dakhala"],"options":[{"bs":"uđite!","en":"(you all) enter!"},{"bs":"i da uđu","en":"and so that they may enter"},{"bs":"ušla je","en":"she/it entered"},{"bs":"pa su ušli","en":"and they entered"}],"ref":"39:72","answerWord":"ٱدْخُلُوٓا۟","answerSound":"audio/95328625d8b90ad5ad2e.m4a","quranTranslation":{"text":"It is said (unto them): Enter ye the gates of hell to dwell therein. Thus hapless is the journey's end of the scorners.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["قِيلَ","ٱدْخُلُوٓا۟","أَبْوَٰبَ","جَهَنَّمَ","خَٰلِدِينَ","فِيهَا","فَبِئْسَ","مَثْوَى","ٱلْمُتَكَبِّرِينَ"],"marked":[1],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-2-111-2","words":["verb:dakhala"],"options":[{"bs":"ulazi","en":"he/it enters"},{"bs":"uđite u njih!","en":"enter it!"},{"bs":"i uđite!","en":"and (you all) enter!"},{"bs":"(niko) neće ući u nju","en":"(no one) shall enter it"}],"ref":"2:111","answerWord":"يَدْخُلَ","answerSound":"audio/06c49dd78b3eacd67339.m4a","quranTranslation":{"text":"And they say: None entereth paradise unless he be a Jew or a Christian. These are their own desires. Say: Bring your proof (of what ye state) if ye are truthful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["وَقَالُوا۟","لَن","يَدْخُلَ","ٱلْجَنَّةَ","إِلَّا","مَن","كَانَ","هُودًا","أَوْ","نَصَٰرَىٰ","تِلْكَ","أَمَانِيُّهُمْ","قُلْ","هَاتُوا۟","بُرْهَٰنَكُمْ","إِن","كُنتُمْ","صَٰدِقِينَ"],"marked":[2],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-2-114-18","words":["verb:dakhala"],"options":[{"bs":"ulaze u njih","en":"they enter them"},{"bs":"pa uđite u njega!","en":"so (you all) enter it!"},{"bs":"ulazite u njih","en":"you (all) enter them"},{"bs":"ušli ste","en":"you (all) entered"}],"ref":"2:114","answerWord":"يَدْخُلُوهَآ","answerSound":"audio/199578e75a5f9cc5b87e.m4a","quranTranslation":{"text":"And who doth greater wrong than he who forbiddeth the approach to the sanctuaries of Allah lest His name should be mentioned therein, and striveth for their ruin. As for such, it was never meant that they should enter them except in fear. Theirs in the world is ignominy and theirs in the Hereafter is an awful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["وَمَنْ","أَظْلَمُ","مِمَّن","مَّنَعَ","مَسَٰجِدَ","ٱللَّهِ","أَن","يُذْكَرَ","فِيهَا","ٱسْمُهُۥ","وَسَعَىٰ","فِى","خَرَابِهَآ","أُو۟لَٰٓئِكَ","مَا","كَانَ","لَهُمْ","أَن","يَدْخُلُوهَآ","إِلَّا","خَآئِفِينَ","لَهُمْ","فِى","ٱلدُّنْيَا","خِزْىٌ","وَلَهُمْ","فِى","ٱلْءَاخِرَةِ","عَذَابٌ","عَظِيمٌ"],"marked":[18],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-3-97-6","words":["verb:dakhala"],"options":[{"bs":"ušao je u njega","en":"he/it entered it"},{"bs":"i uđite!","en":"and (you all) enter!"},{"bs":"ušli su u njega","en":"they entered it"},{"bs":"(niko) neće ući u nju","en":"(no one) shall enter it"}],"ref":"3:97","answerWord":"دَخَلَهُۥ","answerSound":"audio/45d120f988b024d96469.m4a","quranTranslation":{"text":"Wherein are plain memorials (of Allah's guidance); the place where Abraham stood up to pray; and whosoever entereth it is safe. And pilgrimage to the House is a duty unto Allah for mankind, for him who can find a way thither. As for him who disbelieveth, (let him know that) lo! Allah is Independent of (all) creatures.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["فِيهِ","ءَايَٰتٌۢ","بَيِّنَٰتٌ","مَّقَامُ","إِبْرَٰهِيمَ","وَمَن","دَخَلَهُۥ","كَانَ","ءَامِنًا","وَلِلَّهِ","عَلَى","ٱلنَّاسِ","حِجُّ","ٱلْبَيْتِ","مَنِ","ٱسْتَطَاعَ","إِلَيْهِ","سَبِيلًا","وَمَن","كَفَرَ","فَإِنَّ","ٱللَّهَ","غَنِىٌّ","عَنِ","ٱلْعَٰلَمِينَ"],"marked":[6],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-5-22-8","words":["verb:dakhala"],"options":[{"bs":"ulazimo u nju","en":"we enter it"},{"bs":"i uđi!","en":"and enter!"},{"bs":"i da uđu","en":"and so that they may enter"},{"bs":"zaista ćete ući","en":"surely you (all) will enter"}],"ref":"5:22","answerWord":"نَّدْخُلَهَا","answerSound":"audio/48938d5c7b81310795fd.m4a","quranTranslation":{"text":"They said: O Moses! Lo! a giant people (dwell) therein and lo! we go not in till they go forth from thence. When they go forth from thence, then we will enter (not till then).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["قَالُوا۟","يَٰمُوسَىٰٓ","إِنَّ","فِيهَا","قَوْمًا","جَبَّارِينَ","وَإِنَّا","لَن","نَّدْخُلَهَا","حَتَّىٰ","يَخْرُجُوا۟","مِنْهَا","فَإِن","يَخْرُجُوا۟","مِنْهَا","فَإِنَّا","دَٰخِلُونَ"],"marked":[8],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-5-23-12","words":["verb:dakhala"],"options":[{"bs":"ušli ste kroz njih","en":"you (all) entered it"},{"bs":"ulazimo u nju","en":"we enter it"},{"bs":"ulazi","en":"he/it enters"},{"bs":"uđite!","en":"(you all) enter!"}],"ref":"5:23","answerWord":"دَخَلْتُمُوهُ","answerSound":"audio/375fa6839817995f69d0.m4a","quranTranslation":{"text":"Then out spake two of those who feared (their Lord, men) unto whom Allah had been gracious: Enter in upon them by the gate, for if ye enter by it, lo! ye will be victorious. So put your trust (in Allah) if ye are indeed believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["قَالَ","رَجُلَانِ","مِنَ","ٱلَّذِينَ","يَخَافُونَ","أَنْعَمَ","ٱللَّهُ","عَلَيْهِمَا","ٱدْخُلُوا۟","عَلَيْهِمُ","ٱلْبَابَ","فَإِذَا","دَخَلْتُمُوهُ","فَإِنَّكُمْ","غَٰلِبُونَ","وَعَلَى","ٱللَّهِ","فَتَوَكَّلُوٓا۟","إِن","كُنتُم","مُّؤْمِنِينَ"],"marked":[12],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-5-24-4","words":["verb:dakhala"],"options":[{"bs":"ulazimo u nju","en":"we enter it"},{"bs":"ulazi","en":"he/it enters"},{"bs":"ušli ste","en":"you (all) entered"},{"bs":"uđite!","en":"(you all) enter!"}],"ref":"5:24","answerWord":"نَّدْخُلَهَآ","answerSound":"audio/ede0d23030a546d93917.m4a","quranTranslation":{"text":"They said: O Moses! We will never enter (the land) while they are in it. So go thou and thy Lord and fight! We will sit here.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["قَالُوا۟","يَٰمُوسَىٰٓ","إِنَّا","لَن","نَّدْخُلَهَآ","أَبَدًا","مَّا","دَامُوا۟","فِيهَا","فَٱذْهَبْ","أَنتَ","وَرَبُّكَ","فَقَٰتِلَآ","إِنَّا","هَٰهُنَا","قَٰعِدُونَ"],"marked":[4],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-5-61-5","words":["verb:dakhala"],"options":[{"bs":"ušli su","en":"they entered"},{"bs":"pa uđite!","en":"so (you all) enter!"},{"bs":"i uđi!","en":"and enter!"},{"bs":"i da uđu","en":"and so that they may enter"}],"ref":"5:61","answerWord":"دَّخَلُوا۟","answerSound":"audio/d1f2ea90d34ca21d049d.m4a","quranTranslation":{"text":"When they come unto you (Muslims), they say: We believe; but they came in unbelief and they went out in the same; and Allah knoweth best what they were hiding.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["وَإِذَا","جَآءُوكُمْ","قَالُوٓا۟","ءَامَنَّا","وَقَد","دَّخَلُوا۟","بِٱلْكُفْرِ","وَهُمْ","قَدْ","خَرَجُوا۟","بِهِۦ","وَٱللَّهُ","أَعْلَمُ","بِمَا","كَانُوا۟","يَكْتُمُونَ"],"marked":[5],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-7-46-15","words":["verb:dakhala"],"options":[{"bs":"ulaze u njega","en":"they enter it"},{"bs":"ušli ste","en":"you (all) entered"},{"bs":"ušli su u njega","en":"they entered it"},{"bs":"ulaze","en":"they enter"}],"ref":"7:46","answerWord":"يَدْخُلُوهَا","answerSound":"audio/a66dd4ac304eb04dd4b2.m4a","quranTranslation":{"text":"Between them is a veil. And on the Heights are men who know them all by their marks. And they call unto the dwellers of the Garden: Peace be unto you! They enter it not although they hope (to enter).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["وَبَيْنَهُمَا","حِجَابٌ","وَعَلَى","ٱلْأَعْرَافِ","رِجَالٌ","يَعْرِفُونَ","كُلًّۢا","بِسِيمَىٰهُمْ","وَنَادَوْا۟","أَصْحَٰبَ","ٱلْجَنَّةِ","أَن","سَلَٰمٌ","عَلَيْكُمْ","لَمْ","يَدْخُلُوهَا","وَهُمْ","يَطْمَعُونَ"],"marked":[15],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-12-58-3","words":["verb:dakhala"],"options":[{"bs":"pa su ušli","en":"and they entered"},{"bs":"i da uđu","en":"and so that they may enter"},{"bs":"i uđite!","en":"and (you all) enter!"},{"bs":"ulazi","en":"he/it enters"}],"ref":"12:58","answerWord":"فَدَخَلُوا۟","answerSound":"audio/2e9eea25d4f91978479d.m4a","quranTranslation":{"text":"And Joseph's brethren came and presented themselves before him, and he knew them but they knew him not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["وَجَآءَ","إِخْوَةُ","يُوسُفَ","فَدَخَلُوا۟","عَلَيْهِ","فَعَرَفَهُمْ","وَهُمْ","لَهُۥ","مُنكِرُونَ"],"marked":[3],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-16-29-0","words":["verb:dakhala"],"options":[{"bs":"pa uđite!","en":"so (you all) enter!"},{"bs":"ulaze u njih","en":"they enter them"},{"bs":"pa su ušli","en":"and they entered"},{"bs":"i da uđu","en":"and so that they may enter"}],"ref":"16:29","answerWord":"فَٱدْخُلُوٓا۟","answerSound":"audio/2cb2b7c22597bcdee3f9.m4a","quranTranslation":{"text":"So enter the gates of hell, to dwell therein for ever. Woeful indeed will be the lodging of the arrogant.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["فَٱدْخُلُوٓا۟","أَبْوَٰبَ","جَهَنَّمَ","خَٰلِدِينَ","فِيهَا","فَلَبِئْسَ","مَثْوَى","ٱلْمُتَكَبِّرِينَ"],"marked":[0],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-17-7-13","words":["verb:dakhala"],"options":[{"bs":"i da uđu","en":"and so that they may enter"},{"bs":"pa su ušli","en":"and they entered"},{"bs":"ulazite u njih","en":"you (all) enter them"},{"bs":"uđi!","en":"enter!"}],"ref":"17:7","answerWord":"وَلِيَدْخُلُوا۟","answerSound":"audio/a6f3bbfeb5462be53263.m4a","quranTranslation":{"text":"(Saying): If ye do good, ye do good for your own souls, and if ye do evil, it is for them (in like manner). So, when the time for the second (of the judgments) came (We roused against you others of Our slaves) to ravage you, and to enter the Temple even as they entered it the first time, and to lay waste all that they conquered with an utter wasting.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["إِنْ","أَحْسَنتُمْ","أَحْسَنتُمْ","لِأَنفُسِكُمْ","وَإِنْ","أَسَأْتُمْ","فَلَهَا","فَإِذَا","جَآءَ","وَعْدُ","ٱلْءَاخِرَةِ","لِيَسُۥٓـُٔوا۟","وُجُوهَكُمْ","وَلِيَدْخُلُوا۟","ٱلْمَسْجِدَ","كَمَا","دَخَلُوهُ","أَوَّلَ","مَرَّةٍ","وَلِيُتَبِّرُوا۟","مَا","عَلَوْا۟","تَتْبِيرًا"],"marked":[13],"facts":{"verb":"دَخَلَ"}},{"id":"dakhala-17-7-16","words":["verb:dakhala"],"options":[{"bs":"ušli su u njega","en":"they entered it"},{"bs":"ulazi","en":"he/it enters"},{"bs":"pa uđi!","en":"so enter!"},{"bs":"ušao je u njega","en":"he/it entered it"}],"ref":"17:7","answerWord":"دَخَلُوهُ","answerSound":"audio/99c766beaa7e959b3113.m4a","quranTranslation":{"text":"(Saying): If ye do good, ye do good for your own souls, and if ye do evil, it is for them (in like manner). So, when the time for the second (of the judgments) came (We roused against you others of Our slaves) to ravage you, and to enter the Temple even as they entered it the first time, and to lay waste all that they conquered with an utter wasting.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ući","en":"to enter"},"passage":["إِنْ","أَحْسَنتُمْ","أَحْسَنتُمْ","لِأَنفُسِكُمْ","وَإِنْ","أَسَأْتُمْ","فَلَهَا","فَإِذَا","جَآءَ","وَعْدُ","ٱلْءَاخِرَةِ","لِيَسُۥٓـُٔوا۟","وُجُوهَكُمْ","وَلِيَدْخُلُوا۟","ٱلْمَسْجِدَ","كَمَا","دَخَلُوهُ","أَوَّلَ","مَرَّةٍ","وَلِيُتَبِّرُوا۟","مَا","عَلَوْا۟","تَتْبِيرًا"],"marked":[16],"facts":{"verb":"دَخَلَ"}},{"id":"tadhakkara-23-85-4","words":["verb:tadhakkara"],"options":[{"bs":"sjećate se","en":"you (all) remember"},{"bs":"sjetio se","en":"he/it remembered"},{"bs":"poučit će se","en":"will take heed"},{"bs":"sjećaju se","en":"they remember"}],"ref":"23:85","answerWord":"تَذَكَّرُونَ","answerSound":"audio/99a5a50c4ec1b5a03508.m4a","quranTranslation":{"text":"They will say: Unto Allah. Say: Will ye not then remember?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["سَيَقُولُونَ","لِلَّهِ","قُلْ","أَفَلَا","تَذَكَّرُونَ"],"marked":[4],"facts":{"verb":"تَذَكَّرَ"}},{"id":"tadhakkara-44-58-4","words":["verb:tadhakkara"],"options":[{"bs":"sjećaju se","en":"they remember"},{"bs":"i da se sjeti","en":"and so that he/it may remember"},{"bs":"sjećate se","en":"you (all) remember"},{"bs":"sjetio se","en":"he/it remembered"}],"ref":"44:58","answerWord":"يَتَذَكَّرُونَ","answerSound":"audio/2d28532fc2b0884e95a8.m4a","quranTranslation":{"text":"And We have made (this Scripture) easy in thy language only that they may heed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["فَإِنَّمَا","يَسَّرْنَٰهُ","بِلِسَانِكَ","لَعَلَّهُمْ","يَتَذَكَّرُونَ"],"marked":[4],"facts":{"verb":"تَذَكَّرَ"}},{"id":"tadhakkara-13-19-12","words":["verb:tadhakkara"],"options":[{"bs":"sjeća se","en":"he/it remembers"},{"bs":"sjećaju se","en":"they remember"},{"bs":"sjetio se","en":"he/it remembered"},{"bs":"sjećate se","en":"you (all) remember"}],"ref":"13:19","answerWord":"يَتَذَكَّرُ","answerSound":"audio/6ded0f8060ae20b1ea3d.m4a","quranTranslation":{"text":"Is he who knoweth that what is revealed unto thee from thy Lord is the truth like him who is blind? But only men of understanding heed;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["أَفَمَن","يَعْلَمُ","أَنَّمَآ","أُنزِلَ","إِلَيْكَ","مِن","رَّبِّكَ","ٱلْحَقُّ","كَمَنْ","هُوَ","أَعْمَىٰٓ","إِنَّمَا","يَتَذَكَّرُ","أُو۟لُوا۟","ٱلْأَلْبَٰبِ"],"marked":[12],"facts":{"verb":"تَذَكَّرَ"}},{"id":"tadhakkara-6-126-8","words":["verb:tadhakkara"],"options":[{"bs":"sjećaju se","en":"they remember"},{"bs":"sjetio se","en":"he/it remembered"},{"bs":"i da se sjeti","en":"and so that he/it may remember"},{"bs":"sjećate se","en":"you (all) remember"}],"ref":"6:126","answerWord":"يَذَّكَّرُونَ","answerSound":"audio/8af8237bc90dbee7e43d.m4a","quranTranslation":{"text":"This is the path of thy Lord, a straight path. We have detailed Our revelations for a people who take heed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["وَهَٰذَا","صِرَٰطُ","رَبِّكَ","مُسْتَقِيمًا","قَدْ","فَصَّلْنَا","ٱلْءَايَٰتِ","لِقَوْمٍ","يَذَّكَّرُونَ"],"marked":[8],"facts":{"verb":"تَذَكَّرَ"}},{"id":"tadhakkara-2-269-12","words":["verb:tadhakkara"],"options":[{"bs":"sjeća se","en":"he/it remembers"},{"bs":"sjete se","en":"they remember"},{"bs":"sjećate se","en":"you (all) remember"},{"bs":"sjetio se","en":"he/it remembered"}],"ref":"2:269","answerWord":"يَذَّكَّرُ","answerSound":"audio/d867e89c634e2914f064.m4a","quranTranslation":{"text":"He giveth wisdom unto whom He will, and he unto whom wisdom is given, he truly hath received abundant good. But none remember except men of understanding.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["يُؤْتِى","ٱلْحِكْمَةَ","مَن","يَشَآءُ","وَمَن","يُؤْتَ","ٱلْحِكْمَةَ","فَقَدْ","أُوتِىَ","خَيْرًا","كَثِيرًا","وَمَا","يَذَّكَّرُ","إِلَّآ","أُو۟لُوا۟","ٱلْأَلْبَٰبِ"],"marked":[12],"facts":{"verb":"تَذَكَّرَ"}},{"id":"tadhakkara-6-80-24","words":["verb:tadhakkara"],"options":[{"bs":"sjećate se","en":"you (all) remember"},{"bs":"i da se sjeti","en":"and so that he/it may remember"},{"bs":"sjetio se","en":"he/it remembered"},{"bs":"da se sjete","en":"so that they may remember"}],"ref":"6:80","answerWord":"تَتَذَكَّرُونَ","answerSound":"audio/8a16b308ada3975ba9f9.m4a","quranTranslation":{"text":"His people argued with him. He said: Dispute ye with me concerning Allah when He hath guided me? I fear not at all that which ye set up beside Him unless my Lord willeth aught. My Lord includeth all things in His knowledge. Will ye not then remember?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["وَحَآجَّهُۥ","قَوْمُهُۥ","قَالَ","أَتُحَٰٓجُّوٓنِّى","فِى","ٱللَّهِ","وَقَدْ","هَدَىٰنِ","وَلَآ","أَخَافُ","مَا","تُشْرِكُونَ","بِهِۦٓ","إِلَّآ","أَن","يَشَآءَ","رَبِّى","شَيْـًٔا","وَسِعَ","رَبِّى","كُلَّ","شَىْءٍ","عِلْمًا","أَفَلَا","تَتَذَكَّرُونَ"],"marked":[24],"facts":{"verb":"تَذَكَّرَ"}},{"id":"tadhakkara-17-41-5","words":["verb:tadhakkara"],"options":[{"bs":"da se sjete","en":"so that they may remember"},{"bs":"sjeća se","en":"he/it remembers"},{"bs":"sjete se","en":"they remember"},{"bs":"sjećate se","en":"you (all) remember"}],"ref":"17:41","answerWord":"لِيَذَّكَّرُوا۟","answerSound":"audio/638f610c84e14d3de752.m4a","quranTranslation":{"text":"We verily have displayed (Our warnings) in this Qur'an that they may take heed, but it increaseth them in naught save aversion.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["وَلَقَدْ","صَرَّفْنَا","فِى","هَٰذَا","ٱلْقُرْءَانِ","لِيَذَّكَّرُوا۟","وَمَا","يَزِيدُهُمْ","إِلَّا","نُفُورًا"],"marked":[5],"facts":{"verb":"تَذَكَّرَ"}},{"id":"tadhakkara-14-52-10","words":["verb:tadhakkara"],"options":[{"bs":"i da se sjeti","en":"and so that he/it may remember"},{"bs":"sjetio se","en":"he/it remembered"},{"bs":"sjete se","en":"they remember"},{"bs":"sjećate se","en":"you (all) remember"}],"ref":"14:52","answerWord":"وَلِيَذَّكَّرَ","answerSound":"audio/9d631966db5089c90a59.m4a","quranTranslation":{"text":"This is a clear message for mankind in order that they may be warned thereby, and that they may know that He is only One Allah, and that men of understanding may take heed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["هَٰذَا","بَلَٰغٌ","لِّلنَّاسِ","وَلِيُنذَرُوا۟","بِهِۦ","وَلِيَعْلَمُوٓا۟","أَنَّمَا","هُوَ","إِلَٰهٌ","وَٰحِدٌ","وَلِيَذَّكَّرَ","أُو۟لُوا۟","ٱلْأَلْبَٰبِ"],"marked":[10],"facts":{"verb":"تَذَكَّرَ"}},{"id":"tadhakkara-25-62-9","words":["verb:tadhakkara"],"options":[{"bs":"sjeća se","en":"he/it remembers"},{"bs":"sjete se","en":"they remember"},{"bs":"da se sjete","en":"so that they may remember"},{"bs":"sjećate se","en":"you (all) remember"}],"ref":"25:62","answerWord":"يَذَّكَّرَ","answerSound":"audio/f0eb161fca58d87f7734.m4a","quranTranslation":{"text":"And He it is Who hath appointed night and day in succession, for him who desireth to remember, or desireth thankfulness.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["وَهُوَ","ٱلَّذِى","جَعَلَ","ٱلَّيْلَ","وَٱلنَّهَارَ","خِلْفَةً","لِّمَنْ","أَرَادَ","أَن","يَذَّكَّرَ","أَوْ","أَرَادَ","شُكُورًا"],"marked":[9],"facts":{"verb":"تَذَكَّرَ"}},{"id":"tadhakkara-35-37-17","words":["verb:tadhakkara"],"options":[{"bs":"sjetio se","en":"he/it remembered"},{"bs":"sjeća se","en":"he/it remembers"},{"bs":"sjećaju se","en":"they remember"},{"bs":"sjećate se","en":"you (all) remember"}],"ref":"35:37","answerWord":"تَذَكَّرَ","answerSound":"audio/173ce0c46e5af5c99209.m4a","quranTranslation":{"text":"And they cry for help there, (saying): Our Lord! Release us; we will do right, not (the wrong) that we used to do. Did not We grant you a life long enough for him who reflected to reflect therein? And the warner came unto you. Now taste (the flavour of your deeds), for evil-doers have no helper.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["وَهُمْ","يَصْطَرِخُونَ","فِيهَا","رَبَّنَآ","أَخْرِجْنَا","نَعْمَلْ","صَٰلِحًا","غَيْرَ","ٱلَّذِى","كُنَّا","نَعْمَلُ","أَوَلَمْ","نُعَمِّرْكُم","مَّا","يَتَذَكَّرُ","فِيهِ","مَن","تَذَكَّرَ","وَجَآءَكُمُ","ٱلنَّذِيرُ","فَذُوقُوا۟","فَمَا","لِلظَّٰلِمِينَ","مِن","نَّصِيرٍ"],"marked":[17],"facts":{"verb":"تَذَكَّرَ"}},{"id":"tadhakkara-38-29-6","words":["verb:tadhakkara"],"options":[{"bs":"i da se sjeti","en":"and so that he/it may remember"},{"bs":"sjećaju se","en":"they remember"},{"bs":"sjećate se","en":"you (all) remember"},{"bs":"sjetio se","en":"he/it remembered"}],"ref":"38:29","answerWord":"وَلِيَتَذَكَّرَ","answerSound":"audio/d9de6b24c8148a814f53.m4a","quranTranslation":{"text":"(This is) a Scripture that We have revealed unto thee, full of blessing, that they may ponder its revelations, and that men of understanding may reflect.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["كِتَٰبٌ","أَنزَلْنَٰهُ","إِلَيْكَ","مُبَٰرَكٌ","لِّيَدَّبَّرُوٓا۟","ءَايَٰتِهِۦ","وَلِيَتَذَكَّرَ","أُو۟لُوا۟","ٱلْأَلْبَٰبِ"],"marked":[6],"facts":{"verb":"تَذَكَّرَ"}},{"id":"tadhakkara-87-10-0","words":["verb:tadhakkara"],"options":[{"bs":"poučit će se","en":"will take heed"},{"bs":"da se sjete","en":"so that they may remember"},{"bs":"sjećate se","en":"you (all) remember"},{"bs":"sjetio se","en":"he/it remembered"}],"ref":"87:10","answerWord":"سَيَذَّكَّرُ","answerSound":"audio/579b61ccf04ffbd13352.m4a","quranTranslation":{"text":"He will heed who feareth,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sjetiti se, poučiti se","en":"to remember, to take heed"},"passage":["سَيَذَّكَّرُ","مَن","يَخْشَىٰ"],"marked":[0],"facts":{"verb":"تَذَكَّرَ"}},{"id":"raja-29-5-2","words":["verb:raja"],"options":[{"bs":"nada se","en":"he/it hopes"},{"bs":"nadate se","en":"you (all) hope"},{"bs":"i nadaju se","en":"and they hope"},{"bs":"i nadajte se!","en":"and (you all) hope!"}],"ref":"29:5","answerWord":"يَرْجُوا۟","answerSound":"audio/45b2c20b89bed644ef4e.m4a","quranTranslation":{"text":"Whoso looketh forward to the meeting with Allah (let him know that) Allah's reckoning is surely nigh, and He is the Hearer, the Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nadati se","en":"to hope"},"passage":["مَن","كَانَ","يَرْجُوا۟","لِقَآءَ","ٱللَّهِ","فَإِنَّ","أَجَلَ","ٱللَّهِ","لَءَاتٍ","وَهُوَ","ٱلسَّمِيعُ","ٱلْعَلِيمُ"],"marked":[2],"facts":{"verb":"رَجَا"}},{"id":"raja-29-36-8","words":["verb:raja"],"options":[{"bs":"i nadajte se!","en":"and (you all) hope!"},{"bs":"nadaju se","en":"they hope"},{"bs":"nadate se","en":"you (all) hope"},{"bs":"i nada se","en":"and he/it hopes"}],"ref":"29:36","answerWord":"وَٱرْجُوا۟","answerSound":"audio/9b52b4f5c4ca0cfd3aa5.m4a","quranTranslation":{"text":"And unto Midian We sent Shu'eyb, their brother. He said: O my people! Serve Allah, and look forward to the Last Day, and do not evil, making mischief, in the earth.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nadati se","en":"to hope"},"passage":["وَإِلَىٰ","مَدْيَنَ","أَخَاهُمْ","شُعَيْبًا","فَقَالَ","يَٰقَوْمِ","ٱعْبُدُوا۟","ٱللَّهَ","وَٱرْجُوا۟","ٱلْيَوْمَ","ٱلْءَاخِرَ","وَلَا","تَعْثَوْا۟","فِى","ٱلْأَرْضِ","مُفْسِدِينَ"],"marked":[8],"facts":{"verb":"رَجَا"}},{"id":"raja-39-9-9","words":["verb:raja"],"options":[{"bs":"i nada se","en":"and he/it hopes"},{"bs":"i nadajte se!","en":"and (you all) hope!"},{"bs":"i nadate se","en":"and you (all) hope"},{"bs":"nadaju se","en":"they hope"}],"ref":"39:9","answerWord":"وَيَرْجُوا۟","answerSound":"audio/1ac5450709a26da9eb40.m4a","quranTranslation":{"text":"Is he who payeth adoration in the watches of the night, prostrate and standing, bewaring of the Hereafter and hoping for the mercy of his Lord, (to be accounted equal with a disbeliever)? Say (unto them, O Muhammad): Are those who know equal with those who know not? But only men of understanding will pay heed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nadati se","en":"to hope"},"passage":["أَمَّنْ","هُوَ","قَٰنِتٌ","ءَانَآءَ","ٱلَّيْلِ","سَاجِدًا","وَقَآئِمًا","يَحْذَرُ","ٱلْءَاخِرَةَ","وَيَرْجُوا۟","رَحْمَةَ","رَبِّهِۦ","قُلْ","هَلْ","يَسْتَوِى","ٱلَّذِينَ","يَعْلَمُونَ","وَٱلَّذِينَ","لَا","يَعْلَمُونَ","إِنَّمَا","يَتَذَكَّرُ","أُو۟لُوا۟","ٱلْأَلْبَٰبِ"],"marked":[9],"facts":{"verb":"رَجَا"}},{"id":"wadaa-24-60-11","words":["verb:wadaa"],"options":[{"bs":"skidaju","en":"they remove"},{"bs":"skidate","en":"you (all) remove"},{"bs":"postavio ju je","en":"He laid it out"},{"bs":"i skida","en":"and he/it removes"}],"ref":"24:60","answerWord":"يَضَعْنَ","answerSound":"audio/c3065435188f23c8e3bf.m4a","quranTranslation":{"text":"As for women past child-bearing, who have no hope of marriage, it is no sin for them if they discard their (outer) clothing in such a way as not to show adornment. But to refrain is better for them. Allah is Hearer, Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"staviti, položiti","en":"to put, to place"},"passage":["وَٱلْقَوَٰعِدُ","مِنَ","ٱلنِّسَآءِ","ٱلَّٰتِى","لَا","يَرْجُونَ","نِكَاحًا","فَلَيْسَ","عَلَيْهِنَّ","جُنَاحٌ","أَن","يَضَعْنَ","ثِيَابَهُنَّ","غَيْرَ","مُتَبَرِّجَٰتٍۭ","بِزِينَةٍ","وَأَن","يَسْتَعْفِفْنَ","خَيْرٌ","لَّهُنَّ","وَٱللَّهُ","سَمِيعٌ","عَلِيمٌ"],"marked":[11],"facts":{"verb":"وَضَعَ"}},{"id":"wadaa-18-49-0","words":["verb:wadaa"],"options":[{"bs":"i stavljeno je","en":"and it was put"},{"bs":"rodila je","en":"she/it gave birth"},{"bs":"i stavljamo","en":"and we put"},{"bs":"i skida","en":"and he/it removes"}],"ref":"18:49","answerWord":"وَوُضِعَ","answerSound":"audio/96d1dfc88c06b303bc92.m4a","quranTranslation":{"text":"And the Book is placed, and thou seest the guilty fearful of that which is therein, and they say: What kind of a Book is this that leaveth not a small thing nor a great thing but hath counted it! And they find all that they did confronting them, and thy Lord wrongeth no-one.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"staviti, položiti","en":"to put, to place"},"passage":["وَوُضِعَ","ٱلْكِتَٰبُ","فَتَرَى","ٱلْمُجْرِمِينَ","مُشْفِقِينَ","مِمَّا","فِيهِ","وَيَقُولُونَ","يَٰوَيْلَتَنَا","مَالِ","هَٰذَا","ٱلْكِتَٰبِ","لَا","يُغَادِرُ","صَغِيرَةً","وَلَا","كَبِيرَةً","إِلَّآ","أَحْصَىٰهَا","وَوَجَدُوا۟","مَا","عَمِلُوا۟","حَاضِرًا","وَلَا","يَظْلِمُ","رَبُّكَ","أَحَدًا"],"marked":[0],"facts":{"verb":"وَضَعَ"}},{"id":"wadaa-3-36-1","words":["verb:wadaa"],"options":[{"bs":"rodila ju je","en":"she/it gave birth to her"},{"bs":"i stavio je","en":"and he/it put"},{"bs":"postavio ju je","en":"He laid it out"},{"bs":"rodila je","en":"she/it gave birth"}],"ref":"3:36","answerWord":"وَضَعَتْهَا","answerSound":"audio/8f6b50c0f2f090a28a2f.m4a","quranTranslation":{"text":"And when she was delivered she said: My Lord! Lo! I am delivered of a female - Allah knew best of what she was delivered - the male is not as the female; and lo! I have named her Mary, and lo! I crave Thy protection for her and for her offspring from Satan the outcast.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"staviti, položiti","en":"to put, to place"},"passage":["فَلَمَّا","وَضَعَتْهَا","قَالَتْ","رَبِّ","إِنِّى","وَضَعْتُهَآ","أُنثَىٰ","وَٱللَّهُ","أَعْلَمُ","بِمَا","وَضَعَتْ","وَلَيْسَ","ٱلذَّكَرُ","كَٱلْأُنثَىٰ","وَإِنِّى","سَمَّيْتُهَا","مَرْيَمَ","وَإِنِّىٓ","أُعِيذُهَا","بِكَ","وَذُرِّيَّتَهَا","مِنَ","ٱلشَّيْطَٰنِ","ٱلرَّجِيمِ"],"marked":[1],"facts":{"verb":"وَضَعَ"}},{"id":"wadaa-3-36-5","words":["verb:wadaa"],"options":[{"bs":"rodila sam je","en":"I gave birth to her"},{"bs":"i rodila ga je","en":"and she/it gave birth to him"},{"bs":"stavljeno je","en":"it was put"},{"bs":"rodila ju je","en":"she/it gave birth to her"}],"ref":"3:36","answerWord":"وَضَعْتُهَآ","answerSound":"audio/e38a8e01b654cf8280b1.m4a","quranTranslation":{"text":"And when she was delivered she said: My Lord! Lo! I am delivered of a female - Allah knew best of what she was delivered - the male is not as the female; and lo! I have named her Mary, and lo! I crave Thy protection for her and for her offspring from Satan the outcast.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"staviti, položiti","en":"to put, to place"},"passage":["فَلَمَّا","وَضَعَتْهَا","قَالَتْ","رَبِّ","إِنِّى","وَضَعْتُهَآ","أُنثَىٰ","وَٱللَّهُ","أَعْلَمُ","بِمَا","وَضَعَتْ","وَلَيْسَ","ٱلذَّكَرُ","كَٱلْأُنثَىٰ","وَإِنِّى","سَمَّيْتُهَا","مَرْيَمَ","وَإِنِّىٓ","أُعِيذُهَا","بِكَ","وَذُرِّيَّتَهَا","مِنَ","ٱلشَّيْطَٰنِ","ٱلرَّجِيمِ"],"marked":[5],"facts":{"verb":"وَضَعَ"}},{"id":"wadaa-3-36-10","words":["verb:wadaa"],"options":[{"bs":"rodila je","en":"she/it gave birth"},{"bs":"postavio ju je","en":"He laid it out"},{"bs":"i skida","en":"and he/it removes"},{"bs":"skidaju","en":"they remove"}],"ref":"3:36","answerWord":"وَضَعَتْ","answerSound":"audio/36808a7b093f860ca4da.m4a","quranTranslation":{"text":"And when she was delivered she said: My Lord! Lo! I am delivered of a female - Allah knew best of what she was delivered - the male is not as the female; and lo! I have named her Mary, and lo! I crave Thy protection for her and for her offspring from Satan the outcast.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"staviti, položiti","en":"to put, to place"},"passage":["فَلَمَّا","وَضَعَتْهَا","قَالَتْ","رَبِّ","إِنِّى","وَضَعْتُهَآ","أُنثَىٰ","وَٱللَّهُ","أَعْلَمُ","بِمَا","وَضَعَتْ","وَلَيْسَ","ٱلذَّكَرُ","كَٱلْأُنثَىٰ","وَإِنِّى","سَمَّيْتُهَا","مَرْيَمَ","وَإِنِّىٓ","أُعِيذُهَا","بِكَ","وَذُرِّيَّتَهَا","مِنَ","ٱلشَّيْطَٰنِ","ٱلرَّجِيمِ"],"marked":[10],"facts":{"verb":"وَضَعَ"}},{"id":"wadaa-3-96-3","words":["verb:wadaa"],"options":[{"bs":"stavljeno je","en":"it was put"},{"bs":"skidate","en":"you (all) remove"},{"bs":"rodila ju je","en":"she/it gave birth to her"},{"bs":"rodila je","en":"she/it gave birth"}],"ref":"3:96","answerWord":"وُضِعَ","answerSound":"audio/d7975a86103912e2bf92.m4a","quranTranslation":{"text":"Lo! the first Sanctuary appointed for mankind was that at Becca, a blessed place, a guidance to the peoples;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"staviti, položiti","en":"to put, to place"},"passage":["إِنَّ","أَوَّلَ","بَيْتٍ","وُضِعَ","لِلنَّاسِ","لَلَّذِى","بِبَكَّةَ","مُبَارَكًا","وَهُدًى","لِّلْعَٰلَمِينَ"],"marked":[3],"facts":{"verb":"وَضَعَ"}},{"id":"wadaa-21-47-0","words":["verb:wadaa"],"options":[{"bs":"i stavljamo","en":"and we put"},{"bs":"rodila sam je","en":"I gave birth to her"},{"bs":"i stavljeno je","en":"and it was put"},{"bs":"i skinuli smo","en":"and we removed"}],"ref":"21:47","answerWord":"وَنَضَعُ","answerSound":"audio/0df26bd36a43fb1975d8.m4a","quranTranslation":{"text":"And We set a just balance for the Day of Resurrection so that no soul is wronged in aught. Though it be of the weight of a grain of mustard seed, We bring it. And We suffice for reckoners.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"staviti, položiti","en":"to put, to place"},"passage":["وَنَضَعُ","ٱلْمَوَٰزِينَ","ٱلْقِسْطَ","لِيَوْمِ","ٱلْقِيَٰمَةِ","فَلَا","تُظْلَمُ","نَفْسٌ","شَيْـًٔا","وَإِن","كَانَ","مِثْقَالَ","حَبَّةٍ","مِّنْ","خَرْدَلٍ","أَتَيْنَا","بِهَا","وَكَفَىٰ","بِنَا","حَٰسِبِينَ"],"marked":[0],"facts":{"verb":"وَضَعَ"}},{"id":"wadaa-55-7-2","words":["verb:wadaa"],"options":[{"bs":"i stavio je","en":"and he/it put"},{"bs":"skidate","en":"you (all) remove"},{"bs":"skidaju","en":"they remove"},{"bs":"i skinuli smo","en":"and we removed"}],"ref":"55:7","answerWord":"وَوَضَعَ","answerSound":"audio/b06b5181e2cbe4aeca26.m4a","quranTranslation":{"text":"And the sky He hath uplifted; and He hath set the measure,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"staviti, položiti","en":"to put, to place"},"passage":["وَٱلسَّمَآءَ","رَفَعَهَا","وَوَضَعَ","ٱلْمِيزَانَ"],"marked":[2],"facts":{"verb":"وَضَعَ"}},{"id":"wadaa-55-10-1","words":["verb:wadaa"],"options":[{"bs":"postavio ju je","en":"He laid it out"},{"bs":"stavljeno je","en":"it was put"},{"bs":"rodila sam je","en":"I gave birth to her"},{"bs":"rodila ju je","en":"she/it gave birth to her"}],"ref":"55:10","answerWord":"وَضَعَهَا","answerSound":"audio/974fb31bb90554b875ab.m4a","quranTranslation":{"text":"And the earth hath He appointed for (His) creatures,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"staviti, položiti","en":"to put, to place"},"passage":["وَٱلْأَرْضَ","وَضَعَهَا","لِلْأَنَامِ"],"marked":[1],"facts":{"verb":"وَضَعَ"}},{"id":"wadaa-94-2-0","words":["verb:wadaa"],"options":[{"bs":"i skinuli smo","en":"and we removed"},{"bs":"rodila sam je","en":"I gave birth to her"},{"bs":"skidate","en":"you (all) remove"},{"bs":"i stavljamo","en":"and we put"}],"ref":"94:2","answerWord":"وَوَضَعْنَا","answerSound":"audio/cc389c579534b2f2960d.m4a","quranTranslation":{"text":"And eased thee of the burden","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"staviti, položiti","en":"to put, to place"},"passage":["وَوَضَعْنَا","عَنكَ","وِزْرَكَ"],"marked":[0],"facts":{"verb":"وَضَعَ"}},{"id":"nakaha-4-3-6","words":["verb:nakaha"],"options":[{"bs":"pa se oženite!","en":"so (you all) marry!"},{"bs":"ženite se","en":"you (all) marry"},{"bs":"pa ih oženite!","en":"so (you all) marry them!"},{"bs":"ženi je","en":"he/it marries her"}],"ref":"4:3","answerWord":"فَٱنكِحُوا۟","answerSound":"audio/33532269641ea5061b17.m4a","quranTranslation":{"text":"And if ye fear that ye will not deal fairly by the orphans, marry of the women, who seem good to you, two or three or four; and if ye fear that ye cannot do justice (to so many) then one (only) or (the captives) that your right hands possess. Thus it is more likely that ye will not do injustice.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vjenčati se, oženiti se","en":"to marry"},"passage":["وَإِنْ","خِفْتُمْ","أَلَّا","تُقْسِطُوا۟","فِى","ٱلْيَتَٰمَىٰ","فَٱنكِحُوا۟","مَا","طَابَ","لَكُم","مِّنَ","ٱلنِّسَآءِ","مَثْنَىٰ","وَثُلَٰثَ","وَرُبَٰعَ","فَإِنْ","خِفْتُمْ","أَلَّا","تَعْدِلُوا۟","فَوَٰحِدَةً","أَوْ","مَا","مَلَكَتْ","أَيْمَٰنُكُمْ","ذَٰلِكَ","أَدْنَىٰٓ","أَلَّا","تَعُولُوا۟"],"marked":[6],"facts":{"verb":"نَكَحَ"}},{"id":"nakaha-4-22-3","words":["verb:nakaha"],"options":[{"bs":"oženio se","en":"he/it married"},{"bs":"udaju se","en":"they marry"},{"bs":"pa se oženite!","en":"so (you all) marry!"},{"bs":"ženi se","en":"he/it marries"}],"ref":"4:22","answerWord":"نَكَحَ","answerSound":"audio/a9bce8d4cf012ee7d965.m4a","quranTranslation":{"text":"And marry not those women whom your fathers married, except what hath already happened (of that nature) in the past. Lo! it was ever lewdness and abomination, and an evil way.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vjenčati se, oženiti se","en":"to marry"},"passage":["وَلَا","تَنكِحُوا۟","مَا","نَكَحَ","ءَابَآؤُكُم","مِّنَ","ٱلنِّسَآءِ","إِلَّا","مَا","قَدْ","سَلَفَ","إِنَّهُۥ","كَانَ","فَٰحِشَةً","وَمَقْتًا","وَسَآءَ","سَبِيلًا"],"marked":[3],"facts":{"verb":"نَكَحَ"}},{"id":"nakaha-24-3-2","words":["verb:nakaha"],"options":[{"bs":"ženi se","en":"he/it marries"},{"bs":"ženite se","en":"you (all) marry"},{"bs":"oženili ste se","en":"you (all) married"},{"bs":"udaju se","en":"they marry"}],"ref":"24:3","answerWord":"يَنكِحُ","answerSound":"audio/dc58ef7fea088b452a96.m4a","quranTranslation":{"text":"The adulterer shall not marry save an adulteress or an idolatress, and the adulteress none shall marry save an adulterer or an idolater. All that is forbidden unto believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vjenčati se, oženiti se","en":"to marry"},"passage":["ٱلزَّانِى","لَا","يَنكِحُ","إِلَّا","زَانِيَةً","أَوْ","مُشْرِكَةً","وَٱلزَّانِيَةُ","لَا","يَنكِحُهَآ","إِلَّا","زَانٍ","أَوْ","مُشْرِكٌ","وَحُرِّمَ","ذَٰلِكَ","عَلَى","ٱلْمُؤْمِنِينَ"],"marked":[2],"facts":{"verb":"نَكَحَ"}},{"id":"nakaha-24-3-9","words":["verb:nakaha"],"options":[{"bs":"ženi je","en":"he/it marries her"},{"bs":"oženili ste se","en":"you (all) married"},{"bs":"udaju se","en":"they marry"},{"bs":"ženite se","en":"you (all) marry"}],"ref":"24:3","answerWord":"يَنكِحُهَآ","answerSound":"audio/8cad1588eb153e74abdb.m4a","quranTranslation":{"text":"The adulterer shall not marry save an adulteress or an idolatress, and the adulteress none shall marry save an adulterer or an idolater. All that is forbidden unto believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vjenčati se, oženiti se","en":"to marry"},"passage":["ٱلزَّانِى","لَا","يَنكِحُ","إِلَّا","زَانِيَةً","أَوْ","مُشْرِكَةً","وَٱلزَّانِيَةُ","لَا","يَنكِحُهَآ","إِلَّا","زَانٍ","أَوْ","مُشْرِكٌ","وَحُرِّمَ","ذَٰلِكَ","عَلَى","ٱلْمُؤْمِنِينَ"],"marked":[9],"facts":{"verb":"نَكَحَ"}},{"id":"nakaha-33-49-4","words":["verb:nakaha"],"options":[{"bs":"oženili ste se","en":"you (all) married"},{"bs":"pa se oženite!","en":"so (you all) marry!"},{"bs":"ženi je","en":"he/it marries her"},{"bs":"ženite se","en":"you (all) marry"}],"ref":"33:49","answerWord":"نَكَحْتُمُ","answerSound":"audio/84fe59a1b30bbd59e7f8.m4a","quranTranslation":{"text":"O ye who believe! If ye wed believing women and divorce them before ye have touched them, then there is no period that ye should reckon. But content them and release them handsomely.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"vjenčati se, oženiti se","en":"to marry"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓا۟","إِذَا","نَكَحْتُمُ","ٱلْمُؤْمِنَٰتِ","ثُمَّ","طَلَّقْتُمُوهُنَّ","مِن","قَبْلِ","أَن","تَمَسُّوهُنَّ","فَمَا","لَكُمْ","عَلَيْهِنَّ","مِنْ","عِدَّةٍ","تَعْتَدُّونَهَا","فَمَتِّعُوهُنَّ","وَسَرِّحُوهُنَّ","سَرَاحًا","جَمِيلًا"],"marked":[4],"facts":{"verb":"نَكَحَ"}}]