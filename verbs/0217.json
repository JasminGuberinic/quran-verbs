cf666a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "قُوٓا۟", "plain": "قُوا", "quran": true, "notUsed": false, "spoken": "audio/7c875f54628be86897e5.m4a", "recited": "audio/8bef34d63099653eb5e9.m4a", "recitedText": "قُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "قِينَ", "plain": "قِينَ", "quran": false, "notUsed": false, "spoken": "audio/9f77e90dae7195b932da.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "3:16", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/309.mp3", "translation": {"en": {"text": "Those who say: Our Lord! Lo! we believe. So forgive us our sins and guard us from the punishment of Fire;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar ki, \"Ey Rabbimiz! Biz inandık, iman getirdik, artık bizim suçlarımızı bağışla ve bizi ateş azabından koru!\" derler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ جو کہتے ہیں ے رب ہمارے! ہم ایمان لائے تو ہمارے گناہ معاف کر اور ہمیں دوزخ کے عذاب سے بچالے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Yaitu) orang-orang yang berdoa: Ya Tuhan kami, sesungguhnya kami telah beriman, maka ampunilah segala dosa kami dan peliharalah kami dari siksa neraka,\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُولُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱغْفِرْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ذُنُوبَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَقِنَا", "hit": true, "audio": "audio/4d6e07a369ce3faf643d.m4a", "gloss": {"bs": "i sačuvaj nas", "en": "and protect us", "tr": "ve bizi koru", "fr": "et protège-nous", "id": "dan lindungilah kami", "ur": "اور ہمیں بچا", "bn": "এবং আমাদের রক্ষা করো", "fa": "و ما را نگه دار"}}, {"text": "عَذَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلنَّارِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "52:27", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4762.mp3", "translation": {"en": {"text": "But Allah hath been gracious unto us and hath preserved us from the torment of the breath of Fire.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Allah bize lutfetti de bizi (vücûdun) içine işleyen (kavurucu) azabdan korudu.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اللہ نے ہم پر احسان کیا اور ہمیں لُو کے عذاب سے بچالیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka Allah memberikan karunia kepada kami dan memelihara kami dari azab neraka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَمَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَوَقَىٰنَا", "hit": true, "audio": "audio/2e9ceae3f2c6503f46c0.m4a", "gloss": {"bs": "i sačuvao nas je", "en": "and He protected us", "tr": "ve bizi korudu", "fr": "et Il nous a protégés", "id": "dan Dia melindungi kami", "ur": "اور اس نے ہمیں بچایا", "bn": "এবং তিনি আমাদের রক্ষা করলেন", "fa": "و ما را نگه داشت"}}, {"text": "عَذَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمُومِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "40:9", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4142.mp3", "translation": {"en": {"text": "And ward off from them ill-deeds; and he from whom Thou wardest off ill-deeds that day, him verily hast Thou taken into mercy. That is the supreme triumph.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Onları fenalıklardan koru. Sen her kimi fenalıklardan korursan, o gün muhakkak onu rahmetinle yarlığamışsındır. İşte asıl büyük kurtuluş da budur.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور انہیں گناہوں کی شامت سے بچالے، اور جسے تو اس دن گناہوں کی شامت سے بچائے تو بیشک تو نے اس پر رحم فرمایا، اور یہی بڑی کامیابی ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan peliharalah mereka dari (balasan) kejahatan. Dan orang-orang yang Engkau pelihara dari (pembalasan) kejahatan pada hari itu maka sesungguhnya telah Engkau anugerahkan rahmat kepadanya dan itulah kemenangan yang besar\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقِهِمُ", "hit": true, "audio": "audio/47d4900f0694ebea99e1.m4a", "gloss": {"bs": "i sačuvaj ih", "en": "and protect them", "tr": "ve onları koru", "fr": "et protège-les", "id": "dan lindungilah mereka", "ur": "اور انہیں بچا", "bn": "এবং তাদের রক্ষা করো", "fa": "و آنان را نگه دار"}}, {"text": "ٱلسَّيِّـَٔاتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَقِ", "hit": true, "audio": "audio/8d21cbed6de3cd338bea.m4a", "gloss": {"bs": "sačuvaš", "en": "You protect", "tr": "korursun", "fr": "Tu protèges", "id": "Engkau melindungi", "ur": "تو بچائے", "bn": "তুমি রক্ষা করো", "fa": "تو نگه می‌داری"}}, {"text": "ٱلسَّيِّـَٔاتِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَئِذٍ", "hit": false, "audio": null, "gloss": null}, {"text": "فَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "رَحِمْتَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْفَوْزُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَظِيمُ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَقِنَا", "count": 2, "first": "2:201", "audio": "audio/73220379b2c79cf55c0c.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": ["nahnu"]}], "gloss": {"bs": "i sačuvaj nas", "en": "and protect us", "tr": "ve bizi koru", "fr": "et protège-nous", "id": "dan lindungilah kami", "ur": "اور ہمیں بچا", "bn": "এবং আমাদের রক্ষা করো", "fa": "و ما را نگه دار"}}, {"arabic": "وَوَقَىٰهُمْ", "count": 2, "first": "44:56", "audio": "audio/43918b2748e7c20c313d.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hum"]}], "gloss": {"en": "and he/it protected them", "bs": "i zaštitio ih je", "tr": "ve onları korudu", "fr": "et il les a protégés", "id": "dan dia telah melindungi mereka", "ur": "اور اُس نے ان کی حفاظت کی", "bn": "এবং সে তাদের রক্ষা করল", "fa": "و آنان را حفاظت کرد"}}, {"arabic": "يُوقَ", "count": 2, "first": "59:9", "audio": "audio/1ea5ff7d7e6aa2979430.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "jussive"}], "gloss": {"en": "he/it is protected", "bs": "biva zaštićen", "tr": "korunur", "fr": "il est protégé", "id": "dia dilindungi", "ur": "اُس کی حفاظت کی جاتی ہے", "bn": "তাকে রক্ষা করা হয়", "fa": "حفاظت می‌شود"}}, {"arabic": "فَقِنَا", "count": 1, "first": "3:191", "audio": "audio/e70f8943a217c3c1e976.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": ["nahnu"]}], "gloss": {"en": "so protect us!", "bs": "pa nas zaštiti!", "tr": "böylece bizi koru!", "fr": "alors protège-nous !", "id": "maka lindungilah kami!", "ur": "پس ہماری حفاظت کر!", "bn": "অতএব আমাদের রক্ষা কর!", "fa": "پس ما را حفاظت کن!"}}, {"arabic": "تَقِيكُمُ", "count": 