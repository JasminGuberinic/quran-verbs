ive"}], "gloss": {"en": "he/it is equal", "bs": "jednak je", "tr": "eşittir", "fr": "il est égal", "id": "dia sama", "ur": "وہ برابر ہے", "bn": "সে সমান", "fa": "برابر است"}}], "ayatFile": "ayat/0115.json", "ayatTranslations": {"en": "ayat/0115.en.json", "tr": "ayat/0115.tr.json", "ur": "ayat/0115.ur.json", "id": "ayat/0115.id.json"}, "sentences": [{"arabic": "اسْتَوَى التَّمْرُ فِي الصَّيْفِ", "spoken": "audio/6341d5418248228a46ff.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Datule su sazrele ljeti.", "en": "The dates ripened in summer.", "bn": "গ্রীষ্মকালে খেজুর পেকে গেল।", "fa": "خرما در تابستان رسید.", "fr": "Les dattes ont mûri en été.", "id": "Kurma matang di musim panas.", "tr": "Hurmalar yazın olgunlaştı.", "ur": "کھجوریں گرمیوں میں پک گئیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "اسْتَوَى", "target": true, "translation": {"bs": "sazrele su", "en": "became ripe", "bn": "পেকে গেল", "fa": "رسید", "fr": "ont mûri", "id": "matang", "tr": "olgunlaştı", "ur": "وہ پک گئی"}}, {"arabic": "التَّمْرُ", "target": false, "translation": {"bs": "datule", "en": "the dates", "bn": "খেজুর", "fa": "خرما", "fr": "les dattes", "id": "kurma", "tr": "hurmalar", "ur": "کھجوریں"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "u", "en": "in", "bn": "মধ্যে", "fa": "در", "fr": "dans", "id": "di", "tr": "içinde", "ur": "میں"}}, {"arabic": "الصَّيْفِ", "target": false, "translation": {"bs": "ljeto", "en": "summer", "bn": "গ্রীষ্মকাল", "fa": "تابستان", "fr": "l'été", "id": "musim panas", "tr": "yaz", "ur": "گرمیاں"}}]}, {"arabic": "يَسْتَوِي الصَّفُّ قَبْلَ الصَّلَاةِ", "spoken": "audio/a47ed0621e5277ac20bc.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Saf se izravna prije namaza.", "en": "The row becomes straight before prayer.", "bn": "সালাতের আগে কাতার সোজা করা হয়।", "fa": "صف پیش از نماز راست می‌شود.", "fr": "Le rang s'aligne avant la prière.", "id": "Barisan menjadi lurus sebelum salat.", "tr": "Saf, namazdan önc