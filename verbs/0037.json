{"rank": 37, "root": "سمع", "form": 1, "lemma": "سَمِعَ", "count": 78, "ayahCount": 70, "share": 0.4, "meaning": {"bs": "čuti", "en": "to hear", "tr": "işitmek", "fr": "entendre", "id": "mendengar", "ur": "سننا", "bn": "শোনা", "fa": "شنیدن"}, "lemmaSpoken": "audio/52a1393ae84cf04674a3.m4a", "animation": "<svg class=\"va va-samia_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes sm{from{opacity:0}}.va-samia_1 .ra{transform:rotate(-150deg)}.va-samia_1 .a0{animation:sm .4s ease-out 2 both}.va-samia_1 .a1{animation:sm .4s ease-out .3s 2 both}.va-samia_1 .a2{animation:sm .4s ease-out .6s 2 both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-samia_1.off,.va-samia_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-samia_1,.va-samia_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><circle class=\"q\" cx=\"106\" cy=\"52\" r=\"4\"/><path class=\"p a2\" d=\"M60 18q-5 5 0 10\"/><path class=\"p a1\" d=\"M70 16q-7 7 0 14\"/><path class=\"p a0\" d=\"M80 14q-9 9 0 18\"/><g transform=\"translate(46 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "سَمِعَ", "plain": "سَمِعَ", "quran": true, "notUsed": false, "spoken": "audio/52a1393ae84cf04674a3.m4a", "recited": "audio/4ee014726ebbae7fcffd.m4a", "recitedText": "سَمِعَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَسْمَعُ", "plain": "يَسْمَعُ", "quran": true, "notU