ull}, {"tense": "imperative", "pronoun": "anti", "arabic": "قَطِّعِي", "plain": "قَطِّعِي", "quran": false, "notUsed": false, "spoken": "audio/b3a33019f3020d77df51.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "قَطِّعَا", "plain": "قَطِّعَا", "quran": false, "notUsed": false, "spoken": "audio/be256519d4e67d5ab723.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "قَطِّعُوا", "plain": "قَطِّعُوا", "quran": false, "notUsed": false, "spoken": "audio/59afeb837617bbb8e5f9.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "قَطِّعْنَ", "plain": "قَطِّعْنَ", "quran": false, "notUsed": false, "spoken": "audio/fd36bd0c0071fc27d966.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "7:124", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1078.mp3", "translation": {"en": {"text": "Surely I shall have your hands and feet cut off upon alternate sides. Then I shall crucify you every one.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ellerinizi ve ayaklarınızı çaprazlama kestireceğim, sonra da bilin ki, sizi astıracağım.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "قسم ہے کہ میں تمہارے ایک طرف کہ ہاتھ اور دوسری طرف کے پاؤں کاٹوں گا پھر تم سب کو سُو لی دوں گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "demi, sesungguhnya aku akan memotong tangan dan kakimu dengan bersilang secara bertimbal balik, kemudian sungguh-sungguh aku akan menyalib kamu semuanya\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَأُقَطِّعَنَّ", "hit": true, "audio": "audio/0524fe4439dab6a43b56.m4a", "gloss": {"bs": "zaista ću odsjeći", "en": "I will surely cut off", "tr": "mutlaka keseceğim", "fr": "je couperai certes", "id": "aku pasti akan memotong", "ur": "میں ضرور کاٹ ڈالوں گا", "bn": "আমি অবশ্যই কেটে ফেলব", "fa": "قطعاً دست و پایشان را خواهم برید"}}, {"text": "أَيْدِيَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَرْجُلَكُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْ", "hit": false, "audio": null, "gloss": null}, {"text": "خِلَٰفٍ", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "لَأُصَلِّبَنَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْمَعِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "47:22", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4567.mp3", "translation": {"en": {"text": "Would ye then, if ye were given the command, work corruption in the land and sever your ties of kinship?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Demek siz iş başına gelecek olursanız yeryüzünde bozgunculuk çıkaracaksınız ve akrabalık bağlarınızı koparacaksınız öyle mi?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو کیا تمہارے یہ لچھن نظر آتے ہیں کہ اگر تمہیں حکومت ملے تو زمین میں فساد پھیلاؤ اور اپنے رشتے کاٹ دو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka apakah kiranya jika kamu berkuasa kamu akan membuat kerusakan di muka bumi dan memutuskan hubungan kekeluargaan?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَهَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَسَيْتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "تَوَلَّيْتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "تُفْسِدُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتُقَطِّعُوٓا۟", "hit": true, "audio": "audio/4551cfea500f8969f4c6.m4a", "gloss": {"en": "and you (all) sever", "bs": "i kidate", "tr": "ve koparırsınız", "fr": "et vous rompez", "id": "dan kalian memotong", "ur": "اور تم کاٹتے ہو", "bn": "এবং তোমরা ছিন্ন কর", "fa": "و بگسلید"}}, {"text": "أَرْحَامَكُمْ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "لَأُقَطِّعَنَّ", "count": 2, "first": "7:124", "audio": "audio/0524fe4439dab6a43b56.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "zaista ću odsjeći", "en": "I will surely cut off", "tr": "mutlaka keseceğim", "fr": "je couperai certes", "id": "aku pasti akan memotong", "ur": "میں ضرور کاٹ ڈالوں گا", "bn": "আমি অবশ্যই কেটে ফেলব", "fa": "قطعاً دست و پایشان را خواهم برید"}}, {"arabic": "قُطِّعَتْ", "count": 2, "first": "13:31", "audio": "audio/26a664acaf8d4c855817.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": true, "objects": []}], "gloss": {"en": "she/it was cut into pieces", "bs": "isječena je", "tr": "parçalandı", "fr": "elle a été découpée en morceaux", "id": "dia telah dipotong-potong", "ur": "وہ ٹکڑے ٹکڑے کی گئی", "bn": "তা টুকরো টুকরো করা হলো", "fa": "قطعه‌قطعه شد"}}, {"arabic": "تُقَطَّعَ", "count": 1, "first": "5:33", "audio": "audio/e99863778b7ee1cbe24e.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": true, "objects": [], "mood": "subjunctive"}]}, {"arabic": "وَقَطَّعْنَٰهُمُ", "count": 1, "first": "7:160", "audio": "audio/769d7a81f438e1b02b9b.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["hum"]}], "gloss": {"en": "and we divided them", "bs": "i razdijelili smo ih", "tr": "ve onları paylaştırdık", "fr": "et nous les avons dispersés", "id": "dan kami telah membagi-bagi mereka", "ur": "اور ہم نے انہیں تقسیم کیا", "bn": "এবং আমরা তাদের বিভক্ত করেছি", "fa": "و آنان را تقسیم کردیم"}}, {"arabic": "وَقَطَّعْنَٰهُمْ", "count": 1, "first": "7:168", "audio": "audio/c0b6126462a07a235185.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["hum"]}], "gloss": {"en": "and we split them up", "bs": "i raspršili smo ih", "tr": "ve onları dağıttık", "fr": "et nous les avons dispersés", "id": "dan kami telah menyebarkan mereka", "ur": "اور ہم نے انہیں بانٹ دیا", "bn": "এবং আমরা তাদের ছড়িয়ে দিয়েছি", "fa": "و آنان را پراکنده کردیم"}}, {"arabic": "وَقَطَّعْنَ", "count": 1, "first": "12:31", "audio": "audio/dd4e2c0efa28b929a393.m4a", "grammar": [{"tense": "past", "pronoun": "hunna", "passive": false, "objects": []}], "gloss": {"en": "and they cut", "bs": "i porezale su", "tr": "ve kestiler", "fr": "et elles ont coupé", "id": "dan mereka telah memotong", "ur": "اور انہوں نے کاٹا", "bn": "এবং তারা কেটেছে", "fa": "و بریدند"}}, {"arabic": "قَطَّعْنَ", "count": 1, "first": "12:50", "audio": "audio/dd36ee6a6a116a283381.m4a", "grammar": [{"tense": "past", "pronoun": "hunna", "passive": false, "objects": []}], "gloss": {"en": "they cut", "bs": "porezale su", "tr": "kestiler", "fr": "elles ont coupé", "id": "mereka telah memotong", "ur": "وہ کاٹتے ہیں", "bn": "তারা কেটেছে", "fa": "بریدند"}}, {"arabic": "فَلَأُقَطِّعَنَّ", "count": 1, "first": "20:71", "audio": "audio/1cf9f8fe18a921327aa1.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "so surely I will cut off", "bs": "pa zaista ću odsjeći", "tr": "böylece kesinlikle keseceğim", "fr": "alors je couperai assurément", "id": "maka sungguh aku akan memotong", "ur": "پس یقیناً میں کاٹوں گا", "bn": "অতএব নিশ্চয়ই আমি কেটে ফেলব", "fa": "پس قطعاً خواهم برید"}}, {"arabic": "فَقَطَّعَ", "count": 1, "first": "47:15", "audio": "audio/d8441561e045bbaf831f.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "so he/it cut into pieces", "bs": "pa