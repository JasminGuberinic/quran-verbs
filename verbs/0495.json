alse, "audio": null, "gloss": null}, {"text": "ٱلْأَيْمَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَقَرَّبْنَٰهُ", "hit": true, "audio": "audio/3ed51e1b8d9cb26a6fc9.m4a", "gloss": {"en": "and we brought him near", "bs": "i približili smo ga", "tr": "ve onu yaklaştırdık", "fr": "et nous l'avons rapproché", "id": "dan kami telah mendekatkannya", "ur": "اور ہم نے اسے قریب کیا", "bn": "এবং আমরা তাকে নিকটবর্তী করেছি", "fa": "و او را نزدیک کردیم"}}, {"text": "نَجِيًّا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "51:27", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4702.mp3", "translation": {"en": {"text": "And he set it before them, saying: Will ye not eat?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onu önlerine sürerek: \"Yemez misiniz?\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر اسے ان کے پاس رکھا کہا کیا تم کھاتے نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Lalu dihidangkannya kepada mereka. Ibrahim lalu berkata: \"Silahkan anda makan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَقَرَّبَهُۥٓ", "hit": true, "audio": "audio/f914c9489513453b9325.m4a", "gloss": {"bs": "pa ga je primakao", "en": "and he brought it near", "tr": "ve onu yaklaştırdı", "fr": "et il l'approcha d'eux", "id": "lalu dia mendekatkannya", "ur": "پھر اس نے اسے قریب کیا", "bn": "অতঃপর সে তা কাছে আনল", "fa": "پس آن را نزدیک کرد"}}, {"text": "إِلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَأْكُلُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "قَرَّبَا", "count": 1, "first": "5:27", "audio": "audio/2afe91d01b26491a65fc.m4a", "grammar": [{"tense": "past", "pronoun": "huma", 