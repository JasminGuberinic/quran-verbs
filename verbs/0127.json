{"rank": 127, "root": "لبث", "form": 1, "lemma": "لَبِثَ", "count": 29, "ayahCount": 25, "share": 0.15, "meaning": {"bs": "ostati, boraviti", "en": "to stay, to remain", "tr": "kalmak, durmak", "fr": "demeurer, rester", "id": "tinggal, menetap", "ur": "ٹھہرنا، رہنا", "bn": "অবস্থান করা, থাকা", "fa": "ماندن، باقی ماندن"}, "lemmaSpoken": "audio/98e4cea69e8b8746779b.m4a", "animation": "<svg class=\"va va-labitha_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes lb1{from{transform:translateX(-66px)}}.va-labitha_1 .ll{transform:rotate(-88deg)}.va-labitha_1 .rl{transform:rotate(-84deg)}.va-labitha_1 .la{transform:rotate(-30deg)}.va-labitha_1 .ra{transform:rotate(-20deg)}.va-labitha_1 .sn{animation:lb1 3s linear both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-labitha_1.off,.va-labitha_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-labitha_1,.va-labitha_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><path class=\"p\" d=\"M46 56h26\"/><circle class=\"q sn\" cx=\"100\" cy=\"10\" r=\"4.5\"/><g transform=\"translate(58 56)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "لَبِثَ", "plain": "لَبِثَ", "quran": true, "notUsed": false, "spoken": "audio/98e4cea69e8b8746779b.m4a", "recited": "audio/009bbf0b7ede20cd1876.m4a", "recitedText": "لَبِثَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَلْبَثُ", "plai