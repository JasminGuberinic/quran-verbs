abava je trajala dva sata.", "en": "The party lasted two hours.", "bn": "অনুষ্ঠানটি দুই ঘণ্টা চলল।", "fa": "مهمانی دو ساعت طول کشید.", "fr": "La fête a duré deux heures.", "id": "Pesta itu berlangsung dua jam.", "tr": "Parti iki saat sürdü.", "ur": "تقریب دو گھنٹے جاری رہی۔"}, "independentlyReviewed": true, "words": [{"arabic": "دَامَتِ", "target": true, "translation": {"bs": "trajala je", "en": "lasted", "bn": "স্থায়ী হল", "fa": "ادامه یافت", "fr": "a duré", "id": "berlangsung", "tr": "sürdü", "ur": "جاری رہی"}}, {"arabic": "الْحَفْلَةُ", "target": false, "translation": {"bs": "zabava", "en": "the party", "bn": "অনুষ্ঠান", "fa": "مهمانی", "fr": "la fête", "id": "pesta itu", "tr": "parti", "ur": "تقریب"}}, {"arabic": "سَاعَتَيْنِ", "target": false, "translation": {"bs": "dva sata", "en": "two hours", "bn": "দুই ঘণ্টা", "fa": "دو ساعت", "fr": "deux heures", "id": "dua jam", "tr": "iki saat", "ur": "دو گھنٹے"}}]}, {"arabic": "دُمْتُ عَلَى الرِّيَاضَةِ", "spoken": "audio/1ccef0c6e08ba7e9ece9.m4a", "tense": "past", "pronoun": "ana", "translation": {"bs": "Ustrajao sam u sportu.", "en": "I persevered with sport.", "bn": "আমি খেলাধুলায় অবিচল থেকেছি।", "fa": "من بر ورزش پایدار ماندم.", "fr": "J'ai persévéré dans le sport.", "id": "Aku tekun berolahraga.", "tr": "Sporda sebat ettim.", "ur": "میں کھیل پر ڈٹا رہا۔"}, "independentlyReviewed": true, "words": [{"arabic": "دُمْتُ", "target": true, "translation": {"bs": "ustrajao sam", "en": "persevered", "bn": "আমি অবিচল থাকলাম", "fa": "ثابت‌قدم ماندم", "fr": "j'ai persévéré", "id": "aku bertahan", "tr": "dayandım", "ur": "میں ڈٹا رہا"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "u", "en": "with", "bn": "সঙ্গে", "fa": "با", "fr": "avec", "id": "dengan", "tr": "ile", "ur": "کے ساتھ"}}, {"arabic": "الرِّيَاضَةِ", "target": false, "translation": {"bs": "sportu", "en": "sport", "bn": "খেলাধুলা", "fa": "ورزش", "fr": "du sport", "id": "olahraga", "tr": "spor", "ur": "کھیل"}}]}, {"arabic": "دُمْتَ بِخَيْرٍ", "spoken": "audio/cff6e597f175642a94b6.m4a", "tense": "past", "pronoun": "anta", "translation": {"bs": "Ostani dobro.", "en": "May you continue in good health.", "bn": "ভালো থাকো।", "fa": "تو همیشه در خوبی بمان.", "fr": "Puisses-tu rester en bonne santé.", "id": "Semoga engkau tetap dalam keadaan baik.", "tr": "Sağlıkla devam et.", "ur": "تم خیریت سے رہو۔"}, "independentlyReviewed": true, "words": [{"arabic": "دُمْتَ", "target": true, "translation": {"bs": "ostani", "en": "continue", "bn": "তুমি থাক", "fa": "بمان", "fr": "reste", "id": "tetaplah", "tr": "devam et", "ur": "تم رہو"}}, {"arabic": "بِخَيْرٍ", "target": false, "translation": {"bs": "dobro", "en": "in good (health)", "bn": "ভালো", "fa": "خوب", "fr": "en bonne santé", "id": "dalam keadaan baik", "tr": "iyilikte, sağlıkta", "ur": "خیریت سے"}}]}, {"arabic": "دُمْتُمْ بِخَيْرٍ", "spoken": "audio/7a54eed798eb147e04ba.m4a", "tense": "past", "pronoun": "antum", "translation": {"bs": "Ostanite (svi) dobro.", "en": "May you (all) continue in good health.", "bn": "তোমরা ভালো থাকো।", "fa": "شما همیشه در خوبی بمانید.", "fr": "Puissiez-vous tous rester en bonne santé.", "id": "Semoga kalian tetap dalam keadaan baik.", "tr": "Sağlıkla devam edin, hepiniz.", "ur": "تم سب خیریت سے رہو۔"}, "independentlyReviewed": true, "words": [{"arabic": "دُمْتُمْ", "target": true, "translation": {"bs": "ostanite", "en": "you (all) continue", "bn": "তোমরা থাক", "fa": "بمانید", "fr": "restez", "id": "tetaplah (kalian)", "tr": "devam edin", "ur": "تم سب رہو"}}, {"arabic": "بِخَيْرٍ", "target": false, "translation": {"bs": "dobro", "en": "in good (health)", "bn": "ভালো", "fa": "خوب", "fr": "en bonne santé", "id": "dalam keadaan baik", "tr": "iyilikte, sağlıkta", "ur": "خیریت سے"}}]}]}