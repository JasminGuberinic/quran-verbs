": null, "recitedText": null}], "ayat": [{"ref": "43:50", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4375.mp3", "translation": {"en": {"text": "But when We eased them of the torment, behold! they broke their word.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Fakat azabı kendilerinden kaldırdığımız zaman hemen sözlerinden dönüverdiler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر جب ہم نے ان سے وہ مصیبت ٹال دی جبھی وہ عہد توڑ گئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka tatkala Kami hilangkan azab itu dari mereka, dengan serta merta mereka memungkiri (janjinya).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "كَشَفْنَا", "hit": true, "audio": "audio/92bc74c7cbf7d132adeb.m4a", "gloss": {"bs": "otklonili smo", "en": "We removed", "tr": "giderdik", "fr": "Nous avons levé", "id": "Kami menghilangkan", "ur": "ہم نے دور کر دیا", "bn": "আমরা দূর করেছি", "fa": "برطرف کردیم"}}, {"text": "عَنْهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَذَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "هُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَنكُثُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "6:41", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/830.mp3", "translation": {"en": {"text": "Nay, but unto Him ye call, and He removeth that because of which ye call unto Him, if He will, and ye forget whatever partners ye ascribed unto Him.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hayır, yalnız o Allah'a yalvarırsınız. O da dilerse kaldırılmasını istediğiniz belayı kaldırır ve o zaman ortak koştuğunuz şeyleri unutursunuz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بلکہ اسی کو پکارو گے تو وہ اگر چاہے جس پر اسے پکارتے ہو اسے اٹھالے اور شریکوں کو بھول جاؤ گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Tidak), tetapi hanya Dialah yang kamu seru, maka Dia menghilangkan bahaya yang karenanya kamu berdoa kepada-Nya, jika Dia menghendaki, dan kamu tinggalkan sembahan-sembahan yang kamu sekutukan (dengan Allah).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "بَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِيَّاهُ", "hit": false, "audio": null, "gloss": null}, {"text": "تَدْعُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَيَكْشِفُ", "hit": true, "audio": "audio/f6a3cf36354b5a9a2ede.m4a", "gloss": {"bs": "pa On otkloni", "en": "and He removes", "tr": "ve O giderir", "fr": "et Il lève", "id": "dan Dia menghilangkan", "ur": "پھر وہ دور کر دیتا ہے", "bn": "এবং তিনি দূর করেন", "fa": "و برطرف می‌کند"}}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَدْعُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "شَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَنسَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُشْرِكُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "16:54", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1955.mp3", "translation": {"en": {"text": "And afterward, when He hath rid you of the misfortune, behold! a set of you attribute partners to their Lord,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra Allah bu sıkıntıyı sizden kaldırdığı zaman, bir de bakarsınız ki, içinizden bir topluluk, hemen Rablerine ortak koşarlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر جب وہ تم سے برائی ٹال دیتا ہے تو تم میں ایک گروہ اپنے رب کا شریک ٹھہرانے لگتا ہے، ف۱۱۰)", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian apabila Dia telah menghilangkan kemudharatan itu dari pada kamu, tiba-tiba sebahagian dari pada kamu mempersekutukan Tuhannya dengan (yang lain),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَشَفَ", "hit": true, "audio": "audio/dbad03cc269bbbefdb42.m4a", "gloss": {"en": "he/it removed", "bs": "otklonio je", "tr": "uzaklaştırdı", "fr": "il a écarté", "id": "dia telah menyingkirkan", "ur": "اُس نے دور کیا", "bn": "সে সরিয়ে দিল", "fa": "دور کرد"}}, {"text": "ٱلضُّرَّ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَرِيقٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنكُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِرَبِّهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُشْرِكُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "44:12", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4426.mp3", "translation": {"en": {"text": "(Then they will say): Our Lord relieve us of the torment. Lo! we are believers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O gün insanlar: \"Ey Rabbimiz! Bizden azabı kaldır. Artık biz inanıyoruz\" derler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس دن کہیں گے، اے ہمارے رب! ہم پر سے عذاب کھول دے ہم ایمان لاتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Mereka berdoa): \"Ya Tuhan kami, lenyapkanlah dari kami azab itu. Sesungguhnya kami akan beriman\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رَّبَّنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱكْشِفْ", "hit": true, "audio": "audio/e06e5b7ae8d0cc7d77ce.m4a", "gloss": {"bs": "otkloni", "en": "remove", "tr": "gider", "fr": "lève", "id": "hilangkanlah", "ur": "دور کر دے", "bn": "দূর করো", "fa": "برطرف کن"}}, {"text": "عَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَذَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مُؤْمِنُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "كَشَفْنَا", "count": 4, "first": "7:135", "audio": "audio/92bc74c7cbf7d132adeb.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"bs": "otklonili smo", "en": "We removed", "tr": "giderdik", "fr": "Nous avons levé", "id": "Kami menghilangkan", "ur": "ہم نے دور کر دیا", "bn": "আমরা দূর করেছি", "fa": "برطرف کردیم"}}, {"arabic": "فَكَشَفْنَا", "count": 2, "first": "21:84", "audio": "audio/2b333d9842ce656692c4.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "so we removed", "bs": "pa smo otklonili", "tr": "böylece uzaklaştırdık", "fr": "alors nous avons écarté", "id": "maka kami telah menyingkirkan", "ur": "پس ہم نے دور کیا", "bn": "অতএব আমরা সরিয়ে দিলাম", "fa": "پس دور کردیم"}}, {"arabic": "فَيَكْشِفُ", "count": 1, "first": "6:41", "audio": "audio/f6a3cf36354b5a9a2ede.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "pa On otkloni", "en": "and He removes", "tr": "ve O giderir", "fr": "et Il lève", "id": "dan Dia menghilangkan", "ur": "پھر وہ دور کر دیتا ہے", "bn": "এবং 