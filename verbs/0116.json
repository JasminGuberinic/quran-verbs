نِ", "plain": "تَنْسَيَانِ", "quran": false, "notUsed": false, "spoken": "audio/9c01db02563073754419.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَنسَوْنَ", "plain": "تَنْسَوْنَ", "quran": true, "notUsed": false, "spoken": "audio/00375b4c86929e05cd03.m4a", "recited": "audio/dc0f00f67c626c7bbb55.m4a", "recitedText": "وَتَنسَوْنَ"}, {"tense": "present", "pronoun": "antunna", "arabic": "تَنْسَيْنَ", "plain": "تَنْسَيْنَ", "quran": false, "notUsed": false, "spoken": "audio/6856c8ecb574618eaec1.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَنسَى", "plain": "يَنْسَى", "quran": true, "notUsed": false, "spoken": "audio/c0a587a54953c2e92e94.m4a", "recited": "audio/b99eb225d97f326d2e53.m4a", "recitedText": "يَنسَى"}, {"tense": "present", "pronoun": "hiya", "arabic": "تَنْسَى", "plain": "تَنْسَى", "quran": false, "notUsed": false, "spoken": "audio/9027cd03474f982e176e.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يَنْسَيَانِ", "plain": "يَنْسَيَانِ", "quran": false, "notUsed": false, "spoken": "audio/c91b701f5e35ba94b6ca.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَنْسَوْنَ", "plain": "يَنْسَوْنَ", "quran": false, "notUsed": false, "spoken": "audio/e711372526341a01ad10.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hunna", "arabic": "يَنْسَيْنَ", "plain": "يَنْسَيْنَ", "quran": false, "notUsed": false, "spoken": "audio/5197d05a7ba333b3884b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِنْسَ", "plain": "اِنْسَ", "quran": false, "notUsed": false, "spoken": "audio/fdd05752060d15174328.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِنْسَيْ", "plain": "اِنْسَيْ", "quran": false, "notUsed": false, "spoken": "audio/04345e1ebec2b4626283.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِنْسَيَا", "plain": "اِنْسَيَا", "quran": false, "notUsed": false, "spoken": "audio/a6e775cea91d02be706b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِنْسَوْا", "plain": "اِنْسَوْا", "quran": false, "notUsed": false, "spoken": "audio/066f3afedd269df26fb8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِنْسَيْنَ", "plain": "اِنْسَيْنَ", "quran": false, "notUsed": false, "spoken": "audio/6ba4d2f9e8a5a8a64a81.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "59:19", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5145.mp3", "translation": {"en": {"text": "And be not ye as those who forgot Allah, therefor He caused them to forget their souls. Such are the evil-doers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah'ı unutup da Allah'ın da kendilerini unutturduğu kimseler gibi olmayın onlar, yoldan çıkan kimselerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان جیسے نہ ہو جو اللہ کو بھول بیٹھے تو اللہ نے انہیں بلا میں ڈالا کہ اپنی جانیں یاد نہ رہیں وہی فاسق ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan janganlah kamu seperti orang-orang yang lupa kepada Allah, lalu Allah menjadikan mereka lupa kepada mereka sendiri. Mereka itulah orang-orang yang fasik.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَكُونُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "كَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَسُوا۟", "hit": true, "audio": "audio/e1983fcb4e27ac48828e.m4a", "gloss": {"en": "they forgot", "bs": "zaboravili su", "tr": "unuttular", "fr": "ils ont oublié", "id": "mereka telah lupa", "ur": "انہوں نے بھلا دیا", "bn": "তারা ভুলে গেল", "fa": "فراموش کردند"}}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَنسَىٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنفُسَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْفَٰسِقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:115", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2463.mp3", "translation": {"en": {"text": "And verily We made a covenant of old with Adam, but he forgot, and We found no constancy in him.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Doğrusu bundan önce Âdem'e (bu ağaçtan yeme diye) emrettik, fakat unuttu ve biz onda bir azim (bir kararlılık) bulmadık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے آدم کو اس سے پہلے ایک تاکیدی حکم دیا تھا تو وہ بھول گیا اور ہم نے اس کا قصد نہ پایا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya telah Kami perintahkan kepada Adam dahulu, maka ia lupa (akan perintah itu), dan tidak Kami dapati padanya kemauan yang kuat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَهِدْنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَادَمَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "قَبْلُ", "hit": false, "audio": null, "gloss": null}, {"text": "فَنَسِىَ", "hit": true, "audio": "audio/364dcc24c8ab10cafa9d.m4a", "gloss": {"en": "so he/it forgot", "bs": "pa je zaboravio", "tr": "böylece unuttu", "fr": "alors il a oublié", "id": "maka dia telah lupa", "ur": "پس وہ بھولا", "bn": "অতএব সে ভুলে গেল", "fa": "پس فراموش کرد"}}, {"text": "وَلَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَجِدْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "عَزْمًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:44", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/51.mp3", "translation": {"en": {"text": "Enjoin ye righteousness upon mankind while ye yourselves forget (to practise it)? And ye are readers of the Scripture! Have ye then no sense?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İnsanlara iyiliği emreder de kendinizi unutur musunuz? Halbuki kitab (Tevrat)ı okuyorsunuz. Hâlâ aklınızı başınıza almayacak mısınız?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا لوگوں کو بھلائی کا حکم دیتے ہو اور اپنی جانوں کو بھولتے ہو حالانکہ تم کتاب پڑھتے ہو تو کیا تمہیں عقل نہیں -", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mengapa kamu suruh orang lain (mengerjakan) kebaktian, sedang kamu melupakan diri (kewajiban)mu sendiri, padahal kamu membaca Al Kitab (Taurat)? Maka tidaklah kamu berpikir?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَتَأْمُرُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلنَّاسَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْبِرِّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَنسَوْنَ", "hit": true, "audio": "audio/dc0f00f67c626c7bbb55.m4a", "gloss": {"en": "and you (all) forget", "bs": "i zaboravljate", "tr": "ve unutursunuz", "fr": "et vous oubliez", "id": "dan kalian lupa", "ur": "اور تم بھولتے ہو", "bn": "এবং তোমরা ভুলে যাও", "fa": "و فراموش می‌کنید"}}, {"text": "أَنفُسَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَتْلُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكِتَٰبَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَفَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْقِلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:126", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2474.mp3", "translation": {"en": {"text": "He will say: So (it must be). Our revelations came unto thee but thou didst forget them. In like manner thou art forgotten this Day.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah: \"Böyledir, sana âyetlerimiz gelmişti de onları sen unutmuştun, bugün de öylece unutulursun\" der.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "فرمائے گا یونہی تیرے پاس ہماری آیتیں آئیں تھیں تو نے انہیں بھلادیا اور ایسے ہی آج تیری کوئی نہ لے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah berfirman: \"Demikianlah, telah datang kepadamu ayat-ayat Kami, maka kamu melupakannya, dan begitu (pula) pada hari ini kamupun dilupakan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَتَتْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتُنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَنَسِيتَهَا", "hit": true, "audio": "audio/693e00d654529407d4fe.m4a", "gloss": {"bs": "a ti si ih zaboravio", "en": "but you forgot them", "tr": "fakat sen onları unuttun", "fr": "mais tu les as oubliés", "id": "tetapi kamu melupakan mereka", "ur": "مگر تم انہیں بھول گئے", "bn": "কিন্তু তুমি সেগুলো ভুলে গিয়েছিলে", "fa": "اما آنها را فراموش کردی"}}, {"text": "وَكَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْيَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "تُنسَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:73", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2213.mp3", "translation": {"en": {"text": "(Moses) said: Be not wroth with me that I forgot, and be not hard upon me for my fault.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa dedi ki: \"Unuttuğum şeyden dolayı beni suçlama ve bu işimden dolayı bana bir güçlük çıkarma.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہا مجھ سے میری بھول پر گرفت نہ کرو اور مجھ پر میرے کام میں مشکل نہ ڈالو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Musa berkata: \"Janganlah kamu menghukum aku karena kelupaanku dan janganlah kamu membebani aku dengan sesuatu kesulitan dalam urusanku\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُؤَاخِذْنِى", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "نَسِيتُ", "hit": true, "audio": "audio/29860ee21748629310c4.m4a", "gloss": {"en": "I forgot", "bs": "zaboravio sam", "tr": "unuttum", "fr": "j'ai oublié", "id": "aku telah lupa", "ur": "میں بھولا", "bn": "আমি ভুলে গেছি", "fa": "فراموش کردم"}}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُرْهِقْنِى", "hit": false, "audio": null, "gloss": null}, {"text": "مِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْرِى", "hit": false, "audio": null, "gloss": null}, {"text": "عُسْرًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "87:6", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5954.mp3", "translation": {"en": {"text": "We shall make thee read (O Muhammad) so that thou shalt not forget", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bundan böyle sana Kur'ân'ı okutacağız da unutmayacaksın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اب ہم تمہیں پڑھائیں گے کہ تم نہ بھولو گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kami akan membacakan (Al Quran) kepadamu (Muhammad) maka kamu tidak akan lupa,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "سَنُقْرِئُكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَنسَىٰٓ", "hit": true, "audio": "audio/54a3e343f3cf16843b66.m4a", "gloss": {"bs": "(nećeš) zaboraviti", "en": "you will (not) forget", "tr": "(unutmayacaksın)", "fr": "tu (n')oublieras (pas)", "id": "kamu (tidak) akan lupa", "ur": "تم (نہیں) بھولو گے", "bn": "তুমি (কখনও) ভুলবে (না)", "fa": "فراموش نخواهی کرد"}}]}], "forms": [{"arabic": "نَسُوا۟", "count": 7, "first": "6:44", "audio": "audio/f85c62046ffe127d1fbb.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they forgot", "bs": "zaboravili su", "tr": "unuttular", "fr": "ils ont oublié", "id": "mereka telah lupa", "ur": "انہوں نے بھلا دیا", "bn": "তারা ভুলে গেল", "fa": "فراموش کردند"}}, {"arabic": "وَتَنسَوْنَ", "count": 2, "first": "2:44", "audio": "audio/dc0f00f67c626c7bbb55.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and you (all) forget", "bs": "i zaboravljate", "tr": "ve unutursunuz", "fr": "et vous oubliez", "id": "dan kalian lupa", "ur": "اور تم بھولتے ہو", "bn": "এবং তোমরা ভুলে যাও", "fa": "و فراموش می‌کنید"}}, {"arabic": "وَنَسِىَ", "count": 2, "first": "18:57", "audio": "audio/8afe66add8ffc33f78f7.m4a", "grammar"