"plain": "تُنَادُونَ", "quran": false, "notUsed": false, "spoken": "audio/7488b8b6c1182712b204.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antunna", "arabic": "تُنَادِينَ", "plain": "تُنَادِينَ", "quran": false, "notUsed": false, "spoken": "audio/e06123e411c5b9bed6c2.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يُنَادِى", "plain": "يُنَادِي", "quran": true, "notUsed": false, "spoken": "audio/4c92754bf7304d1667e6.m4a", "recited": "audio/d1efbe8f4d66602004ff.m4a", "recitedText": "يُنَادِى"}, {"tense": "present", "pronoun": "hiya", "arabic": "تُنَادِي", "plain": "تُنَادِي", "quran": false, "notUsed": false, "spoken": "audio/c8a89f25ddb3fa9c3609.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يُنَادِيَانِ", "plain": "يُنَادِيَانِ", "quran": false, "notUsed": false, "spoken": "audio/36014e45d303e116525c.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يُنَادُونَ", "plain": "يُنَادُونَ", "quran": false, "notUsed": false, "spoken": "audio/7b18ddfdc0916397febe.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hunna", "arabic": "يُنَادِينَ", "plain": "يُنَادِينَ", "quran": false, "notUsed": false, "spoken": "audio/eb2f19daf4d9737c3edb.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "نَادِ", "plain": "نَادِ", "quran": false, "notUsed": false, "spoken": "audio/485a3c4dd8fb3528dc37.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "نَادِي", "plain": "نَادِي", "quran": false, "notUsed": false, "spoken": "audio/4104b6c6f2d938a9fc36.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "نَادِيَا", "plain": "نَادِيَا", "quran": false, "notUsed": false, "spoken": "audio/43cd9b67b8bda744c3d8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "نَادُوا۟", "plain": "نَادُوا", "quran": true, "notUsed": false, "spoken": "audio/c23de135a2b5d205175b.m4a", "recited": "audio/621f3d80e9b894b42daa.m4a", "recitedText": "نَادُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "نَادِينَ", "plain": "نَادِينَ", "quran": false, "notUsed": false, "spoken": "audio/ac324f10e48061f53622.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "19:3", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2253.mp3", "translation": {"en": {"text": "When he cried unto his Lord a cry in secret,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bir zamanlar o, Rabbine gizlice (içinden) yalvarmıştı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جب اس نے اپنے رب کو آہستہ پکارا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "yaitu tatkala ia berdoa kepada Tuhannya dengan suara yang lembut.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِذْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَادَىٰ", "hit": true, "audio": "audio/06d1e603ab48634882af.m4a", "gloss": {"en": "he/it called", "bs": "pozvao je", "tr": "çağırdı", "fr": "il a appelé", "id": "dia telah memanggil", "ur": "اُس نے پکارا", "bn": "সে আহ্বান করল", "fa": "فراخواند"}}, {"text": "رَبَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "نِدَآءً", "hit": false, "audio": null, "gloss": null}, {"text": "خَفِيًّا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "28:65", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3317.mp3", "translation": {"en": {"text": "And on the Day when He will call unto them and say: What answer gave ye to the messengers?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O gün Allah onları çağırıp \"Peygamberlere ne cevap verdiniz?\" diyecektir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جس دن انہیں ندا کرتے گا تو فرمائے گا تم نے رسولوں کو کیا جواب دیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan (ingatlah) hari (di waktu) Allah menyeru mereka, seraya berkata: \"Apakah jawabanmu kepada para rasul?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُنَادِيهِمْ", "hit": true, "audio": "audio/0c4ca442ecd9558de12b.m4a", "gloss": {"bs": "pozvat će ih", "en": "He will call them", "tr": "onları çağıracak", "fr": "Il les appellera", "id": "Dia akan memanggil mereka", "ur": "وہ انہیں پکارے گا", "bn": "তিনি তাদের ডাকবেন", "fa": "آنان را ندا می‌دهد"}}, {"text": "فَيَقُولُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَاذَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجَبْتُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُرْسَلِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "54:29", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4875.mp3", "translation": {"en": {"text": "But they call their comrade and he took and hamstrung (her).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine arkadaşlarına bağırdılar. O da (bıçağı) çekerek (deveyi) kesti.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو انہوں نے اپنے ساتھی کو پکارا تو اس نے لے کر اس کی کونچیں کاٹ دیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka mereka memanggil kawannya, lalu kawannya menangkap (unta itu) dan membunuhnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَنَادَوْا۟", "hit": true, "audio": "audio/fb7e03655694671887e7.m4a", "gloss": {"en": "so they called", "bs": "pa su pozvali", "tr": "böylece çağırdılar", "fr": "alors ils ont appelé", "id": "maka mereka telah memanggil", "ur": "پس انہوں نے پکارا", "bn": "অতঃপর তারা আহ্বান করল", "fa": "پس فراخواندند"}}, {"text": "صَاحِبَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَعَاطَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "فَعَقَرَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:104", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3892.mp3", "translation": {"en": {"text": "We called unto him: O Abraham!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz de ona şöyle seslendik: \"Ey İbrahim! \"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے اسے ندائی فرمائی کہ اے ابراہیم،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami panggillah dia: \"Hai Ibrahim,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَنَٰدَيْنَٰهُ", "hit": true, "audio": "audio/4b66597fa6a522d30785.m4a", "gloss": {"bs": "i dozvali smo ga", "en": "and We called him", "tr": "ve ona seslendik", "fr": "et Nous l'avons appelé", "id": "dan Kami memanggilnya", "ur": "اور ہم نے اسے پکارا", "bn": "এবং আমরা তাকে ডাকলাম", "fa": "و او را ندا دادیم"}}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰٓإِبْرَٰهِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "49:4", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4616.mp3", "translation": {"en": {"text": "Lo! those who call thee from behind the private apartments, most of them have no sense.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Resülüm!) Sana odaların arkasından bağıranların çokları, aklı ermez kimselerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک وہ جو تمہیں حجروں کے باہر سے پکارتے ہیں ان میں اکثر بے عقل ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya orang-orang yang memanggil kamu dari luar kamar(mu) kebanyakan mereka tidak mengerti.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُنَادُونَكَ", "hit": true, "audio": "audio/5935dddd3de0134dd27b.m4a", "gloss": {"en": "they call you", "bs": "pozivaju te", "tr": "seni çağırırlar", "fr": "ils t'appellent", "id": "mereka memanggil kalian", "ur": "وہ تمہیں پکارتے ہیں", "bn": "তারা তোমাকে আহ্বান করে", "fa": "تو را فرا می‌خوانند"}}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "وَرَآءِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحُجُرَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَكْثَرُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْقِلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "5:58", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/727.mp3", "translation": {"en": {"text": "And when ye call to prayer they take it for a jest and sport. That is because they are a folk who understand not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Namaza çağırdığınız zaman, onu alay ve eğlence konusu yaparlar. Bu onların, akıllarını kullanmayan bir toplum olmalarından dolayıdır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جب تم نماز کے لئے اذان دو تو اسے ہنسی کھیل بناتے ہیں یہ اس لئے کہ وہ نرے بے عقل لوگ ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan apabila kamu menyeru (mereka) untuk (mengerjakan) sembahyang, mereka menjadikannya buah ejekan dan permainan. Yang demikian itu adalah karena mereka benar-benar kaum yang tidak mau mempergunakan akal.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "نَادَيْتُمْ", "hit": true, "audio": "audio/b89dba225e46f0f594d0.m4a", "gloss": {"en": "you (all) called", "bs": "pozvali ste", "tr": "çağırdınız", "fr": "vous avez appelé", "id": "kalian telah memanggil", "ur": "تم نے پکارا", "bn": "তোমরা আহ্বান করেছ", "fa": "فراخواندید"}}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصَّلَوٰةِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱتَّخَذُوهَا", "hit": false, "audio": null, "gloss": null}, {"text": "هُزُوًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَعِبًا", "hit": false, "audio": null, "gloss": null}, {"text": "ذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِأَنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْمٌ", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْقِلُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "نَادَىٰ", "count": 7, "first": "19:3", "audio": "audio/06d1e603ab48634882af.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it called", "bs": "pozvao je", "tr": "çağırdı", "fr": "il a appelé", "id": "dia telah memanggil", "ur": "اُس نے پکارا", "bn": "সে আহ্বান করল", "fa": "فراخواند"}}, {"arabic": "نُودِىَ", "count": 4, "first": "20:11", "audio": "audio/9a6ad106cba8b001c52d.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "he/it was called", "bs": "pozvan je", "tr": "çağrıldı", "fr": "il a été appelé", "id": "dia telah dipanggil", "ur": "اُسے پکارا گیا", "bn": "তাকে আহ্বান করা হয়েছিল", "fa": "فراخوانده شد"}}, {"ar