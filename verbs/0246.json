tegory": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3011.mp3", "translation": {"en": {"text": "And Who feedeth me and watereth me.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Beni yediren, içirendir,\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جو مجھے کھلاتا اور پلاتا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan Tuhanku, Yang Dia memberi makan dan minum kepadaku,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُطْعِمُنِى", "hit": true, "audio": "audio/eff76cfd871d18bcf6b9.m4a", "gloss": {"bs": "hrani me", "en": "He feeds me", "tr": "beni yedirir", "fr": "me nourrit", "id": "Dia memberiku makan", "ur": "وہ مجھے کھلاتا ہے", "bn": "তিনি আমাকে খাওয়ান", "fa": "به من می‌خوراند"}}, {"text": "وَيَسْقِينِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "106:4", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6197.mp3", "translation": {"en": {"text": "Who hath fed them against hunger and hath made them safe from fear.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O, kendilerini açlıktan kurtararak beslemiştir ve her tehlikeye karşı onlara emniyet vermiştir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جس نے انہیں بھوک میں کھانا دیا، اور انہیں ایک بڑے خوف سے امان بخشا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Yang telah memberi makanan kepada mereka untuk menghilangkan lapar dan mengamankan mereka dari ketakutan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَطْعَمَهُم", "hi