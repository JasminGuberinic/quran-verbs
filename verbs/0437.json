2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِنْتَقِمْ", "plain": "اِنْتَقِمْ", "quran": false, "notUsed": false, "spoken": "audio/b6b9de03e987e85b17c2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِنْتَقِمِي", "plain": "اِنْتَقِمِي", "quran": false, "notUsed": false, "spoken": "audio/3fa864d13487770b196f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِنْتَقِمَا", "plain": "اِنْتَقِمَا", "quran": false, "notUsed": false, "spoken": "audio/257357f70ce429d3d062.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِنْتَقِمُوا", "plain": "اِنْتَقِمُوا", "quran": false, "notUsed": false, "spoken": "audio/a183c36500352ec75c06.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِنْتَقِمْنَ", "plain": "اِنْتَقِمْنَ", "quran": false, "notUsed": false, "spoken": "audio/3e9ffc836e0e7297883f.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "15:79", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1881.mp3", "translation": {"en": {"text": "So we took vengeance on them; and lo! they both are on a high-road plain to see.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz Eyke halkından da intikâm aldık. İkisi de (Eyke ve Medyen) açık bir yol üzerindedir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ہم نے ان سے بدلہ لیا اور بیشک دونوں بستیاں کھلے راستہ پر پڑتی ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "maka Kami membinasakan mereka. Dan sesungguhnya kedua kota itu benar-benar terletak di jalan umum yang terang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱنتَقَمْنَا", "hit": true, "audio": "audio/