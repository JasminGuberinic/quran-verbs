{"rank": 89, "root": "حمل", "form": 1, "lemma": "حَمَلَ", "count": 41, "ayahCount": 37, "share": 0.21, "meaning": {"bs": "nositi, ponijeti", "en": "to carry, to bear", "tr": "taşımak, yüklenmek", "fr": "porter, supporter", "id": "membawa, memikul", "ur": "اٹھانا، بوجھ اٹھانا", "bn": "বহন করা, ধারণ করা", "fa": "حمل کردن، بر دوش کشیدن"}, "lemmaSpoken": "audio/2ff2b8436af86f2800aa.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "حَمَلَ", "plain": "حَمَلَ", "quran": true, "notUsed": false, "spoken": "audio/2ff2b8436af86f2800aa.m4a", "recited": "audio/d255325b97628273f30b.m4a", "recitedText": "حَمَلَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَحْمِلُ", "plain": "يَحْمِلُ", "quran": true, "notUsed": false, "spoken": "audio/bf60704219c351b22e9a.m4a", "recited": "audio/5e2e11ecde8a5567cbd1.m4a", "recitedText": "يَحْمِلُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱحْمِلْ", "plain": "اِحْمِلْ", "quran": true, "notUsed": false, "spoken": "audio/bb9e62611232c8a5fb58.m4a", "recited": "audio/68b02e9f96a7bd6074be.m4a", "recitedText": "ٱحْمِلْ"}], "nouns": {"participle": {"lemma": "حامِل", "count": 1, "spoken": "audio/236b27e796b7473f52a6.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "حَمَلْتُ", "plain": "حَمَلْتُ", "quran": false, "notUsed": false, "spoken": "audio/5d83c4ddd7fa5a040e4a.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "حَمَلْنَا", "plain": "حَمَلْنَا", "quran": true, "notUsed": false, "spoken": "audio/6cd140dfef994a669748.m4a", "recited": "audio/e7114c160f10acdd6946.m4a", "recitedText": "حَمَلْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "حَمَلْتَ", "plain": "حَمَلْتَ", "quran": false, "notUsed": false, "spoken": "audio/9f5556f1e26fabc514cd.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "حَمَلْتِ", "plain": "حَمَلْتِ", "quran": false, "notUsed": false, "spoken": "audio/80a8e0ef47404d3b486f.m4a", "recited": 