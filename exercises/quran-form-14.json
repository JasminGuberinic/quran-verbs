[{"id":"samia-2-75-8","words":["verb:samia"],"options":[{"bs":"čuju","en":"they hear"},{"bs":"čujete","en":"you (all) hear"},{"bs":"čuli su","en":"they heard"},{"bs":"čuo ju je","en":"he heard it"}],"ref":"2:75","answerWord":"يَسْمَعُونَ","answerSound":"audio/94ed15484b02dd7081f4.m4a","quranTranslation":{"text":"Have ye any hope that they will be true to you when a party of them used to listen to the word of Allah, then used to change it, after they had understood it, knowingly?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["أَفَتَطْمَعُونَ","أَن","يُؤْمِنُوا۟","لَكُمْ","وَقَدْ","كَانَ","فَرِيقٌ","مِّنْهُمْ","يَسْمَعُونَ","كَلَٰمَ","ٱللَّهِ","ثُمَّ","يُحَرِّفُونَهُۥ","مِنۢ","بَعْدِ","مَا","عَقَلُوهُ","وَهُمْ","يَعْلَمُونَ"],"marked":[8],"facts":{"verb":"سَمِعَ"}},{"id":"samia-21-60-1","words":["verb:samia"],"options":[{"bs":"čuli smo","en":"we heard"},{"bs":"čujemo","en":"we hear"},{"bs":"čuju vas","en":"they hear you (all)"},{"bs":"čuje","en":"he/it hears"}],"ref":"21:60","answerWord":"سَمِعْنَا","answerSound":"audio/0d81cc7d4bc6a4f9b72d.m4a","quranTranslation":{"text":"They said: We heard a youth make mention of them, who is called Abraham.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["قَالُوا۟","سَمِعْنَا","فَتًى","يَذْكُرُهُمْ","يُقَالُ","لَهُۥٓ","إِبْرَٰهِيمُ"],"marked":[1],"facts":{"verb":"سَمِعَ"}},{"id":"samia-67-7-3","words":["verb:samia"],"options":[{"bs":"čuli su","en":"they heard"},{"bs":"čula je","en":"she/it heard"},{"bs":"čuju","en":"they hear"},{"bs":"čuo je","en":"he/it heard"}],"ref":"67:7","answerWord":"سَمِعُوا۟","answerSound":"audio/a1315af1b03e716c17e4.m4a","quranTranslation":{"text":"When they are flung therein they hear its roaring as it boileth up,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["إِذَآ","أُلْقُوا۟","فِيهَا","سَمِعُوا۟","لَهَا","شَهِيقًا","وَهِىَ","تَفُورُ"],"marked":[3],"facts":{"verb":"سَمِعَ"}},{"id":"samia-21-45-5","words":["verb:samia"],"options":[{"bs":"čuje","en":"he/it hears"},{"bs":"i zaista ćete čuti","en":"and surely you (all) will hear"},{"bs":"čuju","en":"they hear"},{"bs":"čuli ste","en":"you (all) heard"}],"ref":"21:45","answerWord":"يَسْمَعُ","answerSound":"audio/d6a148fb63416738455c.m4a","quranTranslation":{"text":"Say (O Muhammad, unto mankind): I warn you only by the Inspiration. But the deaf hear not the call when they are warned.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["قُلْ","إِنَّمَآ","أُنذِرُكُم","بِٱلْوَحْىِ","وَلَا","يَسْمَعُ","ٱلصُّمُّ","ٱلدُّعَآءَ","إِذَا","مَا","يُنذَرُونَ"],"marked":[5],"facts":{"verb":"سَمِعَ"}},{"id":"samia-2-93-10","words":["verb:samia"],"options":[{"bs":"i čujte!","en":"and (you all) hear!"},{"bs":"čujete","en":"you (all) hear"},{"bs":"čuju","en":"they hear"},{"bs":"čuje ih","en":"he/it hears them"}],"ref":"2:93","answerWord":"وَٱسْمَعُوا۟","answerSound":"audio/7ff2ed9e8ee444b514bb.m4a","quranTranslation":{"text":"And when We made with you a covenant and caused the Mount to tower above you, (saying): Hold fast by that which We have given you, and hear (Our Word), they said: We hear and we rebel. And (worship of) the calf was made to sink into their hearts because of their rejection (of the covenant). Say (unto them): Evil is that which your belief enjoineth on you, if ye are believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["وَإِذْ","أَخَذْنَا","مِيثَٰقَكُمْ","وَرَفَعْنَا","فَوْقَكُمُ","ٱلطُّورَ","خُذُوا۟","مَآ","ءَاتَيْنَٰكُم","بِقُوَّةٍ","وَٱسْمَعُوا۟","قَالُوا۟","سَمِعْنَا","وَعَصَيْنَا","وَأُشْرِبُوا۟","فِى","قُلُوبِهِمُ","ٱلْعِجْلَ","بِكُفْرِهِمْ","قُلْ","بِئْسَمَا","يَأْمُرُكُم","بِهِۦٓ","إِيمَٰنُكُمْ","إِن","كُنتُم","مُّؤْمِنِينَ"],"marked":[10],"facts":{"verb":"سَمِعَ"}},{"id":"samia-3-181-1","words":["verb:samia"],"options":[{"bs":"čuo je","en":"he/it heard"},{"bs":"čujemo","en":"we hear"},{"bs":"čuju vas","en":"they hear you (all)"},{"bs":"i čujte!","en":"and (you all) hear!"}],"ref":"3:181","answerWord":"سَمِعَ","answerSound":"audio/4ee014726ebbae7fcffd.m4a","quranTranslation":{"text":"Verily Allah heard the saying of those who said, (when asked for contributions to the war): \"Allah, forsooth, is poor, and we are rich!\" We shall record their saying with their slaying of the prophets wrongfully and We shall say: Taste ye the punishment of burning!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["لَّقَدْ","سَمِعَ","ٱللَّهُ","قَوْلَ","ٱلَّذِينَ","قَالُوٓا۟","إِنَّ","ٱللَّهَ","فَقِيرٌ","وَنَحْنُ","أَغْنِيَآءُ","سَنَكْتُبُ","مَا","قَالُوا۟","وَقَتْلَهُمُ","ٱلْأَنۢبِيَآءَ","بِغَيْرِ","حَقٍّ","وَنَقُولُ","ذُوقُوا۟","عَذَابَ","ٱلْحَرِيقِ"],"marked":[1],"facts":{"verb":"سَمِعَ"}},{"id":"samia-7-198-5","words":["verb:samia"],"options":[{"bs":"čuju","en":"they hear"},{"bs":"čujete","en":"you (all) hear"},{"bs":"(ne) čuješ","en":"you hear (no)"},{"bs":"i čujte!","en":"and (you all) hear!"}],"ref":"7:198","answerWord":"يَسْمَعُوا۟","answerSound":"audio/9881c79929a48891d567.m4a","quranTranslation":{"text":"And if ye (Muslims) call them to the guidance they hear not; and thou (Muhammad) seest them looking toward thee, but they see not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["وَإِن","تَدْعُوهُمْ","إِلَى","ٱلْهُدَىٰ","لَا","يَسْمَعُوا۟","وَتَرَىٰهُمْ","يَنظُرُونَ","إِلَيْكَ","وَهُمْ","لَا","يُبْصِرُونَ"],"marked":[5],"facts":{"verb":"سَمِعَ"}},{"id":"samia-8-20-10","words":["verb:samia"],"options":[{"bs":"čujete","en":"you (all) hear"},{"bs":"čujem","en":"I hear"},{"bs":"čuli smo","en":"we heard"},{"bs":"čuju","en":"they hear"}],"ref":"8:20","answerWord":"تَسْمَعُونَ","answerSound":"audio/b19d818274f3d15d4e7f.m4a","quranTranslation":{"text":"O ye who believe! Obey Allah and His messenger, and turn not away from him when ye hear (him speak).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓا۟","أَطِيعُوا۟","ٱللَّهَ","وَرَسُولَهُۥ","وَلَا","تَوَلَّوْا۟","عَنْهُ","وَأَنتُمْ","تَسْمَعُونَ"],"marked":[10],"facts":{"verb":"سَمِعَ"}},{"id":"samia-24-12-2","words":["verb:samia"],"options":[{"bs":"čuli ste je","en":"you (all) heard it"},{"bs":"čuli su","en":"they heard"},{"bs":"čuo je","en":"he/it heard"},{"bs":"čuje ih","en":"he/it hears them"}],"ref":"24:12","answerWord":"سَمِعْتُمُوهُ","answerSound":"audio/b3d8212fba5baa783b5e.m4a","quranTranslation":{"text":"Why did not the believers, men and women, when ye heard it, think good of their own own folk, and say: It is a manifest untruth?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["لَّوْلَآ","إِذْ","سَمِعْتُمُوهُ","ظَنَّ","ٱلْمُؤْمِنُونَ","وَٱلْمُؤْمِنَٰتُ","بِأَنفُسِهِمْ","خَيْرًا","وَقَالُوا۟","هَٰذَآ","إِفْكٌ","مُّبِينٌ"],"marked":[2],"facts":{"verb":"سَمِعَ"}},{"id":"samia-31-7-8","words":["verb:samia"],"options":[{"bs":"čuje ih","en":"he/it hears them"},{"bs":"čuju","en":"they hear"},{"bs":"(ne) čuješ","en":"you hear (no)"},{"bs":"čuo je","en":"he/it heard"}],"ref":"31:7","answerWord":"يَسْمَعْهَا","answerSound":"audio/06ab21f1a0b50589b5e0.m4a","quranTranslation":{"text":"And when Our revelations are recited unto him he turneth away in pride as if he heard them not, as if there were a deafness in his ears. So give him tidings of a painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["وَإِذَا","تُتْلَىٰ","عَلَيْهِ","ءَايَٰتُنَا","وَلَّىٰ","مُسْتَكْبِرًا","كَأَن","لَّمْ","يَسْمَعْهَا","كَأَنَّ","فِىٓ","أُذُنَيْهِ","وَقْرًا","فَبَشِّرْهُ","بِعَذَابٍ","أَلِيمٍ"],"marked":[8],"facts":{"verb":"سَمِعَ"}},{"id":"samia-43-80-4","words":["verb:samia"],"options":[{"bs":"čujemo","en":"we hear"},{"bs":"čuju vas","en":"they hear you (all)"},{"bs":"čujete","en":"you (all) hear"},{"bs":"čuo ju je","en":"he heard it"}],"ref":"43:80","answerWord":"نَسْمَعُ","answerSound":"audio/29781d62502c83d41bfd.m4a","quranTranslation":{"text":"Or deem they that We cannot hear their secret thoughts and private confidences? Nay, but Our envoys, present with them, do record.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["أَمْ","يَحْسَبُونَ","أَنَّا","لَا","نَسْمَعُ","سِرَّهُمْ","وَنَجْوَىٰهُم","بَلَىٰ","وَرُسُلُنَا","لَدَيْهِمْ","يَكْتُبُونَ"],"marked":[4],"facts":{"verb":"سَمِعَ"}},{"id":"samia-2-181-3","words":["verb:samia"],"options":[{"bs":"čuo ju je","en":"he heard it"},{"bs":"(ne) čuješ","en":"you hear (no)"},{"bs":"čujem","en":"I hear"},{"bs":"čuli ste je","en":"you (all) heard it"}],"ref":"2:181","answerWord":"سَمِعَهُۥ","answerSound":"audio/1117ce700b3711a59336.m4a","quranTranslation":{"text":"And whoso changeth (the will) after he hath heard it - the sin thereof is only upon those who change it. Lo! Allah is Hearer, Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["فَمَنۢ","بَدَّلَهُۥ","بَعْدَمَا","سَمِعَهُۥ","فَإِنَّمَآ","إِثْمُهُۥ","عَلَى","ٱلَّذِينَ","يُبَدِّلُونَهُۥٓ","إِنَّ","ٱللَّهَ","سَمِيعٌ","عَلِيمٌ"],"marked":[3],"facts":{"verb":"سَمِعَ"}},{"id":"samia-3-186-4","words":["verb:samia"],"options":[{"bs":"i zaista ćete čuti","en":"and surely you (all) will hear"},{"bs":"(ne) čuješ","en":"you hear (no)"},{"bs":"čuo ju je","en":"he heard it"},{"bs":"čuje ih","en":"he/it hears them"}],"ref":"3:186","answerWord":"وَلَتَسْمَعُنَّ","answerSound":"audio/6628cd0c320da9b841e5.m4a","quranTranslation":{"text":"Assuredly ye will be tried in your property and in your persons, and ye will hear much wrong from those who were given the Scripture before you, and from the idolaters. But if ye persevere and ward off (evil), then that is of the steadfast heart of things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["لَتُبْلَوُنَّ","فِىٓ","أَمْوَٰلِكُمْ","وَأَنفُسِكُمْ","وَلَتَسْمَعُنَّ","مِنَ","ٱلَّذِينَ","أُوتُوا۟","ٱلْكِتَٰبَ","مِن","قَبْلِكُمْ","وَمِنَ","ٱلَّذِينَ","أَشْرَكُوٓا۟","أَذًى","كَثِيرًا","وَإِن","تَصْبِرُوا۟","وَتَتَّقُوا۟","فَإِنَّ","ذَٰلِكَ","مِنْ","عَزْمِ","ٱلْأُمُورِ"],"marked":[4],"facts":{"verb":"سَمِعَ"}},{"id":"samia-9-6-7","words":["verb:samia"],"options":[{"bs":"čuje","en":"he/it hears"},{"bs":"čuli ste","en":"you (all) heard"},{"bs":"i čujte!","en":"and (you all) hear!"},{"bs":"čuo je","en":"he/it heard"}],"ref":"9:6","answerWord":"يَسْمَعَ","answerSound":"audio/9b478b0f4b860a40a5e5.m4a","quranTranslation":{"text":"And if anyone of the idolaters seeketh thy protection (O Muhammad), then protect him so that he may hear the Word of Allah, and afterward convey him to his place of safety. That is because they are a folk who know not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["وَإِنْ","أَحَدٌ","مِّنَ","ٱلْمُشْرِكِينَ","ٱسْتَجَارَكَ","فَأَجِرْهُ","حَتَّىٰ","يَسْمَعَ","كَلَٰمَ","ٱللَّهِ","ثُمَّ","أَبْلِغْهُ","مَأْمَنَهُۥ","ذَٰلِكَ","بِأَنَّهُمْ","قَوْمٌ","لَّا","يَعْلَمُونَ"],"marked":[7],"facts":{"verb":"سَمِعَ"}},{"id":"samia-20-46-5","words":["verb:samia"],"options":[{"bs":"čujem","en":"I hear"},{"bs":"čujemo","en":"we hear"},{"bs":"i zaista ćete čuti","en":"and surely you (all) will hear"},{"bs":"pa me poslušajte!","en":"so listen to me!"}],"ref":"20:46","answerWord":"أَسْمَعُ","answerSound":"audio/1dd7e1976be21c0cc1b7.m4a","quranTranslation":{"text":"He said: Fear not. Lo! I am with you twain, Hearing and Seeing.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["قَالَ","لَا","تَخَافَآ","إِنَّنِى","مَعَكُمَآ","أَسْمَعُ","وَأَرَىٰ"],"marked":[5],"facts":{"verb":"سَمِعَ"}},{"id":"samia-26-72-2","words":["verb:samia"],"options":[{"bs":"čuju vas","en":"they hear you (all)"},{"bs":"čuli su","en":"they heard"},{"bs":"pa me poslušajte!","en":"so listen to me!"},{"bs":"čuli ste","en":"you (all) heard"}],"ref":"26:72","answerWord":"يَسْمَعُونَكُمْ","answerSound":"audio/9a96aeb9a5df9413c1db.m4a","quranTranslation":{"text":"He said: Do they hear you when ye cry?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["قَالَ","هَلْ","يَسْمَعُونَكُمْ","إِذْ","تَدْعُونَ"],"marked":[2],"facts":{"verb":"سَمِعَ"}},{"id":"samia-32-12-10","words":["verb:samia"],"options":[{"bs":"i čuli smo","en":"and we heard"},{"bs":"čuju vas","en":"they hear you (all)"},{"bs":"čuli su","en":"they heard"},{"bs":"čuju","en":"they hear"}],"ref":"32:12","answerWord":"وَسَمِعْنَا","answerSound":"audio/d7660d7801ec01131548.m4a","quranTranslation":{"text":"Couldst thou but see when the guilty hang their heads before their Lord, (and say): Our Lord! We have now seen and heard, so send us back; we will do right, now we are sure.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["وَلَوْ","تَرَىٰٓ","إِذِ","ٱلْمُجْرِمُونَ","نَاكِسُوا۟","رُءُوسِهِمْ","عِندَ","رَبِّهِمْ","رَبَّنَآ","أَبْصَرْنَا","وَسَمِعْنَا","فَٱرْجِعْنَا","نَعْمَلْ","صَٰلِحًا","إِنَّا","مُوقِنُونَ"],"marked":[10],"facts":{"verb":"سَمِعَ"}},{"id":"samia-36-25-3","words":["verb:samia"],"options":[{"bs":"pa me poslušajte!","en":"so listen to me!"},{"bs":"čujete","en":"you (all) hear"},{"bs":"čula je","en":"she/it heard"},{"bs":"čuo ju je","en":"he heard it"}],"ref":"36:25","answerWord":"فَٱسْمَعُونِ","answerSound":"audio/93c6a68e81c6001193a0.m4a","quranTranslation":{"text":"Lo! I have believed in your Lord, so hear me!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["إِنِّىٓ","ءَامَنتُ","بِرَبِّكُمْ","فَٱسْمَعُونِ"],"marked":[3],"facts":{"verb":"سَمِعَ"}},{"id":"samia-41-26-4","words":["verb:samia"],"options":[{"bs":"čujete","en":"you (all) hear"},{"bs":"čuju","en":"they hear"},{"bs":"čujemo","en":"we hear"},{"bs":"čuje","en":"he/it hears"}],"ref":"41:26","answerWord":"تَسْمَعُوا۟","answerSound":"audio/670373bfee846eb51387.m4a","quranTranslation":{"text":"Those who disbelieve say: Heed not this Qur'an, and drown the hearing of it; haply ye may conquer.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"čuti","en":"to hear"},"passage":["وَقَالَ","ٱلَّذِينَ","كَفَرُوا۟","لَا","تَسْمَعُوا۟","لِهَٰذَا","ٱلْقُرْءَانِ","وَٱلْغَوْا۟","فِيهِ","لَعَلَّكُمْ","تَغْلِبُونَ"],"marked":[4],"facts":{"verb":"سَمِعَ"}},{"id":"nafara-4-71-8","words":["verb:nafara"],"options":[{"bs":"krenite","en":"go forth"},{"bs":"da krenu","en":"so that they may go forth"},{"bs":"krenuo je","en":"he/it went forth"},{"bs":"krećete","en":"you (all) go forth"}],"ref":"4:71","answerWord":"ٱنفِرُوا۟","answerSound":"audio/c03824a6844d25ff6c43.m4a","quranTranslation":{"text":"O ye who believe! Take your precautions, then advance the proven ones, or advance all together.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"krenuti, otići; bježati","en":"to go forth, to flee"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","خُذُوا۟","حِذْرَكُمْ","فَٱنفِرُوا۟","ثُبَاتٍ","أَوِ","ٱنفِرُوا۟","جَمِيعًا"],"marked":[8],"facts":{"verb":"نَفَرَ"}},{"id":"nafara-9-39-1","words":["verb:nafara"],"options":[{"bs":"krećete","en":"you (all) go forth"},{"bs":"krenuo je","en":"he/it went forth"},{"bs":"da krenu","en":"so that they may go forth"},{"bs":"pa krenite","en":"then go forth"}],"ref":"9:39","answerWord":"تَنفِرُوا۟","answerSound":"audio/4ee8ea70e7a684d78637.m4a","quranTranslation":{"text":"If ye go not forth He will afflict you with a painful doom, and will choose instead of you a folk other than you. Ye cannot harm Him at all. Allah is Able to do all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"krenuti, otići; bježati","en":"to go forth, to flee"},"passage":["إِلَّا","تَنفِرُوا۟","يُعَذِّبْكُمْ","عَذَابًا","أَلِيمًا","وَيَسْتَبْدِلْ","قَوْمًا","غَيْرَكُمْ","وَلَا","تَضُرُّوهُ","شَيْـًٔا","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَىْءٍ","قَدِيرٌ"],"marked":[1],"facts":{"verb":"نَفَرَ"}},{"id":"nafara-4-71-5","words":["verb:nafara"],"options":[{"bs":"pa krenite","en":"then go forth"},{"bs":"krećete","en":"you (all) go forth"},{"bs":"krenuo je","en":"he/it went forth"},{"bs":"da krenu","en":"so that they may go forth"}],"ref":"4:71","answerWord":"فَٱنفِرُوا۟","answerSound":"audio/1c84a336d3a9d3e4baa7.m4a","quranTranslation":{"text":"O ye who believe! Take your precautions, then advance the proven ones, or advance all together.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"krenuti, otići; bježati","en":"to go forth, to flee"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","خُذُوا۟","حِذْرَكُمْ","فَٱنفِرُوا۟","ثُبَاتٍ","أَوِ","ٱنفِرُوا۟","جَمِيعًا"],"marked":[5],"facts":{"verb":"نَفَرَ"}},{"id":"nafara-9-122-3","words":["verb:nafara"],"options":[{"bs":"da krenu","en":"so that they may go forth"},{"bs":"krećete","en":"you (all) go forth"},{"bs":"krenuo je","en":"he/it went forth"},{"bs":"krenite","en":"go forth"}],"ref":"9:122","answerWord":"لِيَنفِرُوا۟","answerSound":"audio/4f3c41e3a0b1dfc4fb94.m4a","quranTranslation":{"text":"And the believers should not all go out to fight. Of every troop of them, a party only should go forth, that they (who are left behind) may gain sound knowledge in religion, and that they may warn their folk when they return to them, so that they may beware.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"krenuti, otići; bježati","en":"to go forth, to flee"},"passage":["وَمَا","كَانَ","ٱلْمُؤْمِنُونَ","لِيَنفِرُوا۟","كَآفَّةً","فَلَوْلَا","نَفَرَ","مِن","كُلِّ","فِرْقَةٍ","مِّنْهُمْ","طَآئِفَةٌ","لِّيَتَفَقَّهُوا۟","فِى","ٱلدِّينِ","وَلِيُنذِرُوا۟","قَوْمَهُمْ","إِذَا","رَجَعُوٓا۟","إِلَيْهِمْ","لَعَلَّهُمْ","يَحْذَرُونَ"],"marked":[3],"facts":{"verb":"نَفَرَ"}},{"id":"nafara-9-122-6","words":["verb:nafara"],"options":[{"bs":"krenuo je","en":"he/it went forth"},{"bs":"da krenu","en":"so that they may go forth"},{"bs":"krenite","en":"go forth"},{"bs":"krećete","en":"you (all) go forth"}],"ref":"9:122","answerWord":"نَفَرَ","answerSound":"audio/4d6968a99a42b856a2c5.m4a","quranTranslation":{"text":"And the believers should not all go out to fight. Of every troop of them, a party only should go forth, that they (who are left behind) may gain sound knowledge in religion, and that they may warn their folk when they return to them, so that they may beware.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"krenuti, otići; bježati","en":"to go forth, to flee"},"passage":["وَمَا","كَانَ","ٱلْمُؤْمِنُونَ","لِيَنفِرُوا۟","كَآفَّةً","فَلَوْلَا","نَفَرَ","مِن","كُلِّ","فِرْقَةٍ","مِّنْهُمْ","طَآئِفَةٌ","لِّيَتَفَقَّهُوا۟","فِى","ٱلدِّينِ","وَلِيُنذِرُوا۟","قَوْمَهُمْ","إِذَا","رَجَعُوٓا۟","إِلَيْهِمْ","لَعَلَّهُمْ","يَحْذَرُونَ"],"marked":[6],"facts":{"verb":"نَفَرَ"}}]