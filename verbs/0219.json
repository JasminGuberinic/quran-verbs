isingan", "tr": "gürültüyle", "ur": "شور سے"}}]}, {"arabic": "لَا يُؤْذُونَ الْحَيَوَانَاتِ", "spoken": "audio/ccb2f92a3e64b78eb305.m4a", "tense": "present", "pronoun": "hum", "translation": {"bs": "Ne povređuju životinje.", "en": "They do not harm animals.", "bn": "তারা প্রাণীদের ক্ষতি করে না।", "fa": "به حیوانات آزار نمی‌رسانند.", "fr": "Ils ne font pas de mal aux animaux.", "id": "Mereka tidak menyakiti hewan.", "tr": "Hayvanlara zarar vermezler.", "ur": "وہ جانوروں کو اذیت نہیں دیتے۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "يُؤْذُونَ", "target": true, "translation": {"bs": "povređuju", "en": "they harm", "bn": "তারা ক্ষতি করে", "fa": "آزار می‌دهند", "fr": "ils font du mal", "id": "mereka menyakiti", "tr": "zarar verirler", "ur": "وہ اذیت دیتے ہیں"}}, {"arabic": "الْحَيَوَانَاتِ", "target": false, "translation": {"bs": "životinje", "en": "the animals", "bn": "প্রাণীদের প্রতি", "fa": "حیوانات", "fr": "envers les animaux", "id": "hewan-hewan", "tr": "hayvanlar", "ur": "جانوروں"}}]}]}