b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِمْلِكْ", "plain": "اِمْلِكْ", "quran": false, "notUsed": false, "spoken": "audio/48d064fa4a8ff8d3b735.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِمْلِكِي", "plain": "اِمْلِكِي", "quran": false, "notUsed": false, "spoken": "audio/5e1bc06e41da3c3e0646.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِمْلِكَا", "plain": "اِمْلِكَا", "quran": false, "notUsed": false, "spoken": "audio/92ea0a938cd9a19e48dc.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِمْلِكُوا", "plain": "اِمْلِكُوا", "quran": false, "notUsed": false, "spoken": "audio/08f1f9080824da99a6d5.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِمْلِكْنَ", "plain": "اِمْلِكْنَ", "quran": false, "notUsed": false, "spoken": "audio/b293b722400985da3cec.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "23:6", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2679.mp3", "translation": {"en": {"text": "Save from their wives or the (slaves) that their right hands possess, for then they are not blameworthy,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ancak eşleri ve ellerinin sahip olduğu (cariyeleri) hariç. (Bunlarla ilişkilerinden dolayı) kınanmış değillerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "مگر اپنی بیبیوں یا شرعی باندیوں پر جو ان کے ہاتھ کی مِلک ہیں کہ ان پر کوئی ملامت نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "kecuali terhadap isteri-isteri mereka atau budak yang mereka miliki; maka sesungguhnya mereka dalam hal ini tiada tercela.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَزْوَٰجِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَلَكَتْ", "hit": true, "audio": "audio/7ad8d716beee93669425.m4a", "gloss": {"bs": "posjeduju", "en": "possess", "tr": "sahiptirler", "fr": "possèdent", "id": "memiliki", "ur": "وہ مالک ہیں", "bn": "(যা) অধিকারে আছে", "fa": "مالک‌اند"}}, {"text": "أَيْمَٰنُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "غَيْرُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَلُومِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:87", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2337.mp3", "translation": {"en": {"text": "They will have no power of intercession, save him who hath made a covenant with his Lord.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(O gün) Rahmân (olan Allah)'ın katında bir ahd almış olan kimseden başkaları şefaat etme hakkına sahip olamayacaklardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "لوگ شفاعت کے مالک نہیں مگر وہی جنہوں نے رحمن کے پاس قرار رکھا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka tidak berhak mendapat syafa'at kecuali orang yang telah mengadakan perjanjian di sisi Tuhan Yang Maha Pemurah.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَمْلِكُونَ", "hit": true, "audio": "audio/72f1228fb7a043b768bf.m4a", "gloss": {"en": "they own", "bs": "posjeduju", "tr": "sahiptirler", "fr": "ils possèdent", "id": "mereka memiliki", "ur": "وہ مالک ہوتے ہیں", "bn": "তারা মালিক", "fa": "مالک هستند"}}, {"text": "ٱلشَّفَٰعَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱتَّخَذَ", "hit": false, "audio": null, "gloss": null}, {"text": "عِندَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّحْمَٰنِ", "hit": false, "audio": null, "gloss": null}, {"text": "عَهْدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:89", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2437.mp3", "translation": {"en": {"text": "See they not, then, that it returneth no saying unto them and possesseth for them neither hurt nor use?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar görmüyorlar mıydı ki, o buzağı, kendilerine hiçbir sözle karşılık veremiyor; onlara ne bir zarar, ne de bir yarar vermeye sahip bulunamıyordu.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو کیا نہیں دیکھتے کہ وہ انہیں کسی بات کا جواب نہیں دیتا اور ان کے سوا کسی برے بھلے کا اختیار نہیں رکھتا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka apakah mereka tidak memperhatikan bahwa patung anak lembu itu tidak dapat memberi jawaban kepada mereka, dan tidak dapat memberi kemudharatan kepada mereka dan tidak (pula) kemanfaatan?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَفَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَرَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَرْجِعُ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْلًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَمْلِكُ", "hit": true, "audio": "audio/75c70b8cd3bc5ab21553.m4a", "gloss": {"en": "he/it owns", "bs": "posjeduje", "tr": "sahiptir", "fr": "il possède", "id": "dia memiliki", "ur": "وہ مالک ہے", "bn": "সে মালিক", "fa": "مالک است"}}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ضَرًّا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "نَفْعًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "72:21", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5468.mp3", "translation": {"en": {"text": "Say: Lo! I control not hurt nor benefit for you.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki, \"Haberiniz olsun, ben size kendiliğimden ne bir zarar verebilirim, ne de bir yol gösterebilirim.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ میں تمہارے کسی برے بھلے کا مالک نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah: \"Sesungguhnya aku tidak kuasa mendatangkan sesuatu kemudharatanpun kepadamu dan tidak (pula) suatu kemanfaatan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "لَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْلِكُ", "hit": true, "audio": "audio/d6f3d9a01d147eb14fec.m4a", "gloss": {"bs": "posjedujem", "en": "I possess", "tr": "sahibim", "fr": "je possède", "id": "aku memiliki", "ur": "میں مالک ہوں", "bn": "আমি অধিকার রাখি", "fa": "مالک هستم"}}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ضَرًّا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "رَشَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "82:19", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5848.mp3", "translation": {"en": {"text": "A day on which no soul hath power at all for any (other) soul. The (absolute) command on that day is Allah's.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O gün, hiç kimsenin başkası için hiçbir şeye sahip olamadığı gündür. O gün buyruk yalnız Allah'ındır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جس دن کوئی جان کسی جان کا کچھ اختیار نہ رکھے گی اور سارا حکم اس دن اللہ کا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Yaitu) hari (ketika) seseorang tidak berdaya sedikitpun untuk menolong orang lain. Dan segala urusan pada hari itu dalam kekuasaan Allah.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَمْلِكُ", "hit": true, "audio": "audio/31c81ca58211a0cd997b.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}, {"text": "نَفْسٌ", "hit": false, "audio": null, "gloss": null}, {"text": "لِّنَفْسٍ", "hit": false, "audio": null, "gloss": null}, {"text": "شَيْـًٔا", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْأَمْرُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَئِذٍ", "hit": false, "audio": null, "gloss": null}, {"text": "لِّلَّهِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "مَلَكَتْ", "count": 15, "first": "4:3", "audio": "audio/ee6f95238d93a7e27eb5.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"bs": "posjeduju", "en": "possess", "tr": "sahiptirler", "fr": "possèdent", "id": "memiliki", "ur": "وہ مالک ہیں", "bn": "(