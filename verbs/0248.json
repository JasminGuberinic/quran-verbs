"pronoun": "anti", "arabic": "تَمُدِّينَ", "plain": "تَمُدِّينَ", "quran": false, "notUsed": false, "spoken": "audio/5df10948c7e7faaed0a4.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تَمُدَّانِ", "plain": "تَمُدَّانِ", "quran": false, "notUsed": false, "spoken": "audio/ba3674157c1945b573a0.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَمُدُّونَ", "plain": "تَمُدُّونَ", "quran": false, "notUsed": false, "spoken": "audio/9be45f381418e9d21e61.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antunna", "arabic": "تَمْدُدْنَ", "plain": "تَمْدُدْنَ", "quran": false, "notUsed": false, "spoken": "audio/57ec719f711132493054.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَمُدُّ", "plain": "يَمُدُّ", "quran": false, "notUsed": false, "spoken": "audio/958b3f3d10665986040f.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hiya", "arabic": "تَمُدُّ", "plain": "تَمُدُّ", "quran": false, "notUsed": false, "spoken": "audio/301ce956510ea83ad90f.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يَمُدَّانِ", "plain": "يَمُدَّانِ", "quran": false, "notUsed": false, "spoken": "audio/4765dcc43af628e9116a.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَمُدُّونَ", "plain": "يَمُدُّونَ", "quran": false, "notUsed": false, "spoken": "audio/8bb2a4a1c7e97ff8cedc.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hunna", "arabic": "يَمْدُدْنَ", "plain": "يَمْدُدْنَ", "quran": false, "notUsed": false, "spoken": "audio/619db5dcb22704aeb4b7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اُمْدُدْ", "plain": "اُمْدُدْ", "quran": false, "notUsed": false, "spoken": "audio/4257789f1a0e3c188ecc.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "مُدِّي", "plain": "مُدِّي", "quran": false, "notUsed": false, "spoken": "audio/ac129923c9eb8090ff1c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "مُدَّا", "plain": "مُدَّا", "quran": false, "notUsed": false, "spoken": "audio/9d1e8beaac4405e97000.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "مُدُّوا", "plain": "مُدُّوا", "quran": false, "notUsed": false, "spoken": "audio/14ce1717e8bceebcebad.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُمْدُدْنَ", "plain": "اُمْدُدْنَ", "quran": false, "notUsed": false, "spoken": "audio/81d30846c4636f487afd.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "2:15", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/22.mp3", "translation": {"en": {"text": "Allah (Himself) doth mock them, leaving them to wander blindly on in their contumacy.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Asıl) Allah onlarla alay eder ve taşkınlıkları içinde serserice dolaşmalarına mühlet verir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اللہ ان سے استہزاء فرماتا ہے (جیسا کہ اس کی شان کے لائق ہے) اور انہیں ڈھیل دیتا ہے کہ اپنی سرکشی میں بھٹکتے رہیں۔", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah akan (membalas) olok-olokan mereka dan membiarkan mereka terombang-ambing dalam kesesatan mereka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَهْزِئُ", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَمُدُّهُمْ", "hit": true, "audio": "audio/b857bfb6a1c2db046833.m4a", "gloss": {"bs": "i produžava im", "en": "and He prolongs [for] them", "tr": "ve onlara mühlet verir", "fr": "et Il les laisse se prolonger", "id": "dan Dia memperpanjang [bagi] mereka", "ur": "اور وہ انہیں ڈھیل دیتا ہے", "bn": "এবং তিনি তাদের সুযোগ দেন", "fa": "و برای آنان مهلت می‌دهد"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "طُغْيَٰنِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْمَهُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:19", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1821.mp3", "translation": {"en": {"text": "And the earth have We spread out, and placed therein firm hills, and caused each seemly thing to grow therein.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yeryüzünü düzgün bir şekilde yarattık ve oraya sabit dağlar yerleştirdik. Orada hikmetle ölçülmüş her şeyden bitkiler bitirdik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے زمین پھیلائی اور اس میں لنگر ڈالے اور اس میں ہر چیز اندازے سے اگائی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami telah menghamparkan bumi dan menjadikan padanya gunung-gunung dan Kami tumbuhkan padanya segala sesuatu menurut ukuran.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلْأَرْضَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَدَدْنَٰهَا", "hit": true, "audio": "audio/0a2f63b7017d5a65608d.m4a", "gloss": {"bs": "smo je prostrli", "en": "We spread it out", "tr": "onu yaydık", "fr": "Nous l'avons étendue", "id": "Kami menghamparkannya", "ur": "ہم نے اسے پھیلایا", "bn": "আমরা তা বিস্তৃত করেছি", "fa": "آن را گستردیم"}}, {"text": "وَأَلْقَيْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "رَوَٰسِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنۢبَتْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "كُلِّ", "hit": false, "audio": null, "gloss": null}, {"text": "شَىْءٍ", "hit": false, "audio": null, "gloss": null}, {"text": "مَّوْزُونٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:202", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1156.mp3", "translation": {"en": {"text": "Their brethren plunge them further into error and cease not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Şeytanların kardeşlerine gelince, onlar öbürlerini sapıklığa sürüklerler, sonra da yakalarını bırakmazlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جو شیطانوں کے بھائی ہیں شیطان انہیں گمراہی میں کھینچتے ہیں پھر کمی نہیں کرتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan teman-teman mereka (orang-orang kafir dan fasik) membantu syaitan-syaitan dalam menyesatkan dan mereka tidak henti-hentinya (menyesatkan).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِخْوَٰنُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَمُدُّونَهُمْ", "hit": true, "audio": "audio/030e52d64fd5915b4918.m4a", "gloss": {"en": "they draw them on", "bs": "navode ih", "tr": "onları sürüklerler", "fr": "ils les conduisent", "id": "mereka menggiring mereka", "ur": "وہ انہیں کھینچتے ہیں", "bn": "তারা তাদের টেনে নেয়", "fa": "آنان را می‌کشانند"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْغَىِّ", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُقْصِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "19:79", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2329.mp3", "translation": {"en": {"text": "Nay, but We shall record that which he saith and prolong for him a span of torment.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hayır, asla öyle değil; biz onun söylediklerini yazacağız ve azabını çoğalttıkça çoğaltacağız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہرگز نہیں اب ہم لکھ رکھیں گے جو وہ کہتا ہے اور اسے خوب لمبا عذاب دیں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "sekali-kali tidak, Kami akan menulis apa yang ia katakan, dan benar-benar Kami akan memperpanjang azab untuknya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "سَنَكْتُبُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُولُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَمُدُّ", "hit": true, "audio": "audio/4128a78421f6cb72cf75.m4a", "gloss": {"en": "and we extend", "bs": "i pružamo", "tr": "ve uzatırız", "fr": "et nous étendons", "id": "dan kami membentangkan", "ur": "اور ہم پھیلاتے ہیں", "bn": "এবং আমরা প্রসারিত করি", "fa": "و می‌گستریم"}}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَذَابِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَدًّا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "مَدَّ", "count": 2, "first": "13:3", "audio": "audio/b0f520a1f5907a90e783.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it extended", "bs": "pružio je", "tr": "uzattı", "fr": "il a étendu", "id": "dia telah membentangkan", "ur": "اُس نے پھیلایا", "bn": "সে প্রসারিত করল", "fa": "گسترد"}}, {"arabic": "مَدَدْنَٰهَا", "count": 2, "first": "15:19", "audio": "audio/0a2f63b7017d5a65608d.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["hiya"]}], "gloss": {"bs": "smo je prostrli", "en": "We spread it out", "tr": "onu yaydık", "fr": "Nous l'avons étendue", "id": "Kami menghamparkannya", "ur": "ہم نے اسے پھیلایا", "bn": "আমরা তা বিস্তৃত করেছি", "fa": "آن را گستردیم"}}, {"arabic": "تَمُدَّنَّ", "count": 2, "first": "15:88", "audio": "audio/fcb9148882451f68073a.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "indicative"}, {"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "jussive"}]}, {"arabic": "فَلْيَمْدُدْ", "count": 2, "first": "19:75", "audio": "audio/0f2fef928d7ba4b805b3.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "so let him extend", "bs": "pa neka pruži", "tr": "böylece uzatsın", "fr": "qu'il étende", "id": "maka biarlah dia membentangkan", "ur": "پس وہ پھیلائے", "bn": "অতএব সে প্রসারিত করুক", "fa": "پس بگستراند"}}, {"arabic": "وَيَمُدُّهُمْ", "count": 1, "first": "2:15", "audio": "audio/b857bfb6a1c2db046833.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"bs": "i produžava im", "en": "and He prolongs [for] them", "tr": "ve onlara mühlet verir", "fr": "et Il les laisse se prolonger", "id": "dan Dia memperpanjang [bagi] mereka", "ur": "اور وہ انہیں ڈھیل دیتا ہے", "bn": "এবং তিনি তাদের সুযোগ দেন", "fa": "و برای آنان مهلت می‌دهد"}}, {"arabic": "يَمُدُّونَهُمْ", "count": 1, "first": "7:202", "audio": "audio/030e52d64fd5915b4918.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["hum"], "mood": "indicative"}], "gloss": {"en": "they draw them on", "bs": "navode ih", "tr": "onları sürüklerler", "fr": "ils les conduis