{"rank": 86, "root": "دخل", "form": 4, "lemma": "أَدْخَلَ", "count": 42, "ayahCount": 41, "share": 0.22, "meaning": {"bs": "uvesti", "en": "to admit, to make enter", "tr": "koymak, sokmak", "fr": "faire entrer, admettre", "id": "memasukkan", "ur": "داخل کرنا", "bn": "প্রবেশ করানো", "fa": "وارد کردن، داخل کردن"}, "lemmaSpoken": "audio/625d640f39e265aa00e2.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَدْخَلَ", "plain": "أَدْخَلَ", "quran": false, "notUsed": false, "spoken": "audio/625d640f39e265aa00e2.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يُدْخِلُ", "plain": "يُدْخِلُ", "quran": true, "notUsed": false, "spoken": "audio/88267edfe765d5edbc5c.m4a", "recited": "audio/a2361be7143f4c6bb714.m4a", "recitedText": "يُدْخِلُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَدْخِلْ", "plain": "أَدْخِلْ", "quran": true, "notUsed": false, "spoken": "audio/9a9a681beaf930344ce2.m4a", "recited": "audio/6db8100d031f7a6a5d5c.m4a", "recitedText": "وَأَدْخِلْ"}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَدْخَلْتُ", "plain": "أَدْخَلْتُ", "quran": false, "notUsed": false, "spoken": "audio/31b6989ccb03b0886be3.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَدْخَلْنَا", "plain": "أَدْخَلْنَا", "quran": false, "notUsed": false, "spoken": "audio/657510b75ec33e78d1e1.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "أَدْخَلْتَ", "plain": "أَدْخَلْتَ", "quran": false, "notUsed": false, "spoken": "audio/f88d1ebd22d79da24c03.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "أَدْخَلْتِ", "plain": "أَدْخَلْتِ", "quran": false, "notUsed": false, "spoken": "audio/6e941ce0be6d2af23260.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "أَدْخَلْتُمَا", "plain": "أَدْخَلْتُمَا", "quran": false, "notUsed": false,