 "gloss": {"bs": "progovorit će", "en": "will speak", "tr": "konuşacak", "fr": "parlera", "id": "akan berbicara", "ur": "بات کرے گی", "bn": "সে কথা বলবে", "fa": "سخن خواهد گفت"}}, {"text": "نَفْسٌ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "بِإِذْنِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "فَمِنْهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "شَقِىٌّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَسَعِيدٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "30:35", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3444.mp3", "translation": {"en": {"text": "Or have We revealed unto them any warrant which speaketh of that which they associate with Him?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yoksa biz onlara bir delil indirmişiz de O'na ortak koşmalarını o mu söylüyor?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا ہم نے ان پر کوئی سند اتاری کہ ہو انہیں ہمارے شریک بتارہی ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Atau pernahkah Kami menurunkan kepada mereka keterangan, lalu keterangan itu menunjukkan (kebenaran) apa yang mereka selalu mempersekutukan dengan Tuhan?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنزَلْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "سُلْطَٰنًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَكَلَّمُ", "hit": true, "audio": "audio/6398b10a7857cab857c5.m4a", "gloss": {"bs": "govori", "en": "speaks", "tr": "konuşur", "fr": "parle", "id": "berbicara", "ur": "بات کرتا ہے", "bn": "সে কথা বলে", "fa": "سخن می‌گوید"}}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "يُشْرِكُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تَكَلَّمُ", "count": 1, "first": "11:105", "audio": "audio/21b89579600ded1db1f1.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "progovorit će", "en": "will speak", "tr": "konuşacak", "fr": "elle parlera", "id": "dia akan berbicara", "ur": "بولے گا", "bn": "বলবে", "fa": "سخن خواهد گفت"}}, {"arabic": "نَّتَكَلَّمَ", "count": 1, "first": "24:16", "audio": "audio/a3562fb5a5c18d2dd79d.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "we speak", "bs": "govorimo", "tr": "konuşuruz", "fr": "nous parlons", "id": "kami berbicara", "ur": "ہم بولتے ہیں", "bn": "আমরা বলি", "fa": "سخن گوییم"}}, {"arabic": "يَتَكَلَّمُ", "count": 1, "first": "30:35", "audio": "audio/6398b10a7857cab857c5.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "govori", "en": "speaks", "tr": "konuşur", "fr": "il parle", "id": "dia berbicara", "ur": "بولتا ہے", "bn": "বলে", "fa": "سخن می‌گوید"}}, {"arabic": "يَتَكَلَّمُونَ", "count": 1, "first": "78:38", "audio": "audio/f4ff9432d6f969c4d134.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they speak", "bs": "govore", "tr": "konuşurlar", "fr": "ils parlent", "id": "mereka berbicara", "ur": "وہ بولتے ہیں", "bn": "তারা বলে", "fa": "سخن می‌گویند"}}], "ayatFile": "ayat/0574.json", "ayatTranslations": {"en": "ayat/0574.en.json", "tr": "ayat/0574.tr.json", "ur": "ayat/0574.ur.json", "id": "ayat/0574.id.json"}, "sentences": [{"arabi