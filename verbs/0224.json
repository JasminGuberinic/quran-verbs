{"rank": 224, "root": "صدق", "form": 1, "lemma": "صَدَقَ", "count": 15, "ayahCount": 15, "share": 0.08, "meaning": {"bs": "govoriti istinu, biti iskren", "en": "to tell the truth", "tr": "doğru söylemek, sadık olmak", "fr": "dire la vérité", "id": "berkata benar", "ur": "سچ بولنا", "bn": "সত্য বলা", "fa": "راست گفتن"}, "lemmaSpoken": "audio/887cdd9d748dcdebdb08.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "صَدَقَ", "plain": "صَدَقَ", "quran": true, "notUsed": false, "spoken": "audio/887cdd9d748dcdebdb08.m4a", "recited": "audio/059c2ee2433f7cc78943.m4a", "recitedText": "صَدَقَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَصْدُقُ", "plain": "يَصْدُقُ", "quran": false, "notUsed": false, "spoken": "audio/5edd51d0e3cb3d3e8f01.m4a", "recited": null, "recitedText": null}], "nouns": {"participle": {"lemma": "صادِق", "count": 59, "spoken": "audio/477356fd944f3e73039c.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "صَدَقْتُ", "plain": "صَدَقْتُ", "quran": false, "notUsed": false, "spoken": "audio/7c20825a1e4a668c0e2a.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "صَدَقْنَا", "plain": "صَدَقْنَا", "quran": false, "notUsed": false, "spoken": "audio/087cf54ac7a20e4c0c74.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "صَدَقْتَ", "plain": "صَدَقْتَ", "quran": true, "notUsed": false, "spoken": "audio/6a5ff1d26750bfe66b8d.m4a", "recited": "audio/8dd6786df8557d92baca.m4a", "recitedText": "أَصَدَقْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "صَدَقْتِ", "plain": "صَدَقْتِ", "quran": false, "notUsed": false, "spoken": "audio/e132de62231b0690f26f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "صَدَقْتُمَا", "plain": "صَدَقْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/a0d49c79c3d2f4bbf085.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "