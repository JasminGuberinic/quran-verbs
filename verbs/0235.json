 null, "gloss": null}, {"text": "بِٱلْحَقِّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَبِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْدِلُونَ", "hit": true, "audio": "audio/edba715584c91f1978e0.m4a", "gloss": {"bs": "pravedno postupaju", "en": "they act justly", "tr": "adaletle davranırlar", "fr": "ils agissent avec équité", "id": "mereka berlaku adil", "ur": "وہ انصاف کرتے ہیں", "bn": "তারা ন্যায়বিচার করে", "fa": "عدالت می‌کنند"}}]}, {"ref": "82:7", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5836.mp3", "translation": {"en": {"text": "Who created thee, then fashioned, then proportioned thee?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O Allah ki seni yarattı, seni düzgün yapılı kılıp ölçülü bir biçim verdi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جس نے تجھے پیدا کیا پھر ٹھیک بنایا پھر ہموار فرمایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Yang telah menciptakan kamu lalu menyempurnakan kejadianmu dan menjadikan (susunan tubuh)mu seimbang,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَسَوَّىٰكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَعَدَلَكَ", "hit": true, "audio": "audio/a3ad291d88398812746f.m4a", "gloss": {"bs": "i skladnim te učinio", "en": "and He proportioned you", "tr": "ve seni düzgün kıldı", "fr": "et Il t'a proportionné", "id": "dan Dia menyempurnakanmu", "ur": "پھر تمہیں متناسب بنایا", "bn": "এবং তিনি তোমাকে সুসামঞ্জস্য করলেন", "fa": "و تو را موزون ساخت"}}]}], "forms": [{"arabic": "يَعْدِلُونَ", "count": 5, "first": "6:1", "audio": "audio/edba715584c91f1978e0.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "pravedno postupaju", "en": "they act justly", "tr": "adaletle davranırlar", "fr": "ils agissent avec équité", "id": "mereka berlaku adil", "ur": "وہ انصاف کرتے ہیں", "bn": "তারা ন্যায়বিচার করে", "fa": "عدالت می‌کنند"}}, {"arabic": "تَعْدِلُوا۟", "count": 4, "first": "4:3", "audio": "audio/9c69b1c41309a24d55e4.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "you (all) are just", "bs": "postupate pravedno", "tr": "adil davranırsınız", "fr": "que vous soyez justes", "id": "kalian berlaku adil", "ur": "تم سب عدل کرتے ہو", "bn": "তোমরা ন্যায্য আচরণ কর", "fa": "عدالت ورزید"}}, {"arabic": "ٱعْدِلُوا۟", "count": 1, "first": "5:8", "audio": "audio/b5b2990252e652d3f305.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "(you all) be just!", "bs": "postupajte pravedno!", "tr": "adil davranın!", "fr": "soyez justes !", "id": "berlakulah adil!", "ur": "عدل کرو!", "bn": "ন্যায্য আচরণ কর!", "fa": "عدالت ورزید!"}}, {"arabic": "تَعْدِلْ", "count": 1, "first": "6:70", "audio": "audio/904e7ea5700bde0b2968.m4a", "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "jussive"}]}, {"arabic": "فَٱعْدِلُوا۟", "count": 1, "first": "6:152", "audio": "audio/6c176507e6c6a6bdaf8c.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) be just!", "bs": "pa postupajte pravedno!", "tr": "böylece adil davranın!", "fr": "alors soyez justes !", "id": "maka berlakulah adil kalian!", "ur": "پس تم سب عدل کرو!", "bn": "অতএব ন্যায্য আচরণ কর!", "fa": "پس عدالت ورزید!"}}, {"arabic": "لِأَعْدِلَ", "count": 1, "first": "42:15", "audio": "audio/40b1287610f53ca66954.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "so that I may be just", "bs": "