ronoun": "huwa", "translation": {"bs": "Obućar reže kožu na trake.", "en": "The cobbler cuts the leather into strips.", "bn": "মুচি চামড়াটি ফালি ফালি করে কাটে।", "fa": "کفاش چرم را نوار نوار می‌کند.", "fr": "Le cordonnier coupe le cuir en bandes.", "id": "Tukang sepatu itu merobek kulit menjadi potongan-potongan.", "tr": "Ayakkabıcı deriyi şeritler halinde keser.", "ur": "موچی چمڑے کو پٹیوں میں کاٹتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَقُدُّ", "target": true, "translation": {"bs": "reže na trake", "en": "cuts into strips", "bn": "ফালি ফালি করে কাটে", "fa": "نوار نوار می‌کند", "fr": "coupe en bandes", "id": "ia merobek menjadi potongan-potongan", "tr": "şeritler halinde keser", "ur": "پٹیوں میں کاٹتا ہے"}}, {"arabic": "الْإِسْكَافِيُّ", "target": false, "translation": {"bs": "obućar", "en": "the cobbler", "bn": "মুচি", "fa": "کفاش", "fr": "le cordonnier", "id": "tukang sepatu itu", "tr": "ayakkabıcı", "ur": "موچی"}}, {"arabic": "الْجِلْدَ", "target": false, "translation": {"bs": "kožu", "en": "the leather", "bn": "চামড়া", "fa": "چرم", "fr": "le cuir", "id": "kulit itu", "tr": "deri", "ur": "چمڑا"}}]}, {"arabic": "أَقُدُّ الْوَرَقَةَ نِصْفَيْنِ", "spoken": "audio/20af53ec1ebaf45c1307.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Rasijecam list po dužini na dva dijela.", "en": "I cut the sheet lengthwise in two.", "bn": "আমি কাগজটি লম্বালম্বিভাবে দুই ভাগে কাটি।", "fa": "برگه را از طول به دو نیم می‌کنم.", "fr": "Je coupe la feuille en deux dans la longueur.", "id": "Aku merobek lembaran itu memanjang menjadi dua bagian.", "tr": "Sayfayı boyuna ikiye yararım.", "ur": "میں ورق کو لمبائی میں کاٹ کر دو حصے کرتا ہوں۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَقُدُّ", "target": true, "translation": {"bs": "rasijecam po dužini", "en": "cut lengthwise", "bn": "লম্বালম্বিভাবে কাটি", "fa": "از طول می‌برم", "fr": "je déchire dans la longueur", "id": "aku merobek memanjang", "tr": "boyuna yararım", "ur": "لمبائی میں کاٹتا ہوں"}}, {"arabic": "الْوَرَقَةَ", "target": false, "translation": {"bs": "list", "en": "the sheet", "bn": "কাগজ", "fa": "برگه", "fr": "la feuille", "id": "lembaran itu", "tr": "sayfa", "ur": "ورق"}}, {"arabic": "نِصْفَيْنِ", "target": false, "translation": {"bs": "na dva dijela", "en": "in two", "bn": "দুই ভাগে", "fa": "به دو نیم", "fr": "en deux", "id": "menjadi dua bagian", "tr": "ikiye", "ur": "دو حصوں میں"}}]}, {"arabic": "قَدُّوا الْقُمَاشَ شَرَائِطَ", "spoken": "audio/be262ab1e809faecbbbc.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Izrezali su tkaninu na trake.", "en": "They cut the cloth into strips.", "bn": "তারা কাপড়টি ফালি ফালি করে কেটেছে।", "fa": "پارچه را نوار نوار بریدند.", "fr": "Ils ont découpé le tissu en bandes.", "id": "Mereka merobek kain itu menjadi potongan-potongan.", "tr": "Kumaşı şeritler halinde kestiler.", "ur": "انہوں نے کپڑا پٹیوں میں کاٹا۔"}, "independentlyReviewed": true, "words": [{"arabic": "قَدُّوا", "target": true, "translation": {"bs": "izrezali su", "en": "cut", "bn": "কেটেছে", "fa": "بریدند", "fr": "ont découpé", "id": "mereka merobek", "tr": "kestiler", "ur": "کاٹ ڈالا"}}, {"arabic": "الْقُمَاشَ", "target": false, "translation": {"bs": "tkaninu", "en": "the cloth", "bn": "কাপড়", "fa": "پارچه", "fr": "le tissu", "id": "kain itu", "tr": "kumaş", "ur": "کپڑا"}}, {"arabic": "شَرَائِطَ", "target": false, "translation": {"bs": "na trake", "en": "into strips", "bn": "ফালিতে", "fa": "نوار", "fr": "en bandes", "id": "menjadi potongan-potongan", "tr": "şeritler halinde", "ur": "پٹیوں میں"}}]}, {"arabic": "اُقْدُدْ هَذَا الْجِلْدَ", "spoken": "audio/ca4b2257f454d54ac44c.m4a", "tense": "imperative", "pronoun": "anta", "translation": {"bs": "Izreži ovu kožu po dužini.", "en": "Cut this leather lengthwise.", "bn": "এই চামড়াটি লম্বালম্বিভাবে কাটো।", "fa": "این چرم را از طول ببر.", "fr": "Coupe ce cuir dans la longueur.", "id": "Robeklah kulit ini memanjang.", "tr": "Bu deriyi boyuna yar.", "ur": "یہ چمڑا لمبائی میں کاٹو۔"}, "independentlyReviewed": true, "words": [{"arabic": "اُقْدُدْ", "target": true, "translation": {"bs": "izreži po dužini", "en": "cut lengthwise", "bn": "লম্বালম্বিভাবে কাটো", "fa": "از طول ببر", "fr": "déchire dans la longueur", "id": "robeklah memanjang", "tr": "boyuna yar", "ur": "لمبائی میں کاٹو"}}, {"arabic": "هَذَا", "target": false, "translation": {"bs": "ovu", "en": "this", "bn": "এই", "fa": "این", "fr": "ceci", "id": "ini", "tr": "bu", "ur": "یہ"}}, {"arabic": "الْجِلْدَ", "target": false, "translation": {"bs": "kožu", "en": "leather", "bn": "চামড়া", "fa": "چرم", "fr": "cuir", "id": "kulit", "tr": "deri", "ur": "چمڑا"}}]}]}