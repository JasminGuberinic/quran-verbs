ngatlah) ketika Malaikat (Jibril) berkata: \"Hai Maryam, sesungguhnya Allah telah memilih kamu, mensucikan kamu dan melebihkan kamu atas segala wanita di dunia (yang semasa dengan kamu).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِذْ", "hit": false, "audio": null, "gloss": null}, {"text": "قَالَتِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَلَٰٓئِكَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَٰمَرْيَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱصْطَفَىٰكِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَطَهَّرَكِ", "hit": true, "audio": "audio/787db686835db281fd3e.m4a", "gloss": {"bs": "i očistio te je", "en": "and He purified you", "tr": "ve seni arındırdı", "fr": "et Il t'a purifiée", "id": "dan Dia menyucikanmu", "ur": "اور اس نے تجھے پاک کیا", "bn": "এবং তিনি তোমাকে পবিত্র করেছেন", "fa": "و تو را پاک کرد"}}, {"text": "وَٱصْطَفَىٰكِ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "نِسَآءِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَٰلَمِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "طَهِّرَا", "count": 1, "first": "2:125", "audio": "audio/c4f72defbca5ad9bb2c6.m4a", "grammar": [{"tense": "imperative", "pronoun": "antuma", "passive": false, "objects": ["antuma"]}]}, {"arabic": "وَطَهَّرَكِ", "count": 1, "first": "3:42", "audio": "audio/787db686835db281fd3e.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["anti"]}], "gloss": {"bs": "i očistio te je", "en": "and He purified you", "tr": "ve seni arındırdı", "fr": "et Il t'a purifiée", "id": "dan Dia menyucikanmu", "ur": "اور اس نے تجھے پاک کیا", "bn": "এবং তিনি তোমাকে পবিত্র করেছেন", "fa": "و تو را پاک کرد"}}, {"arabic": "لِيُطَهِّرَكُمْ", "count": 1,