[{"id":"anshaa-6-98-2","words":["verb:anshaa"],"options":[{"bs":"stvorio vas je","en":"he/it produced you (all)"},{"bs":"stvorio ih je","en":"he/it produced them"},{"bs":"i podiže","en":"and He produces"},{"bs":"stvorili smo","en":"we produced"}],"ref":"6:98","answerWord":"أَنشَأَكُم","answerSound":"audio/21007d26c559b26ad4fa.m4a","quranTranslation":{"text":"And He it is Who hath produced you from a single being, and (hath given you) a habitation and a repository. We have detailed Our revelations for a people who have understanding.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["وَهُوَ","ٱلَّذِىٓ","أَنشَأَكُم","مِّن","نَّفْسٍ","وَٰحِدَةٍ","فَمُسْتَقَرٌّ","وَمُسْتَوْدَعٌ","قَدْ","فَصَّلْنَا","ٱلْءَايَٰتِ","لِقَوْمٍ","يَفْقَهُونَ"],"marked":[2],"facts":{"verb":"أَنشَأَ"}},{"id":"anshaa-23-31-1","words":["verb:anshaa"],"options":[{"bs":"stvorili smo","en":"we produced"},{"bs":"stvorio ih je","en":"he/it produced them"},{"bs":"i podiže","en":"and He produces"},{"bs":"stvorio je","en":"he/it produced"}],"ref":"23:31","answerWord":"أَنشَأْنَا","answerSound":"audio/b8356330a3cf5d53a7e2.m4a","quranTranslation":{"text":"Then, after them, We brought forth another generation;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["ثُمَّ","أَنشَأْنَا","مِنۢ","بَعْدِهِمْ","قَرْنًا","ءَاخَرِينَ"],"marked":[1],"facts":{"verb":"أَنشَأَ"}},{"id":"anshaa-23-78-2","words":["verb:anshaa"],"options":[{"bs":"stvorio je","en":"he/it produced"},{"bs":"i stvorili smo","en":"and we produced"},{"bs":"stvorio vas je","en":"he/it produced you (all)"},{"bs":"i podiže","en":"and He produces"}],"ref":"23:78","answerWord":"أَنشَأَ","answerSound":"audio/e3f1297c54f491fcf05d.m4a","quranTranslation":{"text":"He it is Who hath created for you ears and eyes and hearts. Small thanks give ye!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["وَهُوَ","ٱلَّذِىٓ","أَنشَأَ","لَكُمُ","ٱلسَّمْعَ","وَٱلْأَبْصَٰرَ","وَٱلْأَفْـِٔدَةَ","قَلِيلًا","مَّا","تَشْكُرُونَ"],"marked":[2],"facts":{"verb":"أَنشَأَ"}},{"id":"anshaa-13-12-6","words":["verb:anshaa"],"options":[{"bs":"i podiže","en":"and He produces"},{"bs":"stvorili smo ih","en":"We produced them"},{"bs":"stvorio je","en":"he/it produced"},{"bs":"pa smo stvorili","en":"so we produced"}],"ref":"13:12","answerWord":"وَيُنشِئُ","answerSound":"audio/fdff590dd50e4b7b1058.m4a","quranTranslation":{"text":"He it is Who showeth you the lightning, a fear and a hope, and raiseth the heavy clouds.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["هُوَ","ٱلَّذِى","يُرِيكُمُ","ٱلْبَرْقَ","خَوْفًا","وَطَمَعًا","وَيُنشِئُ","ٱلسَّحَابَ","ٱلثِّقَالَ"],"marked":[6],"facts":{"verb":"أَنشَأَ"}},{"id":"anshaa-23-14-14","words":["verb:anshaa"],"options":[{"bs":"stvorili smo ga","en":"we produced it"},{"bs":"stvorili smo","en":"we produced"},{"bs":"i podiže","en":"and He produces"},{"bs":"stvorio vas je","en":"he/it produced you (all)"}],"ref":"23:14","answerWord":"أَنشَأْنَٰهُ","answerSound":"audio/edfc0386eabbcfdbd226.m4a","quranTranslation":{"text":"Then fashioned We the drop a clot, then fashioned We the clot a little lump, then fashioned We the little lump bones, then clothed the bones with flesh, and then produced it as another creation. So blessed be Allah, the Best of creators!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["ثُمَّ","خَلَقْنَا","ٱلنُّطْفَةَ","عَلَقَةً","فَخَلَقْنَا","ٱلْعَلَقَةَ","مُضْغَةً","فَخَلَقْنَا","ٱلْمُضْغَةَ","عِظَٰمًا","فَكَسَوْنَا","ٱلْعِظَٰمَ","لَحْمًا","ثُمَّ","أَنشَأْنَٰهُ","خَلْقًا","ءَاخَرَ","فَتَبَارَكَ","ٱللَّهُ","أَحْسَنُ","ٱلْخَٰلِقِينَ"],"marked":[14],"facts":{"verb":"أَنشَأَ"}},{"id":"anshaa-23-19-0","words":["verb:anshaa"],"options":[{"bs":"pa smo stvorili","en":"so we produced"},{"bs":"i stvaramo vas","en":"and we produce you (all)"},{"bs":"stvorio vas je","en":"he/it produced you (all)"},{"bs":"stvara","en":"he/it produces"}],"ref":"23:19","answerWord":"فَأَنشَأْنَا","answerSound":"audio/7ea321b0424f5be88dfe.m4a","quranTranslation":{"text":"Then We produce for you therewith gardens of date-palms and grapes, wherein is much fruit for you and whereof ye eat;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["فَأَنشَأْنَا","لَكُم","بِهِۦ","جَنَّٰتٍ","مِّن","نَّخِيلٍ","وَأَعْنَٰبٍ","لَّكُمْ","فِيهَا","فَوَٰكِهُ","كَثِيرَةٌ","وَمِنْهَا","تَأْكُلُونَ"],"marked":[0],"facts":{"verb":"أَنشَأَ"}},{"id":"anshaa-29-20-10","words":["verb:anshaa"],"options":[{"bs":"stvara","en":"he/it produces"},{"bs":"stvorio vas je","en":"he/it produced you (all)"},{"bs":"pa smo stvorili","en":"so we produced"},{"bs":"stvorili smo ih","en":"We produced them"}],"ref":"29:20","answerWord":"يُنشِئُ","answerSound":"audio/c6597e2a45b7c8691147.m4a","quranTranslation":{"text":"Say (O Muhammad): Travel in the land and see how He originated creation, then Allah bringeth forth the later growth. Lo! Allah is Able to do all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["قُلْ","سِيرُوا۟","فِى","ٱلْأَرْضِ","فَٱنظُرُوا۟","كَيْفَ","بَدَأَ","ٱلْخَلْقَ","ثُمَّ","ٱللَّهُ","يُنشِئُ","ٱلنَّشْأَةَ","ٱلْءَاخِرَةَ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَىْءٍ","قَدِيرٌ"],"marked":[10],"facts":{"verb":"أَنشَأَ"}},{"id":"anshaa-36-79-3","words":["verb:anshaa"],"options":[{"bs":"stvorio ih je","en":"he/it produced them"},{"bs":"i stvaramo vas","en":"and we produce you (all)"},{"bs":"stvorili ste","en":"you (all) produced"},{"bs":"i podiže","en":"and He produces"}],"ref":"36:79","answerWord":"أَنشَأَهَآ","answerSound":"audio/eb116e38becc13b00c19.m4a","quranTranslation":{"text":"Say: He will revive them Who produced them at the first, for He is Knower of every creation,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["قُلْ","يُحْيِيهَا","ٱلَّذِىٓ","أَنشَأَهَآ","أَوَّلَ","مَرَّةٍ","وَهُوَ","بِكُلِّ","خَلْقٍ","عَلِيمٌ"],"marked":[3],"facts":{"verb":"أَنشَأَ"}},{"id":"anshaa-56-35-1","words":["verb:anshaa"],"options":[{"bs":"stvorili smo ih","en":"We produced them"},{"bs":"stvorio vas je","en":"he/it produced you (all)"},{"bs":"i stvaramo vas","en":"and we produce you (all)"},{"bs":"stvorio je","en":"he/it produced"}],"ref":"56:35","answerWord":"أَنشَأْنَٰهُنَّ","answerSound":"audio/622d9e08c1b6772c8dae.m4a","quranTranslation":{"text":"Lo! We have created them a (new) creation","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["إِنَّآ","أَنشَأْنَٰهُنَّ","إِنشَآءً"],"marked":[1],"facts":{"verb":"أَنشَأَ"}},{"id":"anshaa-56-61-4","words":["verb:anshaa"],"options":[{"bs":"i stvaramo vas","en":"and we produce you (all)"},{"bs":"stvorio ih je","en":"he/it produced them"},{"bs":"i stvorili smo","en":"and we produced"},{"bs":"stvorili smo ih","en":"We produced them"}],"ref":"56:61","answerWord":"وَنُنشِئَكُمْ","answerSound":"audio/9e8bdfedd8722f53c4ea.m4a","quranTranslation":{"text":"That We may transfigure you and make you what ye know not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["عَلَىٰٓ","أَن","نُّبَدِّلَ","أَمْثَٰلَكُمْ","وَنُنشِئَكُمْ","فِى","مَا","لَا","تَعْلَمُونَ"],"marked":[4],"facts":{"verb":"أَنشَأَ"}},{"id":"anshaa-56-72-1","words":["verb:anshaa"],"options":[{"bs":"stvorili ste","en":"you (all) produced"},{"bs":"i stvorili smo","en":"and we produced"},{"bs":"stvara","en":"he/it produces"},{"bs":"i stvaramo vas","en":"and we produce you (all)"}],"ref":"56:72","answerWord":"أَنشَأْتُمْ","answerSound":"audio/390d28fbf1b3d13efe7e.m4a","quranTranslation":{"text":"Was it ye who made the tree thereof to grow, or were We the grower?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["ءَأَنتُمْ","أَنشَأْتُمْ","شَجَرَتَهَآ","أَمْ","نَحْنُ","ٱلْمُنشِـُٔونَ"],"marked":[1],"facts":{"verb":"أَنشَأَ"}},{"id":"anshaa-67-23-3","words":["verb:anshaa"],"options":[{"bs":"stvorio vas je","en":"he/it produced you (all)"},{"bs":"i stvorili smo","en":"and we produced"},{"bs":"stvorio je","en":"he/it produced"},{"bs":"stvorili smo ih","en":"We produced them"}],"ref":"67:23","answerWord":"أَنشَأَكُمْ","answerSound":"audio/13eda577960c7e028413.m4a","quranTranslation":{"text":"Say (unto them, O Muhammad): He it is who gave you being, and hath assigned unto you ears and eyes and hearts. Small thanks give ye!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"stvoriti, podići","en":"to produce, to bring into being"},"passage":["قُلْ","هُوَ","ٱلَّذِىٓ","أَنشَأَكُمْ","وَجَعَلَ","لَكُمُ","ٱلسَّمْعَ","وَٱلْأَبْصَٰرَ","وَٱلْأَفْـِٔدَةَ","قَلِيلًا","مَّا","تَشْكُرُونَ"],"marked":[3],"facts":{"verb":"أَنشَأَ"}},{"id":"atama-22-28-17","words":["verb:atama"],"options":[{"bs":"i nahranite!","en":"and (you all) feed!"},{"bs":"biva nahranjen","en":"he/it is fed"},{"bs":"nahranio ih je","en":"He fed them"},{"bs":"hrane me","en":"they feed me"}],"ref":"22:28","answerWord":"وَأَطْعِمُوا۟","answerSound":"audio/7d2fb9aca6ae2e8be1ee.m4a","quranTranslation":{"text":"That they may witness things that are of benefit to them, and mention the name of Allah on appointed days over the beast of cattle that He hath bestowed upon them. Then eat thereof and feed therewith the poor unfortunate.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nahraniti","en":"to feed"},"passage":["لِّيَشْهَدُوا۟","مَنَٰفِعَ","لَهُمْ","وَيَذْكُرُوا۟","ٱسْمَ","ٱللَّهِ","فِىٓ","أَيَّامٍ","مَّعْلُومَٰتٍ","عَلَىٰ","مَا","رَزَقَهُم","مِّنۢ","بَهِيمَةِ","ٱلْأَنْعَٰمِ","فَكُلُوا۟","مِنْهَا","وَأَطْعِمُوا۟","ٱلْبَآئِسَ","ٱلْفَقِيرَ"],"marked":[17],"facts":{"verb":"أَطْعَمَ"}},{"id":"atama-6-14-9","words":["verb:atama"],"options":[{"bs":"hrani","en":"he/it feeds"},{"bs":"hrani me","en":"He feeds me"},{"bs":"hrane me","en":"they feed me"},{"bs":"zar hranimo?","en":"do we feed?"}],"ref":"6:14","answerWord":"يُطْعِمُ","answerSound":"audio/10a03c7d4bf7e5588dc0.m4a","quranTranslation":{"text":"Say: Shall I choose for a protecting friend other than Allah, the Originator of the heavens and the earth, Who feedeth and is never fed? Say: I am ordered to be the first to surrender (unto Him). And be not thou (O Muhammad) of the idolaters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nahraniti","en":"to feed"},"passage":["قُلْ","أَغَيْرَ","ٱللَّهِ","أَتَّخِذُ","وَلِيًّا","فَاطِرِ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","وَهُوَ","يُطْعِمُ","وَلَا","يُطْعَمُ","قُلْ","إِنِّىٓ","أُمِرْتُ","أَنْ","أَكُونَ","أَوَّلَ","مَنْ","أَسْلَمَ","وَلَا","تَكُونَنَّ","مِنَ","ٱلْمُشْرِكِينَ"],"marked":[9],"facts":{"verb":"أَطْعَمَ"}},{"id":"atama-6-14-11","words":["verb:atama"],"options":[{"bs":"biva nahranjen","en":"he/it is fed"},{"bs":"i nahranite!","en":"and (you all) feed!"},{"bs":"zar hranimo?","en":"do we feed?"},{"bs":"hrane me","en":"they feed me"}],"ref":"6:14","answerWord":"يُطْعَمُ","answerSound":"audio/d9f895d7bf28457c0c30.m4a","quranTranslation":{"text":"Say: Shall I choose for a protecting friend other than Allah, the Originator of the heavens and the earth, Who feedeth and is never fed? Say: I am ordered to be the first to surrender (unto Him). And be not thou (O Muhammad) of the idolaters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nahraniti","en":"to feed"},"passage":["قُلْ","أَغَيْرَ","ٱللَّهِ","أَتَّخِذُ","وَلِيًّا","فَاطِرِ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","وَهُوَ","يُطْعِمُ","وَلَا","يُطْعَمُ","قُلْ","إِنِّىٓ","أُمِرْتُ","أَنْ","أَكُونَ","أَوَّلَ","مَنْ","أَسْلَمَ","وَلَا","تَكُونَنَّ","مِنَ","ٱلْمُشْرِكِينَ"],"marked":[11],"facts":{"verb":"أَطْعَمَ"}},{"id":"atama-26-79-2","words":["verb:atama"],"options":[{"bs":"hrani me","en":"He feeds me"},{"bs":"i hrane","en":"and they feed"},{"bs":"hrane me","en":"they feed me"},{"bs":"hranite","en":"you (all) feed"}],"ref":"26:79","answerWord":"يُطْعِمُنِى","answerSound":"audio/eff76cfd871d18bcf6b9.m4a","quranTranslation":{"text":"And Who feedeth me and watereth me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nahraniti","en":"to feed"},"passage":["وَٱلَّذِى","هُوَ","يُطْعِمُنِى","وَيَسْقِينِ"],"marked":[2],"facts":{"verb":"أَطْعَمَ"}},{"id":"atama-36-47-12","words":["verb:atama"],"options":[{"bs":"zar hranimo?","en":"do we feed?"},{"bs":"i hrane","en":"and they feed"},{"bs":"hrane me","en":"they feed me"},{"bs":"nahranio ga je","en":"he/it fed him"}],"ref":"36:47","answerWord":"أَنُطْعِمُ","answerSound":"audio/36dfc318b779ed04ed2d.m4a","quranTranslation":{"text":"And when it is said unto them: Spend of that wherewith Allah hath provided you, those who disbelieve say unto those who believe: Shall we feed those whom Allah, if He willed, would feed? Ye are in naught else than error manifest.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nahraniti","en":"to feed"},"passage":["وَإِذَا","قِيلَ","لَهُمْ","أَنفِقُوا۟","مِمَّا","رَزَقَكُمُ","ٱللَّهُ","قَالَ","ٱلَّذِينَ","كَفَرُوا۟","لِلَّذِينَ","ءَامَنُوٓا۟","أَنُطْعِمُ","مَن","لَّوْ","يَشَآءُ","ٱللَّهُ","أَطْعَمَهُۥٓ","إِنْ","أَنتُمْ","إِلَّا","فِى","ضَلَٰلٍ","مُّبِينٍ"],"marked":[12],"facts":{"verb":"أَطْعَمَ"}},{"id":"atama-36-47-17","words":["verb:atama"],"options":[{"bs":"nahranio ga je","en":"he/it fed him"},{"bs":"hranite","en":"you (all) feed"},{"bs":"hrani","en":"he/it feeds"},{"bs":"hranimo","en":"we feed"}],"ref":"36:47","answerWord":"أَطْعَمَهُۥٓ","answerSound":"audio/72788120b2eab621e7a6.m4a","quranTranslation":{"text":"And when it is said unto them: Spend of that wherewith Allah hath provided you, those who disbelieve say unto those who believe: Shall we feed those whom Allah, if He willed, would feed? Ye are in naught else than error manifest.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nahraniti","en":"to feed"},"passage":["وَإِذَا","قِيلَ","لَهُمْ","أَنفِقُوا۟","مِمَّا","رَزَقَكُمُ","ٱللَّهُ","قَالَ","ٱلَّذِينَ","كَفَرُوا۟","لِلَّذِينَ","ءَامَنُوٓا۟","أَنُطْعِمُ","مَن","لَّوْ","يَشَآءُ","ٱللَّهُ","أَطْعَمَهُۥٓ","إِنْ","أَنتُمْ","إِلَّا","فِى","ضَلَٰلٍ","مُّبِينٍ"],"marked":[17],"facts":{"verb":"أَطْعَمَ"}},{"id":"atama-51-57-8","words":["verb:atama"],"options":[{"bs":"hrane me","en":"they feed me"},{"bs":"biva nahranjen","en":"he/it is fed"},{"bs":"nahranio ga je","en":"he/it fed him"},{"bs":"hranite","en":"you (all) feed"}],"ref":"51:57","answerWord":"يُطْعِمُونِ","answerSound":"audio/b01fbc17364f8f7bb7bd.m4a","quranTranslation":{"text":"I seek no livelihood from them, nor do I ask that they should feed Me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nahraniti","en":"to feed"},"passage":["مَآ","أُرِيدُ","مِنْهُم","مِّن","رِّزْقٍ","وَمَآ","أُرِيدُ","أَن","يُطْعِمُونِ"],"marked":[8],"facts":{"verb":"أَطْعَمَ"}},{"id":"atama-74-44-2","words":["verb:atama"],"options":[{"bs":"hranimo","en":"we feed"},{"bs":"i hrane","en":"and they feed"},{"bs":"hrane me","en":"they feed me"},{"bs":"hrani me","en":"He feeds me"}],"ref":"74:44","answerWord":"نُطْعِمُ","answerSound":"audio/ff617ce0227d8a9d70d1.m4a","quranTranslation":{"text":"Nor did we feed the wretched.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nahraniti","en":"to feed"},"passage":["وَلَمْ","نَكُ","نُطْعِمُ","ٱلْمِسْكِينَ"],"marked":[2],"facts":{"verb":"أَطْعَمَ"}},{"id":"atama-76-8-0","words":["verb:atama"],"options":[{"bs":"i hrane","en":"and they feed"},{"bs":"zar hranimo?","en":"do we feed?"},{"bs":"hrane me","en":"they feed me"},{"bs":"i nahranite!","en":"and (you all) feed!"}],"ref":"76:8","answerWord":"وَيُطْعِمُونَ","answerSound":"audio/49ab75f336191da8e0f2.m4a","quranTranslation":{"text":"And feed with food the needy wretch, the orphan and the prisoner, for love of Him,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nahraniti","en":"to feed"},"passage":["وَيُطْعِمُونَ","ٱلطَّعَامَ","عَلَىٰ","حُبِّهِۦ","مِسْكِينًا","وَيَتِيمًا","وَأَسِيرًا"],"marked":[0],"facts":{"verb":"أَطْعَمَ"}},{"id":"atama-76-9-1","words":["verb:atama"],"options":[{"bs":"hranimo vas","en":"we feed you (all)"},{"bs":"hrane me","en":"they feed me"},{"bs":"zar hranimo?","en":"do we feed?"},{"bs":"i hrane","en":"and they feed"}],"ref":"76:9","answerWord":"نُطْعِمُكُمْ","answerSound":"audio/5146e27fcca1b2e22b58.m4a","quranTranslation":{"text":"(Saying): We feed you, for the sake of Allah only. We wish for no reward nor thanks from you;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nahraniti","en":"to feed"},"passage":["إِنَّمَا","نُطْعِمُكُمْ","لِوَجْهِ","ٱللَّهِ","لَا","نُرِيدُ","مِنكُمْ","جَزَآءً","وَلَا","شُكُورًا"],"marked":[1],"facts":{"verb":"أَطْعَمَ"}},{"id":"atama-106-4-1","words":["verb:atama"],"options":[{"bs":"nahranio ih je","en":"He fed them"},{"bs":"nahranio ga je","en":"he/it fed him"},{"bs":"biva nahranjen","en":"he/it is fed"},{"bs":"hrani me","en":"He feeds me"}],"ref":"106:4","answerWord":"أَطْعَمَهُم","answerSound":"audio/bde3bddf75f4e448c0e6.m4a","quranTranslation":{"text":"Who hath fed them against hunger and hath made them safe from fear.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nahraniti","en":"to feed"},"passage":["ٱلَّذِىٓ","أَطْعَمَهُم","مِّن","جُوعٍ","وَءَامَنَهُم","مِّنْ","خَوْفٍۭ"],"marked":[1],"facts":{"verb":"أَطْعَمَ"}}]