: {"bs": "je povjerovao", "en": "he believed", "tr": "iman etti", "fr": "il a cru", "id": "dia beriman", "ur": "اس نے تصدیق کی", "bn": "সে বিশ্বাস করল", "fa": "تصدیق کرد"}}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "صَلَّىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:105", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3893.mp3", "translation": {"en": {"text": "Thou hast already fulfilled the vision. Lo! thus do We reward the good.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Rüyana gerçekten sadakat gösterdin, şüphesiz ki, biz iyilik yapanları böyle mükafatlandırırız.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک تو نے خواب سچ کردکھایا ہم ایسا ہی صلہ دیتے ہیں نیکوں کو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "sesungguhnya kamu telah membenarkan mimpi itu sesungguhnya demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "صَدَّقْتَ", "hit": true, "audio": "audio/44b2efd41c8d31ca92d2.m4a", "gloss": {"en": "you fulfilled", "bs": "ispunio si", "tr": "yerine getirdin", "fr": "tu as accompli", "id": "kamu telah menepati", "ur": "تم نے تصدیق کی", "bn": "তুমি পূর্ণ করেছ", "fa": "وفا کردی"}}, {"text": "ٱلرُّءْيَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "كَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَجْزِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُحْسِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "56:57", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5036.mp3", "translation": {"en": {"text": "We created you. Will ye then admit the truth?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz sizi yarattık; tasdik etmeniz gerekmez mi?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہم نے تمہیں پیدا کیا تو تم کیوں نہیں سچ مانتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kami telah menciptakan kamu, maka mengapa kamu tidak membenarkan?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "نَحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "خَلَقْنَٰكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلَوْلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُصَدِّقُونَ", "hit": true, "audio": "audio/8d46e2550981af0ec9d5.m4a", "gloss": {"bs": "vjerujete", "en": "you believe", "tr": "iman edersiniz", "fr": "vous croyez", "id": "kamu beriman", "ur": "تم تصدیق کرتے ہو", "bn": "তোমরা বিশ্বাস করো", "fa": "تصدیق می‌کنید"}}]}, {"ref": "70:26", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5401.mp3", "translation": {"en": {"text": "And those who believe in the Day of Judgment,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar ki ceza gününü tasdik ederler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہو جو انصاف کا دن سچ جانتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan orang-orang yang mempercayai hari pembalasan,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُصَدِّقُونَ", "hit": true, "audio": "audio/17696333674b5ed6e3ff.m4a", "gloss": {"en": "they believe", "bs": "vjeruju", "tr": "inanırlar", "fr": "ils croient", "id": "mereka beriman", "ur": "وہ یقین رکھتے ہیں", "bn": "তারা বিশ্বাস করে", "fa": "ایمان می‌آورند"}