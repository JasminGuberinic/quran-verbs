ift", "bn": "একটি উপহারের", "fa": "به هدیه‌ای", "fr": "un cadeau", "id": "dengan hadiah", "tr": "bir hediye ile", "ur": "تحفے کا"}}]}, {"arabic": "أَنْعَمْنَا عَلَى الْفُقَرَاءِ بِالطَّعَامِ", "spoken": "audio/190b179663ad49d039ba.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Darovali smo siromasima hranu.", "en": "We gave food to the poor.", "bn": "আমরা গরিবদের খাবার দিলাম।", "fa": "به فقیران غذا دادیم.", "fr": "Nous avons donné de la nourriture aux pauvres.", "id": "Kami memberi orang miskin makanan.", "tr": "Fakirlere yemek verdik.", "ur": "ہم نے غریبوں کو کھانا دیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَنْعَمْنَا", "target": true, "translation": {"bs": "darovali smo", "en": "we bestowed", "bn": "আমরা অনুগ্রহ করলাম", "fa": "نعمت دادیم", "fr": "nous avons comblé de bienfaits", "id": "kami melimpahkan", "tr": "verdik", "ur": "ہم نے نعمت دی"}}, {"arabic": "عَلَى", "target": false, "translation": {"bs": "—", "en": "on", "bn": "উপর", "fa": "بر", "fr": "sur", "id": "di atas", "tr": "üzerinde", "ur": "پر"}}, {"arabic": "الْفُقَرَاءِ", "target": false, "translation": {"bs": "siromasima", "en": "the poor", "bn": "গরিবরা", "fa": "فقیران", "fr": "les pauvres", "id": "orang miskin", "tr": "fakirler", "ur": "غریبوں"}}, {"arabic": "بِالطَّعَامِ", "target": false, "translation": {"bs": "hranu", "en": "with the food", "bn": "খাবার দিয়ে", "fa": "با غذا", "fr": "de nourriture", "id": "dengan makanan", "tr": "yemek ile", "ur": "کھانے سے"}}]}, {"arabic": "أَنْعَمْتَ عَلَيْنَا بِكَرَمِكَ", "spoken": "audio/c1e9a156ddc4faf61fa3.m4a", "tense": "past", "pronoun": "anta", "translation": {"bs": "Obasuo si nas svojom darežljivošću.", "en": "You were generous to us.", "bn": "তুমি আমাদের প্রতি উদার ছিলে।", "fa": "به ما بخشندگی کردی.", "fr": "Tu as été généreux envers nous.", "id": "Kamu bermurah hati kepada kami.", "tr": "Bize cömert davrandın.", "ur": "تم نے ہم پر سخاوت کی۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَنْعَمْتَ", "target"