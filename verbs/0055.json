edText": "يَتْلُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَتْلُونَ", "plain": "يَتْلُونَ", "quran": false, "notUsed": false, "spoken": "audio/0b9b83ebcaf5d1291fe4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱتْلُ", "plain": "اُتْلُ", "quran": true, "notUsed": false, "spoken": "audio/b89a43d600e5f15ea6b8.m4a", "recited": "audio/c73727fbc2b513b29b91.m4a", "recitedText": "ٱتْلُ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُتْلِي", "plain": "اُتْلِي", "quran": false, "notUsed": false, "spoken": "audio/f0589d3711067c4fb749.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُتْلُوَا", "plain": "اُتْلُوَا", "quran": false, "notUsed": false, "spoken": "audio/1e5bce29cf78e3023282.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُتْلُوا", "plain": "اُتْلُوا", "quran": false, "notUsed": false, "spoken": "audio/0e238cc2cdf89efcdab8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُتْلُونَ", "plain": "اُتْلُونَ", "quran": false, "notUsed": false, "spoken": "audio/0623e1c3acc4cc27575d.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "98:2", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6132.mp3", "translation": {"en": {"text": "A messenger from Allah, reading purified pages", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Bu delil), tertemiz sayfaları okuyan, Allah tarafından gönderilmiş bir peygamberdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ کون وہ اللہ کا رسول کہ پاک صحیفے پڑھتا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yaitu) seorang Rasul dari Allah (Muhammad) yang membacakan lembaran-lembaran yang disucikan (Al Quran),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رَسُولٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتْلُوا۟", "hit": true, "audio": "audio/0ec96633f2f798ac79f7.m4a", "gloss": {"bs": "uči", "en": "he recites", "tr": "okur", "fr": "il récite", "id": "dia membaca", "ur": "وہ تلاوت کرتا ہے", "bn": "সে তিলাওয়াত করে", "fa": "می‌خواند"}}, {"text": "صُحُفًا", "hit": false, "audio": null, "gloss": null}, {"text": "مُّطَهَّرَةً", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:69", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3001.mp3", "translation": {"en": {"text": "Recite unto them the story of Abraham:", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Resulüm!) onlara İbrahim'in kıssasını da naklet.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان پر پڑھو خبر ابراہیم کی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan bacakanlah kepada mereka kisah Ibrahim.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱتْلُ", "hit": true, "audio": "audio/21a2235090487cedeeb9.m4a", "gloss": {"bs": "i kazuj!", "en": "and recite!", "tr": "ve oku!", "fr": "et récite !", "id": "dan bacalah!", "ur": "اور تلاوت کرو!", "bn": "এবং তিলাওয়াত করো!", "fa": "و بخوان!"}}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَبَأَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِبْرَٰهِيمَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:58", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/351.mp3", "translation": {"en": {"text": "This (which) We recite unto thee is a revelation and a wise reminder.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte bu sana okuduğumuz, âyetlerden ve hikmetli Kur'ân'dandır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یہ ہم تم پر پڑھتے ہیں کچھ آیتیں اور حکمت والی نصیحت،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Demikianlah (kisah Isa), Kami membacakannya kepada kamu sebagian dari bukti-bukti (kerasulannya) dan (membacakan) Al Quran yang penuh hikmah.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَتْلُوهُ", "hit": true, "audio": "audio/3c13349b046396e92a94.m4a", "gloss": {"en": "we recite it", "bs": "učimo ga", "tr": "onu okuruz", "fr": "nous le récitons", "id": "kami membacanya", "ur": "ہم اسے تلاوت کرتے ہیں", "bn": "আমরা তা পাঠ করি", "fa": "آن را تلاوت می‌کنیم"}}, {"text": "عَلَيْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْءَايَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلذِّكْرِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَكِيمِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:83", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2223.mp3", "translation": {"en": {"text": "They will ask thee of Dhu'l-Qarneyn. Say: I shall recite unto you a remembrance of him.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bir de sana Zülkarneyn'den soruyorlar. De ki: Size ondan bir hatıra okuyacağım.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور تم سے ذوالقرنین کو پوچھتے ہیں تم فرماؤ میں تمہیں اس کا مذکور پڑھ کر سناتا ہوں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka akan bertanya kepadamu (Muhammad) tentang Dzulkarnain. Katakanlah: \"Aku akan bacakan kepadamu cerita tantangnya\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَسْـَٔلُونَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَن", "hit": false, "audio": null, "gloss": null}, {"text": "ذِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَرْنَيْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "سَأَتْلُوا۟", "hit": true, "audio": "audio/df6b3740703e07800b04.m4a", "gloss": {"en": "I will recite", "bs": "učit ću", "tr": "okuyacağım", "fr": "je réciterai", "id": "aku akan membaca", "ur": "میں تلاوت کروں گا", "bn": "আমি পাঠ করব", "fa": "تلاوت خواهم کرد"}}, {"text": "عَلَيْكُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ذِكْرًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:44", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/51.mp3", "translation": {"en": {"text": "Enjoin ye righteousness upon mankind while ye yourselves forget (to practise it)? And ye are readers of the Scripture! Have ye then no sense?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İnsanlara iyiliği emreder de kendinizi unutur musunuz? Halbuki kitab (Tevrat)ı okuyorsunuz. Hâlâ aklınızı başınıza almayacak mısınız?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا لوگوں کو بھلائی کا حکم دیتے ہو اور اپنی جانوں کو بھولتے ہو حالانکہ تم کتاب پڑھتے ہو تو کیا تمہیں عقل نہیں -", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mengapa kamu suruh orang lain (mengerjakan) kebaktian, sedang kamu melupakan diri (kewajiban)mu sendiri, padahal kamu membaca Al Kitab (Taurat)? Maka tidaklah kamu berpikir?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَتَأْمُرُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلنَّاسَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْبِرِّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَنسَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنفُسَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَتْلُونَ", "hit": true, "audio": "audio/270236733326db4beee1.m4a", "gloss": {"en": "you (all) recite", "bs": "učite", "tr": "okursunuz", "fr": "vous récitez", "id": "kalian membaca", "ur": "تم سب تلاوت کرتے ہو", "bn": "তোমরা পাঠ কর", "fa": "تلاوت می‌کنید"}}, {"text": "ٱلْكِتَٰبَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَفَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْقِلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "91:2", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6045.mp3", "translation": {"en": {"text": "And the moon when she followeth him,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Güneş'in ardından gelen Ay'a,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور چاند کی جب اس کے پیچھے آئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan bulan apabila mengiringinya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلْقَمَرِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَلَىٰهَا", "hit": true, "audio": "audio/05d6f012b1a4c2770891.m4a", "gloss": {"bs": "(kad) ga slijedi", "en": "(when) it follows it", "tr": "(ona) uyduğunda", "fr": "(lorsqu')elle la suit", "id": "(ketika) mengikutinya", "ur": "(جب) وہ اس کے پیچھے آئے", "bn": "(যখন) তা তার অনুসরণ করে", "fa": "(وقتی) از پی آن آید"}}]}], "forms": [{"arabic": "تُتْلَىٰ", "count": 16, "first": "3:101", "audio": "