{"rank": 429, "root": "قرض", "form": 4, "lemma": "أَقْرَضَ", "count": 6, "ayahCount": 6, "share": 0.03, "meaning": {"bs": "posuditi (dati zajam)", "en": "to lend", "tr": "ödünç vermek", "fr": "prêter", "id": "meminjamkan", "ur": "قرض دینا", "bn": "ধার দেওয়া", "fa": "قرض دادن"}, "lemmaSpoken": "audio/5d5c244cc1fac59f7698.m4a", "animation": "<svg class=\"va va-vqrd_4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes vqrd_4-0{from{transform:none}30%{transform:translate(18px,0)}70%{transform:translate(18px,0)}}.va-vqrd_4 .a .ra{transform:rotate(-90deg)}.va-vqrd_4 .b .ra{transform:rotate(-90deg)}.va-vqrd_4 .cn{animation:vqrd_4-0 3s ease-in-out both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-vqrd_4.off,.va-vqrd_4.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-vqrd_4,.va-vqrd_4 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><g class=\"a\"><g transform=\"translate(36 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g></g><g class=\"b\"><g transform=\"matrix(-1 0 0 1 168 0)\"><g transform=\"translate(84 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=