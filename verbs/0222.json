o": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّمِيعُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَلِيمُ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "لِتَسْكُنُوا۟", "count": 3, "first": "10:67", "audio": "audio/ff360c93fb66a26ab8d1.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "so that you (all) may rest", "bs": "da se odmarate", "tr": "dinlenesiniz diye", "fr": "que vous vous reposiez", "id": "agar kalian beristirahat", "ur": "تاکہ تم سب آرام پاؤ", "bn": "যাতে তোমরা বিশ্রাম কর", "fa": "تا آرام گیرید"}}, {"arabic": "ٱسْكُنْ", "count": 2, "first": "2:35", "audio": "audio/4f928addf2aff84d4136.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "dwell!", "bs": "stanuj!", "tr": "yerleş!", "fr": "demeure !", "id": "tinggallah!", "ur": "ٹھہرو!", "bn": "বসবাস কর!", "fa": "سکونت کن!"}}, {"arabic": "ٱسْكُنُوا۟", "count": 2, "first": "7:161", "audio": "audio/16756d9f642e5dcec57f.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "(you all) dwell!", "bs": "stanujte!", "tr": "yerleşin!", "fr": "demeurez !", "id": "tinggallah kalian!", "ur": "تم سب ٹھہرو!", "bn": "বসবাস কর!", "fa": "سکونت کنید!"}}, {"arabic": "سَكَنَ", "count": 1, "first": "6:13", "audio": "audio/bee3af43ad9112f31ffa.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "miruje", "en": "dwells", "tr": "huzur bulur", "fr": "demeure", "id": "tinggal", "ur": "ٹھہرتا ہے", "bn": "বসবাস করে", "fa": "آرام دارد"}}, {"arabic": "لِيَسْكُنَ", "count": 1, "first": "7:189", "audio": "audio/343d4bdc0b14cc1389dd.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "so that he/it may find rest"