{"rank": 33, "root": "ذكر", "form": 1, "lemma": "ذَكَرَ", "count": 84, "ayahCount": 79, "share": 0.43, "meaning": {"bs": "sjećati se, spominjati", "en": "to remember, to mention", "tr": "hatırlamak, anmak", "fr": "se souvenir, mentionner", "id": "mengingat, menyebut", "ur": "یاد کرنا، ذکر کرنا", "bn": "স্মরণ করা, উল্লেখ করা", "fa": "یاد کردن، به یاد آوردن"}, "lemmaSpoken": "audio/c4dfaf8c107b33569ce5.m4a", "animation": "<svg class=\"va va-vdhkr_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes vdhkr_1-0{from{opacity:0}}@keyframes vdhkr_1-1{from{transform:rotate(0deg)}}.va-vdhkr_1 .bb{animation:vdhkr_1-0 0.5s ease-out both}.va-vdhkr_1 .rb{animation:vdhkr_1-0 0.6s ease-out 1s both}.va-vdhkr_1 .ra{transform:rotate(-160deg);animation:vdhkr_1-1 0.6s ease-in-out 0.3s both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-vdhkr_1.off,.va-vdhkr_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-vdhkr_1,.va-vdhkr_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><g transform=\"translate(46 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g><g class=\"bb\"><circle class=\"p\" cx=\"70\" cy=\"12\" r=\"7\"/><circle class=\"q\" cx=\"65.8\" cy=\"22.0\" r=\"1.6\"/><circle class=\"q\" cx=\"63.0\" cy=\"26.0\" r=\"1\"/></g><circle class=\"q rb\" cx=\"70\" cy=\"12\" r=\"3.6\"/></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "ذَكَرَ", "plain": "ذَكَرَ", "quran": true, "notUsed": false, "spoken": "audio/c4dfaf8c107b33569ce5.m4a", "recited": "audio/72fb10925018dbeeb67e.m4a", "recitedText": "وَذَكَرَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَذْكُرُ", "plain": "يَذْكُرُ", "quran": true, "notUsed": false, "spoken": "audio/5aa41882aed495608260.m4a", "recited": "audio/8892d7ae4c863001931e.m4a", "recitedText": "يَذْكُرُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱذْكُرْ", "plain": "اُذْكُرْ", "quran": true, "notUsed": false, "spoken": "audio/cb79459c7c56d12ab150.m4a", "recited": "audio/af1c30c4ce0bd7a133b3.m4a", "recitedText": "ٱذْكُرْ"}], "nouns": {"verbal_noun": {"lemma": "ذِكْر", "count": 76, "spoken": "audio/9a9948cbb6fdde80646b.m4a"}, "participle": {"lemma": "ذاكِر", "count": 2, "spoken": "audio/94b230d302ef4a86bf82.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "ذَكَرْتُ", "plain": "ذَكَرْتُ", "quran": false, "notUsed": false, "spoken": "audio/bd490174860fe90559c5.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "ذَكَرْنَا", "plain": "ذَكَرْنَا", "quran": false, "notUsed": false, "spoken": "audio/7ab3166093ba31974766.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "ذَكَرْتَ", "plain": "ذَكَرْتَ", "quran": true, "notUsed": false, "spoken": "audio/82b32348ac3772b5ba58.m4a", "recited": "audio/9aff4193f2d41dcd67f2.m4a", "recitedText": "ذَكَرْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "ذَكَرْتِ", "plain": "ذَكَرْتِ", "quran": false, "notUsed": false, "spoken": "audio/669b92e67e1de1bb3fe2.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "ذَكَرْتُمَا", "plain": "ذَكَرْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/ae0b11ac48fbbebda706.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "ذَكَرْتُمْ", "plain": "ذَكَرْتُمْ", "quran": false, "notUsed": false, "spoken": "audio/ea8809fb6a1ca1d3ef9f.m4a", "recited": nu