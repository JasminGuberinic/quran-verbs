[{"id":"aslaha-5-39-5","words":["verb:aslaha"],"options":[{"bs":"i popravio je","en":"and he/it reformed"},{"bs":"i popravili su se","en":"and they reformed"},{"bs":"popravlja","en":"he/it reforms"},{"bs":"popravljaju","en":"they reform"}],"ref":"5:39","answerWord":"وَأَصْلَحَ","answerSound":"audio/813e7f36860a048f2eaa.m4a","quranTranslation":{"text":"But whoso repenteth after his wrongdoing and amendeth, lo! Allah will relent toward him. Lo! Allah is Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["فَمَن","تَابَ","مِنۢ","بَعْدِ","ظُلْمِهِۦ","وَأَصْلَحَ","فَإِنَّ","ٱللَّهَ","يَتُوبُ","عَلَيْهِ","إِنَّ","ٱللَّهَ","غَفُورٌ","رَّحِيمٌ"],"marked":[5],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-2-160-3","words":["verb:aslaha"],"options":[{"bs":"i popravili su se","en":"and they reformed"},{"bs":"i popravit će","en":"and He will set right"},{"bs":"i popravite!","en":"and (you all) reform!"},{"bs":"pa je pomirio","en":"so he/it made peace"}],"ref":"2:160","answerWord":"وَأَصْلَحُوا۟","answerSound":"audio/d800b92a13087aa4ea43.m4a","quranTranslation":{"text":"Except those who repent and amend and make manifest (the truth). These it is toward whom I relent. I am the Relenting, the Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["إِلَّا","ٱلَّذِينَ","تَابُوا۟","وَأَصْلَحُوا۟","وَبَيَّنُوا۟","فَأُو۟لَٰٓئِكَ","أَتُوبُ","عَلَيْهِمْ","وَأَنَا","ٱلتَّوَّابُ","ٱلرَّحِيمُ"],"marked":[3],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-49-10-3","words":["verb:aslaha"],"options":[{"bs":"pa pomirite","en":"so make peace"},{"bs":"i popravio je","en":"and he/it reformed"},{"bs":"i popravili smo","en":"and we set right"},{"bs":"popravljaju","en":"they reform"}],"ref":"49:10","answerWord":"فَأَصْلِحُوا۟","answerSound":"audio/7c47a9193b6f357cda3c.m4a","quranTranslation":{"text":"The believers are naught else than brothers. Therefore make peace between your brethren and observe your duty to Allah that haply ye may obtain mercy.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["إِنَّمَا","ٱلْمُؤْمِنُونَ","إِخْوَةٌ","فَأَصْلِحُوا۟","بَيْنَ","أَخَوَيْكُمْ","وَٱتَّقُوا۟","ٱللَّهَ","لَعَلَّكُمْ","تُرْحَمُونَ"],"marked":[3],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-7-142-18","words":["verb:aslaha"],"options":[{"bs":"i popravi!","en":"and reform!"},{"bs":"i popravili su","en":"and they (two) reformed"},{"bs":"nagode se","en":"they (two) make peace"},{"bs":"i mirite","en":"and you (all) make peace"}],"ref":"7:142","answerWord":"وَأَصْلِحْ","answerSound":"audio/195e5d0f533a7b562e05.m4a","quranTranslation":{"text":"And when We did appoint for Moses thirty nights (of solitude), and added to them ten, and he completed the whole time appointed by his Lord of forty nights; and Moses said unto his brother, Aaron: Take my place among the people. Do right, and follow not the way of mischief-makers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["وَوَٰعَدْنَا","مُوسَىٰ","ثَلَٰثِينَ","لَيْلَةً","وَأَتْمَمْنَٰهَا","بِعَشْرٍ","فَتَمَّ","مِيقَٰتُ","رَبِّهِۦٓ","أَرْبَعِينَ","لَيْلَةً","وَقَالَ","مُوسَىٰ","لِأَخِيهِ","هَٰرُونَ","ٱخْلُفْنِى","فِى","قَوْمِى","وَأَصْلِحْ","وَلَا","تَتَّبِعْ","سَبِيلَ","ٱلْمُفْسِدِينَ"],"marked":[18],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-26-152-5","words":["verb:aslaha"],"options":[{"bs":"popravljaju","en":"they reform"},{"bs":"pa je pomirio","en":"so he/it made peace"},{"bs":"i popravili su","en":"and they (two) reformed"},{"bs":"i popravi!","en":"and reform!"}],"ref":"26:152","answerWord":"يُصْلِحُونَ","answerSound":"audio/c605b921fc0ca1bdf528.m4a","quranTranslation":{"text":"Who spread corruption in the earth, and reform not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["ٱلَّذِينَ","يُفْسِدُونَ","فِى","ٱلْأَرْضِ","وَلَا","يُصْلِحُونَ"],"marked":[5],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-2-182-7","words":["verb:aslaha"],"options":[{"bs":"pa je pomirio","en":"so he/it made peace"},{"bs":"i popravite!","en":"and (you all) reform!"},{"bs":"popravljate","en":"you (all) reform"},{"bs":"nagode se","en":"they (two) make peace"}],"ref":"2:182","answerWord":"فَأَصْلَحَ","answerSound":"audio/f338c45e686e54798a76.m4a","quranTranslation":{"text":"But he who feareth from a testator some unjust or sinful clause, and maketh peace between the parties, (it shall be) no sin for him. Lo! Allah is Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["فَمَنْ","خَافَ","مِن","مُّوصٍ","جَنَفًا","أَوْ","إِثْمًا","فَأَصْلَحَ","بَيْنَهُمْ","فَلَآ","إِثْمَ","عَلَيْهِ","إِنَّ","ٱللَّهَ","غَفُورٌ","رَّحِيمٌ"],"marked":[7],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-2-224-8","words":["verb:aslaha"],"options":[{"bs":"i mirite","en":"and you (all) make peace"},{"bs":"nagode se","en":"they (two) make peace"},{"bs":"i popravili su se","en":"and they reformed"},{"bs":"i popravili su","en":"and they (two) reformed"}],"ref":"2:224","answerWord":"وَتُصْلِحُوا۟","answerSound":"audio/f22d42a5eccbc0d6e6a5.m4a","quranTranslation":{"text":"And make not Allah, by your oaths, a hindrance to your being righteous and observing your duty unto Him and making peace among mankind. Allah is Hearer, Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["وَلَا","تَجْعَلُوا۟","ٱللَّهَ","عُرْضَةً","لِّأَيْمَٰنِكُمْ","أَن","تَبَرُّوا۟","وَتَتَّقُوا۟","وَتُصْلِحُوا۟","بَيْنَ","ٱلنَّاسِ","وَٱللَّهُ","سَمِيعٌ","عَلِيمٌ"],"marked":[8],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-4-16-6","words":["verb:aslaha"],"options":[{"bs":"i popravili su","en":"and they (two) reformed"},{"bs":"i popravit će","en":"and He will set right"},{"bs":"i popravili smo","en":"and we set right"},{"bs":"popravljate","en":"you (all) reform"}],"ref":"4:16","answerWord":"وَأَصْلَحَا","answerSound":"audio/8586f94896702f93ff4f.m4a","quranTranslation":{"text":"And as for the two of you who are guilty thereof, punish them both. And if they repent and improve, then let them be. Lo! Allah is ever relenting, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["وَٱلَّذَانِ","يَأْتِيَٰنِهَا","مِنكُمْ","فَـَٔاذُوهُمَا","فَإِن","تَابَا","وَأَصْلَحَا","فَأَعْرِضُوا۟","عَنْهُمَآ","إِنَّ","ٱللَّهَ","كَانَ","تَوَّابًا","رَّحِيمًا"],"marked":[6],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-4-129-15","words":["verb:aslaha"],"options":[{"bs":"popravljate","en":"you (all) reform"},{"bs":"i popravite!","en":"and (you all) reform!"},{"bs":"i popravili smo","en":"and we set right"},{"bs":"popravljaju","en":"they reform"}],"ref":"4:129","answerWord":"تُصْلِحُوا۟","answerSound":"audio/1be084618ebdc3885992.m4a","quranTranslation":{"text":"Ye will not be able to deal equally between (your) wives, however much ye wish (to do so). But turn not altogether away (from one), leaving her as in suspense. If ye do good and keep from evil, lo! Allah is ever Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["وَلَن","تَسْتَطِيعُوٓا۟","أَن","تَعْدِلُوا۟","بَيْنَ","ٱلنِّسَآءِ","وَلَوْ","حَرَصْتُمْ","فَلَا","تَمِيلُوا۟","كُلَّ","ٱلْمَيْلِ","فَتَذَرُوهَا","كَٱلْمُعَلَّقَةِ","وَإِن","تُصْلِحُوا۟","وَتَتَّقُوا۟","فَإِنَّ","ٱللَّهَ","كَانَ","غَفُورًا","رَّحِيمًا"],"marked":[15],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-8-1-9","words":["verb:aslaha"],"options":[{"bs":"i popravite!","en":"and (you all) reform!"},{"bs":"nagode se","en":"they (two) make peace"},{"bs":"i popravili su","en":"and they (two) reformed"},{"bs":"i popravili smo","en":"and we set right"}],"ref":"8:1","answerWord":"وَأَصْلِحُوا۟","answerSound":"audio/d3265fb022f34da24c6e.m4a","quranTranslation":{"text":"They ask thee (O Muhammad) of the spoils of war. Say: The spoils of war belong to Allah and the messenger, so keep your duty to Allah, and adjust the matter of your difference, and obey Allah and His messenger, if ye are (true) believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["يَسْـَٔلُونَكَ","عَنِ","ٱلْأَنفَالِ","قُلِ","ٱلْأَنفَالُ","لِلَّهِ","وَٱلرَّسُولِ","فَٱتَّقُوا۟","ٱللَّهَ","وَأَصْلِحُوا۟","ذَاتَ","بَيْنِكُمْ","وَأَطِيعُوا۟","ٱللَّهَ","وَرَسُولَهُۥٓ","إِن","كُنتُم","مُّؤْمِنِينَ"],"marked":[9],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-10-81-14","words":["verb:aslaha"],"options":[{"bs":"popravlja","en":"he/it reforms"},{"bs":"i popravite!","en":"and (you all) reform!"},{"bs":"popravljaju","en":"they reform"},{"bs":"i popravili su se","en":"and they reformed"}],"ref":"10:81","answerWord":"يُصْلِحُ","answerSound":"audio/49a6f644e4ac82b57679.m4a","quranTranslation":{"text":"And when they had cast, Moses said: That which ye have brought is magic. Lo! Allah will make it vain. Lo! Allah upholdeth not the work of mischief-makers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["فَلَمَّآ","أَلْقَوْا۟","قَالَ","مُوسَىٰ","مَا","جِئْتُم","بِهِ","ٱلسِّحْرُ","إِنَّ","ٱللَّهَ","سَيُبْطِلُهُۥٓ","إِنَّ","ٱللَّهَ","لَا","يُصْلِحُ","عَمَلَ","ٱلْمُفْسِدِينَ"],"marked":[14],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-16-119-12","words":["verb:aslaha"],"options":[{"bs":"i popravili su","en":"and they reformed"},{"bs":"nagode se","en":"they (two) make peace"},{"bs":"i popravili smo","en":"and we set right"},{"bs":"pa pomirite","en":"so make peace"}],"ref":"16:119","answerWord":"وَأَصْلَحُوٓا۟","answerSound":"audio/7874ab18956d03fcd8df.m4a","quranTranslation":{"text":"Then lo! thy Lord - for those who do evil in ignorance and afterward repent and amend - lo! (for them) thy Lord is afterward indeed Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["ثُمَّ","إِنَّ","رَبَّكَ","لِلَّذِينَ","عَمِلُوا۟","ٱلسُّوٓءَ","بِجَهَٰلَةٍ","ثُمَّ","تَابُوا۟","مِنۢ","بَعْدِ","ذَٰلِكَ","وَأَصْلَحُوٓا۟","إِنَّ","رَبَّكَ","مِنۢ","بَعْدِهَا","لَغَفُورٌ","رَّحِيمٌ"],"marked":[12],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-21-90-5","words":["verb:aslaha"],"options":[{"bs":"i popravili smo","en":"and we set right"},{"bs":"i popravili su","en":"and they reformed"},{"bs":"i popravi!","en":"and reform!"},{"bs":"popravljaju","en":"they reform"}],"ref":"21:90","answerWord":"وَأَصْلَحْنَا","answerSound":"audio/d6f3071a757eb2fb97ad.m4a","quranTranslation":{"text":"Then We heard his prayer, and bestowed upon him John, and adjusted his wife (to bear a child) for him. Lo! they used to vie one with the other in good deeds, and they cried unto Us in longing and in fear, and were submissive unto Us.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["فَٱسْتَجَبْنَا","لَهُۥ","وَوَهَبْنَا","لَهُۥ","يَحْيَىٰ","وَأَصْلَحْنَا","لَهُۥ","زَوْجَهُۥٓ","إِنَّهُمْ","كَانُوا۟","يُسَٰرِعُونَ","فِى","ٱلْخَيْرَٰتِ","وَيَدْعُونَنَا","رَغَبًا","وَرَهَبًا","وَكَانُوا۟","لَنَا","خَٰشِعِينَ"],"marked":[5],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-33-71-0","words":["verb:aslaha"],"options":[{"bs":"popravlja","en":"he/it reforms"},{"bs":"i popravi!","en":"and reform!"},{"bs":"i popravili su se","en":"and they reformed"},{"bs":"i popravio je","en":"and he/it reformed"}],"ref":"33:71","answerWord":"يُصْلِحْ","answerSound":"audio/3af89597a01885a0596d.m4a","quranTranslation":{"text":"He will adjust your works for you and will forgive you your sins. Whosoever obeyeth Allah and His messenger, he verily hath gained a signal victory.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["يُصْلِحْ","لَكُمْ","أَعْمَٰلَكُمْ","وَيَغْفِرْ","لَكُمْ","ذُنُوبَكُمْ","وَمَن","يُطِعِ","ٱللَّهَ","وَرَسُولَهُۥ","فَقَدْ","فَازَ","فَوْزًا","عَظِيمًا"],"marked":[0],"facts":{"verb":"أَصْلَحَ"}},{"id":"aslaha-47-5-1","words":["verb:aslaha"],"options":[{"bs":"i popravit će","en":"and He will set right"},{"bs":"i popravio je","en":"and he/it reformed"},{"bs":"i popravi!","en":"and reform!"},{"bs":"popravljaju","en":"they reform"}],"ref":"47:5","answerWord":"وَيُصْلِحُ","answerSound":"audio/5f803a2558a81920777d.m4a","quranTranslation":{"text":"He will guide them and improve their state,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"popraviti, učiniti dobrim","en":"to reform, to set right"},"passage":["سَيَهْدِيهِمْ","وَيُصْلِحُ","بَالَهُمْ"],"marked":[1],"facts":{"verb":"أَصْلَحَ"}},{"id":"amata-2-28-7","words":["verb:amata"],"options":[{"bs":"usmrćuje vas","en":"he/it causes you (all) to die"},{"bs":"i usmrćujem","en":"and I cause to die"},{"bs":"usmrtio je","en":"he/it caused to die"},{"bs":"usmrćuje me","en":"He causes me to die"}],"ref":"2:28","answerWord":"يُمِيتُكُمْ","answerSound":"audio/0bed6d5491693832d8b2.m4a","quranTranslation":{"text":"How disbelieve ye in Allah when ye were dead and He gave life to you! Then He will give you death, then life again, and then unto Him ye will return.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"usmrtiti","en":"to cause to die"},"passage":["كَيْفَ","تَكْفُرُونَ","بِٱللَّهِ","وَكُنتُمْ","أَمْوَٰتًا","فَأَحْيَٰكُمْ","ثُمَّ","يُمِيتُكُمْ","ثُمَّ","يُحْيِيكُمْ","ثُمَّ","إِلَيْهِ","تُرْجَعُونَ"],"marked":[7],"facts":{"verb":"أَماتَ"}},{"id":"amata-15-23-3","words":["verb:amata"],"options":[{"bs":"i usmrćujemo","en":"and we cause to die"},{"bs":"pa ga je usmrtio","en":"so he/it caused him to die"},{"bs":"usmrtio je","en":"he/it caused to die"},{"bs":"i usmrćujem","en":"and I cause to die"}],"ref":"15:23","answerWord":"وَنُمِيتُ","answerSound":"audio/edd602de07bc1ad81166.m4a","quranTranslation":{"text":"Lo! and it is We, even We, Who quicken and give death, and We are the Inheritor.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"usmrtiti","en":"to cause to die"},"passage":["وَإِنَّا","لَنَحْنُ","نُحْىِۦ","وَنُمِيتُ","وَنَحْنُ","ٱلْوَٰرِثُونَ"],"marked":[3],"facts":{"verb":"أَماتَ"}},{"id":"amata-26-81-1","words":["verb:amata"],"options":[{"bs":"usmrćuje me","en":"He causes me to die"},{"bs":"usmrćuje vas","en":"he/it causes you (all) to die"},{"bs":"pa ga je usmrtio","en":"so he/it caused him to die"},{"bs":"i usmrćujem","en":"and I cause to die"}],"ref":"26:81","answerWord":"يُمِيتُنِى","answerSound":"audio/be79b4758e7364281942.m4a","quranTranslation":{"text":"And Who causeth me to die, then giveth me life (again),","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"usmrtiti","en":"to cause to die"},"passage":["وَٱلَّذِى","يُمِيتُنِى","ثُمَّ","يُحْيِينِ"],"marked":[1],"facts":{"verb":"أَماتَ"}},{"id":"amata-40-11-2","words":["verb:amata"],"options":[{"bs":"usmrtio si nas","en":"you caused us to die"},{"bs":"pa ga je usmrtio","en":"so he/it caused him to die"},{"bs":"usmrćuje vas","en":"he/it causes you (all) to die"},{"bs":"i usmrćujemo","en":"and we cause to die"}],"ref":"40:11","answerWord":"أَمَتَّنَا","answerSound":"audio/0672f380dd6c3d80bd76.m4a","quranTranslation":{"text":"They say: Our Lord! Twice hast Thou made us die, and twice hast Thou made us live. Now we confess our sins. Is there any way to go out?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"usmrtiti","en":"to cause to die"},"passage":["قَالُوا۟","رَبَّنَآ","أَمَتَّنَا","ٱثْنَتَيْنِ","وَأَحْيَيْتَنَا","ٱثْنَتَيْنِ","فَٱعْتَرَفْنَا","بِذُنُوبِنَا","فَهَلْ","إِلَىٰ","خُرُوجٍ","مِّن","سَبِيلٍ"],"marked":[2],"facts":{"verb":"أَماتَ"}},{"id":"amata-53-44-2","words":["verb:amata"],"options":[{"bs":"usmrtio je","en":"he/it caused to die"},{"bs":"pa ga je usmrtio","en":"so he/it caused him to die"},{"bs":"usmrćuje me","en":"He causes me to die"},{"bs":"usmrćuje vas","en":"he/it causes you (all) to die"}],"ref":"53:44","answerWord":"أَمَاتَ","answerSound":"audio/da62bf0bca64d1c44010.m4a","quranTranslation":{"text":"And that He it is Who giveth death and giveth life;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"usmrtiti","en":"to cause to die"},"passage":["وَأَنَّهُۥ","هُوَ","أَمَاتَ","وَأَحْيَا"],"marked":[2],"facts":{"verb":"أَماتَ"}},{"id":"amata-80-21-1","words":["verb:amata"],"options":[{"bs":"usmrtio ga je","en":"He caused him to die"},{"bs":"i usmrćuje","en":"and he/it causes to die"},{"bs":"i usmrćujemo","en":"and we cause to die"},{"bs":"usmrćuje vas","en":"he/it causes you (all) to die"}],"ref":"80:21","answerWord":"أَمَاتَهُۥ","answerSound":"audio/fc39abfe7d8885511e4f.m4a","quranTranslation":{"text":"Then causeth him to die, and burieth him;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"usmrtiti","en":"to cause to die"},"passage":["ثُمَّ","أَمَاتَهُۥ","فَأَقْبَرَهُۥ"],"marked":[1],"facts":{"verb":"أَماتَ"}},{"id":"halla-39-40-4","words":["verb:halla"],"options":[{"bs":"i spusti se","en":"and [it] descends"},{"bs":"dozvoljeni su","en":"they are lawful"},{"bs":"odriješili ste","en":"you (all) untied"},{"bs":"i odriješi","en":"and untie"}],"ref":"39:40","answerWord":"وَيَحِلُّ","answerSound":"audio/f0ab709393fa5ab99a64.m4a","quranTranslation":{"text":"Who it is unto whom cometh a doom that will abase him, and on whom there falleth everlasting doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nastupiti, sići; biti dozvoljen; odriješiti","en":"to alight, to befall; to be lawful; to untie"},"passage":["مَن","يَأْتِيهِ","عَذَابٌ","يُخْزِيهِ","وَيَحِلُّ","عَلَيْهِ","عَذَابٌ","مُّقِيمٌ"],"marked":[4],"facts":{"verb":"حَلَّ"}},{"id":"halla-20-27-0","words":["verb:halla"],"options":[{"bs":"i odriješi","en":"and untie"},{"bs":"odriješili ste","en":"you (all) untied"},{"bs":"silazi","en":"he/it alights"},{"bs":"dozvoljeni su","en":"they are lawful"}],"ref":"20:27","answerWord":"وَٱحْلُلْ","answerSound":"audio/8270ffed857585f2c297.m4a","quranTranslation":{"text":"And loose a knot from my tongue,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nastupiti, sići; biti dozvoljen; odriješiti","en":"to alight, to befall; to be lawful; to untie"},"passage":["وَٱحْلُلْ","عُقْدَةً","مِّن","لِّسَانِى"],"marked":[0],"facts":{"verb":"حَلَّ"}},{"id":"halla-20-81-12","words":["verb:halla"],"options":[{"bs":"silazi","en":"he/it alights"},{"bs":"dozvoljeni su","en":"they are lawful"},{"bs":"i odriješi","en":"and untie"},{"bs":"odriješili ste","en":"you (all) untied"}],"ref":"20:81","answerWord":"يَحْلِلْ","answerSound":"audio/de25cde9d08b2366cdc8.m4a","quranTranslation":{"text":"(Saying): Eat of the good things wherewith We have provided you, and transgress not in respect thereof lest My wrath come upon you: and he on whom My wrath cometh, he is lost indeed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nastupiti, sići; biti dozvoljen; odriješiti","en":"to alight, to befall; to be lawful; to untie"},"passage":["كُلُوا۟","مِن","طَيِّبَٰتِ","مَا","رَزَقْنَٰكُمْ","وَلَا","تَطْغَوْا۟","فِيهِ","فَيَحِلَّ","عَلَيْكُمْ","غَضَبِى","وَمَن","يَحْلِلْ","عَلَيْهِ","غَضَبِى","فَقَدْ","هَوَىٰ"],"marked":[12],"facts":{"verb":"حَلَّ"}},{"id":"halla-20-86-19","words":["verb:halla"],"options":[{"bs":"silazi","en":"he/it alights"},{"bs":"i odriješi","en":"and untie"},{"bs":"odriješili ste","en":"you (all) untied"},{"bs":"dozvoljeni su","en":"they are lawful"}],"ref":"20:86","answerWord":"يَحِلَّ","answerSound":"audio/6e9f59497869a0c55277.m4a","quranTranslation":{"text":"Then Moses went back unto his folk, angry and sad. He said: O my people! Hath not your Lord promised you a fair promise? Did the time appointed then appear too long for you, or did ye wish that wrath from your Lord should come upon you, that ye broke tryst with me?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"nastupiti, sići; biti dozvoljen; odriješiti","en":"to alight, to befall; to be lawful; to untie"},"passage":["فَرَجَعَ","مُوسَىٰٓ","إِلَىٰ","قَوْمِهِۦ","غَضْبَٰنَ","أَسِفًا","قَالَ","يَٰقَوْمِ","أَلَمْ","يَعِدْكُمْ","رَبُّكُمْ","وَعْدًا","حَسَنًا","أَفَطَالَ","عَلَيْكُمُ","ٱلْعَهْدُ","أَمْ","أَرَدتُّمْ","أَن","يَحِلَّ","عَلَيْكُمْ","غَضَبٌ","مِّن","رَّبِّكُمْ","فَأَخْلَفْتُم","مَّوْعِدِى"],"marked":[19],"facts":{"verb":"حَلَّ"}},{"id":"istadhana-9-44-1","words":["verb:istadhana"],"options":[{"bs":"traži ti dozvolu","en":"he/it asks you permission"},{"bs":"tražio je dozvolu","en":"he/it asked permission"},{"bs":"neka vam zatraži dozvolu","en":"let him ask you (all) permission"},{"bs":"tražio ti je dozvolu","en":"he/it asked you permission"}],"ref":"9:44","answerWord":"يَسْتَـْٔذِنُكَ","answerSound":"audio/eb33bb47d19daa861aba.m4a","quranTranslation":{"text":"Those who believe in Allah and the Last Day ask no leave of thee lest they should strive with their wealth and their lives. Allah is Aware of those who keep their duty (unto Him).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tražiti dozvolu","en":"to ask permission"},"passage":["لَا","يَسْتَـْٔذِنُكَ","ٱلَّذِينَ","يُؤْمِنُونَ","بِٱللَّهِ","وَٱلْيَوْمِ","ٱلْءَاخِرِ","أَن","يُجَٰهِدُوا۟","بِأَمْوَٰلِهِمْ","وَأَنفُسِهِمْ","وَٱللَّهُ","عَلِيمٌۢ","بِٱلْمُتَّقِينَ"],"marked":[1],"facts":{"verb":"اسْتَأْذَنَ"}},{"id":"istadhana-9-93-4","words":["verb:istadhana"],"options":[{"bs":"traže ti dozvolu","en":"they ask you permission"},{"bs":"i traži dozvolu","en":"and he/it asks permission"},{"bs":"tražili su ti dozvolu","en":"they asked you permission"},{"bs":"traži ti dozvolu","en":"he/it asks you permission"}],"ref":"9:93","answerWord":"يَسْتَـْٔذِنُونَكَ","answerSound":"audio/0e744e53150a2e9d7bd8.m4a","quranTranslation":{"text":"The road (of blame) is only against those who ask for leave of thee (to stay at home) when they are rich. They are content to be with the useless. Allah hath sealed their hearts so that they know not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tražiti dozvolu","en":"to ask permission"},"passage":["إِنَّمَا","ٱلسَّبِيلُ","عَلَى","ٱلَّذِينَ","يَسْتَـْٔذِنُونَكَ","وَهُمْ","أَغْنِيَآءُ","رَضُوا۟","بِأَن","يَكُونُوا۟","مَعَ","ٱلْخَوَالِفِ","وَطَبَعَ","ٱللَّهُ","عَلَىٰ","قُلُوبِهِمْ","فَهُمْ","لَا","يَعْلَمُونَ"],"marked":[4],"facts":{"verb":"اسْتَأْذَنَ"}},{"id":"istadhana-9-83-6","words":["verb:istadhana"],"options":[{"bs":"pa su ti tražili dozvolu","en":"so they asked you permission"},{"bs":"traži ti dozvolu","en":"he/it asks you permission"},{"bs":"traže ti dozvolu","en":"they ask you permission"},{"bs":"traže mu dozvolu","en":"they ask him permission"}],"ref":"9:83","answerWord":"فَٱسْتَـْٔذَنُوكَ","answerSound":"audio/108c7c03e0ad92768a38.m4a","quranTranslation":{"text":"If Allah bring thee back (from the campaign) unto a party of them and they ask of thee leave to go out (to fight), then say unto them: Ye shall never more go out with me nor fight with me against a foe. Ye were content with sitting still the first time. So sit still, with the useless.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tražiti dozvolu","en":"to ask permission"},"passage":["فَإِن","رَّجَعَكَ","ٱللَّهُ","إِلَىٰ","طَآئِفَةٍ","مِّنْهُمْ","فَٱسْتَـْٔذَنُوكَ","لِلْخُرُوجِ","فَقُل","لَّن","تَخْرُجُوا۟","مَعِىَ","أَبَدًا","وَلَن","تُقَٰتِلُوا۟","مَعِىَ","عَدُوًّا","إِنَّكُمْ","رَضِيتُم","بِٱلْقُعُودِ","أَوَّلَ","مَرَّةٍ","فَٱقْعُدُوا۟","مَعَ","ٱلْخَٰلِفِينَ"],"marked":[6],"facts":{"verb":"اسْتَأْذَنَ"}},{"id":"istadhana-9-86-9","words":["verb:istadhana"],"options":[{"bs":"tražio ti je dozvolu","en":"he/it asked you permission"},{"bs":"traži ti dozvolu","en":"he/it asks you permission"},{"bs":"pa su ti tražili dozvolu","en":"so they asked you permission"},{"bs":"traže mu dozvolu","en":"they ask him permission"}],"ref":"9:86","answerWord":"ٱسْتَـْٔذَنَكَ","answerSound":"audio/5c253904a5561b6f5ce7.m4a","quranTranslation":{"text":"And when a surah is revealed (which saith): Believe in Allah and strive along with His messenger, the men of wealth among them still ask leave of thee and say: Suffer us to be with those who sit (at home).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tražiti dozvolu","en":"to ask permission"},"passage":["وَإِذَآ","أُنزِلَتْ","سُورَةٌ","أَنْ","ءَامِنُوا۟","بِٱللَّهِ","وَجَٰهِدُوا۟","مَعَ","رَسُولِهِ","ٱسْتَـْٔذَنَكَ","أُو۟لُوا۟","ٱلطَّوْلِ","مِنْهُمْ","وَقَالُوا۟","ذَرْنَا","نَكُن","مَّعَ","ٱلْقَٰعِدِينَ"],"marked":[9],"facts":{"verb":"اسْتَأْذَنَ"}},{"id":"istadhana-24-59-5","words":["verb:istadhana"],"options":[{"bs":"pa neka zatraže dozvolu","en":"so let them ask permission"},{"bs":"traži ti dozvolu","en":"he/it asks you permission"},{"bs":"tražili su ti dozvolu","en":"they asked you permission"},{"bs":"neka vam zatraži dozvolu","en":"let him ask you (all) permission"}],"ref":"24:59","answerWord":"فَلْيَسْتَـْٔذِنُوا۟","answerSound":"audio/0e82ef9efd1e919f8f2a.m4a","quranTranslation":{"text":"And when the children among you come to puberty then let them ask leave even as those before them used to ask it. Thus Allah maketh clear His revelations for you. Allah is Knower, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tražiti dozvolu","en":"to ask permission"},"passage":["وَإِذَا","بَلَغَ","ٱلْأَطْفَٰلُ","مِنكُمُ","ٱلْحُلُمَ","فَلْيَسْتَـْٔذِنُوا۟","كَمَا","ٱسْتَـْٔذَنَ","ٱلَّذِينَ","مِن","قَبْلِهِمْ","كَذَٰلِكَ","يُبَيِّنُ","ٱللَّهُ","لَكُمْ","ءَايَٰتِهِۦ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"marked":[5],"facts":{"verb":"اسْتَأْذَنَ"}},{"id":"istadhana-24-59-7","words":["verb:istadhana"],"options":[{"bs":"tražio je dozvolu","en":"he/it asked permission"},{"bs":"pa su ti tražili dozvolu","en":"so they asked you permission"},{"bs":"traže mu dozvolu","en":"they ask him permission"},{"bs":"neka vam zatraži dozvolu","en":"let him ask you (all) permission"}],"ref":"24:59","answerWord":"ٱسْتَـْٔذَنَ","answerSound":"audio/1192f14852bbd27db61f.m4a","quranTranslation":{"text":"And when the children among you come to puberty then let them ask leave even as those before them used to ask it. Thus Allah maketh clear His revelations for you. Allah is Knower, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tražiti dozvolu","en":"to ask permission"},"passage":["وَإِذَا","بَلَغَ","ٱلْأَطْفَٰلُ","مِنكُمُ","ٱلْحُلُمَ","فَلْيَسْتَـْٔذِنُوا۟","كَمَا","ٱسْتَـْٔذَنَ","ٱلَّذِينَ","مِن","قَبْلِهِمْ","كَذَٰلِكَ","يُبَيِّنُ","ٱللَّهُ","لَكُمْ","ءَايَٰتِهِۦ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"marked":[7],"facts":{"verb":"اسْتَأْذَنَ"}},{"id":"istadhana-33-13-10","words":["verb:istadhana"],"options":[{"bs":"i traži dozvolu","en":"and he/it asks permission"},{"bs":"traže mu dozvolu","en":"they ask him permission"},{"bs":"traže ti dozvolu","en":"they ask you permission"},{"bs":"traži ti dozvolu","en":"he/it asks you permission"}],"ref":"33:13","answerWord":"وَيَسْتَـْٔذِنُ","answerSound":"audio/fd152c71603cc1d5741c.m4a","quranTranslation":{"text":"And when a party of them said: O folk of Yathrib! There is no stand (possible) for you, therefor turn back. And certain of them (even) sought permission of the Prophet, saying: Our homes lie open (to the enemy). And they lay not open. They but wished to flee.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tražiti dozvolu","en":"to ask permission"},"passage":["وَإِذْ","قَالَت","طَّآئِفَةٌ","مِّنْهُمْ","يَٰٓأَهْلَ","يَثْرِبَ","لَا","مُقَامَ","لَكُمْ","فَٱرْجِعُوا۟","وَيَسْتَـْٔذِنُ","فَرِيقٌ","مِّنْهُمُ","ٱلنَّبِىَّ","يَقُولُونَ","إِنَّ","بُيُوتَنَا","عَوْرَةٌ","وَمَا","هِىَ","بِعَوْرَةٍ","إِن","يُرِيدُونَ","إِلَّا","فِرَارًا"],"marked":[10],"facts":{"verb":"اسْتَأْذَنَ"}},{"id":"zalla-16-58-4","words":["verb:zalla"],"options":[{"bs":"ostao je","en":"he/it remained"},{"bs":"pa biste ostali","en":"and you would remain"},{"bs":"i ostajemo","en":"and we remain"},{"bs":"pa ostaju","en":"so they remain"}],"ref":"16:58","answerWord":"ظَلَّ","answerSound":"audio/d99ba91f11709278ff76.m4a","quranTranslation":{"text":"When if one of them receiveth tidings of the birth of a female, his face remaineth darkened, and he is wroth inwardly.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ostati, nastaviti","en":"to remain, to keep doing"},"passage":["وَإِذَا","بُشِّرَ","أَحَدُهُم","بِٱلْأُنثَىٰ","ظَلَّ","وَجْهُهُۥ","مُسْوَدًّا","وَهُوَ","كَظِيمٌ"],"marked":[4],"facts":{"verb":"ظَلَّ"}},{"id":"zalla-15-14-6","words":["verb:zalla"],"options":[{"bs":"pa su ostali","en":"so they remained"},{"bs":"ostao je","en":"he/it remained"},{"bs":"i ostajemo","en":"and we remain"},{"bs":"pa je ostala","en":"so she/it remained"}],"ref":"15:14","answerWord":"فَظَلُّوا۟","answerSound":"audio/e1ce4f2690db67dbedb5.m4a","quranTranslation":{"text":"And even if We opened unto them a gate of heaven and they kept mounting through it,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ostati, nastaviti","en":"to remain, to keep doing"},"passage":["وَلَوْ","فَتَحْنَا","عَلَيْهِم","بَابًا","مِّنَ","ٱلسَّمَآءِ","فَظَلُّوا۟","فِيهِ","يَعْرُجُونَ"],"marked":[6],"facts":{"verb":"ظَلَّ"}},{"id":"zalla-20-97-19","words":["verb:zalla"],"options":[{"bs":"ostao si","en":"you remained"},{"bs":"pa ostaju","en":"so they remain"},{"bs":"i ostajemo","en":"and we remain"},{"bs":"pa je ostala","en":"so she/it remained"}],"ref":"20:97","answerWord":"ظَلْتَ","answerSound":"audio/8f0cc057740f437e4270.m4a","quranTranslation":{"text":"(Moses) said: Then go! and lo! in this life it is for thee to say: Touch me not! and lo! there is for thee a tryst thou canst not break. Now look upon thy god of which thou hast remained a votary. Verily we will burn it and will scatter its dust over the sea.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ostati, nastaviti","en":"to remain, to keep doing"},"passage":["قَالَ","فَٱذْهَبْ","فَإِنَّ","لَكَ","فِى","ٱلْحَيَوٰةِ","أَن","تَقُولَ","لَا","مِسَاسَ","وَإِنَّ","لَكَ","مَوْعِدًا","لَّن","تُخْلَفَهُۥ","وَٱنظُرْ","إِلَىٰٓ","إِلَٰهِكَ","ٱلَّذِى","ظَلْتَ","عَلَيْهِ","عَاكِفًا","لَّنُحَرِّقَنَّهُۥ","ثُمَّ","لَنَنسِفَنَّهُۥ","فِى","ٱلْيَمِّ","نَسْفًا"],"marked":[19],"facts":{"verb":"ظَلَّ"}},{"id":"zalla-26-4-7","words":["verb:zalla"],"options":[{"bs":"pa je ostala","en":"so she/it remained"},{"bs":"pa su ostali","en":"so they remained"},{"bs":"ostao si","en":"you remained"},{"bs":"pa biste ostali","en":"and you would remain"}],"ref":"26:4","answerWord":"فَظَلَّتْ","answerSound":"audio/07f5db1d409cc1a6c9f7.m4a","quranTranslation":{"text":"If We will, We can send down on them from the sky a portent so that their necks would remain bowed before it.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ostati, nastaviti","en":"to remain, to keep doing"},"passage":["إِن","نَّشَأْ","نُنَزِّلْ","عَلَيْهِم","مِّنَ","ٱلسَّمَآءِ","ءَايَةً","فَظَلَّتْ","أَعْنَٰقُهُمْ","لَهَا","خَٰضِعِينَ"],"marked":[7],"facts":{"verb":"ظَلَّ"}},{"id":"zalla-26-71-3","words":["verb:zalla"],"options":[{"bs":"i ostajemo","en":"and we remain"},{"bs":"ostao je","en":"he/it remained"},{"bs":"ostao si","en":"you remained"},{"bs":"pa je ostala","en":"so she/it remained"}],"ref":"26:71","answerWord":"فَنَظَلُّ","answerSound":"audio/d7338de18bd93e591c84.m4a","quranTranslation":{"text":"They said: We worship idols, and are ever devoted unto them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ostati, nastaviti","en":"to remain, to keep doing"},"passage":["قَالُوا۟","نَعْبُدُ","أَصْنَامًا","فَنَظَلُّ","لَهَا","عَٰكِفِينَ"],"marked":[3],"facts":{"verb":"ظَلَّ"}},{"id":"zalla-42-33-4","words":["verb:zalla"],"options":[{"bs":"pa ostaju","en":"so they remain"},{"bs":"pa biste ostali","en":"and you would remain"},{"bs":"ostao si","en":"you remained"},{"bs":"pa je ostala","en":"so she/it remained"}],"ref":"42:33","answerWord":"فَيَظْلَلْنَ","answerSound":"audio/e7ae3da1a68f2bbc9201.m4a","quranTranslation":{"text":"If He will He calmeth the wind so that they keep still upon its surface - Lo! herein verily are signs for every steadfast grateful (heart). -","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ostati, nastaviti","en":"to remain, to keep doing"},"passage":["إِن","يَشَأْ","يُسْكِنِ","ٱلرِّيحَ","فَيَظْلَلْنَ","رَوَاكِدَ","عَلَىٰ","ظَهْرِهِۦٓ","إِنَّ","فِى","ذَٰلِكَ","لَءَايَٰتٍ","لِّكُلِّ","صَبَّارٍ","شَكُورٍ"],"marked":[4],"facts":{"verb":"ظَلَّ"}},{"id":"zalla-56-65-4","words":["verb:zalla"],"options":[{"bs":"pa biste ostali","en":"and you would remain"},{"bs":"ostao si","en":"you remained"},{"bs":"ostao je","en":"he/it remained"},{"bs":"pa je ostala","en":"so she/it remained"}],"ref":"56:65","answerWord":"فَظَلْتُمْ","answerSound":"audio/47d8ccd39d833349d554.m4a","quranTranslation":{"text":"If We willed, We verily could make it chaff, then would ye cease not to exclaim:","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"ostati, nastaviti","en":"to remain, to keep doing"},"passage":["لَوْ","نَشَآءُ","لَجَعَلْنَٰهُ","حُطَٰمًا","فَظَلْتُمْ","تَفَكَّهُونَ"],"marked":[4],"facts":{"verb":"ظَلَّ"}}]