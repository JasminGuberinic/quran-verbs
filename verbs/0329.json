amen", "id": "ujian", "tr": "muayene", "ur": "معائنہ"}}]}, {"arabic": "اِطْمَأَنُّوا لِلْخَبَرِ", "spoken": "audio/c89fa26a7f2e6c167497.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Vijest ih je umirila.", "en": "They were reassured by the news.", "bn": "তারা খবরে নিশ্চিন্ত হলো।", "fa": "با خبر آرام گرفتند.", "fr": "Ils ont été rassurés par la nouvelle.", "id": "Mereka merasa tenang dengan kabar itu.", "tr": "Haberle rahatladılar.", "ur": "خبر سے انہیں تسلی ہوئی۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِطْمَأَنُّوا", "target": true, "translation": {"bs": "umirili su se", "en": "were reassured", "bn": "তারা নিশ্চিন্ত হলো", "fa": "آرام گرفتند", "fr": "se sont apaisés", "id": "merasa tenang", "tr": "rahatladılar", "ur": "وہ مطمئن ہوئے"}}, {"arabic": "لِلْخَبَرِ", "target": false, "translation": {"bs": "zbog vijesti", "en": "by the news", "bn": "খবরের দ্বারা", "fa": "به خاطر خبر", "fr": "à cause de la nouvelle", "id": "karena berita itu", "tr": "haber yüzünden", "ur": "خبر سے"}}]}, {"arabic": "تَطْمَئِنُّ الْأُمُّ عَلَى ابْنِهَا", "spoken": "audio/ac39dfb3817ea5ded515.m4a", "tense": "present", "pronoun": "hiya", "translation": {"bs": "Majka je mirna za svog sina.", "en": "The mother is reassured about her son.", "bn": "মা তার ছেলের ব্যাপারে নিশ্চিন্ত।", "fa": "مادر نسبت به پسرش خاطرجمع است.", "fr": "La mère est rassurée au sujet de son fils.", "id": "Ibu itu merasa tenang tentang putranya.", "tr": "Anne oğlu için rahatladı.", "ur": "ماں کو اپنے بیٹے کی طرف سے تسلی ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "تَطْمَئِنُّ", "target": true, "translation": {"bs": "mirna je", "en": "is reassured", "bn": "নিশ্চিন্ত হয়", "fa": "آرام می‌گیرد", "fr": "est apaisée", "id": "merasa tenang", "tr": "rahatlar", "ur": "وہ مطمئن ہوتی ہے"}}, {"arabic": "الْأُمُّ", "target": false, "translation": {"bs": "majka", "en": "the mother", "bn": "মা", "fa": "مادر", "fr": "la mère", "id": "ibu itu", "tr": "anne", "ur": "ماں"}}, {"arabic": "عَلَى",