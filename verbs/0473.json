 "arabic": "يُسِئْنَ", "plain": "يُسِئْنَ", "quran": false, "notUsed": false, "spoken": "audio/3583cf2e21a3f24161fb.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَسِئْ", "plain": "أَسِئْ", "quran": false, "notUsed": false, "spoken": "audio/7b88752125d3aebc4656.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَسِيئِي", "plain": "أَسِيئِي", "quran": false, "notUsed": false, "spoken": "audio/1b5bf1f6df81a4889c3a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَسِيئَا", "plain": "أَسِيئَا", "quran": false, "notUsed": false, "spoken": "audio/fd9b495170fd9cc89426.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَسِيئُوا", "plain": "أَسِيئُوا", "quran": false, "notUsed": false, "spoken": "audio/3057240ecce64a9d3224.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَسِئْنَ", "plain": "أَسِئْنَ", "quran": false, "notUsed": false, "spoken": "audio/43774c7c9a922ba271dc.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "41:46", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4264.mp3", "translation": {"en": {"text": "Whoso doeth right it is for his soul, and whoso doeth wrong it is against it. And thy Lord is not at all a tyrant to His slaves.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Her kim iyi bir iş yaparsa, kendi lehine yapmış olur. Kim de bir kötülük yaparsa, kendi aleyhine yapmış olur. Rabbin kullara zulmedecek değildir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جو نیکی کرے وہ اپنے بھلے کو اور جو برائی کرے اپنے بُرے کو، اور تمہارا رب بندوں پر ظلم نہیں کرتا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Barangsiapa yang mengerjakan amal yang saleh maka (pahalanya) untuk dirinya sendiri dan barangsiapa mengerjakan perbuatan jahat, maka (dosanya) untuk dirinya sendiri; dan sekali-kali tidaklah Rabb-mu menganiaya hamba-hamba-Nya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَّنْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَمِلَ", "hit": false, "audio": null, "gloss": null}, {"text": "صَٰلِحًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَلِنَفْسِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَسَآءَ", "hit": true, "audio": "audio/db176ff3634102480fab.m4a", "gloss": {"bs": "učini loše", "en": "(he) does wrong", "tr": "kötülük yapar", "fr": "(il) fait le mal", "id": "(dia) berbuat buruk", "ur": "(وہ) برائی کرتا ہے", "bn": "(সে) মন্দ কাজ করে", "fa": "(او) بدی می‌کند"}}, {"text": "فَعَلَيْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "رَبُّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِظَلَّٰمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "لِّلْعَبِيدِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَسَٰٓـُٔوا۟", "count": 2, "first": "30:10", "audio": "audio/460ea6dcf7ee39052cd0.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "they did wrong", "bs": "učinili su zlo", "tr": "kötülük ettiler", "fr": "ils ont fait le mal", "id": "mereka telah berbuat kejahatan", "ur": "وہ ظلم کرتے ہیں", "bn": "তারা অন্যায় করেছে", "fa": "بدی کردند"}}, {"arabic": "أَسَآءَ", "count": 2, "first": "41:46", "audio": "audio/db176ff3634102480fab.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "učini loše", "en": "(he) does wrong", "tr": "kötülük yapar", "fr": "(il) fait le mal", "id": "(dia) berbuat buruk", "ur": "(وہ) برائی کرتا ہے", "bn": "(সে) মন্দ কাজ করে", "fa": "(او) بدی می‌کند"}}, {"arabic": "أَسَأْتُمْ", "count": 1, "first": "17:7", "audio": "audio/3f6b6a9381e7718eb15a.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) did wrong", "bs": "učinili ste zlo", "tr": "kötülük ettiniz", "fr": "vous avez fait le mal", "id": "kalian telah berbuat kejahatan", "ur": "تم سب نے ظلم کیا", "bn": "তোমরা অন্যায় করেছ", "fa": "بدی کردید"}}], "ayatFile": "ayat/0473.json", "ayatTranslations": {"en": "ayat/0473.en.json", "tr": "ayat/0473.tr.json", "ur": "ayat/0473.ur.json", "id": "ayat/0473.id.json"}, "sentences": [{"arabic": "أَسَاءَ الْوَلَدُ إِلَى أُمِّهِ", "spoken": "audio/0fce2c9f1f83f574b5e9.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Dijete je uvrijedilo svoju majku.", "en": "The child offended his mother.", "bn": "ছেলেটি তার মায়ের সাথে খারাপ আচরণ করল।", "fa": "پسر به مادرش بدی کرد.", "fr": "L'enfant a fait du tort à sa mère.", "id": "Anak itu berbuat buruk kepada ibunya.", "tr": "Çocuk annesine kötü davrandı.", "ur": "لڑکے نے اپنی ماں کے ساتھ برا سلوک کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَسَاءَ", "target": true, "translation": {"bs": "uvrijedilo je", "en": "offended", "bn": "অসম্মান করল", "fa": "بدی کرد", "fr": "a fait du tort", "id": "berbuat buruk", "tr": "kötülük etti", "ur": "برا سلوک کیا"}}, {"arabic": "الْوَلَدُ", "target": false, "translation": {"bs": "dijete", "en": "the child", "bn": "শিশুটি", "fa": "کودک", "fr": "l'enfant", "id": "anak itu", "tr": "çocuk", "ur": "بچہ"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "(prema)", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "أُمِّهِ", "target": false, "translation": {"bs": "svoju majku", "en": "his mother", "bn": "তার মা", "fa": "مادرش", "fr": "sa mère", "id": "ibunya", "tr": "annesi", "ur": "اس کی ماں"}}]}, {"arabic": "أَسَاءُوا إِلَى جَارِهِمْ", "spoken": "audio/57ca3dd0223ad86a4526.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Naudili su svom komšiji.", "en": "They harmed their neighbor.", "bn": "তারা তাদের প্রতিবেশীর ক্ষতি করল।", "fa": "آنان به همسایه‌شان آزار رساندند.", "fr": "Ils ont fait du tort à leur voisin.", "id": "Mereka berbuat jahat kepada tetangga mereka.", "tr": "Komşularına zarar verdiler.", "ur": "انہوں نے اپنے پڑوسی کو نقصان پہنچایا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَسَاءُوا", "target": true, "translation": {"bs": "naudili su", "en": "harmed", "bn": "তারা ক্ষতি করল", "fa": "آزار رساندند", "fr": "ont fait du tort", "id": "berbuat jahat", "tr": "zarar verdiler", "ur": "انہوں نے نقصان پہنچایا"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "(prema)", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "جَارِهِمْ", "target": false, "translation": {"bs": "svom komšiji", "en": "their neighbor", "bn": "তাদের প্রতিবেশী", "fa": "همسایه‌شان", "fr": "leur voisin", "id": "tetangga mereka", "tr": "komşuları", "ur": "ان کا پڑوسی"}}]}, {"arabic": "أَسَأْتُمْ إِلَى صَدِيقِكُمْ", "spoken": "audio/22edd243d2263b167a24.m4a", "tense": "past", "pronoun": "antum", "translation": {"bs": "Vi (svi) ste naudili svom prijatelju.", "en": "You (all) harmed your (pl.) friend.", "bn": "তোমরা তোমাদের বন্ধুর ক্ষতি করেছ।", "fa": "شما به دوستتان آزار رساندید.", "fr": "Vous avez fait du tort à votre ami.", "id": "Kalian berbuat jahat kepada teman kalian.", "tr": "Arkadaşınıza zarar verdiniz.", "ur": "تم سب نے اپنے دوست کے ساتھ برا کیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَسَأْتُمْ", "target": true, "translation": {"bs": "naudili ste", "en": "harmed", "bn": "তোমরা ক্ষতি করেছ", "fa": "آزار رساندید", "fr": "vous avez fait du tort", "id": "kalian berbuat jahat", "tr": "zarar verdiniz", "ur": "تم سب نے نقصان پہنچایا"}}, {"arabic": "إِلَى", "target": false, "translation": {"bs": "(prema)", "en": "to", "bn": "দিকে", "fa": "به", "fr": "à", "id": "ke", "tr": "-e kadar", "ur": "کی طرف"}}, {"arabic": "صَدِيقِكُمْ", "target": false, "translation": {"bs": "svom prijatelju", "en": "your (pl.) friend", "bn": "তোমাদের বন্ধু", "fa": "دوستتان", "fr": "votre ami", "id": "teman kalian", "tr": "arkadaşınız", "ur": "تم سب کا دوست"}}]}]}