 "audio/90b4f90fb233a986eedd.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَنذِرْ", "plain": "أَنْذِرْ", "quran": true, "notUsed": false, "spoken": "audio/6bf33e0f8e6f90f422e3.m4a", "recited": "audio/85fe6f97c2859541fc67.m4a", "recitedText": "أَنذِرْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَنْذِرِي", "plain": "أَنْذِرِي", "quran": false, "notUsed": false, "spoken": "audio/0ac36186b07453e7afcb.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَنْذِرَا", "plain": "أَنْذِرَا", "quran": false, "notUsed": false, "spoken": "audio/228677eeb43d195ca562.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَنذِرُوٓا۟", "plain": "أَنْذِرُوا", "quran": true, "notUsed": false, "spoken": "audio/70ca3aef5052efc76502.m4a", "recited": "audio/3b8f3ded0b56d6011b45.m4a", "recitedText": "أَنذِرُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَنْذِرْنَ", "plain": "أَنْذِرْنَ", "quran": false, "notUsed": false, "spoken": "audio/706671cbb2b352b53709.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "36:6", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3711.mp3", "translation": {"en": {"text": "That thou mayst warn a folk whose fathers were not warned, so they are heedless.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Babaları korkutulmamış ve kendileri de gafil olan bir kavmi, çok güçlü ve çok merhametli olan Allah'ın indirdiği (Kur'ân) ile korkutasın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تاکہ تم اس قوم کو ڈر سناؤ جس کے باپ دادا نہ ڈرائے گئے تو وہ بے خبر ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Agar kamu memberi peringatan kepada kaum yang bapak-bapak mereka belum pernah diberi peringatan, karena itu mereka lalai.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لِتُنذِرَ", "hit": true, "audio": "audio/013569ab49fde03c2656.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "subjunctive"}]}, {"text": "قَوْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "مَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أُنذِرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَابَآؤُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "غَٰفِلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:214", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3146.mp3", "translation": {"en": {"text": "And warn thy tribe of near kindred,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Önce) en yakın hısımlarını uyar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اے محبوب! اپنے قریب تر رشتہ داروں کو ڈراؤ", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan berilah peringatan kepada kerabat-kerabatmu yang terdekat,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنذِرْ", "hit": true, "audio": "audio/6d752825a476c5ffe102.m4a", "gloss": {"bs": "i opomeni!", "en": "and warn!", "tr": "ve uyar!", "fr": "et avertis !", "id": "dan peringatkanlah!", "ur": "اور ڈراؤ!", "bn": "এবং সতর্ক করো!", "fa": "و هشدار ده!"}}, {"text": "عَشِيرَتَكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَقْرَبِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:4", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2144.mp3", "translation": {"en": {"text": "And to warn those who say: Allah hath chosen a son,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve \"Allah çocuk edindi\" diyenleri de uyarsın.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ان کو ڈرائے جو کہتے ہیں کہ اللہ نے اپنا کوئی بچہ بنایا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan untuk memperingatkan kepada orang-orang yang berkata: \"Allah mengambil seorang anak\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيُنذِرَ", "hit": true, "audio": "audio/1497596eefc3659a70aa.m4a", "gloss": {"bs": "i da opomene", "en": "and to warn", "tr": "ve uyarması için", "fr": "et pour avertir", "id": "dan untuk memperingatkan", "ur": "اور تاکہ وہ ڈرائے", "bn": "এবং সতর্ক করার জন্য", "fa": "و (تا) هشدار دهد"}}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱتَّخَذَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:10", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3715.mp3", "translation": {"en": {"text": "Whether thou warn them or thou warn them not, it is alike for them, for they believe not.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onları korkutsan da korkutmasan da onlara göre birdir, inanmazlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور انہیں ایک سا ہے تم انہیں ڈراؤٕ یا نہ ڈراؤ وہ ایمان لانے کے نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sama saja bagi mereka apakah kamu memberi peringatan kepada mereka ataukah kamu tidak memberi peringatan kepada mereka, mereka tidak akan beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَسَوَآءٌ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَأَنذَرْتَهُمْ", "hit": true, "audio": "audio/5e3c586b61f668231c94.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "anta", "passive": false, "objects": ["hum"]}]}, {"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تُنذِرْهُمْ", "hit": true, "audio": "audio/200a0b9ed32f0f46049c.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": ["hum"], "mood": "jussive"}]}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُؤْمِنُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:45", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2528.mp3", "translation": {"en": {"text": "Say (O Muhammad, unto mankind): I warn you only by the Inspiration. But the deaf hear not the call when they are warned.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki: \"Ben sizi ancak vahiyle korkutup uyarıyorum,\" uyarıldıkları zaman sağırlar çağrıyı duymazlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ کہ میں تم کو صرف وحی سے ڈراتا ہوں اور بہرے پکارنا نہیں سنتے جب ڈرائے جائیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah (hai Muhammad): \"Sesungguhnya aku hanya memberi peringatan kepada kamu sekalian dengan wahyu dan tiadalah orang-orang yang tuli mendengar seruan, apabila mereka diberi peringatan\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أُنذِرُكُم", "hit": true, "audio": "audio/e2999b6331c4eb09e324.m4a", "gloss": {"en": "I warn you (all)", "bs": "opominjem vas", "tr": "sizi uyarırım", "fr": "je vous avertis", "id": "aku memberi peringatan kepada kalian", "ur": "میں تمہیں خبردار کرتا ہوں", "bn": "আমি তোমাদের সতর্ক করি", "fa": "شما را هشدار می‌دهم"}}, {"text": "بِٱلْوَحْىِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْمَعُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلصُّمُّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلدُّعَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُنذَرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "92:14", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6072.mp3", "translation": {"en": {"text": "Therefor have I warned you of the flaming Fire", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ben sizi köpürdükçe köpüren bir ateşe karşı uyardım.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو میں تمہیں ڈراتا ہوں اس آگ سے جو بھڑک رہی ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka, kami memperingatkan kamu dengan neraka yang menyala-nyala.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَنذَرْتُكُمْ", "hit": true, "audio": "audio/4eabe7d3b19f704fa141.m4a", "gloss": {"bs": "pa sam vas opomenuo", "en": "so I warned you", "tr": "ben de sizi uyardım", "fr": "alors je vous ai avertis", "id": "maka aku telah memperingatkanmu", "ur": "پس میں نے تمہیں ڈرایا", "bn": "তাই আমি তোমাদের সতর্ক করেছি", "fa": "پس به شما هشدار دادم"}}, {"text": "نَارًا", "hit": false, "audio": null, "gloss": null}, {"text": "تَلَظَّىٰ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "لِتُنذِرَ", "count": 4, "first": "7:2",