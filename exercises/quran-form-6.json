[{"id":"abada-37-161-2","words":["verb:abada"],"options":[{"bs":"obožavate","en":"you worship"},{"bs":"pa obožavajte!","en":"so (you all) worship!"},{"bs":"obožavali smo ih","en":"we worshipped them"},{"bs":"obožavaju ih","en":"they worship them"}],"ref":"37:161","answerWord":"تَعْبُدُونَ","answerSound":"audio/b5e719bb18e19489eaf7.m4a","quranTranslation":{"text":"Lo! verily, ye and that which ye worship,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["فَإِنَّكُمْ","وَمَا","تَعْبُدُونَ"],"marked":[2],"facts":{"verb":"عَبَدَ"}},{"id":"abada-2-21-2","words":["verb:abada"],"options":[{"bs":"obožavajte!","en":"(you all) worship!"},{"bs":"obožavamo","en":"we worship"},{"bs":"obožava","en":"he/it worships"},{"bs":"bivaju obožavani","en":"they are worshipped"}],"ref":"2:21","answerWord":"ٱعْبُدُوا۟","answerSound":"audio/ebf30b3806a5627372e8.m4a","quranTranslation":{"text":"O mankind! worship your Lord, Who hath created you and those before you, so that ye may ward off (evil).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["يَٰٓأَيُّهَا","ٱلنَّاسُ","ٱعْبُدُوا۟","رَبَّكُمُ","ٱلَّذِى","خَلَقَكُمْ","وَٱلَّذِينَ","مِن","قَبْلِكُمْ","لَعَلَّكُمْ","تَتَّقُونَ"],"marked":[2],"facts":{"verb":"عَبَدَ"}},{"id":"abada-7-70-8","words":["verb:abada"],"options":[{"bs":"obožava","en":"he/it worships"},{"bs":"obožavali smo","en":"we worshipped"},{"bs":"pa ga obožavaj!","en":"so worship him!"},{"bs":"obožavamo","en":"we worship"}],"ref":"7:70","answerWord":"يَعْبُدُ","answerSound":"audio/2f1beb9c06c6c0ebfed8.m4a","quranTranslation":{"text":"They said: Hast come unto us that we should serve Allah alone, and forsake what our fathers worshipped? Then bring upon us that wherewith thou threatenest us if thou art of the truthful!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["قَالُوٓا۟","أَجِئْتَنَا","لِنَعْبُدَ","ٱللَّهَ","وَحْدَهُۥ","وَنَذَرَ","مَا","كَانَ","يَعْبُدُ","ءَابَآؤُنَا","فَأْتِنَا","بِمَا","تَعِدُنَآ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"marked":[8],"facts":{"verb":"عَبَدَ"}},{"id":"abada-10-104-10","words":["verb:abada"],"options":[{"bs":"obožavam","en":"I worship"},{"bs":"obožavajte!","en":"(you all) worship!"},{"bs":"obožavajte me!","en":"(you all) worship me!"},{"bs":"obožavali smo ih","en":"we worshipped them"}],"ref":"10:104","answerWord":"أَعْبُدُ","answerSound":"audio/4c053cf00ce1094b1aed.m4a","quranTranslation":{"text":"Say (O Muhammad): O mankind! If ye are in doubt of my religion, then (know that) I worship not those whom ye worship instead of Allah, but I worship Allah Who causeth you to die, and I have been commanded to be of the believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["قُلْ","يَٰٓأَيُّهَا","ٱلنَّاسُ","إِن","كُنتُمْ","فِى","شَكٍّ","مِّن","دِينِى","فَلَآ","أَعْبُدُ","ٱلَّذِينَ","تَعْبُدُونَ","مِن","دُونِ","ٱللَّهِ","وَلَٰكِنْ","أَعْبُدُ","ٱللَّهَ","ٱلَّذِى","يَتَوَفَّىٰكُمْ","وَأُمِرْتُ","أَنْ","أَكُونَ","مِنَ","ٱلْمُؤْمِنِينَ"],"marked":[10,17],"facts":{"verb":"عَبَدَ"}},{"id":"abada-11-109-8","words":["verb:abada"],"options":[{"bs":"obožavaju","en":"they worship"},{"bs":"obožavate","en":"you (all) worship"},{"bs":"obožavamo","en":"we worship"},{"bs":"obožavajte me!","en":"(you all) worship me!"}],"ref":"11:109","answerWord":"يَعْبُدُونَ","answerSound":"audio/8f826a06ecc52a47e237.m4a","quranTranslation":{"text":"So be not thou in doubt concerning that which these (folk) worship. They worship only as their fathers worshipped aforetime. Lo! we shall pay them their whole due unabated.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["فَلَا","تَكُ","فِى","مِرْيَةٍ","مِّمَّا","يَعْبُدُ","هَٰٓؤُلَآءِ","مَا","يَعْبُدُونَ","إِلَّا","كَمَا","يَعْبُدُ","ءَابَآؤُهُم","مِّن","قَبْلُ","وَإِنَّا","لَمُوَفُّوهُمْ","نَصِيبَهُمْ","غَيْرَ","مَنقُوصٍ"],"marked":[8],"facts":{"verb":"عَبَدَ"}},{"id":"abada-3-51-4","words":["verb:abada"],"options":[{"bs":"pa ga obožavajte!","en":"so (you all) worship him!"},{"bs":"da obožavaju","en":"so that they may worship"},{"bs":"obožavamo","en":"we worship"},{"bs":"obožavajte!","en":"(you all) worship!"}],"ref":"3:51","answerWord":"فَٱعْبُدُوهُ","answerSound":"audio/837c6ee7d4fd2c1828bc.m4a","quranTranslation":{"text":"Lo! Allah is my Lord and your Lord, so worship Him. That is a straight path.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["إِنَّ","ٱللَّهَ","رَبِّى","وَرَبُّكُمْ","فَٱعْبُدُوهُ","هَٰذَا","صِرَٰطٌ","مُّسْتَقِيمٌ"],"marked":[4],"facts":{"verb":"عَبَدَ"}},{"id":"abada-6-56-4","words":["verb:abada"],"options":[{"bs":"obožavam","en":"I worship"},{"bs":"obožavajte me!","en":"(you all) worship me!"},{"bs":"i obožavao je","en":"and he/it worshipped"},{"bs":"obožavajte!","en":"(you all) worship!"}],"ref":"6:56","answerWord":"أَعْبُدَ","answerSound":"audio/000af73645ed9559a141.m4a","quranTranslation":{"text":"Say: I am forbidden to worship those on whom ye call instead of Allah. Say: I will not follow your desires, for then should I go astray and I should not be of the rightly guided.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["قُلْ","إِنِّى","نُهِيتُ","أَنْ","أَعْبُدَ","ٱلَّذِينَ","تَدْعُونَ","مِن","دُونِ","ٱللَّهِ","قُل","لَّآ","أَتَّبِعُ","أَهْوَآءَكُمْ","قَدْ","ضَلَلْتُ","إِذًا","وَمَآ","أَنَا۠","مِنَ","ٱلْمُهْتَدِينَ"],"marked":[4],"facts":{"verb":"عَبَدَ"}},{"id":"abada-10-18-0","words":["verb:abada"],"options":[{"bs":"i obožavaju","en":"and they worship"},{"bs":"obožavamo ih","en":"we worship them"},{"bs":"obožavate","en":"you worship"},{"bs":"obožavali smo ih","en":"we worshipped them"}],"ref":"10:18","answerWord":"وَيَعْبُدُونَ","answerSound":"audio/1ad19336a871045f5cd1.m4a","quranTranslation":{"text":"They worship beside Allah that which neither hurteth them nor profiteth them, and they say: These are our intercessors with Allah. Say: Would ye inform Allah of (something) that He knoweth not in the heavens or in the earth? Praised be He and High Exalted above all that ye associate (with Him)!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["وَيَعْبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَضُرُّهُمْ","وَلَا","يَنفَعُهُمْ","وَيَقُولُونَ","هَٰٓؤُلَآءِ","شُفَعَٰٓؤُنَا","عِندَ","ٱللَّهِ","قُلْ","أَتُنَبِّـُٔونَ","ٱللَّهَ","بِمَا","لَا","يَعْلَمُ","فِى","ٱلسَّمَٰوَٰتِ","وَلَا","فِى","ٱلْأَرْضِ","سُبْحَٰنَهُۥ","وَتَعَٰلَىٰ","عَمَّا","يُشْرِكُونَ"],"marked":[0],"facts":{"verb":"عَبَدَ"}},{"id":"abada-1-5-1","words":["verb:abada"],"options":[{"bs":"obožavamo","en":"we worship"},{"bs":"pa me obožavajte!","en":"so (you all) worship me!"},{"bs":"obožavate","en":"you (all) worship"},{"bs":"pa obožavaj!","en":"so worship!"}],"ref":"1:5","answerWord":"نَعْبُدُ","answerSound":"audio/003626ae799c539d5d7e.m4a","quranTranslation":{"text":"Thee (alone) we worship; Thee (alone) we ask for help.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["إِيَّاكَ","نَعْبُدُ","وَإِيَّاكَ","نَسْتَعِينُ"],"marked":[1],"facts":{"verb":"عَبَدَ"}},{"id":"abada-53-62-2","words":["verb:abada"],"options":[{"bs":"i obožavajte","en":"and worship"},{"bs":"obožavali smo ih","en":"we worshipped them"},{"bs":"pa neka obožavaju","en":"so let them worship"},{"bs":"pa ga obožavaj!","en":"so worship him!"}],"ref":"53:62","answerWord":"وَٱعْبُدُوا۟","answerSound":"audio/e003f680838db09b3192.m4a","quranTranslation":{"text":"Rather prostrate yourselves before Allah and serve Him.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["فَٱسْجُدُوا۟","لِلَّهِ","وَٱعْبُدُوا۟"],"marked":[2],"facts":{"verb":"عَبَدَ"}},{"id":"abada-21-25-14","words":["verb:abada"],"options":[{"bs":"pa me obožavajte!","en":"so (you all) worship me!"},{"bs":"obožavaju ih","en":"they worship them"},{"bs":"obožavamo","en":"we worship"},{"bs":"i obožavao je","en":"and he/it worshipped"}],"ref":"21:25","answerWord":"فَٱعْبُدُونِ","answerSound":"audio/c8ec6382fd18b24bc0c0.m4a","quranTranslation":{"text":"And We sent no messenger before thee but We inspired him, (saying): There is no Allah save Me (Allah), so worship Me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["وَمَآ","أَرْسَلْنَا","مِن","قَبْلِكَ","مِن","رَّسُولٍ","إِلَّا","نُوحِىٓ","إِلَيْهِ","أَنَّهُۥ","لَآ","إِلَٰهَ","إِلَّآ","أَنَا۠","فَٱعْبُدُونِ"],"marked":[14],"facts":{"verb":"عَبَدَ"}},{"id":"abada-5-76-1","words":["verb:abada"],"options":[{"bs":"zar obožavate?","en":"do you (all) worship?"},{"bs":"i obožavaju","en":"and they worship"},{"bs":"obožavam","en":"I worship"},{"bs":"obožavali smo","en":"we worshipped"}],"ref":"5:76","answerWord":"أَتَعْبُدُونَ","answerSound":"audio/e0aaf1913ebc6bb80c5b.m4a","quranTranslation":{"text":"Say: Serve ye in place of Allah that which possesseth for you neither hurt nor use? Allah it is Who is the Hearer, the Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["قُلْ","أَتَعْبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَمْلِكُ","لَكُمْ","ضَرًّا","وَلَا","نَفْعًا","وَٱللَّهُ","هُوَ","ٱلسَّمِيعُ","ٱلْعَلِيمُ"],"marked":[1],"facts":{"verb":"عَبَدَ"}},{"id":"abada-11-62-10","words":["verb:abada"],"options":[{"bs":"obožavamo","en":"we worship"},{"bs":"i obožavaju","en":"and they worship"},{"bs":"pa obožavajte!","en":"so (you all) worship!"},{"bs":"pa obožavaj!","en":"so worship!"}],"ref":"11:62","answerWord":"نَّعْبُدَ","answerSound":"audio/10cfdc8292be07b7a2c2.m4a","quranTranslation":{"text":"They said: O Salih! Thou hast been among us hitherto as that wherein our hope was placed. Dost thou ask us not to worship what our fathers worshipped? Lo! we verily are in grave doubt concerning that to which thou callest us.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["قَالُوا۟","يَٰصَٰلِحُ","قَدْ","كُنتَ","فِينَا","مَرْجُوًّا","قَبْلَ","هَٰذَآ","أَتَنْهَىٰنَآ","أَن","نَّعْبُدَ","مَا","يَعْبُدُ","ءَابَآؤُنَا","وَإِنَّنَا","لَفِى","شَكٍّ","مِّمَّا","تَدْعُونَآ","إِلَيْهِ","مُرِيبٍ"],"marked":[10],"facts":{"verb":"عَبَدَ"}},{"id":"abada-11-123-8","words":["verb:abada"],"options":[{"bs":"pa ga obožavaj!","en":"so worship him!"},{"bs":"obožavaju","en":"they worship"},{"bs":"pa obožavajte!","en":"so (you all) worship!"},{"bs":"obožavam","en":"I worship"}],"ref":"11:123","answerWord":"فَٱعْبُدْهُ","answerSound":"audio/279b9bfe10d108239f39.m4a","quranTranslation":{"text":"And Allah's is the Invisible of the heavens and the earth, and unto Him the whole matter will be returned. So worship Him and put thy trust in Him. Lo! thy Lord is not unaware of what ye (mortals) do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["وَلِلَّهِ","غَيْبُ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","وَإِلَيْهِ","يُرْجَعُ","ٱلْأَمْرُ","كُلُّهُۥ","فَٱعْبُدْهُ","وَتَوَكَّلْ","عَلَيْهِ","وَمَا","رَبُّكَ","بِغَٰفِلٍ","عَمَّا","تَعْمَلُونَ"],"marked":[8],"facts":{"verb":"عَبَدَ"}},{"id":"abada-5-60-18","words":["verb:abada"],"options":[{"bs":"i obožavao je","en":"and he/it worshipped"},{"bs":"obožavamo","en":"we worship"},{"bs":"obožavam","en":"I worship"},{"bs":"pa ga obožavajte!","en":"so (you all) worship him!"}],"ref":"5:60","answerWord":"وَعَبَدَ","answerSound":"audio/0f74c84626df293e2d6c.m4a","quranTranslation":{"text":"Shall I tell thee of a worse (case) than theirs for retribution with Allah? (Worse is the case of him) whom Allah hath cursed, him on whom His wrath hath fallen and of whose sort Allah hath turned some to apes and swine, and who serveth idols. Such are in worse plight and further astray from the plain road.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["قُلْ","هَلْ","أُنَبِّئُكُم","بِشَرٍّ","مِّن","ذَٰلِكَ","مَثُوبَةً","عِندَ","ٱللَّهِ","مَن","لَّعَنَهُ","ٱللَّهُ","وَغَضِبَ","عَلَيْهِ","وَجَعَلَ","مِنْهُمُ","ٱلْقِرَدَةَ","وَٱلْخَنَازِيرَ","وَعَبَدَ","ٱلطَّٰغُوتَ","أُو۟لَٰٓئِكَ","شَرٌّ","مَّكَانًا","وَأَضَلُّ","عَن","سَوَآءِ","ٱلسَّبِيلِ"],"marked":[18],"facts":{"verb":"عَبَدَ"}},{"id":"abada-7-70-2","words":["verb:abada"],"options":[{"bs":"da obožavamo","en":"so that we may worship"},{"bs":"obožavam","en":"I worship"},{"bs":"obožavaju","en":"they worship"},{"bs":"obožavate","en":"you (all) worship"}],"ref":"7:70","answerWord":"لِنَعْبُدَ","answerSound":"audio/7ae1c517082e6a8e7142.m4a","quranTranslation":{"text":"They said: Hast come unto us that we should serve Allah alone, and forsake what our fathers worshipped? Then bring upon us that wherewith thou threatenest us if thou art of the truthful!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["قَالُوٓا۟","أَجِئْتَنَا","لِنَعْبُدَ","ٱللَّهَ","وَحْدَهُۥ","وَنَذَرَ","مَا","كَانَ","يَعْبُدُ","ءَابَآؤُنَا","فَأْتِنَا","بِمَا","تَعِدُنَآ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"marked":[2],"facts":{"verb":"عَبَدَ"}},{"id":"abada-9-31-13","words":["verb:abada"],"options":[{"bs":"da obožavaju","en":"so that they may worship"},{"bs":"obožavate","en":"you worship"},{"bs":"obožavali smo","en":"we worshipped"},{"bs":"obožavali ste","en":"you worshipped"}],"ref":"9:31","answerWord":"لِيَعْبُدُوٓا۟","answerSound":"audio/ecb7d6626e912a606da2.m4a","quranTranslation":{"text":"They have taken as lords beside Allah their rabbis and their monks and the Messiah son of Mary, when they were bidden to worship only One Allah. There is no Allah save Him. Be He Glorified from all that they ascribe as partner (unto Him)!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["ٱتَّخَذُوٓا۟","أَحْبَارَهُمْ","وَرُهْبَٰنَهُمْ","أَرْبَابًا","مِّن","دُونِ","ٱللَّهِ","وَٱلْمَسِيحَ","ٱبْنَ","مَرْيَمَ","وَمَآ","أُمِرُوٓا۟","إِلَّا","لِيَعْبُدُوٓا۟","إِلَٰهًا","وَٰحِدًا","لَّآ","إِلَٰهَ","إِلَّا","هُوَ","سُبْحَٰنَهُۥ","عَمَّا","يُشْرِكُونَ"],"marked":[13],"facts":{"verb":"عَبَدَ"}},{"id":"abada-15-99-0","words":["verb:abada"],"options":[{"bs":"i obožavaj!","en":"and worship!"},{"bs":"obožavaju ih","en":"they worship them"},{"bs":"da obožavamo","en":"so that we may worship"},{"bs":"i obožavao je","en":"and he/it worshipped"}],"ref":"15:99","answerWord":"وَٱعْبُدْ","answerSound":"audio/88e8474c49abc3f5318e.m4a","quranTranslation":{"text":"And serve thy Lord till the Inevitable cometh unto thee.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["وَٱعْبُدْ","رَبَّكَ","حَتَّىٰ","يَأْتِيَكَ","ٱلْيَقِينُ"],"marked":[0],"facts":{"verb":"عَبَدَ"}},{"id":"abada-20-14-7","words":["verb:abada"],"options":[{"bs":"pa me obožavaj!","en":"so worship me!"},{"bs":"i obožavajte ga!","en":"and (you all) worship him!"},{"bs":"obožavaju ih","en":"they worship them"},{"bs":"pa neka obožavaju","en":"so let them worship"}],"ref":"20:14","answerWord":"فَٱعْبُدْنِى","answerSound":"audio/7da8bd067d4cb0c3d4da.m4a","quranTranslation":{"text":"Lo! I, even I, am Allah, There is no Allah save Me. So serve Me and establish worship for My remembrance.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["إِنَّنِىٓ","أَنَا","ٱللَّهُ","لَآ","إِلَٰهَ","إِلَّآ","أَنَا۠","فَٱعْبُدْنِى","وَأَقِمِ","ٱلصَّلَوٰةَ","لِذِكْرِىٓ"],"marked":[7],"facts":{"verb":"عَبَدَ"}},{"id":"abada-29-17-22","words":["verb:abada"],"options":[{"bs":"i obožavajte ga!","en":"and (you all) worship him!"},{"bs":"i obožavaj!","en":"and worship!"},{"bs":"pa obožavajte!","en":"so (you all) worship!"},{"bs":"obožavate","en":"you worship"}],"ref":"29:17","answerWord":"وَٱعْبُدُوهُ","answerSound":"audio/0321e87b1fd0d168157e.m4a","quranTranslation":{"text":"Ye serve instead of Allah only idols, and ye only invent a lie. Lo! those whom ye serve instead of Allah own no provision for you. So seek your provision from Allah, and serve Him, and give thanks unto Him, (for) unto Him ye will be brought back.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"obožavati, robovati","en":"to worship"},"passage":["إِنَّمَا","تَعْبُدُونَ","مِن","دُونِ","ٱللَّهِ","أَوْثَٰنًا","وَتَخْلُقُونَ","إِفْكًا","إِنَّ","ٱلَّذِينَ","تَعْبُدُونَ","مِن","دُونِ","ٱللَّهِ","لَا","يَمْلِكُونَ","لَكُمْ","رِزْقًا","فَٱبْتَغُوا۟","عِندَ","ٱللَّهِ","ٱلرِّزْقَ","وَٱعْبُدُوهُ","وَٱشْكُرُوا۟","لَهُۥٓ","إِلَيْهِ","تُرْجَعُونَ"],"marked":[22],"facts":{"verb":"عَبَدَ"}},{"id":"shariba-52-19-1","words":["verb:shariba"],"options":[{"bs":"i pijte","en":"and drink"},{"bs":"pio je","en":"he/it drank"},{"bs":"pije","en":"he/it drinks"},{"bs":"pijete","en":"you drink"}],"ref":"52:19","answerWord":"وَٱشْرَبُوا۟","answerSound":"audio/19a7ac113aed81521015.m4a","quranTranslation":{"text":"(And it is said unto them): Eat and drink in health (as a reward) for what ye used to do,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"piti","en":"to drink"},"passage":["كُلُوا۟","وَٱشْرَبُوا۟","هَنِيٓـًٔۢا","بِمَا","كُنتُمْ","تَعْمَلُونَ"],"marked":[1],"facts":{"verb":"شَرِبَ"}},{"id":"shariba-56-68-3","words":["verb:shariba"],"options":[{"bs":"pijete","en":"you drink"},{"bs":"pio je","en":"he/it drank"},{"bs":"pije","en":"he/it drinks"},{"bs":"i pijte","en":"and drink"}],"ref":"56:68","answerWord":"تَشْرَبُونَ","answerSound":"audio/04323abbc83a883f3270.m4a","quranTranslation":{"text":"Have ye observed the water which ye drink?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"piti","en":"to drink"},"passage":["أَفَرَءَيْتُمُ","ٱلْمَآءَ","ٱلَّذِى","تَشْرَبُونَ"],"marked":[3],"facts":{"verb":"شَرِبَ"}},{"id":"shariba-83-28-1","words":["verb:shariba"],"options":[{"bs":"pije","en":"he/it drinks"},{"bs":"pio je","en":"he/it drank"},{"bs":"pa su pili","en":"so they drank"},{"bs":"piju","en":"they drink"}],"ref":"83:28","answerWord":"يَشْرَبُ","answerSound":"audio/98ed74d8ebb58f3c3b44.m4a","quranTranslation":{"text":"A spring whence those brought near (to Allah) drink.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"piti","en":"to drink"},"passage":["عَيْنًا","يَشْرَبُ","بِهَا","ٱلْمُقَرَّبُونَ"],"marked":[1],"facts":{"verb":"شَرِبَ"}},{"id":"shariba-19-26-1","words":["verb:shariba"],"options":[{"bs":"i pij!","en":"and drink!"},{"bs":"pio je","en":"he/it drank"},{"bs":"piju","en":"they drink"},{"bs":"pije","en":"he/it drinks"}],"ref":"19:26","answerWord":"وَٱشْرَبِى","answerSound":"audio/4f10a43181108491ae3b.m4a","quranTranslation":{"text":"So eat and drink and be consoled. And if thou meetest any mortal, say: Lo! I have vowed a fast unto the Beneficent, and may not speak this day to any mortal.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"piti","en":"to drink"},"passage":["فَكُلِى","وَٱشْرَبِى","وَقَرِّى","عَيْنًا","فَإِمَّا","تَرَيِنَّ","مِنَ","ٱلْبَشَرِ","أَحَدًا","فَقُولِىٓ","إِنِّى","نَذَرْتُ","لِلرَّحْمَٰنِ","صَوْمًا","فَلَنْ","أُكَلِّمَ","ٱلْيَوْمَ","إِنسِيًّا"],"marked":[1],"facts":{"verb":"شَرِبَ"}},{"id":"shariba-23-33-22","words":["verb:shariba"],"options":[{"bs":"i pije","en":"and he/it drinks"},{"bs":"pio je","en":"he/it drank"},{"bs":"piju","en":"they drink"},{"bs":"i pijte","en":"and drink"}],"ref":"23:33","answerWord":"وَيَشْرَبُ","answerSound":"audio/8c5bf242935160f7d8fd.m4a","quranTranslation":{"text":"And the chieftains of his folk, who disbelieved and denied the meeting of the Hereafter, and whom We had made soft in the life of the world, said: This is only a mortal like you, who eateth of that whereof ye eat and drinketh of that ye drink.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"piti","en":"to drink"},"passage":["وَقَالَ","ٱلْمَلَأُ","مِن","قَوْمِهِ","ٱلَّذِينَ","كَفَرُوا۟","وَكَذَّبُوا۟","بِلِقَآءِ","ٱلْءَاخِرَةِ","وَأَتْرَفْنَٰهُمْ","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","مَا","هَٰذَآ","إِلَّا","بَشَرٌ","مِّثْلُكُمْ","يَأْكُلُ","مِمَّا","تَأْكُلُونَ","مِنْهُ","وَيَشْرَبُ","مِمَّا","تَشْرَبُونَ"],"marked":[22],"facts":{"verb":"شَرِبَ"}},{"id":"shariba-76-5-2","words":["verb:shariba"],"options":[{"bs":"piju","en":"they drink"},{"bs":"i pijte","en":"and drink"},{"bs":"pio je","en":"he/it drank"},{"bs":"pijete","en":"you drink"}],"ref":"76:5","answerWord":"يَشْرَبُونَ","answerSound":"audio/22b5a0d8cbaf22b589af.m4a","quranTranslation":{"text":"Lo! the righteous shall drink of a cup whereof the mixture is of Kafur,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"piti","en":"to drink"},"passage":["إِنَّ","ٱلْأَبْرَارَ","يَشْرَبُونَ","مِن","كَأْسٍ","كَانَ","مِزَاجُهَا","كَافُورًا"],"marked":[2],"facts":{"verb":"شَرِبَ"}},{"id":"ahsana-2-21-91-1","words":["verb:ahsana-2"],"options":[{"bs":"sačuvala je","en":"(she) guarded"},{"bs":"pohranjujete","en":"you (all) store"},{"bs":"udane su","en":"they were married"},{"bs":"da vas štiti","en":"to protect you (all)"}],"ref":"21:91","answerWord":"أَحْصَنَتْ","answerSound":"audio/9449b1d4214f7819c143.m4a","quranTranslation":{"text":"And she who was chaste, therefor We breathed into her (something) of Our Spirit and made her and her son a token for (all) peoples.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"utvrditi, zaštititi, sačuvati (čednost)","en":"to fortify, to protect, to guard (chastity)"},"passage":["وَٱلَّتِىٓ","أَحْصَنَتْ","فَرْجَهَا","فَنَفَخْنَا","فِيهَا","مِن","رُّوحِنَا","وَجَعَلْنَٰهَا","وَٱبْنَهَآ","ءَايَةً","لِّلْعَٰلَمِينَ"],"marked":[1],"facts":{"verb":"أَحْصَنَ"}},{"id":"ahsana-2-12-48-14","words":["verb:ahsana-2"],"options":[{"bs":"pohranjujete","en":"you (all) store"},{"bs":"sačuvala je","en":"(she) guarded"},{"bs":"udane su","en":"they were married"},{"bs":"da vas štiti","en":"to protect you (all)"}],"ref":"12:48","answerWord":"تُحْصِنُونَ","answerSound":"audio/f9e2af0312c6102ad33e.m4a","quranTranslation":{"text":"Then after that will come seven hard years which will devour all that ye have prepared for them, save a little of that which ye have stored.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"utvrditi, zaštititi, sačuvati (čednost)","en":"to fortify, to protect, to guard (chastity)"},"passage":["ثُمَّ","يَأْتِى","مِنۢ","بَعْدِ","ذَٰلِكَ","سَبْعٌ","شِدَادٌ","يَأْكُلْنَ","مَا","قَدَّمْتُمْ","لَهُنَّ","إِلَّا","قَلِيلًا","مِّمَّا","تُحْصِنُونَ"],"marked":[14],"facts":{"verb":"أَحْصَنَ"}},{"id":"mada-8-38-13","words":["verb:mada"],"options":[{"bs":"prošla je","en":"it passed"},{"bs":"i prošao je","en":"and has gone before"},{"bs":"idem","en":"I go on"},{"bs":"i idite!","en":"and (you all) go on!"}],"ref":"8:38","answerWord":"مَضَتْ","answerSound":"audio/f0e975686d201b48f18e.m4a","quranTranslation":{"text":"Tell those who disbelieve that if they cease (from persecution of believers) that which is past will be forgiven them; but if they return (thereto) then the example of the men of old hath already gone (before them, for a warning).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"proći, nastaviti","en":"to pass, to go on"},"passage":["قُل","لِّلَّذِينَ","كَفَرُوٓا۟","إِن","يَنتَهُوا۟","يُغْفَرْ","لَهُم","مَّا","قَدْ","سَلَفَ","وَإِن","يَعُودُوا۟","فَقَدْ","مَضَتْ","سُنَّتُ","ٱلْأَوَّلِينَ"],"marked":[13],"facts":{"verb":"مَضَى"}},{"id":"mada-15-65-11","words":["verb:mada"],"options":[{"bs":"i idite!","en":"and (you all) go on!"},{"bs":"idem","en":"I go on"},{"bs":"i prošao je","en":"and has gone before"},{"bs":"prošla je","en":"it passed"}],"ref":"15:65","answerWord":"وَٱمْضُوا۟","answerSound":"audio/b68ca5a5a19deda02f44.m4a","quranTranslation":{"text":"So travel with thy household in a portion of the night, and follow thou their backs. Let none of you turn round, but go whither ye are commanded.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"proći, nastaviti","en":"to pass, to go on"},"passage":["فَأَسْرِ","بِأَهْلِكَ","بِقِطْعٍ","مِّنَ","ٱلَّيْلِ","وَٱتَّبِعْ","أَدْبَٰرَهُمْ","وَلَا","يَلْتَفِتْ","مِنكُمْ","أَحَدٌ","وَٱمْضُوا۟","حَيْثُ","تُؤْمَرُونَ"],"marked":[11],"facts":{"verb":"مَضَى"}},{"id":"mada-18-60-11","words":["verb:mada"],"options":[{"bs":"idem","en":"I go on"},{"bs":"i prošao je","en":"and has gone before"},{"bs":"i idite!","en":"and (you all) go on!"},{"bs":"prošla je","en":"it passed"}],"ref":"18:60","answerWord":"أَمْضِىَ","answerSound":"audio/71769fa8a688aeb41269.m4a","quranTranslation":{"text":"And when Moses said unto his servant: I will not give up until I reach the point where the two rivers meet, though I march on for ages.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"proći, nastaviti","en":"to pass, to go on"},"passage":["وَإِذْ","قَالَ","مُوسَىٰ","لِفَتَىٰهُ","لَآ","أَبْرَحُ","حَتَّىٰٓ","أَبْلُغَ","مَجْمَعَ","ٱلْبَحْرَيْنِ","أَوْ","أَمْضِىَ","حُقُبًا"],"marked":[11],"facts":{"verb":"مَضَى"}},{"id":"mada-43-8-4","words":["verb:mada"],"options":[{"bs":"i prošao je","en":"and has gone before"},{"bs":"i idite!","en":"and (you all) go on!"},{"bs":"prošla je","en":"it passed"},{"bs":"idem","en":"I go on"}],"ref":"43:8","answerWord":"وَمَضَىٰ","answerSound":"audio/d50dcef70d4ff353e9ac.m4a","quranTranslation":{"text":"Then We destroyed men mightier than these in prowess; and the example of the men of old hath gone (before them).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"proći, nastaviti","en":"to pass, to go on"},"passage":["فَأَهْلَكْنَآ","أَشَدَّ","مِنْهُم","بَطْشًا","وَمَضَىٰ","مَثَلُ","ٱلْأَوَّلِينَ"],"marked":[4],"facts":{"verb":"مَضَى"}}]