 "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4306.mp3", "translation": {"en": {"text": "Or He causeth them to perish on account of that which they have earned - And He forgiveth much -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yahut da Allah kazandıkları günahlar yüzünden onları helâk eder ve birçoğunu da bağışlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا انہیں تباہ کردے لوگوں کے گناہوں کے سبب اور بہت معاف فرمادے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "atau kapal-kapal itu dibinasakan-Nya karena perbuatan mereka atau Dia memberi maaf sebagian besar (dari mereka).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُوبِقْهُنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَسَبُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَعْفُ", "hit": true, "audio": "audio/30bf522b68b3d1da912f.m4a", "gloss": {"bs": "i oprašta", "en": "and He pardons", "tr": "ve bağışlar", "fr": "et Il pardonne", "id": "dan Dia memaafkan", "ur": "اور وہ درگزر کرتا ہے", "bn": "এবং তিনি ক্ষমা করেন", "fa": "و عفو می‌کند"}}, {"text": "عَن", "hit": false, "audio": null, "gloss": null}, {"text": "كَثِيرٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "2:52", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/59.mp3", "translation": {"en": {"text": "Then, even after that, We pardoned you in order that ye might give thanks.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra yine de sizi affettik, artık şükretmeniz gerekiyordu.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر اس کے بعد ہم نے تمہیں معافی دی کہ کہیں تم احسان مانو -", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian sesudah itu Kami maafkan kesalahanmu, agar kamu bersyukur.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "عَفَوْنَا", "hit": true, "audio": "audio/5c6a248480cd1a15cad3.m4a", "gloss": {"bs": "oprostili smo", "en": "We pardoned", "tr": "bağışladık", "fr": "Nous avons pardonné", "id": "Kami memaafkan", "ur": "ہم نے معاف کر دیا", "bn": "আমরা ক্ষমা করেছি", "fa": "عفو کردیم"}}, {"text": "عَنكُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْدِ", "hit": false, "audio": null, "gloss": null}, {"text": "ذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَشْكُرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "عَفَا", "count": 6, "first": "3:152", "audio": "audio/171d326bbee92c3b4b9b.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it pardoned", "bs": "oprostio je", "tr": "bağışladı", "fr": "il a pardonné", "id": "dia telah mengampuni", "ur": "اُس نے معاف کیا", "bn": "সে ক্ষমা করল", "fa": "آمرزید"}}, {"arabic": "وَيَعْفُوا۟", "count": 3, "first": "5:15", "audio": "audio/eb983af10f3a1652826a.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and he/it pardons", "bs": "i oprašta", "tr": "ve bağışlar", "fr": "et il pardonne", "id": "dan dia mengampuni", "ur": "اور وہ معاف کرتا ہے", "bn": "এবং সে ক্ষমা করে", "fa": "و می‌آمرزد"}}, {"arabic": "فَٱعْفُ", "count": 2, "first": "3:159", "audio": "audio/246c7de6ca0660a1e840.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "so pardon!", "bs": "pa 