oss": {"bs": "su zaslužili", "en": "they have earned", "tr": "kazandılar", "fr": "ils ont acquis", "id": "mereka telah memperoleh", "ur": "انہوں نے کمایا ہے", "bn": "তারা অর্জন করেছে", "fa": "کسب کرده‌اند"}}, {"text": "فَقَدِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱحْتَمَلُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "بُهْتَٰنًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِثْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "مُّبِينًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ٱكْتَسَبُوا۟", "count": 2, "first": "4:32", "audio": "audio/05b6caf819425fb029b0.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "su zaslužili", "en": "they have earned", "tr": "kazandılar", "fr": "ils ont mérité", "id": "mereka telah mengusahakan", "ur": "انہوں نے کمایا ہے", "bn": "তারা অর্জন করেছে", "fa": "کسب کرده‌اند"}}, {"arabic": "ٱكْتَسَبَتْ", "count": 1, "first": "2:286", "audio": "audio/3b27c00d19029a5d6e99.m4a", "grammar": [{"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}], "gloss": {"en": "she/it earned", "bs": "stekla je", "tr": "kazandı", "fr": "elle a acquis", "id": "dia telah mengusahakan", "ur": "اُس نے کمایا", "bn": "সে অর্জন করেছে", "fa": "کسب کرد"}}, {"arabic": "ٱكْتَسَبْنَ", "count": 1, "first": "4:32", "audio": "audio/dfdc6c4a388709dd0ca1.m4a", "grammar": [{"tense": "past", "pronoun": "hunna", "passive": false, "objects": []}], "gloss": {"en": "they earned", "bs": "stekle su", "tr": "kazandılar", "fr": "elles ont acquis", "id": "mereka telah mengusahakan", "ur": "انہوں نے کمایا", "bn": "তারা অর্জন করেছে", "fa": "کسب کردند"}}, {"arabic": "ٱكْتَسَبَ", "count": 1, "first": "24:11", "audio": "audio/d878ee73ae760e1f49a7.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "he/it earned", "bs": "stekao je", "tr": "kazandı", "fr": "il a acquis", "id": "dia telah me