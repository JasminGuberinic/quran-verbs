{"rank": 76, "root": "شكر", "form": 1, "lemma": "شَكَرَ", "count": 46, "ayahCount": 42, "share": 0.24, "meaning": {"bs": "zahvaliti, biti zahvalan", "en": "to thank, to be grateful", "tr": "şükretmek, minnettar olmak", "fr": "remercier, être reconnaissant", "id": "bersyukur", "ur": "شکر کرنا، شکرگزار ہونا", "bn": "শুকরিয়া আদায় করা, কৃতজ্ঞ হওয়া", "fa": "سپاس گفتن، شکرگزاری کردن"}, "lemmaSpoken": "audio/f8d0670af0f1eee53bfc.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "شَكَرَ", "plain": "شَكَرَ", "quran": true, "notUsed": false, "spoken": "audio/f8d0670af0f1eee53bfc.m4a", "recited": "audio/632c2e512e7f26eae524.m4a", "recitedText": "شَكَرَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَشْكُرُ", "plain": "يَشْكُرُ", "quran": true, "notUsed": false, "spoken": "audio/ba6755b5309f31235430.m4a", "recited": "audio/089d9b98ab12aa3f68c2.m4a", "recitedText": "يَشْكُرُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱشْكُرْ", "plain": "اُشْكُرْ", "quran": true, "notUsed": false, "spoken": "audio/94802a1549c461563edc.m4a", "recited": "audio/4d6f5ba20fcd627c03b9.m4a", "recitedText": "ٱشْكُرْ"}], "nouns": {"participle": {"lemma": "شاكِر", "count": 14, "spoken": "audio/de26a5ab79fb6c16cf59.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "شَكَرْتُ", "plain": "شَكَرْتُ", "quran": false, "notUsed": false, "spoken": "audio/e1c2d3336ca43168ad8e.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "شَكَرْنَا", "plain": "شَكَرْنَا", "quran": false, "notUsed": false, "spoken": "audio/904dab88a75cbef44f0d.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "شَكَرْتَ", "plain": "شَكَرْتَ", "quran": false, "notUsed": false, "spoken": "audio/799f5f1fc77c5265d279.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "شَكَرْتِ", "plain": "شَكَرْتِ", "quran": false, "notUsed": false, "spoken": "audio/87499e35e7996ecd0251.m4