ects": ["huwa"]}], "gloss": {"bs": "pa ga je odabrao", "en": "so He chose him", "tr": "böylece onu seçti", "fr": "alors Il l'a choisi", "id": "maka Dia memilihnya", "ur": "پھر اس نے اسے چن لیا", "bn": "তখন তিনি তাকে মনোনীত করলেন", "fa": "پس او را برگزید"}}], "ayatFile": "ayat/0296.json", "ayatTranslations": {"en": "ayat/0296.en.json", "tr": "ayat/0296.tr.json", "ur": "ayat/0296.ur.json", "id": "ayat/0296.id.json"}, "sentences": [{"arabic": "يَجْتَبِي الْمُدَرِّبُ أَفْضَلَ اللَّاعِبِينَ", "spoken": "audio/70b31a6557d64f688d11.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Trener odabire najbolje igrače.", "en": "The coach chooses the best players.", "bn": "প্রশিক্ষক সেরা খেলোয়াড়দের বেছে নেন।", "fa": "مربی بهترین بازیکنان را برمی‌گزیند.", "fr": "L'entraîneur choisit les meilleurs joueurs.", "id": "Pelatih memilih pemain-pemain terbaik.", "tr": "Antrenör en iyi oyuncuları seçer.", "ur": "کوچ بہترین کھلاڑی چنتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَجْتَبِي", "target": true, "translation": {"bs": "odabire", "en": "chooses", "bn": "বেছে নেয়", "fa": "برمی‌گزیند", "fr": "choisit", "id": "memilih", "tr": "seçer", "ur": "وہ چنتا ہے"}}, {"arabic": "الْمُدَرِّبُ", "target": false, "translation": {"bs": "trener", "en": "the coach", "bn": "প্রশিক্ষক", "fa": "مربی", "fr": "l'entraîneur", "id": "pelatih", "tr": "antrenör", "ur": "کوچ"}}, {"arabic": "أَفْضَلَ", "target": false, "translation": {"bs": "najbolje", "en": "best", "bn": "সেরা", "fa": "بهترین", "fr": "le meilleur", "id": "yang terbaik", "tr": "en iyi", "ur": "بہترین"}}, {"arabic": "اللَّاعِبِينَ", "target": false, "translation": {"bs": "igrače", "en": "the players", "bn": "খেলোয়াড়রা", "fa": "بازیکنان", "fr": "les joueurs", "id": "para pemain", "tr": "oyuncuları", "ur": "کھلاڑیوں"}}]}, {"arabic": "اِجْتَبَيْنَا أَجْمَلَ الصُّوَرِ", "spoken": "audio/1d0bb237f85885aaea3c.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Odabrali smo najljepše slike.", "en": "We chose the most beautiful pictures.", "bn": "আমরা সবচেয়ে সুন্দর ছবিগুলো বেছে নিলাম।", "fa": "زیباترین عکس‌ها را برگزیدیم.", "fr": "Nous avons choisi les plus belles images.", "id": "Kami memilih gambar-gambar yang paling indah.", "tr": "En güzel resimleri seçtik.", "ur": "ہم نے سب سے خوبصورت تصویریں چنیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِجْتَبَيْنَا", "target": true, "translation": {"bs": "odabrali smo", "en": "we chose", "bn": "আমরা বেছে নিলাম", "fa": "برگزیدیم", "fr": "nous avons choisi", "id": "kami memilih", "tr": "seçtik", "ur": "ہم نے چنا"}}, {"arabic": "أَجْمَلَ", "target": false, "translation": {"bs": "najljepše", "en": "most beautiful", "bn": "সবচেয়ে সুন্দর", "fa": "زیباترین", "fr": "le plus beau", "id": "yang paling indah", "tr": "en güzel", "ur": "سب سے خوبصورت"}}, {"arabic": "الصُّوَرِ", "target": false, "translation": {"bs": "slike", "en": "the pictures", "bn": "ছবিগুলো", "fa": "عکس‌ها", "fr": "les images", "id": "gambar-gambar", "tr": "resimler", "ur": "تصویریں"}}]}]}