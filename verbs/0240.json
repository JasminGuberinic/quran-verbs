, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِئْبَيَا", "plain": "اِئْبَيَا", "quran": false, "notUsed": false, "spoken": "audio/83b65a97a7da6688930a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِئْبَوْا", "plain": "اِئْبَوْا", "quran": false, "notUsed": false, "spoken": "audio/dae71e253fa5bfd5ee01.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِئْبَيْنَ", "plain": "اِئْبَيْنَ", "quran": false, "notUsed": false, "spoken": "audio/3e80654d7f3fe0487912.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "20:56", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2404.mp3", "translation": {"en": {"text": "And We verily did show him all Our tokens, but he denied them and refused.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "And olsun ki, biz, Firavun'a mucizelerimizin hepsini gösterdik. Böyle iken o yine onları yalan sayıp kabulden çekindi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے اسے اپنی سب نشانیاں دکھائیں تو اس نے جھٹلایا اور نہ مانا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya Kami telah perlihatkan kepadanya (Fir'aun) tanda-tanda kekuasaan Kami semuanya maka ia mendustakan dan enggan (menerima kebenaran).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرَيْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُلَّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَكَذَّبَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَبَىٰ", "hit": true, "audio": "audio/e3bb2a2d5d3eb939add4.m4a", "gloss": {"bs": "i odbio je", "