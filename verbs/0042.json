n": "يُطِعْنَ", "quran": false, "notUsed": false, "spoken": "audio/20202c316adc8562a7cb.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَطِعْ", "plain": "أَطِعْ", "quran": false, "notUsed": false, "spoken": "audio/5bb6ba90fdce22ec5174.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَطِيعِي", "plain": "أَطِيعِي", "quran": false, "notUsed": false, "spoken": "audio/10c6cbbefa0d9b176f9c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَطِيعَا", "plain": "أَطِيعَا", "quran": false, "notUsed": false, "spoken": "audio/aa47bc035369e6aaa0fa.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَطِيعُوا۟", "plain": "أَطِيعُوا", "quran": true, "notUsed": false, "spoken": "audio/6b14c959bf3058b3f5bc.m4a", "recited": "audio/09a28073aadef864b34d.m4a", "recitedText": "أَطِيعُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَطِعْنَ", "plain": "أَطِعْنَ", "quran": true, "notUsed": false, "spoken": "audio/bc678cf22ec06c2d57b3.m4a", "recited": "audio/3fd5033ed13cacf224a0.m4a", "recitedText": "وَأَطِعْنَ"}], "ayat": [{"ref": "26:108", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3040.mp3", "translation": {"en": {"text": "So keep your duty to Allah, and obey me.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Gelin artık, Allah'tan korkun ve bana itaat edin.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اللہ سے ڈرو اور میرا حکم مانو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "maka bertakwalah kepada Allah dan taatlah kepadaku.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱتَّقُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَطِيعُونِ", "hit": true, "audio": "audio/1579621f63196f7b70ee.m4a", "gloss": {"bs": "i mene slušajte!", "en": "and obey me!", "tr": "ve bana itaat edin!", "fr": "et obéissez-moi !", "id": "dan taatlah kepadaku!", "ur": "اور میری اطاعت کرو!", "bn": "এবং আমার আনুগত্য করো!", "fa": "و از من اطاعت کنید!"}}]}, {"ref": "33:67", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3600.mp3", "translation": {"en": {"text": "And they say: Our Lord! Lo! we obeyed our princes and great men, and they misled us from the Way.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yine derler ki: \"Ey Rabbimiz! Biz beylerimize ve büyüklerimize itaat ettik de bizi yanlış yola götürdüler.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور کہیں گے اے ہمارے رب! ہم اپنے سرداروں اور اپنے بڑوں کے کہنے پر چلے تو انہوں نے ہمیں راہ سے بہکادیا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka berkata: \"Ya Tuhan kami, sesungguhnya kami telah mentaati pemimpin-pemimpin dan pembesar-pembesar kami, lalu mereka menyesatkan kami dari jalan (yang benar).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَطَعْنَا", "hit": true, "audio": "audio/09f63a1e419cef77bf92.m4a", "gloss": {"en": "we obeyed", "bs": "poslušali smo", "tr": "itaat ettik", "fr": "nous avons obéi", "id": "kami telah taat", "ur": "ہم نے اطاعت کی", "bn": "আমরা মান্য করেছি", "fa": "اطاعت کردیم"}}, {"text": "سَادَتَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَكُبَرَآءَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَضَلُّونَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّبِيلَا۠", "hit": false, "audio": null, "gloss": null}]}, {"ref": "68:8", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5279.mp3", "translation": {"en": {"text": "Therefor obey not thou the rejecters", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O halde, yalanlayıcılara itaat etme.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو جھٹلانے والوں کی بات نہ سننا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka janganlah kamu ikuti orang-orang yang mendustakan (ayat-ayat Allah).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُطِعِ", "hit": true, "audio": "audio/2529f0e987e98f24d9be.m4a", "gloss": {"bs": "(ne) slušaj", "en": "(do not) obey", "tr": "itaat etme", "fr": "(n')obéis (pas)", "id": "(jangan) taat", "ur": "(اطاعت) مت کر", "bn": "(তুমি) আনুগত্য করো না", "fa": "اطاعت مکن"}}, {"text": "ٱلْمُكَذِّبِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "24:52", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2843.mp3", "translation": {"en": {"text": "He who obeyeth Allah and His messenger, and feareth Allah, and keepeth duty (unto Him): such indeed are the victorious.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Her kim Allah'a ve Resulüne itaat eder, Allah'a saygı duyar ve O'ndan sakınırsa, işte asıl bunlar bedbahtlıktan kurtulanlardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جو حکم مانے اللہ اور اس کے رسول کا اور اللہ سے ڈرے اور پرہیزگاری کرے تو یہی لوگ کامیاب ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan barang siapa yang taat kepada Allah dan rasul-Nya dan takut kepada Allah dan bertakwa kepada-Nya, maka mereka adalah orang-orang yang mendapat kemenangan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "يُطِعِ", "hit": true, "audio": "audio/9dbf7de741830d2cef18.m4a", "gloss": {"en": "he/it obeys", "bs": "sluša", "tr": "itaat eder", "fr": "il obéit", "id": "dia taat", "ur": "وہ اطاعت کرتا ہے", "bn": "সে মান্য করে", "fa": "اطاعت کند"}}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَرَسُولَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَخْشَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَتَّقْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْفَآئِزُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:151", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3083.mp3", "translation": {"en": {"text": "And obey not the command of the prodigal,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Yeryüzünde bozgunculuk yapıp dirlik düzenlik vermeyen bozguncuların emrine uymayın.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور حد سے بڑھنے والوں کے کہنے پر نہ چلو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan janganlah kamu mentaati perintah orang-orang yang melewati batas,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُطِيعُوٓا۟", "hit": true, "audio": "audio/0eb4ebdc6fc3494ef8bb.m4a", "gloss": {"en": "you (all) obey", "bs": "slušate", "tr": "itaat edersiniz", "fr": "vous obéissez", "id": "kalian taat", "ur": "تم سب اطاعت کرو", "bn": "তোমরা মান্য কর", "fa": "اطاعت کنید"}}, {"text": "أَمْرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُسْرِفِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:34", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2707.mp3", "translation": {"en": {"text": "If ye were to obey a mortal like yourselves, then, lo! ye surely would be losers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Gerçekten, tıpkı kendiniz gibi bir beşere itaat ederseniz herhalde ziyan edersiniz.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر تم کسی اپنے جیسے آدمی کی اطاعت کرو جب تو تم ضرور گھاٹے میں ہو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya jika kamu sekalian mentaati manusia yang seperti kamu, niscaya bila demikian, kamu benar-benar (menjadi) orang-orang yang merugi.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَئِنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَطَعْتُم", "hit": true, "audio": "audio/942a208ca6da2f05ed2b.m4a", "gloss": {"bs": "(ako) poslušate", "en": "(if) you obey", "tr": "(eğer) itaat ederseniz", "fr": "(si) vous obéissez", "id": "(jika) kamu taat", "ur": "(اگر) تم اطاعت کرو", "bn": "(যদি) তোমরা আনুগত্য করো", "fa": "(اگر) اطاعت کنید"}}, {"text": "بَشَرًا", "hit": false, "audio": null, "gloss": null}, {"text": "مِّثْلَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذًا", "hit": false, "audio": null, "gloss": null}, {"text": "لَّخَٰسِرُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَأَطِيعُوا۟", "count": 13, "first": "3:132", "audio": "audio/4793ee67a96878dedf68.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) obey!", "bs": "i poslušajte!", "tr": "ve itaat edin!", "fr": "et obéissez !", "id": "dan taatlah kalian!", "ur": "اور تم سب اطاعت کرو!", "bn": "এবং তোমরা মান্য কর!", "fa": "و اطاعت کنید!"}}, {"arabic": "وَأَطِيعُونِ", "count": 11, "first": "3:50", "audio": "audio/5ef967a7126ea56c3f1a.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["ana"]}], "gloss": {"bs": "i mene slušajte!", "en": "and obey me!", "tr": "ve bana itaat edin!", "fr": "et obéissez-moi !", "id": "dan taatlah kepadaku!", "ur": "اور میری اطاعت کرو!", "bn": "এবং আমার আনুগত্য করো!", "fa": "و از من اطاعت کنید!"}}, {"arabic": "وَأَطَعْنَا", "count": 6, "first": "2:285", "audio": "audio/463daf2b5fa2805fc2ee.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "and we obeyed", "bs": "i poslušali smo", "tr": "ve itaat ettik", "fr": "et nous avons obéi", "id": "dan kami telah taat", "ur": "اور ہم نے اطاعت کی", "bn": "এবং আমরা মান্য করেছি", "fa": "و اطاعت کردیم"}}, {"arabic": "يُطِعِ", "count": 6, "first": "4:13", "audio": "audio/6ceb2b290f022459d547.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "he/it obeys", "bs": "sluša", "tr": "itaat eder", "fr": "il obéit", "id": "dia taat", "ur": "وہ اطاعت کرتا ہے", "bn": "সে মান্য করে", "fa": "اطاعت کند"}}, {"arabic": "أَطِيعُوا۟", "count": 5, "first": "3:32", "audio": "audio/09a28073aadef864b34d.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "(you all) obey!", "bs": "poslušajte!", "tr": "itaat edin!", "fr": "obéissez !", "id": "taatlah kalian!", "ur": "اطاعت کرو!", "bn": "তোমরা মান্য কর!", "fa": "اطاعت کنید!"}}, {"arabic": "تُطِيعُوا۟", "count": 4, "first": "3:100", "audio": "audio/6802ac33911b30f8f293.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood":