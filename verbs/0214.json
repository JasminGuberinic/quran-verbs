tUsed": false, "spoken": "audio/19e2ec949cf5d03d263e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱنتَهُوا۟", "plain": "اِنْتَهُوا", "quran": true, "notUsed": false, "spoken": "audio/91c797c8a46d8190597c.m4a", "recited": "audio/b2c5697cc01203739e90.m4a", "recitedText": "ٱنتَهُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِنْتَهِينَ", "plain": "اِنْتَهِينَ", "quran": false, "notUsed": false, "spoken": "audio/db7297cce97c2a34d6b5.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "2:192", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/199.mp3", "translation": {"en": {"text": "But if they desist, then lo! Allah is Forgiving, Merciful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Artık şirkten vazgeçerlerse, şüphesiz ki Allah çok bağışlayıcıdır, çok merhamet edicidir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر اگر وہ باز رہیں تو بیشک اللہ بخشنے والا مہربان ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian jika mereka berhenti (dari memusuhi kamu), maka sesungguhnya Allah Maha Pengampun lagi Maha Penyayang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَإِنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱنتَهَوْا۟", "hit": true, "audio": "audio/9e7bfe534721b11607b6.m4a", "gloss": {"bs": "prestanu", "en": "they desist", "tr": "vazgeçerler", "fr": "ils cessent", "id": "mereka berhenti", "ur": "وہ باز آ جائیں", "bn": "তারা বিরত থাকে", "fa": "بازایستند"}}, {"text": "فَإِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "غَفُورٌ", "hit": false, "audio": null, "gloss": null}, {"text": "رَّحِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:116", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3048.mp3", "translation": {"en": {"text": "They said: If thou cease not, O Noah, thou wilt surely be among those stoned (to death).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Dediler ki: \"Ey Nuh! Eğer vazgeçmezsen, iyi bil ki, taşa tutulanlardan olacaksın!\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے اے نوح! اگر تم باز نہ آئے تو ضرور سنگسار کیے جاؤ گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka berkata: \"Sungguh jika kamu tidak (mau) berhenti hai Nuh, niscaya benar-benar kamu akan termasuk orang-orang yang dirajam\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَئِن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَنتَهِ", "hit": true, "audio": "audio/23378e8c155e89341a9b.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "jussive"}]}, {"text": "يَٰنُوحُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَتَكُونَنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمَرْجُومِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:18", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3723.mp3", "translation": {"en": {"text": "(The people of the city) said: We augur ill of you. If ye desist not, we shall surely stone you, and grievous torture will befall you at our hands.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar dediler ki: \"Herhalde biz sizin yüzünüzden uğursuzluğa uğradık. Eğer bu işten vazgeçmezseniz, andolsun ki, sizi hiç tınmadan taşlarız ve mutlaka bizden size pek acıklı bir azab dokunur.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولے ہم تمہیں منحوس سمجھتے ہیں بیشک اگر تم باز نہ آئے تو ضرور ہم تمہیں سنگسار کریں گے بیشک ہمارے ہاتھوں تم پر دکھ کی مار پڑے گی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka menjawab: \"Sesungguhnya kami bernasib malang karena kamu, sesungguhnya jika kamu tidak berhenti (menyeru kami), niscaya kami akan merajam kamu dan kamu pasti akan mendapat siksa yang pedih dari kami\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تَطَيَّرْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "بِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَئِن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَنتَهُوا۟", "hit": true, "audio": "audio/e31da1f8deec97e27999.m4a", "gloss": {"en": "you (all) stop", "bs": "prestajete", "tr": "durursunuz", "fr": "vous cessez", "id": "kalian berhenti", "ur": "تم سب رک جاتے ہو", "bn": "তোমরা থামো", "fa": "بازایستید"}}, {"text": "لَنَرْجُمَنَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَيَمَسَّنَّكُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابٌ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "96:15", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6121.mp3", "translation": {"en": {"text": "Nay, but if he cease not We will seize him by the forelock -", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Hayır, hayır! Eğer o, bu davranışından vazgeçmezse, and olsun ki biz, onu perçeminden, o günahkâr ve yalancı perçeminden tutup cehenneme sürükleriz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہاں ہاں اگر باز نہ آیا تو ضرور ہم پیشانی کے بال پکڑ کر کھینچیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ketahuilah, sungguh jika dia tidak berhenti (berbuat demikian) niscaya Kami tarik ubun-ubunnya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَئِن", "hit": false, "audio": null, "gloss": null}, {"text": "لَّمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَنتَهِ", "hit": true, "audio": "audio/f9600d8925f852f2a37f.m4a", "gloss": {"bs": "prestane", "en": "he desists", "tr": "vazgeçer", "fr": "il cesse", "id": "dia berhenti", "ur": "وہ باز آ جائے", "bn": "সে বিরত থাকে", "fa": "بازایستد"}}, {"text": "لَنَسْفَعًۢا", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلنَّاصِيَةِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ٱنتَهَوْا۟", "count": 3, "first": "2:192", "audio": "audio/9e7bfe534721b11607b6.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "prestanu", "en": "they desist", "tr": "vazgeçerler", "fr": "ils cessent", "id": "mereka berhenti", "ur": "وہ باز آ جائیں", "bn": "তারা বিরত থাকে", "fa": "بازایستند"}}, {"arabic": "تَنتَهِ", "count": 3, "first": "19:46", "audio": "audio/07edabc132ad1fbd8ba8.m4a", "grammar": [{"tense": "present", "pronoun": "anta", "passive": false, "objects": [], "mood": "jussive"}]}, {"arabic": "يَنتَهُوا۟", "count": 2, "first": "5:73", "audio": "audio/29cc9da4cf56cd5fcaf8.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "they stop", "bs": "prestaju", "tr": "dururlar", "fr": "ils cessent", "id": "mereka berhenti", "ur": "وہ رک جاتے ہیں", 