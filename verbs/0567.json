ranslation": {"en": {"text": "And every nation hath its term, and when its term cometh, they cannot put it off an hour nor yet advance (it).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Her ümmetin bir eceli vardır. O ecel geldiğinde, ne bir ân erteleyebilirler, ne de öne alabilirler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہر گروہ کا ایک وعدہ ہے تو جب ان کا وعدہ آئے گا ایک گھڑی نہ پیچھے ہو نہ آگے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tiap-tiap umat mempunyai batas waktu; maka apabila telah datang waktunya mereka tidak dapat mengundurkannya barang sesaatpun dan tidak dapat (pula) memajukannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلِكُلِّ", "hit": false, "audio": null, "gloss": null}, {"text": "أُمَّةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجَلٌ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "جَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجَلُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَأْخِرُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَاعَةً", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَقْدِمُونَ", "hit": true, "audio": "audio/0d4b42a87943e168d54c.m4a", "gloss": {"bs": "preteći", "en": "advance", "tr": "öne geç", "fr": "devancent", "id": "mendahului", "ur": "وہ آگے بڑھتے ہیں", "bn": "তারা এগিয়ে যায়", "fa": "پیش‌دستی کنند"}}]}, {"ref": "34:30", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3636.mp3", "translation": {"en": {"text": "Say (O Muhammad): Yours is the promise of a Day which ye cannot postpone nor hasten by an hour.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki: \"Size vaad edilen öyle bir gündür ki, ondan ne bir an geri kalabilirsiniz, ne de ileri geçebilirsiniz.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ تمہارے لیے ایک ایسے دن کا وعدہ جس سے تم نہ ایک گھڑی پیچھے ہٹ سکو اور نہ آگے بڑھ سکو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah: \"Bagimu ada hari yang telah dijanjikan (hari kiamat) yang tiada dapat kamu minta mundur daripadanya barang sesaatpun dan tidak (pula) kamu dapat meminta supaya diajukan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُل", "hit": false, "audio": null, "gloss": null}, {"text": "لَّكُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّيعَادُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمٍ", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْتَـْٔخِرُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "سَاعَةً", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْتَقْدِمُونَ", "hit": true, "audio": "audio/f3058ab76c7be82beb01.m4a", "gloss": {"bs": "preteći", "en": "advance", "tr": "öne geç", "fr": "devancez", "id": "mendahului", "ur": "تم آگے بڑھتے ہو", "bn": "তোমরা এগিয়ে যাও", "fa": "پیش‌دستی کنید"}}]}], "forms": [{"arabic": "يَسْتَقْدِمُونَ", "count": 3, "first": "7:34", "audio": "audio/0d4b42a87943e168d54c.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "preteći", "en": "advance", "tr": "ilerlerler", "fr": "ils avancent", "id": "mereka maju", "ur": "آگے بڑھو", "bn": "অগ্রসর হও", "fa": "پیشی می‌گیرند"}}, {"arabic": "تَسْتَقْدِمُونَ", "count": 1, "first": "34:30", "audio": "audio/f3058ab76c7be82beb01.m4a", "grammar": [{"tense": "pr