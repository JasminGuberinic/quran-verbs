{"ayat":[{"ref":"70:1","number":5376,"text":"سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ","hits":[0,1,2]},{"ref":"70:2","number":5377,"text":"لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ","hits":[0,1,2]},{"ref":"70:3","number":5378,"text":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ","hits":[0]},{"ref":"70:4","number":5379,"text":"تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ","hits":[0,1,2,3,4,5,6,7,10]},{"ref":"70:5","number":5380,"text":"فَٱصْبِرْ صَبْرًا جَمِيلًا","hits":[0,1,2]},{"ref":"70:6","number":5381,"text":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا","hits":[0,1,2]},{"ref":"70:7","number":5382,"text":"وَنَرَىٰهُ قَرِيبًا","hits":[1]},{"ref":"70:8","number":5383,"text":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ","hits":[2]},{"ref":"70:9","number":5384,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ","hits":[1]},{"ref":"70:10","number":5385,"text":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا","hits":[0]},{"ref":"70:11","number":5386,"text":"يُبَصَّرُونَهُمْ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ","hits":[1,2,3,4,8]},{"ref":"70:12","number":5387,"text":"وَصَٰحِبَتِهِۦ وَأَخِيهِ","hits":[1]},{"ref":"70:13","number":5388,"text":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ","hits":[1,2]},{"ref":"70:14","number":5389,"text":"وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ","hits":[0,2,4,5]},{"ref":"70:15","number":5390,"text":"كَلَّآ إِنَّهَا لَظَىٰ","hits":[0]},{"ref":"70:16","number":5391,"text":"نَزَّاعَةً لِّلشَّوَىٰ","hits":[]},{"ref":"70:17","number":5392,"text":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ","hits":[0,2,3]},{"ref":"70:18","number":5393,"text":"وَجَمَعَ فَأَوْعَىٰٓ","hits":[0]},{"ref":"70:19","number":5394,"text":"إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا","hits":[1,2]},{"ref":"70:20","number":5395,"text":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا","hits":[0,1,2]},{"ref":"70:21","number":5396,"text":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا","hits":[2]},{"ref":"70:22","number":5397,"text":"إِلَّا ٱلْمُصَلِّينَ","hits":[0,1]},{"ref":"70:23","number":5398,"text":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ","hits":[0,1,2,3]},{"ref":"70:24","number":5399,"text":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ","hits":[2,3,4]},{"ref":"70:25","number":5400,"text":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ","hits":[1]},{"ref":"70:26","number":5401,"text":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ","hits":[1,3]},{"ref":"70:27","number":5402,"text":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ","hits":[4]},{"ref":"70:28","number":5403,"text":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ","hits":[]},{"ref":"70:29","number":5404,"text":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ","hits":[]},{"ref":"70:30","number":5405,"text":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ","hits":[2,3,4,5,6]},{"ref":"70:31","number":5406,"text":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ","hits":[1,3,4]},{"ref":"70:32","number":5407,"text":"وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ","hits":[2,3]},{"ref":"70:33","number":5408,"text":"وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ","hits":[2]},{"ref":"70:34","number":5409,"text":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ","hits":[4]},{"ref":"70:35","number":5410,"text":"أُو۟لَٰٓئِكَ فِى جَنَّٰتٍ مُّكْرَمُونَ","hits":[2]},{"ref":"70:36","number":5411,"text":"فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ","hits":[2]},{"ref":"70:37","number":5412,"text":"عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","hits":[0]},{"ref":"70:38","number":5413,"text":"أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ","hits":[0,2,4,5,7]},{"ref":"70:39","number":5414,"text":"كَلَّآ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ","hits":[4]},{"ref":"70:40","number":5415,"text":"فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ","hits":[1,3,6]},{"ref":"70:41","number":5416,"text":"عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ","hits":[2,6]},{"ref":"70:42","number":5417,"text":"فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ","hits":[0,1,2,3,6,7]},{"ref":"70:43","number":5418,"text":"يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ","hits":[1,5]},{"ref":"70:44","number":5419,"text":"خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ","hits":[1,2,3]}]}