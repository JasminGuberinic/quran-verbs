: "audio/75f3ca907a849a54bca7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "تَفَرَّقْ", "plain": "تَفَرَّقْ", "quran": false, "notUsed": false, "spoken": "audio/bbf4b842e21c99c68d2f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "تَفَرَّقِي", "plain": "تَفَرَّقِي", "quran": false, "notUsed": false, "spoken": "audio/0cafbef023d40f9bedc3.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "تَفَرَّقَا", "plain": "تَفَرَّقَا", "quran": false, "notUsed": false, "spoken": "audio/fb85cf6deb370af1409a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "تَفَرَّقُوا", "plain": "تَفَرَّقُوا", "quran": false, "notUsed": false, "spoken": "audio/87039705d081069210ef.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "تَفَرَّقْنَ", "plain": "تَفَرَّقْنَ", "quran": false, "notUsed": false, "spoken": "audio/62e335b43cc51030ebec.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "4:130", "tense": "present", "category": {"tense": "present", "pronoun": "huma", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/623.mp3", "translation": {"en": {"text": "But if they separate, Allah will compensate each out of His abundance. Allah is ever All-Embracing, All-Knowing.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer karıkoca birbirlerinden ayrılacak olurlarsa, Allah, onların her birini geniş lutfuyla muhtaç bırakmaz. Allah'ın lutfu geniştir, hikmeti büyüktür.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر وہ دونوں جدا ہوجائیں تو اللہ اپنی کشائش سے تم میں ہر ایک کو دوسرے سے بے نیاز کردے گا اور اللہ کشائش والا حکمت والا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Jika keduanya bercerai, maka Allah akan memberi kecukupan kepada masing-masingnya dari limpahan karunia-Nya. Dan adalah Allah Maha Luas (karunia-Nya) lagi Maha Bijaksana.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِن", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَفَرَّقَا", "hit": true, "audio": "audio/2bad9b91e2875c18046a.m4a", "gloss": {"en": "they (two) separate", "bs": "rastanu se", "tr": "ayrılırlar", "fr": "qu'ils (deux) se séparent", "id": "mereka berdua berpisah", "ur": "وہ دونوں جدا ہوتے ہیں", "bn": "তারা দুজন পৃথক হয়", "fa": "جدا شوند"}}, {"text": "يُغْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "كُلًّا", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "سَعَتِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "وَكَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٰسِعًا", "hit": false, "audio": null, "gloss": null}, {"text": "حَكِيمًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "30:14", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3423.mp3", "translation": {"en": {"text": "In the day when the Hour cometh, in that day they will be sundered.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kıyamet saatinin gelip çattığı gün varya, o gün (inananlarla inanmayanlar) ayrılırlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جس دن قیامت قائم ہوگی اس دن الگ ہوجائیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan pada hari terjadinya kiamat, di hari itu mereka (manusia) bergolong-golongan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَقُومُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّاعَةُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَئِذٍ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَفَرَّقُونَ", "hit": true, "audio": "audio/b907e558b769db4453d7.m4a", "gloss": {"bs": "razdvojit će se", "en": "they will be separated", "tr": "ayrılacaklar", "fr": "ils seront séparés", "id": "mereka akan terpisah", "ur": "وہ جدا جدا ہو جائیں گے", "bn": "তারা বিচ্ছিন্ন হয়ে যাবে", "fa": "پراکنده خواهند شد"}}]}, {"ref": "98:4", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6134.mp3", "translation": {"en": {"text": "Nor were the People of the Scripture divided until after the clear proof came unto them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kitap ehli, ancak kendilerine apaçık delil geldikten sonra ayrılığa düştüler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور پھوٹ نہ پڑی کتاب والوں میں مگر بعد اس کے کہ وہ روشن دلیل ان کے پاس تشریف لائے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan tidaklah berpecah belah orang-orang yang didatangkan Al Kitab (kepada mereka) melainkan sesudah datang kepada mereka bukti yang nyata.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَفَرَّقَ", "hit": true, "audio": "audio/413ce66856ffc62f69bd.m4a", "gloss": {"bs": "podijelili su se", "en": "they split up", "tr": "ayrılığa düştüler", "fr": "ils se sont divisés", "id": "mereka terpecah belah", "ur": "وہ بٹ گئے", "bn": "তারা বিভক্ত হয়ে গেল", "fa": "پراکنده شدند"}}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "أُوتُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكِتَٰبَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text