{"rank": 248, "root": "مدد", "form": 1, "lemma": "مَدَّ", "count": 13, "ayahCount": 13, "share": 0.07, "meaning": {"bs": "pružiti, protegnuti", "en": "to extend, to stretch", "tr": "uzatmak, yaymak", "fr": "étendre, prolonger", "id": "membentangkan, menghamparkan", "ur": "پھیلانا، دراز کرنا", "bn": "প্রসারিত করা, বিস্তৃত করা", "fa": "گستردن، کشیدن"}, "lemmaSpoken": "audio/0fe2d18b1516e830df79.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "مَدَّ", "plain": "مَدَّ", "quran": true, "notUsed": false, "spoken": "audio/0fe2d18b1516e830df79.m4a", "recited": "audio/b0f520a1f5907a90e783.m4a", "recitedText": "مَدَّ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَمُدُّ", "plain": "يَمُدُّ", "quran": false, "notUsed": false, "spoken": "audio/958b3f3d10665986040f.m4a", "recited": null, "recitedText": null}], "nouns": {"verbal_noun": {"lemma": "مَدّ", "count": 2, "spoken": "audio/5af1a04b8466c33f928a.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "مَدَدْتُ", "plain": "مَدَدْتُ", "quran": false, "notUsed": false, "spoken": "audio/425ef048d24c1425af64.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "مَدَدْنَا", "plain": "مَدَدْنَا", "quran": false, "notUsed": false, "spoken": "audio/730103ef83eab6931cf9.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "مَدَدْتَ", "plain": "مَدَدْتَ", "quran": false, "notUsed": false, "spoken": "audio/0f8f9ea14960e1faaa04.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "مَدَدْتِ", "plain": "مَدَدْتِ", "quran": false, "notUsed": false, "spoken": "audio/db177899ed36d924b8f1.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "مَدَدْتُمَا", "plain": "مَدَدْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/c0ef878918dd2e3f7961.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antum", "arabic": "مَدَدْتُم