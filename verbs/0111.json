], "mood": "subjunctive"}], "gloss": {"en": "so that we may make clear", "bs": "da pojasnimo", "tr": "açıklayalım diye", "fr": "que nous expliquions", "id": "agar kami menjelaskan", "ur": "تاکہ ہم واضح کریں", "bn": "যাতে আমরা স্পষ্ট করি", "fa": "تا روشن کنیم"}}, {"arabic": "وَلِأُبَيِّنَ", "count": 1, "first": "43:63", "audio": "audio/6518fb61d042550d9505.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "and so that I may make clear", "bs": "i da pojasnim", "tr": "ve açıklayayım diye", "fr": "et que j'explique", "id": "dan agar aku menjelaskan", "ur": "اور تاکہ میں واضح کروں", "bn": "এবং যাতে আমি স্পষ্ট করি", "fa": "و تا روشن کنم"}}], "ayatFile": "ayat/0111.json", "ayatTranslations": {"en": "ayat/0111.en.json", "tr": "ayat/0111.tr.json", "ur": "ayat/0111.ur.json", "id": "ayat/0111.id.json"}, "sentences": [{"arabic": "يُبَيِّنُ الْمُعَلِّمُ الدَّرْسَ", "spoken": "audio/48775124afcbdd9de5cf.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Učitelj objašnjava lekciju.", "en": "The teacher explains the lesson.", "bn": "শিক্ষক পাঠটি ব্যাখ্যা করেন।", "fa": "معلم درس را توضیح می‌دهد.", "fr": "L'enseignant explique la leçon.", "id": "Guru menjelaskan pelajaran.", "tr": "Öğretmen dersi açıklıyor.", "ur": "استاد سبق سمجھاتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يُبَيِّنُ", "target": true, "translation": {"bs": "objašnjava", "en": "explains", "bn": "ব্যাখ্যা করে", "fa": "توضیح می‌دهد", "fr": "explique", "id": "menjelaskan", "tr": "açıklar", "ur": "وہ سمجھاتا ہے"}}, {"arabic": "الْمُعَلِّمُ", "target": false, "translation": {"bs": "učitelj", "en": "the teacher", "bn": "শিক্ষক", "fa": "معلم", "fr": "le professeur", "id": "guru itu", "tr": "öğretmen", "ur": "استاد"}}, {"arabic": "الدَّرْسَ", "target": false, "translation": {"bs": "lekciju", "en": "the lesson", "bn": "পাঠ", "fa": "درس", "fr": "la leçon", "id": "pelajaran", "tr": "ders", "ur": "سبق"}}]}, {"arabic": "بَيَّنُوا الطَّرِيقَ لِلضَّيْفِ", "spoken": "audio/0323701f33596a30e522.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Objasnili su put gostu.", "en": "They explained the way to the guest.", "bn": "তারা অতিথিকে পথটি বুঝিয়ে দিল।", "fa": "راه را به مهمان توضیح دادند.", "fr": "Ils ont expliqué le chemin à l'invité.", "id": "Mereka menjelaskan jalan kepada tamu.", "tr": "Misafire yolu tarif ettiler.", "ur": "انہوں نے مہمان کو راستہ سمجھایا۔"}, "independentlyReviewed": true, "words": [{"arabic": "بَيَّنُوا", "target": true, "translation": {"bs": "objasnili su", "en": "they explained, demonstrated", "bn": "তারা ব্যাখ্যা করল, বুঝিয়ে দিল", "fa": "توضیح دادند", "fr": "ont expliqué, montré", "id": "mereka menjelaskan, memperagakan", "tr": "açıkladılar, tarif ettiler", "ur": "انہوں نے سمجھایا"}}, {"arabic": "الطَّرِيقَ", "target": false, "translation": {"bs": "put", "en": "the way", "bn": "পথ", "fa": "راه", "fr": "le chemin", "id": "jalan itu", "tr": "yol", "ur": "راستہ"}}, {"arabic": "لِلضَّيْفِ", "target": false, "translation": {"bs": "gostu", "en": "to the guest", "bn": "অতিথিকে", "fa": "برای مهمان", "fr": "à l'invité", "id": "kepada tamu", "tr": "misafire", "ur": "مہمان کو"}}]}, {"arabic": "بَيَّنَّا الْقَاعِدَةَ لِلطُّلَّابِ", "spoken": "audio/ad5a4aea980ecb6156d0.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Objasnili smo pravilo učenicima.", "en": "We explained the rule to the students.", "bn": "আমরা ছাত্রদের নিয়মটি ব্যাখ্যা করলাম।", "fa": "قاعده را برای دانش‌آموزان توضیح دادیم.", "fr": "Nous avons expliqué la règle aux élèves.", "id": "Kami menjelaskan aturan kepada para siswa.", "tr": "Kuralı öğrencilere açıkladık.", "ur": "ہم نے طلبہ کو قاعدہ سمجھایا۔"}, "independentlyReviewed": true, "words": [{"arabic": "بَيَّنَّا", "target": true, "translation": {"bs": "objasnili smo", "en": "we explained, demonstrated", "bn": "আমরা ব্যাখ্যা করলাম, বুঝিয়ে দিলাম", "fa": "توضیح دادیم", "fr": "nous avons expliqué, montré", "id": "kami menjelaskan, memperagakan", "tr": "açıkladık, gösterdik", "ur": "ہم نے سمجھایا"}}, {"arabic": "الْقَاعِدَةَ", "target": false, "translation": {"bs": "pravilo", "en": "the rule", "bn": "নিয়ম", "fa": "قاعده", "fr": "la règle", "id": "aturan", "tr": "kural", "ur": "قاعدہ"}}, {"arabic": "لِلطُّلَّابِ", "target": false, "translation": {"bs": "učenicima", "en": "to the students", "bn": "ছাত্রদের কাছে", "fa": "برای دانش‌آموزان", "fr": "aux élèves", "id": "kepada para siswa", "tr": "öğrencilere", "ur": "طلبہ کو"}}]}, {"arabic": "نُبَيِّنُ الْخَطَأَ لِلطَّالِبِ", "spoken": "audio/73b344a34ad6cf4d7b7a.m4a", "tense": "present", "pronoun": "nahnu", "translation": {"bs": "Objašnjavamo grešku učeniku.", "en": "We explain the mistake to the student.", "bn": "আমরা ছাত্রকে ভুলটি বুঝিয়ে দিই।", "fa": "اشتباه را برای دانش‌آموز توضیح می‌دهیم.", "fr": "Nous expliquons l'erreur à l'élève.", "id": "Kami menjelaskan kesalahan itu kepada siswa.", "tr": "Hatayı öğrenciye açıklıyoruz.", "ur": "ہم طالب علم کو اس کی غلطی سمجھاتے ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "نُبَيِّنُ", "target": true, "translation": {"bs": "objašnjavamo", "en": "we explain", "bn": "আমরা ব্যাখ্যা করি", "fa": "توضیح می‌دهیم", "fr": "nous expliquons", "id": "kami menjelaskan", "tr": "açıklıyoruz", "ur": "ہم سمجھاتے ہیں"}}, {"arabic": "الْخَطَأَ", "target": false, "translation": {"bs": "grešku", "en": "the mistake", "bn": "ভুল", "fa": "اشتباه", "fr": "l'erreur", "id": "kesalahan", "tr": "hata", "ur": "غلطی"}}, {"arabic": "لِلطَّالِبِ", "target": false, "translation": {"bs": "učeniku", "en": "to the student", "bn": "ছাত্রকে", "fa": "برای دانش‌آموز", "fr": "à l'élève", "id": "kepada siswa", "tr": "öğrenciye", "ur": "طالب علم کو"}}]}]}