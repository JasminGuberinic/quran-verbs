[{"id":"hasiba-18-104-7","words":["verb:hasiba"],"options":[{"bs":"misle","en":"they think"},{"bs":"i smatrate ga","en":"and you (all) think it"},{"bs":"smatrala ga je","en":"she/it thought it"},{"bs":"misli","en":"he thinks"}],"ref":"18:104","answerWord":"يَحْسَبُونَ","answerSound":"audio/01b61d865a9bb099631b.m4a","quranTranslation":{"text":"Those whose effort goeth astray in the life of the world, and yet they reckon that they do good work.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["ٱلَّذِينَ","ضَلَّ","سَعْيُهُمْ","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","وَهُمْ","يَحْسَبُونَ","أَنَّهُمْ","يُحْسِنُونَ","صُنْعًا"],"marked":[7],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-75-3-0","words":["verb:hasiba"],"options":[{"bs":"zar misli?","en":"does he/it think?"},{"bs":"misle","en":"they think"},{"bs":"smatrate ga","en":"you (all) think it"},{"bs":"smatra ga","en":"he/it thinks it"}],"ref":"75:3","answerWord":"أَيَحْسَبُ","answerSound":"audio/beefe5d1d6301713069d.m4a","quranTranslation":{"text":"Thinketh man that We shall not assemble his bones?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["أَيَحْسَبُ","ٱلْإِنسَٰنُ","أَلَّن","نَّجْمَعَ","عِظَامَهُۥ"],"marked":[0],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-2-214-1","words":["verb:hasiba"],"options":[{"bs":"mislili ste","en":"you (all) thought"},{"bs":"mislio je","en":"he/it thought"},{"bs":"i smatrate ga","en":"and you (all) think it"},{"bs":"zar misle?","en":"do they think?"}],"ref":"2:214","answerWord":"حَسِبْتُمْ","answerSound":"audio/7e50d587b5170ea11fed.m4a","quranTranslation":{"text":"Or think ye that ye will enter paradise while yet there hath not come unto you the like of (that which came to) those who passed away before you? Affliction and adversity befell them, they were shaken as with earthquake, till the messenger (of Allah) and those who believed along with him said: When cometh Allah's help? Now surely Allah's help is nigh.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["أَمْ","حَسِبْتُمْ","أَن","تَدْخُلُوا۟","ٱلْجَنَّةَ","وَلَمَّا","يَأْتِكُم","مَّثَلُ","ٱلَّذِينَ","خَلَوْا۟","مِن","قَبْلِكُم","مَّسَّتْهُمُ","ٱلْبَأْسَآءُ","وَٱلضَّرَّآءُ","وَزُلْزِلُوا۟","حَتَّىٰ","يَقُولَ","ٱلرَّسُولُ","وَٱلَّذِينَ","ءَامَنُوا۟","مَعَهُۥ","مَتَىٰ","نَصْرُ","ٱللَّهِ","أَلَآ","إِنَّ","نَصْرَ","ٱللَّهِ","قَرِيبٌ"],"marked":[1],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-29-4-1","words":["verb:hasiba"],"options":[{"bs":"mislio je","en":"he/it thought"},{"bs":"zar misle?","en":"do they think?"},{"bs":"zar ste mislili","en":"did you then think"},{"bs":"smatrala ga je","en":"she/it thought it"}],"ref":"29:4","answerWord":"حَسِبَ","answerSound":"audio/7744c3bd9756e3c4c7a9.m4a","quranTranslation":{"text":"Or do those who do ill-deeds imagine that they can outstrip Us? Evil (for them) is that which they decide.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["أَمْ","حَسِبَ","ٱلَّذِينَ","يَعْمَلُونَ","ٱلسَّيِّـَٔاتِ","أَن","يَسْبِقُونَا","سَآءَ","مَا","يَحْكُمُونَ"],"marked":[1],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-2-273-11","words":["verb:hasiba"],"options":[{"bs":"smatra ih","en":"he/it thinks them"},{"bs":"misle","en":"they think"},{"bs":"mislio si","en":"you thought"},{"bs":"zar misli?","en":"does he/it think?"}],"ref":"2:273","answerWord":"يَحْسَبُهُمُ","answerSound":"audio/f6485f2939640bc9b865.m4a","quranTranslation":{"text":"(Alms are) for the poor who are straitened for the cause of Allah, who cannot travel in the land (for trade). The unthinking man accounteth them wealthy because of their restraint. Thou shalt know them by their mark: They do not beg of men with importunity. And whatsoever good thing ye spend, lo! Allah knoweth it.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["لِلْفُقَرَآءِ","ٱلَّذِينَ","أُحْصِرُوا۟","فِى","سَبِيلِ","ٱللَّهِ","لَا","يَسْتَطِيعُونَ","ضَرْبًا","فِى","ٱلْأَرْضِ","يَحْسَبُهُمُ","ٱلْجَاهِلُ","أَغْنِيَآءَ","مِنَ","ٱلتَّعَفُّفِ","تَعْرِفُهُم","بِسِيمَٰهُمْ","لَا","يَسْـَٔلُونَ","ٱلنَّاسَ","إِلْحَافًا","وَمَا","تُنفِقُوا۟","مِنْ","خَيْرٍ","فَإِنَّ","ٱللَّهَ","بِهِۦ","عَلِيمٌ"],"marked":[11],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-3-78-6","words":["verb:hasiba"],"options":[{"bs":"da ga smatrate","en":"so that you (all) may think it"},{"bs":"zar je mislio?","en":"did he/it think?"},{"bs":"i mislili su","en":"and they thought"},{"bs":"misli","en":"he thinks"}],"ref":"3:78","answerWord":"لِتَحْسَبُوهُ","answerSound":"audio/7f70705ddbcfe563df74.m4a","quranTranslation":{"text":"And lo! there is a party of them who distort the Scripture with their tongues, that ye may think that what they say is from the Scripture, when it is not from the Scripture. And they say: It is from Allah, when it is not from Allah; and they speak a lie concerning Allah knowingly.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["وَإِنَّ","مِنْهُمْ","لَفَرِيقًا","يَلْوُۥنَ","أَلْسِنَتَهُم","بِٱلْكِتَٰبِ","لِتَحْسَبُوهُ","مِنَ","ٱلْكِتَٰبِ","وَمَا","هُوَ","مِنَ","ٱلْكِتَٰبِ","وَيَقُولُونَ","هُوَ","مِنْ","عِندِ","ٱللَّهِ","وَمَا","هُوَ","مِنْ","عِندِ","ٱللَّهِ","وَيَقُولُونَ","عَلَى","ٱللَّهِ","ٱلْكَذِبَ","وَهُمْ","يَعْلَمُونَ"],"marked":[6],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-5-71-0","words":["verb:hasiba"],"options":[{"bs":"i mislili su","en":"and they thought"},{"bs":"zar misli?","en":"does he/it think?"},{"bs":"smatra ih","en":"he/it thinks them"},{"bs":"mislili ste","en":"you (all) thought"}],"ref":"5:71","answerWord":"وَحَسِبُوٓا۟","answerSound":"audio/835bdc2cfb9ee3968293.m4a","quranTranslation":{"text":"They thought no harm would come of it, so they were wilfully blind and deaf. And afterward Allah turned (in mercy) toward them. Now (even after that) are many of them wilfully blind and deaf. Allah is Seer of what they do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["وَحَسِبُوٓا۟","أَلَّا","تَكُونَ","فِتْنَةٌ","فَعَمُوا۟","وَصَمُّوا۟","ثُمَّ","تَابَ","ٱللَّهُ","عَلَيْهِمْ","ثُمَّ","عَمُوا۟","وَصَمُّوا۟","كَثِيرٌ","مِّنْهُمْ","وَٱللَّهُ","بَصِيرٌۢ","بِمَا","يَعْمَلُونَ"],"marked":[0],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-18-9-1","words":["verb:hasiba"],"options":[{"bs":"mislio si","en":"you thought"},{"bs":"smatrala ga je","en":"she/it thought it"},{"bs":"smatrate ga","en":"you (all) think it"},{"bs":"misli","en":"he thinks"}],"ref":"18:9","answerWord":"حَسِبْتَ","answerSound":"audio/2d929351348c776fa3f4.m4a","quranTranslation":{"text":"Or deemest thou that the People of the Cave and the Inscription are a wonder among Our portents?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["أَمْ","حَسِبْتَ","أَنَّ","أَصْحَٰبَ","ٱلْكَهْفِ","وَٱلرَّقِيمِ","كَانُوا۟","مِنْ","ءَايَٰتِنَا","عَجَبًا"],"marked":[1],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-23-55-0","words":["verb:hasiba"],"options":[{"bs":"zar misle?","en":"do they think?"},{"bs":"i mislili su","en":"and they thought"},{"bs":"smatrala ga je","en":"she/it thought it"},{"bs":"smatrate ga","en":"you (all) think it"}],"ref":"23:55","answerWord":"أَيَحْسَبُونَ","answerSound":"audio/67856f328dce80bf9322.m4a","quranTranslation":{"text":"Think they that in the wealth and sons wherewith We provide them","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["أَيَحْسَبُونَ","أَنَّمَا","نُمِدُّهُم","بِهِۦ","مِن","مَّالٍ","وَبَنِينَ"],"marked":[0],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-23-115-0","words":["verb:hasiba"],"options":[{"bs":"zar ste mislili","en":"did you then think"},{"bs":"smatrate ga","en":"you (all) think it"},{"bs":"zar misli?","en":"does he/it think?"},{"bs":"i mislili su","en":"and they thought"}],"ref":"23:115","answerWord":"أَفَحَسِبْتُمْ","answerSound":"audio/d65a87e595d5b9447314.m4a","quranTranslation":{"text":"Deemed ye then that We had created you for naught, and that ye would not be returned unto Us?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["أَفَحَسِبْتُمْ","أَنَّمَا","خَلَقْنَٰكُمْ","عَبَثًا","وَأَنَّكُمْ","إِلَيْنَا","لَا","تُرْجَعُونَ"],"marked":[0],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-24-11-7","words":["verb:hasiba"],"options":[{"bs":"smatrate ga","en":"you (all) think it"},{"bs":"mislili ste","en":"you (all) thought"},{"bs":"smatra ga","en":"he/it thinks it"},{"bs":"mislio si","en":"you thought"}],"ref":"24:11","answerWord":"تَحْسَبُوهُ","answerSound":"audio/e960bb8370c1a2f1ea41.m4a","quranTranslation":{"text":"Lo! they who spread the slander are a gang among you. Deem it not a bad thing for you; nay, it is good for you. Unto every man of them (will be paid) that which he hath earned of the sin; and as for him among them who had the greater share therein, his will be an awful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["إِنَّ","ٱلَّذِينَ","جَآءُو","بِٱلْإِفْكِ","عُصْبَةٌ","مِّنكُمْ","لَا","تَحْسَبُوهُ","شَرًّا","لَّكُم","بَلْ","هُوَ","خَيْرٌ","لَّكُمْ","لِكُلِّ","ٱمْرِئٍ","مِّنْهُم","مَّا","ٱكْتَسَبَ","مِنَ","ٱلْإِثْمِ","وَٱلَّذِى","تَوَلَّىٰ","كِبْرَهُۥ","مِنْهُمْ","لَهُۥ","عَذَابٌ","عَظِيمٌ"],"marked":[7],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-24-15-10","words":["verb:hasiba"],"options":[{"bs":"i smatrate ga","en":"and you (all) think it"},{"bs":"mislio si","en":"you thought"},{"bs":"i mislili su","en":"and they thought"},{"bs":"smatra ih","en":"he/it thinks them"}],"ref":"24:15","answerWord":"وَتَحْسَبُونَهُۥ","answerSound":"audio/7c0d93291a0933055a0b.m4a","quranTranslation":{"text":"When ye welcomed it with your tongues, and uttered with your mouths that whereof ye had no knowledge, ye counted it a trifle. In the sight of Allah it is very great.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["إِذْ","تَلَقَّوْنَهُۥ","بِأَلْسِنَتِكُمْ","وَتَقُولُونَ","بِأَفْوَاهِكُم","مَّا","لَيْسَ","لَكُم","بِهِۦ","عِلْمٌ","وَتَحْسَبُونَهُۥ","هَيِّنًا","وَهُوَ","عِندَ","ٱللَّهِ","عَظِيمٌ"],"marked":[10],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-24-39-5","words":["verb:hasiba"],"options":[{"bs":"smatra ga","en":"he/it thinks it"},{"bs":"smatra ih","en":"he/it thinks them"},{"bs":"misle","en":"they think"},{"bs":"mislio si","en":"you thought"}],"ref":"24:39","answerWord":"يَحْسَبُهُ","answerSound":"audio/4d38735c956adfc3f028.m4a","quranTranslation":{"text":"As for those who disbelieve, their deeds are as a mirage in a desert. The thirsty one supposeth it to be water till he cometh unto it and findeth it naught, and findeth, in the place thereof, Allah Who payeth him his due; and Allah is swift at reckoning.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["وَٱلَّذِينَ","كَفَرُوٓا۟","أَعْمَٰلُهُمْ","كَسَرَابٍۭ","بِقِيعَةٍ","يَحْسَبُهُ","ٱلظَّمْـَٔانُ","مَآءً","حَتَّىٰٓ","إِذَا","جَآءَهُۥ","لَمْ","يَجِدْهُ","شَيْـًٔا","وَوَجَدَ","ٱللَّهَ","عِندَهُۥ","فَوَفَّىٰهُ","حِسَابَهُۥ","وَٱللَّهُ","سَرِيعُ","ٱلْحِسَابِ"],"marked":[5],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-27-44-6","words":["verb:hasiba"],"options":[{"bs":"smatrala ga je","en":"she/it thought it"},{"bs":"misli","en":"he thinks"},{"bs":"smatra ga","en":"he/it thinks it"},{"bs":"i mislili su","en":"and they thought"}],"ref":"27:44","answerWord":"حَسِبَتْهُ","answerSound":"audio/dd78e52ba5ba2422701e.m4a","quranTranslation":{"text":"It was said unto her: Enter the hall. And when she saw it she deemed it a pool and bared her legs. (Solomon) said: Lo! it is a hall, made smooth, of glass. She said: My Lord! Lo! I have wronged myself, and I surrender with Solomon unto Allah, the Lord of the Worlds.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["قِيلَ","لَهَا","ٱدْخُلِى","ٱلصَّرْحَ","فَلَمَّا","رَأَتْهُ","حَسِبَتْهُ","لُجَّةً","وَكَشَفَتْ","عَن","سَاقَيْهَا","قَالَ","إِنَّهُۥ","صَرْحٌ","مُّمَرَّدٌ","مِّن","قَوَارِيرَ","قَالَتْ","رَبِّ","إِنِّى","ظَلَمْتُ","نَفْسِى","وَأَسْلَمْتُ","مَعَ","سُلَيْمَٰنَ","لِلَّهِ","رَبِّ","ٱلْعَٰلَمِينَ"],"marked":[6],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-29-2-0","words":["verb:hasiba"],"options":[{"bs":"zar je mislio?","en":"did he/it think?"},{"bs":"smatrate ga","en":"you (all) think it"},{"bs":"smatrao si ih","en":"you thought them"},{"bs":"zar misle?","en":"do they think?"}],"ref":"29:2","answerWord":"أَحَسِبَ","answerSound":"audio/d4d40f67c8469e2d3fa7.m4a","quranTranslation":{"text":"Do men imagine that they will be left (at ease) because they say, We believe, and will not be tested with affliction?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["أَحَسِبَ","ٱلنَّاسُ","أَن","يُتْرَكُوٓا۟","أَن","يَقُولُوٓا۟","ءَامَنَّا","وَهُمْ","لَا","يُفْتَنُونَ"],"marked":[0],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-76-19-6","words":["verb:hasiba"],"options":[{"bs":"smatrao si ih","en":"you thought them"},{"bs":"mislio je","en":"he/it thought"},{"bs":"smatrate ga","en":"you (all) think it"},{"bs":"misle","en":"they think"}],"ref":"76:19","answerWord":"حَسِبْتَهُمْ","answerSound":"audio/9a5ecb0d18180f774602.m4a","quranTranslation":{"text":"There wait on them immortal youths, whom, when thou seest, thou wouldst take for scattered pearls.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["وَيَطُوفُ","عَلَيْهِمْ","وِلْدَٰنٌ","مُّخَلَّدُونَ","إِذَا","رَأَيْتَهُمْ","حَسِبْتَهُمْ","لُؤْلُؤًا","مَّنثُورًا"],"marked":[6],"facts":{"verb":"حَسِبَ"}},{"id":"hasiba-104-3-0","words":["verb:hasiba"],"options":[{"bs":"misli","en":"he thinks"},{"bs":"mislio si","en":"you thought"},{"bs":"mislili ste","en":"you (all) thought"},{"bs":"i mislili su","en":"and they thought"}],"ref":"104:3","answerWord":"يَحْسَبُ","answerSound":"audio/cd636bf693c3973020b2.m4a","quranTranslation":{"text":"He thinketh that his wealth will render him immortal.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"misliti, smatrati","en":"to think, to reckon"},"passage":["يَحْسَبُ","أَنَّ","مَالَهُۥٓ","أَخْلَدَهُۥ"],"marked":[0],"facts":{"verb":"حَسِبَ"}},{"id":"ashhada-2-204-8","words":["verb:ashhada"],"options":[{"bs":"i uzima za svjedoka","en":"and he/it calls to witness"},{"bs":"uzimam za svjedoka","en":"I call to witness"},{"bs":"pa uzmite za svjedoka!","en":"so (you all) call to witness!"},{"bs":"uzeo sam ih za svjedoke","en":"I called them to witness"}],"ref":"2:204","answerWord":"وَيُشْهِدُ","answerSound":"audio/5ebd586a82177d38dcb0.m4a","quranTranslation":{"text":"And of mankind there is he whoso conversation on the life of this world pleaseth thee (Muhammad), and he calleth Allah to witness as to that which is in his heart; yet he is the most rigid of opponents.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti za svjedoka","en":"to call to witness"},"passage":["وَمِنَ","ٱلنَّاسِ","مَن","يُعْجِبُكَ","قَوْلُهُۥ","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","وَيُشْهِدُ","ٱللَّهَ","عَلَىٰ","مَا","فِى","قَلْبِهِۦ","وَهُوَ","أَلَدُّ","ٱلْخِصَامِ"],"marked":[8],"facts":{"verb":"أَشْهَدَ"}},{"id":"ashhada-7-172-9","words":["verb:ashhada"],"options":[{"bs":"i uzeo ih je za svjedoke","en":"and he/it called them to witness"},{"bs":"i uzmite za svjedoka!","en":"and (you all) call to witness!"},{"bs":"i uzima za svjedoka","en":"and he/it calls to witness"},{"bs":"uzimam za svjedoka","en":"I call to witness"}],"ref":"7:172","answerWord":"وَأَشْهَدَهُمْ","answerSound":"audio/4ddac546d278a2831173.m4a","quranTranslation":{"text":"And (remember) when thy Lord brought forth from the Children of Adam, from their reins, their seed, and made them testify of themselves, (saying): Am I not your Lord? They said: Yea, verily. We testify. (That was) lest ye should say at the Day of Resurrection: Lo! of this we were unaware;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti za svjedoka","en":"to call to witness"},"passage":["وَإِذْ","أَخَذَ","رَبُّكَ","مِنۢ","بَنِىٓ","ءَادَمَ","مِن","ظُهُورِهِمْ","ذُرِّيَّتَهُمْ","وَأَشْهَدَهُمْ","عَلَىٰٓ","أَنفُسِهِمْ","أَلَسْتُ","بِرَبِّكُمْ","قَالُوا۟","بَلَىٰ","شَهِدْنَآ","أَن","تَقُولُوا۟","يَوْمَ","ٱلْقِيَٰمَةِ","إِنَّا","كُنَّا","عَنْ","هَٰذَا","غَٰفِلِينَ"],"marked":[9],"facts":{"verb":"أَشْهَدَ"}},{"id":"ashhada-11-54-9","words":["verb:ashhada"],"options":[{"bs":"uzimam za svjedoka","en":"I call to witness"},{"bs":"i uzmite za svjedoka!","en":"and (you all) call to witness!"},{"bs":"i uzima za svjedoka","en":"and he/it calls to witness"},{"bs":"uzeo sam ih za svjedoke","en":"I called them to witness"}],"ref":"11:54","answerWord":"أُشْهِدُ","answerSound":"audio/3c9d821384cb9be4f3a0.m4a","quranTranslation":{"text":"We say naught save that one of our gods hath possessed thee in an evil way. He said: I call Allah to witness, and do ye (too) bear witness, that I am innocent of (all) that ye ascribe as partners (to Allah)","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti za svjedoka","en":"to call to witness"},"passage":["إِن","نَّقُولُ","إِلَّا","ٱعْتَرَىٰكَ","بَعْضُ","ءَالِهَتِنَا","بِسُوٓءٍ","قَالَ","إِنِّىٓ","أُشْهِدُ","ٱللَّهَ","وَٱشْهَدُوٓا۟","أَنِّى","بَرِىٓءٌ","مِّمَّا","تُشْرِكُونَ"],"marked":[9],"facts":{"verb":"أَشْهَدَ"}},{"id":"ashhada-18-51-1","words":["verb:ashhada"],"options":[{"bs":"uzeo sam ih za svjedoke","en":"I called them to witness"},{"bs":"pa uzmite za svjedoka!","en":"so (you all) call to witness!"},{"bs":"i uzima za svjedoka","en":"and he/it calls to witness"},{"bs":"uzimam za svjedoka","en":"I call to witness"}],"ref":"18:51","answerWord":"أَشْهَدتُّهُمْ","answerSound":"audio/218b489c489a99875860.m4a","quranTranslation":{"text":"I made them not to witness the creation of the heavens and the earth, nor their own creation; nor choose I misleaders for (My) helpers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti za svjedoka","en":"to call to witness"},"passage":["مَّآ","أَشْهَدتُّهُمْ","خَلْقَ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","وَلَا","خَلْقَ","أَنفُسِهِمْ","وَمَا","كُنتُ","مُتَّخِذَ","ٱلْمُضِلِّينَ","عَضُدًا"],"marked":[1],"facts":{"verb":"أَشْهَدَ"}},{"id":"ashhada-65-2-8","words":["verb:ashhada"],"options":[{"bs":"i uzmite za svjedoka!","en":"and (you all) call to witness!"},{"bs":"i uzima za svjedoka","en":"and he/it calls to witness"},{"bs":"uzeo sam ih za svjedoke","en":"I called them to witness"},{"bs":"uzimam za svjedoka","en":"I call to witness"}],"ref":"65:2","answerWord":"وَأَشْهِدُوا۟","answerSound":"audio/72a06c590af60dc83128.m4a","quranTranslation":{"text":"Then, when they have reached their term, take them back in kindness or part from them in kindness, and call to witness two just men among you, and keep your testimony upright for Allah. Whoso believeth in Allah and the Last Day is exhorted to act thus. And whosoever keepeth his duty to Allah, Allah will appoint a way out for him,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uzeti za svjedoka","en":"to call to witness"},"passage":["فَإِذَا","بَلَغْنَ","أَجَلَهُنَّ","فَأَمْسِكُوهُنَّ","بِمَعْرُوفٍ","أَوْ","فَارِقُوهُنَّ","بِمَعْرُوفٍ","وَأَشْهِدُوا۟","ذَوَىْ","عَدْلٍ","مِّنكُمْ","وَأَقِيمُوا۟","ٱلشَّهَٰدَةَ","لِلَّهِ","ذَٰلِكُمْ","يُوعَظُ","بِهِۦ","مَن","كَانَ","يُؤْمِنُ","بِٱللَّهِ","وَٱلْيَوْمِ","ٱلْءَاخِرِ","وَمَن","يَتَّقِ","ٱللَّهَ","يَجْعَل","لَّهُۥ","مَخْرَجًا"],"marked":[8],"facts":{"verb":"أَشْهَدَ"}},{"id":"tamasa-4-47-13","words":["verb:tamasa"],"options":[{"bs":"brišemo","en":"we efface"},{"bs":"izbriši!","en":"efface!"},{"bs":"izbrisali bismo","en":"We would have blotted out"},{"bs":"izbrisana je","en":"she/it was effaced"}],"ref":"4:47","answerWord":"نَّطْمِسَ","answerSound":"audio/6992607417a97bcbf7b8.m4a","quranTranslation":{"text":"O ye unto whom the Scripture hath been given! Believe in what We have revealed confirming that which ye possess, before We destroy countenances so as to confound them, or curse them as We cursed the Sabbath-breakers (of old time). The commandment of Allah is always executed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati, zatrti","en":"to efface, to blot out"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","أُوتُوا۟","ٱلْكِتَٰبَ","ءَامِنُوا۟","بِمَا","نَزَّلْنَا","مُصَدِّقًا","لِّمَا","مَعَكُم","مِّن","قَبْلِ","أَن","نَّطْمِسَ","وُجُوهًا","فَنَرُدَّهَا","عَلَىٰٓ","أَدْبَارِهَآ","أَوْ","نَلْعَنَهُمْ","كَمَا","لَعَنَّآ","أَصْحَٰبَ","ٱلسَّبْتِ","وَكَانَ","أَمْرُ","ٱللَّهِ","مَفْعُولًا"],"marked":[13],"facts":{"verb":"طَمَسَ"}},{"id":"tamasa-10-88-17","words":["verb:tamasa"],"options":[{"bs":"izbriši!","en":"efface!"},{"bs":"izbrisana je","en":"she/it was effaced"},{"bs":"izbrisali bismo","en":"We would have blotted out"},{"bs":"brišemo","en":"we efface"}],"ref":"10:88","answerWord":"ٱطْمِسْ","answerSound":"audio/40f470319f3c87c20ff8.m4a","quranTranslation":{"text":"And Moses said: Our Lord! Lo! Thou hast given Pharaoh and his chiefs splendour and riches in the life of the world, Our Lord! that they may lead men astray from Thy way. Our Lord! Destroy their riches and harden their hearts so that they believe not till they see the painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati, zatrti","en":"to efface, to blot out"},"passage":["وَقَالَ","مُوسَىٰ","رَبَّنَآ","إِنَّكَ","ءَاتَيْتَ","فِرْعَوْنَ","وَمَلَأَهُۥ","زِينَةً","وَأَمْوَٰلًا","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","رَبَّنَا","لِيُضِلُّوا۟","عَن","سَبِيلِكَ","رَبَّنَا","ٱطْمِسْ","عَلَىٰٓ","أَمْوَٰلِهِمْ","وَٱشْدُدْ","عَلَىٰ","قُلُوبِهِمْ","فَلَا","يُؤْمِنُوا۟","حَتَّىٰ","يَرَوُا۟","ٱلْعَذَابَ","ٱلْأَلِيمَ"],"marked":[17],"facts":{"verb":"طَمَسَ"}},{"id":"tamasa-36-66-2","words":["verb:tamasa"],"options":[{"bs":"izbrisali bismo","en":"We would have blotted out"},{"bs":"izbrisana je","en":"she/it was effaced"},{"bs":"izbriši!","en":"efface!"},{"bs":"brišemo","en":"we efface"}],"ref":"36:66","answerWord":"لَطَمَسْنَا","answerSound":"audio/68b40db9bf9c8cbde5b0.m4a","quranTranslation":{"text":"And had We willed, We verily could have quenched their eyesight so that they should struggle for the way. Then how could they have seen?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati, zatrti","en":"to efface, to blot out"},"passage":["وَلَوْ","نَشَآءُ","لَطَمَسْنَا","عَلَىٰٓ","أَعْيُنِهِمْ","فَٱسْتَبَقُوا۟","ٱلصِّرَٰطَ","فَأَنَّىٰ","يُبْصِرُونَ"],"marked":[2],"facts":{"verb":"طَمَسَ"}},{"id":"tamasa-54-37-4","words":["verb:tamasa"],"options":[{"bs":"pa smo izbrisali","en":"so we effaced"},{"bs":"izbriši!","en":"efface!"},{"bs":"brišemo","en":"we efface"},{"bs":"izbrisana je","en":"she/it was effaced"}],"ref":"54:37","answerWord":"فَطَمَسْنَآ","answerSound":"audio/6cbb1712d74605dd0b2d.m4a","quranTranslation":{"text":"They even asked of him his guests for an ill purpose. Then We blinded their eyes (and said): Taste now My punishment after My warnings!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati, zatrti","en":"to efface, to blot out"},"passage":["وَلَقَدْ","رَٰوَدُوهُ","عَن","ضَيْفِهِۦ","فَطَمَسْنَآ","أَعْيُنَهُمْ","فَذُوقُوا۟","عَذَابِى","وَنُذُرِ"],"marked":[4],"facts":{"verb":"طَمَسَ"}},{"id":"tamasa-77-8-2","words":["verb:tamasa"],"options":[{"bs":"izbrisana je","en":"she/it was effaced"},{"bs":"izbriši!","en":"efface!"},{"bs":"izbrisali bismo","en":"We would have blotted out"},{"bs":"brišemo","en":"we efface"}],"ref":"77:8","answerWord":"طُمِسَتْ","answerSound":"audio/b50ab0f048e15d8470bf.m4a","quranTranslation":{"text":"So when the stars are put out,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati, zatrti","en":"to efface, to blot out"},"passage":["فَإِذَا","ٱلنُّجُومُ","طُمِسَتْ"],"marked":[2],"facts":{"verb":"طَمَسَ"}},{"id":"hayya-4-86-1","words":["verb:hayya"],"options":[{"bs":"pozdravljeni ste","en":"you (all) were greeted"},{"bs":"pa pozdravite!","en":"so (you all) greet!"},{"bs":"pozdravlja te","en":"he/it greets you"},{"bs":"pozdravili su te","en":"they greeted you"}],"ref":"4:86","answerWord":"حُيِّيتُم","answerSound":"audio/a0b22ffc69f7b827b205.m4a","quranTranslation":{"text":"When ye are greeted with a greeting, greet ye with a better than it or return it. Lo! Allah taketh count of all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozdraviti","en":"to greet"},"passage":["وَإِذَا","حُيِّيتُم","بِتَحِيَّةٍ","فَحَيُّوا۟","بِأَحْسَنَ","مِنْهَآ","أَوْ","رُدُّوهَآ","إِنَّ","ٱللَّهَ","كَانَ","عَلَىٰ","كُلِّ","شَىْءٍ","حَسِيبًا"],"marked":[1],"facts":{"verb":"حَيَّا"}},{"id":"hayya-4-86-3","words":["verb:hayya"],"options":[{"bs":"pa pozdravite!","en":"so (you all) greet!"},{"bs":"pozdravlja te","en":"he/it greets you"},{"bs":"pozdravljeni ste","en":"you (all) were greeted"},{"bs":"pozdravili su te","en":"they greeted you"}],"ref":"4:86","answerWord":"فَحَيُّوا۟","answerSound":"audio/6d6182089cfe0293a983.m4a","quranTranslation":{"text":"When ye are greeted with a greeting, greet ye with a better than it or return it. Lo! Allah taketh count of all things.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pozdraviti","en":"to greet"},"passage":["وَإِذَا","حُيِّيتُم","بِتَحِيَّةٍ","فَحَيُّوا۟","بِأَحْسَنَ","مِنْهَآ","أَوْ","رُدُّوهَآ","إِنَّ","ٱللَّهَ","كَانَ","عَلَىٰ","كُلِّ","شَىْءٍ","حَسِيبًا"],"marked":[3],"facts":{"verb":"حَيَّا"}}]