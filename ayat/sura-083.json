{"ayat":[{"ref":"83:1","number":5849,"text":"وَيْلٌ لِّلْمُطَفِّفِينَ","hits":[]},{"ref":"83:2","number":5850,"text":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","hits":[0,1,3,4]},{"ref":"83:3","number":5851,"text":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","hits":[2]},{"ref":"83:4","number":5852,"text":"أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","hits":[0,1,2,3]},{"ref":"83:5","number":5853,"text":"لِيَوْمٍ عَظِيمٍ","hits":[0,1]},{"ref":"83:6","number":5854,"text":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ","hits":[1,3,4]},{"ref":"83:7","number":5855,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ","hits":[0,1,2,4]},{"ref":"83:8","number":5856,"text":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ","hits":[0,1]},{"ref":"83:9","number":5857,"text":"كِتَٰبٌ مَّرْقُومٌ","hits":[]},{"ref":"83:10","number":5858,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[2]},{"ref":"83:11","number":5859,"text":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","hits":[1,3]},{"ref":"83:12","number":5860,"text":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","hits":[2,3,6]},{"ref":"83:13","number":5861,"text":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","hits":[1,3,4,5]},{"ref":"83:14","number":5862,"text":"كَلَّا بَلْ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","hits":[1,4,6,7]},{"ref":"83:15","number":5863,"text":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ","hits":[2]},{"ref":"83:16","number":5864,"text":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","hits":[0]},{"ref":"83:17","number":5865,"text":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","hits":[2,3]},{"ref":"83:18","number":5866,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","hits":[3]},{"ref":"83:19","number":5867,"text":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","hits":[]},{"ref":"83:20","number":5868,"text":"كِتَٰبٌ مَّرْقُومٌ","hits":[]},{"ref":"83:21","number":5869,"text":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","hits":[0]},{"ref":"83:22","number":5870,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","hits":[3]},{"ref":"83:23","number":5871,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","hits":[1,2]},{"ref":"83:24","number":5872,"text":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","hits":[0,2]},{"ref":"83:25","number":5873,"text":"يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ","hits":[0,1]},{"ref":"83:26","number":5874,"text":"خِتَٰمُهُۥ مِسْكٌ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ","hits":[3]},{"ref":"83:27","number":5875,"text":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ","hits":[]},{"ref":"83:28","number":5876,"text":"عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ","hits":[0,1]},{"ref":"83:29","number":5877,"text":"إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ","hits":[2,6,7]},{"ref":"83:30","number":5878,"text":"وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ","hits":[1]},{"ref":"83:31","number":5879,"text":"وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ","hits":[1,2,3]},{"ref":"83:32","number":5880,"text":"وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ","hits":[1,4,5]},{"ref":"83:33","number":5881,"text":"وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ","hits":[1]},{"ref":"83:34","number":5882,"text":"فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ","hits":[4]},{"ref":"83:35","number":5883,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","hits":[]},{"ref":"83:36","number":5884,"text":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ","hits":[0,5]}]}