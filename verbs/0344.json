n", "ayatTranslations": {"en": "ayat/0344.en.json", "tr": "ayat/0344.tr.json", "ur": "ayat/0344.ur.json", "id": "ayat/0344.id.json"}, "sentences": [{"arabic": "خَسَفَ الْبَدْرُ أَمْسِ", "spoken": "audio/5145d03ffa808f0b7aa3.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Pun mjesec se jučer pomračio.", "en": "The full moon was eclipsed yesterday.", "bn": "গতকাল পূর্ণিমার চাঁদে গ্রহণ লেগেছিল।", "fa": "دیروز ماه کامل گرفت.", "fr": "La pleine lune s'est éclipsée hier.", "id": "Bulan purnama mengalami gerhana kemarin.", "tr": "Dolunay dün tutuldu.", "ur": "پورا چاند کل گہنا گیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "خَسَفَ", "target": true, "translation": {"bs": "pomračio se", "en": "was eclipsed", "bn": "গ্রহণ লাগল", "fa": "گرفت", "fr": "s'est éclipsée", "id": "mengalami gerhana", "tr": "tutuldu", "ur": "گہنا گیا"}}, {"arabic": "الْبَدْرُ", "target": false, "translation": {"bs": "pun mjesec", "en": "the full moon", "bn": "পূর্ণিমার চাঁদ", "fa": "ماه کامل", "fr": "la pleine lune", "id": "bulan purnama", "tr": "dolunay", "ur": "پورا چاند"}}, {"arabic": "أَمْسِ", "target": false, "translation": {"bs": "jučer", "en": "yesterday", "bn": "গতকাল", "fa": "دیروز", "fr": "hier", "id": "kemarin", "tr": "dün", "ur": "کل (گزشتہ)"}}]}]}