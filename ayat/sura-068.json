{"ayat":[{"ref":"68:1","number":5272,"text":"نٓ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ","hits":[1,2]},{"ref":"68:2","number":5273,"text":"مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ","hits":[1,2,3,4]},{"ref":"68:3","number":5274,"text":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ","hits":[0,1,2]},{"ref":"68:4","number":5275,"text":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ","hits":[1,2,3]},{"ref":"68:5","number":5276,"text":"فَسَتُبْصِرُ وَيُبْصِرُونَ","hits":[0]},{"ref":"68:6","number":5277,"text":"بِأَييِّكُمُ ٱلْمَفْتُونُ","hits":[]},{"ref":"68:7","number":5278,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ","hits":[2,4,5,6,7]},{"ref":"68:8","number":5279,"text":"فَلَا تُطِعِ ٱلْمُكَذِّبِينَ","hits":[0,1,2]},{"ref":"68:9","number":5280,"text":"وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ","hits":[0,1]},{"ref":"68:10","number":5281,"text":"وَلَا تُطِعْ كُلَّ حَلَّافٍ مَّهِينٍ","hits":[4]},{"ref":"68:11","number":5282,"text":"هَمَّازٍ مَّشَّآءٍۭ بِنَمِيمٍ","hits":[]},{"ref":"68:12","number":5283,"text":"مَّنَّاعٍ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ","hits":[1,3]},{"ref":"68:13","number":5284,"text":"عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ","hits":[2]},{"ref":"68:14","number":5285,"text":"أَن كَانَ ذَا مَالٍ وَبَنِينَ","hits":[0,1,3,4]},{"ref":"68:15","number":5286,"text":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","hits":[0,1,3,4,5]},{"ref":"68:16","number":5287,"text":"سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ","hits":[]},{"ref":"68:17","number":5288,"text":"إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ","hits":[1,4,5,6,7]},{"ref":"68:18","number":5289,"text":"وَلَا يَسْتَثْنُونَ","hits":[]},{"ref":"68:19","number":5290,"text":"فَطَافَ عَلَيْهَا طَآئِفٌ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ","hits":[0,3,5]},{"ref":"68:20","number":5291,"text":"فَأَصْبَحَتْ كَٱلصَّرِيمِ","hits":[0]},{"ref":"68:21","number":5292,"text":"فَتَنَادَوْا۟ مُصْبِحِينَ","hits":[]},{"ref":"68:22","number":5293,"text":"أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ","hits":[3,4]},{"ref":"68:23","number":5294,"text":"فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ","hits":[0]},{"ref":"68:24","number":5295,"text":"أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌ","hits":[2,3,5]},{"ref":"68:25","number":5296,"text":"وَغَدَوْا۟ عَلَىٰ حَرْدٍ قَٰدِرِينَ","hits":[3]},{"ref":"68:26","number":5297,"text":"فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ","hits":[0,1,4]},{"ref":"68:27","number":5298,"text":"بَلْ نَحْنُ مَحْرُومُونَ","hits":[0,1,2]},{"ref":"68:28","number":5299,"text":"قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ","hits":[2,5,6]},{"ref":"68:29","number":5300,"text":"قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ","hits":[5]},{"ref":"68:30","number":5301,"text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَلَٰوَمُونَ","hits":[0]},{"ref":"68:31","number":5302,"text":"قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ","hits":[1]},{"ref":"68:32","number":5303,"text":"عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ","hits":[0,3,7]},{"ref":"68:33","number":5304,"text":"كَذَٰلِكَ ٱلْعَذَابُ وَلَعَذَابُ ٱلْءَاخِرَةِ أَكْبَرُ لَوْ كَانُوا۟ يَعْلَمُونَ","hits":[1,7]},{"ref":"68:34","number":5305,"text":"إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ","hits":[1,5]},{"ref":"68:35","number":5306,"text":"أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ","hits":[0,1,2]},{"ref":"68:36","number":5307,"text":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","hits":[2,3]},{"ref":"68:37","number":5308,"text":"أَمْ لَكُمْ كِتَٰبٌ فِيهِ تَدْرُسُونَ","hits":[0,2,3,4]},{"ref":"68:38","number":5309,"text":"إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ","hits":[]},{"ref":"68:39","number":5310,"text":"أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ","hits":[2,7]},{"ref":"68:40","number":5311,"text":"سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ","hits":[0]},{"ref":"68:41","number":5312,"text":"أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَٰدِقِينَ","hits":[2,3,7]},{"ref":"68:42","number":5313,"text":"يَوْمَ يُكْشَفُ عَن سَاقٍ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ","hits":[1,3,4,8]},{"ref":"68:43","number":5314,"text":"خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَٰلِمُونَ","hits":[1,2,3,4]},{"ref":"68:44","number":5315,"text":"فَذَرْنِى وَمَن يُكَذِّبُ بِهَٰذَا ٱلْحَدِيثِ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ","hits":[0,2,3,4]},{"ref":"68:45","number":5316,"text":"وَأُمْلِى لَهُمْ إِنَّ كَيْدِى مَتِينٌ","hits":[0,3,4]},{"ref":"68:46","number":5317,"text":"أَمْ تَسْـَٔلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ","hits":[]},{"ref":"68:47","number":5318,"text":"أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ","hits":[2,4]},{"ref":"68:48","number":5319,"text":"فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌ","hits":[0,1,5,6,8]},{"ref":"68:49","number":5320,"text":"لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌ","hits":[6]},{"ref":"68:50","number":5321,"text":"فَٱجْتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ","hits":[0,4]},{"ref":"68:51","number":5322,"text":"وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌ","hits":[1,2,3,7,8]},{"ref":"68:52","number":5323,"text":"وَمَا هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ","hits":[2,4]}]}