": false, "spoken": "audio/626beacf41bdc440fd48.m4a", "recited": "audio/00e8cc90079857ab35b8.m4a", "recitedText": "يَسْتَكْبِرُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَسْتَكْبِرْنَ", "plain": "يَسْتَكْبِرْنَ", "quran": false, "notUsed": false, "spoken": "audio/0216cafb5a8cbc6328b4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِسْتَكْبِرْ", "plain": "اِسْتَكْبِرْ", "quran": false, "notUsed": false, "spoken": "audio/0a57693098e07763a96e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِسْتَكْبِرِي", "plain": "اِسْتَكْبِرِي", "quran": false, "notUsed": false, "spoken": "audio/74e8957e247d0ac1c080.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِسْتَكْبِرَا", "plain": "اِسْتَكْبِرَا", "quran": false, "notUsed": false, "spoken": "audio/9f72213991dd153f5e5d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِسْتَكْبِرُوا", "plain": "اِسْتَكْبِرُوا", "quran": false, "notUsed": false, "spoken": "audio/293769aa55797ebeb768.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِسْتَكْبِرْنَ", "plain": "اِسْتَكْبِرْنَ", "quran": false, "notUsed": false, "spoken": "audio/ed36bb0e8dfb3eb36b33.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "23:46", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2719.mp3", "translation": {"en": {"text": "Unto Pharaoh and his chiefs, but they scorned (them) and they were despotic folk.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Firavun'a ve ileri gelenlerine de (gönderdik). Bunun üzerine onlar kibire kapıldılar ve ululuk taslayan zorba bir kavim oldular.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "فرعون اور اس کے درباریوں کی طرف تو انہوں نے غرور کیا اور وہ لوگ غلبہ پائے ہوئے تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "kepada Fir'aun dan pembesar-pembesar kaumnya, maka mereka ini takbur dan mereka adalah orang-orang yang sombong.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "فِرْعَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَلَإِي۟هِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱسْتَكْبَرُوا۟", "hit": true, "audio": "audio/bd57cbed32361e9c8288.m4a", "gloss": {"en": "so they were arrogant", "bs": "pa su se uzoholili", "tr": "böylece kibirlendiler", "fr": "alors ils se sont enorgueillis", "id": "maka mereka telah menyombongkan diri", "ur": "پس انہوں نے تکبر کیا", "bn": "অতএব তারা অহংকার করল", "fa": "پس تکبر کردند"}}, {"text": "وَكَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "عَالِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:35", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3823.mp3", "translation": {"en": {"text": "For when it was said unto them, There is no Allah save Allah, they were scornful", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Çünkü onlar, kendilerine: \"Allah'tan başka ilâh yoktur\" denildiği zaman kafa tutuyorlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک جب ان سے کہا جاتا تھا کہ اللہ کے سوا کسی کی بندگی نہیں تو اونچی کھینچتے (تکبر کرتے) تھے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya mereka dahulu apabila dikatakan kepada mereka: \"Laa ilaaha illallah\" (Tiada Tuhan yang berhak disembah melainkan Allah) mereka menyombongkan diri,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "قِيلَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَٰهَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَكْبِرُونَ", "hit": true, "audio": "audio/00e8cc90079857ab35b8.m4a", "gloss": {"bs": "oholili su se", "en": "they were arrogant", "tr": "kibirlendiler", "fr": "ils s'enorgueillissaient", "id": "mereka menyombongkan diri", "ur": "وہ تکبر کرتے ہیں", "bn": "তারা অহংকার করত", "fa": "تکبر می‌ورزیدند"}}]}, {"ref": "74:23", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5518.mp3", "translation": {"en": {"text": "Then turned he away in pride", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra arkasını döndü ve büyüklük tasladı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر پیٹھ پھیری اور تکبر کیا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "kemudian dia berpaling (dari kebenaran) dan menyombongkan diri,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَدْبَرَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱسْتَكْبَرَ", "hit": true, "audio": "audio/7cd7178b83740ea8fd6d.m4a", "gloss": {"bs": "i uzoholio se", "en": "and was arrogant", "tr": "ve kibirlendi", "fr": "et s'enorgueillit", "id": "dan dia menyombongkan diri", "ur": "اور اس نے تکبر کیا", "bn": "এবং সে অহংকার করল", "fa": "و تکبر ورزید"}}]}, {"ref": "45:31", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4504.mp3", "translation": {"en": {"text": "And as for those who disbelieved (it will be said unto them): Were not Our revelations recited unto you? But ye were scornful and became a guilty folk.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ama kâfirlere gelince; onlara da denilir ki; \"Size âyetlerim okunmadı mı? Siz büyüklük tasladınız ve günah işleyen bir kavim oldunuz değil mi?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جو کافر ہوئے ان سے فرمایا جائے گا، کیا نہ تھا کہ میری آیتیں تم پر پڑھی جاتی تھیں تو تم تکبر کرتے تھے اور تم مجرم لوگ تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan adapun orang-orang yang kafir (kepada mereka dikatakan): \"Maka apakah belum ada ayat-ayat-Ku yang dibacakan kepadamu lalu kamu menyombongkan diri dan kamu jadi kaum yang berbuat dosa?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَرُوٓا۟", "hit": false, "audio": null, "gloss": null}, {"text": "أَفَلَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَكُنْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتِى", "hit": false, "audio": null, "gloss": null}, {"text": "تُتْلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱسْتَكْبَرْتُمْ", "hit": true, "audio": "audio/49be30e73ef2b518c1f1.m4a", "gloss": {"en": "so you (all) were arrogant", "bs": "pa ste se uzoholili", "tr": "böylece kibirlendiniz", "fr": "alors vous vous êtes enorgueillis", "id": "maka kalian telah menyombongkan diri", "ur": "پس تم سب نے تکبر کیا", "bn": "অতএব তোমরা অহংকার করেছিলে", "fa": "پس تکبر کردید"}}, {"text": "وَكُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "قَوْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "مُّجْرِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "39:59", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4117.mp3", "translation": {"en": {"text": "(But now the answer will be): Nay, for My revelations came unto thee, but thou didst deny them and wast scornful and wast among the disbelievers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Ona): \"Hayır sana âyetlerim geldi de onlara yalan dedin, kibirlenmek istedin ve kâfirlerden oldun.\" (denir.)", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہاں کیوں نہیں بیشک تیرے پاس میری آیتیں آئیں تو تُو نے انہیں جھٹلایا اور تکبر کیا اور تو کافر تھا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(Bukan demikian) sebenarya telah datang keterangan-keterangan-Ku kepadamu lalu kamu mendustakannya dan kamu menyombongkan diri dan adalah kamu termasuk orang-orang yang kafir\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "بَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "قَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "جَآءَتْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتِى", "hit": false, "audio": null, "gloss": null}, {"text": "فَكَذَّبْتَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱسْتَكْبَرْتَ", "hit": true, "audio": "audio/678d1e51f5eb9a05107a.m4a", "gloss": {"en": "and you were arrogant", "bs": "i uzoholio si se", "tr": "ve kibirlendin", "fr": "et tu t'es enorgueilli", "id": "dan kamu telah menyombongkan diri", "ur": "اور تم نے تکبر کیا", "bn": "এবং তুমি অহংকার করেছিলে", "fa": "و تکبر کردی"}}, {"text": "وَكُنتَ", "hit": false, "audio": null, "gloss": null}, {"text": "