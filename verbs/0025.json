": false, "spoken": "audio/95de91c179bff760f522.m4a", "recited": "audio/f60931b2e36c2705641a.m4a", "recitedText": "يَظْلِمُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَظْلِمْنَ", "plain": "يَظْلِمْنَ", "quran": false, "notUsed": false, "spoken": "audio/1ad86894aba381389f33.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِظْلِمْ", "plain": "اِظْلِمْ", "quran": false, "notUsed": false, "spoken": "audio/e9b90221fd1b55858472.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِظْلِمِي", "plain": "اِظْلِمِي", "quran": false, "notUsed": false, "spoken": "audio/a0ab0d85362d7e63f2c4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِظْلِمَا", "plain": "اِظْلِمَا", "quran": false, "notUsed": false, "spoken": "audio/50c3f694c32d5c9d98ae.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِظْلِمُوا", "plain": "اِظْلِمُوا", "quran": false, "notUsed": false, "spoken": "audio/3655f7488eba592c4e55.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِظْلِمْنَ", "plain": "اِظْلِمْنَ", "quran": false, "notUsed": false, "spoken": "audio/27059b8bdf034fc60008.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "37:22", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3810.mp3", "translation": {"en": {"text": "(And it is said unto the angels): Assemble those who did wrong, together with their wives and what they used to worship", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Toplayın mahşere o zulmedenleri, eşlerini ve Allah'tan başka taptıkları şeyleri. Toplayın da götürün onları sırata (cehennem köprüsüne) doğru.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہانکو ظالموں اور ان کے جوڑوں کو اور جو کچھ وہ پوجتے تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(kepada malaikat diperintahkan): \"Kumpulkanlah orang-orang yang zalim beserta teman sejawat mereka dan sembahan-sembahan yang selalu mereka sembah,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱحْشُرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ظَلَمُوا۟", "hit": true, "audio": "audio/22de31a961ff22ca7d86.m4a", "gloss": {"en": "they wronged", "bs": "nanijeli su nepravdu", "tr": "zulmettiler", "fr": "ils ont été injustes", "id": "mereka telah berbuat zalim", "ur": "انہوں نے ظلم کیا", "bn": "তারা অন্যায় করেছে", "fa": "ستم کردند"}}, {"text": "وَأَزْوَٰجَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْبُدُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:177", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1131.mp3", "translation": {"en": {"text": "Evil as an example are the folk who denied Our revelations, and were wont to wrong themselves.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Âyetlerimizi inkâr edip, sırf kendilerine zulmeden o kavmin hali ne kadar kötüdür!", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا بری کہاوت ہے ان کی جنہوں نے ہماری آیتیں جھٹلائیں اور اپنی ہی جان کا برا کرتے تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Amat buruklah perumpamaan orang-orang yang mendustakan ayat-ayat Kami dan kepada diri mereka sendirilah mereka berbuat zalim.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "سَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَثَلًا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقَوْمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "كَذَّبُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "بِـَٔايَٰتِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنفُسَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَظْلِمُونَ", "hit": true, "audio": "audio/b565b5719e3dcb6c31f7.m4a", "gloss": {"bs": "čine nepravdu", "en": "they wrong", "tr": "zulmediyorlar", "fr": "ils lésaient", "id": "mereka berbuat zalim", "ur": "ظلم کرتے تھے", "bn": "তারা জুলুম করে", "fa": "ستم می‌کنند"}}]}, {"ref": "10:44", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1408.mp3", "translation": {"en": {"text": "Lo! Allah wrongeth not mankind in aught; but mankind wrong themselves.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Şurası kesindir ki Allah, insanlara zerre kadar zulmetmez. Ne var ki, insanlar kendi kendilerine zulmedip duruyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک اللہ لوگوں پر کچھ ظلم نہیں کرتا ہاں لوگ ہی اپنی جانوں پر ظلم کرتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Allah tidak berbuat zalim kepada manusia sedikitpun, akan tetapi manusia itulah yang berbuat zalim kepada diri mereka sendiri.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَظْلِمُ", "hit": true, "audio": "audio/2406c60669ce09d0ff60.m4a", "gloss": {"en": "he/it wrongs", "bs": "nanosi nepravdu", "tr": "zulmeder", "fr": "il fait injustice", "id": "dia berbuat zalim", "ur": "وہ ظلم کرتا ہے", "bn": "সে অন্যায় করে", "fa": "ستم می‌کند"}}, {"text": "ٱلنَّاسَ", "hit": false, "audio": null, "gloss": null}, {"text": "شَيْـًٔا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَٰكِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلنَّاسَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنفُسَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَظْلِمُونَ", "hit": true, "audio": "audio/827b5ccc497cd52125df.m4a", "gloss": {"bs": "čine nepravdu", "en": "they wrong", "tr": "zulmediyorlar", "fr": "ils lésaient", "id": "mereka berbuat zalim", "ur": "ظلم کرتے تھے", "bn": "তারা জুলুম করে", "fa": "ستم می‌کنند"}}]}, {"ref": "27:11", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3170.mp3", "translation": {"en": {"text": "Save him who hath done wrong and afterward hath changed evil for good. And lo! I am Forgiving, Merciful.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ancak, kim haksızlık yapar, sonra yaptığı kötülüğü iyiliğe çevirirse, bilsin ki ben (ona karşı da) çok bağışlayıcıyım, çok merhamet sahibiyim.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہاں جو کوئی ز یادتی کرے پھر برائی کے بعد بھلائی سے بدلے تو بیشک میں بخشنے والا مہربان ہوں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "tetapi orang yang berlaku zalim, kemudian ditukarnya kezalimannya dengan kebaikan (Allah akan mengampuninya); maka seaungguhnya Aku Maha Pangampun lagi Maha Penyayang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "ظَلَمَ", "hit": true, "audio": "audio/1502ad1b3536a8b1d1c4.m4a", "gloss": {"en": "he/it wronged", "bs": "nanio je nepravdu", "tr": "zulmetti", "fr": "il a été injuste", "id": "dia telah berbuat zalim", "ur": "اُس نے ظلم کیا", "bn": "সে অন্যায় করেছে", "fa": "ستم کرد"}}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "بَدَّلَ", "hit": false, "audio": null, "gloss": null}, {"text": "حُسْنًۢا", "hit": false, "audio": null, "gloss": null}, {"text": "بَعْدَ", "hit": false, "audio": null, "gloss": null}, {"text": "سُوٓءٍ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "غَفُورٌ", "hit": false, "audio": null, "gloss": null}, {"text": "رَّحِيمٌ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "43:76", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4401.mp3", "translation": {"en": {"text": "We wronged them not, but they it was who did the wrong.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz onlara zulmetmedik, fakat onlar kendileri zâlimler oldular.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے ان پر کچھ ظلم نہ کیا، ہاں وہ خود ہی ظالم تھے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan tidaklah Kami menganiaya mereka tetapi merekalah yang menganiaya diri mereka sendiri.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "ظَلَمْنَٰهُمْ", "hit": true, "audio": "audio/1508582a6e2fb4bde66e.m4a", "gloss": {"bs": "učinili smo im nepravdu", "en": "We wronged them", "tr": "onlara zulmettik", "fr": "Nous les avons lésés", "id": "Kami menganiaya mereka", "ur": "ہم نے ان پر ظلم کیا", "bn": "আমরা তাদের প্রতি জুলুম করেছি", "fa": "به آنان ستم کردیم"}}, {"text": "وَلَٰكِن", "hit": false, "audio": null, "gloss": null}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "هُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلظَّٰلِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:33", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2173.mp3", "translation": {"en": {"text": "Each of the gardens gave its fruit and withheld naught thereof. And We caused a river to gush forth therein.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İki bağın ikisi de yemişlerini vermiş, hiçbir şey noksan bırakmamış, ikisinin ortasından bir de nehir akıtmışız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "دونوں باغ اپنے پھل لائے اور اس میں کچھ کمی نہ دی اور دونوں کے بیچ میں ہم نے نہر بہائی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kedua buah kebun itu menghasilkan buahnya, dan kebun itu tiada kurang buahnya sedikitpun, dan Kami alirkan sungai di celah-celah kedua kebun itu,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كِلْتَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْجَنَّتَيْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاتَتْ", "hit": false, "audio": null, "gloss": null}, {"text": "أُكُلَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَظْلِم", "hit": true, "audio": "audio/8f0ca62fa686909be028.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "jussive"}]}, {"text": "مِّنْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "شَيْـًٔا", "hit": false, "audio": null, "gloss": null}, {"text": "وَفَجَّرْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "خِلَٰلَهُمَا", "hit": false, "audio": null, "gloss": null}, {"text": "نَهَرًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ظَلَمُوا۟", "count": 28, "first": "2:59", "audio": "audio/83b16140c2088f8cf1bf.m4a", "grammar": [{"tense": "past", "pronoun"