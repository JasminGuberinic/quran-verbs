ed": false, "spoken": "audio/2cd73272b8058417798f.m4a", "recited": "audio/c34b5500f3d78dc72af1.m4a", "recitedText": "يُلْقُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يُلْقِينَ", "plain": "يُلْقِينَ", "quran": false, "notUsed": false, "spoken": "audio/3bbd8a4b9eb7cf3e4a86.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَلْقِ", "plain": "أَلْقِ", "quran": true, "notUsed": false, "spoken": "audio/3992c8aae0ba4d6948e0.m4a", "recited": "audio/0782468f6c058d9ccd51.m4a", "recitedText": "أَلْقِ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَلْقِي", "plain": "أَلْقِي", "quran": false, "notUsed": false, "spoken": "audio/50b58eaa49819fbc6445.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَلْقِيَا", "plain": "أَلْقِيَا", "quran": false, "notUsed": false, "spoken": "audio/0e76570639ed77165c73.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَلْقُوا۟", "plain": "أَلْقُوا", "quran": true, "notUsed": false, "spoken": "audio/2a2f09f0a36233070412.m4a", "recited": "audio/ff9a85d5a51c78f61583.m4a", "recitedText": "أَلْقُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَلْقِينَ", "plain": "أَلْقِينَ", "quran": false, "notUsed": false, "spoken": "audio/9614815f950bb9544806.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "75:15", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5566.mp3", "translation": {"en": {"text": "Although he tender his excuses.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bir takım özürler ortaya atsa da.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اگر اس کے پاس جتنے بہانے ہوں سب لا ڈالے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "meskipun dia mengemukakan alasan-alasannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلْقَىٰ", "hit": true, "audio": "audio/195e086f972458054f7d.m4a", "gloss": {"bs": "(makar) iznio", "en": "(though) he offered", "tr": "(onu) sunsa da", "fr": "(alors qu')il a présenté", "id": "(walaupun) dia menawarkan", "ur": "(اگرچہ) اس نے ڈالا", "bn": "(যদিও) সে পেশ করল", "fa": "(هرچند) افکند"}}, {"text": "مَعَاذِيرَهُۥ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:44", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2976.mp3", "translation": {"en": {"text": "Then they threw down their cords and their staves and said: By Pharaoh's might, lo! we verily are the winners.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine iplerini ve değneklerini attılar ve \"Firavun'un kudreti hakkı için şüphesiz elbette bizler galip geleceğiz\" dediler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو انہوں نے اپنی رسیاں اور لاٹھیاں ڈالیں اور بولے فرعون کی عزت کی قسم بیشک ہماری ہی جیت ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Lalu mereka melemparkan tali temali dan tongkat-tongkat mereka dan berkata: \"Demi kekuasaan Fir'aun, sesungguhnya kami benar-benar akan menang\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَلْقَوْا۟", "hit": true, "audio": "audio/402313bb16fc8ad46df0.m4a", "gloss": {"en": "so they threw", "bs": "pa su bacili"}}, {"text": "حِبَالَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَعِصِيَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَقَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "بِعِزَّةِ", "hit": false, "audio": null, "gloss": null}, {"text": "فِرْعَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْغَٰلِبُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:43", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2975.mp3", "translation": {"en": {"text": "Moses said unto them: Throw what ye are going to throw!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa onlara \"Atın, ne atacaksanız\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "موسیٰ نے ان سے فرمایا ڈالو جو تمہیں ڈالنا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berkatalah Musa kepada mereka: \"Lemparkanlah apa yang hendak kamu lemparkan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّوسَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلْقُوا۟", "hit": true, "audio": "audio/e51f5d07fdb4f72576ec.m4a", "gloss": {"en": "(you all) throw!", "bs": "bacite!", "tr": "atın!", "fr": "jetez !", "id": "lemparkanlah!", "ur": "ڈالو!", "bn": "নিক্ষেপ কর!", "fa": "بیندازید!"}}, {"text": "مَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنتُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّلْقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:19", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2367.mp3", "translation": {"en": {"text": "He said: Cast it down, O Moses!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah: \"Ey Musa! onu (yere) bırak\"dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "فرمایا اسے ڈال دے اے موسیٰ،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Allah berfirman: \"Lemparkanlah ia, hai Musa!\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلْقِهَا", "hit": true, "audio": "audio/5dc85540a6e84d14bda4.m4a", "gloss": {"bs": "baci ga!", "en": "throw it!", "tr": "onu at!", "fr": "jette-le !", "id": "lemparkanlah!", "ur": "اسے ڈال دے!", "bn": "তা নিক্ষেপ করো!", "fa": "آن را بینداز!"}}, {"text": "يَٰمُوسَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "38:34", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4004.mp3", "translation": {"en": {"text": "And verily We tried Solomon, and set upon his throne a (mere) body. Then did he repent.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Andolsun ki Süleyman'ı imtihan da ettik ve tahtının üzerine bir ceset bıraktık. Sonra tekrar tevbe ile önceki haline döndü.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے سلیمان کو جانچا اور اس کے تخت پر ایک بے جان بدن ڈال دیا پھر رجوع لایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya Kami telah menguji Sulaiman dan Kami jadikan (dia) tergeletak di atas kursinya sebagai tubuh (yang lemah karena sakit), kemudian ia bertaubat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "سُلَيْمَٰنَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَلْقَيْنَا", "hit": true, "audio": "audio/0f49a3f7cefce733d9b5.m4a", "gloss": {"en": "and we threw", "bs": "i bacili smo"}}, {"text": "عَلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "كُرْسِيِّهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "جَسَدًا", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنَابَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:223", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3155.mp3", "translation": {"en": {"text": "They listen eagerly, but most of them are liars.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, (şeytanlara) kulak verirler ve onların çoğu yalancıdır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "شیطان اپنی سنی ہوئی ان پر ڈالتے ہیں اور ان میں اکثر جھوٹے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka menghadapkan pendengaran (kepada syaitan) itu, dan kebanyakan mereka adalah orang-orang pendusta.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يُلْقُونَ", "hit": true, "audio": "audio/c34b5500f3d78dc72af1.m4a", "gloss": {"bs": "prisluškuju (bacaju sluh)", "en": "they give (ear)", "tr": "kulak verirler", "fr": "ils prêtent (l'oreille)", "id": "mereka (memasang) telinga", "ur": "وہ (کان) لگاتے ہیں", "bn": "তারা (কান) পেতে দেয়", "fa": "(گوش) می‌دهند"}}, {"text": "ٱلسَّمْعَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَكْثَرُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَٰذِبُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَأَلْقَيْنَا", "count": 4, "first": "5:64", "audio": "audio/28477877155e9ddf1b83.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "and we threw; and we cast", "bs": "i bacili smo", "tr": "ve attık", "fr": "et nous avons jeté ; et nous avons lancé", "id": "dan kami telah melemparkan", "ur": "اور ہم نے ڈالا", "bn": "এবং আমরা নিক্ষেপ করলাম", "fa": "و انداختیم"}}, {"arabic": "أَلْقُوا۟", "count": 4, "first": "7:116", "audio": "audio/ff9a85d5a51c78f61583.m4a",