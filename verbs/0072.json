null, "recitedText": null}, {"tense": "present", "pronoun": "anti", "arabic": "تَزِيدِينَ", "plain": "تَزِيدِينَ", "quran": false, "notUsed": false, "spoken": "audio/e6534dd9ffef76456579.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تَزِيدَانِ", "plain": "تَزِيدَانِ", "quran": false, "notUsed": false, "spoken": "audio/dbcac07cfe278862925c.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَزِيدُونَ", "plain": "تَزِيدُونَ", "quran": false, "notUsed": false, "spoken": "audio/35e67618b1d6c76d6878.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antunna", "arabic": "تَزِدْنَ", "plain": "تَزِدْنَ", "quran": false, "notUsed": false, "spoken": "audio/55bf860f8b1e083f5879.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَزِيدُ", "plain": "يَزِيدُ", "quran": true, "notUsed": false, "spoken": "audio/2a1d8f4eeb2945188502.m4a", "recited": "audio/9195de46e4c49eb68817.m4a", "recitedText": "يَزِيدُ"}, {"tense": "present", "pronoun": "hiya", "arabic": "تَزِيدُ", "plain": "تَزِيدُ", "quran": false, "notUsed": false, "spoken": "audio/8df8e9c40a64918c09d3.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يَزِيدَانِ", "plain": "يَزِيدَانِ", "quran": false, "notUsed": false, "spoken": "audio/9f4087e6d6851fef23da.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَزِيدُونَ", "plain": "يَزِيدُونَ", "quran": true, "notUsed": false, "spoken": "audio/d1155df1ed3a78a30624.m4a", "recited": "audio/d79ee14c1cb0449e112a.m4a", "recitedText": "يَزِيدُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَزِدْنَ", "plain": "يَزِدْنَ", "quran": false, "notUsed": false, "spoken": "audio/bc93a01555d6bf30f82b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "زِدْ", "plain": "زِدْ", "quran": true, "notUsed": false, "spoken": "audio/9c311749b1b067372dd4.m4a", "recited": "audio/abe7b577cacaedcd95ec.m4a", "recitedText": "زِدْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "زِيدِي", "plain": "زِيدِي", "quran": false, "notUsed": false, "spoken": "audio/1f66ed9b8ed4a489c6c7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "زِيدَا", "plain": "زِيدَا", "quran": false, "notUsed": false, "spoken": "audio/ccc47d1133007ed92a1a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "زِيدُوا", "plain": "زِيدُوا", "quran": false, "notUsed": false, "spoken": "audio/0506047e36a11637f1a2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "زِدْنَ", "plain": "زِدْنَ", "quran": false, "notUsed": false, "spoken": "audio/1605ce65e06ffd9a8d7d.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "17:109", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2138.mp3", "translation": {"en": {"text": "They fall down on their faces, weeping, and it increaseth humility in them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve ağlayarak yüzleri üstü secdeye kapanırlar. Hem de bu Kur'ân'ı işitmek onların Allah'a teslimiyetlerini daha da artırır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور تھوڑی کے بل گرتے ہیں روتے ہوئے اور یہ قرآن ان کے دل کا جھکنا بڑھاتا ہے، (السجدة) ۴", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan mereka menyungkur atas muka mereka sambil menangis dan mereka bertambah khusyu'.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَخِرُّونَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلْأَذْقَانِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَبْكُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَزِيدُهُمْ", "hit": true, "audio": "audio/9c5c81ac0a9f501d17d8.m4a", "gloss": {"en": "and he/it increases them", "bs": "i povećava ih", "tr": "ve onları artırır", "fr": "et il les augmente", "id": "dan dia menambah mereka", "ur": "اور وہ انہیں بڑھاتا ہے", "bn": "এবং সে তাদের বৃদ্ধি করে", "fa": "و آنان را می‌افزاید"}}, {"text": "خُشُوعًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "47:17", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4562.mp3", "translation": {"en": {"text": "While as for those who walk aright, He addeth to their guidance, and giveth them their protection (against evil).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Doğru yola girenlere gelince, Allah onların hidayetlerini artırmış ve onlara kötülükten sakınma çarelerini ilham etmiştir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جنہوں نے راہ پائی اللہ نے ان کی ہدایت اور زیادہ فرمائی اور ان کی پرہیزگاری انہیں عطا فرمائی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang mau menerima petunjuk, Allah menambah petunjuk kepada mereka dan memberikan balasan ketakwaannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱهْتَدَوْا۟", "hit": false, "audio": null, "gloss": null}, {"text": "زَادَهُمْ", "hit": true, "audio": "audio/c758e38a77f034320cc4.m4a", "gloss": {"bs": "povećao im je", "en": "He increased them", "tr": "onların artırdı", "fr": "Il les a accrus", "id": "Dia menambah mereka", "ur": "اس نے انہیں بڑھا دیا", "bn": "তিনি তাদের বৃদ্ধি করলেন", "fa": "بر آنان افزود"}}, {"text": "هُدًى", "hit": false, "audio": null, "gloss": null}, {"text": "وَءَاتَىٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَقْوَىٰهُمْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "78:30", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5702.mp3", "translation": {"en": {"text": "So taste (of that which ye have earned). No increase do We give you save of torment.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Onlara): \"Şimdi tadın (cezanızı). Artık size azabınızı artırmaktan başka bir şey yapmayacağız\" (denir).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اب چکھو کہ ہم تمہیں نہ بڑھائیں گے مگر عذاب،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Karena itu rasakanlah. Dan Kami sekali-kali tidak akan menambah kepada kamu selain daripada azab.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَذُوقُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فَلَن", "hit": false, "audio": null, "gloss": null}, {"text": "نَّزِيدَكُمْ", "hit": true, "audio": "audio/fbe6c5fc166f2a51cb5c.m4a", "gloss": {"en": "we increase you (all)", "bs": "povećavamo vas", "tr": "sizi artırırız", "fr": "nous vous augmentons", "id": "kami menambah kalian", "ur": "ہم تمہیں بڑھاتے ہیں", "bn": "আমরা তোমাদের বৃদ্ধি করি", "fa": "شما را بیفزاییم"}}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "عَذَابًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "9:125", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1360.mp3", "translation": {"en": {"text": "But as for those in whose hearts is disease, it only addeth wickedness to their wickedness, and they die while they are disbelievers.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kalblerinde bir hastalık olanlara gelince, onların da murdarlıklarına (küfürlerine) murdarlık (küfür) katmıştır ve kâfir olarak ölüp gitmişlerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جن کے دلوں میں آزار ہے انہیں اور پلیدی پر پلیدی بڑھائی اور وہ کفر ہی پر مر گئے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan adapun orang-orang yang di dalam hati mereka ada penyakit, maka dengan surat itu bertambah kekafiran mereka, disamping kekafirannya (yang telah ada) dan mereka mati dalam keadaan kafir.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "قُلُوبِهِم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّرَضٌ", "hit": false, "audio": null, "gloss": null}, {"text": "فَزَادَتْهُمْ", "hit": true, "audio": "audio/6b7057dd5fd145db6900.m4a", "gloss": {"en": "so she/it increased them", "bs": "pa ih je povećala", "tr": "böylece onları artırdı", "fr": "alors elle les a augmentés", "id": "dia telah menambah mereka", "ur": "پس اُس نے انہیں بڑھایا", "bn": "অতএব সে তাদের বৃদ্ধি করল", "fa": "پس آنان را افزود"}}, {"text": "رِجْسًا", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "رِجْسِهِمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَاتُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَٰفِرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "73:4", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5479.mp3", "translation": {"en": {"text": "Or add (a little) thereto - and chant the Qur'an in measure,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Veya bunu artır ve ağır ağır Kur'ân oku.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا اس پر کچھ بڑھاؤ اور قرآن خوب ٹھہر ٹھہر کر پڑھو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "atau lebih dari seperdua itu. Dan bacalah Al Quran itu dengan perlahan-lahan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَوْ", "hit": false, "audio": null, "gloss": null}, {"text": "زِدْ", "hit": true, "audio": "audio/abe7b577cacaedcd95ec.m4a", "gloss": {"bs": "dodaj!", "en": "add!", "tr": "artır!", "fr": "ajoute !", "id": "tambahlah!", "ur": "بڑھا دے!", "bn": "বাড়িয়ে দাও!", "fa": "بیفزای!"}}, {"text": "عَلَيْهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَرَتِّلِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقُرْءَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَرْتِيلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "74:15", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5510.mp3", "translation": {"en": {"text": "Yet he desireth that I should give more.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra da şiddetle arzu eder ki daha da artırayım.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر یہ طمع کرتا ہے کہ میں اور زیادہ دوں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "kemudian dia ingin sekali supaya Aku menambahnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "يَطْمَعُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَزِيدَ", "hit": true, "audio": "audio/ee1c477828c92d0599b8.m4a", "gloss": {"bs": "(da mu) još dodam", "en": "(that) I add more", "tr": "(ona) daha da artırayım", "fr": "(que) j'ajoute davantage", "id": "(agar) aku menambah", "ur": "(کہ) میں اور بڑھاؤں", "bn": "(যে) আমি আরও বাড়াই", "fa": "(که) بیفزایم"}}]}], "for