{"rank": 102, "root": "بشر", "form": 2, "lemma": "بَشَّرَ", "count": 38, "ayahCount": 37, "share": 0.2, "meaning": {"bs": "obradovati, navijestiti radosnu vijest", "en": "to give good news, to announce", "tr": "müjdelemek, bildirmek", "fr": "annoncer la bonne nouvelle", "id": "memberi kabar gembira, mengumumkan", "ur": "خوشخبری دینا، بشارت دینا", "bn": "সুসংবাদ দেওয়া, ঘোষণা করা", "fa": "بشارت دادن، مژده دادن"}, "lemmaSpoken": "audio/825bc781bd676761846d.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "بَشَّرَ", "plain": "بَشَّرَ", "quran": false, "notUsed": false, "spoken": "audio/825bc781bd676761846d.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يُبَشِّرُ", "plain": "يُبَشِّرُ", "quran": true, "notUsed": false, "spoken": "audio/8e5442b8d9647c233393.m4a", "recited": "audio/660d6dbc86d37884cd55.m4a", "recitedText": "يُبَشِّرُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "بَشِّرِ", "plain": "بَشِّرْ", "quran": true, "notUsed": false, "spoken": "audio/78fa1f4331e1185edf1e.m4a", "recited": "audio/070bde09d0682ab4cf90.m4a", "recitedText": "بَشِّرِ"}], "nouns": {"participle": {"lemma": "مُبَشِّر", "count": 9, "spoken": "audio/3ef696ef88677046a306.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "بَشَّرْتُ", "plain": "بَشَّرْتُ", "quran": false, "notUsed": false, "spoken": "audio/c4b3023b71f15e17820a.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "بَشَّرْنَا", "plain": "بَشَّرْنَا", "quran": false, "notUsed": false, "spoken": "audio/bf75610b45e1021b398f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "بَشَّرْتَ", "plain": "بَشَّرْتَ", "quran": false, "notUsed": false, "spoken": "audio/3e95fb77b0fd155755cc.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "بَشَّرْتِ", "plain": "بَشَّرْتِ", "quran": false, "notUsed": false, "spoken": "audio/a8dfcf7dcb