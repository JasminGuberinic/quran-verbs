", "quran": false, "notUsed": false, "spoken": "audio/429a2a0d441629422d38.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "تَذَكَّرِي", "plain": "تَذَكَّرِي", "quran": false, "notUsed": false, "spoken": "audio/d219e88ed427abed4547.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "تَذَكَّرَا", "plain": "تَذَكَّرَا", "quran": false, "notUsed": false, "spoken": "audio/237c4dc1d46a40e2b6d4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "تَذَكَّرُوا", "plain": "تَذَكَّرُوا", "quran": false, "notUsed": false, "spoken": "audio/6dee0a521f4b7aaaf75d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "تَذَكَّرْنَ", "plain": "تَذَكَّرْنَ", "quran": false, "notUsed": false, "spoken": "audio/61ef0bc5b7390b742b58.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "23:85", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2758.mp3", "translation": {"en": {"text": "They will say: Unto Allah. Say: Will ye not then remember?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Allah'a aittir\" diyecekler. \"Öyle ise siz hiç düşünüp taşınmaz mısınız?\" de.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اب کہیں گے کہ اللہ کا تم فرماؤ پھر کیوں نہیں سوچتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka akan menjawab: \"Kepunyaan Allah\". Katakanlah: \"Maka apakah kamu tidak ingat?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "سَيَقُولُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَفَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَذَكَّرُونَ", "hit": true, "audio": "audio/df5d544b1333a514b4ca.m4a", "gloss": {"en": "you (all) remember", "bs": "sjećate se", "tr": "hatırlıyorsunuz", "fr": "vous vous souvenez", "id": "kalian mengingat", "ur": "تم سب یاد کرتے ہو", "bn": "তোমরা স্মরণ কর", "fa": "یاد می‌کنید"}}]}, {"ref": "44:58", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4472.mp3", "translation": {"en": {"text": "And We have made (this Scripture) easy in thy language only that they may heed.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz Kur'ân'ı senin dilinle indirip kolaylaştırdık. Umulur ki onlar öğüt alırlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو ہم نے اس قرآن کو تمہاری زبان میں آسان کیا کہ وہ سمجھیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Kami mudahkan Al Quran itu dengan bahasamu supaya mereka mendapat pelajaran.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَإِنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسَّرْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "بِلِسَانِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَذَكَّرُونَ", "hit": true, "audio": "audio/9d2a1f12b332c2f33299.m4a", "gloss": {"en": "they remember", "bs": "sjećaju se", "tr": "hatırlarlar", "fr": "ils se souviennent", "id": "mereka mengingat", "ur": "وہ یاد کرتے ہیں", "bn": "তারা স্মরণ করে", "fa": "یاد می‌کنند"}}]}, {"ref": "87:10", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5958.mp3", "translation": {"en": {"text": "He will heed who feareth,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Saygısı olan öğüt alacaktır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "عنقریب نصیحت مانے گا جو ڈرتا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "orang yang takut (kepada Allah) akan mendapat pelajaran,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "سَيَذَّكَّرُ", "hit": true, "audio": "audio/579b61ccf04ffbd13352.m4a", "gloss": {"bs": "poučit će se", "en": "will take heed", "tr": "öğüt alacaklar", "fr": "réfléchira", "id": "akan mengambil pelajaran", "ur": "نصیحت پکڑے گا", "bn": "সে উপদেশ গ্রহণ করবে", "fa": "پند خواهد گرفت"}}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَخْشَىٰ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:201", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1155.mp3", "translation": {"en": {"text": "Lo! those who ward off (evil), when a glamour from the devil troubleth them, they do but remember (Allah's Guidance) and behold them seers!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Allah'tan korkanlar, kendilerine şeytandan bir vesvese iliştiği zaman, durup düşünürler de derhal kendi basiretlerine sahib olurlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک وہ جو ڈر والے ہیں جب انہیں کسی شیطانی خیال کی ٹھیس لگتی ہے ہوشیار ہوجاتے ہیں اسی وقت ان کی آنکھیں کھل جاتی ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya orang-orang yang bertakwa bila mereka ditimpa was-was dari syaitan, mereka ingat kepada Allah, maka ketika itu juga mereka melihat kesalahan-kesalahannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱتَّقَوْا۟", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss":