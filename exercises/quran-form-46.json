[{"id":"tawalla-53-33-2","words":["verb:tawalla"],"options":[{"bs":"okrenuo se","en":"he/it turned away"},{"bs":"uzima ih za prijatelje","en":"he/it befriends them"},{"bs":"okrenuli ste se","en":"you (all) turned away"},{"bs":"uzimate ih za prijatelje","en":"you (all) befriend them"}],"ref":"53:33","answerWord":"تَوَلَّىٰ","answerSound":"audio/3fb61d6340bf603073fc.m4a","quranTranslation":{"text":"Didst thou (O Muhammad) observe him who turned away,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["أَفَرَءَيْتَ","ٱلَّذِى","تَوَلَّىٰ"],"marked":[2],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-47-22-3","words":["verb:tawalla"],"options":[{"bs":"okrenuli ste se","en":"you (all) turned away"},{"bs":"uzimate ih za prijatelje","en":"you (all) befriend them"},{"bs":"i okreću se","en":"and they turn away"},{"bs":"okrenuo se","en":"he/it turned away"}],"ref":"47:22","answerWord":"تَوَلَّيْتُمْ","answerSound":"audio/cc7d75f7defe40184253.m4a","quranTranslation":{"text":"Would ye then, if ye were given the command, work corruption in the land and sever your ties of kinship?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["فَهَلْ","عَسَيْتُمْ","إِن","تَوَلَّيْتُمْ","أَن","تُفْسِدُوا۟","فِى","ٱلْأَرْضِ","وَتُقَطِّعُوٓا۟","أَرْحَامَكُمْ"],"marked":[3],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-12-84-0","words":["verb:tawalla"],"options":[{"bs":"i okrenuo se","en":"and he/it turned away"},{"bs":"uzima ih za prijatelje","en":"he/it befriends them"},{"bs":"i okreću se","en":"and they turn away"},{"bs":"okreni se!","en":"turn away!"}],"ref":"12:84","answerWord":"وَتَوَلَّىٰ","answerSound":"audio/6f3e468e7f3ae05099fb.m4a","quranTranslation":{"text":"And he turned away from them and said: Alas, my grief for Joseph! And his eyes were whitened with the sorrow that he was suppressing.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["وَتَوَلَّىٰ","عَنْهُمْ","وَقَالَ","يَٰٓأَسَفَىٰ","عَلَىٰ","يُوسُفَ","وَٱبْيَضَّتْ","عَيْنَاهُ","مِنَ","ٱلْحُزْنِ","فَهُوَ","كَظِيمٌ"],"marked":[0],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-5-56-1","words":["verb:tawalla"],"options":[{"bs":"uzima za prijatelja","en":"he/it befriends"},{"bs":"okrenuo se","en":"he/it turned away"},{"bs":"pa se okreni!","en":"so turn away!"},{"bs":"i okrenuli su se","en":"and they turned away"}],"ref":"5:56","answerWord":"يَتَوَلَّ","answerSound":"audio/bc59cda3817356e13924.m4a","quranTranslation":{"text":"And whoso taketh Allah and His messenger and those who believe for guardian (will know that), lo! the party of Allah, they are the victorious.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["وَمَن","يَتَوَلَّ","ٱللَّهَ","وَرَسُولَهُۥ","وَٱلَّذِينَ","ءَامَنُوا۟","فَإِنَّ","حِزْبَ","ٱللَّهِ","هُمُ","ٱلْغَٰلِبُونَ"],"marked":[1],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-7-79-0","words":["verb:tawalla"],"options":[{"bs":"pa se okrenuo","en":"so he/it turned away"},{"bs":"uzima ih za prijatelje","en":"he/it befriends them"},{"bs":"i okreću se","en":"and they turn away"},{"bs":"i okreni se!","en":"and turn away!"}],"ref":"7:79","answerWord":"فَتَوَلَّىٰ","answerSound":"audio/e26c73f7cfee4784a1b4.m4a","quranTranslation":{"text":"And (Salih) turned from them and said: O my people! I delivered my Lord's message unto you and gave you good advice, but ye love not good advisers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["فَتَوَلَّىٰ","عَنْهُمْ","وَقَالَ","يَٰقَوْمِ","لَقَدْ","أَبْلَغْتُكُمْ","رِسَالَةَ","رَبِّى","وَنَصَحْتُ","لَكُمْ","وَلَٰكِن","لَّا","تُحِبُّونَ","ٱلنَّٰصِحِينَ"],"marked":[0],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-37-174-0","words":["verb:tawalla"],"options":[{"bs":"pa se okreni!","en":"so turn away!"},{"bs":"uzima za prijatelja","en":"he/it befriends"},{"bs":"okrenuli ste se","en":"you (all) turned away"},{"bs":"okreću se","en":"they turn away"}],"ref":"37:174","answerWord":"فَتَوَلَّ","answerSound":"audio/e2f7d12661bc3c6041d1.m4a","quranTranslation":{"text":"So withdraw from them (O Muhammad) awhile,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["فَتَوَلَّ","عَنْهُمْ","حَتَّىٰ","حِينٍ"],"marked":[0],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-2-64-1","words":["verb:tawalla"],"options":[{"bs":"okrenuli ste se","en":"you (all) turned away"},{"bs":"uzima ih za prijatelje","en":"he/it befriends them"},{"bs":"i okrenuli su se","en":"and they turned away"},{"bs":"uzima za prijatelja","en":"he/it befriends"}],"ref":"2:64","answerWord":"تَوَلَّيْتُم","answerSound":"audio/9a654b7f90f4a36e7cc6.m4a","quranTranslation":{"text":"Then, even after that, ye turned away, and if it had not been for the grace of Allah and His mercy ye had been among the losers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["ثُمَّ","تَوَلَّيْتُم","مِّنۢ","بَعْدِ","ذَٰلِكَ","فَلَوْلَا","فَضْلُ","ٱللَّهِ","عَلَيْكُمْ","وَرَحْمَتُهُۥ","لَكُنتُم","مِّنَ","ٱلْخَٰسِرِينَ"],"marked":[1],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-3-23-15","words":["verb:tawalla"],"options":[{"bs":"okreće se","en":"he/it turns away"},{"bs":"i okreću se","en":"and they turn away"},{"bs":"i okrenuo se","en":"and he/it turned away"},{"bs":"i okrenuli su se","en":"and they turned away"}],"ref":"3:23","answerWord":"يَتَوَلَّىٰ","answerSound":"audio/29db86efaabfd186c59b.m4a","quranTranslation":{"text":"Hast thou not seen how those who have received a portion of the Scripture invoke the Scripture of Allah (in their disputes) that it may judge between them; then a faction of them turn away, being opposed (to it)?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["أَلَمْ","تَرَ","إِلَى","ٱلَّذِينَ","أُوتُوا۟","نَصِيبًا","مِّنَ","ٱلْكِتَٰبِ","يُدْعَوْنَ","إِلَىٰ","كِتَٰبِ","ٱللَّهِ","لِيَحْكُمَ","بَيْنَهُمْ","ثُمَّ","يَتَوَلَّىٰ","فَرِيقٌ","مِّنْهُمْ","وَهُم","مُّعْرِضُونَ"],"marked":[15],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-5-43-8","words":["verb:tawalla"],"options":[{"bs":"okreću se","en":"they turn away"},{"bs":"okreni se!","en":"turn away!"},{"bs":"uzima ih za prijatelje","en":"he/it befriends them"},{"bs":"uzeo ga je za prijatelja","en":"he/it befriended him"}],"ref":"5:43","answerWord":"يَتَوَلَّوْنَ","answerSound":"audio/4b85d4e1486b4cd171ff.m4a","quranTranslation":{"text":"How come they unto thee for judgment when they have the Torah, wherein Allah hath delivered judgment (for them)? Yet even after that they turn away. Such (folk) are not believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["وَكَيْفَ","يُحَكِّمُونَكَ","وَعِندَهُمُ","ٱلتَّوْرَىٰةُ","فِيهَا","حُكْمُ","ٱللَّهِ","ثُمَّ","يَتَوَلَّوْنَ","مِنۢ","بَعْدِ","ذَٰلِكَ","وَمَآ","أُو۟لَٰٓئِكَ","بِٱلْمُؤْمِنِينَ"],"marked":[8],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-5-51-12","words":["verb:tawalla"],"options":[{"bs":"uzima ih za prijatelje","en":"he/it befriends them"},{"bs":"okreće se","en":"he/it turns away"},{"bs":"okrenuli ste se","en":"you (all) turned away"},{"bs":"i okrenuo se","en":"and he/it turned away"}],"ref":"5:51","answerWord":"يَتَوَلَّهُم","answerSound":"audio/77146472dc4a6ec80946.m4a","quranTranslation":{"text":"O ye who believe! Take not the Jews and the Christians for friends. They are friends one to another. He among you who taketh them for friends is (one) of them. Lo! Allah guideth not wrongdoing folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","لَا","تَتَّخِذُوا۟","ٱلْيَهُودَ","وَٱلنَّصَٰرَىٰٓ","أَوْلِيَآءَ","بَعْضُهُمْ","أَوْلِيَآءُ","بَعْضٍ","وَمَن","يَتَوَلَّهُم","مِّنكُمْ","فَإِنَّهُۥ","مِنْهُمْ","إِنَّ","ٱللَّهَ","لَا","يَهْدِى","ٱلْقَوْمَ","ٱلظَّٰلِمِينَ"],"marked":[12],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-80-1-1","words":["verb:tawalla"],"options":[{"bs":"i okrenuo se","en":"and he/it turned away"},{"bs":"okreni se!","en":"turn away!"},{"bs":"brine se o","en":"He takes care of"},{"bs":"i okreću se","en":"and they turn away"}],"ref":"80:1","answerWord":"وَتَوَلَّىٰٓ","answerSound":"audio/cd786cdaf4aa238242ae.m4a","quranTranslation":{"text":"He frowned and turned away","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["عَبَسَ","وَتَوَلَّىٰٓ"],"marked":[1],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-7-196-7","words":["verb:tawalla"],"options":[{"bs":"brine se o","en":"He takes care of"},{"bs":"uzima ih za prijatelje","en":"he/it befriends them"},{"bs":"i okreni se!","en":"and turn away!"},{"bs":"uzimaju ga za prijatelja","en":"they befriend him"}],"ref":"7:196","answerWord":"يَتَوَلَّى","answerSound":"audio/8e59cabc834c96c6ef7d.m4a","quranTranslation":{"text":"Lo! my Protecting Friend is Allah Who revealeth the Scripture. He befriendeth the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["إِنَّ","وَلِۦِّىَ","ٱللَّهُ","ٱلَّذِى","نَزَّلَ","ٱلْكِتَٰبَ","وَهُوَ","يَتَوَلَّى","ٱلصَّٰلِحِينَ"],"marked":[7],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-9-50-13","words":["verb:tawalla"],"options":[{"bs":"i okreću se","en":"and they turn away"},{"bs":"uzima za prijatelja","en":"he/it befriends"},{"bs":"uzimaju ga za prijatelja","en":"they befriend him"},{"bs":"i okreni se!","en":"and turn away!"}],"ref":"9:50","answerWord":"وَيَتَوَلَّوا۟","answerSound":"audio/bfa9283496692bb22747.m4a","quranTranslation":{"text":"If good befalleth thee (O Muhammad) it afflicteth them, and if calamity befalleth thee, they say: We took precaution, and they turn away well pleased.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["إِن","تُصِبْكَ","حَسَنَةٌ","تَسُؤْهُمْ","وَإِن","تُصِبْكَ","مُصِيبَةٌ","يَقُولُوا۟","قَدْ","أَخَذْنَآ","أَمْرَنَا","مِن","قَبْلُ","وَيَتَوَلَّوا۟","وَّهُمْ","فَرِحُونَ"],"marked":[13],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-16-100-4","words":["verb:tawalla"],"options":[{"bs":"uzimaju ga za prijatelja","en":"they befriend him"},{"bs":"okrenuo se","en":"he/it turned away"},{"bs":"i okreću se","en":"and they turn away"},{"bs":"pa se okreni!","en":"so turn away!"}],"ref":"16:100","answerWord":"يَتَوَلَّوْنَهُۥ","answerSound":"audio/ec2129d492e950d2e94f.m4a","quranTranslation":{"text":"His power is only over those who make a friend of him, and those who ascribe partners unto Him (Allah).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["إِنَّمَا","سُلْطَٰنُهُۥ","عَلَى","ٱلَّذِينَ","يَتَوَلَّوْنَهُۥ","وَٱلَّذِينَ","هُم","بِهِۦ","مُشْرِكُونَ"],"marked":[4],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-22-4-4","words":["verb:tawalla"],"options":[{"bs":"uzeo ga je za prijatelja","en":"he/it befriended him"},{"bs":"okreni se!","en":"turn away!"},{"bs":"i okrenuo se","en":"and he/it turned away"},{"bs":"okreće se","en":"he/it turns away"}],"ref":"22:4","answerWord":"تَوَلَّاهُ","answerSound":"audio/72179aa03d47573303e6.m4a","quranTranslation":{"text":"For him it is decreed that whoso taketh him for friend, he verily will mislead him and will guide him to the punishment of the Flame.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["كُتِبَ","عَلَيْهِ","أَنَّهُۥ","مَن","تَوَلَّاهُ","فَأَنَّهُۥ","يُضِلُّهُۥ","وَيَهْدِيهِ","إِلَىٰ","عَذَابِ","ٱلسَّعِيرِ"],"marked":[4],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-27-28-6","words":["verb:tawalla"],"options":[{"bs":"okreni se!","en":"turn away!"},{"bs":"okrenuli ste se","en":"you (all) turned away"},{"bs":"uzeo ga je za prijatelja","en":"he/it befriended him"},{"bs":"okreće se","en":"he/it turns away"}],"ref":"27:28","answerWord":"تَوَلَّ","answerSound":"audio/bf44622385d7cea10870.m4a","quranTranslation":{"text":"Go with this my letter and throw it down unto them; then turn away and see what (answer) they return,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["ٱذْهَب","بِّكِتَٰبِى","هَٰذَا","فَأَلْقِهْ","إِلَيْهِمْ","ثُمَّ","تَوَلَّ","عَنْهُمْ","فَٱنظُرْ","مَاذَا","يَرْجِعُونَ"],"marked":[6],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-28-24-3","words":["verb:tawalla"],"options":[{"bs":"okrenuo se","en":"he/it turned away"},{"bs":"okreću se","en":"they turn away"},{"bs":"uzima za prijatelja","en":"he/it befriends"},{"bs":"okrenuli ste se","en":"you (all) turned away"}],"ref":"28:24","answerWord":"تَوَلَّىٰٓ","answerSound":"audio/d7ada77ba9b592e5a648.m4a","quranTranslation":{"text":"So he watered (their flock) for them. Then he turned aside into the shade, and said: My Lord! I am needy of whatever good Thou sendest down for me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["فَسَقَىٰ","لَهُمَا","ثُمَّ","تَوَلَّىٰٓ","إِلَى","ٱلظِّلِّ","فَقَالَ","رَبِّ","إِنِّى","لِمَآ","أَنزَلْتَ","إِلَىَّ","مِنْ","خَيْرٍ","فَقِيرٌ"],"marked":[3],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-37-178-0","words":["verb:tawalla"],"options":[{"bs":"i okreni se!","en":"and turn away!"},{"bs":"okrenuo se","en":"he/it turned away"},{"bs":"okreće se","en":"he/it turns away"},{"bs":"okrenuli su se","en":"they turned away"}],"ref":"37:178","answerWord":"وَتَوَلَّ","answerSound":"audio/5835452b39f0aae2fe11.m4a","quranTranslation":{"text":"Withdraw from them awhile","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["وَتَوَلَّ","عَنْهُمْ","حَتَّىٰ","حِينٍ"],"marked":[0],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-60-9-15","words":["verb:tawalla"],"options":[{"bs":"uzimate ih za prijatelje","en":"you (all) befriend them"},{"bs":"okrenuo se","en":"he/it turned away"},{"bs":"uzima ih za prijatelje","en":"he/it befriends them"},{"bs":"i okrenuli su se","en":"and they turned away"}],"ref":"60:9","answerWord":"تَوَلَّوْهُمْ","answerSound":"audio/082bc181ae2bdf9bb732.m4a","quranTranslation":{"text":"Allah forbiddeth you only those who warred against you on account of religion and have driven you out from your homes and helped to drive you out, that ye make friends of them. Whosoever maketh friends of them - (All) such are wrong-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["إِنَّمَا","يَنْهَىٰكُمُ","ٱللَّهُ","عَنِ","ٱلَّذِينَ","قَٰتَلُوكُمْ","فِى","ٱلدِّينِ","وَأَخْرَجُوكُم","مِّن","دِيَٰرِكُمْ","وَظَٰهَرُوا۟","عَلَىٰٓ","إِخْرَاجِكُمْ","أَن","تَوَلَّوْهُمْ","وَمَن","يَتَوَلَّهُمْ","فَأُو۟لَٰٓئِكَ","هُمُ","ٱلظَّٰلِمُونَ"],"marked":[15],"facts":{"verb":"تَوَلَّى"}},{"id":"tawalla-60-9-17","words":["verb:tawalla"],"options":[{"bs":"uzima ih za prijatelje","en":"he/it befriends them"},{"bs":"pa su se okrenuli","en":"so they turned away"},{"bs":"uzima za prijatelja","en":"he/it befriends"},{"bs":"pa se okrenuo","en":"so he/it turned away"}],"ref":"60:9","answerWord":"يَتَوَلَّهُمْ","answerSound":"audio/d06845c819884c576d29.m4a","quranTranslation":{"text":"Allah forbiddeth you only those who warred against you on account of religion and have driven you out from your homes and helped to drive you out, that ye make friends of them. Whosoever maketh friends of them - (All) such are wrong-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"okrenuti se; brinuti se o","en":"to turn away; to take charge of"},"passage":["إِنَّمَا","يَنْهَىٰكُمُ","ٱللَّهُ","عَنِ","ٱلَّذِينَ","قَٰتَلُوكُمْ","فِى","ٱلدِّينِ","وَأَخْرَجُوكُم","مِّن","دِيَٰرِكُمْ","وَظَٰهَرُوا۟","عَلَىٰٓ","إِخْرَاجِكُمْ","أَن","تَوَلَّوْهُمْ","وَمَن","يَتَوَلَّهُمْ","فَأُو۟لَٰٓئِكَ","هُمُ","ٱلظَّٰلِمُونَ"],"marked":[17],"facts":{"verb":"تَوَلَّى"}},{"id":"istakbara-37-35-9","words":["verb:istakbara"],"options":[{"bs":"oholili su se","en":"they were arrogant"},{"bs":"uzoholili ste se","en":"you (all) were arrogant"},{"bs":"i oholi se","en":"and he/it is arrogant"},{"bs":"pa su se uzoholili","en":"so they were arrogant"}],"ref":"37:35","answerWord":"يَسْتَكْبِرُونَ","answerSound":"audio/00e8cc90079857ab35b8.m4a","quranTranslation":{"text":"For when it was said unto them, There is no Allah save Allah, they were scornful","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["إِنَّهُمْ","كَانُوٓا۟","إِذَا","قِيلَ","لَهُمْ","لَآ","إِلَٰهَ","إِلَّا","ٱللَّهُ","يَسْتَكْبِرُونَ"],"marked":[9],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"istakbara-7-75-3","words":["verb:istakbara"],"options":[{"bs":"uzoholili su se","en":"they were arrogant"},{"bs":"i oholi se","en":"and he/it is arrogant"},{"bs":"i uzoholio se","en":"and was arrogant"},{"bs":"pa ste se uzoholili","en":"so you (all) were arrogant"}],"ref":"7:75","answerWord":"ٱسْتَكْبَرُوا۟","answerSound":"audio/7b4ce1b0125fa0ea6072.m4a","quranTranslation":{"text":"The chieftains of his people, who were scornful, said unto those whom they despised, unto such of them as believed: Know ye that Salih is one sent from his Lord? They said: Lo! In that wherewith he hath been sent we are believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["قَالَ","ٱلْمَلَأُ","ٱلَّذِينَ","ٱسْتَكْبَرُوا۟","مِن","قَوْمِهِۦ","لِلَّذِينَ","ٱسْتُضْعِفُوا۟","لِمَنْ","ءَامَنَ","مِنْهُمْ","أَتَعْلَمُونَ","أَنَّ","صَٰلِحًا","مُّرْسَلٌ","مِّن","رَّبِّهِۦ","قَالُوٓا۟","إِنَّا","بِمَآ","أُرْسِلَ","بِهِۦ","مُؤْمِنُونَ"],"marked":[3],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"istakbara-23-46-3","words":["verb:istakbara"],"options":[{"bs":"pa su se uzoholili","en":"so they were arrogant"},{"bs":"i uzoholio se","en":"and was arrogant"},{"bs":"oholili su se","en":"they were arrogant"},{"bs":"pa ste se uzoholili","en":"so you (all) were arrogant"}],"ref":"23:46","answerWord":"فَٱسْتَكْبَرُوا۟","answerSound":"audio/08c7b8254ac36ced9fb7.m4a","quranTranslation":{"text":"Unto Pharaoh and his chiefs, but they scorned (them) and they were despotic folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["إِلَىٰ","فِرْعَوْنَ","وَمَلَإِي۟هِۦ","فَٱسْتَكْبَرُوا۟","وَكَانُوا۟","قَوْمًا","عَالِينَ"],"marked":[3],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"istakbara-4-173-13","words":["verb:istakbara"],"options":[{"bs":"i uzoholili su se","en":"and they were arrogant"},{"bs":"i uzoholio si se","en":"and you were arrogant"},{"bs":"oholili su se","en":"they were arrogant"},{"bs":"i uzoholio se","en":"and was arrogant"}],"ref":"4:173","answerWord":"وَٱسْتَكْبَرُوا۟","answerSound":"audio/bb2e6eff85ca9a6a29bb.m4a","quranTranslation":{"text":"Then, as for those who believed and did good works, unto them will He pay their wages in full, adding unto them of His bounty; and as for those who were scornful and proud, them will He punish with a painful doom. And they will not find for them, against Allah, any protecting friend or helper.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["فَأَمَّا","ٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","فَيُوَفِّيهِمْ","أُجُورَهُمْ","وَيَزِيدُهُم","مِّن","فَضْلِهِۦ","وَأَمَّا","ٱلَّذِينَ","ٱسْتَنكَفُوا۟","وَٱسْتَكْبَرُوا۟","فَيُعَذِّبُهُمْ","عَذَابًا","أَلِيمًا","وَلَا","يَجِدُونَ","لَهُم","مِّن","دُونِ","ٱللَّهِ","وَلِيًّا","وَلَا","نَصِيرًا"],"marked":[13],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"istakbara-7-76-2","words":["verb:istakbara"],"options":[{"bs":"uzoholili su se","en":"they were arrogant"},{"bs":"oholite se","en":"you (all) are arrogant"},{"bs":"i oholi se","en":"and he/it is arrogant"},{"bs":"uzoholio se","en":"he/it was arrogant"}],"ref":"7:76","answerWord":"ٱسْتَكْبَرُوٓا۟","answerSound":"audio/d9dbaa384bc0aafa1f23.m4a","quranTranslation":{"text":"Those who were scornful said: Lo! in that which ye believe we are disbelievers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["قَالَ","ٱلَّذِينَ","ٱسْتَكْبَرُوٓا۟","إِنَّا","بِٱلَّذِىٓ","ءَامَنتُم","بِهِۦ","كَٰفِرُونَ"],"marked":[2],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"istakbara-74-23-2","words":["verb:istakbara"],"options":[{"bs":"i uzoholio se","en":"and was arrogant"},{"bs":"i uzoholili su se","en":"and they were arrogant"},{"bs":"i uzoholio si se","en":"and you were arrogant"},{"bs":"i oholi se","en":"and he/it is arrogant"}],"ref":"74:23","answerWord":"وَٱسْتَكْبَرَ","answerSound":"audio/7f63a0fa11351ba173e2.m4a","quranTranslation":{"text":"Then turned he away in pride","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["ثُمَّ","أَدْبَرَ","وَٱسْتَكْبَرَ"],"marked":[2],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"istakbara-2-87-23","words":["verb:istakbara"],"options":[{"bs":"uzoholili ste se","en":"you (all) were arrogant"},{"bs":"oholite se","en":"you (all) are arrogant"},{"bs":"pa su se uzoholili","en":"so they were arrogant"},{"bs":"i uzoholio se","en":"and was arrogant"}],"ref":"2:87","answerWord":"ٱسْتَكْبَرْتُمْ","answerSound":"audio/9b23fdd6bf8723722495.m4a","quranTranslation":{"text":"And verily We gave unto Moses the Scripture and We caused a train of messengers to follow after him, and We gave unto Jesus, son of Mary, clear proofs (of Allah's sovereignty), and We supported him with the Holy spirit. Is it ever so, that, when there cometh unto you a messenger (from Allah) with that which ye yourselves desire not, ye grow arrogant, and some ye disbelieve and some ye slay?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["وَلَقَدْ","ءَاتَيْنَا","مُوسَى","ٱلْكِتَٰبَ","وَقَفَّيْنَا","مِنۢ","بَعْدِهِۦ","بِٱلرُّسُلِ","وَءَاتَيْنَا","عِيسَى","ٱبْنَ","مَرْيَمَ","ٱلْبَيِّنَٰتِ","وَأَيَّدْنَٰهُ","بِرُوحِ","ٱلْقُدُسِ","أَفَكُلَّمَا","جَآءَكُمْ","رَسُولٌۢ","بِمَا","لَا","تَهْوَىٰٓ","أَنفُسُكُمُ","ٱسْتَكْبَرْتُمْ","فَفَرِيقًا","كَذَّبْتُمْ","وَفَرِيقًا","تَقْتُلُونَ"],"marked":[23],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"istakbara-4-172-14","words":["verb:istakbara"],"options":[{"bs":"i oholi se","en":"and he/it is arrogant"},{"bs":"i uzoholio se","en":"and was arrogant"},{"bs":"i uzoholili su se","en":"and they were arrogant"},{"bs":"i uzoholio si se","en":"and you were arrogant"}],"ref":"4:172","answerWord":"وَيَسْتَكْبِرْ","answerSound":"audio/75ab8adc90959c057c5a.m4a","quranTranslation":{"text":"The Messiah will never scorn to be a slave unto Allah, nor will the favoured angels. Whoso scorneth His service and is proud, all such will He assemble unto Him;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["لَّن","يَسْتَنكِفَ","ٱلْمَسِيحُ","أَن","يَكُونَ","عَبْدًا","لِّلَّهِ","وَلَا","ٱلْمَلَٰٓئِكَةُ","ٱلْمُقَرَّبُونَ","وَمَن","يَسْتَنكِفْ","عَنْ","عِبَادَتِهِۦ","وَيَسْتَكْبِرْ","فَسَيَحْشُرُهُمْ","إِلَيْهِ","جَمِيعًا"],"marked":[14],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"istakbara-38-74-2","words":["verb:istakbara"],"options":[{"bs":"uzoholio se","en":"he/it was arrogant"},{"bs":"pa ste se uzoholili","en":"so you (all) were arrogant"},{"bs":"i uzoholili su se","en":"and they were arrogant"},{"bs":"oholite se","en":"you (all) are arrogant"}],"ref":"38:74","answerWord":"ٱسْتَكْبَرَ","answerSound":"audio/65763b461f067ad56be6.m4a","quranTranslation":{"text":"Saving Iblis; he was scornful and became one of the disbelievers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["إِلَّآ","إِبْلِيسَ","ٱسْتَكْبَرَ","وَكَانَ","مِنَ","ٱلْكَٰفِرِينَ"],"marked":[2],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"istakbara-38-75-9","words":["verb:istakbara"],"options":[{"bs":"zar si se uzoholio?","en":"were you arrogant?"},{"bs":"i uzoholili su se","en":"and they were arrogant"},{"bs":"uzoholili ste se","en":"you (all) were arrogant"},{"bs":"i uzoholio se","en":"and was arrogant"}],"ref":"38:75","answerWord":"أَسْتَكْبَرْتَ","answerSound":"audio/03dd46a783898a2edad4.m4a","quranTranslation":{"text":"He said: O Iblis! What hindereth thee from falling prostrate before that which I have created with both My hands? Art thou too proud or art thou of the high exalted?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["قَالَ","يَٰٓإِبْلِيسُ","مَا","مَنَعَكَ","أَن","تَسْجُدَ","لِمَا","خَلَقْتُ","بِيَدَىَّ","أَسْتَكْبَرْتَ","أَمْ","كُنتَ","مِنَ","ٱلْعَالِينَ"],"marked":[9],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"istakbara-39-59-6","words":["verb:istakbara"],"options":[{"bs":"i uzoholio si se","en":"and you were arrogant"},{"bs":"uzoholili su se","en":"they were arrogant"},{"bs":"i uzoholio se","en":"and was arrogant"},{"bs":"oholite se","en":"you (all) are arrogant"}],"ref":"39:59","answerWord":"وَٱسْتَكْبَرْتَ","answerSound":"audio/678d1e51f5eb9a05107a.m4a","quranTranslation":{"text":"(But now the answer will be): Nay, for My revelations came unto thee, but thou didst deny them and wast scornful and wast among the disbelievers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["بَلَىٰ","قَدْ","جَآءَتْكَ","ءَايَٰتِى","فَكَذَّبْتَ","بِهَا","وَٱسْتَكْبَرْتَ","وَكُنتَ","مِنَ","ٱلْكَٰفِرِينَ"],"marked":[6],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"istakbara-45-31-8","words":["verb:istakbara"],"options":[{"bs":"pa ste se uzoholili","en":"so you (all) were arrogant"},{"bs":"oholite se","en":"you (all) are arrogant"},{"bs":"zar si se uzoholio?","en":"were you arrogant?"},{"bs":"uzoholili su se","en":"they were arrogant"}],"ref":"45:31","answerWord":"فَٱسْتَكْبَرْتُمْ","answerSound":"audio/49be30e73ef2b518c1f1.m4a","quranTranslation":{"text":"And as for those who disbelieved (it will be said unto them): Were not Our revelations recited unto you? But ye were scornful and became a guilty folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"oholiti se, uzoholiti se","en":"to be arrogant"},"passage":["وَأَمَّا","ٱلَّذِينَ","كَفَرُوٓا۟","أَفَلَمْ","تَكُنْ","ءَايَٰتِى","تُتْلَىٰ","عَلَيْكُمْ","فَٱسْتَكْبَرْتُمْ","وَكُنتُمْ","قَوْمًا","مُّجْرِمِينَ"],"marked":[8],"facts":{"verb":"اسْتَكْبَرَ"}},{"id":"amina-7-97-0","words":["verb:amina"],"options":[{"bs":"zar su se onda osjećali sigurnim","en":"did they then feel secure"},{"bs":"vjerovao sam vam","en":"I trusted you (all)"},{"bs":"i osjećaju se sigurnima","en":"and they feel safe"},{"bs":"vjerujem vam","en":"I trust you (all)"}],"ref":"7:97","answerWord":"أَفَأَمِنَ","answerSound":"audio/f83c32d4efa928e3b761.m4a","quranTranslation":{"text":"Are the people of the townships then secure from the coming of Our wrath upon them as a night-raid while they sleep?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osjećati se sigurnim","en":"to feel safe, to be secure"},"passage":["أَفَأَمِنَ","أَهْلُ","ٱلْقُرَىٰٓ","أَن","يَأْتِيَهُم","بَأْسُنَا","بَيَٰتًا","وَهُمْ","نَآئِمُونَ"],"marked":[0],"facts":{"verb":"أَمِنَ"}},{"id":"amina-7-99-0","words":["verb:amina"],"options":[{"bs":"zar su se onda osjećali sigurnim","en":"did they then feel secure"},{"bs":"osjećali ste se sigurnima","en":"you (all) felt safe"},{"bs":"i osjećaju se sigurnima","en":"and they feel safe"},{"bs":"osjeća se sigurnim","en":"feels secure"}],"ref":"7:99","answerWord":"أَفَأَمِنُوا۟","answerSound":"audio/104e645b9a6dd7979f4e.m4a","quranTranslation":{"text":"Are they then secure from Allah's scheme? None deemeth himself secure from Allah's scheme save folk that perish.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osjećati se sigurnim","en":"to feel safe, to be secure"},"passage":["أَفَأَمِنُوا۟","مَكْرَ","ٱللَّهِ","فَلَا","يَأْمَنُ","مَكْرَ","ٱللَّهِ","إِلَّا","ٱلْقَوْمُ","ٱلْخَٰسِرُونَ"],"marked":[0],"facts":{"verb":"أَمِنَ"}},{"id":"amina-7-99-4","words":["verb:amina"],"options":[{"bs":"osjeća se sigurnim","en":"feels secure"},{"bs":"zar ste se osjećali sigurnima?","en":"did you (all) feel safe?"},{"bs":"vjerujem vam","en":"I trust you (all)"},{"bs":"zar su se onda osjećali sigurnim","en":"did they then feel secure"}],"ref":"7:99","answerWord":"يَأْمَنُ","answerSound":"audio/a08b22585d7464a7d45e.m4a","quranTranslation":{"text":"Are they then secure from Allah's scheme? None deemeth himself secure from Allah's scheme save folk that perish.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osjećati se sigurnim","en":"to feel safe, to be secure"},"passage":["أَفَأَمِنُوا۟","مَكْرَ","ٱللَّهِ","فَلَا","يَأْمَنُ","مَكْرَ","ٱللَّهِ","إِلَّا","ٱلْقَوْمُ","ٱلْخَٰسِرُونَ"],"marked":[4],"facts":{"verb":"أَمِنَ"}},{"id":"amina-12-64-2","words":["verb:amina"],"options":[{"bs":"vjerujem vam","en":"I trust you (all)"},{"bs":"osjeća se sigurnim","en":"feels secure"},{"bs":"zar su se onda osjećali sigurnim","en":"did they then feel secure"},{"bs":"zar ste se osjećali sigurnima?","en":"did you (all) feel safe?"}],"ref":"12:64","answerWord":"ءَامَنُكُمْ","answerSound":"audio/36b5c42033e23d7151a4.m4a","quranTranslation":{"text":"He said: Can I entrust him to you save as I entrusted his brother to you aforetime? Allah is better at guarding, and He is the Most Merciful of those who show mercy.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osjećati se sigurnim","en":"to feel safe, to be secure"},"passage":["قَالَ","هَلْ","ءَامَنُكُمْ","عَلَيْهِ","إِلَّا","كَمَآ","أَمِنتُكُمْ","عَلَىٰٓ","أَخِيهِ","مِن","قَبْلُ","فَٱللَّهُ","خَيْرٌ","حَٰفِظًا","وَهُوَ","أَرْحَمُ","ٱلرَّٰحِمِينَ"],"marked":[2],"facts":{"verb":"أَمِنَ"}},{"id":"amina-12-64-6","words":["verb:amina"],"options":[{"bs":"vjerovao sam vam","en":"I trusted you (all)"},{"bs":"povjerio je","en":"he/it entrusted"},{"bs":"vjerujem vam","en":"I trust you (all)"},{"bs":"osjeća se sigurnim","en":"feels secure"}],"ref":"12:64","answerWord":"أَمِنتُكُمْ","answerSound":"audio/1d6e86d98244641c3a2c.m4a","quranTranslation":{"text":"He said: Can I entrust him to you save as I entrusted his brother to you aforetime? Allah is better at guarding, and He is the Most Merciful of those who show mercy.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osjećati se sigurnim","en":"to feel safe, to be secure"},"passage":["قَالَ","هَلْ","ءَامَنُكُمْ","عَلَيْهِ","إِلَّا","كَمَآ","أَمِنتُكُمْ","عَلَىٰٓ","أَخِيهِ","مِن","قَبْلُ","فَٱللَّهُ","خَيْرٌ","حَٰفِظًا","وَهُوَ","أَرْحَمُ","ٱلرَّٰحِمِينَ"],"marked":[6],"facts":{"verb":"أَمِنَ"}},{"id":"amina-67-16-0","words":["verb:amina"],"options":[{"bs":"zar ste se osjećali sigurnima?","en":"did you (all) feel safe?"},{"bs":"zar su se onda osjećali sigurnim","en":"did they then feel secure"},{"bs":"vjerovao sam vam","en":"I trusted you (all)"},{"bs":"povjerio je","en":"he/it entrusted"}],"ref":"67:16","answerWord":"ءَأَمِنتُم","answerSound":"audio/763a0aeeeb8144ac4010.m4a","quranTranslation":{"text":"Have ye taken security from Him Who is in the heaven that He will not cause the earth to swallow you when lo! it is convulsed?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osjećati se sigurnim","en":"to feel safe, to be secure"},"passage":["ءَأَمِنتُم","مَّن","فِى","ٱلسَّمَآءِ","أَن","يَخْسِفَ","بِكُمُ","ٱلْأَرْضَ","فَإِذَا","هِىَ","تَمُورُ"],"marked":[0],"facts":{"verb":"أَمِنَ"}},{"id":"amina-67-17-1","words":["verb:amina"],"options":[{"bs":"osjećali ste se sigurnima","en":"you (all) felt safe"},{"bs":"vjerovao sam vam","en":"I trusted you (all)"},{"bs":"zar su se onda osjećali sigurnim","en":"did they then feel secure"},{"bs":"vjerujem vam","en":"I trust you (all)"}],"ref":"67:17","answerWord":"أَمِنتُم","answerSound":"audio/6e13082001d9fa10f726.m4a","quranTranslation":{"text":"Or have ye taken security from Him Who is in the heaven that He will not let loose on you a hurricane? But ye shall know the manner of My warning.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"osjećati se sigurnim","en":"to feel safe, to be secure"},"passage":["أَمْ","أَمِنتُم","مَّن","فِى","ٱلسَّمَآءِ","أَن","يُرْسِلَ","عَلَيْكُمْ","حَاصِبًا","فَسَتَعْلَمُونَ","كَيْفَ","نَذِيرِ"],"marked":[1],"facts":{"verb":"أَمِنَ"}},{"id":"nafakha-6-73-15","words":["verb:nafakha"],"options":[{"bs":"puše se","en":"it is blown"},{"bs":"i puhnuto je","en":"and it was blown"},{"bs":"puhnite!","en":"(you all) blow!"},{"bs":"i puhnuo je","en":"and he/it blew"}],"ref":"6:73","answerWord":"يُنفَخُ","answerSound":"audio/b7474ad2ef20b6e0ccd7.m4a","quranTranslation":{"text":"He it is Who created the heavens and the earth in truth. In the day when He saith: Be! it is. His Word is the Truth, and His will be the Sovereignty on the day when the trumpet is blown. Knower of the Invisible and the Visible, He is the Wise, the Aware.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"puhnuti, udahnuti","en":"to blow"},"passage":["وَهُوَ","ٱلَّذِى","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضَ","بِٱلْحَقِّ","وَيَوْمَ","يَقُولُ","كُن","فَيَكُونُ","قَوْلُهُ","ٱلْحَقُّ","وَلَهُ","ٱلْمُلْكُ","يَوْمَ","يُنفَخُ","فِى","ٱلصُّورِ","عَٰلِمُ","ٱلْغَيْبِ","وَٱلشَّهَٰدَةِ","وَهُوَ","ٱلْحَكِيمُ","ٱلْخَبِيرُ"],"marked":[15],"facts":{"verb":"نَفَخَ"}},{"id":"nafakha-18-99-6","words":["verb:nafakha"],"options":[{"bs":"i puhnuto je","en":"and it was blown"},{"bs":"pa puhnem","en":"so I blow"},{"bs":"puše se","en":"it is blown"},{"bs":"i udahnem","en":"and I have breathed"}],"ref":"18:99","answerWord":"وَنُفِخَ","answerSound":"audio/06cc9faae23e6dcc76e6.m4a","quranTranslation":{"text":"And on that day we shall let some of them surge against others, and the Trumpet will be blown. Then We shall gather them together in one gathering.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"puhnuti, udahnuti","en":"to blow"},"passage":["وَتَرَكْنَا","بَعْضَهُمْ","يَوْمَئِذٍ","يَمُوجُ","فِى","بَعْضٍ","وَنُفِخَ","فِى","ٱلصُّورِ","فَجَمَعْنَٰهُمْ","جَمْعًا"],"marked":[6],"facts":{"verb":"نَفَخَ"}},{"id":"nafakha-23-101-1","words":["verb:nafakha"],"options":[{"bs":"puhnuto je","en":"it was blown"},{"bs":"puhnite!","en":"(you all) blow!"},{"bs":"i udahnem","en":"and I have breathed"},{"bs":"pa puhnem","en":"so I blow"}],"ref":"23:101","answerWord":"نُفِخَ","answerSound":"audio/a7ff1f6ef6d7800a5fae.m4a","quranTranslation":{"text":"And when the trumpet is blown there will be no kinship among them that day, nor will they ask of one another.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"puhnuti, udahnuti","en":"to blow"},"passage":["فَإِذَا","نُفِخَ","فِى","ٱلصُّورِ","فَلَآ","أَنسَابَ","بَيْنَهُمْ","يَوْمَئِذٍ","وَلَا","يَتَسَآءَلُونَ"],"marked":[1],"facts":{"verb":"نَفَخَ"}},{"id":"nafakha-15-29-2","words":["verb:nafakha"],"options":[{"bs":"i udahnem","en":"and I have breathed"},{"bs":"puše se","en":"it is blown"},{"bs":"i puhnuto je","en":"and it was blown"},{"bs":"puhnite!","en":"(you all) blow!"}],"ref":"15:29","answerWord":"وَنَفَخْتُ","answerSound":"audio/ca2107dfd822bae5bef2.m4a","quranTranslation":{"text":"So, when I have made him and have breathed into him of My Spirit, do ye fall down, prostrating yourselves unto him.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"puhnuti, udahnuti","en":"to blow"},"passage":["فَإِذَا","سَوَّيْتُهُۥ","وَنَفَخْتُ","فِيهِ","مِن","رُّوحِى","فَقَعُوا۟","لَهُۥ","سَٰجِدِينَ"],"marked":[2],"facts":{"verb":"نَفَخَ"}},{"id":"nafakha-18-96-9","words":["verb:nafakha"],"options":[{"bs":"puhnite!","en":"(you all) blow!"},{"bs":"puše se","en":"it is blown"},{"bs":"i udahnem","en":"and I have breathed"},{"bs":"pa puhnem","en":"so I blow"}],"ref":"18:96","answerWord":"ٱنفُخُوا۟","answerSound":"audio/7497097404534fddd23c.m4a","quranTranslation":{"text":"Give me pieces of iron - till, when he had levelled up (the gap) between the cliffs, he said: Blow! - till, when he had made it a fire, he said: Bring me molten copper to pour thereon.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"puhnuti, udahnuti","en":"to blow"},"passage":["ءَاتُونِى","زُبَرَ","ٱلْحَدِيدِ","حَتَّىٰٓ","إِذَا","سَاوَىٰ","بَيْنَ","ٱلصَّدَفَيْنِ","قَالَ","ٱنفُخُوا۟","حَتَّىٰٓ","إِذَا","جَعَلَهُۥ","نَارًا","قَالَ","ءَاتُونِىٓ","أُفْرِغْ","عَلَيْهِ","قِطْرًا"],"marked":[9],"facts":{"verb":"نَفَخَ"}},{"id":"nafakha-32-9-2","words":["verb:nafakha"],"options":[{"bs":"i puhnuo je","en":"and he/it blew"},{"bs":"puše se","en":"it is blown"},{"bs":"pa puhnem","en":"so I blow"},{"bs":"puhnite!","en":"(you all) blow!"}],"ref":"32:9","answerWord":"وَنَفَخَ","answerSound":"audio/41a9a9ac49a8ddeaee88.m4a","quranTranslation":{"text":"Then He fashioned him and breathed into him of His Spirit; and appointed for you hearing and sight and hearts. Small thanks give ye!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"puhnuti, udahnuti","en":"to blow"},"passage":["ثُمَّ","سَوَّىٰهُ","وَنَفَخَ","فِيهِ","مِن","رُّوحِهِۦ","وَجَعَلَ","لَكُمُ","ٱلسَّمْعَ","وَٱلْأَبْصَٰرَ","وَٱلْأَفْـِٔدَةَ","قَلِيلًا","مَّا","تَشْكُرُونَ"],"marked":[2],"facts":{"verb":"نَفَخَ"}},{"id":"awqada-28-38-10","words":["verb:awqada"],"options":[{"bs":"pa zapali!","en":"so kindle!"},{"bs":"pali se","en":"he/it is kindled"},{"bs":"zagrijavaju","en":"they heat (in fire)"},{"bs":"palite","en":"you kindle"}],"ref":"28:38","answerWord":"فَأَوْقِدْ","answerSound":"audio/abb22eb4834862e8c072.m4a","quranTranslation":{"text":"And Pharaoh said: O chiefs! I know not that ye have a god other than me, so kindle for me (a fire), O Haman, to bake the mud; and set up for me a lofty tower in order that I may survey the god of Moses; and lo! I deem him of the liars.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zapaliti, potpaliti (vatru)","en":"to kindle, to light (a fire)"},"passage":["وَقَالَ","فِرْعَوْنُ","يَٰٓأَيُّهَا","ٱلْمَلَأُ","مَا","عَلِمْتُ","لَكُم","مِّنْ","إِلَٰهٍ","غَيْرِى","فَأَوْقِدْ","لِى","يَٰهَٰمَٰنُ","عَلَى","ٱلطِّينِ","فَٱجْعَل","لِّى","صَرْحًا","لَّعَلِّىٓ","أَطَّلِعُ","إِلَىٰٓ","إِلَٰهِ","مُوسَىٰ","وَإِنِّى","لَأَظُنُّهُۥ","مِنَ","ٱلْكَٰذِبِينَ"],"marked":[10],"facts":{"verb":"أَوْقَدَ"}},{"id":"awqada-36-80-10","words":["verb:awqada"],"options":[{"bs":"palite","en":"you kindle"},{"bs":"pali se","en":"he/it is kindled"},{"bs":"pa zapali!","en":"so kindle!"},{"bs":"zagrijavaju","en":"they heat (in fire)"}],"ref":"36:80","answerWord":"تُوقِدُونَ","answerSound":"audio/ad631db788cd164911f7.m4a","quranTranslation":{"text":"Who hath appointed for you fire from the green tree, and behold! ye kindle from it.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zapaliti, potpaliti (vatru)","en":"to kindle, to light (a fire)"},"passage":["ٱلَّذِى","جَعَلَ","لَكُم","مِّنَ","ٱلشَّجَرِ","ٱلْأَخْضَرِ","نَارًا","فَإِذَآ","أَنتُم","مِّنْهُ","تُوقِدُونَ"],"marked":[10],"facts":{"verb":"أَوْقَدَ"}}]