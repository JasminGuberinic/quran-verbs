d": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِلْتَقِي", "plain": "اِلْتَقِي", "quran": false, "notUsed": false, "spoken": "audio/961eea951cdfe457a808.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِلْتَقِيَا", "plain": "اِلْتَقِيَا", "quran": false, "notUsed": false, "spoken": "audio/e1c7b0d4195b5110063e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِلْتَقُوا", "plain": "اِلْتَقُوا", "quran": false, "notUsed": false, "spoken": "audio/2e5efbfcca63ee47bee2.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِلْتَقِينَ", "plain": "اِلْتَقِينَ", "quran": false, "notUsed": false, "spoken": "audio/73e2ebfea943372cf425.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "3:166", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/459.mp3", "translation": {"en": {"text": "That which befell you, on the day when the two armies met, was by permission of Allah; that He might know the true believers;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İki topluluğun karşılaştığı günde başınıza gelen musibet de Allah'ın izniyledir. Bu da müminleri belirlemesi ve hem de münafıklık yapanları ayırt etmesi içindir. Ve onlara: \"Geliniz, Allah yolunda savaşınız veya (hiç olmazsa) savunmaya geçiniz.\" denilmişti. Onlar ise: \"Biz savaşmasını (veya savaş olacağını) bilseydik arkanızdan gelirdik.\" demişlerdi. Onlar, o gün, imandan çok küfre yakındılar. kalblerinde olmayanı ağızlarıyla söylüyorlardı. Allah neyi gizlediklerini daha iyi bilendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ مصیبت جو تم پر آئی جس دن دونوں فوجیں ملی تھیں وہ اللہ کے حکم سے تھی اور اس لئے کہ پہچان کرادے ایمان والوں کی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan apa yang menimpa kamu pada hari bertemunya dua pasukan, maka (kekalahan) itu adalah dengan izin (takdir) Allah, dan agar Allah mengetahui siapa orang-orang yang beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَصَٰبَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْتَقَى", "hit": true, "audio": "audio/62bca9fec53328e9c917.m4a", "gloss": {"bs": "su se sukobile", "en": "met", "tr": "karşılaştı", "fr": "se sont affrontées", "id": "telah bertemu", "ur": "مل گئیں", "bn": "তারা মুখোমুখি হল", "fa": "برخورد کرد"}}, {"text": "ٱلْجَمْعَانِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَبِإِذْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلِيَعْلَمَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُؤْمِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "55:19", "tense": "present", "category": {"tense": "present", "pronoun": "huma", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4920.mp3", "translation": {"en": {"text": "He hath loosed the two seas. They meet.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Acı ve tatlı) iki denizi salıverdi birbirine kavuşuyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس نے دو سمندر بہائے کہ دیکھنے میں معلوم ہوں ملے ہوئے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dia membiarkan dua lautan mengalir yang keduanya kemudian bertemu,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَرَجَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبَحْرَيْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "يَلْتَقِيَانِ", "hit": true, "audio": "audio/d6c0774f545d92e9dceb.m4a", "gloss": {"bs": "susreću se", "en": "they meet", "tr": "karşılaşırlar", "fr": "ils se rencontrent", "id": "mereka bertemu", "ur": "وہ دونوں ملتے ہیں", "bn": "তারা দুজন মিলিত হয়", "fa": "با هم دیدار می‌کنند"}}]}], "forms": [{"arabic": "ٱلْتَقَى", "count": 3, "first": "3:155", "audio": "audio/62bca9fec53328e9c917.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "su se sukobile", "en": "met", "tr": "karşılaştı", "fr": "se sont affrontées", "id": "telah bertemu", "ur": "مل گئیں", "bn": "তারা মুখোমুখি হল", "fa": "برخورد کرد"}}, {"arabic": "ٱلْتَقَتَا", "count": 1, "first": "3:13", "audio": "audio/9ffafd2dadf039527ebf.m4a", "grammar": [{"tense": "past", "pronoun": "huma", "passive": false, "objects": []}], "gloss": {"en": "they (two) met", "bs": "srele su se", "tr": "karşılaştılar", "fr": "elles (deux) se sont rencontrées", "id": "mereka berdua bertemu", "ur": "وہ دونوں ملے", "bn": "তারা দুজন মিলিত হলো", "fa": "آن دو دیدار کردند"}}, {"arabic": "ٱلْتَقَيْتُمْ", "count": 1, "first": "8:44", "audio": "audio/7ff1fdb84b8761f581eb.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) met", "bs": "sreli ste se", "tr": "karşılaştınız", "fr": "vous vous êtes rencontrés", "id": "kalian telah bertemu", "ur": "تم سب ملے", "bn": "তোমরা মিলিত হলে", "fa": "دیدار کردید"}}, {"arabic": "فَٱلْتَقَى", "count": 1, "first": "54:12", "audio": "audio/855be6edf951906e7084.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "so he/it met", "bs": "pa se sreo", "tr": "böylece karşılaştı", "fr": "alors il rencontra", "id": "maka dia bertemu", "ur": "پس وہ ملا", "bn": "অতএব সে মিলিত হলো", "fa": "پس دیدار کرد"}}, {"arabic": "يَلْتَقِيَانِ", "count": 1, "first": "55:19", "audio": "audio/d6c0774f545d92e9dceb.m4a", "grammar": [{"tense": "present", "pronoun": "huma", "passive": false, "objects": ["huma"], "mood": "indicative"}], "g