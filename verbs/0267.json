: false, "translation": {"bs": "zbog novca", "en": "with the money", "bn": "অর্থ নিয়ে", "fa": "از ثروت", "fr": "de l'argent", "id": "dengan harta", "tr": "paradan", "ur": "مال کی وجہ سے"}}]}]}