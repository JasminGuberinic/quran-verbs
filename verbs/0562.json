{"rank": 562, "root": "فرق", "form": 1, "lemma": "فَرَقَ", "count": 4, "ayahCount": 4, "share": 0.02, "meaning": {"bs": "razdvojiti, rastaviti, razlučiti", "en": "to separate, to part, to distinguish", "tr": "ayırmak, ayrıştırmak, ayırt etmek", "fr": "séparer, diviser, distinguer", "id": "memisahkan, membagi, membedakan", "ur": "جدا کرنا، الگ کرنا، فرق کرنا", "bn": "আলাদা করা, বিচ্ছিন্ন করা, পার্থক্য করা", "fa": "جدا کردن، از هم جدا ساختن، تمییز دادن"}, "lemmaSpoken": "audio/85c5e383dc7b72c3135b.m4a", "animation": "<svg class=\"va va-faraqa_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes fa{from{transform:translateX(14px)}}@keyframes fb{from{transform:translateX(-14px)}}.va-faraqa_1 .l{animation:fa 1.2s ease-in-out both}.va-faraqa_1 .r{animation:fb 1.2s ease-in-out both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-faraqa_1.off,.va-faraqa_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-faraqa_1,.va-faraqa_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><path class=\"q l\" d=\"M28 43h18v18H28z\"/><path class=\"q r\" d=\"M74 43h18v18H74z\"/></svg> ", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "فَرَقَ", "plain": "فَرَقَ", "quran": false, "notUsed": false, "spoken": "audio/85c5e383dc7b72c3135b.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَفْرُقُ", "plain": "يَفْرُقُ", "quran": false, "notUsed": false, "spoken": "audio/500ab3d07900a2511e36.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱفْرُقْ", "plain": "اُفْرُقْ", "quran": true, "notUsed": false, "spoken": "audio/97e946ee47d945b60ba4.m4a", "recited": "audio/96ec21b905bc2a499f38.m4a", "recitedText": "فَٱفْرُقْ"}], "nouns": {"participle": {"lemma": "فارِقَة", "cou