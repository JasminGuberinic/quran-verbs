 null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِسْمَعَا", "plain": "اِسْمَعَا", "quran": false, "notUsed": false, "spoken": "audio/c9d8515e1f3948c0c4c5.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱسْمَعُوا۟", "plain": "اِسْمَعُوا", "quran": true, "notUsed": false, "spoken": "audio/1afb69d3fbfcea986557.m4a", "recited": "audio/7ff2ed9e8ee444b514bb.m4a", "recitedText": "وَٱسْمَعُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِسْمَعْنَ", "plain": "اِسْمَعْنَ", "quran": false, "notUsed": false, "spoken": "audio/e94dac8927438ec56b38.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "26:72", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3004.mp3", "translation": {"en": {"text": "He said: Do they hear you when ye cry?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İbrahim \"Peki, dedi, yalvardığınızda onlar sizi işitiyorlar mı?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "فرمایا کیا وہ تمہاری سنتے ہیں جب تم پکارو،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berkata Ibrahim: \"Apakah berhala-berhala itu mendengar (doa)mu sewaktu kamu berdoa (kepadanya)?,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "هَلْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْمَعُونَكُمْ", "hit": true, "audio": "audio/9a96aeb9a5df9413c1db.m4a", "gloss": {"en": "they hear you (all)", "bs": "čuju vas", "tr": "sizi duyarlar", "fr": "ils vous entendent", "id": "mereka mendengar kalian", "ur": "وہ تم سب کو سنتے ہیں", "bn": "তারা তোমাদের শোনে", "fa": "شما را می‌شنوند"}}, {"text": "إِذْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَدْعُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:60", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2543.mp3", "translation": {"en": {"text": "They said: We heard a youth make mention of them, who is called Abraham.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Bazıları) \"İbrahim denen bir gencin, onları diline doladığını duymuştuk\" dediler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ان میں کے کچھ بولے ہم نے ایک جوان کو انہیں برا کہتے سنا جسے ابراہیم کہتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka berkata: \"Kami dengar ada seorang pemuda yang mencela berhala-berhala ini yang bernama Ibrahim\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "سَمِعْنَا", "hit": true, "audio": "audio/5ddca86470805acc7d43.m4a", "gloss": {"bs": "čuli smo", "en": "we heard", "tr": "işittik", "fr": "nous avons entendu", "id": "kami mendengar", "ur": "ہم نے سنا", "bn": "আমরা শুনেছি", "fa": "شنیدیم"}}, {"text": "فَتًى", "hit": false, "audio": null, "gloss": null}, {"text": "يَذْكُرُهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُقَالُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِبْرَٰهِيمُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:45", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2528.mp3", "translation": {"en": {"text": "Say (O Muhammad, unto mankind): I warn you only by the Inspiration. But the deaf hear not the call when they are warned.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki: \"Ben sizi ancak vahiyle korkutup uyarıyorum,\" uyarıldıkları zaman sağırlar çağrıyı duymazlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ کہ میں تم کو صرف وحی سے ڈراتا ہوں اور بہرے پکارنا نہیں سنتے جب ڈرائے جائیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah (hai Muhammad): \"Sesungguhnya aku hanya memberi peringatan kepada kamu sekalian dengan wahyu dan tiadalah orang-orang yang tuli mendengar seruan, apabila mereka diberi peringatan\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أُنذِرُكُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْوَحْىِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْمَعُ", "hit": true, "audio": "audio/6673488fb5ce6d8e826e.m4a", "gloss": {"en": "he/it hears", "bs": "čuje", "tr": "duyar", "fr": "il entend", "id": "dia mendengar", "ur": "وہ سنتا ہے", "bn": "সে শোনে", "fa": "می‌شنود"}}, {"text": "ٱلصُّمُّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلدُّعَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُنذَرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "67:7", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5248.mp3", "translation": {"en": {"text": "When they are flung therein they hear its roaring as it boileth up,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Oraya atıldıklarında, onun kaynarken çıkardığı uğultuyu işitirler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جب اس میں ڈالے جائیں گے اس کا رینکنا (چنگھاڑنا) سنیں گے کہ جوش مارتی ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Apabila mereka dilemparkan ke dalamnya mereka mendengar suara neraka yang mengerikan, sedang neraka itu menggelegak,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِذَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أُلْقُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "سَمِعُوا۟", "hit": true, "audio": "audio/714100a9085d23507cde.m4a", "gloss": {"en": "they heard", "bs": "čuli su", "tr": "duydular", "fr": "ils ont entendu", "id": "mereka telah mendengar", "ur": "انہوں نے سنا", "bn": "তারা শুনেছে", "fa": "شنیدند"}}, {"text": "لَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "شَهِيقًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَهِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَفُورُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:25", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3730.mp3", "translation": {"en": {"text": "Lo! I have believed in your Lord, so hear me!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Şüphesiz ki ben, Rabbinize iman getirdim, gelin dinleyin beni.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "مقرر میں تمہارے رب پر ایمان لایا تو میری سنو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya aku telah beriman kepada Tuhanmu; maka dengarkanlah (pengakuan keimanan)ku.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنِّىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنتُ", "hit": false, "audio": null, "gloss": null}, {"text": "بِرَبِّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱسْمَعُونِ", "hit": true, "audio": "audio/93c6a68e81c6001193a0.m4a", "gloss": {"bs": "pa me poslušajte!", "en": "so listen to me!", "tr": "öyleyse beni dinleyin!", "fr": "alors écoutez-moi !", "id": "maka dengarkanlah aku!", "ur": "پس میری سنو!", "bn": "অতএব আমার কথা শোনো!", "fa": "پس به من گوش دهید!"}}]}, {"ref": "88:11", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5978.mp3", "translation": {"en": {"text": "Where they hear no idle speech,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Orada boş bir söz işitmez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ اس میں کوئی بیہودہ بات نہ سنیں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "tidak kamu dengar di dalamnya perkataan yang tidak berguna.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْمَعُ", "hit": true, "audio": "audio/7e9b52705fda86a4c8c6.m4a", "gloss": {"bs": "(ne) čuješ", "en": "you hear (no)", "tr": "işitmezsin", "fr": "tu (n')entends (pas)", "id": "kamu (tidak) dapat mendengar", "ur": "تم (نہیں) سنتے", "bn": "তুমি শোনো (না)", "fa": "می‌شنوی (نه)"}}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَٰغِيَةً", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَسْمَعُونَ", "count": 19, "first": "2:75", "audio": "audio/94ed15484b02dd7081f4.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they hear", "bs": "čuju", "tr": "duyarlar", "fr": "ils entendent", "id": "mereka mendengar", "ur": "وہ سنتے ہیں", "bn": "তারা শোনে", "fa": "می‌شنوند"}}, {"arabic": "سَمِعْنَا", "count": 16, "first": "2:93", "audio": "audio/0d81cc7d4bc6a4f9b72d.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"bs": "čuli smo", "en": "we heard", "tr": "işittik", "fr": "nous avons entendu", "id": "kami mendengar", "ur": "ہم نے سنا", "bn": "আমরা শুনেছি",