null}, {"tense": "present", "pronoun": "hum", "arabic": "يَكْفُرُونَ", "plain": "يَكْفُرُونَ", "quran": true, "notUsed": false, "spoken": "audio/27869acdec03611c6dbe.m4a", "recited": "audio/f106539195db05421806.m4a", "recitedText": "يَكْفُرُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَكْفُرْنَ", "plain": "يَكْفُرْنَ", "quran": false, "notUsed": false, "spoken": "audio/7f3f7f8e3cf41e15ca0e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱكْفُرْ", "plain": "اُكْفُرْ", "quran": true, "notUsed": false, "spoken": "audio/4f59a5f2f1e785f4a1c7.m4a", "recited": "audio/675a21fc4b32b1e46edc.m4a", "recitedText": "ٱكْفُرْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُكْفُرِي", "plain": "اُكْفُرِي", "quran": false, "notUsed": false, "spoken": "audio/8c3b5f942fe58d5f230e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُكْفُرَا", "plain": "اُكْفُرَا", "quran": false, "notUsed": false, "spoken": "audio/6a619158a95be1f94076.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱكْفُرُوٓا۟", "plain": "اُكْفُرُوا", "quran": true, "notUsed": false, "spoken": "audio/daa935eae6a6e3a09e03.m4a", "recited": "audio/3d87abdd41667c253458.m4a", "recitedText": "وَٱكْفُرُوٓا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُكْفُرْنَ", "plain": "اُكْفُرْنَ", "quran": false, "notUsed": false, "spoken": "audio/fc7a08ca1e84a2b74308.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "37:170", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3958.mp3", "translation": {"en": {"text": "Yet (now that it is come) they disbelieve therein; but they will come to know.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Fakat şimdi onu inkâr ettiler. Ama ilerde bileceklerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اس کے منکر ہوئے تو عنقریب جان لیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tetapi mereka mengingkarinya (Al Quran); maka kelak mereka akan mengetahui (akibat keingkarannya itu).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَكَفَرُوا۟", "hit": true, "audio": "audio/3ae20a54d6c280499467.m4a", "gloss": {"bs": "pa su zanijekali", "en": "yet they disbelieved", "tr": "fakat inkâr ettiler", "fr": "mais ils ont mécru", "id": "tetapi mereka mengingkari", "ur": "پھر انہوں نے انکار کیا", "bn": "কিন্তু তারা কুফরি করল", "fa": "اما کفر ورزیدند"}}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "فَسَوْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَعْلَمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "16:55", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1956.mp3", "translation": {"en": {"text": "So as to deny that which We have given them. Then enjoy life (while ye may), for ye will come to know.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunu kendilerine verdiğimiz nimete nankörlük etmek için yaparlar. Şimdi eğlenin bakalım! Fakat yakında bileceksiniz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ ہماری دی ہوئی نعمتوں کی ناشکری کریں، تو کچھ برت لو (۱۱۱) کہ عنقریب جان جاؤ گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Biarlah mereka mengingkari nikmat yang telah Kami berikan kepada mereka; maka bersenang-senanglah kamu. Kelak kamu akan mengetahui (akibatnya).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لِيَكْفُرُوا۟", "hit": true, "audio": "audio/cdae4b80523da5b50acb.m4a", "gloss": {"en": "so that they may be ungrateful", "bs": "da budu nezahvalni", "tr": "nankör olsunlar diye", "fr": "qu'ils soient ingrats", "id": "agar mereka tidak bersyukur", "ur": "تاکہ وہ کفر کریں", "bn": "যাতে তারা অকৃতজ্ঞ হয়", "fa": "تا ناسپاس باشند"}}, {"text": "بِمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاتَيْنَٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فَتَمَتَّعُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فَسَوْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَعْلَمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:64", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3769.mp3", "translation": {"en": {"text": "Burn therein this day for that ye disbelieved.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bugün yaslanın ona bakalım inkâr ettiğiniz için.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "آج اسی میں جاؤ بدلہ اپنے کفر کا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Masuklah ke dalamnya pada hari ini disebabkan kamu dahulu mengingkarinya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱصْلَوْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْيَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَكْفُرُونَ", "hit": true, "audio": "audio/01c0c2b4a26787744511.m4a", "gloss": {"bs": "ne vjerujete (poricali ste)", "en": "you disbelieved", "tr": "inkâr ediyordunuz", "fr": "vous mécroyiez", "id": "kamu ingkari", "ur": "تم کفر کرتے تھے", "bn": "তোমরা কুফরি করেছিলে", "fa": "کفر می‌ورزیدید"}}]}, {"ref": "88:23", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5990.mp3", "translation": {"en": {"text": "But whoso is averse and disbelieveth,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ancak kim yüz çevirir ve kâfir olursa,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہاں جو منہ پھیرے اور کفر کرے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "tetapi orang yang berpaling dan kafir,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَوَلَّىٰ", "hit": false, "audio": null, "gloss": null}, {"text": "وَكَفَرَ", "hit": true, "audio": "audio/1183f10534a58f1042bd.m4a", "gloss": {"en": "and he/it disbelieved", "bs": "i nije vjerovao", "tr": "ve inanmadı", "fr": "et il n'a pas cru", "id": "dan dia telah ingkar", "ur": "اور وہ کافر ہوا", "bn": "এবং সে অবিশ্বাস করল", "fa": "و کفر ورزید"}}]}, {"ref": "2:99", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/106.mp3", "translation": {"en": {"text": "Verily We have revealed unto thee clear tokens, and only miscreants will disbelieve in them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Şanım hakkı için sana çok açık âyetler; parlak mucizeler indirdik. Öyle ki, iman sahasından uzaklaşmış fasıklardan başkası onları inkâr etmez.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے تمہاری طرف روشن آیتیں اتاریں اور ان کے منکر نہ ہوں گے مگر فاسق لوگ -", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya Kami telah menurunkan kepadamu ayat-ayat yang jelas; dan tak ada yang ingkar kepadanya, melainkan orang-orang yang fasik.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَقَدْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنزَلْنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَيْكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتٍۭ", "hit": false, "audio": null, "gloss": null}, {"text": "بَيِّنَٰتٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَكْفُرُ", "hit": true, "audio": "audio/f6172a4879e1fadaadcc.m4a", "gloss": {"en": "he/it disbelieves", "bs": "ne vjeruje", "tr": "inanmıyor", "fr": "il ne croit pas", "id": "dia ingkar", "ur": "وہ کفر کرتا ہے", "bn": "সে অবিশ্বাস করে", "fa": "کفر نمی‌ورزد"}}, {"text": "بِهَآ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْفَٰسِقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "73:17", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5492.mp3", "translation": {"en": {"text": "Then how, if ye disbelieve, will ye protect yourselves upon the day which will turn children grey,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Peki inkâr ederseniz, çocukları ihtiyarlatacak o günden (kıyamet gününden) kendinizi nasıl kurtaracaksınız?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر کیسے بچو گے اگر کفر کرو اس دن جو بچوں کو بوڑھا کردے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka bagaimanakah kamu akan dapat memelihara dirimu jika kamu tetap kafir kepada hari yang menjadikan anak-anak beruban.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَكَيْفَ", "hit": false, "audio": null, "gloss": null}, {"text": "تَتَّقُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "كَفَرْتُمْ", "hit": true, "audio": "audio/159ce0f5c595d5275797.m4a", "gloss": {"en": "you (all) disbelieved", "bs": "niste vjerovali"}}, {"text": "يَوْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "يَجْعَلُ", "hit": false, "audio": n