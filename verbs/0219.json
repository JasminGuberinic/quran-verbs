n": "آذِي", "quran": false, "notUsed": false, "spoken": "audio/79c27e24bf0e527a87cb.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "آذِيَا", "plain": "آذِيَا", "quran": false, "notUsed": false, "spoken": "audio/96cf699cb729112cb64c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "آذُوا", "plain": "آذُوا", "quran": false, "notUsed": false, "spoken": "audio/54be288b2d28000207ac.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "آذِينَ", "plain": "آذِينَ", "quran": false, "notUsed": false, "spoken": "audio/4883c705a4563852801b.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "33:58", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3591.mp3", "translation": {"en": {"text": "And those who malign believing men and believing women undeservedly, they bear the guilt of slander and manifest sin.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Mümin erkeklere ve mümin kadınlara yapmadıkları bir şeyden dolayı eziyet edenler de bir iftira ve açık bir günah yüklenmişlerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جو ایمان والے مردوں اور عورتوں کو بے کئے ستاتے ہیں انہوں نے بہتان اور کھلا گناہ اپنے سر لیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang menyakiti orang-orang yang mukmin dan mukminat tanpa kesalahan yang mereka perbuat, maka sesungguhnya mereka telah memikul kebohongan dan dosa yang nyata.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُؤْذُونَ", "hit": true, "audio": "audio/040b4ba7a1f0bc0c34d4.m4a", "gloss": {"bs": "uznemiravaju", "en": "they harm", "tr": "eziyet ederler", "fr": "ils nuisent", "id": "mereka menyakiti", "ur": "وہ اذیت دیتے ہیں", "bn": "তারা কষ্ট দেয়", "fa": "آزار می‌رسانند"}}, {"text": "ٱلْمُؤْمِنِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْمُؤْمِنَٰتِ", "hit": false, "audio": null, "gloss": null}, {"text": "بِغَيْرِ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱكْتَسَبُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "فَقَدِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱحْتَمَلُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "بُهْتَٰنًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِثْمًا", "hit": false, "audio": null, "gloss": null}, {"text": "مُّبِينًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُؤْذُونَ", "count": 4, "first": "9:61", "audio": "audio/040b4ba7a1f0bc0c34d4.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "uznemiravaju", "en": "they harm", "tr": "eziyet ederler", "fr": "ils nuisent", "id": "mereka menyakiti", "ur": "وہ اذیت دیتے ہیں", "bn": "তারা কষ্ট দেয়", "fa": "آزار می‌رسانند"}}, {"arabic": "وَأُوذُوا۟", "count": 2, "first": "3:195", "audio": "audio/2e7e5927d158966048b7.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": true, "objects": []}], "gloss": {"en": "and they were harmed", "bs": "i uznemireni su", "tr": "ve rahatsız edildiler", "fr": "et ils ont été troublés", "id": "dan mereka telah disusahkan", "ur": "اور انہیں نقصان پہنچایا گیا", "bn": "এবং তারা কষ্ট পেল", "fa": "و آزرده شدند"}}, {"arabic": "فَـَٔاذُوهُمَا", "count": 1, "first": "4:16", "audio": "audio/1547f441d514d0fb4a82.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["huma"]}], "gloss": {"en": "so (you all) punish them (two)!", "bs": "pa ih kaznite!", "tr": "böylece ikisini cezalandırın!", "fr": "alors punissez-les (deux) !", "id": "maka hukumlah mereka be