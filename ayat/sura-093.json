{"ayat":[{"ref":"93:1","number":6080,"text":"وَٱلضُّحَىٰ","hits":[0]},{"ref":"93:2","number":6081,"text":"وَٱلَّيْلِ إِذَا سَجَىٰ","hits":[0,1]},{"ref":"93:3","number":6082,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","hits":[0,2]},{"ref":"93:4","number":6083,"text":"وَلَلْءَاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","hits":[1,2,3]},{"ref":"93:5","number":6084,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","hits":[0,1,3]},{"ref":"93:6","number":6085,"text":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","hits":[0,1,2,3]},{"ref":"93:7","number":6086,"text":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ","hits":[1,2]},{"ref":"93:8","number":6087,"text":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ","hits":[2]},{"ref":"93:9","number":6088,"text":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","hits":[0,2]},{"ref":"93:10","number":6089,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","hits":[1]},{"ref":"93:11","number":6090,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","hits":[1]}]}