"arabic": "اِنْتَصِرِي", "plain": "اِنْتَصِرِي", "quran": false, "notUsed": false, "spoken": "audio/020ee8c763a6389d3f60.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِنْتَصِرَا", "plain": "اِنْتَصِرَا", "quran": false, "notUsed": false, "spoken": "audio/4a6392065e4031c24eda.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِنْتَصِرُوا", "plain": "اِنْتَصِرُوا", "quran": false, "notUsed": false, "spoken": "audio/a5567ed1950c1abe026b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِنْتَصِرْنَ", "plain": "اِنْتَصِرْنَ", "quran": false, "notUsed": false, "spoken": "audio/51504963665bcda74510.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "42:39", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4311.mp3", "translation": {"en": {"text": "And those who, when great wrong is done to them, defend themselves,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, bir zulüm ve saldırıya uğradıkları zaman birbirleriyle yardımlaşırlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ کہ جب انہیں بغاوت پہنچے بدلہ لیتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan ( bagi) orang-orang yang apabila mereka diperlakukan dengan zalim mereka membela diri.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "إِذَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَصَابَهُمُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْبَغْىُ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَنتَصِرُونَ", "hit": true, "audio": "audio/2affd172d27c5d387f9d.m4a", "gloss": {"bs": "brane se", "en": "they defend themselves", "tr": "kendilerini savunurlar", "fr": "ils se défendent", "id": "mereka membela diri", "ur": "وہ بدلہ لیتے ہیں", "bn": "তারা আত্মরক্ষা করে", "fa": "از خود دفاع می‌کنند"}}]}, {"ref": "42:41", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4313.mp3", "translation": {"en": {"text": "And whoso defendeth himself after he hath suffered wrong - for such, there is no way (of blame) against them.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Zulme uğradıktan sonra hakkını alan kimseye gelince, işte onların aleyhinde ceza vermek için herhangi bir yol yoktur.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بے شک جس نے اپنی مظلو می پر بدلہ لیا ان پر کچھ مواخذہ کی راه نہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya orang-orang yang membela diri sesudah teraniaya, tidak ada satu dosapun terhadap mereka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَمَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱنتَصَرَ", "hit": true, "audio": "audio/114d8e619052df5dfabe.m4a", "gloss": {"bs": "brani se", "en": "defends himself", "tr": "kendini savunur", "fr": "il se défend", "id": "dia membela diri", "ur": "بدلہ لیتا ہے", "bn": "সে আত্মরক্ষা করে", "fa": "از خود دفاع می‌کند"}}, {"text": "بَعْدَ", "hit": false, "audio": null, "gloss": null}, {"text": "ظُلْمِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْهِم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "سَبِيلٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "54:10", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4856.mp3", "translation": {"en": {"text": "So he cried unto his Lord, saying: I am vanquished, so give help.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun üzerine Rabbine: \"Ben yenik düştüm, bana yardım et!\" diyerek yalvardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو اس نے اپنے رب سے دعا کی کہ میں مغلوب ہوں تو میرا بدلہ لے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka dia mengadu kepada Tuhannya: \"bahwasanya aku ini adalah orang yang dikalahkan, oleh sebab itu menangkanlah (aku)\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَدَعَا", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "مَغْلُوبٌ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱنتَصِرْ", "hit": true, "audio": "audio/6a3fa03b661825c58772.m4a", "gloss": {"bs": "pa pomozi", "en": "so help (me)", "tr": "o hâlde yardım et", "fr": "alors secours-moi", "id": "maka tolonglah (aku)", "ur": "تو (میری) مدد کر", "bn": "তাহলে সাহায্য কর", "fa": "پس یاری کن"}}]}, {"ref": "55:35", "tense": "present", "category": {"tense": "present", "pronoun": "antuma", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4936.mp3", "translation": {"en": {"text": "There will be sent, against you both, heat of fire and flash of brass, and ye will not escape.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Üzerinize ateşten alev ve duman gönderilir, kendinizi savunamazsınız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم پر چھوڑی جائے گی بے دھویں کی آگ کی لپٹ اور بے لپٹ کا کالا دھواں تو پھر بدلا نہ لے سکو گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kepada kamu, (jin dan manusia) dilepaskan nyala api dan cairan tembaga maka kamu tidak dapat menyelamatkan diri (dari padanya).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يُرْسَلُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَيْكُمَا", "hit": false, "audio": null, "gloss": null}, {"text": "شُوَاظٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "نَّارٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنُحَاسٌ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَنتَصِرَانِ", "hit": true, "audio": "audio/db48ad481ca04f22c550.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "antuma", "passive": false, "objects": [], "mood": "indicative"}]}]}], "forms": [{"arabic": "يَنتَصِرُونَ", "count": 2, "first": "26:93", "audio": "audio/2affd172d27c5d387f9d.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "brane se", "en": "they defend themselves", "tr": "kendilerini savunurlar", "fr": "ils se défendent", "id": "mereka membela diri", "ur": "وہ بدلہ لیتے ہیں", "bn": "তারা আত্মরক্ষা করে", "fa": "از خود دفاع می‌کنند"}}, {"arabic": "وَٱنتَصَرُوا۟", "count": 1, "first": "26:227", "audio": "audio/8b1e9caebfc0e8ff9703.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "and they defended themselves", "bs": "i odbranili su se", "tr": "ve kendilerini savundular", "fr": "et ils se sont défendus", "id": "dan mereka membela diri", "ur": "اور انہوں نے دفاع کیا", "bn": "এবং তারা প্রতিরক্ষা করল", "fa": "و دفاع کردند"}}, {"arabic": "ٱنتَصَرَ", "count": 1, "first": "42:41", "audio": "audio/114d8e619052df5dfabe.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "brani se", "en": "defends himself", "tr": "kendini savunur", 