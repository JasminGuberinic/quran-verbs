{"ayat":[{"ref":"36:57","number":3762,"text":"لَهُمْ فِيهَا فَٰكِهَةٌ وَلَهُم مَّا يَدَّعُونَ","hits":[2]},{"ref":"38:51","number":4021,"text":"مُتَّكِـِٔينَ فِيهَا يَدْعُونَ فِيهَا بِفَٰكِهَةٍ كَثِيرَةٍ وَشَرَابٍ","hits":[4]},{"ref":"43:73","number":4398,"text":"لَكُمْ فِيهَا فَٰكِهَةٌ كَثِيرَةٌ مِّنْهَا تَأْكُلُونَ","hits":[2]},{"ref":"44:55","number":4469,"text":"يَدْعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَ","hits":[3]},{"ref":"52:22","number":4757,"text":"وَأَمْدَدْنَٰهُم بِفَٰكِهَةٍ وَلَحْمٍ مِّمَّا يَشْتَهُونَ","hits":[1]},{"ref":"55:11","number":4912,"text":"فِيهَا فَٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ","hits":[1]},{"ref":"55:52","number":4953,"text":"فِيهِمَا مِن كُلِّ فَٰكِهَةٍ زَوْجَانِ","hits":[3]},{"ref":"55:68","number":4969,"text":"فِيهِمَا فَٰكِهَةٌ وَنَخْلٌ وَرُمَّانٌ","hits":[1]},{"ref":"56:20","number":4999,"text":"وَفَٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ","hits":[0]},{"ref":"56:32","number":5011,"text":"وَفَٰكِهَةٍ كَثِيرَةٍ","hits":[0]},{"ref":"80:31","number":5789,"text":"وَفَٰكِهَةً وَأَبًّا","hits":[0]}]}