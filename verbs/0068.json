": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3013.mp3", "translation": {"en": {"text": "And Who causeth me to die, then giveth me life (again),", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"O ki, benim canımı alacak, sonra diriltecektir. \"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ مجھے وفات دے گا پھر مجھے زندہ کرے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan Yang akan mematikan aku, kemudian akan menghidupkan aku (kembali),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِى", "hit": false, "audio": null, "gloss": null}, {"text": "يُمِيتُنِى", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "يُحْيِينِ", "hit": true, "audio": "audio/3150ce0aa704f60a2dfa.m4a", "gloss": {"bs": "(zatim) će me oživiti", "en": "(then) He will give me life", "tr": "(sonra) beni diriltecek", "fr": "(puis) Il me fera revivre", "id": "(kemudian) Dia akan menghidupkanku", "ur": "(پھر) وہ مجھے زندہ کرے گا", "bn": "(অতঃপর) তিনি আমাকে জীবিত করবেন", "fa": "(سپس) مرا زنده خواهد کرد"}}]}, {"ref": "53:44", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4828.mp3", "translation": {"en": {"text": "And that He it is Who giveth death and giveth life;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Öldüren de dirilten de O'dur.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ کہ وہی ہے جس نے مارا اور جِلایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan bahwasanya Dialah yang mematikan dan menghidupkan,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمَاتَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَحْيَا", "hit": true, "audio": "audio/c88b27040e52d50e46b0.m4a", "gloss": {"bs": "i On je dao život", "en": "and He gave life", "tr": "ve O hayat verdi", "fr": "et Il a donné la vie", "id": "dan Dia menghidupkan", "ur": "اور اس نے زندگی بخشی", "bn": "এবং তিনি জীবন দিলেন", "fa": "و زنده کرد"}}]}, {"ref": "15:23", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1825.mp3", "translation": {"en": {"text": "Lo! and it is We, even We, Who quicken and give death, and We are the Inheritor.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Elbette biz diriltiriz ve biz öldürürüz! Ve hepsinin varisleri de biziz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم ہی جِلائیں اور ہم ہی ماریں اور ہم ہی وارث ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya benar-benar Kami-lah yang menghidupkan dan mematikan dan Kami (pulalah) yang mewarisi.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "نُحْىِۦ", "hit": true, "audio": "audio/3bcb15ea90f1097841dc.m4a", "gloss": {"en": "we give life", "bs": "oživljavamo", "tr": "canlandırırız", "fr": "nous donnons la vie", "id": "kami menghidupkan", "ur": "ہم زندہ کرتے ہیں", "bn": "আমরা জীবন দিই", "fa": "زنده می‌کنیم"}}, {"text": "وَنُمِيتُ", "hit": false, "audio": null, "gloss": null}, {"text": "وَنَحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْوَٰرِثُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "50:11", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4641.mp3", "translation": {"en": {"text": "Provision (made) for men; and therewith We quicken a dead land. Even so will be the resurrection of the dead.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunları kullara rızık olması için (yetiştirmekteyiz). O su ile ölü bir toprağa can verdik, işte hayata çıkış da böyledir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بندووں کی روزی کے لیے اور ہم نے اس سے مردہ شہر جِلایا یونہی قبروں سے تمہارا نکلنا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "untuk menjadi rezeki bagi hamba-hamba (Kami), dan Kami hidupkan dengan air itu tanah yang mati (kering). Seperti itulah terjadinya kebangkitan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رِّزْقًا", "hit": false, "audio": null, "gloss": null}, {"text": "لِّلْعِبَادِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَحْيَيْنَا", "hit": true, "audio": "audio/bc86e55dfde8bd278eac.m4a", "gloss": {"en": "and we gave life", "bs": "i oživili smo", "tr": "ve canlandırdık", "fr": "et nous avons donné la vie", "id": "dan kami telah menghidupkan", "ur": "اور ہم نے زندہ کیا", "bn": "এবং আমরা জীবন দিয়েছি", "fa": "و زنده کردیم"}}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "بَلْدَةً", "hit": false, "audio": null, "gloss": null}, {"text": "مَّيْتًا", "hit": false, "audio": null, "gloss": null}, {"text": "كَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخُرُوجُ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يُحْىِۦ", "count": 10, "first": "2:258", "audio": "audio/df76882fbe59ea9dc638.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it gives life", "bs": "oživljava", "tr": "canlandırır", "fr": "il donne la vie", "id": "dia menghidupkan", "ur": "وہ زندہ کرتا ہے", "bn": "সে জীবন দেয়", "fa": "زنده می‌کند"}}, {"arabic": "يُحْىِ", "count": 6, "first": "2:73", "audio": "audio/87b7567f43d8ef03cbb2.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}, {"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "he/it gives life", "bs": "oživljava", "tr": "canlandırır", "fr": "il donne la vie", "id": "dia menghidupkan", "ur": "وہ زندہ کرتا ہے", "bn": "সে জীবন দেয়", "fa": "زنده می‌کند"}}, {"arabic": "يُحْيِيكُمْ", "count": 5, "first": "2:28", "audio": "audio/32ec59d27e10e3c89518.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "he/it gives you (all) life", "bs": "oživljava vas", "tr": "sizi canlandırır", "fr": "il vous donne la vie", "id": "dia menghidupkan kalian", "ur": "وہ تمہیں زندہ کرتا ہے", "bn": "সে তোমাদের জীবন দেয়", "fa": "شما را زنده می‌کند"}}, {"arabic": "فَأَحْيَا", "count": 4, "first": "2:164", "audio": "audio/435f3cf2664d79e18f92.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "so he/it gave life", "bs": "pa je oživio", "tr": "böylece canlandırdı", "fr": "alors il a donné la vie", "id": "maka dia telah menghidupkan", "ur": "پس اُس نے زندہ کیا", "bn": "অতএব সে জীবন দিল", "fa": "پس زنده کرد"}}, {"arabic": "أَحْيَاهَا", "count": 2, "first": "5:32", "audio": "audio/e67f9772407487c15349.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["hiya"]}], "gloss": {"en": "he/it gave it life", "bs": "oživio ju je", "tr": "onu canlandırdı", "fr": "il lui a donné la vie", "id": "dia telah menghidupkannya", "ur": "اُس نے اسے زندہ کیا", "bn": "সে তাকে জীবন দিল", "fa": "آن را زنده کرد"}}, {"arabic": "نُحْىِۦ", "count": 2, "first": "15:23", "audio": "audio/3bcb15ea90f1097841dc.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "indicative"}]