[{"id":"adala-7-181-6","words":["verb:adala"],"options":[{"bs":"pravedno postupaju","en":"they act justly"},{"bs":"postupate pravedno","en":"you (all) are just"},{"bs":"postupajte pravedno!","en":"(you all) be just!"},{"bs":"da postupim pravedno","en":"so that I may be just"}],"ref":"7:181","answerWord":"يَعْدِلُونَ","answerSound":"audio/edba715584c91f1978e0.m4a","quranTranslation":{"text":"And of those whom We created there is a nation who guide with the Truth and establish justice therewith.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti pravedan, pravedno postupati","en":"to be just, to act justly"},"passage":["وَمِمَّنْ","خَلَقْنَآ","أُمَّةٌ","يَهْدُونَ","بِٱلْحَقِّ","وَبِهِۦ","يَعْدِلُونَ"],"marked":[6],"facts":{"verb":"عَدَلَ"}},{"id":"adala-4-3-18","words":["verb:adala"],"options":[{"bs":"postupate pravedno","en":"you (all) are just"},{"bs":"da postupim pravedno","en":"so that I may be just"},{"bs":"i skladnim te učinio","en":"and He proportioned you"},{"bs":"postupajte pravedno!","en":"(you all) be just!"}],"ref":"4:3","answerWord":"تَعْدِلُوا۟","answerSound":"audio/9c69b1c41309a24d55e4.m4a","quranTranslation":{"text":"And if ye fear that ye will not deal fairly by the orphans, marry of the women, who seem good to you, two or three or four; and if ye fear that ye cannot do justice (to so many) then one (only) or (the captives) that your right hands possess. Thus it is more likely that ye will not do injustice.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti pravedan, pravedno postupati","en":"to be just, to act justly"},"passage":["وَإِنْ","خِفْتُمْ","أَلَّا","تُقْسِطُوا۟","فِى","ٱلْيَتَٰمَىٰ","فَٱنكِحُوا۟","مَا","طَابَ","لَكُم","مِّنَ","ٱلنِّسَآءِ","مَثْنَىٰ","وَثُلَٰثَ","وَرُبَٰعَ","فَإِنْ","خِفْتُمْ","أَلَّا","تَعْدِلُوا۟","فَوَٰحِدَةً","أَوْ","مَا","مَلَكَتْ","أَيْمَٰنُكُمْ","ذَٰلِكَ","أَدْنَىٰٓ","أَلَّا","تَعُولُوا۟"],"marked":[18],"facts":{"verb":"عَدَلَ"}},{"id":"adala-5-8-15","words":["verb:adala"],"options":[{"bs":"postupajte pravedno!","en":"(you all) be just!"},{"bs":"postupate pravedno","en":"you (all) are just"},{"bs":"pravedno postupaju","en":"they act justly"},{"bs":"i skladnim te učinio","en":"and He proportioned you"}],"ref":"5:8","answerWord":"ٱعْدِلُوا۟","answerSound":"audio/b5b2990252e652d3f305.m4a","quranTranslation":{"text":"O ye who believe! Be steadfast witnesses for Allah in equity, and let not hatred of any people seduce you that ye deal not justly. Deal justly, that is nearer to your duty. Observe your duty to Allah. Lo! Allah is Informed of what ye do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti pravedan, pravedno postupati","en":"to be just, to act justly"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","كُونُوا۟","قَوَّٰمِينَ","لِلَّهِ","شُهَدَآءَ","بِٱلْقِسْطِ","وَلَا","يَجْرِمَنَّكُمْ","شَنَـَٔانُ","قَوْمٍ","عَلَىٰٓ","أَلَّا","تَعْدِلُوا۟","ٱعْدِلُوا۟","هُوَ","أَقْرَبُ","لِلتَّقْوَىٰ","وَٱتَّقُوا۟","ٱللَّهَ","إِنَّ","ٱللَّهَ","خَبِيرٌۢ","بِمَا","تَعْمَلُونَ"],"marked":[15],"facts":{"verb":"عَدَلَ"}},{"id":"adala-82-7-3","words":["verb:adala"],"options":[{"bs":"i skladnim te učinio","en":"and He proportioned you"},{"bs":"postupajte pravedno!","en":"(you all) be just!"},{"bs":"pravedno postupaju","en":"they act justly"},{"bs":"da postupim pravedno","en":"so that I may be just"}],"ref":"82:7","answerWord":"فَعَدَلَكَ","answerSound":"audio/a3ad291d88398812746f.m4a","quranTranslation":{"text":"Who created thee, then fashioned, then proportioned thee?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti pravedan, pravedno postupati","en":"to be just, to act justly"},"passage":["ٱلَّذِى","خَلَقَكَ","فَسَوَّىٰكَ","فَعَدَلَكَ"],"marked":[3],"facts":{"verb":"عَدَلَ"}},{"id":"marra-7-189-16","words":["verb:marra"],"options":[{"bs":"pa je prošla","en":"so she/it passed"},{"bs":"prošao je","en":"he/it passed"},{"bs":"zaista prolazite","en":"you surely pass"},{"bs":"prolaze","en":"they pass"}],"ref":"7:189","answerWord":"فَمَرَّتْ","answerSound":"audio/b04bd9a430c2b37c4865.m4a","quranTranslation":{"text":"He it is Who did create you from a single soul, and therefrom did make his mate that he might take rest in her. And when he covered her she bore a light burden, and she passed (unnoticed) with it, but when it became heavy they cried unto Allah, their Lord, saying: If thou givest unto us aright we shall be of the thankful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"proći, prolaziti","en":"to pass, to pass by"},"passage":["هُوَ","ٱلَّذِى","خَلَقَكُم","مِّن","نَّفْسٍ","وَٰحِدَةٍ","وَجَعَلَ","مِنْهَا","زَوْجَهَا","لِيَسْكُنَ","إِلَيْهَا","فَلَمَّا","تَغَشَّىٰهَا","حَمَلَتْ","حَمْلًا","خَفِيفًا","فَمَرَّتْ","بِهِۦ","فَلَمَّآ","أَثْقَلَت","دَّعَوَا","ٱللَّهَ","رَبَّهُمَا","لَئِنْ","ءَاتَيْتَنَا","صَٰلِحًا","لَّنَكُونَنَّ","مِنَ","ٱلشَّٰكِرِينَ"],"marked":[16],"facts":{"verb":"مَرَّ"}},{"id":"marra-12-105-6","words":["verb:marra"],"options":[{"bs":"prolaze","en":"they pass"},{"bs":"pa je prošla","en":"so she/it passed"},{"bs":"prošao je","en":"he/it passed"},{"bs":"zaista prolazite","en":"you surely pass"}],"ref":"12:105","answerWord":"يَمُرُّونَ","answerSound":"audio/a1e6d14eb6f41cf3368e.m4a","quranTranslation":{"text":"How many a portent is there in the heavens and the earth which they pass by with face averted!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"proći, prolaziti","en":"to pass, to pass by"},"passage":["وَكَأَيِّن","مِّنْ","ءَايَةٍ","فِى","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","يَمُرُّونَ","عَلَيْهَا","وَهُمْ","عَنْهَا","مُعْرِضُونَ"],"marked":[6],"facts":{"verb":"مَرَّ"}},{"id":"marra-37-137-1","words":["verb:marra"],"options":[{"bs":"zaista prolazite","en":"you surely pass"},{"bs":"prolaze","en":"they pass"},{"bs":"prošao je","en":"he/it passed"},{"bs":"pa je prošla","en":"so she/it passed"}],"ref":"37:137","answerWord":"لَتَمُرُّونَ","answerSound":"audio/0347caa72f8fe893cd07.m4a","quranTranslation":{"text":"And lo! ye verily pass by (the ruin of) them in the morning","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"proći, prolaziti","en":"to pass, to pass by"},"passage":["وَإِنَّكُمْ","لَتَمُرُّونَ","عَلَيْهِم","مُّصْبِحِينَ"],"marked":[1],"facts":{"verb":"مَرَّ"}}]