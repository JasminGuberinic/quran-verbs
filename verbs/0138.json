plain": "يَبْغِينَ", "quran": false, "notUsed": false, "spoken": "audio/91ae4ce3a4cb1255d7ff.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِبْغِ", "plain": "اِبْغِ", "quran": false, "notUsed": false, "spoken": "audio/8ed19c33d0a0ef30bbde.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِبْغِي", "plain": "اِبْغِي", "quran": false, "notUsed": false, "spoken": "audio/dee9c9bb4bfeab30c2e1.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِبْغِيَا", "plain": "اِبْغِيَا", "quran": false, "notUsed": false, "spoken": "audio/e311651192b860be176a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِبْغُوا", "plain": "اِبْغُوا", "quran": false, "notUsed": false, "spoken": "audio/38490a11b38e66866a99.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِبْغِينَ", "plain": "اِبْغِينَ", "quran": false, "notUsed": false, "spoken": "audio/3286a8f0f50b1ed6729e.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "18:108", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2248.mp3", "translation": {"en": {"text": "Wherein they will abide, with no desire to be removed from thence.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İçlerinde ebedî olarak kalacaklar, oradan hiç ayrılmak istemeyeceklerdir. Bu hatırlatma ve uyarmayı yeterli görmeyip de daha fazla açıklama isteyenlere karşı ey Muhammed!", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ ہمیشہ ان ہی میں رہیں گے ان سے جگہ بدلنا نہ چاہیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka kekal di dalamnya, mereka tidak ingin berpindah dari padanya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "خَٰلِدِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَبْغُونَ", "hit": true, "audio": "audio/5a8cd2a04a8df27f2b4c.m4a", "gloss": {"en": "they desire", "bs": "žele"}}, {"text": "عَنْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "حِوَلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:140", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1094.mp3", "translation": {"en": {"text": "He said: Shall I seek for you a god other than Allah when He hath favoured you above (all) creatures?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sizi âlemlere üstün kılan Allah olduğu halde, ben size O'ndan başka ilâh mı arayayım! dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہا کیا اللہ کے سوا تمہارا اور کوئی خدا تلاش کروں حالانکہ اس نے تمہیں زمانے بھر پر فضیلت دی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Musa menjawab: \"Patutkah aku mencari Tuhan untuk kamu yang selain dari pada Allah, padahal Dialah yang telah melebihkan kamu atas segala umat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَغَيْرَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَبْغِيكُمْ", "hit": true, "audio": "audio/9dcf6b84ae52a502a905.m4a", "gloss": {"en": "I seek you (all)", "bs": "tražim vas", "tr": "sizi ararım", "fr": "je vous cherche", "id": "aku mencari kalian", "ur": "میں تمہیں تلاش کرتا ہوں", "bn": "আমি তোমাদের খুঁজি", "fa": "شما را می‌جویم"}}, {"text": "إِلَٰهًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَهُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَضَّلَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَٰلَمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "18:64", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2204.mp3", "translation": {"en": {"text": "He said: This is that which we have been seeking. So they retraced their steps again.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa da demişti ki: \"İşte aradığımız o idi.\" Bunun üzerine izlerine dönüp gerisin geri gittiler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "موسیٰ نے کہا یہی تو ہم چاہتے تھے تو پیچھے پلٹے اپنے قدموں کے نشان دیکھتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Musa berkata: \"Itulah (tempat) yang kita cari\". Lalu keduanya kembali, mengikuti jejak mereka semula.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "ذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "نَبْغِ", "hit": true, "audio": "audio/a6bafac4477fff9992b9.m4a", "gloss": {"en": "we seek", "bs": "tražimo", "tr": "ararız", "fr": "nous cherchons", "id": "kami mencari", "ur": "ہم تلاش کرتے ہیں", "bn": "আমরা খুঁজি", "fa": "می‌جوییم"}}, {"text": "فَٱرْتَدَّا", "hit": false, "audio": null, "gloss": null}, {"text": "عَلَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاثَارِهِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "قَصَصًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "55:20", "tense": "present", "category": {"tense": "present", "pronoun": "huma", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4921.mp3", "translation": {"en": {"text": "There is a barrier between them. They encroach not (one upon the other).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Fakat aralarında bir engel vardır, birbirlerine geçip karışmıyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہے ان میں روک کہ ایک دوسرے پر بڑھ نہیں سکتا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "antara keduanya ada batas yang tidak dilampaui masing-masing.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "بَيْنَهُمَا", "hit": false, "audio": null, "gloss": null}, {"text": "بَرْزَخٌ", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَبْغِيَانِ", "hit": true, "audio": "audio/ab52579aeb871bd48c9c.m4a", "gloss": {"bs": "ne prelaze (njih dvoje)", "en": "they do not transgress (the two)", "tr": "(ikisini) aşmazlar", "fr": "ils (ne) transgressent (pas) (les deux)", "id": "mereka (tidak) melampaui batas (keduanya)", "ur": "(دونوں) سرکشی نہیں کرتے", "bn": "(দুটি) সীমালঙ্ঘন করে না", "fa": "(آن دو) تجاوز نمی‌کنند"}}]}], "forms": [{"arabic": "يَبْغُونَ", "count": 4, "first": "3:83", "audio": "audio/8b1618df4eeca6312122.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they desire; they transgress", "bs": "žele; čine nasilje", "tr": "isterler; haddi aşarlar", "fr": "ils désirent ; ils commettent l'injustice", "id": "mereka menginginkan; mereka berbuat zalim", "ur": "وہ سرکشی کرتے ہیں", "bn": "তারা কামনা করে; তারা সীমালঙ্ঘন করে", "fa": "می‌خواهند؛ تجاوز می‌کنند"}}, {"arabic": "وَيَبْغُونَهَا", "count": 3, "first": "7:45", "audio": "audio/1d6083e21c4d9ee0cedd.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["hiya"], "mood": "indicative"}], "gloss": {"en": "and they seek it", "bs": "i traže ga", "tr": "ve onu ararlar", "fr": "et ils la recherchent", "id": "dan mereka mencarinya", "ur": "اور وہ اس کی تلاش کرتے ہیں", "bn": "এবং তারা তা খোঁজে", "fa": "و آن را می‌جویند"}}, {"arabic": "تَبْغُونَهَا", "count": 1, "first": "3:99", "audio": "audio/685f411be7eafe3d2295.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": ["hiya"], "mood": "indicative"}], "gloss": {"en": "you (all) seek it", "bs": "tražite ga", "tr": "onu ararsınız", "fr": "vous la recherchez", "id": "kalian mencarinya", "ur": "تم سب اسے تلاش کرتے ہو", "bn": "তোমরা তা খোঁজ", "fa": "آن را می‌جویید"}}, {"arabic": "تَبْغُوا۟", "count": 1, "first": "4:34", "audio": "audio/f81ff39e15881359300e.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "you (all) seek", "bs": "tražite", "tr": "ararsınız", "fr": "que vous cherchiez", "id": "kalian mencari", "ur": "تم سب تلاش کرتے ہو", "bn": "তোমরা খোঁজ", "fa": "بجویید"}}, {"arabic": "أَبْغِى", "count": 1, "first": "6:164", "audio": "audio/ca9fdaa1fa8bfa39d743.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "I seek", "bs": "tražim", "tr": "ararım", "fr": "je cherche", "id": "aku mencari", "ur": "میں تلاش کرتا ہوں", "bn": "আমি খুঁজি", "fa": "می‌جویم"}}, {"arabic": "وَتَبْغُونَهَا", "count": 1, "first": "7:86", "audio": "audio/f5f7cc232b6c938a7f9a.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": ["hiya"], "mood": "indicative"}], "gloss": {"en": "and you (all) seek it", "bs": "i tražite ga", "tr": "ve onu ararsınız", "fr": "et vous la recherchez", "id": "dan kalian mencarinya", "ur": "اور تم سب اسے تلاش کرتے ہو", "bn": "এবং তোমরা তা খোঁজ", "fa": "و آن را می‌جویید"}}, {"arabic": "أَبْغِيكُمْ", "count": 1, "first": "7:140", "audio": "audio/9dcf6b84ae52a502a905.m4a", "grammar": [{"tense": "present", "pronoun": "ana", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "I seek you (all)", "bs": "tražim vas", "tr": "sizi ararım", "fr": "je vous cherche", "id": "aku mencari kalian", "ur": "میں تمہیں تلاش کرتا ہوں", "bn": "আমি তোমাদের খুঁজি", "fa": "شما را می‌جویم"}}, {"arabic": "يَبْغُونَكُمُ", "count": 1, "first": "9:47", "audio": "audio/3515069b7f91232c6570.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": ["antum"], "mood": "indicative"}], "gloss": {"en": "they seek you (all)", "bs": "traže vas", "tr": "sizi ararlar", "fr": "ils vous cherchent", "id": "mereka mencari kalian", "ur": "وہ تمہیں تلاش کرتے ہیں", "bn": "তারা তোমাদের খোঁজে", "fa": "شما را می‌جویند"}}, {"arabic": "نَبْغِى", "count": 1, "first": "12:65", "audio": "audio/c2ee66db2ec436a3b070.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "we desire", "bs": "želimo", "tr": "isteriz", "fr": "nous désirons", "id": "kami menginginkan", "ur": "ہم چاہتے ہیں", "bn": "আমরা কামনা করি", "fa": "می‌خواهیم"}}, {"arabic": "نَبْغِ", "count": 1, "first": "18:64", "audio": "audio/a6bafac4477fff9992b9.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "we seek", "bs": "tražimo", "tr": "ararız", "fr": "nous cherchons", "id": "kami mencari", "ur": "ہم تلاش کرتے ہیں", "bn": "আমরা খুঁজি", "fa": "می‌جوییم"}}, {"arabic": "بُغِىَ", "count": 1, "first": "22:60", "audio": "audio/3080c2d4d94d939c3fed.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "he/it was wronged", "bs": "nasilje je učinjeno nad njim", "tr": "ona zulmedildi", "fr": "il a été lésé ; on a commis une injustice envers lui", "id": "dia telah dizalimi", "ur": "اُس پر ظلم کیا گیا", "bn": "তার প্রতি অন্যায় করা হয়েছে", "fa": "بر او تجاوز شد"}}, {"arabic": "فَبَغَىٰ", "count": 1, "first": "28:76", "audio": "audio/297bf406cb8a102393d9.m4a", "grammar": [{"ten