s": [{"arabic": "أَذِنْتَ", "target": true, "translation": {"bs": "dozvolio si", "en": "you allowed", "bn": "তুমি অনুমতি দিলে", "fa": "اجازه دادی", "fr": "tu as permis", "id": "kamu mengizinkan", "tr": "izin verdin", "ur": "تو نے اجازت دی"}}, {"arabic": "لِصَدِيقِكَ", "target": false, "translation": {"bs": "prijatelju", "en": "your friend", "bn": "তোমার বন্ধু", "fa": "به دوستت", "fr": "à ton ami", "id": "temanmu", "tr": "arkadaşın", "ur": "تمہارے دوست کو"}}, {"arabic": "بِالْجُلُوسِ", "target": false, "translation": {"bs": "da sjedne", "en": "sitting", "bn": "বসা", "fa": "نشستن", "fr": "de s'asseoir", "id": "duduk", "tr": "oturmasına", "ur": "بیٹھنے کی"}}]}, {"arabic": "اِئْذَنُوا لِلطُّلَّابِ بِالرَّاحَةِ", "spoken": "audio/0ded09b26654b01efa93.m4a", "tense": "imperative", "pronoun": "antum", "translation": {"bs": "Dozvolite učenicima da se odmore.", "en": "Allow the students to rest.", "bn": "ছাত্রদের বিশ্রাম নেওয়ার অনুমতি দাও।", "fa": "به دانش‌آموزان اجازه استراحت دهید.", "fr": "Permettez aux élèves de se reposer.", "id": "Izinkan para siswa beristirahat.", "tr": "Öğrencilerin dinlenmesine izin verin.", "ur": "طلبہ کو آرام کی اجازت دو۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِئْذَنُوا", "target": true, "translation": {"bs": "dozvolite", "en": "allow", "bn": "অনুমতি দাও", "fa": "اجازه دهید", "fr": "permettez !", "id": "izinkanlah", "tr": "izin verin", "ur": "اجازت دو"}}, {"arabic": "لِلطُّلَّابِ", "target": false, "translation": {"bs": "učenicima", "en": "the students", "bn": "ছাত্রদের", "fa": "به دانش‌آموزان", "fr": "aux élèves", "id": "para siswa", "tr": "öğrencilerin", "ur": "طلبہ کو"}}, {"arabic": "بِالرَّاحَةِ", "target": false, "translation": {"bs": "da se odmore", "en": "to rest", "bn": "বিশ্রাম নিতে", "fa": "استراحت", "fr": "de se reposer", "id": "untuk beristirahat", "tr": "dinlenmesine", "ur": "آرام کی"}}]}]}