{"ayat":[{"ref":"100:1","number":6147,"text":"وَٱلْعَٰدِيَٰتِ ضَبْحًا","hits":[]},{"ref":"100:2","number":6148,"text":"فَٱلْمُورِيَٰتِ قَدْحًا","hits":[]},{"ref":"100:3","number":6149,"text":"فَٱلْمُغِيرَٰتِ صُبْحًا","hits":[1]},{"ref":"100:4","number":6150,"text":"فَأَثَرْنَ بِهِۦ نَقْعًا","hits":[0,1]},{"ref":"100:5","number":6151,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا","hits":[2]},{"ref":"100:6","number":6152,"text":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌ","hits":[0,1,2]},{"ref":"100:7","number":6153,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ","hits":[1,2,3]},{"ref":"100:8","number":6154,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","hits":[1,2,3]},{"ref":"100:9","number":6155,"text":"أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","hits":[0,1,2,4,5,6]},{"ref":"100:10","number":6156,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","hits":[3]},{"ref":"100:11","number":6157,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ","hits":[3,4]}]}