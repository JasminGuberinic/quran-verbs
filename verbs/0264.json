", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱسْلُكْ", "plain": "اُسْلُكْ", "quran": true, "notUsed": false, "spoken": "audio/d3499cfc4e2aee90d25a.m4a", "recited": "audio/88103a2e00a404f71077.m4a", "recitedText": "ٱسْلُكْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "ٱسْلُكِى", "plain": "اُسْلُكِي", "quran": true, "notUsed": false, "spoken": "audio/4445718d83cd75ff6203.m4a", "recited": "audio/8eecf0eddea6c7dbffa3.m4a", "recitedText": "فَٱسْلُكِى"}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُسْلُكَا", "plain": "اُسْلُكَا", "quran": false, "notUsed": false, "spoken": "audio/a2e3597088d3ab857106.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اُسْلُكُوا", "plain": "اُسْلُكُوا", "quran": false, "notUsed": false, "spoken": "audio/64c2c2921b2525114833.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُسْلُكْنَ", "plain": "اُسْلُكْنَ", "quran": false, "notUsed": false, "spoken": "audio/c4de8de3808b72ee0cd7.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "74:42", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5537.mp3", "translation": {"en": {"text": "What hath brought you to this burning?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Nedir sizi Sekar'a sokan?\" diye.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تمہیں کیا بات دوزخ میں لے گئی،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "\"Apakah yang memasukkan kamu ke dalam Saqar (neraka)?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "سَلَكَكُمْ", "hit": true, "audio": "audio/59d934e508972c142f71.m4a", "gloss": {"bs": "uvelo vas je", "en": "led you", "tr": "sizi soktu", "fr": "vous a conduits", "id": "menuntunmu", "ur": "تمہیں داخل کیا", "bn": "তোমাদের পরিচালিত করেছে", "fa": "شما را درآورد"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "سَقَرَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "72:17", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5464.mp3", "translation": {"en": {"text": "That We may test them thereby, and whoso turneth away from the remembrance of his Lord; He will thrust him into ever-growing torment.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ki onları onunla sınayalım. Kim Rabbini anmaktan yüz çevirirse, Rabbi onu gittikçe yükselen bir azaba sokar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ اس پر انہیں جانچیں اور جو اپنے رب کی یاد سے منہ پھیرے وہ اسے چڑھتے عذاب میں ڈالے گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Untuk Kami beri cobaan kepada mereka padanya. Dan barangsiapa yang berpaling dari peringatan Tuhannya, niscaya akan dimasukkan-Nya ke dalam azab yang amat berat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لِّنَفْتِنَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "يُعْرِضْ", "hit": false, "audio": null, "gloss": null}, {"text": "عَن", "hit": false, "audio": null, "gloss": null}, {"text": "ذِكْرِ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْلُكْهُ", "hit": true, "audio": "audio/774bfedff1d8d35d2ac7.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["huwa"], "mood": "jussive"}]}, {"text": "عَذَابًا", "hit": false, "audio": null, "gloss": null}, {"text": "صَعَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:12", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1814.mp3", "translation": {"en": {"text": "Thus do We make it traverse the hearts of the guilty:", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz o küfrü suçluların kalbine işte böyle sokarız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ایسے ہی ہم اس ہنسی کو ان مجرموں کے دلوں میں راہ دیتے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Demikianlah, Kami mamasukkan (rasa ingkar dan memperolok-olokkan itu) kedalam hati orang-orang yang berdosa (orang-orang kafir),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَسْلُكُهُۥ", "hit": true, "audio": "audio/bc4dcd0bd0751bbeee94.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": ["huwa"], "mood": "indicative"}]}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "قُلُوبِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُجْرِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:200", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3132.mp3", "translation": {"en": {"text": "Thus do We make it traverse the hearts of the guilty.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Böylece onu günahkarların kalplerine soktuk. (okuyup anladılar, ama yine de) acıklı azabı görünceye kadar ona iman etmezler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ہم نے یونہی جھٹلانا پیرا دیا ہے مجرموں کے دلوں میں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Demikianlah Kami masukkan Al Quran ke dalam hati orang-orang yang durhaka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَلَكْنَٰهُ", "hit": true, "audio": "audio/031c1a2fe7a2b4b1ca00.m4a", "gloss": null, "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": ["huwa"]}]}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "قُلُوبِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُجْرِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "69:32", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5355.mp3", "translation": {"en": {"text": "And then insert him in a chain whereof the length is seventy cubits.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Sonra da boyu yetmiş arşın zincir içerisinde onu oraya sokun.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر ایسی زنجیر میں جس کا ناپ ستر ہاتھ ہے اسے پُرو دو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian belitlah dia dengan rantai yang panjangnya tujuh puluh hasta.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "سِلْسِلَةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "ذَرْعُهَا", "hit": false, "audio": null, "gloss": null}, {"text": "سَبْعُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ذِرَاعًا", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱسْلُكُوهُ", "hit": true, "audio": "audio/d0aadfabb7b5e1437fa4.m4a", "gloss": {"bs": "pa ga uvedite", "en": "then insert him", "tr": "sonra onu sokun", "fr": "puis introduisez-le", "id": "kemudian masukkanlah dia", "ur": "پس اسے ڈال دو", "bn": "তখন তাকে প্রবেশ করাও", "fa": "پس او را درآورید"}}]}, {"r