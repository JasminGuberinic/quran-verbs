": true, "audio": "audio/2bcaa23950ebb35380d6.m4a", "gloss": {"bs": "pa zatraži zaštitu", "en": "so seek refuge", "tr": "öyleyse sığın", "fr": "alors cherche refuge", "id": "maka mohonlah perlindungan", "ur": "پس تو پناہ مانگ", "bn": "অতএব আশ্রয় চাও", "fa": "پس پناه بجوی"}}, {"text": "بِٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلشَّيْطَٰنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّجِيمِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "فَٱسْتَعِذْ", "count": 4, "first": "7:200", "audio": "audio/42a7c63aabad765949a9.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"bs": "pa zatraži zaštitu", "en": "so seek refuge", "tr": "böylece sığın", "fr": "alors cherche refuge", "id": "maka mintalah perlindungan", "ur": "پس پناہ مانگو", "bn": "অতএব আশ্রয় চাও", "fa": "پس پناه بجوی!"}}], "ayatFile": "ayat/0554.json", "ayatTranslations": {"en": "ayat/0554.en.json", "tr": "ayat/0554.tr.json", "ur": "ayat/0554.ur.json", "id": "ayat/0554.id.json"}, "sentences": [{"arabic": "اِسْتَعِذْ مِنَ الْكَسَلِ", "spoken": "audio/6971d66f702b9bcf7d8b.m4a", "tense": "imperative", "pronoun": "anta", "translation": {"bs": "Traži utočište od lijenosti.", "en": "Seek refuge from laziness.", "bn": "অলসতা থেকে আশ্রয় চাও।", "fa": "از تنبلی پناه بجو.", "fr": "Cherche refuge contre la paresse.", "id": "Mohonlah perlindungan dari kemalasan.", "tr": "Tembellikten Allah'a sığın.", "ur": "کاہلی سے پناہ مانگو۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِسْتَعِذْ", "target": true, "translation": {"bs": "traži utočište", "en": "seek refuge", "bn": "আশ্রয় চাও", "fa": "پناه بجوی", "fr": "cherche refuge", "id": "dia memohon perlindungan", "tr": "sığınır", "ur": "پناہ مانگو"}}, {"arabic": "مِنَ", "target": false, "translation": {"bs": "od", "en": "from", "bn": "থেকে", "fa": "از", "fr": "de", "id": "dari", "tr": "-den"