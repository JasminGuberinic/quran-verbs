": "imperative", "pronoun": "anti", "arabic": "اِبْخَلِي", "plain": "اِبْخَلِي", "quran": false, "notUsed": false, "spoken": "audio/235b743d09a8f3a055d7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِبْخَلَا", "plain": "اِبْخَلَا", "quran": false, "notUsed": false, "spoken": "audio/0999fee563446a24ae49.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِبْخَلُوا", "plain": "اِبْخَلُوا", "quran": false, "notUsed": false, "spoken": "audio/b70893c8d888e4ddcbe4.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِبْخَلْنَ", "plain": "اِبْخَلْنَ", "quran": false, "notUsed": false, "spoken": "audio/70aeab11c4f3a3815249.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "57:24", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5099.mp3", "translation": {"en": {"text": "Who hoard and who enjoin upon the people avarice. And whosoever turneth away, still Allah is the Absolute, the Owner of Praise.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar cimrilik edip insanlara da cimriliği emrederler. Kim yüz çevirirse Allah, zengindir, övgüye layıktır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "وہ جو آپ بخل کریں اور اوروں سے بخل کو کہیں اور جو منہ پھیرے تو بیشک اللہ ہی بے نیاز ہے سب خوبیوں سراہا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yaitu) orang-orang yang kikir dan menyuruh manusia berbuat kikir. Dan barangsiapa yang berpaling (dari perintah-perintah Allah) maka sesungguhnya Allah Dialah Yang Maha Kaya lagi Maha Terpuji.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَبْخَلُونَ", "hit": true, "audio": "audio/7cfd1170fc9d2712649b.m4a", "gloss": {"en": "they are stingy", "bs": "škrtare", "tr": "cimrilik ederler", "fr": "ils sont avares", "id": "mereka kikir", "ur": "وہ بخل کرتے ہیں", "bn": "তারা কৃপণতা করে", "fa": "بخل می‌ورزند"}}, {"text": "وَيَأْمُرُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلنَّاسَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْبُخْلِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَوَلَّ", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْغَنِىُّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَمِيدُ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "9:76", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1311.mp3", "translation": {"en": {"text": "Yet when He gave them of His bounty, they hoarded it and turned away, averse;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ne zaman ki, Allah lutfedip onlara ihsanda bulundu, onlar da cimrilik edip yüz çevirdiler ve zaten yan çizip duruyorlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو جب اللہ نے انہیں اپنے فضل سے دیا اس میں بخل کرنے لگے اور منہ پھیر کر پلٹ گئے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka setelah Allah memberikan kepada mereka sebahagian dari karunia-Nya, mereka kikir dengan karunia itu, dan berpaling, dan mereka memanglah orang-orang yang selalu membelakangi (kebenaran).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَمَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاتَىٰهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "فَضْلِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "بَخِلُوا۟", "hit": true, "audio": "audio/db660e9ce966387389cb.m4a", "gloss": {"en": "they were stingy", "bs": "škrtarili su", "tr": "cimrilik ettiler", "fr": "ils ont été avares", "id": "mereka telah kikir", "ur": "انہوں نے بخل کیا", "bn": "তারা কৃপণতা করেছিল", "fa": "بخل ورزیدند"}}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "وَتَوَلَّوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَّهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّعْرِضُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "47:37", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4582.mp3", "translation": {"en": {"text": "If He should ask it of you and importune you, ye would hoard it, and He would bring to light your (secret) hates.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer sizden onların tamamını isteyip de sizi zorlasaydı cimrilik ederdiniz. Bu da sizin bütün kinlerinizi ortaya çıkarırdı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اگر انہیں تم سے طلب کرے اور زیادہ طلب کرے تم بخل کرو گے اور وہ بخل تمہارے دلوں کے میل ظاہر کردے گا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Jika Dia meminta harta kepadamu lalu mendesak kamu (supaya memberikan semuanya) niscaya kamu akan kikir dan Dia akan menampakkan kedengkianmu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِن", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْـَٔلْكُمُوهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَيُحْفِكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَبْخَلُوا۟", "hit": true, "audio": "audio/88ab59094b16260e2a97.m4a", "gloss": {"bs": "škrtarili biste", "en": "you would be stingy", "tr": "cimrilik ederdiniz", "fr": "vous seriez avares", "id": "kamu akan kikir", "ur": "تم بخل کرتے", "bn": "তোমরা কৃপণতা করবে", "fa": "بخل می‌ورزیدید"}}, {"text": "وَيُخْرِجْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَضْغَٰنَكُمْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "92:8", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6066.mp3", "translation": {"en": {"text": "But as for him who hoardeth and deemeth himself independent,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kim de cimrilik eder ve kendini hiçbir şeye ihtiyacı kalmamış görür.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جس نے بخل کیا اور بے پرواہ بنا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan adapun orang-orang yang bakhil dan merasa dirinya cukup,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "مَنۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بَخِلَ", "hit": true, "audio": "audio/9876351ad6a3d5a2047b.m4a", "gloss": {"bs": "škrtario je", "en": "was stingy", "tr": "cimrilik etti", "fr": "fut avare", "id": "dia kikir", "ur": "اس نے بخل کیا", "bn": "কৃপণতা করল", "fa": "بخل ورزید"}}, {"text": "وَٱسْتَغْنَىٰ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَبْخَلُونَ", "count": 3, "first": "3:180", "audio": "audio/de2568c2feaf0dd9fa52.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they are stingy", "bs": "škrtare", "tr": "cimrilik ederler", "fr": "ils sont avares", "id": "mereka kikir", "ur": "وہ بخل کرتے ہیں", "bn": "তারা কৃপণতা করে", "fa": "بخل می‌ورزند"}}, {"arabic": "بَخِلُوا۟", "count": 2, "first": "3:180", "audio": "audio/783ceb29a9a8f24a04a6.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive