{"ayat":[{"ref":"99:1","number":6139,"text":"إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","hits":[0,2,3]},{"ref":"99:2","number":6140,"text":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","hits":[0,2]},{"ref":"99:3","number":6141,"text":"وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا","hits":[0,1,2,3]},{"ref":"99:4","number":6142,"text":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا","hits":[0,2]},{"ref":"99:5","number":6143,"text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","hits":[0,1,2]},{"ref":"99:6","number":6144,"text":"يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَٰلَهُمْ","hits":[2,4,5]},{"ref":"99:7","number":6145,"text":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ","hits":[0,1,2,3,4,5]},{"ref":"99:8","number":6146,"text":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ","hits":[4]}]}