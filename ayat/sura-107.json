{"ayat":[{"ref":"107:1","number":6198,"text":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","hits":[0,1,2,3]},{"ref":"107:2","number":6199,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","hits":[0,3]},{"ref":"107:3","number":6200,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","hits":[0,2,3,4]},{"ref":"107:4","number":6201,"text":"فَوَيْلٌ لِّلْمُصَلِّينَ","hits":[0,1]},{"ref":"107:5","number":6202,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","hits":[0,1,2,3]},{"ref":"107:6","number":6203,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","hits":[]},{"ref":"107:7","number":6204,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","hits":[0]}]}