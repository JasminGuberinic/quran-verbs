": "بہکایا"}}, {"arabic": "الْإِعْلَانَاتُ", "target": false, "translation": {"bs": "reklame", "en": "the advertisements", "bn": "বিজ্ঞাপনগুলো", "fa": "آگهی‌ها", "fr": "les publicités", "id": "iklan-iklan itu", "tr": "reklamlar", "ur": "اشتہارات"}}, {"arabic": "لِلنَّاسِ", "target": false, "translation": {"bs": "ljude", "en": "people", "bn": "মানুষ", "fa": "برای مردم", "fr": "les gens", "id": "orang-orang", "tr": "insanlar", "ur": "لوگ"}}, {"arabic": "الشِّرَاءَ", "target": false, "translation": {"bs": "na kupovinu", "en": "purchasing", "bn": "কেনার", "fa": "خرید", "fr": "à l'achat", "id": "untuk membeli", "tr": "satın almaya", "ur": "خریداری"}}]}]}