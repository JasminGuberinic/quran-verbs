[{"id":"amara-96-12-1","words":["verb:amara"],"options":[{"bs":"(ili) je naređivao","en":"(or) he enjoined"},{"bs":"naređeno im je","en":"they were commanded"},{"bs":"naredio mu je","en":"he/it commanded him"},{"bs":"naredio si mi","en":"you commanded me"}],"ref":"96:12","answerWord":"أَمَرَ","answerSound":"audio/96a70d3da70762886577.m4a","quranTranslation":{"text":"Or enjoineth piety?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["أَوْ","أَمَرَ","بِٱلتَّقْوَىٰٓ"],"marked":[1],"facts":{"verb":"أَمَرَ"}},{"id":"amara-10-72-11","words":["verb:amara"],"options":[{"bs":"i naređeno mi je","en":"and I was commanded"},{"bs":"i naređuj!","en":"and enjoin!"},{"bs":"naredio mu je","en":"he/it commanded him"},{"bs":"i naređuju","en":"and they command"}],"ref":"10:72","answerWord":"وَأُمِرْتُ","answerSound":"audio/7b8ae064c824f0665b38.m4a","quranTranslation":{"text":"But if ye are averse I have asked of you no wage. My wage is the concern of Allah only, and I am commanded to be of those who surrender (unto Him).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["فَإِن","تَوَلَّيْتُمْ","فَمَا","سَأَلْتُكُم","مِّنْ","أَجْرٍ","إِنْ","أَجْرِىَ","إِلَّا","عَلَى","ٱللَّهِ","وَأُمِرْتُ","أَنْ","أَكُونَ","مِنَ","ٱلْمُسْلِمِينَ"],"marked":[11],"facts":{"verb":"أَمَرَ"}},{"id":"amara-6-14-14","words":["verb:amara"],"options":[{"bs":"naređeno mi je","en":"I was commanded"},{"bs":"zar vam naređuje?","en":"does he/it command you (all)?"},{"bs":"savjetujete (naređujete)","en":"you advise (command)"},{"bs":"naređuje vam se","en":"you (all) are commanded"}],"ref":"6:14","answerWord":"أُمِرْتُ","answerSound":"audio/795c1c4b8c97e6738013.m4a","quranTranslation":{"text":"Say: Shall I choose for a protecting friend other than Allah, the Originator of the heavens and the earth, Who feedeth and is never fed? Say: I am ordered to be the first to surrender (unto Him). And be not thou (O Muhammad) of the idolaters.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["قُلْ","أَغَيْرَ","ٱللَّهِ","أَتَّخِذُ","وَلِيًّا","فَاطِرِ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","وَهُوَ","يُطْعِمُ","وَلَا","يُطْعَمُ","قُلْ","إِنِّىٓ","أُمِرْتُ","أَنْ","أَكُونَ","أَوَّلَ","مَنْ","أَسْلَمَ","وَلَا","تَكُونَنَّ","مِنَ","ٱلْمُشْرِكِينَ"],"marked":[14],"facts":{"verb":"أَمَرَ"}},{"id":"amara-19-55-1","words":["verb:amara"],"options":[{"bs":"naređuje","en":"he/it commands"},{"bs":"naredio sam ti","en":"I commanded you"},{"bs":"naređeno ti je","en":"you were commanded"},{"bs":"naređuje vam se","en":"you (all) are commanded"}],"ref":"19:55","answerWord":"يَأْمُرُ","answerSound":"audio/6af24f2078fe532018bd.m4a","quranTranslation":{"text":"He enjoined upon his people worship and almsgiving, and was acceptable in the sight of his Lord.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["وَكَانَ","يَأْمُرُ","أَهْلَهُۥ","بِٱلصَّلَوٰةِ","وَٱلزَّكَوٰةِ","وَكَانَ","عِندَ","رَبِّهِۦ","مَرْضِيًّا"],"marked":[1],"facts":{"verb":"أَمَرَ"}},{"id":"amara-57-24-2","words":["verb:amara"],"options":[{"bs":"i naređuju","en":"and they command"},{"bs":"naredio vam je","en":"he/it commanded you (all)"},{"bs":"naređujete mi","en":"you (all) command me"},{"bs":"i naređuj!","en":"and enjoin!"}],"ref":"57:24","answerWord":"وَيَأْمُرُونَ","answerSound":"audio/b91902940c5b5213ae1c.m4a","quranTranslation":{"text":"Who hoard and who enjoin upon the people avarice. And whosoever turneth away, still Allah is the Absolute, the Owner of Praise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["ٱلَّذِينَ","يَبْخَلُونَ","وَيَأْمُرُونَ","ٱلنَّاسَ","بِٱلْبُخْلِ","وَمَن","يَتَوَلَّ","فَإِنَّ","ٱللَّهَ","هُوَ","ٱلْغَنِىُّ","ٱلْحَمِيدُ"],"marked":[2],"facts":{"verb":"أَمَرَ"}},{"id":"amara-7-199-2","words":["verb:amara"],"options":[{"bs":"i naređuj!","en":"and enjoin!"},{"bs":"zar naređujete?","en":"do you (all) command?"},{"bs":"naređuje vam","en":"he/it commands you (all)"},{"bs":"naređuju","en":"they command"}],"ref":"7:199","answerWord":"وَأْمُرْ","answerSound":"audio/70ff1986d2520456dd66.m4a","quranTranslation":{"text":"Keep to forgiveness (O Muhammad), and enjoin kindness, and turn away from the ignorant.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["خُذِ","ٱلْعَفْوَ","وَأْمُرْ","بِٱلْعُرْفِ","وَأَعْرِضْ","عَنِ","ٱلْجَٰهِلِينَ"],"marked":[2],"facts":{"verb":"أَمَرَ"}},{"id":"amara-3-21-11","words":["verb:amara"],"options":[{"bs":"naređuju","en":"they command"},{"bs":"naređuje vam","en":"he/it commands you (all)"},{"bs":"naređuješ","en":"you command"},{"bs":"zar naređujete?","en":"do you (all) command?"}],"ref":"3:21","answerWord":"يَأْمُرُونَ","answerSound":"audio/60d70c651b1999b1931c.m4a","quranTranslation":{"text":"Lo! those who disbelieve the revelations of Allah, and slay the prophets wrongfully, and slay those of mankind who enjoin equity: promise them a painful doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["إِنَّ","ٱلَّذِينَ","يَكْفُرُونَ","بِـَٔايَٰتِ","ٱللَّهِ","وَيَقْتُلُونَ","ٱلنَّبِيِّۦنَ","بِغَيْرِ","حَقٍّ","وَيَقْتُلُونَ","ٱلَّذِينَ","يَأْمُرُونَ","بِٱلْقِسْطِ","مِنَ","ٱلنَّاسِ","فَبَشِّرْهُم","بِعَذَابٍ","أَلِيمٍ"],"marked":[11],"facts":{"verb":"أَمَرَ"}},{"id":"amara-7-110-6","words":["verb:amara"],"options":[{"bs":"savjetujete (naređujete)","en":"you advise (command)"},{"bs":"i naređuju","en":"and they command"},{"bs":"naredio nam je","en":"he/it commanded us"},{"bs":"naređeno im je","en":"they were commanded"}],"ref":"7:110","answerWord":"تَأْمُرُونَ","answerSound":"audio/e4bcd1d0234e060e8d12.m4a","quranTranslation":{"text":"Who would expel you from your land. Now what do ye advise?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["يُرِيدُ","أَن","يُخْرِجَكُم","مِّنْ","أَرْضِكُمْ","فَمَاذَا","تَأْمُرُونَ"],"marked":[6],"facts":{"verb":"أَمَرَ"}},{"id":"amara-4-60-20","words":["verb:amara"],"options":[{"bs":"naređeno im je","en":"they were commanded"},{"bs":"zar naređujete?","en":"do you (all) command?"},{"bs":"naredio nam je","en":"he/it commanded us"},{"bs":"naređuje","en":"he/it commands"}],"ref":"4:60","answerWord":"أُمِرُوٓا۟","answerSound":"audio/e74fdbd7ce648a44400a.m4a","quranTranslation":{"text":"Hast thou not seen those who pretend that they believe in that which is revealed unto thee and that which was revealed before thee, how they would go for judgment (in their disputes) to false deities when they have been ordered to abjure them? Satan would mislead them far astray.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["أَلَمْ","تَرَ","إِلَى","ٱلَّذِينَ","يَزْعُمُونَ","أَنَّهُمْ","ءَامَنُوا۟","بِمَآ","أُنزِلَ","إِلَيْكَ","وَمَآ","أُنزِلَ","مِن","قَبْلِكَ","يُرِيدُونَ","أَن","يَتَحَاكَمُوٓا۟","إِلَى","ٱلطَّٰغُوتِ","وَقَدْ","أُمِرُوٓا۟","أَن","يَكْفُرُوا۟","بِهِۦ","وَيُرِيدُ","ٱلشَّيْطَٰنُ","أَن","يُضِلَّهُمْ","ضَلَٰلًۢا","بَعِيدًا"],"marked":[20],"facts":{"verb":"أَمَرَ"}},{"id":"amara-2-67-6","words":["verb:amara"],"options":[{"bs":"naređuje vam","en":"he/it commands you (all)"},{"bs":"(ili) je naređivao","en":"(or) he enjoined"},{"bs":"naređujete nam","en":"you (all) command us"},{"bs":"naredio mu je","en":"he/it commanded him"}],"ref":"2:67","answerWord":"يَأْمُرُكُمْ","answerSound":"audio/0d1b7691b6892b8db355.m4a","quranTranslation":{"text":"And when Moses said unto his people: Lo! Allah commandeth you that ye sacrifice a cow, they said: Dost thou make game of us? He answered: Allah forbid that I should be among the foolish!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["وَإِذْ","قَالَ","مُوسَىٰ","لِقَوْمِهِۦٓ","إِنَّ","ٱللَّهَ","يَأْمُرُكُمْ","أَن","تَذْبَحُوا۟","بَقَرَةً","قَالُوٓا۟","أَتَتَّخِذُنَا","هُزُوًا","قَالَ","أَعُوذُ","بِٱللَّهِ","أَنْ","أَكُونَ","مِنَ","ٱلْجَٰهِلِينَ"],"marked":[6],"facts":{"verb":"أَمَرَ"}},{"id":"amara-2-68-22","words":["verb:amara"],"options":[{"bs":"naređuje vam se","en":"you (all) are commanded"},{"bs":"i naređuju","en":"and they command"},{"bs":"naređuješ","en":"you command"},{"bs":"naredio mu je","en":"he/it commanded him"}],"ref":"2:68","answerWord":"تُؤْمَرُونَ","answerSound":"audio/d1bf8ddb9ddaf7de0f2a.m4a","quranTranslation":{"text":"They said: Pray for us unto thy Lord that He make clear to us what (cow) she is. (Moses) answered: Lo! He saith, Verily she is a cow neither with calf nor immature; (she is) between the two conditions; so do that which ye are commanded.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["قَالُوا۟","ٱدْعُ","لَنَا","رَبَّكَ","يُبَيِّن","لَّنَا","مَا","هِىَ","قَالَ","إِنَّهُۥ","يَقُولُ","إِنَّهَا","بَقَرَةٌ","لَّا","فَارِضٌ","وَلَا","بِكْرٌ","عَوَانٌۢ","بَيْنَ","ذَٰلِكَ","فَٱفْعَلُوا۟","مَا","تُؤْمَرُونَ"],"marked":[22],"facts":{"verb":"أَمَرَ"}},{"id":"amara-2-93-21","words":["verb:amara"],"options":[{"bs":"naređuje vam","en":"he/it commands you (all)"},{"bs":"savjetujete (naređujete)","en":"you advise (command)"},{"bs":"naređujete nam","en":"you (all) command us"},{"bs":"naređuju","en":"they command"}],"ref":"2:93","answerWord":"يَأْمُرُكُم","answerSound":"audio/ea8ef0da8d854a7e9a2a.m4a","quranTranslation":{"text":"And when We made with you a covenant and caused the Mount to tower above you, (saying): Hold fast by that which We have given you, and hear (Our Word), they said: We hear and we rebel. And (worship of) the calf was made to sink into their hearts because of their rejection (of the covenant). Say (unto them): Evil is that which your belief enjoineth on you, if ye are believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["وَإِذْ","أَخَذْنَا","مِيثَٰقَكُمْ","وَرَفَعْنَا","فَوْقَكُمُ","ٱلطُّورَ","خُذُوا۟","مَآ","ءَاتَيْنَٰكُم","بِقُوَّةٍ","وَٱسْمَعُوا۟","قَالُوا۟","سَمِعْنَا","وَعَصَيْنَا","وَأُشْرِبُوا۟","فِى","قُلُوبِهِمُ","ٱلْعِجْلَ","بِكُفْرِهِمْ","قُلْ","بِئْسَمَا","يَأْمُرُكُم","بِهِۦٓ","إِيمَٰنُكُمْ","إِن","كُنتُم","مُّؤْمِنِينَ"],"marked":[21],"facts":{"verb":"أَمَرَ"}},{"id":"amara-4-119-2","words":["verb:amara"],"options":[{"bs":"i zaista ću im narediti","en":"and surely I will command them"},{"bs":"naređeno ti je","en":"you were commanded"},{"bs":"naredio si mi","en":"you commanded me"},{"bs":"naredio mu je","en":"he/it commanded him"}],"ref":"4:119","answerWord":"وَلَءَامُرَنَّهُمْ","answerSound":"audio/bde3fcda3569b63617a3.m4a","quranTranslation":{"text":"And surely I will lead them astray, and surely I will arouse desires in them, and surely I will command them and they will cut the cattle' ears, and surely I will command them and they will change Allah's creation. Whoso chooseth Satan for a patron instead of Allah is verily a loser and his loss is manifest.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["وَلَأُضِلَّنَّهُمْ","وَلَأُمَنِّيَنَّهُمْ","وَلَءَامُرَنَّهُمْ","فَلَيُبَتِّكُنَّ","ءَاذَانَ","ٱلْأَنْعَٰمِ","وَلَءَامُرَنَّهُمْ","فَلَيُغَيِّرُنَّ","خَلْقَ","ٱللَّهِ","وَمَن","يَتَّخِذِ","ٱلشَّيْطَٰنَ","وَلِيًّا","مِّن","دُونِ","ٱللَّهِ","فَقَدْ","خَسِرَ","خُسْرَانًا","مُّبِينًا"],"marked":[2,6],"facts":{"verb":"أَمَرَ"}},{"id":"amara-11-112-2","words":["verb:amara"],"options":[{"bs":"naređeno ti je","en":"you were commanded"},{"bs":"i naređeno mi je","en":"and I was commanded"},{"bs":"i naređuje vam","en":"and he/it commands you (all)"},{"bs":"naređuje vam se","en":"you (all) are commanded"}],"ref":"11:112","answerWord":"أُمِرْتَ","answerSound":"audio/e8acf4eff96a0524a7e3.m4a","quranTranslation":{"text":"So tread thou the straight path as thou art commanded, and those who turn (unto Allah) with thee, and transgress not. Lo! He is Seer of what ye do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["فَٱسْتَقِمْ","كَمَآ","أُمِرْتَ","وَمَن","تَابَ","مَعَكَ","وَلَا","تَطْغَوْا۟","إِنَّهُۥ","بِمَا","تَعْمَلُونَ","بَصِيرٌ"],"marked":[2],"facts":{"verb":"أَمَرَ"}},{"id":"amara-12-68-4","words":["verb:amara"],"options":[{"bs":"naredio im je","en":"he/it commanded them"},{"bs":"naredio mu je","en":"he/it commanded him"},{"bs":"naređeno im je","en":"they were commanded"},{"bs":"i naredili su","en":"and they commanded"}],"ref":"12:68","answerWord":"أَمَرَهُمْ","answerSound":"audio/d8c893e0e4bbc57f39ba.m4a","quranTranslation":{"text":"And when they entered in the manner which their father had enjoined, it would have naught availed them as against Allah; it was but a need of Jacob's soul which he thus satisfied; and lo! he was a lord of knowledge because We had taught him; but most of mankind know not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["وَلَمَّا","دَخَلُوا۟","مِنْ","حَيْثُ","أَمَرَهُمْ","أَبُوهُم","مَّا","كَانَ","يُغْنِى","عَنْهُم","مِّنَ","ٱللَّهِ","مِن","شَىْءٍ","إِلَّا","حَاجَةً","فِى","نَفْسِ","يَعْقُوبَ","قَضَىٰهَا","وَإِنَّهُۥ","لَذُو","عِلْمٍ","لِّمَا","عَلَّمْنَٰهُ","وَلَٰكِنَّ","أَكْثَرَ","ٱلنَّاسِ","لَا","يَعْلَمُونَ"],"marked":[4],"facts":{"verb":"أَمَرَ"}},{"id":"amara-16-50-6","words":["verb:amara"],"options":[{"bs":"naređuje im se","en":"they are commanded"},{"bs":"i naređuj!","en":"and enjoin!"},{"bs":"naredio mu je","en":"he/it commanded him"},{"bs":"naređuje","en":"he/it commands"}],"ref":"16:50","answerWord":"يُؤْمَرُونَ","answerSound":"audio/6d2293c288354955358f.m4a","quranTranslation":{"text":"They fear their Lord above them, and do what they are bidden.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["يَخَافُونَ","رَبَّهُم","مِّن","فَوْقِهِمْ","وَيَفْعَلُونَ","مَا","يُؤْمَرُونَ"],"marked":[6],"facts":{"verb":"أَمَرَ"}},{"id":"amara-2-44-0","words":["verb:amara"],"options":[{"bs":"zar naređujete?","en":"do you (all) command?"},{"bs":"i zaista ću im narediti","en":"and surely I will command them"},{"bs":"naredio mu je","en":"he/it commanded him"},{"bs":"naređuju","en":"they command"}],"ref":"2:44","answerWord":"أَتَأْمُرُونَ","answerSound":"audio/b206ad45e7113715d096.m4a","quranTranslation":{"text":"Enjoin ye righteousness upon mankind while ye yourselves forget (to practise it)? And ye are readers of the Scripture! Have ye then no sense?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["أَتَأْمُرُونَ","ٱلنَّاسَ","بِٱلْبِرِّ","وَتَنسَوْنَ","أَنفُسَكُمْ","وَأَنتُمْ","تَتْلُونَ","ٱلْكِتَٰبَ","أَفَلَا","تَعْقِلُونَ"],"marked":[0],"facts":{"verb":"أَمَرَ"}},{"id":"amara-2-222-19","words":["verb:amara"],"options":[{"bs":"naredio vam je","en":"he/it commanded you (all)"},{"bs":"naredio im je","en":"he/it commanded them"},{"bs":"zar naređujete?","en":"do you (all) command?"},{"bs":"zar vam naređuje?","en":"does he/it command you (all)?"}],"ref":"2:222","answerWord":"أَمَرَكُمُ","answerSound":"audio/fa118ae36afb0c14e2f7.m4a","quranTranslation":{"text":"They question thee (O Muhammad) concerning menstruation. Say: It is an illness, so let women alone at such times and go not in unto them till they are cleansed. And when they have purified themselves, then go in unto them as Allah hath enjoined upon you. Truly Allah loveth those who turn unto Him, and loveth those who have a care for cleanness.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["وَيَسْـَٔلُونَكَ","عَنِ","ٱلْمَحِيضِ","قُلْ","هُوَ","أَذًى","فَٱعْتَزِلُوا۟","ٱلنِّسَآءَ","فِى","ٱلْمَحِيضِ","وَلَا","تَقْرَبُوهُنَّ","حَتَّىٰ","يَطْهُرْنَ","فَإِذَا","تَطَهَّرْنَ","فَأْتُوهُنَّ","مِنْ","حَيْثُ","أَمَرَكُمُ","ٱللَّهُ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلتَّوَّٰبِينَ","وَيُحِبُّ","ٱلْمُتَطَهِّرِينَ"],"marked":[19],"facts":{"verb":"أَمَرَ"}},{"id":"amara-2-268-3","words":["verb:amara"],"options":[{"bs":"i naređuje vam","en":"and he/it commands you (all)"},{"bs":"naređeno im je","en":"they were commanded"},{"bs":"naređuje vam se","en":"you (all) are commanded"},{"bs":"savjetujete (naređujete)","en":"you advise (command)"}],"ref":"2:268","answerWord":"وَيَأْمُرُكُم","answerSound":"audio/fbd77c066f72ef942d8c.m4a","quranTranslation":{"text":"The devil promiseth you destitution and enjoineth on you lewdness. But Allah promiseth you forgiveness from Himself with bounty. Allah is All-Embracing, All-knowing.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["ٱلشَّيْطَٰنُ","يَعِدُكُمُ","ٱلْفَقْرَ","وَيَأْمُرُكُم","بِٱلْفَحْشَآءِ","وَٱللَّهُ","يَعِدُكُم","مَّغْفِرَةً","مِّنْهُ","وَفَضْلًا","وَٱللَّهُ","وَٰسِعٌ","عَلِيمٌ"],"marked":[3],"facts":{"verb":"أَمَرَ"}},{"id":"amara-3-80-1","words":["verb:amara"],"options":[{"bs":"naređuje vam","en":"he/it commands you (all)"},{"bs":"naređeno mi je","en":"I was commanded"},{"bs":"naređuješ","en":"you command"},{"bs":"naređuje vam se","en":"you (all) are commanded"}],"ref":"3:80","answerWord":"يَأْمُرَكُمْ","answerSound":"audio/6044d85307836e94c0d2.m4a","quranTranslation":{"text":"And he commanded you not that ye should take the angels and the prophets for lords. Would he command you to disbelieve after ye had surrendered (to Allah)?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"narediti","en":"to command"},"passage":["وَلَا","يَأْمُرَكُمْ","أَن","تَتَّخِذُوا۟","ٱلْمَلَٰٓئِكَةَ","وَٱلنَّبِيِّۦنَ","أَرْبَابًا","أَيَأْمُرُكُم","بِٱلْكُفْرِ","بَعْدَ","إِذْ","أَنتُم","مُّسْلِمُونَ"],"marked":[1],"facts":{"verb":"أَمَرَ"}},{"id":"kada-2-7-195-23","words":["verb:kada-2"],"options":[{"bs":"spletkarite protiv mene!","en":"(you all) plot against me!"},{"bs":"smislili smo","en":"we devised"},{"bs":"pa spletkare","en":"so they plot"},{"bs":"i spletkarim","en":"and I plot"}],"ref":"7:195","answerWord":"كِيدُونِ","answerSound":"audio/f787d453ac8c99f5c6ee.m4a","quranTranslation":{"text":"Have they feet wherewith they walk, or have they hands wherewith they hold, or have they eyes wherewith they see, or have they ears wherewith they hear? Say: Call upon your (so-called) partners (of Allah), and then contrive against me, spare me not!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["أَلَهُمْ","أَرْجُلٌ","يَمْشُونَ","بِهَآ","أَمْ","لَهُمْ","أَيْدٍ","يَبْطِشُونَ","بِهَآ","أَمْ","لَهُمْ","أَعْيُنٌ","يُبْصِرُونَ","بِهَآ","أَمْ","لَهُمْ","ءَاذَانٌ","يَسْمَعُونَ","بِهَا","قُلِ","ٱدْعُوا۟","شُرَكَآءَكُمْ","ثُمَّ","كِيدُونِ","فَلَا","تُنظِرُونِ"],"marked":[23],"facts":{"verb":"كَادَ"}},{"id":"kada-2-12-5-7","words":["verb:kada-2"],"options":[{"bs":"pa spletkare","en":"so they plot"},{"bs":"zaista ću spletkariti","en":"surely I will plot"},{"bs":"smislili smo","en":"we devised"},{"bs":"spletkarite protiv mene!","en":"(you all) plot against me!"}],"ref":"12:5","answerWord":"فَيَكِيدُوا۟","answerSound":"audio/6ef8cfbb8af42eedbddc.m4a","quranTranslation":{"text":"He said: O my dear son! Tell not thy brethren of thy vision, lest they plot a plot against thee. Lo! Satan is for man an open foe.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["قَالَ","يَٰبُنَىَّ","لَا","تَقْصُصْ","رُءْيَاكَ","عَلَىٰٓ","إِخْوَتِكَ","فَيَكِيدُوا۟","لَكَ","كَيْدًا","إِنَّ","ٱلشَّيْطَٰنَ","لِلْإِنسَٰنِ","عَدُوٌّ","مُّبِينٌ"],"marked":[7],"facts":{"verb":"كَادَ"}},{"id":"kada-2-21-57-1","words":["verb:kada-2"],"options":[{"bs":"zaista ću spletkariti","en":"surely I will plot"},{"bs":"smišljaju lukavstvo","en":"they are plotting"},{"bs":"pa smislite lukavstvo protiv Mene","en":"then plot against Me"},{"bs":"smislili smo","en":"we devised"}],"ref":"21:57","answerWord":"لَأَكِيدَنَّ","answerSound":"audio/92da25f1f507369ad072.m4a","quranTranslation":{"text":"And, by Allah, I shall circumvent your idols after ye have gone away and turned your backs.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَتَٱللَّهِ","لَأَكِيدَنَّ","أَصْنَٰمَكُم","بَعْدَ","أَن","تُوَلُّوا۟","مُدْبِرِينَ"],"marked":[1],"facts":{"verb":"كَادَ"}},{"id":"kada-2-77-39-4","words":["verb:kada-2"],"options":[{"bs":"pa smislite lukavstvo protiv Mene","en":"then plot against Me"},{"bs":"smišljaju lukavstvo","en":"they are plotting"},{"bs":"i spletkarim","en":"and I plot"},{"bs":"smislili smo","en":"we devised"}],"ref":"77:39","answerWord":"فَكِيدُونِ","answerSound":"audio/8c0c603b23cf8a901fe1.m4a","quranTranslation":{"text":"If now ye have any wit, outwit Me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["فَإِن","كَانَ","لَكُمْ","كَيْدٌ","فَكِيدُونِ"],"marked":[4],"facts":{"verb":"كَادَ"}},{"id":"kada-2-86-15-1","words":["verb:kada-2"],"options":[{"bs":"smišljaju lukavstvo","en":"they are plotting"},{"bs":"spletkarite protiv mene!","en":"(you all) plot against me!"},{"bs":"zaista ću spletkariti","en":"surely I will plot"},{"bs":"smislili smo","en":"we devised"}],"ref":"86:15","answerWord":"يَكِيدُونَ","answerSound":"audio/093acc701a8dc6c2c3bb.m4a","quranTranslation":{"text":"Lo! they plot a plot (against thee, O Muhammad)","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["إِنَّهُمْ","يَكِيدُونَ","كَيْدًا"],"marked":[1],"facts":{"verb":"كَادَ"}},{"id":"kada-2-86-16-0","words":["verb:kada-2"],"options":[{"bs":"i spletkarim","en":"and I plot"},{"bs":"smislili smo","en":"we devised"},{"bs":"pa smislite lukavstvo protiv Mene","en":"then plot against Me"},{"bs":"smišljaju lukavstvo","en":"they are plotting"}],"ref":"86:16","answerWord":"وَأَكِيدُ","answerSound":"audio/e1f2cbb953f89665c1ed.m4a","quranTranslation":{"text":"And I plot a plot (against them).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spletkariti, smišljati lukavstvo","en":"to plot, to scheme"},"passage":["وَأَكِيدُ","كَيْدًا"],"marked":[0],"facts":{"verb":"كَادَ"}}]