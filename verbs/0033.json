 "quran": false, "notUsed": false, "spoken": "audio/6d97727f9497ed81f45f.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antuma", "arabic": "تَذْكُرَانِ", "plain": "تَذْكُرَانِ", "quran": false, "notUsed": false, "spoken": "audio/e1489f9e584f87c52422.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antum", "arabic": "تَذْكُرُونَ", "plain": "تَذْكُرُونَ", "quran": true, "notUsed": false, "spoken": "audio/25173a9b6fda02a26408.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "antunna", "arabic": "تَذْكُرْنَ", "plain": "تَذْكُرْنَ", "quran": false, "notUsed": false, "spoken": "audio/ad1a74f8e1a5ca6692eb.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَذْكُرُ", "plain": "يَذْكُرُ", "quran": true, "notUsed": false, "spoken": "audio/5aa41882aed495608260.m4a", "recited": "audio/8892d7ae4c863001931e.m4a", "recitedText": "يَذْكُرُ"}, {"tense": "present", "pronoun": "hiya", "arabic": "تَذْكُرُ", "plain": "تَذْكُرُ", "quran": false, "notUsed": false, "spoken": "audio/7fe941a1b997fb72b013.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يَذْكُرَانِ", "plain": "يَذْكُرَانِ", "quran": false, "notUsed": false, "spoken": "audio/a90bd3ed2b817b3168a6.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَذْكُرُونَ", "plain": "يَذْكُرُونَ", "quran": true, "notUsed": false, "spoken": "audio/7ea6fad1c4a55ea40868.m4a", "recited": "audio/367f96d81f55aee31f06.m4a", "recitedText": "يَذْكُرُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَذْكُرْنَ", "plain": "يَذْكُرْنَ", "quran": false, "notUsed": false, "spoken": "audio/b9dcde45dfc998a392bd.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱذْكُرْ", "plain": "اُذْكُرْ", "quran": true, "notUsed": false, "spoken": "audio/cb79459c7c56d12ab150.m4a", "recited": "audio/af1c30c4ce0bd7a133b3.m4a", "recitedText": "ٱذْكُرْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اُذْكُرِي", "plain": "اُذْكُرِي", "quran": false, "notUsed": false, "spoken": "audio/8454089aff7e9178a2db.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اُذْكُرَا", "plain": "اُذْكُرَا", "quran": false, "notUsed": false, "spoken": "audio/3a3b9468f32f60fb641b.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱذْكُرُوا۟", "plain": "اُذْكُرُوا", "quran": true, "notUsed": false, "spoken": "audio/cee8de48495f62155b14.m4a", "recited": "audio/8bc561e1733b20c55cb6.m4a", "recitedText": "ٱذْكُرُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "ٱذْكُرْنَ", "plain": "اُذْكُرْنَ", "quran": true, "notUsed": false, "spoken": "audio/5eaf05886b3ce7e33086.m4a", "recited": "audio/71d391991b37b9f480ea.m4a", "recitedText": "وَٱذْكُرْنَ"}], "ayat": [{"ref": "2:152", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/159.mp3", "translation": {"en": {"text": "Therefore remember Me, I will remember you. Give thanks to Me, and reject not Me.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O halde beni anın, ben de sizi anayım. Bana şükredin de nankörlük etmeyin.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو میری یاد کرو میں تمہارا چرچا کروں گا اور میرا حق مانو اور میری ناشکری نہ کرو-", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Karena itu, ingatlah kamu kepada-Ku niscaya Aku ingat (pula) kepadamu, dan bersyukurlah kepada-Ku, dan janganlah kamu mengingkari (nikmat)-Ku.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَٱذْكُرُونِىٓ", "hit": true, "audio": "audio/0d88e741a3d61fa3a766.m4a", "gloss": {"en": "so (you all) remember me!", "bs": "pa me spomenite!", "tr": "böylece beni hatırlayın!", "fr": "souvenez-vous donc de moi !", "id": "maka ingatlah aku!", "ur": "پس مجھے یاد کرو!", "bn": "অতএব তোমরা আমাকে স্মরণ কর!", "fa": "پس مرا یاد کنید!"}}, {"text": "أَذْكُرْكُمْ", "hit": true, "audio": "audio/774beb242e0ee0e735b6.m4a", "gloss": {"en": "I remember you (all)", "bs": "spominjem vas", "tr": "sizi hatırlarım", "fr": "je vous mentionne", "id": "aku mengingat kalian", "ur": "میں تم سب کو یاد کروں", "bn": "আমি তোমাদের স্মরণ করি", "fa": "شما را یاد کنم"}}, {"text": "وَٱشْكُرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَكْفُرُونِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "76:25", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5616.mp3", "translation": {"en": {"text": "Remember the name of thy Lord at morn and evening.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sabahakşam Rabbinin ismini an.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اپنے رب کا نام صبح و شام یاد کرو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sebutlah nama Tuhanmu pada (waktu) pagi dan petang.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱذْكُرِ", "hit": true, "audio": "audio/bc4760f69947a1428ce2.m4a", "gloss": {"bs": "i spominji!", "en": "and remember!", "tr": "ve an!", "fr": "et invoque / mentionne !", "id": "dan ingatlah!", "ur": "اور یاد کرو!", "bn": "এবং স্মরণ করো!", "fa": "و یاد کن!"}}, {"text": "ٱسْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّكَ", "hit": false, "audio": null, "gloss": null}, {"text": "بُكْرَةً", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَصِيلًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "37:13", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3801.mp3", "translation": {"en": {"text": "And heed not when they are reminded,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kendilerine hatırlatıldığında da düşünmüyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور سمجھائے نہیں سمجھتے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan apabila mereka diberi pelajaran mereka tiada mengingatnya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "ذُكِّرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَذْكُرُونَ", "hit": true, "audio": "audio/367f96d81f55aee31f06.m4a", "gloss": {"bs": "(ne) opamete se", "en": "they (do not) take heed", "tr": "(öğüt) alırlar", "fr": "ils (ne) se rappellent (pas)", "id": "mereka (tidak) mengambil pelajaran", "ur": "وہ (نصیحت) نہیں پکڑتے", "bn": "তারা (উপদেশ) গ্রহণ করে না", "fa": "پند می‌گیرند"}}]}, {"ref": "74:55", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5550.mp3", "translation": {"en": {"text": "So whosoever will may heed.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Dileyen onu düşünür.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو جو چاہے اس سے نصیحت لے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka barangsiapa menghendaki, niscaya dia mengambil pelajaran daripadanya (Al Quran).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "شَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "ذَكَرَهُۥ", "hit": true, "audio": "audio/54d08306f14e7a7e8864.m4a", "gloss": {"bs": "sjeti ga se", "en": "remembers it", "tr": "onu hatırlar", "fr": "s'en souvient", "id": "mengingatnya", "ur": "وہ اسے یاد کرتا ہے", "bn": "তাকে স্মরণ করে", "fa": "آن را یاد می‌کند"}}]}, {"ref": "40:44", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4177.mp3", "translation": {"en": {"text": "And ye will remember what I say unto you. I confide my cause unto Allah. Lo! Allah is Seer of (His) slaves.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Siz benim söylediklerimi sonra anlayacaksınız. Ben işimi Allah'a havale ediyorum. Şüphesiz Allah, kullarını görür, gözetir.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو جلد وہ وقت آتا ہے کہ جو میں تم سے کہہ رہا ہوں، اسے یاد کرو گے اور میں اپنے کام اللہ کو سونپتا ہوں، بیشک اللہ بندوں کو دیکھتا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kelak kamu akan ingat kepada apa yang kukatakan kepada kamu. Dan aku menyerahkan urusanku kepada Allah. Sesungguhnya Allah Maha Melihat akan hamba-hamba-Nya\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَسَتَذْكُرُونَ", "hit": true, "audio": "audio/47ec063d5582f1b55ae5.m4a", "gloss": {"en": "so you (all) will remember", "bs": "pa ćete se sjetiti", "tr": "böylece hatırlayacaksınız", "fr": "alors vous vous souviendrez", "id": "maka kalian akan ingat", "ur": "پس تم یاد کرو گے", "bn": "অতএব তোমরা স্মরণ করবে", "fa": "پس یاد خواهید کرد"}}, {"text": "مَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَقُولُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأُفَوِّضُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْرِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "بَصِيرٌۢ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱلْعِبَادِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:60", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2543.mp3", "translation": {"en": {"text": "They said: We heard a youth make mention of them, who is called Abraham.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Bazıları) \"İbrahim denen bir gencin, onları diline doladığını duymuştuk\" dediler.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ان میں کے کچھ بولے ہم نے ایک جوان کو انہیں برا کہتے سنا جسے ابراہیم کہتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka berkata: \"Kami dengar ada seorang pemuda yang mencela berhala-berhala ini yang bernama Ibrahim\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "سَمِعْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَتًى", "hit": false, "audio": null, "gloss": null}, {"text": "يَذْكُرُهُمْ", "hit": true, "audio": "audio/67730b6bcb084c3f1df4.m4a", "gloss": {"en": "he/it mentions them", "bs": "spominje ih", "tr": "onları zikreder", "fr": "il les mentionne", "id": "dia menyebut mereka", "ur": "وہ انہیں یاد کرتا ہے", "bn": "সে তাদের উল্লেখ করে", "fa": "آنان را یاد می‌کند"}}, {"text": "يُقَالُ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِبْرَٰهِيمُ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَٱذْكُرْ", "count": 10, "first": "19:16", "audio": "audio/5dca3929395297ecbd7e.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "and mention!", "bs": "i spomeni!", "tr": "ve zikret!", "fr": "et rappelle-toi !", "id": "dan sebutlah!", "ur": "اور یاد کر!", "bn": "এবং স্মরণ কর!", "fa": "و یاد کن!"}}, {"arabic": "ٱذْكُرُوا۟", "count": 9, "first": "2:40", "audio": "audio/8bc561e1733b20c55cb6.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "(you all) remember!", "bs": "sjetite se!", "tr": "hatırlayın!", "fr": "souvenez-vous !", "id": "ingatlah kalian!", "ur": "یاد کرو!", "bn": "তোমরা স্মরণ কর!", "fa": "یاد کنید!"}}, {"arabic": "وَٱذْكُرُوا۟", "count": 9, "first": "2:63", "audio": "audio/898f9532e30780188525.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) remember!", "bs": "i sjetite se!", "tr": "ve hatırlayın!", "fr": "et souvenez-vous !", "id": "dan ingatlah kalian!", "ur": "اور یاد کرو!", "bn": "এবং তোমরা স্মরণ কর!", "fa": "و یاد کنید!"}}, {"arabic": "ذُكِرَ", "count": 6, "first": "6:118", "audio": "audio/eb7e37989020fda1c8d4.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": true, "objects": []}], "gloss": {"en": "he/it was mentioned", "bs": "spomenut je", "tr": "zikredildi", "fr": "il a été mentionné", "id": "disebutkan", "ur": "اُس کا ذکر کیا گیا", "bn": "তার উল্লেখ করা হয়েছে", "fa": "یاد شد"}}, {"arabic": "فَٱذْكُرُوا۟", "count": 5, "first": "2:198", "audio": "audio/3d3e911343c5ffe2b3f0.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) remember!", "bs": "pa se sjetite!", "tr": "böylece hatırlayın!", "fr": "souvenez-vous donc !", "id": "maka ingatlah kalian!", "ur": "پس یاد کرو!", "bn": "অতএব তোমরা স্মরণ কর!", "fa": "پس یاد کنید!"}}, {"arabic": "يَذْكُرُونَ", "count": 5, "first": "3:191", "audio": "audio/367f96d81f55aee31f06.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "(ne) opamete se", "en": "they (do not) take heed", "tr": "(öğüt) alırlar", "fr": "ils (ne) se rappellent (pas)", "id": "mereka (tidak) mengambil pelajaran", "ur": "وہ (نصیحت) نہیں پکڑتے", "bn": "তারা (উপদেশ) গ্রহণ করে না", "fa": "پند می‌گیرند"}}, {"arabic": "وَٱذْكُرُوٓا۟", "count": 4, "first": "7:69", "audio": "audio/6385b007c75b2535a84d.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) remember!", "bs": "i sjetite se!", "tr": "ve hatırlayın!", "fr": "et souvenez-vous !", "id": "dan ingatlah kalian!", "ur": "اور یاد کرو!", "bn": "এবং তোমরা স্মরণ কর!", "fa": "و یاد کنید!"}}, {"arabic": "وَٱذْكُر", "count": 3, "first": "3:41", "audio": "audio/4773713312812e0097c2.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "and remember!", "bs": "i sjeti se!", "tr": "ve hatırla!", "fr": "et souviens-toi !", "id": "dan ingatlah!", "ur": "اور یاد کر!", "bn": "এবং স্মরণ কর!", "fa": "و یاد کن!"}}, {"arabic": "فَٱذْكُرُوٓا۟", "count": 2, "first": "7:69", "audio": "audio/9af37517651b2bea64b7.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) remember!", "bs": "pa se sjetite!", "tr": "böylece hatırlayın!", "fr": "souvenez-vous donc !", "id": "maka ingatlah kalian!", "ur": "پس یاد کرو!", "bn": "অতএব তোমরা স্মরণ কর!", "fa": "پس یاد کنید!"}}, {"arabic": "يَذْكُرُ", "count": 2, "first": "19:67", "audio": "audio/8892d7ae4c863001931e.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it remembers", "bs": "sjeća se", "tr": "hatırlar", "fr": "il se souvient", "id": "dia mengingat", "ur": "وہ یاد کرتا ہے", "bn": "সে স্মরণ করে", "fa": "یاد می‌کند"}}, {"arabic": "وَذَكَرَ", "count": 2, "first": "33:21", "audio": "audio/72fb10925018dbeeb67e.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"en": "and he/it remembered", "bs": "i sjetio se", "tr": "ve hatırladı", "fr": "et il se souvint", "id": "dan dia mengingat", "ur": "اور اُس نے یاد کیا", "bn": "এবং সে স্মরণ করল", "fa": "و یاد کرد"}}, {"arabic": "وَٱذْكُرِ", "count": 2, "first": "73:8", "audio": "audio/8fd864552db3a948f901.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"bs": "i spominji!", "en": "and remember!", "tr": "ve an!", "fr": "et invoque / mentionne !", "id": "dan ingatlah!", "ur": "اور یاد کرو!", "bn": "এবং স্মরণ করো!", "fa": "و یاد کن!"}}, {"arabic": "ذَكَرَهُۥ", "count": 2, "first": "74:55", "audio": "audio/54d08306f14e7a7e8864.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": ["huwa"]}], "gloss": {"bs": "sjeti ga se", "en": "remembers it", "tr": "onu hatırlar", "fr": "s'en souvient", "id": "mengingatnya", "ur": "وہ اسے یاد کرتا ہے", "bn": "তাকে স্মরণ করে", "fa": "آن را یاد می‌کند"}}, {"arabic": "يُذْكَرَ", "count": 1, "first": "2:114", "audio": "audio/3a3aa8f0fdc34d809b48.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": true, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "he/it is mentioned", "bs": "biva spomenut", "tr": "zikredilir", "fr": "il est mentionné", "id": "disebut", "ur": "اُس کا ذکر کیا جائے", "bn": "তার উল্লেখ করা হয়", "fa": "یاد شود"}}, {"arabic": "فَٱذْكُرُونِىٓ", "count": 1, "first": "2:152", "audio": "audio/0d88e741a3d61fa3a766.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": ["ana"]}], "gloss": {"en": "so (you all) remember me!", "bs": "pa me spomenite!", "tr": "böylece beni hatırlayın!", "fr": "souvenez-vous donc de moi !", "id": "maka ingatlah aku!", "ur": "پس مجھے یاد کرو!", "bn": "অতএব তোমরা আমাকে স্মরণ কর!", "fa": "پس مرا یاد کنید!"}}, {"arabic": "أَذْكُرْكُمْ", "count": 1, "first": "2:152", "audio": "audio/7