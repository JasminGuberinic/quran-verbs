{"rank": 59, "root": "صبر", "form": 1, "lemma": "صَبَرَ", "count": 58, "ayahCount": 56, "share": 0.3, "meaning": {"bs": "strpjeti se, izdržati", "en": "to be patient, to endure", "tr": "sabretmek, dayanmak", "fr": "être patient, endurer", "id": "bersabar, bertahan", "ur": "صبر کرنا، برداشت کرنا", "bn": "ধৈর্য ধারণ করা, সবর করা", "fa": "صبر کردن، تحمل کردن"}, "lemmaSpoken": "audio/b9bb1eff57da7d66eaf0.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "صَبَرَ", "plain": "صَبَرَ", "quran": true, "notUsed": false, "spoken": "audio/b9bb1eff57da7d66eaf0.m4a", "recited": "audio/f7e9f60bdb00221f30af.m4a", "recitedText": "صَبَرَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَصْبِرُ", "plain": "يَصْبِرُ", "quran": false, "notUsed": false, "spoken": "audio/d172109560651e39d027.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱصْبِرْ", "plain": "اِصْبِرْ", "quran": true, "notUsed": false, "spoken": "audio/6e2d8cf9a7ce81a1b706.m4a", "recited": "audio/8c25c70bf4de5efc09f1.m4a", "recitedText": "ٱصْبِرْ"}], "nouns": {"participle": {"lemma": "صابِر", "count": 20, "spoken": "audio/44209ed6acedd7ec6c5c.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "صَبَرْتُ", "plain": "صَبَرْتُ", "quran": false, "notUsed": false, "spoken": "audio/7641d5ab632eae5867c5.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "صَبَرْنَا", "plain": "صَبَرْنَا", "quran": true, "notUsed": false, "spoken": "audio/0b9d0c17c2737a350c4a.m4a", "recited": "audio/c90f7a65477ecf227a68.m4a", "recitedText": "صَبَرْنَا"}, {"tense": "past", "pronoun": "anta", "arabic": "صَبَرْتَ", "plain": "صَبَرْتَ", "quran": false, "notUsed": false, "spoken": "audio/fdbb8e735e236fe4a6d4.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "صَبَرْتِ", "plain": "صَبَرْتِ", "quran": false, "notUsed": false, "spoken": "audio/35e622f1843f8e65b3cd.m4a", "recited": null, "re