": []}]}], "ayatFile": "ayat/0124.json", "ayatTranslations": {"en": "ayat/0124.en.json", "tr": "ayat/0124.tr.json", "ur": "ayat/0124.ur.json", "id": "ayat/0124.id.json"}, "sentences": [{"arabic": "عَسَيْتُمْ أَنْ تَنْجَحُوا", "spoken": "audio/580a17aa60416f38171a.m4a", "tense": "past", "pronoun": "antum", "translation": {"bs": "Možda ćete uspjeti.", "en": "Perhaps you will succeed.", "bn": "হয়তো তোমরা সফল হবে।", "fa": "شاید موفق شوید.", "fr": "Peut-être réussirez-vous.", "id": "Semoga kalian berhasil.", "tr": "Belki başarırsınız.", "ur": "شاید تم کامیاب ہو جاؤ۔"}, "independentlyReviewed": true, "words": [{"arabic": "عَسَيْتُمْ", "target": true, "translation": {"bs": "možda vi", "en": "perhaps you", "bn": "হয়তো তোমরা", "fa": "شاید شما", "fr": "peut-être que vous", "id": "semoga kalian", "tr": "belki siz", "ur": "شاید تم"}}, {"arabic": "أَنْ", "target": false, "translation": {"bs": "da", "en": "that", "bn": "সেটা", "fa": "که", "fr": "que", "id": "bahwa", "tr": "-mekten", "ur": "کہ"}}, {"arabic": "تَنْجَحُوا", "target": false, "translation": {"bs": "uspijete", "en": "succeed", "bn": "সফল হও", "fa": "موفق شوید", "fr": "réussissiez", "id": "berhasil", "tr": "başarırsın", "ur": "کامیاب ہو جاؤ"}}]}, {"arabic": "عَسَى أَنْ يَنْزِلَ الْمَطَرُ", "spoken": "audio/83efa3cf11ae2e72bfbf.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Možda padne kiša.", "en": "Perhaps the rain will come down.", "bn": "হয়তো বৃষ্টি নেমে আসবে।", "fa": "شاید باران ببارد.", "fr": "Peut-être que la pluie tombera.", "id": "Semoga hujan turun.", "tr": "Belki yağmur yağar.", "ur": "شاید بارش برس جائے۔"}, "independentlyReviewed": true, "words": [{"arabic": "عَسَى", "target": true, "translation": {"bs": "možda", "en": "perhaps", "bn": "হয়তো", "fa": "شاید", "fr": "peut-être", "id": "semoga", "tr": "belki", "ur": "شاید"}}, {"arabic": "أَنْ", "target": false, "translation": {"bs": "da", "en": "that", "bn": "সেটা", "fa": "که", "fr": "que", "id": "bahwa", "tr": "-mekten", "ur": "کہ"}}, {"ara