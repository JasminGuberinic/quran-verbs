a RI, via tanzil.net"}}, "words": [{"text": "أَرْسِلْهُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَعَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "غَدًا", "hit": false, "audio": null, "gloss": null}, {"text": "يَرْتَعْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَلْعَبْ", "hit": true, "audio": "audio/23f732d395df19c9907d.m4a", "gloss": {"en": "and he/it plays", "bs": "i igra se", "tr": "oynar", "fr": "et il joue", "id": "dan dia bermain", "ur": "اور وہ کھیلتا ہے", "bn": "এবং সে খেলা করে", "fa": "و بازی کند"}}, {"text": "وَإِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "لَحَٰفِظُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَلْعَبُونَ", "count": 5, "first": "6:91", "audio": "audio/3677268234d6576e4709.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"bs": "igraju se", "en": "they play", "tr": "oynarlar", "fr": "ils jouent", "id": "mereka bermain", "ur": "وہ کھیلتے ہیں", "bn": "তারা খেলা করে", "fa": "بازی می‌کنند"}}, {"arabic": "وَيَلْعَبُوا۟", "count": 2, "first": "43:83", "audio": "audio/5e41ca4456faefee3838.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "subjunctive"}, {"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "and they play", "bs": "i igraju se", "tr": "oynarlar", "fr": "qu'ils jouent", "id": "dan mereka bermain", "ur": "اور وہ کھیلتے ہیں", "bn": "এবং তারা খেলা করে", "fa": "و بازی کنند"}}, {"arabic": "وَنَلْعَبُ", "count": 1, "first": "9:65", "audio": "audio/985ce59f88bda0b8a6f7.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "and we play", "bs": "i igramo se", "tr": "oynarız", "fr": "et nous jouons", "id": "dan kami bermain", "ur": "اور 