{"ayat":[{"ref":"111:1","number":6217,"text":"تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ","hits":[1,2]},{"ref":"111:2","number":6218,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","hits":[0,1,2,3,5]},{"ref":"111:3","number":6219,"text":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ","hits":[0,1]},{"ref":"111:4","number":6220,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","hits":[0,2]},{"ref":"111:5","number":6221,"text":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ","hits":[0,2,3]}]}