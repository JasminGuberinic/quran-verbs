41aac1204.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَحْصِنْ", "plain": "أَحْصِنْ", "quran": false, "notUsed": false, "spoken": "audio/3812cb7a90fc126bc128.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَحْصِنِي", "plain": "أَحْصِنِي", "quran": false, "notUsed": false, "spoken": "audio/442e721f1ee810b43c2e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَحْصِنَا", "plain": "أَحْصِنَا", "quran": false, "notUsed": false, "spoken": "audio/f2d94dc626b84354ec3e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَحْصِنُوا", "plain": "أَحْصِنُوا", "quran": false, "notUsed": false, "spoken": "audio/ca6851078d0cf0ee6f1d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَحْصِنَّ", "plain": "أَحْصِنَّ", "quran": false, "notUsed": false, "spoken": "audio/147759a5cb9f9ee972d5.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "21:91", "tense": "past", "category": {"tense": "past", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2574.mp3", "translation": {"en": {"text": "And she who was chaste, therefor We breathed into her (something) of Our Spirit and made her and her son a token for (all) peoples.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Irzını koruyan Meryem'e ruhumuzdan üflemiş, onu ve oğlunu, âlemler için bir mucize kılmıştık.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور اس عورت کو اس نے اپنی پارسائی نگاہ رکھی تو ہم نے اس میں اپنی روح پھونکی اور اسے اور اس کے بیٹے کو سارے جہاں کے لیے نشانی بنایا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan (ingatlah kisah) Maryam yang telah memelihara kehormatannya, lalu Kami tiupkan ke dalam (tubuh)nya ruh dari Kami dan Kami jadikan dia dan anaknya tanda (kekuasaan Allah) yang besar bagi semesta alam.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّتِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَحْصَنَتْ", "hit": true, "audio": "audio/9449b1d4214f7819c143.m4a", "gloss": {"bs": "sačuvala je", "en": "(she) guarded", "tr": "(o) korudu", "fr": "(elle) a gardé", "id": "(dia perempuan) menjaga", "ur": "(اس نے) حفاظت کی", "bn": "(সে) রক্ষা করল", "fa": "(او) حفظ کرد"}}, {"text": "فَرْجَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَنَفَخْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "فِيهَا", "hit": false, "audio": null, "gloss": null}, {"text": "مِن", "hit": false, "audio": null, "gloss": null}, {"text": "رُّوحِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَجَعَلْنَٰهَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱبْنَهَآ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَةً", "hit": false, "audio": null, "gloss": null}, {"text": "لِّلْعَٰلَمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:80", "tense": "present", "category": {"tense": "present", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2563.mp3", "translation": {"en": {"text": "And We taught him the art of making garments (of mail) to protect you in your daring. Are ye then thankful?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ona, sizi savaşta korumak için zırh yapma sanatını öğrettik, artık şükreder misiniz?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے اسے تمہارا ایک پہناوا بنانا سکھایا کہ تمہیں تمہاری آنچ سے (زخمی ہونے سے) بچائے تو کیا تم شکر کروگے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan telah Kami ajarkan kepada Daud membuat baju besi untuk kamu, guna memelihara kamu dalam peperanganmu; Maka hendaklah kamu bersyukur (kepada Allah).", "by": "Kement