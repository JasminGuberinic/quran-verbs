ive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "he/it marries", "bs": "ženi se", "tr": "evlenir", "fr": "il se marie", "id": "dia menikah", "ur": "وہ نکاح کرتا ہے", "bn": "সে বিবাহ করে", "fa": "ازدواج می‌کند"}}, {"arabic": "يَنكِحُهَآ", "count": 1, "first": "24:3", "audio": "audio/8cad1588eb153e74abdb.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": ["hiya"], "mood": "indicative"}], "gloss": {"en": "he/it marries her", "bs": "ženi je", "tr": "onunla evlenir", "fr": "il l'épouse", "id": "dia menikahinya", "ur": "وہ اس سے نکاح کرتا ہے", "bn": "সে তাকে বিবাহ করে", "fa": "با او ازدواج می‌کند"}}, {"arabic": "نَكَحْتُمُ", "count": 1, "first": "33:49", "audio": "audio/84fe59a1b30bbd59e7f8.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) married", "bs": "oženili ste se", "tr": "evlendiniz", "fr": "vous vous êtes mariés", "id": "kalian telah menikah", "ur": "تم نے نکاح کیا", "bn": "তোমরা বিবাহ করেছ", "fa": "ازدواج کردید"}}, {"arabic": "تَنكِحُوٓا۟", "count": 1, "first": "33:53", "audio": "audio/11fe624ee805fd1bdb43.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "you (all) marry", "bs": "ženite se", "tr": "evlenirsiniz", "fr": "que vous vous mariiez", "id": "kalian menikah", "ur": "تم سب نکاح کرتے ہو", "bn": "তোমরা বিবাহ কর", "fa": "ازدواج کنید"}}], "ayatFile": "ayat/0239.json", "ayatTranslations": {"en": "ayat/0239.en.json", "tr": "ayat/0239.tr.json", "ur": "ayat/0239.ur.json", "id": "ayat/0239.id.json"}, "sentences": []}