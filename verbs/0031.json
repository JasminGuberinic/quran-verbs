ُونَ", "plain": "يَفْعَلُونَ", "quran": true, "notUsed": false, "spoken": "audio/076e23ecc68237dbec96.m4a", "recited": "audio/9c0608927f12e7c8bad0.m4a", "recitedText": "يَفْعَلُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَفْعَلْنَ", "plain": "يَفْعَلْنَ", "quran": false, "notUsed": false, "spoken": "audio/00c2a42b214be0c901f8.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱفْعَلْ", "plain": "اِفْعَلْ", "quran": true, "notUsed": false, "spoken": "audio/46d14f683481a9bed9d1.m4a", "recited": "audio/61621c231f55525cadd3.m4a", "recitedText": "ٱفْعَلْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِفْعَلِي", "plain": "اِفْعَلِي", "quran": false, "notUsed": false, "spoken": "audio/9d8229e9d5de70d48f47.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِفْعَلَا", "plain": "اِفْعَلَا", "quran": false, "notUsed": false, "spoken": "audio/7aab16174961c9064b50.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱفْعَلُوا۟", "plain": "اِفْعَلُوا", "quran": true, "notUsed": false, "spoken": "audio/d436b2103d086452bb13.m4a", "recited": "audio/2a5576010dcc6f32f076.m4a", "recitedText": "فَٱفْعَلُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِفْعَلْنَ", "plain": "اِفْعَلْنَ", "quran": false, "notUsed": false, "spoken": "audio/bd9c2d1d2f9a7241e6f6.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "26:226", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3158.mp3", "translation": {"en": {"text": "And how they say that which they do not?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onların her vadide şaşkın şaşkın dolaştıklarını ve gerçekte yapmadıkları şeyleri söylediklerini görmedin mi?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ کہتے ہیں جو نہیں کرتے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan bahwasanya mereka suka mengatakan apa yang mereka sendiri tidak mengerjakan(nya)?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُولُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَفْعَلُونَ", "hit": true, "audio": "audio/b428e98cf702ce43868f.m4a", "gloss": {"en": "they do", "bs": "čine", "tr": "yaparlar", "fr": "ils font", "id": "mereka berbuat", "ur": "وہ کرتے ہیں", "bn": "তারা করে", "fa": "انجام می‌دهند"}}]}, {"ref": "21:23", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2506.mp3", "translation": {"en": {"text": "He will not be questioned as to that which He doeth, but they will be questioned.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O, yaptığından sorumlu olmaz, onlar ise sorumlu tutulacaklardır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس سے نہیں پوچھا جاتا جو وہ کرے اور ان سب سے سوال ہوگا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dia tidak ditanya tentang apa yang diperbuat-Nya dan merekalah yang akan ditanyai.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُسْـَٔلُ", "hit": false, "audio": null, "gloss": null}, {"text": "عَمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَفْعَلُ", "hit": true, "audio": "audio/2bf2f9689444f88b7a80.m4a", "gloss": {"en": "he/it does", "bs": "čini", "tr": "yapar", "fr": "il fait", "id": "dia berbuat", "ur": "وہ کرتا ہے", "bn": "সে করে", "fa": "انجام می‌دهد"}}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُسْـَٔلُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "82:12", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5841.mp3", "translation": {"en": {"text": "Who know (all) that ye do.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onlar, siz her ne yaparsanız bilirler", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جانتے ہیں جو کچھ تم کرو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "mereka mengetahui apa yang kamu kerjakan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَعْلَمُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَفْعَلُونَ", "hit": true, "audio": "audio/2c645c5d89c43da2afed.m4a", "gloss": {"en": "you (all) do", "bs": "činite", "tr": "yapıyorsunuz", "fr": "vous faites", "id": "kalian berbuat", "ur": "تم سب کرتے ہو", "bn": "তোমরা কর", "fa": "انجام می‌دهید"}}]}, {"ref": "54:52", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4898.mp3", "translation": {"en": {"text": "And every thing they did is in the scriptures,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşledikleri her şey, kitaplarda mevcuttur.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور انہوں نے جو کچھ کیا سب کتابوں میں ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan segala sesuatu yang telah mereka perbuat tercatat dalam buku-buku catatan", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَكُلُّ", "hit": false, "audio": null, "gloss": null}, {"text": "شَىْءٍ", "hit": false, "audio": null, "gloss": null}, {"text": "فَعَلُوهُ", "hit": true, "audio": "audio/c553a413073ffadf9a4e.m4a", "gloss": {"bs": "učinili su ga", "en": "they did it", "tr": "onu yaptılar", "fr": "ils l'ont fait", "id": "mereka melakukannya", "ur": "انہوں نے اسے کیا", "bn": "তারা তা করেছিল", "fa": "آن را انجام دادند"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلزُّبُرِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "77:18", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5640.mp3", "translation": {"en": {"text": "Thus deal We ever with the guilty.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz suçlulara böyle yaparız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "مجرموں کے ساتھ ہم ایسا ہی کرتے ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Demikianlah Kami berbuat terhadap orang-orang yang berdosa.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَفْعَلُ", "hit": true, "audio": "audio/f19bd78a35d4efcf5afc.m4a", "gloss": {"bs": "postupamo", "en": "We do (deal)", "tr": "yapıyoruz (davranıyoruz)", "fr": "Nous agissons (ainsi)", "id": "Kami perlakukan", "ur": "ہم کرتے ہیں (معاملہ)", "bn": "আমরা করি", "fa": "انجام می‌دهیم (می‌کنیم)"}}, {"text": "بِٱلْمُجْرِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "22:77", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2672.mp3", "translation": {"en": {"text": "O ye who believe! Bow down and prostrate yourselves, and worship your Lord, and do good, that haply ye may prosper.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey iman edenler! rükû edin, secdeye varın, Rabbinize kulluk edin, iyilik yapın ki kurtulabilesiniz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے ایمان والو! رکوع اور سجدہ کرو اور اپنے رب کی بندگی کرو اور بھلے کام کرو اس امید پر کہ تمہیں چھٹکارا ہو، (السجدة) عندالشافعیؒ،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Hai orang-orang yang beriman, ruku'lah kamu, sujudlah kamu, sembahlah Tuhanmu dan perbuatlah kebajikan, supaya kamu mendapat kemenangan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَٰٓأَيُّهَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "ٱرْكَعُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱسْجُدُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱعْبُدُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "رَبَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱفْعَلُوا۟", "hit": true, "audio": "audio/2935c5546aae4d9233ba.m4a", "gloss": {"bs": "i činite!", "en": "and do!", "tr": "ve yapın!", "fr": "et faites !", "id": "dan berbuatlah!", "ur": "اور کرو!", "bn": "এবং তোমরা করো!", "fa": "و انجام دهید!"}}, {"text": "ٱلْخَيْرَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تُفْلِحُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَفْعَلُونَ", "count": 13, "first": "2:71", "audio": "audio/9c0608927f12e7c8bad0.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they do", "bs": "čine", "tr": "yaparlar", "fr": "ils font", "id": "mereka berbuat", "ur": "وہ کرتے ہیں", "bn": "তারা করে", "fa": "انجام می‌دهند"}}, {"arabic": "تَفْعَلُوا۟", "count": 8, "first": "2:24", "audio": "audio/6bf85a6ae089c5eecfca.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}, {"tense": "present", "pronoun": "antum", "passive