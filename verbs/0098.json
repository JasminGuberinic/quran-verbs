 "recited": "audio/e01e100fe7ff1f6f4a5c.m4a", "recitedText": "يَهْتَدُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَهْتَدِينَ", "plain": "يَهْتَدِينَ", "quran": false, "notUsed": false, "spoken": "audio/345232baa391e6e5b395.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "اِهْتَدِ", "plain": "اِهْتَدِ", "quran": false, "notUsed": false, "spoken": "audio/e3eea753a52bb5909f82.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِهْتَدِي", "plain": "اِهْتَدِي", "quran": false, "notUsed": false, "spoken": "audio/8267e566b806066c74ad.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِهْتَدِيَا", "plain": "اِهْتَدِيَا", "quran": false, "notUsed": false, "spoken": "audio/bf1f24049ed2b9c4f127.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِهْتَدُوا", "plain": "اِهْتَدُوا", "quran": false, "notUsed": false, "spoken": "audio/2665e457b195101e4af7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِهْتَدِينَ", "plain": "اِهْتَدِينَ", "quran": false, "notUsed": false, "spoken": "audio/1e3a7ab36e54a3f23b5e.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "16:16", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1917.mp3", "translation": {"en": {"text": "And landmarks (too), and by the star they find a way.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Daha birçok âlametler yarattı. İnsanlar geceleyin de Allah'ın yarattığı yıldızlarla yönlerini bulurlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور علامتیں اور ستارے سے وہ راہ پاتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dan (Dia ciptakan) tanda-tanda (penunjuk jalan). Dan dengan bintang-bintang itulah mereka mendapat petunjuk.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَعَلَٰمَٰتٍ", "hit": false, "audio": null, "gloss": null}, {"text": "وَبِٱلنَّجْمِ", "hit": false, "audio": null, "gloss": null}, {"text": "هُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَهْتَدُونَ", "hit": true, "audio": "audio/e01e100fe7ff1f6f4a5c.m4a", "gloss": {"bs": "nalaze put", "en": "they are guided", "tr": "hidayet bulurlar", "fr": "ils sont guidés", "id": "mereka mendapat petunjuk", "ur": "وہ ہدایت پاتے ہیں", "bn": "তারা হেদায়াত পায়", "fa": "هدایت می‌شوند"}}]}, {"ref": "2:53", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/60.mp3", "translation": {"en": {"text": "And when We gave unto Moses the Scripture and the criterion (of right and wrong), that ye might be led aright.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve hani bir zamanlar Musa'ya o kitabı ve furkanı verdik, gerekirdi ki, doğru yolda gidesiniz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جب ہم نے موسیٰ کو کتاب عطا کی اور حق و باطل میں تمیز کردینا کہ کہیں تم راہ آؤ -", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan (ingatlah), ketika Kami berikan kepada Musa Al Kitab (Taurat) dan keterangan yang membedakan antara yang benar dan yang salah, agar kamu mendapat petunjuk.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِذْ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَاتَيْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "مُوسَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكِتَٰبَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَٱلْفُرْقَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَهْتَدُونَ", "hit": true, "audio": "audio/563e9ec04688f73697ce.m4a", "gloss": {"en": "you (all) are guided", "bs": "upućeni ste", "tr": "hidayete erdirilirsiniz", "fr": "vous êtes guidés", "id": "kalian mendapat petunjuk", "ur": "تمہیں ہدایت دی جاتی ہے", "bn": "তোমরা পথপ্রাপ্ত", "fa": "هدایت شده‌اید"}}]}, {"ref": "20:82", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2430.mp3", "translation": {"en": {"text": "And lo! verily I am Forgiving toward him who repenteth and believeth and doeth good, and afterward walketh aright.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bununla beraber, şüphe yok ki ben, tevbe eden, iman edip salih amel işleyen, sonra da hak yolda sebat gösteren kimse için çok bağışlayıcıyım.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک میں بہت بخشنے والا ہوں اسے جس نے توبہ کی اور ایمان لایا اور اچھا کام کیا پھر ہدایت پر رہا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya Aku Maha Pengampun bagi orang yang bertaubat, beriman, beramal saleh, kemudian tetap di jalan yang benar.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "لَغَفَّارٌ", "hit": false, "audio": null, "gloss": null}, {"text": "لِّمَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَءَامَنَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَعَمِلَ", "hit": false, "audio": null, "gloss": null}, {"text": "صَٰلِحًا", "hit": false, "audio": null, "gloss": null}, {"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱهْتَدَىٰ", "hit": true, "audio": "audio/ed3f80f2726217694f1a.m4a", "gloss": {"en": "he/it was guided", "bs": "bio je upućen", "tr": "hidayete erdirildi", "fr": "il était guidé", "id": "dia telah mendapat petunjuk", "ur": "اسے ہدایت دی گئی", "bn": "সে পথপ্রাপ্ত ছিল", "fa": "هدایت شده بود"}}]}, {"ref": "47:17", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4562.mp3", "translation": {"en": {"text": "While as for those who walk aright, He addeth to their guidance, and giveth them their protection (against evil).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Doğru yola girenlere gelince, Allah onların hidayetlerini artırmış ve onlara kötülükten sakınma çarelerini ilham etmiştir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جنہوں نے راہ پائی اللہ نے ان کی ہدایت اور زیادہ فرمائی اور ان کی پرہیزگاری انہیں عطا فرمائی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang mau menerima petunjuk, Allah menambah petunjuk kepada mereka dan memberikan balasan ketakwaannya.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱهْتَدَوْا۟", "hit": true, "audio": "audio/22e7a510d95396efd97c.m4a", "gloss": {"bs": "upućeni su", "en": "were guided", "tr": "hidayete erdiler", "fr": "furent guidés", "id": "mendapat petunjuk", "ur": "وہ ہدایت پا گئے", "bn": "তারা হেদায়াত পেয়েছে", "fa": "هدایت یافتند"}}, {"text": "زَادَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "هُدًى", "hit": false, "audio": null, "gloss": null}, {"text": "وَءَاتَىٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَقْوَىٰهُمْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "27:41", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3200.mp3", "translation": {"en": {"text": "He said: Disguise her throne for her that we may see whether she will go aright or be of those not rightly guided.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Süleyman devamla) dedi ki: \"Onun tahtını bilemeyeceği bir vaziyete sokun; getirin bakalım tanıyabilecek mi, yoksa tanıyamayanlardan mı olacak?\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "سلیمان نے حکم دیا عورت کا تخت اس کے سامنے وضع بدل کر بیگانہ کردو کہ ہم دیکھیں کہ وہ راہ پاتی ہے یا ان میں ہوتی ہے جو ناواقف رہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dia berkata: \"Rubahlah baginya singgasananya; maka kita akan melihat apakah dia mengenal ataukah dia termasuk orang-orang yang tidak mengenal(nya)\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَكِّرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "عَرْشَهَا", "hit": false, "audio": null, "gloss": null}, {"text": "نَنظُرْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَتَهْتَدِىٓ", "hit": true, "audio": "audio/695f83ee919407213bb7.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}, {"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَكُونُ", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَهْتَدُونَ", "hit": true, "audio": "audio/782b3e0c8cc47ba5871e.m4a", "gloss": {"bs": "nalaze put", "en": "they are guided", "tr": "hidayet bulurlar", "fr": "ils sont guidés", "id": "mereka mendapat petunjuk", "ur": "وہ ہدایت پاتے ہیں", "bn": "তারা হেদায়াত পায়", "fa": "هدایت می‌شوند"}}]}], "forms": [{"arabic": "يَهْتَدُونَ", "count": 10, "first": "2:170", "audio": "audio/e01e100fe7ff1f6f4a5c.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive":