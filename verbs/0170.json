lse, "spoken": "audio/feaf96d69d3638d589b8.m4a", "recited": "audio/59e1d2bc3a0c82d3cd71.m4a", "recitedText": "فَٱسْعَوْا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِسْعَيْنَ", "plain": "اِسْعَيْنَ", "quran": false, "notUsed": false, "spoken": "audio/fc869e11d1dc000bdd7c.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "79:22", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5734.mp3", "translation": {"en": {"text": "Then turned he away in haste,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra koşarak dönüp gitti.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر پیٹھ دی اپنی کوشش میں لگا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kemudian dia berpaling seraya berusaha menantang (Musa).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَدْبَرَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْعَىٰ", "hit": true, "audio": "audio/3da9e6b4ca993d323c95.m4a", "gloss": {"bs": "žureći", "en": "hastening", "tr": "acele ederek", "fr": "s'empressant", "id": "bergegas", "ur": "دوڑتا ہوا", "bn": "দ্রুত ছুটছে", "fa": "شتابان"}}]}, {"ref": "79:35", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5747.mp3", "translation": {"en": {"text": "The day when man will call to mind his (whole) endeavour,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O, insanın neyin peşinde koştuğunu anladığı gün,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس دن آدمی یاد کرے گا جو کوشش کی تھی", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Pada hari (ketika) manusia teringat akan apa yang telah dikerjakannya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَوْمَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَتَذَكَّرُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْإِنسَٰنُ", "hit": false, "audio": null, "gloss": null}, {"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "سَعَىٰ", "hit": true, "audio": "audio/25bf41990ec5fd582590.m4a", "gloss": {"bs": "je radio", "en": "he strove for", "tr": "çabalayan", "fr": "il s'est efforcé", "id": "dia berjuang untuk", "ur": "اس نے کوشش کی", "bn": "সে চেষ্টা করল", "fa": "کوشید برای"}}]}, {"ref": "34:38", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3644.mp3", "translation": {"en": {"text": "And as for those who strive against Our revelations, challenging, they will be brought to the doom.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Âyetlerimizi hükümsüz bırakmak için yarışanlara gelince, işte onlar Hakk'ın huzuruna azab içinde getirileceklerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہو جو ہماری آیتوں میں ہرانے کی کوشش کرتے ہیں وہ عذاب میں لادھرے جائیں گے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang berusaha (menentang) ayat-ayat Kami dengan anggapan untuk dapat melemahkan (menggagalkan azab Kami), mereka itu dimasukkan ke dalam azab.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْعَوْنَ", "hit": true, "audio": "audio/b91ae9c63e6d41c3a95d.m4a", "gloss": {"en": "they strive", "bs": "trude se", "tr": "çabalarlar", "fr": "ils s'efforcent", "id": "mereka berjuang keras", "ur": "وہ کوشش کرتے ہیں", "bn": "তারা চেষ্টা করে", "fa": "می‌کوشند"}}, {"text": "فِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "مُعَٰجِزِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "أُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَذَابِ", "hit": false, "audio": null, "gloss": null}, {"text": "مُحْضَرُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:20", "tense": "present", "category": {"tense": "present", "pronoun": "hiya", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2368.mp3", "translation": {"en": {"text": "So he cast it down, and lo! it was a serpent, gliding.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Musa da onu bıraktı, bir de ne görsün! o bir yılan olmuş koşuyor.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو موسیٰ نے ڈال دیا تو جبھی وہ دوڑتا ہوا سانپ ہوگیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Lalu dilemparkannyalah tongkat itu, maka tiba-tiba ia menjadi seekor ular yang merayap dengan cepat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَأَلْقَىٰهَا", "hit": false, "audio": null, "gloss": null}, {"text": "فَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "هِىَ", "hit": false, "audio": null, "gloss": null}, {"text": "حَيَّةٌ", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْعَىٰ", "hit": true, "audio": "audio/5915f8a66364bcd022ca.m4a", "gloss": null, "grammar": [{"tense": "present", "pronoun": "hiya", "passive": false, "objects": [], "mood": "indicative"}]}]}, {"ref": "22:51", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2646.mp3", "translation": {"en": {"text": "While those who strive to thwart Our revelations, such are rightful owners of the Fire.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Âyetlerimizi tartışarak bozmaya uğraşanlara gelince, işte onlar cehennemliktirler. Böyle de ve temennilere uyma. Çünkü:", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور وہ جو کوشش کرتے ہیں ہماری آیتوں میں ہار جیت کے ارادہ سے وہ جہنمی ہیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang berusaha dengan maksud menentang ayat-ayat Kami dengan melemahkan (kemauan untuk beriman); mereka itu adalah penghuni-penghuni neraka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَعَوْا۟", "hit": true, "audio": "audio/ecdec8301f1a34967b35.m4a", "gloss": {"en": "they strove", "bs": "trudili su se", "tr": "çabaladılar", "fr": "ils se sont efforcés", "id": "mereka telah berjuang keras", "ur": "انہوں نے کوشش کی", "bn": "তারা চেষ্টা করেছিল", "fa": "کوشیدند"}}, {"text": "فِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَايَٰتِنَا", "hit": false, "audio": null, "gloss": null}, {"text": "مُعَٰجِزِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "أُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَصْحَٰبُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْجَحِيمِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "يَسْعَىٰ", "count": 6, "first": "28:20", "audio": "audio/3da9e6b4ca993d323c95.m4a", "grammar": [{"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "indicative"}, {"tense": "present", "pronoun": "huwa", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"bs": "žureći", "en": "hastening", "tr": "acele ederek", "fr": "s'empressant", "id": "bergegas", "ur": "دوڑتا ہوا", "bn": "দ্রুত ছুটছে", "fa": "شتابان"}}, {"arabic": "سَعَىٰ", "count": 3, "first": "2:205", "audio": "audio/25bf41990ec5fd582590.m4a", "grammar": [{"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}], "gloss": {"bs": "je radio", "en": "he strove for", "tr": "çabalayan", "fr": "il s'est eff