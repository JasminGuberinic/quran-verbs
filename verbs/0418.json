n": true, "notUsed": false, "spoken": "audio/1ff0fcc578ec94c89fbb.m4a", "recited": "audio/4714c36fa1957faff165.m4a", "recitedText": "فَشُدُّوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اُشْدُدْنَ", "plain": "اُشْدُدْنَ", "quran": false, "notUsed": false, "spoken": "audio/63715ec7e75663c1ea77.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "20:31", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2379.mp3", "translation": {"en": {"text": "Confirm my strength with him", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Onunla arkamı kuvvetlendir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اس سے میری کمر مضبوط کر،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "teguhkanlah dengan dia kekuatanku,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ٱشْدُدْ", "hit": true, "audio": "audio/362dd78fd9b52497e2b2.m4a", "gloss": {"bs": "ojačaj", "en": "strengthen", "tr": "güçlendir", "fr": "renforce", "id": "kuatkanlah", "ur": "مضبوط کر", "bn": "শক্ত করো", "fa": "محکم کن"}}, {"text": "بِهِۦٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَزْرِى", "hit": false, "audio": null, "gloss": null}]}, {"ref": "38:20", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3990.mp3", "translation": {"en": {"text": "We made his kingdom strong and gave him wisdom and decisive speech.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Biz onun mülkünü kuvvetlendirmiş ve kendisine hikmet ve hakkı batıldan ayırt etme kabiliyeti vermiştik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم نے اس کی سلطنت کو مضبوط کیا اور اسے حکمت اور قولِ فیصل دیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami kuatkan kerajaannya dan Kami berikan kepadanya hikmahdan kebijaksanaan dalam menyelesaikan perselisihan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَشَدَدْنَا", "hit": true, "audio": "audio/89f4a735ace9a2ef9598.m4a", "gloss": {"bs": "i učvrstili smo", "en": "and We strengthened", "tr": "ve güçlendirdik", "fr": "et Nous avons renforcé", "id": "dan Kami menguatkan", "ur": "اور ہم نے مضبوط کیا", "bn": "এবং আমরা শক্ত করলাম", "fa": "و ما محکم کردیم"}}, {"text": "مُلْكَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَءَاتَيْنَٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحِكْمَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَفَصْلَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْخِطَابِ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَٱشْدُدْ", "count": 1, "first": "10:88", "audio": "audio/df84ec260d4fdb83ebc5.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"en": "and harden!", "bs": "i zapečati!", "tr": "ve mühürle!", "fr": "et scelle !", "id": "dan meteraikanlah!", "ur": "اور سخت کر!", "bn": "এবং মোহর লাগিয়ে দাও!", "fa": "و مهر بزن!"}}, {"arabic": "ٱشْدُدْ", "count": 1, "first": "20:31", "audio": "audio/362dd78fd9b52497e2b2.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"bs": "ojačaj", "en": "strengthen", "tr": "güçlendir", "fr": "renforce", "id": "kuatkanlah", "ur": "مضبوط کر", "bn": "শক্ত করো", "fa": "محکم کن"}}, {"arabic": "سَنَشُدُّ", "count": 1, "first": "28:35", "audio": "audio/2145a13d5be738445336.m4a", "grammar": [{"tense": "present", "pronoun": "nahnu", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "we will strengthen", "bs": "ojačat ćemo", "tr": "güçlendireceğiz", "fr": "nous fortifierons", "id": "kami akan menguatkan", "ur": "ہم مضبوط کریں گے", "bn": "আমরা শক্তিশালী করব", "fa": "قوی خواهیم کرد"}}, {"arabic": "وَشَدَدْنَا", "count": 1, "first": "38:20", "audio": "audio/89f4a735ace9a2ef9598.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"bs": "i učvrstili smo", "en": "and We strengthened", "tr": "ve güçlendirdik", "fr": "et Nous avons renforcé", "id": "dan Kami menguatkan", "ur": "اور ہم نے مضبوط کیا", "bn": "এবং আমরা শক্ত করলাম", "fa": "و ما محکم کردیم"}}, {"arabic": "فَشُدُّوا۟", "count": 1, "first": "47:4", "audio": "audio/4714c36fa1957faff165.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) tighten!", "bs": "pa stegnite!", "tr": "böylece sıkıca bağlayın!", "fr": "serrez donc !", "id": "maka kencangkanlah kalian!", "ur": "پس مضبوط کرو!", "bn": "অতএব শক্ত করে বাঁধ!", "fa": "پس استوار گیرید!"}}, {"arabic": "وَشَدَدْنَآ", "count": 1, "first": "76:28", "audio": "audio/9217f1d7ec9d5f4b041c.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"en": "and we strengthened", "bs": "i ojačali smo", "tr": "ve güçlendirdik", "fr": "et nous avons fortifié", "id": "dan kami telah menguatkan", "ur": "اور ہم نے مضبوط کیا", "bn": "এবং আমরা শক্তিশালী করেছি", "fa": "و قوی کردیم"}}], "ayatFile": "ayat/0418.json", "ayatTranslations": {"en": "ayat/0418.en.json", "tr": "ayat/0418.tr.json", "ur": "ayat/0418.ur.json", "id": "ayat/0418.id.json"}, "sentences": [{"arabic": "اُشْدُدْ عَزْمَكَ", "spoken": "audio/3829406390412e00f4c1.m4a", "tense": "imperative", "pronoun": "anta", "translation": {"bs": "Ojačaj svoju odlučnost.", "en": "Strengthen your resolve.", "bn": "তোমার সংকল্প মজবুত করো।", "fa": "عزمت را محکم کن.", "fr": "Renforce ta détermination.", "id": "Kuatkanlah tekadmu.", "tr": "Azmini güçlendir.", "ur": "اپنا عزم مضبوط کرو۔"}, "independentlyReviewed": true, "words": [{"arabic": "اُشْدُدْ", "target": true, "translation": {"bs": "ojačaj", "en": "strengthen", "bn": "মজবুত করো", "fa": "محکم کن", "fr": "renforce", "id": "kuatkanlah", "tr": "güçlendir", "ur": "مضبوط کرو"}}, {"arabic": "عَزْمَكَ", "target": false, "translation": {"bs": "svoju odlučnost", "en": "your resolve", "bn": "তোমার সংকল্প", "fa": "عزمت", "fr": "ta détermination", "id": "tekadmu", "tr": "azmin", "ur": "تمہارا عزم"}}]}, {"arabic": "شَدَدْنَا الْحِبَالَ جَيِّدًا", "spoken": "audio/97de34f742625a2e700c.m4a", "tense": "past", "pronoun": "nahnu", "translation": {"bs": "Dobro smo zategli konopce.", "en": "We tightened the cords well.", "bn": "আমরা দড়িগুলো ভালোভাবে শক্ত করে বাঁধলাম।", "fa": "ما طناب‌ها را خوب محکم بستیم.", "fr": "Nous avons bien serré les cordes.", "id": "Kami mengencangkan tali-tali itu dengan baik.", "tr": "Halatları iyice sıktık.", "ur": "ہم نے رسیاں اچھی طرح کس دیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "شَدَدْنَا", "target": true, "translation": {"bs": "zategli smo", "en": "made tight", "bn": "আমরা শক্ত করে বাঁধলাম", "fa": "محکم بستیم", "fr": "avons serré", "id": "mengencangkan", "tr": "sıktık", "ur": "ہم نے کسا"}}, {"arabic": "الْحِبَالَ", "target": false, "translation": {"bs": "konopce", "en": "the cords", "bn": "দড়িগুলো", "fa": "طناب‌ها", "fr": "les cordes", "id": "tali-tali itu", "tr": "halatlar", "ur": "رسیاں"}}, {"arabic": "جَيِّدًا", "target": false, "translation": {"bs": "dobro", "en": "well", "bn": "ভালোভাবে", "fa": "خوب", "fr": "bien", "id": "baik", "tr": "iyi", "ur": "اچھی طرح"}}]}, {"arabic": "نَشُدُّ الْحِبَالَ قَبْلَ السَّفَرِ", "spoken": "audio/43f1269b7cca518c4aa4.m4a", "tense": "present", "pronoun": "nahnu", "translation": {"bs": "Zatežemo konopce prije putovanja.", "en": "We tighten the cords before the trip.", "bn": "আমরা সফরের আগে দড়িগুলো শক্ত করে বাঁধি।", "fa": "ما پیش از سفر طناب‌ها را محکم می‌بندیم.", "fr": "Nous serrons les cordes avant le voyage.", "id": "Kami mengencangkan tali-tali sebelum perjalanan.", "tr": "Yolculuktan önce halatları sıkarız.", "ur": "ہم سفر سے پہلے رسیاں کستے ہیں۔"}, "independentlyReviewed": true, "words": [{