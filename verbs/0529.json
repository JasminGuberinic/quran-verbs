: "bleue", "id": "biru", "tr": "mavi", "ur": "نیلا"}}]}, {"arabic": "يَخْتَارُ الزَّبُونُ الْفَاكِهَةَ", "spoken": "audio/9fd7f319752ed18f2b77.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Kupac bira voće.", "en": "The customer chooses the fruit.", "bn": "ক্রেতা ফল বেছে নেয়।", "fa": "مشتری میوه را انتخاب می‌کند.", "fr": "Le client choisit les fruits.", "id": "Pelanggan itu memilih buah-buahan.", "tr": "Müşteri meyveyi seçer.", "ur": "گاہک پھل کا انتخاب کرتا ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَخْتَارُ", "target": true, "translation": {"bs": "bira", "en": "chooses", "bn": "বেছে নেয়", "fa": "برمی‌گزیند", "fr": "choisit", "id": "dia memilih", "tr": "seçer", "ur": "چنتا ہے"}}, {"arabic": "الزَّبُونُ", "target": false, "translation": {"bs": "kupac", "en": "the customer", "bn": "ক্রেতা", "fa": "مشتری", "fr": "le client", "id": "pelanggan itu", "tr": "müşteri", "ur": "گاہک"}}, {"arabic": "الْفَاكِهَةَ", "target": false, "translation": {"bs": "voće", "en": "the fruit", "bn": "ফল", "fa": "میوه", "fr": "les fruits", "id": "buah-buahan itu", "tr": "meyve", "ur": "پھل"}}]}]}