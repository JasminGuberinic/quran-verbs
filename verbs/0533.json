null}], "ayat": [{"ref": "28:54", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3306.mp3", "translation": {"en": {"text": "These will be given their reward twice over, because they are steadfast and repel evil with good, and spend of that wherewith We have provided them,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İşte onlara, sabretmelerinden ötürü mükafatları iki defa verilecektir. Bunlar kötülüğü iyilikle savarlar, kendilerine verdiğimiz rızıktan da Allah rızası için harcarlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "ان کو ان کا اجر دوبالا دیا جائے گا بدلہ ان کے صبر کا اور وہ بھلائی سے برائی کو ٹالتے ہیں اور ہمارے دیے سے کچھ ہماری راہ میں خرچ کرتے ہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Mereka itu diberi pahala dua kali disebabkan kesabaran mereka, dan mereka menolak kejahatan dengan kebaikan, dan sebagian dari apa yang telah Kami rezekikan kepada mereka, mereka nafkahkan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أُو۟لَٰٓئِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "يُؤْتَوْنَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْرَهُم", "hit": false, "audio": null, "gloss": null}, {"text": "مَّرَّتَيْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "صَبَرُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "وَيَدْرَءُونَ", "hit": true, "audio": "audio/1d274069fc7be2bda9ce.m4a", "gloss": {"bs": "i odbijaju", "en": "and they repel", "tr": "ve savuyorlar", "fr": "et ils repoussent", "id": "dan mereka menolak", "ur": "اور وہ ٹالتے ہیں", "bn": "এবং তারা প্রতিহত করে", "fa": "و دفع می‌کنند"}}, {"text": "بِٱلْحَسَنَةِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّيِّئَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَمِمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "رَزَقْنَٰهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُنفِقُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "24:8", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2799.mp3", "translation": {"en": {"text": "And it shall avert the punishment from her if she bear witness before Allah four times that the thing he saith is indeed false,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kadının, kocasının yalan söyleyenlerden olduğuna dair dört defa Allah adına yemin ve şahitlik etmesi,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور عورت سے یوں سزا ٹل جائے گی کہ وہ اللہ کا نام لے کر چار بار گواہی دے کہ مرد جھوٹا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Istrinya itu dihindarkan dari hukuman oleh sumpahnya empat kali atas nama Allah sesungguhnya suaminya itu benar-benar termasuk orang-orang yang dusta.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَيَدْرَؤُا۟", "hit": true, "audio": "audio/f963e78019efbfd14cbd.m4a", "gloss": {"bs": "i otklanja", "en": "and it averts", "tr": "ve savuşturur", "fr": "et cela écarte", "id": "dan ia menangkal", "ur": "اور وہ ٹالتی ہے", "bn": "এবং তা প্রতিহত করে", "fa": "و دفع می‌کند"}}, {"text": "عَنْهَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَذَابَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَشْهَدَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَرْبَعَ", "hit": false, "audio": null, "gloss": null}, {"text": "شَهَٰدَٰتٍۭ", "hit": false, "audio": null, "gloss": null}, {"text": "بِٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "لَمِنَ", "hit": false,