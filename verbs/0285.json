"quran": false, "notUsed": false, "spoken": "audio/ee6f2ccc0105c0eae259.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "17:32", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2061.mp3", "translation": {"en": {"text": "And come not near unto adultery. Lo! it is an abomination and an evil way.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Zinaya da yaklaşmayın, çünkü o pek çirkindir ve kötü bir yoldur.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بدکاری کے پاس نہ جاؤ بیشک وہ بے حیائی ہے، اور بہت ہی بری راہ،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan janganlah kamu mendekati zina; sesungguhnya zina itu adalah suatu perbuatan yang keji. Dan suatu jalan yang buruk.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَقْرَبُوا۟", "hit": true, "audio": "audio/a30d69bb11f0f6bedc5b.m4a", "gloss": {"bs": "približavajte se", "en": "approach", "tr": "yaklaşın", "fr": "n'approchez pas", "id": "mendekatlah", "ur": "قریب نہ جاؤ", "bn": "কাছে যেয়ো না", "fa": "نزدیک نشوید"}}, {"text": "ٱلزِّنَىٰٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "كَانَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٰحِشَةً", "hit": false, "audio": null, "gloss": null}, {"text": "وَسَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "سَبِيلًا", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "تَقْرَبُوا۟", "count": 5, "first": "4:43", "audio": "audio/9e7ab161d9e446b0ce0d.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"bs": "približavajte se", "en": "approach", "tr": "yaklaşın", "fr": "n'approchez pas", "id": "mendekatlah", "ur": "قریب نہ جاؤ", "bn": "কাছে যেয়ো না", "fa": "نزدیک نشوید"}}, {"arabic": "تَقْرَبَا", "count": 2, "first": "2:35", "audio": "audio/821483d9ebdae79253ba.m4a", "grammar": [{"tense": "present", "pronoun": "antuma", "passive": false, "objects": [], "mood": "jussive"}]}, {"arabic": "تَقْرَبُوهَا", "count": 1, "first": "2:187", "audio": "audio/a245308ce8ced82440a6.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": ["hiya"], "mood": "jussive"}], "gloss": {"en": "you (all) approach them", "bs": "prilazite im", "tr": "onlara yaklaşırsınız", "fr": "que vous approchiez d'eux", "id": "kalian mendekati mereka", "ur": "تم ان کے قریب جاتے ہو", "bn": "তোমরা তাদের কাছে যাও", "fa": "به آنان نزدیک شوید"}}, {"arabic": "تَقْرَبُوهُنَّ", "count": 1, "first": "2:222", "audio": "audio/d7dc4d094eb6a87affd0.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": ["hunna"], "mood": "jussive"}], "gloss": {"en": "you (all) approach them", "bs": "prilazite im", "tr": "onlara yaklaşırsınız", "fr": "que vous approchiez d'elles", "id": "kalian mendekati mereka", "ur": "تم ان کے قریب جاتے ہو", "bn": "তোমরা তাদের কাছে যাও", "fa": "به آنان نزدیک شوید"}}, {"arabic": "يَقْرَبُوا۟", "count": 1, "first": "9:28", "audio": "audio/d39866f0f89bc7f06aa6.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "jussive"}], "gloss": {"en": "they approach", "bs": "prilaze", "tr": "yaklaşırlar", "fr": "qu'ils approchent", "id": "mereka mendekati", "ur": "وہ قریب جاتے ہیں", "bn": "তারা কাছে যায়", "fa": "نزدیک شوند"}}, {"arabic": "تَقْرَبُونِ", "count": 1, "first": "12:60", "audio": "audio/7bce4ae12084be04d1fd.m4a", "grammar": [{"tense": "present", "pronoun": "antum", "passive": false, "objects": ["ana"], "mood": "jussive"}], "gloss": {"en": "you (all) approach me", "bs": "prilazite mi", "tr": "bana yaklaşırsınız", "fr": "que vous approchiez de moi", "id": "kalian mendekatiku", "ur": "تم میرے قریب آتے ہو", "bn": "তোমরা আমার কাছে যাও", "fa": "به من نزدیک شوید"}}], "ayatFile": "ayat/0285.json", "ayatTranslations": {"en": "ayat/0285.en.json", "tr": "ayat/0285.tr.json", "ur": "ayat/0285.ur.json", "id": "ayat/0285.id.json"}, "sentences": [{"arabic": "لَا يَقْرَبُ الْقِطُّ الْمَاءَ", "spoken": "audio/ac1c2aecfaca4cb2117c.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Mačka ne prilazi vodi.", "en": "The cat does not go near water.", "bn": "বিড়ালটি পানির কাছে যায় না।", "fa": "گربه به آب نزدیک نمی‌شود.", "fr": "Le chat ne s'approche pas de l'eau.", "id": "Kucing itu tidak mendekati air.", "tr": "Kedi suya yaklaşmaz.", "ur": "بلی پانی کے قریب نہیں جاتی۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "يَقْرَبُ", "target": true, "translation": {"bs": "prilazi", "en": "approaches", "bn": "কাছে আসে", "fa": "نزدیک می‌شود", "fr": "s'approche", "id": "mendekat", "tr": "yaklaşır", "ur": "وہ قریب جاتا ہے"}}, {"arabic": "الْقِطُّ", "target": false, "translation": {"bs": "mačka", "en": "the cat", "bn": "বিড়াল", "fa": "گربه", "fr": "le chat", "id": "kucing", "tr": "kedi", "ur": "بلا"}}, {"arabic": "الْمَاءَ", "target": false, "translation": {"bs": "vodi", "en": "water", "bn": "পানি", "fa": "آب", "fr": "de l'eau", "id": "air", "tr": "su", "ur": "پانی"}}]}, {"arabic": "لَا أَقْرَبُ الْحَلْوَى", "spoken": "audio/a00e54f8a5e9465c44d3.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Ne prilazim slatkišima.", "en": "I do not go near sweets.", "bn": "আমি মিষ্টির কাছে যাই না।", "fa": "به شیرینی نزدیک نمی‌شوم.", "fr": "Je ne m'approche pas des sucreries.", "id": "Aku tidak mendekati manisan.", "tr": "Tatlılara yaklaşmam.", "ur": "میں مٹھائی کے قریب نہیں جاتا۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَا", "target": false, "translation": {"bs": "ne", "en": "not", "bn": "না", "fa": "نه", "fr": "ne… pas", "id": "tidak", "tr": "değil", "ur": "نہیں"}}, {"arabic": "أَقْرَبُ", "target": true, "translation": {"bs": "prilazim", "en": "I approach", "bn": "আমি কাছে যাই", "fa": "نزدیک می‌شوم", "fr": "je m'approche", "id": "aku mendekat", "tr": "yaklaşırım", "ur": "میں قریب جاتا ہوں"}}, {"arabic": "الْحَلْوَى", "target": false, "translation": {"bs": "slatkišima", "en": "sweets", "bn": "মিষ্টি", "fa": "شیرینی", "fr": "des sucreries", "id": "manisan", "tr": "tatlılar", "ur": "مٹھائی"}}]}, {"arabic": "مَا قَرِبُوا الطَّعَامَ", "spoken": "audio/522400cb6a66e03348d0.m4a", "tense": "past", "pronoun": "hum", "translation": {"bs": "Nisu ni prišli hrani.", "en": "They did not go near the food.", "bn": "তারা খাবারের কাছে গেল না।", "fa": "به غذا نزدیک نشدند.", "fr": "Ils ne se sont pas approchés de la nourriture.", "id": "Mereka tidak mendekati makanan itu.", "tr": "Yemeğe yaklaşmadılar.", "ur": "وہ کھانے کے قریب نہیں گئے۔"}, "independentlyReviewed": true, "words": [{"arabic": "مَا", "target": false, "translation": {"bs": "nisu", "en": "not", "bn": "না", "fa": "نه", "fr": "nous n'avons pas", "id": "tidak", "tr": "-me", "ur": "نہیں"}}, {"arabic": "قَرِبُوا", "target": true, "translation": {"bs": "prišli", "en": "they approached", "bn": "তারা কাছে এল", "fa": "نزدیک شدند", "fr": "se sont approchés", "id": "mereka mendekat", "tr": "yaklaştılar", "ur": "وہ قریب آئے"}}, {"arabic": "الطَّعَامَ", "target": false, "translation": {"bs": "hrani", "en": "the food", "bn": "খাবার", "fa": "غذا", "fr": "la nourriture", "id": "makanan itu", "tr": "yemek", "ur": "کھانا"}}]}, {"arabic": "مَا قَرِبَ الطِّفْلُ النَّارَ", "spoken": "audio/4d77824e770f6311dc39.m4a", "tense": "past", "pronoun": "huwa", "translation": {"bs": "Dijete nije ni prišlo vatri.", "en": "The child did not go near the fire.", "bn": "শিশুটি আগুনের কাছে গেল না।", "fa": "کودک به آتش نزدیک نشد.", "fr": "L'enfant ne s'est pas approché du feu.", "id": "Anak itu tidak mendekati api.", "tr": "Çocuk ateşe yakla