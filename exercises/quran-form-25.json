[{"id":"nasara-2-48-18","words":["verb:nasara"],"options":[{"bs":"bivaju potpomognuti","en":"they are helped"},{"bs":"pomažu im","en":"they help them"},{"bs":"bivate potpomognuti","en":"you (all) are helped"},{"bs":"pomogao im je","en":"he/it helped them"}],"ref":"2:48","answerWord":"يُنصَرُونَ","answerSound":"audio/90c0dd69b2081139af76.m4a","quranTranslation":{"text":"And guard yourselves against a day when no soul will in aught avail another, nor will intercession be accepted from it, nor will compensation be received from it, nor will they be helped.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["وَٱتَّقُوا۟","يَوْمًا","لَّا","تَجْزِى","نَفْسٌ","عَن","نَّفْسٍ","شَيْـًٔا","وَلَا","يُقْبَلُ","مِنْهَا","شَفَٰعَةٌ","وَلَا","يُؤْخَذُ","مِنْهَا","عَدْلٌ","وَلَا","هُمْ","يُنصَرُونَ"],"marked":[18],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-11-113-16","words":["verb:nasara"],"options":[{"bs":"bivate potpomognuti","en":"you (all) are helped"},{"bs":"pa nam pomozi!","en":"so help us!"},{"bs":"i (da) ti pomogne","en":"and (that God) may help you"},{"bs":"pomaže vam","en":"he/it helps you (all)"}],"ref":"11:113","answerWord":"تُنصَرُونَ","answerSound":"audio/cb7a044587ac824956ef.m4a","quranTranslation":{"text":"And incline not toward those who do wrong lest the Fire touch you, and ye have no protecting friends against Allah, and afterward ye would not be helped.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["وَلَا","تَرْكَنُوٓا۟","إِلَى","ٱلَّذِينَ","ظَلَمُوا۟","فَتَمَسَّكُمُ","ٱلنَّارُ","وَمَا","لَكُم","مِّن","دُونِ","ٱللَّهِ","مِنْ","أَوْلِيَآءَ","ثُمَّ","لَا","تُنصَرُونَ"],"marked":[16],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-23-26-2","words":["verb:nasara"],"options":[{"bs":"pomozi mi!","en":"help me!"},{"bs":"bivate potpomognuti","en":"you (all) are helped"},{"bs":"i pomažu","en":"and they help"},{"bs":"pomaže","en":"he/it helps"}],"ref":"23:26","answerWord":"ٱنصُرْنِى","answerSound":"audio/be56d5c42a8f69b8c071.m4a","quranTranslation":{"text":"He said: My Lord! Help me because they deny me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["قَالَ","رَبِّ","ٱنصُرْنِى","بِمَا","كَذَّبُونِ"],"marked":[2],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-2-250-11","words":["verb:nasara"],"options":[{"bs":"i pomozi nam!","en":"and help us!"},{"bs":"pomaže mu","en":"he/it helps him"},{"bs":"i (da) ti pomogne","en":"and (that God) may help you"},{"bs":"bivaju potpomognuti","en":"they are helped"}],"ref":"2:250","answerWord":"وَٱنصُرْنَا","answerSound":"audio/f443a280aae2281f5ec5.m4a","quranTranslation":{"text":"And when they went into the field against Goliath and his hosts they said: Our Lord! Bestow on us endurance, make our foothold sure, and give us help against the disbelieving folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["وَلَمَّا","بَرَزُوا۟","لِجَالُوتَ","وَجُنُودِهِۦ","قَالُوا۟","رَبَّنَآ","أَفْرِغْ","عَلَيْنَا","صَبْرًا","وَثَبِّتْ","أَقْدَامَنَا","وَٱنصُرْنَا","عَلَى","ٱلْقَوْمِ","ٱلْكَٰفِرِينَ"],"marked":[11],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-3-123-1","words":["verb:nasara"],"options":[{"bs":"pomogao vam je","en":"he/it helped you (all)"},{"bs":"pomaže mi","en":"he/it helps me"},{"bs":"pomaže nam","en":"he/it helps us"},{"bs":"pomaže vam","en":"he/it helps you (all)"}],"ref":"3:123","answerWord":"نَصَرَكُمُ","answerSound":"audio/1880fc6e9fe657a7ca1e.m4a","quranTranslation":{"text":"Allah had already given you the victory at Badr, when ye were contemptible. So observe your duty to Allah in order that ye may be thankful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["وَلَقَدْ","نَصَرَكُمُ","ٱللَّهُ","بِبَدْرٍ","وَأَنتُمْ","أَذِلَّةٌ","فَٱتَّقُوا۟","ٱللَّهَ","لَعَلَّكُمْ","تَشْكُرُونَ"],"marked":[1],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-3-160-11","words":["verb:nasara"],"options":[{"bs":"pomaže vam","en":"he/it helps you (all)"},{"bs":"pomogao im je","en":"he/it helped them"},{"bs":"pomažu mu","en":"they help him"},{"bs":"pomaže","en":"he/it helps"}],"ref":"3:160","answerWord":"يَنصُرُكُم","answerSound":"audio/3579ae32863641e23331.m4a","quranTranslation":{"text":"If Allah is your helper none can overcome you, and if He withdraw His help from you, who is there who can help you after Him? In Allah let believers put their trust.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["إِن","يَنصُرْكُمُ","ٱللَّهُ","فَلَا","غَالِبَ","لَكُمْ","وَإِن","يَخْذُلْكُمْ","فَمَن","ذَا","ٱلَّذِى","يَنصُرُكُم","مِّنۢ","بَعْدِهِۦ","وَعَلَى","ٱللَّهِ","فَلْيَتَوَكَّلِ","ٱلْمُؤْمِنُونَ"],"marked":[11],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-7-192-6","words":["verb:nasara"],"options":[{"bs":"pomažu","en":"they help"},{"bs":"pomaže mi","en":"he/it helps me"},{"bs":"pomogao vam je","en":"he/it helped you (all)"},{"bs":"i pomozite!","en":"and (you all) help!"}],"ref":"7:192","answerWord":"يَنصُرُونَ","answerSound":"audio/44517e4dee9063fcda1a.m4a","quranTranslation":{"text":"And cannot give them help, nor can they help themselves?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["وَلَا","يَسْتَطِيعُونَ","لَهُمْ","نَصْرًا","وَلَآ","أَنفُسَهُمْ","يَنصُرُونَ"],"marked":[6],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-11-30-2","words":["verb:nasara"],"options":[{"bs":"pomaže mi","en":"he/it helps me"},{"bs":"bivate potpomognuti","en":"you (all) are helped"},{"bs":"pomaže vam","en":"he/it helps you (all)"},{"bs":"pomažu im","en":"they help them"}],"ref":"11:30","answerWord":"يَنصُرُنِى","answerSound":"audio/7dab23a5367fc68a5829.m4a","quranTranslation":{"text":"And, O my people! who would deliver me from Allah if I thrust them away? Will ye not then reflect?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["وَيَٰقَوْمِ","مَن","يَنصُرُنِى","مِنَ","ٱللَّهِ","إِن","طَرَدتُّهُمْ","أَفَلَا","تَذَكَّرُونَ"],"marked":[2],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-18-43-4","words":["verb:nasara"],"options":[{"bs":"pomažu mu","en":"they help him"},{"bs":"bivate potpomognuti","en":"you (all) are helped"},{"bs":"pomogao im je","en":"he/it helped them"},{"bs":"zaista ćemo vam pomoći","en":"surely we will help you (all)"}],"ref":"18:43","answerWord":"يَنصُرُونَهُۥ","answerSound":"audio/57ba6d457504e2dd5b45.m4a","quranTranslation":{"text":"And he had no troop of men to help him as against Allah, nor could he save himself.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["وَلَمْ","تَكُن","لَّهُۥ","فِئَةٌ","يَنصُرُونَهُۥ","مِن","دُونِ","ٱللَّهِ","وَمَا","كَانَ","مُنتَصِرًا"],"marked":[4],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-3-160-1","words":["verb:nasara"],"options":[{"bs":"pomaže vam","en":"he/it helps you (all)"},{"bs":"pomaže mi","en":"he/it helps me"},{"bs":"pomaže","en":"he/it helps"},{"bs":"pomaže mu","en":"he/it helps him"}],"ref":"3:160","answerWord":"يَنصُرْكُمُ","answerSound":"audio/99fadee513343fa1f0b6.m4a","quranTranslation":{"text":"If Allah is your helper none can overcome you, and if He withdraw His help from you, who is there who can help you after Him? In Allah let believers put their trust.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["إِن","يَنصُرْكُمُ","ٱللَّهُ","فَلَا","غَالِبَ","لَكُمْ","وَإِن","يَخْذُلْكُمْ","فَمَن","ذَا","ٱلَّذِى","يَنصُرُكُم","مِّنۢ","بَعْدِهِۦ","وَعَلَى","ٱللَّهِ","فَلْيَتَوَكَّلِ","ٱلْمُؤْمِنُونَ"],"marked":[1],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-9-14-5","words":["verb:nasara"],"options":[{"bs":"i pomaže vam","en":"and he/it helps you (all)"},{"bs":"i pomogli su mu","en":"and they helped him"},{"bs":"pomaže mi","en":"he/it helps me"},{"bs":"pomažete","en":"you (all) help"}],"ref":"9:14","answerWord":"وَيَنصُرْكُمْ","answerSound":"audio/1995c93ad6a5812deebc.m4a","quranTranslation":{"text":"Fight them! Allah will chastise them at your hands, and He will lay them low and give you victory over them, and He will heal the breasts of folk who are believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["قَٰتِلُوهُمْ","يُعَذِّبْهُمُ","ٱللَّهُ","بِأَيْدِيكُمْ","وَيُخْزِهِمْ","وَيَنصُرْكُمْ","عَلَيْهِمْ","وَيَشْفِ","صُدُورَ","قَوْمٍ","مُّؤْمِنِينَ"],"marked":[5],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-21-68-2","words":["verb:nasara"],"options":[{"bs":"i pomozite!","en":"and (you all) help!"},{"bs":"i pomozi nam!","en":"and help us!"},{"bs":"pomažete mu","en":"you (all) help him"},{"bs":"zaista ćemo vam pomoći","en":"surely we will help you (all)"}],"ref":"21:68","answerWord":"وَٱنصُرُوٓا۟","answerSound":"audio/c104c343cf9374167a2c.m4a","quranTranslation":{"text":"They cried: Burn him and stand by your gods, if ye will be doing.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["قَالُوا۟","حَرِّقُوهُ","وَٱنصُرُوٓا۟","ءَالِهَتَكُمْ","إِن","كُنتُمْ","فَٰعِلِينَ"],"marked":[2],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-21-77-0","words":["verb:nasara"],"options":[{"bs":"i pomogli smo mu","en":"and we helped him"},{"bs":"pomaže mu","en":"he/it helps him"},{"bs":"pomažu","en":"they help"},{"bs":"pomažu vam","en":"they help you (all)"}],"ref":"21:77","answerWord":"وَنَصَرْنَٰهُ","answerSound":"audio/a22d8ffb3badd80cc4c4.m4a","quranTranslation":{"text":"And delivered him from the people who denied Our revelations. Lo! they were folk of evil, therefor did We drown them all.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["وَنَصَرْنَٰهُ","مِنَ","ٱلْقَوْمِ","ٱلَّذِينَ","كَذَّبُوا۟","بِـَٔايَٰتِنَآ","إِنَّهُمْ","كَانُوا۟","قَوْمَ","سَوْءٍ","فَأَغْرَقْنَٰهُمْ","أَجْمَعِينَ"],"marked":[0],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-22-15-5","words":["verb:nasara"],"options":[{"bs":"pomaže mu","en":"he/it helps him"},{"bs":"i pomogli su mu","en":"and they helped him"},{"bs":"i pomozite!","en":"and (you all) help!"},{"bs":"pomažete","en":"you (all) help"}],"ref":"22:15","answerWord":"يَنصُرَهُ","answerSound":"audio/11c0e8c03127a28318b7.m4a","quranTranslation":{"text":"Whoso is wont to think (through envy) that Allah will not give him (Muhammad) victory in the world and the Hereafter (and is enraged at the thought of his victory), let him stretch a rope up to the roof (of his dwelling), and let him hang himself. Then let him see whether his strategy dispelleth that whereat he rageth!.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["مَن","كَانَ","يَظُنُّ","أَن","لَّن","يَنصُرَهُ","ٱللَّهُ","فِى","ٱلدُّنْيَا","وَٱلْءَاخِرَةِ","فَلْيَمْدُدْ","بِسَبَبٍ","إِلَى","ٱلسَّمَآءِ","ثُمَّ","لْيَقْطَعْ","فَلْيَنظُرْ","هَلْ","يُذْهِبَنَّ","كَيْدُهُۥ","مَا","يَغِيظُ"],"marked":[5],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-22-60-10","words":["verb:nasara"],"options":[{"bs":"zaista će mu pomoći","en":"surely he/it will help him"},{"bs":"pomažu mu","en":"they help him"},{"bs":"pomažu vam","en":"they help you (all)"},{"bs":"i pomogli su mu","en":"and they helped him"}],"ref":"22:60","answerWord":"لَيَنصُرَنَّهُ","answerSound":"audio/4a68d4f926494625166a.m4a","quranTranslation":{"text":"That (is so). And whoso hath retaliated with the like of that which he was made to suffer and then hath (again) been wronged, Allah will succour him. Lo! Allah verily is Mild, Forgiving.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["ذَٰلِكَ","وَمَنْ","عَاقَبَ","بِمِثْلِ","مَا","عُوقِبَ","بِهِۦ","ثُمَّ","بُغِىَ","عَلَيْهِ","لَيَنصُرَنَّهُ","ٱللَّهُ","إِنَّ","ٱللَّهَ","لَعَفُوٌّ","غَفُورٌ"],"marked":[10],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-26-93-4","words":["verb:nasara"],"options":[{"bs":"pomažu vam","en":"they help you (all)"},{"bs":"pomogli su im","en":"they helped them"},{"bs":"i pomaže vam","en":"and he/it helps you (all)"},{"bs":"pomažete","en":"you (all) help"}],"ref":"26:93","answerWord":"يَنصُرُونَكُمْ","answerSound":"audio/5c11648a866937c7e813.m4a","quranTranslation":{"text":"Instead of Allah? Can they help you or help themselves?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["مِن","دُونِ","ٱللَّهِ","هَلْ","يَنصُرُونَكُمْ","أَوْ","يَنتَصِرُونَ"],"marked":[4],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-30-5-2","words":["verb:nasara"],"options":[{"bs":"pomaže","en":"he/it helps"},{"bs":"pa nam pomozi!","en":"so help us!"},{"bs":"i (da) ti pomogne","en":"and (that God) may help you"},{"bs":"pomaže vam","en":"he/it helps you (all)"}],"ref":"30:5","answerWord":"يَنصُرُ","answerSound":"audio/d5c03370baf6aa029cb6.m4a","quranTranslation":{"text":"In Allah's help to victory. He helpeth to victory whom He will. He is the Mighty, the Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["بِنَصْرِ","ٱللَّهِ","يَنصُرُ","مَن","يَشَآءُ","وَهُوَ","ٱلْعَزِيزُ","ٱلرَّحِيمُ"],"marked":[2],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-37-116-0","words":["verb:nasara"],"options":[{"bs":"i pomogli smo im","en":"and We helped them"},{"bs":"pomaže","en":"he/it helps"},{"bs":"pomaže mu","en":"he/it helps him"},{"bs":"pomaže mi","en":"he/it helps me"}],"ref":"37:116","answerWord":"وَنَصَرْنَٰهُمْ","answerSound":"audio/05bb3226124fb9405994.m4a","quranTranslation":{"text":"And helped them so that they became the victors.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["وَنَصَرْنَٰهُمْ","فَكَانُوا۟","هُمُ","ٱلْغَٰلِبِينَ"],"marked":[0],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-40-29-8","words":["verb:nasara"],"options":[{"bs":"pomaže nam","en":"he/it helps us"},{"bs":"i pomaže vam","en":"and he/it helps you (all)"},{"bs":"zaista pomažemo","en":"surely we help"},{"bs":"pomažete mu","en":"you (all) help him"}],"ref":"40:29","answerWord":"يَنصُرُنَا","answerSound":"audio/8f206725ef870aeeb2cf.m4a","quranTranslation":{"text":"O my people! Yours is the kingdom to-day, ye being uppermost in the land. But who would save us from the wrath of Allah should it reach us? Pharaoh said: I do but show you what I think, and I do but guide you to wise policy.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["يَٰقَوْمِ","لَكُمُ","ٱلْمُلْكُ","ٱلْيَوْمَ","ظَٰهِرِينَ","فِى","ٱلْأَرْضِ","فَمَن","يَنصُرُنَا","مِنۢ","بَأْسِ","ٱللَّهِ","إِن","جَآءَنَا","قَالَ","فِرْعَوْنُ","مَآ","أُرِيكُمْ","إِلَّا","مَآ","أَرَىٰ","وَمَآ","أَهْدِيكُمْ","إِلَّا","سَبِيلَ","ٱلرَّشَادِ"],"marked":[8],"facts":{"verb":"نَصَرَ"}},{"id":"nasara-40-51-1","words":["verb:nasara"],"options":[{"bs":"zaista pomažemo","en":"surely we help"},{"bs":"pomažu im","en":"they help them"},{"bs":"i pomogli su mu","en":"and they helped him"},{"bs":"i pomogli smo im","en":"and We helped them"}],"ref":"40:51","answerWord":"لَنَنصُرُ","answerSound":"audio/b4a62228ffbd07463a0c.m4a","quranTranslation":{"text":"Lo! We verily do help Our messengers, and those who believe, in the life of the world and on the day when the witnesses arise,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomoći, dati pobjedu","en":"to help, to give victory"},"passage":["إِنَّا","لَنَنصُرُ","رُسُلَنَا","وَٱلَّذِينَ","ءَامَنُوا۟","فِى","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","وَيَوْمَ","يَقُومُ","ٱلْأَشْهَٰدُ"],"marked":[1],"facts":{"verb":"نَصَرَ"}},{"id":"radia-5-119-19","words":["verb:radia"],"options":[{"bs":"i bili su zadovoljni","en":"and they were pleased"},{"bs":"bio je zadovoljan","en":"he/it was pleased"},{"bs":"bili ste zadovoljni","en":"you (all) were pleased"},{"bs":"i zadovoljan je","en":"and he/it is pleased"}],"ref":"5:119","answerWord":"وَرَضُوا۟","answerSound":"audio/612d58c7cdd6d50c6a89.m4a","quranTranslation":{"text":"Allah saith: This is a day in which their truthfulness profiteth the truthful, for theirs are Gardens underneath which rivers flow, wherein they are secure for ever, Allah taking pleasure in them and they in Him. That is the great triumph.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti zadovoljan","en":"to be pleased, to be satisfied"},"passage":["قَالَ","ٱللَّهُ","هَٰذَا","يَوْمُ","يَنفَعُ","ٱلصَّٰدِقِينَ","صِدْقُهُمْ","لَهُمْ","جَنَّٰتٌ","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدًا","رَّضِىَ","ٱللَّهُ","عَنْهُمْ","وَرَضُوا۟","عَنْهُ","ذَٰلِكَ","ٱلْفَوْزُ","ٱلْعَظِيمُ"],"marked":[19],"facts":{"verb":"رَضِيَ"}},{"id":"radia-9-87-0","words":["verb:radia"],"options":[{"bs":"zadovoljili su se","en":"they were satisfied"},{"bs":"i bio je zadovoljan","en":"and he/it was pleased"},{"bs":"da budete zadovoljni","en":"so that you (all) may be pleased"},{"bs":"i zadovoljan je","en":"and he/it is pleased"}],"ref":"9:87","answerWord":"رَضُوا۟","answerSound":"audio/a7cff995b7981037cbb1.m4a","quranTranslation":{"text":"They are content that they should be with the useless and their hearts are sealed, so that they apprehend not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti zadovoljan","en":"to be pleased, to be satisfied"},"passage":["رَضُوا۟","بِأَن","يَكُونُوا۟","مَعَ","ٱلْخَوَالِفِ","وَطُبِعَ","عَلَىٰ","قُلُوبِهِمْ","فَهُمْ","لَا","يَفْقَهُونَ"],"marked":[0],"facts":{"verb":"رَضِيَ"}},{"id":"radia-5-119-16","words":["verb:radia"],"options":[{"bs":"bio je zadovoljan","en":"he/it was pleased"},{"bs":"zadovoljni ste","en":"you (all) are pleased"},{"bs":"pa ćeš biti zadovoljan","en":"and you will be satisfied"},{"bs":"i bio sam zadovoljan","en":"and I was pleased"}],"ref":"5:119","answerWord":"رَّضِىَ","answerSound":"audio/6e5e06248f0aa8feb2cd.m4a","quranTranslation":{"text":"Allah saith: This is a day in which their truthfulness profiteth the truthful, for theirs are Gardens underneath which rivers flow, wherein they are secure for ever, Allah taking pleasure in them and they in Him. That is the great triumph.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti zadovoljan","en":"to be pleased, to be satisfied"},"passage":["قَالَ","ٱللَّهُ","هَٰذَا","يَوْمُ","يَنفَعُ","ٱلصَّٰدِقِينَ","صِدْقُهُمْ","لَهُمْ","جَنَّٰتٌ","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدًا","رَّضِىَ","ٱللَّهُ","عَنْهُمْ","وَرَضُوا۟","عَنْهُ","ذَٰلِكَ","ٱلْفَوْزُ","ٱلْعَظِيمُ"],"marked":[16],"facts":{"verb":"رَضِيَ"}},{"id":"radia-48-18-1","words":["verb:radia"],"options":[{"bs":"bio je zadovoljan","en":"he/it was pleased"},{"bs":"pa ćeš biti zadovoljan","en":"and you will be satisfied"},{"bs":"i zadovoljne su","en":"and they are pleased"},{"bs":"zar ste bili zadovoljni?","en":"were you (all) pleased?"}],"ref":"48:18","answerWord":"رَضِىَ","answerSound":"audio/33f01515a18926ababbf.m4a","quranTranslation":{"text":"Allah was well pleased with the believers when they swore allegiance unto thee beneath the tree, and He knew what was in their hearts, and He sent down peace of reassurance on them, and hath rewarded them with a near victory;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti zadovoljan","en":"to be pleased, to be satisfied"},"passage":["لَّقَدْ","رَضِىَ","ٱللَّهُ","عَنِ","ٱلْمُؤْمِنِينَ","إِذْ","يُبَايِعُونَكَ","تَحْتَ","ٱلشَّجَرَةِ","فَعَلِمَ","مَا","فِى","قُلُوبِهِمْ","فَأَنزَلَ","ٱلسَّكِينَةَ","عَلَيْهِمْ","وَأَثَٰبَهُمْ","فَتْحًا","قَرِيبًا"],"marked":[1],"facts":{"verb":"رَضِيَ"}},{"id":"radia-9-38-15","words":["verb:radia"],"options":[{"bs":"zar ste bili zadovoljni?","en":"were you (all) pleased?"},{"bs":"zadovoljni ste","en":"you (all) are pleased"},{"bs":"bio je zadovoljan","en":"he/it was pleased"},{"bs":"zadovoljili su se","en":"they were satisfied"}],"ref":"9:38","answerWord":"أَرَضِيتُم","answerSound":"audio/590641a3997c40117b24.m4a","quranTranslation":{"text":"O ye who believe! What aileth you that when it is said unto you: Go forth in the way of Allah, ye are bowed down to the ground with heaviness. Take ye pleasure in the life of the world rather than in the Hereafter? The comfort of the life of the world is but little in the Hereafter.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti zadovoljan","en":"to be pleased, to be satisfied"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","مَا","لَكُمْ","إِذَا","قِيلَ","لَكُمُ","ٱنفِرُوا۟","فِى","سَبِيلِ","ٱللَّهِ","ٱثَّاقَلْتُمْ","إِلَى","ٱلْأَرْضِ","أَرَضِيتُم","بِٱلْحَيَوٰةِ","ٱلدُّنْيَا","مِنَ","ٱلْءَاخِرَةِ","فَمَا","مَتَٰعُ","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","فِى","ٱلْءَاخِرَةِ","إِلَّا","قَلِيلٌ"],"marked":[15],"facts":{"verb":"رَضِيَ"}},{"id":"radia-9-83-18","words":["verb:radia"],"options":[{"bs":"bili ste zadovoljni","en":"you (all) were pleased"},{"bs":"i zadovoljan je","en":"and he/it is pleased"},{"bs":"zadovoljili su se","en":"they were satisfied"},{"bs":"i bio je zadovoljan","en":"and he/it was pleased"}],"ref":"9:83","answerWord":"رَضِيتُم","answerSound":"audio/949fa9caf36d849b8f77.m4a","quranTranslation":{"text":"If Allah bring thee back (from the campaign) unto a party of them and they ask of thee leave to go out (to fight), then say unto them: Ye shall never more go out with me nor fight with me against a foe. Ye were content with sitting still the first time. So sit still, with the useless.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti zadovoljan","en":"to be pleased, to be satisfied"},"passage":["فَإِن","رَّجَعَكَ","ٱللَّهُ","إِلَىٰ","طَآئِفَةٍ","مِّنْهُمْ","فَٱسْتَـْٔذَنُوكَ","لِلْخُرُوجِ","فَقُل","لَّن","تَخْرُجُوا۟","مَعِىَ","أَبَدًا","وَلَن","تُقَٰتِلُوا۟","مَعِىَ","عَدُوًّا","إِنَّكُمْ","رَضِيتُم","بِٱلْقُعُودِ","أَوَّلَ","مَرَّةٍ","فَٱقْعُدُوا۟","مَعَ","ٱلْخَٰلِفِينَ"],"marked":[18],"facts":{"verb":"رَضِيَ"}},{"id":"radia-9-96-2","words":["verb:radia"],"options":[{"bs":"da budete zadovoljni","en":"so that you (all) may be pleased"},{"bs":"i zadovoljne su","en":"and they are pleased"},{"bs":"i bio sam zadovoljan","en":"and I was pleased"},{"bs":"bio je zadovoljan","en":"he/it was pleased"}],"ref":"9:96","answerWord":"لِتَرْضَوْا۟","answerSound":"audio/0df715d07a3fbe00f605.m4a","quranTranslation":{"text":"They swear unto you, that ye may accept them. Though ye accept them. Allah verily accepteth not wrongdoing folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti zadovoljan","en":"to be pleased, to be satisfied"},"passage":["يَحْلِفُونَ","لَكُمْ","لِتَرْضَوْا۟","عَنْهُمْ","فَإِن","تَرْضَوْا۟","عَنْهُمْ","فَإِنَّ","ٱللَّهَ","لَا","يَرْضَىٰ","عَنِ","ٱلْقَوْمِ","ٱلْفَٰسِقِينَ"],"marked":[2],"facts":{"verb":"رَضِيَ"}},{"id":"radia-9-96-5","words":["verb:radia"],"options":[{"bs":"zadovoljni ste","en":"you (all) are pleased"},{"bs":"bio je zadovoljan","en":"he/it was pleased"},{"bs":"bili ste zadovoljni","en":"you (all) were pleased"},{"bs":"i bili su zadovoljni","en":"and they were pleased"}],"ref":"9:96","answerWord":"تَرْضَوْا۟","answerSound":"audio/41e20ad480fd0a7e7980.m4a","quranTranslation":{"text":"They swear unto you, that ye may accept them. Though ye accept them. Allah verily accepteth not wrongdoing folk.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti zadovoljan","en":"to be pleased, to be satisfied"},"passage":["يَحْلِفُونَ","لَكُمْ","لِتَرْضَوْا۟","عَنْهُمْ","فَإِن","تَرْضَوْا۟","عَنْهُمْ","فَإِنَّ","ٱللَّهَ","لَا","يَرْضَىٰ","عَنِ","ٱلْقَوْمِ","ٱلْفَٰسِقِينَ"],"marked":[5],"facts":{"verb":"رَضِيَ"}},{"id":"radia-20-109-9","words":["verb:radia"],"options":[{"bs":"i bio je zadovoljan","en":"and he/it was pleased"},{"bs":"da budete zadovoljni","en":"so that you (all) may be pleased"},{"bs":"i bili su zadovoljni","en":"and they were pleased"},{"bs":"bili ste zadovoljni","en":"you (all) were pleased"}],"ref":"20:109","answerWord":"وَرَضِىَ","answerSound":"audio/f655685f73e06e4b1993.m4a","quranTranslation":{"text":"On that day no intercession availeth save (that of) him unto whom the Beneficent hath given leave and whose word He accepteth.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti zadovoljan","en":"to be pleased, to be satisfied"},"passage":["يَوْمَئِذٍ","لَّا","تَنفَعُ","ٱلشَّفَٰعَةُ","إِلَّا","مَنْ","أَذِنَ","لَهُ","ٱلرَّحْمَٰنُ","وَرَضِىَ","لَهُۥ","قَوْلًا"],"marked":[9],"facts":{"verb":"رَضِيَ"}},{"id":"radia-53-26-17","words":["verb:radia"],"options":[{"bs":"i zadovoljan je","en":"and he/it is pleased"},{"bs":"zadovoljili su se","en":"they were satisfied"},{"bs":"bili ste zadovoljni","en":"you (all) were pleased"},{"bs":"zadovoljni ste","en":"you (all) are pleased"}],"ref":"53:26","answerWord":"وَيَرْضَىٰٓ","answerSound":"audio/5d419be678a270f5cf03.m4a","quranTranslation":{"text":"And how many angels are in the heavens whose intercession availeth naught save after Allah giveth leave to whom He chooseth and accepteth.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"biti zadovoljan","en":"to be pleased, to be satisfied"},"passage":["وَكَم","مِّن","مَّلَكٍ","فِى","ٱلسَّمَٰوَٰتِ","لَا","تُغْنِى","شَفَٰعَتُهُمْ","شَيْـًٔا","إِلَّا","مِنۢ","بَعْدِ","أَن","يَأْذَنَ","ٱللَّهُ","لِمَن","يَشَآءُ","وَيَرْضَىٰٓ"],"marked":[17],"facts":{"verb":"رَضِيَ"}},{"id":"ijtaba-6-87-4","words":["verb:ijtaba"],"options":[{"bs":"i izabrali smo ih","en":"and we chose them"},{"bs":"pa ga je odabrao","en":"so He chose him"},{"bs":"izabrao vas je","en":"he/it chose you (all)"},{"bs":"i izabrali smo","en":"and we chose"}],"ref":"6:87","answerWord":"وَٱجْتَبَيْنَٰهُمْ","answerSound":"audio/85adbf4450f837274b01.m4a","quranTranslation":{"text":"With some of their forefathers and their offspring and their brethren; and We chose them and guided them unto a straight path.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odabrati, izabrati","en":"to choose, to select"},"passage":["وَمِنْ","ءَابَآئِهِمْ","وَذُرِّيَّٰتِهِمْ","وَإِخْوَٰنِهِمْ","وَٱجْتَبَيْنَٰهُمْ","وَهَدَيْنَٰهُمْ","إِلَىٰ","صِرَٰطٍ","مُّسْتَقِيمٍ"],"marked":[4],"facts":{"verb":"اجْتَبَى"}},{"id":"ijtaba-7-203-6","words":["verb:ijtaba"],"options":[{"bs":"izabrao si je","en":"you chose it"},{"bs":"izabrao vas je","en":"he/it chose you (all)"},{"bs":"pa ga je odabrao","en":"so He chose him"},{"bs":"bira","en":"he/it chooses"}],"ref":"7:203","answerWord":"ٱجْتَبَيْتَهَا","answerSound":"audio/07778a5c6d856f4b6048.m4a","quranTranslation":{"text":"And when thou bringest not a verse for them they say: Why hast thou not chosen it? Say: I follow only that which is inspired in me from my Lord. This (Qur'an) is insight from your Lord, and a guidance and a mercy for a people that believe.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odabrati, izabrati","en":"to choose, to select"},"passage":["وَإِذَا","لَمْ","تَأْتِهِم","بِـَٔايَةٍ","قَالُوا۟","لَوْلَا","ٱجْتَبَيْتَهَا","قُلْ","إِنَّمَآ","أَتَّبِعُ","مَا","يُوحَىٰٓ","إِلَىَّ","مِن","رَّبِّى","هَٰذَا","بَصَآئِرُ","مِن","رَّبِّكُمْ","وَهُدًى","وَرَحْمَةٌ","لِّقَوْمٍ","يُؤْمِنُونَ"],"marked":[6],"facts":{"verb":"اجْتَبَى"}},{"id":"ijtaba-12-6-1","words":["verb:ijtaba"],"options":[{"bs":"bira te","en":"he/it chooses you"},{"bs":"bira","en":"he/it chooses"},{"bs":"izabrao ga je","en":"he/it chose him"},{"bs":"i izabrali smo ih","en":"and we chose them"}],"ref":"12:6","answerWord":"يَجْتَبِيكَ","answerSound":"audio/b6cb2d4f1e0b080dd72a.m4a","quranTranslation":{"text":"Thus thy Lord will prefer thee and will teach thee the interpretation of events, and will perfect His grace upon thee and upon the family of Jacob as He perfected it upon thy forefathers, Abraham and Isaac. Lo! thy Lord is Knower, Wise.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odabrati, izabrati","en":"to choose, to select"},"passage":["وَكَذَٰلِكَ","يَجْتَبِيكَ","رَبُّكَ","وَيُعَلِّمُكَ","مِن","تَأْوِيلِ","ٱلْأَحَادِيثِ","وَيُتِمُّ","نِعْمَتَهُۥ","عَلَيْكَ","وَعَلَىٰٓ","ءَالِ","يَعْقُوبَ","كَمَآ","أَتَمَّهَا","عَلَىٰٓ","أَبَوَيْكَ","مِن","قَبْلُ","إِبْرَٰهِيمَ","وَإِسْحَٰقَ","إِنَّ","رَبَّكَ","عَلِيمٌ","حَكِيمٌ"],"marked":[1],"facts":{"verb":"اجْتَبَى"}},{"id":"ijtaba-16-121-2","words":["verb:ijtaba"],"options":[{"bs":"izabrao ga je","en":"he/it chose him"},{"bs":"izabrao si je","en":"you chose it"},{"bs":"i izabrali smo ih","en":"and we chose them"},{"bs":"izabrao vas je","en":"he/it chose you (all)"}],"ref":"16:121","answerWord":"ٱجْتَبَىٰهُ","answerSound":"audio/3a107963ba2f8e45166d.m4a","quranTranslation":{"text":"Thankful for His bounties; He chose him and He guided him unto a straight path.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odabrati, izabrati","en":"to choose, to select"},"passage":["شَاكِرًا","لِّأَنْعُمِهِ","ٱجْتَبَىٰهُ","وَهَدَىٰهُ","إِلَىٰ","صِرَٰطٍ","مُّسْتَقِيمٍ"],"marked":[2],"facts":{"verb":"اجْتَبَى"}},{"id":"ijtaba-19-58-20","words":["verb:ijtaba"],"options":[{"bs":"i izabrali smo","en":"and we chose"},{"bs":"bira","en":"he/it chooses"},{"bs":"izabrao si je","en":"you chose it"},{"bs":"bira te","en":"he/it chooses you"}],"ref":"19:58","answerWord":"وَٱجْتَبَيْنَآ","answerSound":"audio/76c072624f6c9697bef1.m4a","quranTranslation":{"text":"These are they unto whom Allah showed favour from among the prophets, of the seed of Adam and of those whom We carried (in the ship) with Noah, and of the seed of Abraham and Israel, and from among those whom We guided and chose. When the revelations of the Beneficent were recited unto them, they fell down, adoring and weeping.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odabrati, izabrati","en":"to choose, to select"},"passage":["أُو۟لَٰٓئِكَ","ٱلَّذِينَ","أَنْعَمَ","ٱللَّهُ","عَلَيْهِم","مِّنَ","ٱلنَّبِيِّۦنَ","مِن","ذُرِّيَّةِ","ءَادَمَ","وَمِمَّنْ","حَمَلْنَا","مَعَ","نُوحٍ","وَمِن","ذُرِّيَّةِ","إِبْرَٰهِيمَ","وَإِسْرَٰٓءِيلَ","وَمِمَّنْ","هَدَيْنَا","وَٱجْتَبَيْنَآ","إِذَا","تُتْلَىٰ","عَلَيْهِمْ","ءَايَٰتُ","ٱلرَّحْمَٰنِ","خَرُّوا۟","سُجَّدًا","وَبُكِيًّا"],"marked":[20],"facts":{"verb":"اجْتَبَى"}},{"id":"ijtaba-20-122-1","words":["verb:ijtaba"],"options":[{"bs":"izabrao ga je","en":"he/it chose him"},{"bs":"izabrao vas je","en":"he/it chose you (all)"},{"bs":"i izabrali smo ih","en":"and we chose them"},{"bs":"bira","en":"he/it chooses"}],"ref":"20:122","answerWord":"ٱجْتَبَٰهُ","answerSound":"audio/dc94da13b04685850a48.m4a","quranTranslation":{"text":"Then his Lord chose him, and relented toward him, and guided him.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odabrati, izabrati","en":"to choose, to select"},"passage":["ثُمَّ","ٱجْتَبَٰهُ","رَبُّهُۥ","فَتَابَ","عَلَيْهِ","وَهَدَىٰ"],"marked":[1],"facts":{"verb":"اجْتَبَى"}},{"id":"ijtaba-68-50-0","words":["verb:ijtaba"],"options":[{"bs":"pa ga je odabrao","en":"so He chose him"},{"bs":"i izabrali smo ih","en":"and we chose them"},{"bs":"bira","en":"he/it chooses"},{"bs":"bira te","en":"he/it chooses you"}],"ref":"68:50","answerWord":"فَٱجْتَبَٰهُ","answerSound":"audio/9aff37fb53ea6cffce5b.m4a","quranTranslation":{"text":"But his Lord chose him and placed him among the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"odabrati, izabrati","en":"to choose, to select"},"passage":["فَٱجْتَبَٰهُ","رَبُّهُۥ","فَجَعَلَهُۥ","مِنَ","ٱلصَّٰلِحِينَ"],"marked":[0],"facts":{"verb":"اجْتَبَى"}},{"id":"zahara-2-58-2-1","words":["verb:zahara-2"],"options":[{"bs":"izriču zihar","en":"they pronounce ẓihār"},{"bs":"podržali su ih","en":"they backed them"},{"bs":"i podržali su","en":"and they backed"},{"bs":"izričete zihar","en":"you (all) pronounce ẓihār"}],"ref":"58:2","answerWord":"يُظَٰهِرُونَ","answerSound":"audio/a1d640a053ff6d6cb0b3.m4a","quranTranslation":{"text":"Such of you as put away your wives (by saying they are as their mothers) - They are not their mothers; none are their mothers except those who gave them birth - they indeed utter an ill word and a lie. And lo! Allah is Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"podržati, pomagati; izreći zihar","en":"to back, to support; to swear ẓihār"},"passage":["ٱلَّذِينَ","يُظَٰهِرُونَ","مِنكُم","مِّن","نِّسَآئِهِم","مَّا","هُنَّ","أُمَّهَٰتِهِمْ","إِنْ","أُمَّهَٰتُهُمْ","إِلَّا","ٱلَّٰٓـِٔى","وَلَدْنَهُمْ","وَإِنَّهُمْ","لَيَقُولُونَ","مُنكَرًا","مِّنَ","ٱلْقَوْلِ","وَزُورًا","وَإِنَّ","ٱللَّهَ","لَعَفُوٌّ","غَفُورٌ"],"marked":[1],"facts":{"verb":"ظَاهَرَ"}},{"id":"zahara-2-9-4-10","words":["verb:zahara-2"],"options":[{"bs":"podržavaju","en":"they back"},{"bs":"izričete zihar","en":"you (all) pronounce ẓihār"},{"bs":"i podržali su","en":"and they backed"},{"bs":"podržali su ih","en":"they backed them"}],"ref":"9:4","answerWord":"يُظَٰهِرُوا۟","answerSound":"audio/15f55bba03766ea6da19.m4a","quranTranslation":{"text":"Excepting those of the idolaters with whom ye (Muslims) have a treaty, and who have since abated nothing of your right nor have supported anyone against you. (As for these), fulfil their treaty to them till their term. Lo! Allah loveth those who keep their duty (unto Him).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"podržati, pomagati; izreći zihar","en":"to back, to support; to swear ẓihār"},"passage":["إِلَّا","ٱلَّذِينَ","عَٰهَدتُّم","مِّنَ","ٱلْمُشْرِكِينَ","ثُمَّ","لَمْ","يَنقُصُوكُمْ","شَيْـًٔا","وَلَمْ","يُظَٰهِرُوا۟","عَلَيْكُمْ","أَحَدًا","فَأَتِمُّوٓا۟","إِلَيْهِمْ","عَهْدَهُمْ","إِلَىٰ","مُدَّتِهِمْ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلْمُتَّقِينَ"],"marked":[10],"facts":{"verb":"ظَاهَرَ"}},{"id":"zahara-2-33-4-12","words":["verb:zahara-2"],"options":[{"bs":"izričete zihar","en":"you (all) pronounce ẓihār"},{"bs":"i podržali su","en":"and they backed"},{"bs":"izriču zihar","en":"they pronounce ẓihār"},{"bs":"podržali su ih","en":"they backed them"}],"ref":"33:4","answerWord":"تُظَٰهِرُونَ","answerSound":"audio/c791a8ccd24f9a84f12d.m4a","quranTranslation":{"text":"Allah hath not assigned unto any man two hearts within his body, nor hath He made your wives whom ye declare (to be your mothers) your mothers, nor hath He made those whom ye claim (to be your sons) your sons. This is but a saying of your mouths. But Allah saith the truth and He showeth the way.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"podržati, pomagati; izreći zihar","en":"to back, to support; to swear ẓihār"},"passage":["مَّا","جَعَلَ","ٱللَّهُ","لِرَجُلٍ","مِّن","قَلْبَيْنِ","فِى","جَوْفِهِۦ","وَمَا","جَعَلَ","أَزْوَٰجَكُمُ","ٱلَّٰٓـِٔى","تُظَٰهِرُونَ","مِنْهُنَّ","أُمَّهَٰتِكُمْ","وَمَا","جَعَلَ","أَدْعِيَآءَكُمْ","أَبْنَآءَكُمْ","ذَٰلِكُمْ","قَوْلُكُم","بِأَفْوَٰهِكُمْ","وَٱللَّهُ","يَقُولُ","ٱلْحَقَّ","وَهُوَ","يَهْدِى","ٱلسَّبِيلَ"],"marked":[12],"facts":{"verb":"ظَاهَرَ"}},{"id":"zahara-2-33-26-2","words":["verb:zahara-2"],"options":[{"bs":"podržali su ih","en":"they backed them"},{"bs":"podržavaju","en":"they back"},{"bs":"izričete zihar","en":"you (all) pronounce ẓihār"},{"bs":"i podržali su","en":"and they backed"}],"ref":"33:26","answerWord":"ظَٰهَرُوهُم","answerSound":"audio/29b9857117b9d5a6f9ce.m4a","quranTranslation":{"text":"And He brought those of the People of the Scripture who supported them down from their strongholds, and cast panic into their hearts. Some ye slew, and ye made captive some.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"podržati, pomagati; izreći zihar","en":"to back, to support; to swear ẓihār"},"passage":["وَأَنزَلَ","ٱلَّذِينَ","ظَٰهَرُوهُم","مِّنْ","أَهْلِ","ٱلْكِتَٰبِ","مِن","صَيَاصِيهِمْ","وَقَذَفَ","فِى","قُلُوبِهِمُ","ٱلرُّعْبَ","فَرِيقًا","تَقْتُلُونَ","وَتَأْسِرُونَ","فَرِيقًا"],"marked":[2],"facts":{"verb":"ظَاهَرَ"}},{"id":"zahara-2-60-9-11","words":["verb:zahara-2"],"options":[{"bs":"i podržali su","en":"and they backed"},{"bs":"podržavaju","en":"they back"},{"bs":"izričete zihar","en":"you (all) pronounce ẓihār"},{"bs":"podržali su ih","en":"they backed them"}],"ref":"60:9","answerWord":"وَظَٰهَرُوا۟","answerSound":"audio/723f9f4f42a19e8b6e15.m4a","quranTranslation":{"text":"Allah forbiddeth you only those who warred against you on account of religion and have driven you out from your homes and helped to drive you out, that ye make friends of them. Whosoever maketh friends of them - (All) such are wrong-doers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"podržati, pomagati; izreći zihar","en":"to back, to support; to swear ẓihār"},"passage":["إِنَّمَا","يَنْهَىٰكُمُ","ٱللَّهُ","عَنِ","ٱلَّذِينَ","قَٰتَلُوكُمْ","فِى","ٱلدِّينِ","وَأَخْرَجُوكُم","مِّن","دِيَٰرِكُمْ","وَظَٰهَرُوا۟","عَلَىٰٓ","إِخْرَاجِكُمْ","أَن","تَوَلَّوْهُمْ","وَمَن","يَتَوَلَّهُمْ","فَأُو۟لَٰٓئِكَ","هُمُ","ٱلظَّٰلِمُونَ"],"marked":[11],"facts":{"verb":"ظَاهَرَ"}}]