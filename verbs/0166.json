{"rank": 166, "root": "أمن", "form": 1, "lemma": "أَمِنَ", "count": 20, "ayahCount": 16, "share": 0.1, "meaning": {"bs": "osjećati se sigurnim", "en": "to feel safe, to be secure", "tr": "güvende olmak, emin olmak", "fr": "se sentir en sécurité, être en sûreté", "id": "merasa aman", "ur": "امن میں ہونا، محفوظ ہونا", "bn": "নিরাপদ বোধ করা, নিরাপদ থাকা", "fa": "در امان بودن، ایمن بودن"}, "lemmaSpoken": "audio/eb182671cf724ad0cdbf.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "أَمِنَ", "plain": "أَمِنَ", "quran": true, "notUsed": false, "spoken": "audio/eb182671cf724ad0cdbf.m4a", "recited": "audio/a7012a938918366b4c27.m4a", "recitedText": "أَمِنَ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يَأْمَنُ", "plain": "يَأْمَنُ", "quran": true, "notUsed": false, "spoken": "audio/6ceadfa6320e539fc10e.m4a", "recited": "audio/a08b22585d7464a7d45e.m4a", "recitedText": "يَأْمَنُ"}], "nouns": {"participle": {"lemma": "آمِن", "count": 16, "spoken": "audio/f9576c7923fa8afca686.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "أَمِنْتُ", "plain": "أَمِنْتُ", "quran": false, "notUsed": false, "spoken": "audio/63a4fa2368e8c8e280c7.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "أَمِنَّا", "plain": "أَمِنَّا", "quran": false, "notUsed": false, "spoken": "audio/64ee95675f053fa73d48.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "أَمِنْتَ", "plain": "أَمِنْتَ", "quran": false, "notUsed": false, "spoken": "audio/ace79e2004a5ffc0160f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "أَمِنْتِ", "plain": "أَمِنْتِ", "quran": false, "notUsed": false, "spoken": "audio/bfe59fc3b5e3e29f3dfb.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "أَمِنْتُمَا", "plain": "أَمِنْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/30cfa8e27924e44d13e2.m4a", "recited": null, "recited