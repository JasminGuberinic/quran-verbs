[{"id":"anzala-2-4-3","words":["verb:anzala"],"options":[{"bs":"objavljeno je","en":"it was sent down"},{"bs":"objavili smo","en":"we sent down"},{"bs":"objavio si","en":"you sent down"},{"bs":"objavio ga je","en":"he/it sent it down"}],"ref":"2:4","answerWord":"أُنزِلَ","answerSound":"audio/7b6c849cc802dcd3e3c5.m4a","quranTranslation":{"text":"And who believe in that which is revealed unto thee (Muhammad) and that which was revealed before thee, and are certain of the Hereafter.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["وَٱلَّذِينَ","يُؤْمِنُونَ","بِمَآ","أُنزِلَ","إِلَيْكَ","وَمَآ","أُنزِلَ","مِن","قَبْلِكَ","وَبِٱلْءَاخِرَةِ","هُمْ","يُوقِنُونَ"],"marked":[3,6],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-47-9-4","words":["verb:anzala"],"options":[{"bs":"objavio je","en":"he/it sent down"},{"bs":"objavi!","en":"send down!"},{"bs":"objavili smo ga","en":"we sent it down"},{"bs":"objavio ga je","en":"he/it sent it down"}],"ref":"47:9","answerWord":"أَنزَلَ","answerSound":"audio/9b281584009494e73b4c.m4a","quranTranslation":{"text":"That is because they are averse to that which Allah hath revealed, therefor maketh He their actions fruitless.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["ذَٰلِكَ","بِأَنَّهُمْ","كَرِهُوا۟","مَآ","أَنزَلَ","ٱللَّهُ","فَأَحْبَطَ","أَعْمَٰلَهُمْ"],"marked":[4],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-15-90-1","words":["verb:anzala"],"options":[{"bs":"spustili smo","en":"We sent down"},{"bs":"objavili smo ga","en":"we sent it down"},{"bs":"objavljeno je","en":"it was sent down"},{"bs":"objavio ga je","en":"he/it sent it down"}],"ref":"15:90","answerWord":"أَنزَلْنَا","answerSound":"audio/d5c7a8a0b72e31fc1ae1.m4a","quranTranslation":{"text":"Such as We send down for those who make division,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["كَمَآ","أَنزَلْنَا","عَلَى","ٱلْمُقْتَسِمِينَ"],"marked":[1],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-6-92-2","words":["verb:anzala"],"options":[{"bs":"objavili smo ga","en":"we sent it down"},{"bs":"spustili smo","en":"We sent down"},{"bs":"objavio sam","en":"I sent down"},{"bs":"objavi!","en":"send down!"}],"ref":"6:92","answerWord":"أَنزَلْنَٰهُ","answerSound":"audio/116f16a1dcb03781d6ea.m4a","quranTranslation":{"text":"And this is a blessed Scripture which We have revealed, confirming that which (was revealed) before it, that thou mayst warn the Mother of Villages and those around her. Those who believe in the Hereafter believe herein, and they are careful of their worship.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["وَهَٰذَا","كِتَٰبٌ","أَنزَلْنَٰهُ","مُبَارَكٌ","مُّصَدِّقُ","ٱلَّذِى","بَيْنَ","يَدَيْهِ","وَلِتُنذِرَ","أُمَّ","ٱلْقُرَىٰ","وَمَنْ","حَوْلَهَا","وَٱلَّذِينَ","يُؤْمِنُونَ","بِٱلْءَاخِرَةِ","يُؤْمِنُونَ","بِهِۦ","وَهُمْ","عَلَىٰ","صَلَاتِهِمْ","يُحَافِظُونَ"],"marked":[2],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-2-57-3","words":["verb:anzala"],"options":[{"bs":"i objavili smo","en":"and we sent down"},{"bs":"objavi!","en":"send down!"},{"bs":"objavili smo je","en":"we sent it down"},{"bs":"objavio ga je","en":"he/it sent it down"}],"ref":"2:57","answerWord":"وَأَنزَلْنَا","answerSound":"audio/ffee7f162071d9945014.m4a","quranTranslation":{"text":"And We caused the white cloud to overshadow you and sent down on you the manna and the quails, (saying): Eat of the good things wherewith We have provided you - they wronged Us not, but they did wrong themselves.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["وَظَلَّلْنَا","عَلَيْكُمُ","ٱلْغَمَامَ","وَأَنزَلْنَا","عَلَيْكُمُ","ٱلْمَنَّ","وَٱلسَّلْوَىٰ","كُلُوا۟","مِن","طَيِّبَٰتِ","مَا","رَزَقْنَٰكُمْ","وَمَا","ظَلَمُونَا","وَلَٰكِن","كَانُوٓا۟","أَنفُسَهُمْ","يَظْلِمُونَ"],"marked":[3],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-2-99-1","words":["verb:anzala"],"options":[{"bs":"objavili smo","en":"we sent down"},{"bs":"spustili ste ga","en":"you (all) sent it down"},{"bs":"zar je objavljeno?","en":"was it sent down?"},{"bs":"objavio sam","en":"I sent down"}],"ref":"2:99","answerWord":"أَنزَلْنَآ","answerSound":"audio/6a50330244ad7ca38b3c.m4a","quranTranslation":{"text":"Verily We have revealed unto thee clear tokens, and only miscreants will disbelieve in them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["وَلَقَدْ","أَنزَلْنَآ","إِلَيْكَ","ءَايَٰتٍۭ","بَيِّنَٰتٍ","وَمَا","يَكْفُرُ","بِهَآ","إِلَّا","ٱلْفَٰسِقُونَ"],"marked":[1],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-9-86-1","words":["verb:anzala"],"options":[{"bs":"objavljeno je","en":"it was sent down"},{"bs":"pa je objavio","en":"so he/it sent down"},{"bs":"objavi!","en":"send down!"},{"bs":"spustili smo","en":"We sent down"}],"ref":"9:86","answerWord":"أُنزِلَتْ","answerSound":"audio/fd60b1e779ca894d2aad.m4a","quranTranslation":{"text":"And when a surah is revealed (which saith): Believe in Allah and strive along with His messenger, the men of wealth among them still ask leave of thee and say: Suffer us to be with those who sit (at home).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["وَإِذَآ","أُنزِلَتْ","سُورَةٌ","أَنْ","ءَامِنُوا۟","بِٱللَّهِ","وَجَٰهِدُوا۟","مَعَ","رَسُولِهِ","ٱسْتَـْٔذَنَكَ","أُو۟لُوا۟","ٱلطَّوْلِ","مِنْهُمْ","وَقَالُوا۟","ذَرْنَا","نَكُن","مَّعَ","ٱلْقَٰعِدِينَ"],"marked":[1],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-4-174-7","words":["verb:anzala"],"options":[{"bs":"i objavili smo","en":"and we sent down"},{"bs":"objavio je","en":"he/it sent down"},{"bs":"objavio si","en":"you sent down"},{"bs":"zar je objavljeno?","en":"was it sent down?"}],"ref":"4:174","answerWord":"وَأَنزَلْنَآ","answerSound":"audio/05f3121d766a1f6b763a.m4a","quranTranslation":{"text":"O mankind! Now hath a proof from your Lord come unto you, and We have sent down unto you a clear light;","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["يَٰٓأَيُّهَا","ٱلنَّاسُ","قَدْ","جَآءَكُم","بُرْهَٰنٌ","مِّن","رَّبِّكُمْ","وَأَنزَلْنَآ","إِلَيْكُمْ","نُورًا","مُّبِينًا"],"marked":[7],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-3-53-3","words":["verb:anzala"],"options":[{"bs":"objavio si","en":"you sent down"},{"bs":"spustili smo","en":"We sent down"},{"bs":"objavljeno je","en":"it was sent down"},{"bs":"spusti me","en":"cause me to land"}],"ref":"3:53","answerWord":"أَنزَلْتَ","answerSound":"audio/a868aa130c7775305705.m4a","quranTranslation":{"text":"Our Lord! We believe in that which Thou hast revealed and we follow him whom Thou hast sent. Enrol us among those who witness (to the truth).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["رَبَّنَآ","ءَامَنَّا","بِمَآ","أَنزَلْتَ","وَٱتَّبَعْنَا","ٱلرَّسُولَ","فَٱكْتُبْنَا","مَعَ","ٱلشَّٰهِدِينَ"],"marked":[3],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-2-41-2","words":["verb:anzala"],"options":[{"bs":"objavio sam","en":"I sent down"},{"bs":"objavi!","en":"send down!"},{"bs":"objavljeno je","en":"it was sent down"},{"bs":"i objavili smo","en":"and we sent down"}],"ref":"2:41","answerWord":"أَنزَلْتُ","answerSound":"audio/5c1619e41a500ed2af55.m4a","quranTranslation":{"text":"And believe in that which I reveal, confirming that which ye possess already (of the Scripture), and be not first to disbelieve therein, and part not with My revelations for a trifling price, and keep your duty unto Me.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["وَءَامِنُوا۟","بِمَآ","أَنزَلْتُ","مُصَدِّقًا","لِّمَا","مَعَكُمْ","وَلَا","تَكُونُوٓا۟","أَوَّلَ","كَافِرٍۭ","بِهِۦ","وَلَا","تَشْتَرُوا۟","بِـَٔايَٰتِى","ثَمَنًا","قَلِيلًا","وَإِيَّٰىَ","فَٱتَّقُونِ"],"marked":[2],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-3-65-7","words":["verb:anzala"],"options":[{"bs":"objavljeno je","en":"it was sent down"},{"bs":"objavi!","en":"send down!"},{"bs":"zar je objavljeno?","en":"was it sent down?"},{"bs":"objavili smo je","en":"we sent it down"}],"ref":"3:65","answerWord":"أُنزِلَتِ","answerSound":"audio/6300acf8db74d471ca4b.m4a","quranTranslation":{"text":"O People of the Scripture! Why will ye argue about Abraham, when the Torah and the Gospel were not revealed till after him? Have ye then no sense?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["يَٰٓأَهْلَ","ٱلْكِتَٰبِ","لِمَ","تُحَآجُّونَ","فِىٓ","إِبْرَٰهِيمَ","وَمَآ","أُنزِلَتِ","ٱلتَّوْرَىٰةُ","وَٱلْإِنجِيلُ","إِلَّا","مِنۢ","بَعْدِهِۦٓ","أَفَلَا","تَعْقِلُونَ"],"marked":[7],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-4-166-6","words":["verb:anzala"],"options":[{"bs":"objavio ga je","en":"he/it sent it down"},{"bs":"pa je objavio","en":"so he/it sent down"},{"bs":"objavio si","en":"you sent down"},{"bs":"i objavljeno je","en":"and it was sent down"}],"ref":"4:166","answerWord":"أَنزَلَهُۥ","answerSound":"audio/6346313f1b8fa5b379dc.m4a","quranTranslation":{"text":"But Allah (Himself) testifieth concerning that which He hath revealeth unto thee; in His knowledge hath He revealed it; and the angels also testify. And Allah is sufficient Witness.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["لَّٰكِنِ","ٱللَّهُ","يَشْهَدُ","بِمَآ","أَنزَلَ","إِلَيْكَ","أَنزَلَهُۥ","بِعِلْمِهِۦ","وَٱلْمَلَٰٓئِكَةُ","يَشْهَدُونَ","وَكَفَىٰ","بِٱللَّهِ","شَهِيدًا"],"marked":[6],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-5-114-6","words":["verb:anzala"],"options":[{"bs":"objavi!","en":"send down!"},{"bs":"objavili smo","en":"we sent down"},{"bs":"objavio ga je","en":"he/it sent it down"},{"bs":"objavljeno je","en":"it was sent down"}],"ref":"5:114","answerWord":"أَنزِلْ","answerSound":"audio/72c077ddb7d24cf924d9.m4a","quranTranslation":{"text":"Jesus, son of Mary, said: O Allah, Lord of us! Send down for us a table spread with food from heaven, that it may be a feast for us, for the first of us and for the last of us, and a sign from Thee. Give us sustenance, for Thou art the Best of Sustainers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["قَالَ","عِيسَى","ٱبْنُ","مَرْيَمَ","ٱللَّهُمَّ","رَبَّنَآ","أَنزِلْ","عَلَيْنَا","مَآئِدَةً","مِّنَ","ٱلسَّمَآءِ","تَكُونُ","لَنَا","عِيدًا","لِّأَوَّلِنَا","وَءَاخِرِنَا","وَءَايَةً","مِّنكَ","وَٱرْزُقْنَا","وَأَنتَ","خَيْرُ","ٱلرَّٰزِقِينَ"],"marked":[6],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-23-29-2","words":["verb:anzala"],"options":[{"bs":"spusti me","en":"cause me to land"},{"bs":"objavio si","en":"you sent down"},{"bs":"objavio ga je","en":"he/it sent it down"},{"bs":"spustili ste ga","en":"you (all) sent it down"}],"ref":"23:29","answerWord":"أَنزِلْنِى","answerSound":"audio/71cebd419b8c3298fb4d.m4a","quranTranslation":{"text":"And say: My Lord! Cause me to land at a blessed landing-place, for Thou art Best of all who bring to land.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["وَقُل","رَّبِّ","أَنزِلْنِى","مُنزَلًا","مُّبَارَكًا","وَأَنتَ","خَيْرُ","ٱلْمُنزِلِينَ"],"marked":[2],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-24-1-1","words":["verb:anzala"],"options":[{"bs":"objavili smo je","en":"we sent it down"},{"bs":"objavljeno je","en":"it was sent down"},{"bs":"spusti me","en":"cause me to land"},{"bs":"objavio ga je","en":"he/it sent it down"}],"ref":"24:1","answerWord":"أَنزَلْنَٰهَا","answerSound":"audio/1206045f615fd3f9c5a1.m4a","quranTranslation":{"text":"(Here is) a surah which We have revealed and enjoined, and wherein We have revealed plain tokens, that haply ye may take heed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["سُورَةٌ","أَنزَلْنَٰهَا","وَفَرَضْنَٰهَا","وَأَنزَلْنَا","فِيهَآ","ءَايَٰتٍۭ","بَيِّنَٰتٍ","لَّعَلَّكُمْ","تَذَكَّرُونَ"],"marked":[1],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-25-6-1","words":["verb:anzala"],"options":[{"bs":"objavio ga je","en":"he/it sent it down"},{"bs":"objavi!","en":"send down!"},{"bs":"spustili ste ga","en":"you (all) sent it down"},{"bs":"objavili smo","en":"we sent down"}],"ref":"25:6","answerWord":"أَنزَلَهُ","answerSound":"audio/6346313f1b8fa5b379dc.m4a","quranTranslation":{"text":"Say (unto them, O Muhammad): He who knoweth the secret of the heavens and the earth hath revealed it. Lo! He ever is Forgiving, Merciful.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["قُلْ","أَنزَلَهُ","ٱلَّذِى","يَعْلَمُ","ٱلسِّرَّ","فِى","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","إِنَّهُۥ","كَانَ","غَفُورًا","رَّحِيمًا"],"marked":[1],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-29-46-17","words":["verb:anzala"],"options":[{"bs":"i objavljeno je","en":"and it was sent down"},{"bs":"objavio ga je","en":"he/it sent it down"},{"bs":"i objavili smo","en":"and we sent down"},{"bs":"spusti me","en":"cause me to land"}],"ref":"29:46","answerWord":"وَأُنزِلَ","answerSound":"audio/bd3f187ab2ced609aa8b.m4a","quranTranslation":{"text":"And argue not with the People of the Scripture unless it be in (a way) that is better, save with such of them as do wrong; and say: We believe in that which hath been revealed unto us and revealed unto you; our Allah and your Allah is One, and unto Him we surrender.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["وَلَا","تُجَٰدِلُوٓا۟","أَهْلَ","ٱلْكِتَٰبِ","إِلَّا","بِٱلَّتِى","هِىَ","أَحْسَنُ","إِلَّا","ٱلَّذِينَ","ظَلَمُوا۟","مِنْهُمْ","وَقُولُوٓا۟","ءَامَنَّا","بِٱلَّذِىٓ","أُنزِلَ","إِلَيْنَا","وَأُنزِلَ","إِلَيْكُمْ","وَإِلَٰهُنَا","وَإِلَٰهُكُمْ","وَٰحِدٌ","وَنَحْنُ","لَهُۥ","مُسْلِمُونَ"],"marked":[17],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-38-8-0","words":["verb:anzala"],"options":[{"bs":"zar je objavljeno?","en":"was it sent down?"},{"bs":"i objavili smo","en":"and we sent down"},{"bs":"objavi!","en":"send down!"},{"bs":"objavio ga je","en":"he/it sent it down"}],"ref":"38:8","answerWord":"أَءُنزِلَ","answerSound":"audio/0944128df19913a7009d.m4a","quranTranslation":{"text":"Hath the reminder been unto him (alone) among us? Nay, but they are in doubt concerning My reminder; nay but they have not yet tasted My doom.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["أَءُنزِلَ","عَلَيْهِ","ٱلذِّكْرُ","مِنۢ","بَيْنِنَا","بَلْ","هُمْ","فِى","شَكٍّ","مِّن","ذِكْرِى","بَل","لَّمَّا","يَذُوقُوا۟","عَذَابِ"],"marked":[0],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-56-69-1","words":["verb:anzala"],"options":[{"bs":"spustili ste ga","en":"you (all) sent it down"},{"bs":"objavio ga je","en":"he/it sent it down"},{"bs":"objavljeno je","en":"it was sent down"},{"bs":"objavili smo ga","en":"we sent it down"}],"ref":"56:69","answerWord":"أَنزَلْتُمُوهُ","answerSound":"audio/f6ad31318ce0165d72dc.m4a","quranTranslation":{"text":"Is it ye who shed it from the raincloud, or are We the Shedder?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["ءَأَنتُمْ","أَنزَلْتُمُوهُ","مِنَ","ٱلْمُزْنِ","أَمْ","نَحْنُ","ٱلْمُنزِلُونَ"],"marked":[1],"facts":{"verb":"أَنزَلَ"}},{"id":"anzala-65-5-3","words":["verb:anzala"],"options":[{"bs":"objavio ga je","en":"he/it sent it down"},{"bs":"spustili ste ga","en":"you (all) sent it down"},{"bs":"spustili smo","en":"We sent down"},{"bs":"objavit ću","en":"I will send down"}],"ref":"65:5","answerWord":"أَنزَلَهُۥٓ","answerSound":"audio/39bc050f22f59c28d57f.m4a","quranTranslation":{"text":"That is the commandment of Allah which He revealeth unto you. And whoso keepeth his duty to Allah, He will remit from him his evil deeds and magnify reward for him.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"spustiti, objaviti","en":"to send down, to reveal"},"passage":["ذَٰلِكَ","أَمْرُ","ٱللَّهِ","أَنزَلَهُۥٓ","إِلَيْكُمْ","وَمَن","يَتَّقِ","ٱللَّهَ","يُكَفِّرْ","عَنْهُ","سَيِّـَٔاتِهِۦ","وَيُعْظِمْ","لَهُۥٓ","أَجْرًا"],"marked":[3],"facts":{"verb":"أَنزَلَ"}},{"id":"ahlaka-18-59-2","words":["verb:ahlaka"],"options":[{"bs":"uništili smo ih","en":"we destroyed them"},{"bs":"i uništili smo","en":"and we destroyed"},{"bs":"biva uništen","en":"he/it is destroyed"},{"bs":"pa su uništeni","en":"so they were destroyed"}],"ref":"18:59","answerWord":"أَهْلَكْنَٰهُمْ","answerSound":"audio/a59c5c58e441cddfbdcf.m4a","quranTranslation":{"text":"And (all) those townships! We destroyed them when they did wrong, and We appointed a fixed time for their destruction.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَتِلْكَ","ٱلْقُرَىٰٓ","أَهْلَكْنَٰهُمْ","لَمَّا","ظَلَمُوا۟","وَجَعَلْنَا","لِمَهْلِكِهِم","مَّوْعِدًا"],"marked":[2],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-6-26-6","words":["verb:ahlaka"],"options":[{"bs":"uništavaju","en":"they destroy"},{"bs":"uništili smo je","en":"we destroyed it"},{"bs":"pa smo uništili","en":"so we destroyed"},{"bs":"i uništava","en":"and he/it destroys"}],"ref":"6:26","answerWord":"يُهْلِكُونَ","answerSound":"audio/afbeb21f0d101e9b8f6e.m4a","quranTranslation":{"text":"And they forbid (men) from it and avoid it, and they ruin none save themselves, though they perceive not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَهُمْ","يَنْهَوْنَ","عَنْهُ","وَيَنْـَٔوْنَ","عَنْهُ","وَإِن","يُهْلِكُونَ","إِلَّآ","أَنفُسَهُمْ","وَمَا","يَشْعُرُونَ"],"marked":[6],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-6-47-10","words":["verb:ahlaka"],"options":[{"bs":"biva uništen","en":"he/it is destroyed"},{"bs":"uništavaju","en":"they destroy"},{"bs":"uništio me je","en":"he/it destroyed me"},{"bs":"i uništili smo","en":"and we destroyed"}],"ref":"6:47","answerWord":"يُهْلَكُ","answerSound":"audio/827c7f936bef9b2a035e.m4a","quranTranslation":{"text":"Say: Can ye see yourselves, if the punishment of Allah come upon you unawares or openly? Would any perish save wrongdoing folk?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["قُلْ","أَرَءَيْتَكُمْ","إِنْ","أَتَىٰكُمْ","عَذَابُ","ٱللَّهِ","بَغْتَةً","أَوْ","جَهْرَةً","هَلْ","يُهْلَكُ","إِلَّا","ٱلْقَوْمُ","ٱلظَّٰلِمُونَ"],"marked":[10],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-7-4-3","words":["verb:ahlaka"],"options":[{"bs":"uništili smo je","en":"we destroyed it"},{"bs":"da uništi","en":"so that he/it may destroy"},{"bs":"uništava nas","en":"he/it destroys us"},{"bs":"i uništili smo","en":"and we destroyed"}],"ref":"7:4","answerWord":"أَهْلَكْنَٰهَا","answerSound":"audio/2734cc9107b4a7444683.m4a","quranTranslation":{"text":"How many a township have We destroyed! As a raid by night, or while they slept at noon, Our terror came unto them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَكَم","مِّن","قَرْيَةٍ","أَهْلَكْنَٰهَا","فَجَآءَهَا","بَأْسُنَا","بَيَٰتًا","أَوْ","هُمْ","قَآئِلُونَ"],"marked":[3],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-21-6-5","words":["verb:ahlaka"],"options":[{"bs":"uništili smo je","en":"we destroyed it"},{"bs":"uništavaju","en":"they destroy"},{"bs":"pa smo uništili","en":"so we destroyed"},{"bs":"uništio je","en":"destroyed"}],"ref":"21:6","answerWord":"أَهْلَكْنَٰهَآ","answerSound":"audio/70b463463f854f65b361.m4a","quranTranslation":{"text":"Not a township believed of those which We destroyed before them (though We sent them portents): would they then believe?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["مَآ","ءَامَنَتْ","قَبْلَهُم","مِّن","قَرْيَةٍ","أَهْلَكْنَٰهَآ","أَفَهُمْ","يُؤْمِنُونَ"],"marked":[5],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-53-50-1","words":["verb:ahlaka"],"options":[{"bs":"uništio je","en":"destroyed"},{"bs":"uništili smo je","en":"we destroyed it"},{"bs":"uništavaju","en":"they destroy"},{"bs":"da uništi","en":"so that he/it may destroy"}],"ref":"53:50","answerWord":"أَهْلَكَ","answerSound":"audio/1902bb4113bb460dc259.m4a","quranTranslation":{"text":"And that He destroyed the former (tribe of) A'ad,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَأَنَّهُۥٓ","أَهْلَكَ","عَادًا","ٱلْأُولَىٰ"],"marked":[1],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-69-5-2","words":["verb:ahlaka"],"options":[{"bs":"pa su uništeni","en":"so they were destroyed"},{"bs":"uništavamo","en":"we destroy"},{"bs":"uništava","en":"he/it destroys"},{"bs":"uništili smo ih","en":"we destroyed them"}],"ref":"69:5","answerWord":"فَأُهْلِكُوا۟","answerSound":"audio/31db95a4b6c795e04ec5.m4a","quranTranslation":{"text":"As for Thamud, they were destroyed by the lightning.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["فَأَمَّا","ثَمُودُ","فَأُهْلِكُوا۟","بِٱلطَّاغِيَةِ"],"marked":[2],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-2-205-7","words":["verb:ahlaka"],"options":[{"bs":"i uništava","en":"and he/it destroys"},{"bs":"pa ga je uništila","en":"so she/it destroyed it"},{"bs":"pa smo ih uništili","en":"so we destroyed them"},{"bs":"uništio me je","en":"he/it destroyed me"}],"ref":"2:205","answerWord":"وَيُهْلِكَ","answerSound":"audio/8b4b5c5b2906c0fa0f85.m4a","quranTranslation":{"text":"And when he turneth away (from thee) his effort in the land is to make mischief therein and to destroy the crops and the cattle; and Allah loveth not mischief.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَإِذَا","تَوَلَّىٰ","سَعَىٰ","فِى","ٱلْأَرْضِ","لِيُفْسِدَ","فِيهَا","وَيُهْلِكَ","ٱلْحَرْثَ","وَٱلنَّسْلَ","وَٱللَّهُ","لَا","يُحِبُّ","ٱلْفَسَادَ"],"marked":[7],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-3-117-16","words":["verb:ahlaka"],"options":[{"bs":"pa ga je uništila","en":"so she/it destroyed it"},{"bs":"i uništava","en":"and he/it destroys"},{"bs":"(zar nismo) uništili","en":"(did We not) destroy"},{"bs":"pa su uništeni","en":"so they were destroyed"}],"ref":"3:117","answerWord":"فَأَهْلَكَتْهُ","answerSound":"audio/7bdcd08b456325f8fa96.m4a","quranTranslation":{"text":"The likeness of that which they spend in this life of the world is as the likeness of a biting, icy wind which smiteth the harvest of a people who have wronged themselves, and devastateth it. Allah wronged them not, but they do wrong themselves.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["مَثَلُ","مَا","يُنفِقُونَ","فِى","هَٰذِهِ","ٱلْحَيَوٰةِ","ٱلدُّنْيَا","كَمَثَلِ","رِيحٍ","فِيهَا","صِرٌّ","أَصَابَتْ","حَرْثَ","قَوْمٍ","ظَلَمُوٓا۟","أَنفُسَهُمْ","فَأَهْلَكَتْهُ","وَمَا","ظَلَمَهُمُ","ٱللَّهُ","وَلَٰكِنْ","أَنفُسَهُمْ","يَظْلِمُونَ"],"marked":[16],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-11-117-3","words":["verb:ahlaka"],"options":[{"bs":"da uništi","en":"so that he/it may destroy"},{"bs":"uništio si ih","en":"you destroyed them"},{"bs":"uništava nas","en":"he/it destroys us"},{"bs":"uništili smo je","en":"we destroyed it"}],"ref":"11:117","answerWord":"لِيُهْلِكَ","answerSound":"audio/4b0ce1a683cd3d4c84e1.m4a","quranTranslation":{"text":"In truth thy Lord destroyed not the townships tyrannously while their folk were doing right.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَمَا","كَانَ","رَبُّكَ","لِيُهْلِكَ","ٱلْقُرَىٰ","بِظُلْمٍ","وَأَهْلُهَا","مُصْلِحُونَ"],"marked":[3],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-14-13-14","words":["verb:ahlaka"],"options":[{"bs":"zaista ćemo uništiti","en":"surely we will destroy"},{"bs":"uništio si ih","en":"you destroyed them"},{"bs":"i uništava","en":"and he/it destroys"},{"bs":"potrošio sam","en":"I squandered"}],"ref":"14:13","answerWord":"لَنُهْلِكَنَّ","answerSound":"audio/2961bf2de5b5f14b83b1.m4a","quranTranslation":{"text":"And those who disbelieved said unto their messengers: Verily we will drive you out from our land, unless ye return to our religion. Then their Lord inspired them, (saying): Verily we shall destroy the wrong-doers,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَقَالَ","ٱلَّذِينَ","كَفَرُوا۟","لِرُسُلِهِمْ","لَنُخْرِجَنَّكُم","مِّنْ","أَرْضِنَآ","أَوْ","لَتَعُودُنَّ","فِى","مِلَّتِنَا","فَأَوْحَىٰٓ","إِلَيْهِمْ","رَبُّهُمْ","لَنُهْلِكَنَّ","ٱلظَّٰلِمِينَ"],"marked":[14],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-17-16-3","words":["verb:ahlaka"],"options":[{"bs":"uništavamo","en":"we destroy"},{"bs":"pa ga je uništila","en":"so she/it destroyed it"},{"bs":"uništili smo","en":"we destroyed"},{"bs":"i uništava","en":"and he/it destroys"}],"ref":"17:16","answerWord":"نُّهْلِكَ","answerSound":"audio/f5045819ac9af6fcc783.m4a","quranTranslation":{"text":"And when We would destroy a township We send commandment to its folk who live at ease, and afterward they commit abomination therein, and so the Word (of doom) hath effect for it, and we annihilate it with complete annihilation.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَإِذَآ","أَرَدْنَآ","أَن","نُّهْلِكَ","قَرْيَةً","أَمَرْنَا","مُتْرَفِيهَا","فَفَسَقُوا۟","فِيهَا","فَحَقَّ","عَلَيْهَا","ٱلْقَوْلُ","فَدَمَّرْنَٰهَا","تَدْمِيرًا"],"marked":[3],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-20-134-2","words":["verb:ahlaka"],"options":[{"bs":"uništili smo ih","en":"we destroyed them"},{"bs":"uništili smo je","en":"we destroyed it"},{"bs":"(zar nismo) uništili","en":"(did We not) destroy"},{"bs":"uništio me je","en":"he/it destroyed me"}],"ref":"20:134","answerWord":"أَهْلَكْنَٰهُم","answerSound":"audio/99d8726b9282643b32b3.m4a","quranTranslation":{"text":"And if we had destroyed them with some punishment before it, they would assuredly have said: Our Lord! If only Thou hadst sent unto us a messenger, so that we might have followed Thy revelations before we were (thus) humbled and disgraced!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَلَوْ","أَنَّآ","أَهْلَكْنَٰهُم","بِعَذَابٍ","مِّن","قَبْلِهِۦ","لَقَالُوا۟","رَبَّنَا","لَوْلَآ","أَرْسَلْتَ","إِلَيْنَا","رَسُولًا","فَنَتَّبِعَ","ءَايَٰتِكَ","مِن","قَبْلِ","أَن","نَّذِلَّ","وَنَخْزَىٰ"],"marked":[2],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-21-9-6","words":["verb:ahlaka"],"options":[{"bs":"i uništili smo","en":"and we destroyed"},{"bs":"uništava","en":"he/it destroys"},{"bs":"uništava nas","en":"he/it destroys us"},{"bs":"uništili smo ih","en":"we destroyed them"}],"ref":"21:9","answerWord":"وَأَهْلَكْنَا","answerSound":"audio/9c0f7f182df7f983c8d2.m4a","quranTranslation":{"text":"Then we fulfilled the promise unto them. So we delivered them and whom We would, and We destroyed the prodigals.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["ثُمَّ","صَدَقْنَٰهُمُ","ٱلْوَعْدَ","فَأَنجَيْنَٰهُمْ","وَمَن","نَّشَآءُ","وَأَهْلَكْنَا","ٱلْمُسْرِفِينَ"],"marked":[6],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-26-139-1","words":["verb:ahlaka"],"options":[{"bs":"pa smo ih uništili","en":"so we destroyed them"},{"bs":"uništili smo je","en":"we destroyed it"},{"bs":"potrošio sam","en":"I squandered"},{"bs":"pa su uništeni","en":"so they were destroyed"}],"ref":"26:139","answerWord":"فَأَهْلَكْنَٰهُمْ","answerSound":"audio/a6d47d57b11a9eb60aa7.m4a","quranTranslation":{"text":"And they denied him; therefor We destroyed them. Lo! herein is indeed a portent, yet most of them are not believers.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["فَكَذَّبُوهُ","فَأَهْلَكْنَٰهُمْ","إِنَّ","فِى","ذَٰلِكَ","لَءَايَةً","وَمَا","كَانَ","أَكْثَرُهُم","مُّؤْمِنِينَ"],"marked":[1],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-43-8-0","words":["verb:ahlaka"],"options":[{"bs":"pa smo uništili","en":"so we destroyed"},{"bs":"zaista ćemo uništiti","en":"surely we will destroy"},{"bs":"uništava nas","en":"he/it destroys us"},{"bs":"uništili smo je","en":"we destroyed it"}],"ref":"43:8","answerWord":"فَأَهْلَكْنَآ","answerSound":"audio/c2f02342f5cfb35d45a5.m4a","quranTranslation":{"text":"Then We destroyed men mightier than these in prowess; and the example of the men of old hath gone (before them).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["فَأَهْلَكْنَآ","أَشَدَّ","مِنْهُم","بَطْشًا","وَمَضَىٰ","مَثَلُ","ٱلْأَوَّلِينَ"],"marked":[0],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-45-24-9","words":["verb:ahlaka"],"options":[{"bs":"uništava nas","en":"he/it destroys us"},{"bs":"uništili smo je","en":"we destroyed it"},{"bs":"uništio je","en":"destroyed"},{"bs":"uništili smo ih","en":"we destroyed them"}],"ref":"45:24","answerWord":"يُهْلِكُنَآ","answerSound":"audio/36795069574ee218460e.m4a","quranTranslation":{"text":"And they say: There is naught but our life of the world; we die and we live, and naught destroyeth us save time; when they have no knowledge whatsoever of (all) that; they do but guess.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَقَالُوا۟","مَا","هِىَ","إِلَّا","حَيَاتُنَا","ٱلدُّنْيَا","نَمُوتُ","وَنَحْيَا","وَمَا","يُهْلِكُنَآ","إِلَّا","ٱلدَّهْرُ","وَمَا","لَهُم","بِذَٰلِكَ","مِنْ","عِلْمٍ","إِنْ","هُمْ","إِلَّا","يَظُنُّونَ"],"marked":[9],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-54-51-1","words":["verb:ahlaka"],"options":[{"bs":"uništili smo","en":"we destroyed"},{"bs":"uništili smo je","en":"we destroyed it"},{"bs":"(zar nismo) uništili","en":"(did We not) destroy"},{"bs":"uništio je","en":"destroyed"}],"ref":"54:51","answerWord":"أَهْلَكْنَآ","answerSound":"audio/48b2a1171558a8df260f.m4a","quranTranslation":{"text":"And verily We have destroyed your fellows; but is there any that remembereth?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["وَلَقَدْ","أَهْلَكْنَآ","أَشْيَاعَكُمْ","فَهَلْ","مِن","مُّدَّكِرٍ"],"marked":[1],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-67-28-3","words":["verb:ahlaka"],"options":[{"bs":"uništio me je","en":"he/it destroyed me"},{"bs":"pa su uništeni","en":"so they were destroyed"},{"bs":"uništavamo","en":"we destroy"},{"bs":"uništili smo","en":"we destroyed"}],"ref":"67:28","answerWord":"أَهْلَكَنِىَ","answerSound":"audio/9c4519ef8953e98ad04b.m4a","quranTranslation":{"text":"Say (O Muhammad): Have ye thought: Whether Allah causeth me (Muhammad) and those with me to perish or hath mercy on us, still, who will protect the disbelievers from a painful doom?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["قُلْ","أَرَءَيْتُمْ","إِنْ","أَهْلَكَنِىَ","ٱللَّهُ","وَمَن","مَّعِىَ","أَوْ","رَحِمَنَا","فَمَن","يُجِيرُ","ٱلْكَٰفِرِينَ","مِنْ","عَذَابٍ","أَلِيمٍ"],"marked":[3],"facts":{"verb":"أَهْلَكَ"}},{"id":"ahlaka-77-16-1","words":["verb:ahlaka"],"options":[{"bs":"(zar nismo) uništili","en":"(did We not) destroy"},{"bs":"potrošio sam","en":"I squandered"},{"bs":"uništava","en":"he/it destroys"},{"bs":"pa smo uništili","en":"so we destroyed"}],"ref":"77:16","answerWord":"نُهْلِكِ","answerSound":"audio/0cea2b14398b2967f937.m4a","quranTranslation":{"text":"Destroyed We not the former folk,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"uništiti","en":"to destroy"},"passage":["أَلَمْ","نُهْلِكِ","ٱلْأَوَّلِينَ"],"marked":[1],"facts":{"verb":"أَهْلَكَ"}},{"id":"asarra-2-77-6","words":["verb:asarra"],"options":[{"bs":"taje","en":"they keep secret"},{"bs":"i tajite","en":"and keep secret"},{"bs":"i tajili su","en":"and they kept secret"},{"bs":"pa ju je tajio","en":"so he/it kept it secret"}],"ref":"2:77","answerWord":"يُسِرُّونَ","answerSound":"audio/641789c3e5fee06af292.m4a","quranTranslation":{"text":"Are they then unaware that Allah knoweth that which they keep hidden and that which they proclaim?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tajiti, skrivati","en":"to keep secret, to conceal"},"passage":["أَوَلَا","يَعْلَمُونَ","أَنَّ","ٱللَّهَ","يَعْلَمُ","مَا","يُسِرُّونَ","وَمَا","يُعْلِنُونَ"],"marked":[6],"facts":{"verb":"أَسَرَّ"}},{"id":"asarra-20-62-3","words":["verb:asarra"],"options":[{"bs":"i tajili su","en":"and they kept secret"},{"bs":"tajio je","en":"he/it kept secret"},{"bs":"i tajio sam","en":"and I kept secret"},{"bs":"taje","en":"they keep secret"}],"ref":"20:62","answerWord":"وَأَسَرُّوا۟","answerSound":"audio/540aabe63036ac2f57d1.m4a","quranTranslation":{"text":"Then they debated one with another what they must do, and they kept their counsel secret.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tajiti, skrivati","en":"to keep secret, to conceal"},"passage":["فَتَنَٰزَعُوٓا۟","أَمْرَهُم","بَيْنَهُمْ","وَأَسَرُّوا۟","ٱلنَّجْوَىٰ"],"marked":[3],"facts":{"verb":"أَسَرَّ"}},{"id":"asarra-16-19-3","words":["verb:asarra"],"options":[{"bs":"tajite","en":"you conceal"},{"bs":"pa ju je tajio","en":"so he/it kept it secret"},{"bs":"i tajio sam","en":"and I kept secret"},{"bs":"tajili su","en":"they kept secret"}],"ref":"16:19","answerWord":"تُسِرُّونَ","answerSound":"audio/0e58cb62d60c1087c7d6.m4a","quranTranslation":{"text":"And Allah knoweth that which ye keep hidden and that which ye proclaim.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tajiti, skrivati","en":"to keep secret, to conceal"},"passage":["وَٱللَّهُ","يَعْلَمُ","مَا","تُسِرُّونَ","وَمَا","تُعْلِنُونَ"],"marked":[3],"facts":{"verb":"أَسَرَّ"}},{"id":"asarra-13-10-3","words":["verb:asarra"],"options":[{"bs":"tajio je","en":"he/it kept secret"},{"bs":"i tajili su ga","en":"and they kept him secret"},{"bs":"taje","en":"they keep secret"},{"bs":"pa ju je tajio","en":"so he/it kept it secret"}],"ref":"13:10","answerWord":"أَسَرَّ","answerSound":"audio/66cd6a302cfcc3f39c60.m4a","quranTranslation":{"text":"Alike of you is he who hideth the saying and he who noiseth it abroad, he who lurketh in the night and he who goeth freely in the daytime.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tajiti, skrivati","en":"to keep secret, to conceal"},"passage":["سَوَآءٌ","مِّنكُم","مَّنْ","أَسَرَّ","ٱلْقَوْلَ","وَمَن","جَهَرَ","بِهِۦ","وَمَنْ","هُوَ","مُسْتَخْفٍۭ","بِٱلَّيْلِ","وَسَارِبٌۢ","بِٱلنَّهَارِ"],"marked":[3],"facts":{"verb":"أَسَرَّ"}},{"id":"asarra-5-52-24","words":["verb:asarra"],"options":[{"bs":"tajili su","en":"they kept secret"},{"bs":"taje","en":"they keep secret"},{"bs":"pa ju je tajio","en":"so he/it kept it secret"},{"bs":"i tajili su ga","en":"and they kept him secret"}],"ref":"5:52","answerWord":"أَسَرُّوا۟","answerSound":"audio/7603de6c80ba2fab42d2.m4a","quranTranslation":{"text":"And thou seest those in whose heart is a disease race toward them, saying: We fear lest a change of fortune befall us. And it may happen that Allah will vouchsafe (unto thee) the victory, or a commandment from His presence. Then will they repent them of their secret thoughts.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tajiti, skrivati","en":"to keep secret, to conceal"},"passage":["فَتَرَى","ٱلَّذِينَ","فِى","قُلُوبِهِم","مَّرَضٌ","يُسَٰرِعُونَ","فِيهِمْ","يَقُولُونَ","نَخْشَىٰٓ","أَن","تُصِيبَنَا","دَآئِرَةٌ","فَعَسَى","ٱللَّهُ","أَن","يَأْتِىَ","بِٱلْفَتْحِ","أَوْ","أَمْرٍ","مِّنْ","عِندِهِۦ","فَيُصْبِحُوا۟","عَلَىٰ","مَآ","أَسَرُّوا۟","فِىٓ","أَنفُسِهِمْ","نَٰدِمِينَ"],"marked":[24],"facts":{"verb":"أَسَرَّ"}},{"id":"asarra-12-19-10","words":["verb:asarra"],"options":[{"bs":"i tajili su ga","en":"and they kept him secret"},{"bs":"i tajili su","en":"and they kept secret"},{"bs":"taje","en":"they keep secret"},{"bs":"i tajite","en":"and keep secret"}],"ref":"12:19","answerWord":"وَأَسَرُّوهُ","answerSound":"audio/4ba8f742d896922931af.m4a","quranTranslation":{"text":"And there came a caravan, and they sent their waterdrawer. He let down his pail (into the pit). He said: Good luck! Here is a youth. And they hid him as a treasure, and Allah was Aware of what they did.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tajiti, skrivati","en":"to keep secret, to conceal"},"passage":["وَجَآءَتْ","سَيَّارَةٌ","فَأَرْسَلُوا۟","وَارِدَهُمْ","فَأَدْلَىٰ","دَلْوَهُۥ","قَالَ","يَٰبُشْرَىٰ","هَٰذَا","غُلَٰمٌ","وَأَسَرُّوهُ","بِضَٰعَةً","وَٱللَّهُ","عَلِيمٌۢ","بِمَا","يَعْمَلُونَ"],"marked":[10],"facts":{"verb":"أَسَرَّ"}},{"id":"asarra-12-77-9","words":["verb:asarra"],"options":[{"bs":"pa ju je tajio","en":"so he/it kept it secret"},{"bs":"tajio je","en":"he/it kept secret"},{"bs":"tajili su","en":"they kept secret"},{"bs":"i tajio sam","en":"and I kept secret"}],"ref":"12:77","answerWord":"فَأَسَرَّهَا","answerSound":"audio/c1baab2eff452b1a074b.m4a","quranTranslation":{"text":"They said: If he stealeth, a brother of his stole before. But Joseph kept it secret in his soul and revealed it not unto them. He said (within himself): Ye are in worse case, and Allah knoweth best (the truth of) that which ye allege.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tajiti, skrivati","en":"to keep secret, to conceal"},"passage":["قَالُوٓا۟","إِن","يَسْرِقْ","فَقَدْ","سَرَقَ","أَخٌ","لَّهُۥ","مِن","قَبْلُ","فَأَسَرَّهَا","يُوسُفُ","فِى","نَفْسِهِۦ","وَلَمْ","يُبْدِهَا","لَهُمْ","قَالَ","أَنتُمْ","شَرٌّ","مَّكَانًا","وَٱللَّهُ","أَعْلَمُ","بِمَا","تَصِفُونَ"],"marked":[9],"facts":{"verb":"أَسَرَّ"}},{"id":"asarra-67-13-0","words":["verb:asarra"],"options":[{"bs":"i tajite","en":"and keep secret"},{"bs":"taje","en":"they keep secret"},{"bs":"pa ju je tajio","en":"so he/it kept it secret"},{"bs":"i tajili su ga","en":"and they kept him secret"}],"ref":"67:13","answerWord":"وَأَسِرُّوا۟","answerSound":"audio/973b4136cad822c29182.m4a","quranTranslation":{"text":"And keep your opinion secret or proclaim it, lo! He is Knower of all that is in the breasts (of men).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tajiti, skrivati","en":"to keep secret, to conceal"},"passage":["وَأَسِرُّوا۟","قَوْلَكُمْ","أَوِ","ٱجْهَرُوا۟","بِهِۦٓ","إِنَّهُۥ","عَلِيمٌۢ","بِذَاتِ","ٱلصُّدُورِ"],"marked":[0],"facts":{"verb":"أَسَرَّ"}},{"id":"asarra-71-9-4","words":["verb:asarra"],"options":[{"bs":"i tajio sam","en":"and I kept secret"},{"bs":"taje","en":"they keep secret"},{"bs":"i tajili su ga","en":"and they kept him secret"},{"bs":"i tajili su","en":"and they kept secret"}],"ref":"71:9","answerWord":"وَأَسْرَرْتُ","answerSound":"audio/803b87f9ad2c9fc16e32.m4a","quranTranslation":{"text":"And lo! I have made public proclamation unto them, and I have appealed to them in private.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"tajiti, skrivati","en":"to keep secret, to conceal"},"passage":["ثُمَّ","إِنِّىٓ","أَعْلَنتُ","لَهُمْ","وَأَسْرَرْتُ","لَهُمْ","إِسْرَارًا"],"marked":[4],"facts":{"verb":"أَسَرَّ"}},{"id":"labasa-16-14-11","words":["verb:labasa"],"options":[{"bs":"nosite ga","en":"you (all) wear it"},{"bs":"nose","en":"they wear"},{"bs":"zamagljujete","en":"you (all) make vague"},{"bs":"zbunjuje vas","en":"he/it confuses you (all)"}],"ref":"16:14","answerWord":"تَلْبَسُونَهَا","answerSound":"audio/6aff86021048b5229458.m4a","quranTranslation":{"text":"And He it is Who hath constrained the sea to be of service that ye eat fresh meat from thence, and bring forth from thence ornaments which ye wear. And thou seest the ships ploughing it that ye (mankind) may seek of His bounty and that haply ye may give thanks.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomutiti, zamagliti","en":"to make vague, to confuse"},"passage":["وَهُوَ","ٱلَّذِى","سَخَّرَ","ٱلْبَحْرَ","لِتَأْكُلُوا۟","مِنْهُ","لَحْمًا","طَرِيًّا","وَتَسْتَخْرِجُوا۟","مِنْهُ","حِلْيَةً","تَلْبَسُونَهَا","وَتَرَى","ٱلْفُلْكَ","مَوَاخِرَ","فِيهِ","وَلِتَبْتَغُوا۟","مِن","فَضْلِهِۦ","وَلَعَلَّكُمْ","تَشْكُرُونَ"],"marked":[11],"facts":{"verb":"لَبَسَ"}},{"id":"labasa-2-42-1","words":["verb:labasa"],"options":[{"bs":"zamagljujete","en":"you (all) make vague"},{"bs":"i da zamagle","en":"and so that they may make vague"},{"bs":"zbunjuje vas","en":"he/it confuses you (all)"},{"bs":"nosite ga","en":"you (all) wear it"}],"ref":"2:42","answerWord":"تَلْبِسُوا۟","answerSound":"audio/2304bc44b957aa617a2d.m4a","quranTranslation":{"text":"Confound not truth with falsehood, nor knowingly conceal the truth.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomutiti, zamagliti","en":"to make vague, to confuse"},"passage":["وَلَا","تَلْبِسُوا۟","ٱلْحَقَّ","بِٱلْبَٰطِلِ","وَتَكْتُمُوا۟","ٱلْحَقَّ","وَأَنتُمْ","تَعْلَمُونَ"],"marked":[1],"facts":{"verb":"لَبَسَ"}},{"id":"labasa-3-71-3","words":["verb:labasa"],"options":[{"bs":"zamagljujete","en":"you (all) make vague"},{"bs":"i da zamagle","en":"and so that they may make vague"},{"bs":"i zamaglili bismo","en":"and We would have made unclear"},{"bs":"nosite ga","en":"you (all) wear it"}],"ref":"3:71","answerWord":"تَلْبِسُونَ","answerSound":"audio/e2501eb751eba06dc612.m4a","quranTranslation":{"text":"O People of the Scripture! Why confound ye truth with falsehood and knowingly conceal the truth?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomutiti, zamagliti","en":"to make vague, to confuse"},"passage":["يَٰٓأَهْلَ","ٱلْكِتَٰبِ","لِمَ","تَلْبِسُونَ","ٱلْحَقَّ","بِٱلْبَٰطِلِ","وَتَكْتُمُونَ","ٱلْحَقَّ","وَأَنتُمْ","تَعْلَمُونَ"],"marked":[3],"facts":{"verb":"لَبَسَ"}},{"id":"labasa-6-9-5","words":["verb:labasa"],"options":[{"bs":"i zamaglili bismo","en":"and We would have made unclear"},{"bs":"zamagljujete","en":"you (all) make vague"},{"bs":"zbunjuje vas","en":"he/it confuses you (all)"},{"bs":"nose","en":"they wear"}],"ref":"6:9","answerWord":"وَلَلَبَسْنَا","answerSound":"audio/5584fd171828531f2c79.m4a","quranTranslation":{"text":"Had we appointed him (Our messenger) an angel, We assuredly had made him (as) a man (that he might speak to men); and (thus) obscured for them (the truth) they (now) obscure.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomutiti, zamagliti","en":"to make vague, to confuse"},"passage":["وَلَوْ","جَعَلْنَٰهُ","مَلَكًا","لَّجَعَلْنَٰهُ","رَجُلًا","وَلَلَبَسْنَا","عَلَيْهِم","مَّا","يَلْبِسُونَ"],"marked":[5],"facts":{"verb":"لَبَسَ"}},{"id":"labasa-6-9-8","words":["verb:labasa"],"options":[{"bs":"zamagljuju","en":"they make unclear"},{"bs":"zamagljujete","en":"you (all) make vague"},{"bs":"i zamaglili bismo","en":"and We would have made unclear"},{"bs":"nosite ga","en":"you (all) wear it"}],"ref":"6:9","answerWord":"يَلْبِسُونَ","answerSound":"audio/758a0b8687df5a6f2b02.m4a","quranTranslation":{"text":"Had we appointed him (Our messenger) an angel, We assuredly had made him (as) a man (that he might speak to men); and (thus) obscured for them (the truth) they (now) obscure.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomutiti, zamagliti","en":"to make vague, to confuse"},"passage":["وَلَوْ","جَعَلْنَٰهُ","مَلَكًا","لَّجَعَلْنَٰهُ","رَجُلًا","وَلَلَبَسْنَا","عَلَيْهِم","مَّا","يَلْبِسُونَ"],"marked":[8],"facts":{"verb":"لَبَسَ"}},{"id":"labasa-6-65-15","words":["verb:labasa"],"options":[{"bs":"zbunjuje vas","en":"he/it confuses you (all)"},{"bs":"zamagljujete","en":"you (all) make vague"},{"bs":"nose","en":"they wear"},{"bs":"i zamaglili bismo","en":"and We would have made unclear"}],"ref":"6:65","answerWord":"يَلْبِسَكُمْ","answerSound":"audio/4d450ecde0c98359182c.m4a","quranTranslation":{"text":"Say: He is able to send punishment upon you from above you or from beneath your feet, or to bewilder you with dissension and make you taste the tyranny one of another. See how We display the revelations so that they may understand.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomutiti, zamagliti","en":"to make vague, to confuse"},"passage":["قُلْ","هُوَ","ٱلْقَادِرُ","عَلَىٰٓ","أَن","يَبْعَثَ","عَلَيْكُمْ","عَذَابًا","مِّن","فَوْقِكُمْ","أَوْ","مِن","تَحْتِ","أَرْجُلِكُمْ","أَوْ","يَلْبِسَكُمْ","شِيَعًا","وَيُذِيقَ","بَعْضَكُم","بَأْسَ","بَعْضٍ","ٱنظُرْ","كَيْفَ","نُصَرِّفُ","ٱلْءَايَٰتِ","لَعَلَّهُمْ","يَفْقَهُونَ"],"marked":[15],"facts":{"verb":"لَبَسَ"}},{"id":"labasa-6-82-3","words":["verb:labasa"],"options":[{"bs":"zamagljuju","en":"they make vague"},{"bs":"nosite ga","en":"you (all) wear it"},{"bs":"zamagljujete","en":"you (all) make vague"},{"bs":"zbunjuje vas","en":"he/it confuses you (all)"}],"ref":"6:82","answerWord":"يَلْبِسُوٓا۟","answerSound":"audio/5c15aef755f35f1eeb3c.m4a","quranTranslation":{"text":"Those who believe and obscure not their belief by wrongdoing, theirs is safety; and they are rightly guided.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomutiti, zamagliti","en":"to make vague, to confuse"},"passage":["ٱلَّذِينَ","ءَامَنُوا۟","وَلَمْ","يَلْبِسُوٓا۟","إِيمَٰنَهُم","بِظُلْمٍ","أُو۟لَٰٓئِكَ","لَهُمُ","ٱلْأَمْنُ","وَهُم","مُّهْتَدُونَ"],"marked":[3],"facts":{"verb":"لَبَسَ"}},{"id":"labasa-6-137-9","words":["verb:labasa"],"options":[{"bs":"i da zamagle","en":"and so that they may make vague"},{"bs":"zamagljujete","en":"you (all) make vague"},{"bs":"zbunjuje vas","en":"he/it confuses you (all)"},{"bs":"nosite ga","en":"you (all) wear it"}],"ref":"6:137","answerWord":"وَلِيَلْبِسُوا۟","answerSound":"audio/f4f4ef172991ba072b1a.m4a","quranTranslation":{"text":"Thus have their (so-called) partners (of Allah) made the killing of their children to seem fair unto many of the idolaters, that they may ruin them and make their faith obscure for them. Had Allah willed (it otherwise), they had not done so. So leave them alone with their devices.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomutiti, zamagliti","en":"to make vague, to confuse"},"passage":["وَكَذَٰلِكَ","زَيَّنَ","لِكَثِيرٍ","مِّنَ","ٱلْمُشْرِكِينَ","قَتْلَ","أَوْلَٰدِهِمْ","شُرَكَآؤُهُمْ","لِيُرْدُوهُمْ","وَلِيَلْبِسُوا۟","عَلَيْهِمْ","دِينَهُمْ","وَلَوْ","شَآءَ","ٱللَّهُ","مَا","فَعَلُوهُ","فَذَرْهُمْ","وَمَا","يَفْتَرُونَ"],"marked":[9],"facts":{"verb":"لَبَسَ"}},{"id":"labasa-18-31-14","words":["verb:labasa"],"options":[{"bs":"i nose","en":"and they wear"},{"bs":"zbunjuje vas","en":"he/it confuses you (all)"},{"bs":"zamagljujete","en":"you (all) make vague"},{"bs":"i zamaglili bismo","en":"and We would have made unclear"}],"ref":"18:31","answerWord":"وَيَلْبَسُونَ","answerSound":"audio/277ce6861d8fd636d1d9.m4a","quranTranslation":{"text":"As for such, theirs will be Gardens of Eden, wherein rivers flow beneath them; therein they will be given armlets of gold and will wear green robes of finest silk and gold embroidery, reclining upon throne therein. Blest the reward, and fair the resting-place!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomutiti, zamagliti","en":"to make vague, to confuse"},"passage":["أُو۟لَٰٓئِكَ","لَهُمْ","جَنَّٰتُ","عَدْنٍ","تَجْرِى","مِن","تَحْتِهِمُ","ٱلْأَنْهَٰرُ","يُحَلَّوْنَ","فِيهَا","مِنْ","أَسَاوِرَ","مِن","ذَهَبٍ","وَيَلْبَسُونَ","ثِيَابًا","خُضْرًا","مِّن","سُندُسٍ","وَإِسْتَبْرَقٍ","مُّتَّكِـِٔينَ","فِيهَا","عَلَى","ٱلْأَرَآئِكِ","نِعْمَ","ٱلثَّوَابُ","وَحَسُنَتْ","مُرْتَفَقًا"],"marked":[14],"facts":{"verb":"لَبَسَ"}},{"id":"labasa-44-53-0","words":["verb:labasa"],"options":[{"bs":"nose","en":"they wear"},{"bs":"zamagljujete","en":"you (all) make vague"},{"bs":"i zamaglili bismo","en":"and We would have made unclear"},{"bs":"zbunjuje vas","en":"he/it confuses you (all)"}],"ref":"44:53","answerWord":"يَلْبَسُونَ","answerSound":"audio/3d8fd52ebc55c2d76102.m4a","quranTranslation":{"text":"Attired in silk and silk embroidery, facing one another.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"pomutiti, zamagliti","en":"to make vague, to confuse"},"passage":["يَلْبَسُونَ","مِن","سُندُسٍ","وَإِسْتَبْرَقٍ","مُّتَقَٰبِلِينَ"],"marked":[0],"facts":{"verb":"لَبَسَ"}},{"id":"tafarraqa-30-14-4","words":["verb:tafarraqa"],"options":[{"bs":"razdvojit će se","en":"they will be separated"},{"bs":"podijelili su se","en":"they split up"},{"bs":"rastanu se","en":"they (two) separate"},{"bs":"razilazite se","en":"you (all) become divided"}],"ref":"30:14","answerWord":"يَتَفَرَّقُونَ","answerSound":"audio/b907e558b769db4453d7.m4a","quranTranslation":{"text":"In the day when the Hour cometh, in that day they will be sundered.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"razići se, podijeliti se","en":"to disperse, to split up"},"passage":["وَيَوْمَ","تَقُومُ","ٱلسَّاعَةُ","يَوْمَئِذٍ","يَتَفَرَّقُونَ"],"marked":[4],"facts":{"verb":"تَفَرَّقَ"}},{"id":"tafarraqa-98-4-1","words":["verb:tafarraqa"],"options":[{"bs":"podijelili su se","en":"they split up"},{"bs":"razilazite se","en":"you (all) become divided"},{"bs":"razišli su se","en":"they became divided"},{"bs":"rastanu se","en":"they (two) separate"}],"ref":"98:4","answerWord":"تَفَرَّقَ","answerSound":"audio/413ce66856ffc62f69bd.m4a","quranTranslation":{"text":"Nor were the People of the Scripture divided until after the clear proof came unto them.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"razići se, podijeliti se","en":"to disperse, to split up"},"passage":["وَمَا","تَفَرَّقَ","ٱلَّذِينَ","أُوتُوا۟","ٱلْكِتَٰبَ","إِلَّا","مِنۢ","بَعْدِ","مَا","جَآءَتْهُمُ","ٱلْبَيِّنَةُ"],"marked":[1],"facts":{"verb":"تَفَرَّقَ"}}]