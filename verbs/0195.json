n": false, "notUsed": false, "spoken": "audio/618e2cbf40c8fb9a86f6.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَغْرِقَا", "plain": "أَغْرِقَا", "quran": false, "notUsed": false, "spoken": "audio/061051f4cdc605f67df1.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَغْرِقُوا", "plain": "أَغْرِقُوا", "quran": false, "notUsed": false, "spoken": "audio/693d2c9dd65b59080461.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَغْرِقْنَ", "plain": "أَغْرِقْنَ", "quran": false, "notUsed": false, "spoken": "audio/3e52e01f8d55c222ceee.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "26:66", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2998.mp3", "translation": {"en": {"text": "And We drowned the others.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Sonra da ötekileri suda boğduk.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "پھر دوسروں کو ڈبو دیا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Kami tenggelamkan golongan yang lain itu.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ثُمَّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَغْرَقْنَا", "hit": true, "audio": "audio/4e783e08c8cb8251b418.m4a", "gloss": {"bs": "potopili smo", "en": "We drowned", "tr": "boğduk", "fr": "Nous avons noyé", "id": "Kami menenggelamkan", "ur": "ہم نے غرق کر دیا", "bn": "আমরা ডুবিয়ে দিয়েছি", "fa": "غرق کردیم"}}, {"text": "ٱلْءَاخَرِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "36:43", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3748.mp3", "translation": {"en": {"text": "And if We will, We drown them, and there is no help for them, neither can they be saved;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Eğer dilesek onları boğarız da o zaman ne onların feryadına yetişen bulunur, ne de onlar kurtarılır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور ہم چاہیں تو انہیں ڈبودیں تو نہ کوئی ان کی فریاد کو پہنچنے والا ہو اور نہ وہ بچائے جائیں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan jika Kami menghendaki niscaya Kami tenggelamkan mereka, maka tiadalah bagi mereka penolong dan tidak pula mereka diselamatkan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِن", "hit": false, "audio": null, "gloss": null}, {"text": "نَّشَأْ", "hit": false, "audio": null, "gloss": null}, {"text": "نُغْرِقْهُمْ", "hit": true, "audio": "audio/ce08d414490d3769a48e.m4a", "gloss": {"bs": "potopimo ih", "en": "We drown them", "tr": "onları boğarız", "fr": "Nous les noyons", "id": "Kami menenggelamkan mereka", "ur": "ہم انہیں غرق کر دیں", "bn": "আমরা তাদের ডুবিয়ে দিই", "fa": "آنان را غرق می‌کنیم"}}, {"text": "فَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "صَرِيخَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "هُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يُنقَذُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "أَغْرَقْنَا", "count": 4, "first": "26:66", "audio": "audio/4e783e08c8cb8251b418.m4a", "grammar": [{"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}], "gloss": {"bs": "potopili smo", "en": "We drowned", "tr": "boğduk", "fr": "Nous avons noyé", "id": "Kami menenggelamkan", "ur": "ہم نے غرق کر دیا", "bn": "আমরা ডুবিয়ে দিয়েছি", "fa": "غرق کردیم"}}, {"arabic": "فَأَغْرَقْنَٰهُمْ", "count": 3, "first": "7:136", "audio": "audio/bd1759a5632926771aec.m4a