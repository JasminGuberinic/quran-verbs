{"ayat":[{"ref":"77:1","number":5623,"text":"وَٱلْمُرْسَلَٰتِ عُرْفًا","hits":[]},{"ref":"77:2","number":5624,"text":"فَٱلْعَٰصِفَٰتِ عَصْفًا","hits":[]},{"ref":"77:3","number":5625,"text":"وَٱلنَّٰشِرَٰتِ نَشْرًا","hits":[]},{"ref":"77:4","number":5626,"text":"فَٱلْفَٰرِقَٰتِ فَرْقًا","hits":[]},{"ref":"77:5","number":5627,"text":"فَٱلْمُلْقِيَٰتِ ذِكْرًا","hits":[1]},{"ref":"77:6","number":5628,"text":"عُذْرًا أَوْ نُذْرًا","hits":[0,1]},{"ref":"77:7","number":5629,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ","hits":[0,1]},{"ref":"77:8","number":5630,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","hits":[0,1,2]},{"ref":"77:9","number":5631,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","hits":[1]},{"ref":"77:10","number":5632,"text":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","hits":[1]},{"ref":"77:11","number":5633,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","hits":[1]},{"ref":"77:12","number":5634,"text":"لِأَىِّ يَوْمٍ أُجِّلَتْ","hits":[1]},{"ref":"77:13","number":5635,"text":"لِيَوْمِ ٱلْفَصْلِ","hits":[]},{"ref":"77:14","number":5636,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","hits":[0,1]},{"ref":"77:15","number":5637,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[2]},{"ref":"77:16","number":5638,"text":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","hits":[0,1]},{"ref":"77:17","number":5639,"text":"ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ","hits":[0,1]},{"ref":"77:18","number":5640,"text":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","hits":[0,1,2]},{"ref":"77:19","number":5641,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[]},{"ref":"77:20","number":5642,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ","hits":[1,2,3,4]},{"ref":"77:21","number":5643,"text":"فَجَعَلْنَٰهُ فِى قَرَارٍ مَّكِينٍ","hits":[0,1]},{"ref":"77:22","number":5644,"text":"إِلَىٰ قَدَرٍ مَّعْلُومٍ","hits":[0,2]},{"ref":"77:23","number":5645,"text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ","hits":[0,1,2]},{"ref":"77:24","number":5646,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[]},{"ref":"77:25","number":5647,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","hits":[2]},{"ref":"77:26","number":5648,"text":"أَحْيَآءً وَأَمْوَٰتًا","hits":[0,1]},{"ref":"77:27","number":5649,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍ وَأَسْقَيْنَٰكُم مَّآءً فُرَاتًا","hits":[4]},{"ref":"77:28","number":5650,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[]},{"ref":"77:29","number":5651,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","hits":[0,3,4,5]},{"ref":"77:30","number":5652,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَٰثِ شُعَبٍ","hits":[2]},{"ref":"77:31","number":5653,"text":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","hits":[0,3]},{"ref":"77:32","number":5654,"text":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ","hits":[1,3]},{"ref":"77:33","number":5655,"text":"كَأَنَّهُۥ جِمَٰلَتٌ صُفْرٌ","hits":[0]},{"ref":"77:34","number":5656,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[]},{"ref":"77:35","number":5657,"text":"هَٰذَا يَوْمُ لَا يَنطِقُونَ","hits":[0,3]},{"ref":"77:36","number":5658,"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","hits":[1,2,3]},{"ref":"77:37","number":5659,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[]},{"ref":"77:38","number":5660,"text":"هَٰذَا يَوْمُ ٱلْفَصْلِ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ","hits":[3]},{"ref":"77:39","number":5661,"text":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ","hits":[0,3,4]},{"ref":"77:40","number":5662,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[]},{"ref":"77:41","number":5663,"text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍ وَعُيُونٍ","hits":[1,4]},{"ref":"77:42","number":5664,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","hits":[2]},{"ref":"77:43","number":5665,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","hits":[0,1,5]},{"ref":"77:44","number":5666,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","hits":[2,3]},{"ref":"77:45","number":5667,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[]},{"ref":"77:46","number":5668,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","hits":[1,2]},{"ref":"77:47","number":5669,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[]},{"ref":"77:48","number":5670,"text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","hits":[1,3]},{"ref":"77:49","number":5671,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","hits":[]},{"ref":"77:50","number":5672,"text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","hits":[1,3]}]}