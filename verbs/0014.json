: "audio/a0ddc4f1172014029103.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يُنْزِلُ", "plain": "يُنْزِلُ", "quran": false, "notUsed": false, "spoken": "audio/5d5b09c40488038052df.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hiya", "arabic": "تُنْزِلُ", "plain": "تُنْزِلُ", "quran": false, "notUsed": false, "spoken": "audio/3671e8ea73b74421c223.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huma", "arabic": "يُنْزِلَانِ", "plain": "يُنْزِلَانِ", "quran": false, "notUsed": false, "spoken": "audio/fff964334b31677eda3e.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يُنْزِلُونَ", "plain": "يُنْزِلُونَ", "quran": false, "notUsed": false, "spoken": "audio/3a03cd809a4f4c9af3a9.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hunna", "arabic": "يُنْزِلْنَ", "plain": "يُنْزِلْنَ", "quran": false, "notUsed": false, "spoken": "audio/af3bcf580eb896e62616.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَنزِلْ", "plain": "أَنْزِلْ", "quran": true, "notUsed": false, "spoken": "audio/773105365b9fb36b1fe5.m4a", "recited": "audio/72c077ddb7d24cf924d9.m4a", "recitedText": "أَنزِلْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَنْزِلِي", "plain": "أَنْزِلِي", "quran": false, "notUsed": false, "spoken": "audio/9edeb8e3051470d50a42.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَنْزِلَا", "plain": "أَنْزِلَا", "quran": false, "notUsed": false, "spoken": "audio/e299dd16b66bfd4cab5e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَنْزِلُوا", "plain": "أَنْزِلُوا", "quran": false, "notUsed": false, "spoken": "audio/50480c1fa05dd53e1a9d.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَنْزِلْنَ", "plain": "أَنْزِلْنَ", "quran": false, "notUsed": false, "spoken": "audio/0bea0b01106f25ba8c86.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "47:9", "tense": "past", "category": {"tense": "past", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4554.mp3", "translation": {"en": {"text": "That is because they are averse to that which Allah hath revealed, therefor maketh He their actions fruitless.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bu onların, Allah'ın indirdiklerini beğenmediklerinden dolayıdır. Allah da bunun için onların amellerini boşa çıkarmıştır.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یہ اس لیے کہ انہیں ناگوار ہوا جو اللہ نے اتارا تو اللہ نے ان کا کیا دھرا اِکارت کیا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Yang demikian itu adalah karena Sesungguhnya mereka benci kepada apa yang diturunkan Allah (Al Quran) lalu Allah menghapuskan (pahala-pahala) amal-amal mereka.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "بِأَنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "كَرِهُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "مَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنزَلَ", "hit": true, "audio": "audio/373aae0959f0069cd437.m4a", "gloss": {"en": "he/it sent down", "bs": "objavio je", "tr": "indirdi", "fr": "il a révélé", "id": "dia telah menurunkan", "ur": "اُس نے اتارا", "bn": "সে অবতীর্ণ করেছে", "fa": "نازل کرد"}}, {"text": "ٱللَّهُ", "hit": false, "audio": null, "gloss": null}, {"text": "فَأَحْبَطَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْمَٰلَهُمْ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:90", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1892.mp3", "translation": {"en": {"text": "Such as We send down for those who make division,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(İnanmazsanız başınıza) tıpkı o taksimcilere (yahudi ve hıristiyanlara) indirdiğimiz azap gibi (bir azab inecektir).", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جیسا ہم نے بانٹنے والوں پر اتارا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sebagaimana (Kami telah memberi peringatan), Kami telah menurunkan (azab) kepada orang-orang yang membagi-bagi (Kitab Allah),", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "كَمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنزَلْنَا", "hit": true, "audio": "audio/625939380490cd96842a.m4a", "gloss": {"bs": "spustili smo", "en": "We sent down", "tr": "indirdik", "fr": "Nous avons fait descendre", "id": "Kami turunkan", "ur": "ہم نے اتارا", "bn": "আমরা নাযিল করেছি", "fa": "فرو فرستادیم"}}, {"text": "عَلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُقْتَسِمِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "3:53", "tense": "past", "category": {"tense": "past", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/346.mp3", "translation": {"en": {"text": "Our Lord! We believe in that which Thou hast revealed and we follow him whom Thou hast sent. Enrol us among those who witness (to the truth).", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ey Rabbimiz, senin indirdiğine iman ettik, o peygambere de uyduk. Artık bizi şahidlerle beraber yaz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اے رب ہمارے! ہم اس پر ایمان لائے جو تو نے اتارا اور رسول کے تابع ہوئے تو ہمیں حق پر گواہی دینے والوں میں لکھ لے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ya Tuhan kami, kami telah beriman kepada apa yang telah Engkau turunkan dan telah kami ikuti rasul, karena itu masukanlah kami ke dalam golongan orang-orang yang menjadi saksi (tentang keesaan Allah)\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "رَبَّنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنزَلْتَ", "hit": true, "audio": "audio/a868aa130c7775305705.m4a", "gloss": {"en": "you sent down", "bs": "objavio si", "tr": "indirdin", "fr": "tu as révélé", "id": "kamu telah menurunkan", "ur": "تم نے اتارا", "bn": "তুমি অবতীর্ণ করেছ", "fa": "نازل کردی"}}, {"text": "وَٱتَّبَعْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرَّسُولَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱكْتُبْنَا", "hit": false, "audio": null, "gloss": null}, {"text": "مَعَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلشَّٰهِدِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "23:29", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2702.mp3", "translation": {"en": {"text": "And say: My Lord! Cause me to land at a blessed landing-place, for Thou art Best of all who bring to land.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ve de ki: \"Rabbim! Beni mübarek bir yere indir. Sen, konuklatanların en hayırlısısın.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور عرض کر کہ اے میرے رب مجھے برکت والی جگہ اتار اور تو سب سے بہتر اتارنے والا ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan berdoalah: Ya Tuhanku, tempatkanlah aku pada tempat yang diberkati, dan Engkau adalah sebaik-baik Yang memberi tempat\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَقُل", "hit": false, "audio": null, "gloss": null}, {"text": "رَّبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنزِلْنِى", "hit": true, "audio": "audio/71cebd419b8c3298fb4d.m4a", "gloss": {"bs": "spusti me", "en": "cause me to land", "tr": "beni indir", "fr": "fais-moi débarquer", "id": "tempatkanlah aku", "ur": "مجھے اتار", "bn": "আমাকে অবতরণ করান", "fa": "مرا فرود آور"}}, {"text": "مُنزَلًا", "hit": false, "audio": null, "gloss": null}, {"text": "مُّبَارَكًا", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنتَ", "hit": false, "audio": null, "gloss": null}, {"text": "خَيْرُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُنزِلِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "56:69", "tense": "past", "category": {"tense": "past", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5048.mp3", "translation": {"en": {"text": "Is it ye who shed it from the raincloud, or are We the Shedder?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Buluttan onu siz mi indirdiniz, yoksa indiren biz miyiz?", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا تم نے اسے بادل سے اتارا یا ہم ہیں اتارنے والے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Kamukah yang menurunkannya atau Kamikah yang menurunkannya?", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ءَأَنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَنزَلْتُمُوهُ", "hit": true, "audio": "audio/f6ad31318ce0165d72dc.m4a", "gloss": {"en": "you (all) sent it down", "bs": "spustili ste ga", "tr": "onu indirdiniz", "fr": "vous l'avez fait descendre", "id": "kalian telah menurunkannya", "ur": "تم سب نے اسے اتارا", "bn": "তোমরা তা অবতীর্ণ করেছ", "fa": "آن را نازل کردید"}}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُزْنِ", "hit": false, "audio": null, "gloss": null}, {"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "نَحْنُ", "hit": false, "audio": nul