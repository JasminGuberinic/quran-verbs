null, "gloss": null}]}, {"ref": "72:2", "tense": "present", "category": {"tense": "present", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5449.mp3", "translation": {"en": {"text": "Which guideth unto righteousness, so we believe in it and we ascribe no partner unto our Lord.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "O Kur'ân hidayete erdiriyor, biz de ona iman ettik. Rabbimize hiçbir şeyi ortak koşmayacağız.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کہ بھلائی کی راہ بتا تا ہے تو ہم اس پر ایمان لائے، اور ہم ہرگز کسی کو اپنے رب کا شریک نہ کریں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "(yang) memberi petunjuk kapada jalan yang benar, lalu kami beriman kepadanya. Dan kami sekali-kali tidak akan mempersekutukan seseorangpun dengan Tuhan kami,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "يَهْدِىٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلرُّشْدِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَـَٔامَنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "وَلَن", "hit": false, "audio": null, "gloss": null}, {"text": "نُّشْرِكَ", "hit": true, "audio": "audio/c4f3cf3a66abcbd4f18d.m4a", "gloss": {"en": "we associate (partners with God)", "bs": "pripisujemo druga Allahu", "tr": "Allah'a ortak koşarız", "fr": "que nous attribuions des associés à Allah", "id": "kami mempersekutukan Allah", "ur": "ہم شرک کریں", "bn": "আমরা আল্লাহর সাথে শরীক করি", "fa": "برای الله شریک قرار دهیم"}}, {"text": "بِرَبِّنَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَحَدًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:32", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "