{"rank": 72, "root": "زيد", "form": 1, "lemma": "زادَ", "count": 49, "ayahCount": 47, "share": 0.25, "meaning": {"bs": "povećati, dodati", "en": "to increase, to add", "tr": "artırmak, eklemek", "fr": "augmenter, ajouter", "id": "menambah", "ur": "بڑھانا، اضافہ کرنا", "bn": "বৃদ্ধি করা, যোগ করা", "fa": "افزودن، زیاد کردن"}, "lemmaSpoken": "audio/4d27041899f74097e2ef.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "زَادَ", "plain": "زَادَ", "quran": false, "notUsed": false, "spoken": "audio/4d27041899f74097e2ef.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "huwa", "arabic": "يَزِيدُ", "plain": "يَزِيدُ", "quran": true, "notUsed": false, "spoken": "audio/2a1d8f4eeb2945188502.m4a", "recited": "audio/9195de46e4c49eb68817.m4a", "recitedText": "يَزِيدُ"}, {"tense": "imperative", "pronoun": "anta", "arabic": "زِدْ", "plain": "زِدْ", "quran": true, "notUsed": false, "spoken": "audio/9c311749b1b067372dd4.m4a", "recited": "audio/abe7b577cacaedcd95ec.m4a", "recitedText": "زِدْ"}], "nouns": {}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "زِدْتُ", "plain": "زِدْتُ", "quran": false, "notUsed": false, "spoken": "audio/4eb0f72f56b7b9f5aa2a.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "زِدْنَا", "plain": "زِدْنَا", "quran": false, "notUsed": false, "spoken": "audio/e0706fd4f9f7e17ba94f.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "زِدْتَ", "plain": "زِدْتَ", "quran": false, "notUsed": false, "spoken": "audio/4ee21c309795ea23eaab.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anti", "arabic": "زِدْتِ", "plain": "زِدْتِ", "quran": false, "notUsed": false, "spoken": "audio/ca2e1ced79291d1a5890.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "antuma", "arabic": "زِدْتُمَا", "plain": "زِدْتُمَا", "quran": false, "notUsed": false, "spoken": "audio/f346508af3fc41afefd3.m4a", "recit