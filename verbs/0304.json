, "quran": false, "notUsed": false, "spoken": "audio/23d576ac0b8c051007a7.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "عُذْنَ", "plain": "عُذْنَ", "quran": false, "notUsed": false, "spoken": "audio/b90cc7746e5000abb65a.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "113:1", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/6226.mp3", "translation": {"en": {"text": "Say: I seek refuge in the Lord of the Daybreak", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki: \"Ben, ağaran sabahın Rabbine sığınırım,", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ میں اس کی پناہ لیتا ہوں جو صبح کا پیدا کرنے والا ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah: \"Aku berlindung kepada Tuhan Yang Menguasai subuh,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعُوذُ", "hit": true, "audio": "audio/4d7273936699d881d4c3.m4a", "gloss": {"bs": "utječem se", "en": "I seek refuge", "tr": "sığınırım", "fr": "je cherche refuge", "id": "aku berlindung", "ur": "میں پناہ مانگتا ہوں", "bn": "আমি আশ্রয় চাই", "fa": "پناه می‌برم"}}, {"text": "بِرَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْفَلَقِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "44:20", "tense": "past", "category": {"tense": "past", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4434.mp3", "translation": {"en": {"text": "And lo! I have sought refuge in my Lord and your Lord lest ye stone me to death.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Gerçekten ben, beni taşlamanızdan dolayı benim de Rabbim, sizin de Rabbiniz olan Allah'a sığındım.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور میں پناہ لیتا ہوں اپنے رب اور تمہارے رب کی اس سے کہ تم مجھے سنگسار کرو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan sesungguhnya aku berlindung kepada Tuhanku dan Tuhanmu, dari keinginanmu merajamku,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِنِّى", "hit": false, "audio": null, "gloss": null}, {"text": "عُذْتُ", "hit": true, "audio": "audio/bcfcca133cc08ccb9204.m4a", "gloss": {"bs": "utječem se", "en": "I have sought refuge", "tr": "sığındım", "fr": "j'ai cherché refuge", "id": "aku telah berlindung", "ur": "میں نے پناہ لی", "bn": "আমি আশ্রয় চেয়েছি", "fa": "پناه بردم"}}, {"text": "بِرَبِّى", "hit": false, "audio": null, "gloss": null}, {"text": "وَرَبِّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "أَن", "hit": false, "audio": null, "gloss": null}, {"text": "تَرْجُمُونِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "72:6", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5453.mp3", "translation": {"en": {"text": "And indeed (O Muhammad) individuals of humankind used to invoke the protection of individuals of the jinn, so that they increased them in revolt against Allah);", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Doğrusu insanlardan bazı erkekler, cinlerden bazı erkeklere sığınırlardı da onların şımarıklıklarını artırırlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور یہ کہ آدمیوں میں کچھ مرد جنوں کے کچھ مردوں کے پناہ لیتے تھے تو اس سے اور بھی ان کا تکبر بڑھا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan bahwasanya ada beberapa orang laki-laki di antara manusia meminta perlindungan kepada beberapa laki-laki di antara jin, maka jin-jin itu menambah bagi mereka dosa dan kesalahan.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"te