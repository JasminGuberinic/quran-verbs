ic": "الْحَارِسُ", "target": false, "translation": {"bs": "čuvar", "en": "the guard", "bn": "প্রহরী", "fa": "نگهبان", "fr": "le gardien", "id": "penjaga itu", "tr": "bekçi", "ur": "پہرے دار"}}, {"arabic": "الْخَطَرَ", "target": false, "translation": {"bs": "opasnost", "en": "the danger", "bn": "বিপদ", "fa": "خطر", "fr": "le danger", "id": "bahaya itu", "tr": "tehlike", "ur": "خطرہ"}}]}, {"arabic": "يَدْرَأُ الدَّوَاءُ الْمَرَضَ", "spoken": "audio/7dbdbcfe60e27bc854c9.m4a", "tense": "present", "pronoun": "huwa", "translation": {"bs": "Lijek otklanja bolest.", "en": "The remedy wards off the disease.", "bn": "ওষুধ রোগ দূর করে।", "fa": "دارو بیماری را دفع می‌کند.", "fr": "Le remède écarte la maladie.", "id": "Obat itu menangkal penyakit itu.", "tr": "Çare hastalığı savar.", "ur": "دوا بیماری کو ٹالتی ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "يَدْرَأُ", "target": true, "translation": {"bs": "otklanja", "en": "wards off", "bn": "প্রতিহত করে", "fa": "دفع می‌کند", "fr": "repousse", "id": "ia menangkal", "tr": "savar", "ur": "ٹالتا ہے"}}, {"arabic": "الدَّوَاءُ", "target": false, "translation": {"bs": "lijek", "en": "the remedy", "bn": "ওষুধ", "fa": "دارو", "fr": "le remède", "id": "obat itu", "tr": "çare", "ur": "دوا"}}, {"arabic": "الْمَرَضَ", "target": false, "translation": {"bs": "bolest", "en": "the disease", "bn": "রোগ", "fa": "بیماری", "fr": "la maladie", "id": "penyakit itu", "tr": "hastalık", "ur": "بیماری"}}]}, {"arabic": "أَدْرَأُ الْبَرْدَ بِالْمِعْطَفِ", "spoken": "audio/1c6053fbea165c99787d.m4a", "tense": "present", "pronoun": "ana", "translation": {"bs": "Otklanjam hladnoću kaputom.", "en": "I ward off the cold with the overcoat.", "bn": "আমি কোট দিয়ে ঠান্ডা প্রতিরোধ করি।", "fa": "با کت، سرما را دفع می‌کنم.", "fr": "Je me protège du froid avec le manteau.", "id": "Aku menangkal dingin dengan mantel itu.", "tr": "Soğuğu palto ile savarım.", "ur": "میں کوٹ کے ذریعے سردی کو ٹالتا ہوں۔"}, "independentlyReviewed": true, "words": [{"arabic": "أَد