{"ayat":[{"ref":"10:16","number":1380,"text":"قُل لَّوْ شَآءَ ٱللَّهُ مَا تَلَوْتُهُۥ عَلَيْكُمْ وَلَآ أَدْرَىٰكُم بِهِۦ فَقَدْ لَبِثْتُ فِيكُمْ عُمُرًا مِّن قَبْلِهِۦٓ أَفَلَا تَعْقِلُونَ","hits":[8]},{"ref":"33:63","number":3596,"text":"يَسْـَٔلُكَ ٱلنَّاسُ عَنِ ٱلسَّاعَةِ قُلْ إِنَّمَا عِلْمُهَا عِندَ ٱللَّهِ وَمَا يُدْرِيكَ لَعَلَّ ٱلسَّاعَةَ تَكُونُ قَرِيبًا","hits":[10]},{"ref":"42:17","number":4289,"text":"ٱللَّهُ ٱلَّذِىٓ أَنزَلَ ٱلْكِتَٰبَ بِٱلْحَقِّ وَٱلْمِيزَانَ وَمَا يُدْرِيكَ لَعَلَّ ٱلسَّاعَةَ قَرِيبٌ","hits":[7]},{"ref":"69:3","number":5326,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","hits":[1]},{"ref":"74:27","number":5522,"text":"وَمَآ أَدْرَىٰكَ مَا سَقَرُ","hits":[1]},{"ref":"77:14","number":5636,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","hits":[1]},{"ref":"80:3","number":5761,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","hits":[1]},{"ref":"82:17","number":5846,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","hits":[1]},{"ref":"82:18","number":5847,"text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","hits":[2]},{"ref":"83:8","number":5856,"text":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ","hits":[1]},{"ref":"83:19","number":5867,"text":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","hits":[1]},{"ref":"86:2","number":5933,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","hits":[1]},{"ref":"90:12","number":6035,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","hits":[1]},{"ref":"97:2","number":6127,"text":"وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ","hits":[1]},{"ref":"101:3","number":6160,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","hits":[1]},{"ref":"101:10","number":6167,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","hits":[1]},{"ref":"104:5","number":6184,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","hits":[1]}]}