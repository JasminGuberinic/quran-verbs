poken": "audio/e3dfd3276fca84734d9f.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "زَيِّنِي", "plain": "زَيِّنِي", "quran": false, "notUsed": false, "spoken": "audio/0cd46dc3b7059cc38260.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "زَيِّنَا", "plain": "زَيِّنَا", "quran": false, "notUsed": false, "spoken": "audio/45b662bdc12143c34110.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "زَيِّنُوا", "plain": "زَيِّنُوا", "quran": false, "notUsed": false, "spoken": "audio/743fbb4b814dd704d00a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "زَيِّنَّ", "plain": "زَيِّنَّ", "quran": false, "notUsed": false, "spoken": "audio/cfc92486be491b3e706d.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "37:6", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3794.mp3", "translation": {"en": {"text": "Lo! We have adorned the lowest heaven with an ornament, the planets;", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Gerçekten biz dünya göğünü (o yakın göğü) bir zinetle, yıldızlarla süsledik.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور بیشک ہم نے نیچے کے آسمان کو تاروں کے سنگھار سے آراستہ کیا،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya Kami telah menghias langit yang terdekat dengan hiasan, yaitu bintang-bintang,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّا", "hit": false, "audio": null, "gloss": null}, {"text": "زَيَّنَّا", "hit": true, "audio": "audio/0bd83ca3ae05eb1b763a.m4a", "gloss": {"bs": "ukrasili smo", "en": "We adorned", "tr": "süsledik", "fr": "Nous avons embelli", "id": "Kami menghiasi", "ur": "ہم نے مزین کیا", "bn": "আমরা সুশোভিত করেছি", "fa": "آراستیم"}}, {"text": "ٱلسَّمَآءَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلدُّنْيَا", "hit": false, "audio": null, "gloss": null}, {"text": "بِزِينَةٍ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكَوَاكِبِ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "15:39", "tense": "present", "category": {"tense": "present", "pronoun": "ana", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1841.mp3", "translation": {"en": {"text": "He said: My Lord! Because Thou hast sent me astray, I verily shall adorn the path of error for them in the earth, and shall mislead them every one,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "İblis şöyle dedi: \"Rabbim! Beni saptırdığın için, mutlaka ben de yeryüzünde onlara günahları süsleyeceğim ve onların hepsini mutlaka azdıracağım!\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بولا اے رب میرے! قسم اس کی کہ تو نے مجھے گمراہ کیا میں انہیں زمین میں بھلاوے دوں گا اور ضرور میں ان سب کو بے راہ کروں گا", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Iblis berkata: \"Ya Tuhanku, oleh sebab Engkau telah memutuskan bahwa aku sesat, pasti aku akan menjadikan mereka memandang baik (perbuatan maksiat) di muka bumi, dan pasti aku akan menyesatkan mereka semuanya,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "رَبِّ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَغْوَيْتَنِى", "hit": false, "audio": null, "gloss": null}, {"text": "لَأُزَيِّنَنَّ", "hit": true, "audio": "audio/dcc1b2363d2ccc79ecaf.m4a", "gloss": {"bs": "sigurno ću uljepšati", "en": "I will surely make attractive", "tr": "mutlaka güzel göstereceğim", "fr": "certes je rendrai séduisant", "id": "aku pasti akan memperindah", "ur": "میں ضرور خوشنما بنا دوں گا", "bn": "আম