{"rank": 75, "root": "ظنن", "form": 1, "lemma": "ظَنَّ", "count": 47, "ayahCount": 44, "share": 0.24, "meaning": {"bs": "misliti, smatrati", "en": "to think, to assume", "tr": "sanmak, zannetmek", "fr": "penser, supposer", "id": "mengira, menyangka", "ur": "گمان کرنا، خیال کرنا", "bn": "মনে করা, ধারণা করা", "fa": "گمان کردن، پنداشتن"}, "lemmaSpoken": "audio/19336c99e268f8b7322a.m4a", "animation": "<svg class=\"va va-vznn_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 72\"><style> @keyframes vznn_1-0{from{opacity:0}}.va-vznn_1 .ra{transform:rotate(-150deg)}.va-vznn_1 .bb{animation:vznn_1-0 0.5s ease-out both}.va-vznn_1 .d0{animation:vznn_1-0 0.3s ease-out 0.5s both}.va-vznn_1 .d1{animation:vznn_1-0 0.3s ease-out 0.9s both}.va-vznn_1 .d2{animation:vznn_1-0 0.3s ease-out 1.3s both}.f,.p{fill:none;stroke-linecap:round;stroke-linejoin:round}.f{stroke:var(--accent);stroke-width:4.5}.t{stroke-width:8}.h{fill:var(--accent)}.p{stroke:var(--gold);stroke-width:3}.q{fill:var(--gold)}.va-vznn_1.off,.va-vznn_1.off *{animation:none!important}@media(prefers-reduced-motion:reduce){.va-vznn_1,.va-vznn_1 *{animation:none!important}}</style><path class=\"p\" d=\"M6 61H114\"/><g transform=\"translate(48 44)\"><g class=\"fig\"><g class=\"ll\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"rl\"><path class=\"f\" d=\"M0 0v17\"/></g><g class=\"tr\"><path class=\"f t\" d=\"M0 0V-17\"/><circle class=\"h\" cy=\"-26\" r=\"6.5\"/><g transform=\"translate(0 -15)\"><g class=\"la\"><path class=\"f\" d=\"M0 0v14\"/></g></g><g transform=\"translate(0 -15)\"><g class=\"ra\"><path class=\"f\" d=\"M0 0v14\"/></g></g></g></g></g><g class=\"bb\"><circle class=\"p\" cx=\"72\" cy=\"12\" r=\"7\"/><circle class=\"q\" cx=\"67.8\" cy=\"22.0\" r=\"1.6\"/><circle class=\"q\" cx=\"65.0\" cy=\"26.0\" r=\"1\"/></g><circle class=\"q d0\" cx=\"68\" cy=\"12\" r=\"1.4\"/><circle class=\"q d1\" cx=\"72\" cy=\"12\" r=\"1.4\"/><circle class=\"q d2\" cx=\"76\" cy=\"12\" r=\"1.4\"/></svg> ", "principal": [{"tens