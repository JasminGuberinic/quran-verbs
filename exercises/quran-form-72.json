[{"id":"jamaa-10-58-9","words":["verb:jamaa"],"options":[{"bs":"sakupljaju","en":"they amass"},{"bs":"pa smo ih okupili","en":"so we gathered them"},{"bs":"pa je okupio","en":"so he/it gathered"},{"bs":"okupili smo vas","en":"we gathered you (all)"}],"ref":"10:58","answerWord":"يَجْمَعُونَ","answerSound":"audio/368bdc87f56d55a6e0ba.m4a","quranTranslation":{"text":"Say: In the bounty of Allah and in His mercy: therein let them rejoice. It is better than what they hoard.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["قُلْ","بِفَضْلِ","ٱللَّهِ","وَبِرَحْمَتِهِۦ","فَبِذَٰلِكَ","فَلْيَفْرَحُوا۟","هُوَ","خَيْرٌ","مِّمَّا","يَجْمَعُونَ"],"marked":[9],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-34-26-1","words":["verb:jamaa"],"options":[{"bs":"okuplja","en":"he/it gathers"},{"bs":"okupili su","en":"they gathered"},{"bs":"zaista će vas okupiti","en":"surely he/it will gather you (all)"},{"bs":"sakupio je","en":"he gathered"}],"ref":"34:26","answerWord":"يَجْمَعُ","answerSound":"audio/aaec9285e530e9799c01.m4a","quranTranslation":{"text":"Say: Our Lord will bring us all together, then He will judge between us with truth. He is the All-knowing Judge.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["قُلْ","يَجْمَعُ","بَيْنَنَا","رَبُّنَا","ثُمَّ","يَفْتَحُ","بَيْنَنَا","بِٱلْحَقِّ","وَهُوَ","ٱلْفَتَّاحُ","ٱلْعَلِيمُ"],"marked":[1],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-4-87-5","words":["verb:jamaa"],"options":[{"bs":"zaista će vas okupiti","en":"surely he/it will gather you (all)"},{"bs":"pa smo ih okupili","en":"so we gathered them"},{"bs":"sakupio je","en":"he gathered"},{"bs":"spajate","en":"you (all) join together"}],"ref":"4:87","answerWord":"لَيَجْمَعَنَّكُمْ","answerSound":"audio/3e9c84a8587c22859577.m4a","quranTranslation":{"text":"Allah! There is no Allah save Him. He gathereth you all unto a Day of Resurrection whereof there is no doubt. Who is more true in statement than Allah?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["ٱللَّهُ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","لَيَجْمَعَنَّكُمْ","إِلَىٰ","يَوْمِ","ٱلْقِيَٰمَةِ","لَا","رَيْبَ","فِيهِ","وَمَنْ","أَصْدَقُ","مِنَ","ٱللَّهِ","حَدِيثًا"],"marked":[5],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-45-26-6","words":["verb:jamaa"],"options":[{"bs":"okuplja vas","en":"he/it gathers you (all)"},{"bs":"okuplja","en":"he/it gathers"},{"bs":"i okupljen je","en":"and he/it was gathered"},{"bs":"okupili smo ih","en":"we gathered them"}],"ref":"45:26","answerWord":"يَجْمَعُكُمْ","answerSound":"audio/b6889c0592b0ee4e3152.m4a","quranTranslation":{"text":"Say (unto them, O Muhammad): Allah giveth life to you, then causeth you to die, then gathereth you unto the Day of Resurrection whereof there is no doubt. But most of mankind know not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["قُلِ","ٱللَّهُ","يُحْيِيكُمْ","ثُمَّ","يُمِيتُكُمْ","ثُمَّ","يَجْمَعُكُمْ","إِلَىٰ","يَوْمِ","ٱلْقِيَٰمَةِ","لَا","رَيْبَ","فِيهِ","وَلَٰكِنَّ","أَكْثَرَ","ٱلنَّاسِ","لَا","يَعْلَمُونَ"],"marked":[6],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-3-25-2","words":["verb:jamaa"],"options":[{"bs":"okupili smo ih","en":"we gathered them"},{"bs":"okupili su","en":"they gathered"},{"bs":"i sakupio je","en":"and he/it amassed"},{"bs":"okuplja vas","en":"he/it gathers you (all)"}],"ref":"3:25","answerWord":"جَمَعْنَٰهُمْ","answerSound":"audio/2087f9e879f3c4ea2ecf.m4a","quranTranslation":{"text":"How (will it be with them) when We have brought them all together to a Day of which there is no doubt, when every soul will be paid in full what it hath earned, and they will not be wronged.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["فَكَيْفَ","إِذَا","جَمَعْنَٰهُمْ","لِيَوْمٍ","لَّا","رَيْبَ","فِيهِ","وَوُفِّيَتْ","كُلُّ","نَفْسٍ","مَّا","كَسَبَتْ","وَهُمْ","لَا","يُظْلَمُونَ"],"marked":[2],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-3-173-7","words":["verb:jamaa"],"options":[{"bs":"okupili su","en":"they gathered"},{"bs":"okupili smo vas","en":"we gathered you (all)"},{"bs":"sakupio je","en":"he gathered"},{"bs":"pa smo ih okupili","en":"so we gathered them"}],"ref":"3:173","answerWord":"جَمَعُوا۟","answerSound":"audio/668b1b53809a9320c8ec.m4a","quranTranslation":{"text":"Those unto whom men said: Lo! the people have gathered against you, therefor fear them. (The threat of danger) but increased the faith of them and they cried: Allah is Sufficient for us! Most Excellent is He in Whom we trust!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["ٱلَّذِينَ","قَالَ","لَهُمُ","ٱلنَّاسُ","إِنَّ","ٱلنَّاسَ","قَدْ","جَمَعُوا۟","لَكُمْ","فَٱخْشَوْهُمْ","فَزَادَهُمْ","إِيمَٰنًا","وَقَالُوا۟","حَسْبُنَا","ٱللَّهُ","وَنِعْمَ","ٱلْوَكِيلُ"],"marked":[7],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-18-99-9","words":["verb:jamaa"],"options":[{"bs":"pa smo ih okupili","en":"so we gathered them"},{"bs":"okuplja vas","en":"he/it gathers you (all)"},{"bs":"spajate","en":"you (all) join together"},{"bs":"sakupit ćemo","en":"We will gather"}],"ref":"18:99","answerWord":"فَجَمَعْنَٰهُمْ","answerSound":"audio/d8f17b79c23930469265.m4a","quranTranslation":{"text":"And on that day we shall let some of them surge against others, and the Trumpet will be blown. Then We shall gather them together in one gathering.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["وَتَرَكْنَا","بَعْضَهُمْ","يَوْمَئِذٍ","يَمُوجُ","فِى","بَعْضٍ","وَنُفِخَ","فِى","ٱلصُّورِ","فَجَمَعْنَٰهُمْ","جَمْعًا"],"marked":[9],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-20-60-2","words":["verb:jamaa"],"options":[{"bs":"pa je okupio","en":"so he/it gathered"},{"bs":"zaista će vas okupiti","en":"surely he/it will gather you (all)"},{"bs":"sakupljaju","en":"they amass"},{"bs":"okupili smo ih","en":"we gathered them"}],"ref":"20:60","answerWord":"فَجَمَعَ","answerSound":"audio/dde1c821a878502af88c.m4a","quranTranslation":{"text":"Then Pharaoh went and gathered his strength, then came (to the appointed tryst).","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["فَتَوَلَّىٰ","فِرْعَوْنُ","فَجَمَعَ","كَيْدَهُۥ","ثُمَّ","أَتَىٰ"],"marked":[2],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-26-38-0","words":["verb:jamaa"],"options":[{"bs":"pa je okupljen","en":"so he/it was gathered"},{"bs":"okupili smo vas","en":"we gathered you (all)"},{"bs":"sakupljaju","en":"they amass"},{"bs":"zaista će vas okupiti","en":"surely he/it will gather you (all)"}],"ref":"26:38","answerWord":"فَجُمِعَ","answerSound":"audio/3a374c7c9f96afacf292.m4a","quranTranslation":{"text":"So the wizards were gathered together at a set time on a day appointed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["فَجُمِعَ","ٱلسَّحَرَةُ","لِمِيقَٰتِ","يَوْمٍ","مَّعْلُومٍ"],"marked":[0],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-70-18-0","words":["verb:jamaa"],"options":[{"bs":"i sakupio je","en":"and he/it amassed"},{"bs":"sakupljaju","en":"they amass"},{"bs":"okupili smo ih","en":"we gathered them"},{"bs":"zaista će vas okupiti","en":"surely he/it will gather you (all)"}],"ref":"70:18","answerWord":"وَجَمَعَ","answerSound":"audio/4024313b84b7b4e22f59.m4a","quranTranslation":{"text":"And hoarded (wealth) and withheld it.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["وَجَمَعَ","فَأَوْعَىٰٓ"],"marked":[0],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-75-3-3","words":["verb:jamaa"],"options":[{"bs":"sakupit ćemo","en":"We will gather"},{"bs":"spajate","en":"you (all) join together"},{"bs":"sakupio je","en":"he gathered"},{"bs":"pa je okupljen","en":"so he/it was gathered"}],"ref":"75:3","answerWord":"نَّجْمَعَ","answerSound":"audio/d086696e5ac13cd69246.m4a","quranTranslation":{"text":"Thinketh man that We shall not assemble his bones?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["أَيَحْسَبُ","ٱلْإِنسَٰنُ","أَلَّن","نَّجْمَعَ","عِظَامَهُۥ"],"marked":[3],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-75-9-0","words":["verb:jamaa"],"options":[{"bs":"i okupljen je","en":"and he/it was gathered"},{"bs":"okuplja vas","en":"he/it gathers you (all)"},{"bs":"pa smo ih okupili","en":"so we gathered them"},{"bs":"sakupljaju","en":"they amass"}],"ref":"75:9","answerWord":"وَجُمِعَ","answerSound":"audio/31a5c61050a26250b9e2.m4a","quranTranslation":{"text":"And sun and moon are united,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["وَجُمِعَ","ٱلشَّمْسُ","وَٱلْقَمَرُ"],"marked":[0],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-77-38-3","words":["verb:jamaa"],"options":[{"bs":"okupili smo vas","en":"we gathered you (all)"},{"bs":"i okupljen je","en":"and he/it was gathered"},{"bs":"pa smo ih okupili","en":"so we gathered them"},{"bs":"okupili su","en":"they gathered"}],"ref":"77:38","answerWord":"جَمَعْنَٰكُمْ","answerSound":"audio/9476fdd5c218c1b68a20.m4a","quranTranslation":{"text":"This is the Day of Decision, We have brought you and the men of old together.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["هَٰذَا","يَوْمُ","ٱلْفَصْلِ","جَمَعْنَٰكُمْ","وَٱلْأَوَّلِينَ"],"marked":[3],"facts":{"verb":"جَمَعَ"}},{"id":"jamaa-104-2-1","words":["verb:jamaa"],"options":[{"bs":"sakupio je","en":"he gathered"},{"bs":"okupili smo ih","en":"we gathered them"},{"bs":"okuplja vas","en":"he/it gathers you (all)"},{"bs":"okupili smo vas","en":"we gathered you (all)"}],"ref":"104:2","answerWord":"جَمَعَ","answerSound":"audio/2fa9b3a7fcec7c936ea2.m4a","quranTranslation":{"text":"Who hath gathered wealth (of this world) and arranged it.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"sakupiti, okupiti","en":"to gather, to collect"},"passage":["ٱلَّذِى","جَمَعَ","مَالًا","وَعَدَّدَهُۥ"],"marked":[1],"facts":{"verb":"جَمَعَ"}},{"id":"kaffara-64-9-12","words":["verb:kaffara"],"options":[{"bs":"briše grijehe","en":"he/it removes (sins)"},{"bs":"zaista ću izbrisati grijehe","en":"surely I will remove (sins)"},{"bs":"i izbriši grijehe!","en":"and remove (sins)!"},{"bs":"izbrisao je grijehe","en":"he/it removed (sins)"}],"ref":"64:9","answerWord":"يُكَفِّرْ","answerSound":"audio/4c486ce297629aa7387f.m4a","quranTranslation":{"text":"The day when He shall gather you unto the Day of Assembling, that will be a day of mutual disillusion. And whoso believeth in Allah and doeth right, He will remit from him his evil deeds and will bring him unto Gardens underneath which rivers flow, therein to abide for ever. That is the supreme triumph.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati (grijehe), iskupiti","en":"to remove (sins), to expiate"},"passage":["يَوْمَ","يَجْمَعُكُمْ","لِيَوْمِ","ٱلْجَمْعِ","ذَٰلِكَ","يَوْمُ","ٱلتَّغَابُنِ","وَمَن","يُؤْمِنۢ","بِٱللَّهِ","وَيَعْمَلْ","صَٰلِحًا","يُكَفِّرْ","عَنْهُ","سَيِّـَٔاتِهِۦ","وَيُدْخِلْهُ","جَنَّٰتٍ","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدًا","ذَٰلِكَ","ٱلْفَوْزُ","ٱلْعَظِيمُ"],"marked":[12],"facts":{"verb":"كَفَّرَ"}},{"id":"kaffara-2-271-12","words":["verb:kaffara"],"options":[{"bs":"i briše grijehe","en":"and he/it removes (sins)"},{"bs":"zaista ćemo izbrisati grijehe","en":"surely we will remove (sins)"},{"bs":"izbrisali bismo","en":"We would have removed"},{"bs":"zaista ću izbrisati grijehe","en":"surely I will remove (sins)"}],"ref":"2:271","answerWord":"وَيُكَفِّرُ","answerSound":"audio/3bc3d057ab3f9bfb0e85.m4a","quranTranslation":{"text":"If ye publish your almsgiving, it is well, but if ye hide it and give it to the poor, it will be better for you, and will atone for some of your ill-deeds. Allah is Informed of what ye do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati (grijehe), iskupiti","en":"to remove (sins), to expiate"},"passage":["إِن","تُبْدُوا۟","ٱلصَّدَقَٰتِ","فَنِعِمَّا","هِىَ","وَإِن","تُخْفُوهَا","وَتُؤْتُوهَا","ٱلْفُقَرَآءَ","فَهُوَ","خَيْرٌ","لَّكُمْ","وَيُكَفِّرُ","عَنكُم","مِّن","سَيِّـَٔاتِكُمْ","وَٱللَّهُ","بِمَا","تَعْمَلُونَ","خَبِيرٌ"],"marked":[12],"facts":{"verb":"كَفَّرَ"}},{"id":"kaffara-3-193-14","words":["verb:kaffara"],"options":[{"bs":"i izbriši grijehe!","en":"and remove (sins)!"},{"bs":"zaista ću izbrisati grijehe","en":"surely I will remove (sins)"},{"bs":"i briše grijehe","en":"and he/it removes (sins)"},{"bs":"izbrisali bismo","en":"We would have removed"}],"ref":"3:193","answerWord":"وَكَفِّرْ","answerSound":"audio/ac1cee4d693ceb7477d3.m4a","quranTranslation":{"text":"Our Lord! Lo! we have heard a crier calling unto Faith: \"Believe ye in your Lord!\" So we believed. Our Lord! Therefor forgive us our sins, and remit from us our evil deeds, and make us die the death of the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati (grijehe), iskupiti","en":"to remove (sins), to expiate"},"passage":["رَّبَّنَآ","إِنَّنَا","سَمِعْنَا","مُنَادِيًا","يُنَادِى","لِلْإِيمَٰنِ","أَنْ","ءَامِنُوا۟","بِرَبِّكُمْ","فَـَٔامَنَّا","رَبَّنَا","فَٱغْفِرْ","لَنَا","ذُنُوبَنَا","وَكَفِّرْ","عَنَّا","سَيِّـَٔاتِنَا","وَتَوَفَّنَا","مَعَ","ٱلْأَبْرَارِ"],"marked":[14],"facts":{"verb":"كَفَّرَ"}},{"id":"kaffara-4-31-6","words":["verb:kaffara"],"options":[{"bs":"izbrisat ćemo","en":"We will remove"},{"bs":"izbrisao je grijehe","en":"he/it removed (sins)"},{"bs":"i briše grijehe","en":"and he/it removes (sins)"},{"bs":"zaista ću izbrisati grijehe","en":"surely I will remove (sins)"}],"ref":"4:31","answerWord":"نُكَفِّرْ","answerSound":"audio/ebfcce3362cf6ee60bd3.m4a","quranTranslation":{"text":"If ye avoid the great (things) which ye are forbidden, We will remit from you your evil deeds and make you enter at a noble gate.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati (grijehe), iskupiti","en":"to remove (sins), to expiate"},"passage":["إِن","تَجْتَنِبُوا۟","كَبَآئِرَ","مَا","تُنْهَوْنَ","عَنْهُ","نُكَفِّرْ","عَنكُمْ","سَيِّـَٔاتِكُمْ","وَنُدْخِلْكُم","مُّدْخَلًا","كَرِيمًا"],"marked":[6],"facts":{"verb":"كَفَّرَ"}},{"id":"kaffara-5-65-6","words":["verb:kaffara"],"options":[{"bs":"izbrisali bismo","en":"We would have removed"},{"bs":"i briše grijehe","en":"and he/it removes (sins)"},{"bs":"zaista ćemo izbrisati grijehe","en":"surely we will remove (sins)"},{"bs":"i izbriši grijehe!","en":"and remove (sins)!"}],"ref":"5:65","answerWord":"لَكَفَّرْنَا","answerSound":"audio/022862504a1b4b0da5a6.m4a","quranTranslation":{"text":"If only the People of the Scripture would believe and ward off (evil), surely We should remit their sins from them and surely We should bring them into Gardens of Delight.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati (grijehe), iskupiti","en":"to remove (sins), to expiate"},"passage":["وَلَوْ","أَنَّ","أَهْلَ","ٱلْكِتَٰبِ","ءَامَنُوا۟","وَٱتَّقَوْا۟","لَكَفَّرْنَا","عَنْهُمْ","سَيِّـَٔاتِهِمْ","وَلَأَدْخَلْنَٰهُمْ","جَنَّٰتِ","ٱلنَّعِيمِ"],"marked":[6],"facts":{"verb":"كَفَّرَ"}},{"id":"kaffara-8-29-9","words":["verb:kaffara"],"options":[{"bs":"i briše grijehe","en":"and he/it removes (sins)"},{"bs":"zaista ćemo izbrisati grijehe","en":"surely we will remove (sins)"},{"bs":"i izbriši grijehe!","en":"and remove (sins)!"},{"bs":"izbrisao je grijehe","en":"he/it removed (sins)"}],"ref":"8:29","answerWord":"وَيُكَفِّرْ","answerSound":"audio/271cddf62c30e7c977a0.m4a","quranTranslation":{"text":"O ye who believe! If ye keep your duty to Allah, He will give you discrimination (between right and wrong) and will rid you of your evil thoughts and deeds, and will forgive you. Allah is of Infinite Bounty.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati (grijehe), iskupiti","en":"to remove (sins), to expiate"},"passage":["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓا۟","إِن","تَتَّقُوا۟","ٱللَّهَ","يَجْعَل","لَّكُمْ","فُرْقَانًا","وَيُكَفِّرْ","عَنكُمْ","سَيِّـَٔاتِكُمْ","وَيَغْفِرْ","لَكُمْ","وَٱللَّهُ","ذُو","ٱلْفَضْلِ","ٱلْعَظِيمِ"],"marked":[9],"facts":{"verb":"كَفَّرَ"}},{"id":"kaffara-29-7-4","words":["verb:kaffara"],"options":[{"bs":"zaista ćemo izbrisati grijehe","en":"surely we will remove (sins)"},{"bs":"i izbriši grijehe!","en":"and remove (sins)!"},{"bs":"izbrisali bismo","en":"We would have removed"},{"bs":"i briše grijehe","en":"and he/it removes (sins)"}],"ref":"29:7","answerWord":"لَنُكَفِّرَنَّ","answerSound":"audio/7b507d2bdd6ce3d0c773.m4a","quranTranslation":{"text":"And as for those who believe and do good works, We shall remit from them their evil deeds and shall repay them the best that they did.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati (grijehe), iskupiti","en":"to remove (sins), to expiate"},"passage":["وَٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","لَنُكَفِّرَنَّ","عَنْهُمْ","سَيِّـَٔاتِهِمْ","وَلَنَجْزِيَنَّهُمْ","أَحْسَنَ","ٱلَّذِى","كَانُوا۟","يَعْمَلُونَ"],"marked":[4],"facts":{"verb":"كَفَّرَ"}},{"id":"kaffara-39-35-0","words":["verb:kaffara"],"options":[{"bs":"da izbriše grijehe","en":"so that he/it may remove (sins)"},{"bs":"i izbriši grijehe!","en":"and remove (sins)!"},{"bs":"zaista ću izbrisati grijehe","en":"surely I will remove (sins)"},{"bs":"izbrisat ćemo","en":"We will remove"}],"ref":"39:35","answerWord":"لِيُكَفِّرَ","answerSound":"audio/9b278c5dcba913c3c51f.m4a","quranTranslation":{"text":"That Allah will remit from them the worst of what they did, and will pay them for reward the best they used to do.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati (grijehe), iskupiti","en":"to remove (sins), to expiate"},"passage":["لِيُكَفِّرَ","ٱللَّهُ","عَنْهُمْ","أَسْوَأَ","ٱلَّذِى","عَمِلُوا۟","وَيَجْزِيَهُمْ","أَجْرَهُم","بِأَحْسَنِ","ٱلَّذِى","كَانُوا۟","يَعْمَلُونَ"],"marked":[0],"facts":{"verb":"كَفَّرَ"}},{"id":"kaffara-47-2-13","words":["verb:kaffara"],"options":[{"bs":"izbrisao je grijehe","en":"he/it removed (sins)"},{"bs":"i briše grijehe","en":"and he/it removes (sins)"},{"bs":"zaista ću izbrisati grijehe","en":"surely I will remove (sins)"},{"bs":"i izbriši grijehe!","en":"and remove (sins)!"}],"ref":"47:2","answerWord":"كَفَّرَ","answerSound":"audio/587ce332c970c4279827.m4a","quranTranslation":{"text":"And those who believe and do good works and believe in that which is revealed unto Muhammad - and it is the truth from their Lord - He riddeth them of their ill-deeds and improveth their state.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati (grijehe), iskupiti","en":"to remove (sins), to expiate"},"passage":["وَٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","وَءَامَنُوا۟","بِمَا","نُزِّلَ","عَلَىٰ","مُحَمَّدٍ","وَهُوَ","ٱلْحَقُّ","مِن","رَّبِّهِمْ","كَفَّرَ","عَنْهُمْ","سَيِّـَٔاتِهِمْ","وَأَصْلَحَ","بَالَهُمْ"],"marked":[13],"facts":{"verb":"كَفَّرَ"}},{"id":"kaffara-48-5-10","words":["verb:kaffara"],"options":[{"bs":"i briše grijehe","en":"and he/it removes (sins)"},{"bs":"i izbriši grijehe!","en":"and remove (sins)!"},{"bs":"zaista ćemo izbrisati grijehe","en":"surely we will remove (sins)"},{"bs":"zaista ću izbrisati grijehe","en":"surely I will remove (sins)"}],"ref":"48:5","answerWord":"وَيُكَفِّرَ","answerSound":"audio/a426327e99895d7ce9fa.m4a","quranTranslation":{"text":"That He may bring the believing men and the believing women into Gardens underneath which rivers flow, wherein they will abide, and may remit from them their evil deeds - That, in the sight of Allah, is the supreme triumph -","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"izbrisati (grijehe), iskupiti","en":"to remove (sins), to expiate"},"passage":["لِّيُدْخِلَ","ٱلْمُؤْمِنِينَ","وَٱلْمُؤْمِنَٰتِ","جَنَّٰتٍ","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَٰرُ","خَٰلِدِينَ","فِيهَا","وَيُكَفِّرَ","عَنْهُمْ","سَيِّـَٔاتِهِمْ","وَكَانَ","ذَٰلِكَ","عِندَ","ٱللَّهِ","فَوْزًا","عَظِيمًا"],"marked":[10],"facts":{"verb":"كَفَّرَ"}},{"id":"salla-3-39-4","words":["verb:salla"],"options":[{"bs":"klanja","en":"he/it prays"},{"bs":"klanjajte!","en":"(you all) pray!"},{"bs":"blagosiljaju","en":"they send blessings"},{"bs":"i klanjaj!","en":"and pray!"}],"ref":"3:39","answerWord":"يُصَلِّى","answerSound":"audio/457b3aed28f34b5ed18d.m4a","quranTranslation":{"text":"And the angels called to him as he stood praying in the sanctuary: Allah giveth thee glad tidings of (a son whose name is) John, (who cometh) to confirm a word from Allah lordly, chaste, a prophet of the righteous.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"klanjati, moliti","en":"to pray"},"passage":["فَنَادَتْهُ","ٱلْمَلَٰٓئِكَةُ","وَهُوَ","قَآئِمٌ","يُصَلِّى","فِى","ٱلْمِحْرَابِ","أَنَّ","ٱللَّهَ","يُبَشِّرُكَ","بِيَحْيَىٰ","مُصَدِّقًۢا","بِكَلِمَةٍ","مِّنَ","ٱللَّهِ","وَسَيِّدًا","وَحَصُورًا","وَنَبِيًّا","مِّنَ","ٱلصَّٰلِحِينَ"],"marked":[4],"facts":{"verb":"صَلَّى"}},{"id":"salla-9-103-7","words":["verb:salla"],"options":[{"bs":"i klanjaj!","en":"and pray!"},{"bs":"klanjao je","en":"he/it prayed"},{"bs":"pa neka klanjaju","en":"so let them pray"},{"bs":"klanjajte!","en":"(you all) pray!"}],"ref":"9:103","answerWord":"وَصَلِّ","answerSound":"audio/4a61038073b8a9d70d6f.m4a","quranTranslation":{"text":"Take alms of their wealth, wherewith thou mayst purify them and mayst make them grow, and pray for them. Lo! thy prayer is an assuagement for them. Allah is Hearer, Knower.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"klanjati, moliti","en":"to pray"},"passage":["خُذْ","مِنْ","أَمْوَٰلِهِمْ","صَدَقَةً","تُطَهِّرُهُمْ","وَتُزَكِّيهِم","بِهَا","وَصَلِّ","عَلَيْهِمْ","إِنَّ","صَلَوٰتَكَ","سَكَنٌ","لَّهُمْ","وَٱللَّهُ","سَمِيعٌ","عَلِيمٌ"],"marked":[7],"facts":{"verb":"صَلَّى"}},{"id":"salla-33-56-3","words":["verb:salla"],"options":[{"bs":"blagosiljaju","en":"they send blessings"},{"bs":"pa klanjaj","en":"so pray"},{"bs":"klanja","en":"he/it prays"},{"bs":"pa je klanjao","en":"so he/it prayed"}],"ref":"33:56","answerWord":"يُصَلُّونَ","answerSound":"audio/fd1cef148c44cbd1a8c3.m4a","quranTranslation":{"text":"Lo! Allah and His angels shower blessings on the Prophet. O ye who believe! Ask blessings on him and salute him with a worthy salutation.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"klanjati, moliti","en":"to pray"},"passage":["إِنَّ","ٱللَّهَ","وَمَلَٰٓئِكَتَهُۥ","يُصَلُّونَ","عَلَى","ٱلنَّبِىِّ","يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","صَلُّوا۟","عَلَيْهِ","وَسَلِّمُوا۟","تَسْلِيمًا"],"marked":[3],"facts":{"verb":"صَلَّى"}},{"id":"salla-33-56-9","words":["verb:salla"],"options":[{"bs":"klanjajte!","en":"(you all) pray!"},{"bs":"i klanjaj!","en":"and pray!"},{"bs":"klanjao je","en":"he/it prayed"},{"bs":"pa neka klanjaju","en":"so let them pray"}],"ref":"33:56","answerWord":"صَلُّوا۟","answerSound":"audio/f6c2516bba7659dc34a6.m4a","quranTranslation":{"text":"Lo! Allah and His angels shower blessings on the Prophet. O ye who believe! Ask blessings on him and salute him with a worthy salutation.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"klanjati, moliti","en":"to pray"},"passage":["إِنَّ","ٱللَّهَ","وَمَلَٰٓئِكَتَهُۥ","يُصَلُّونَ","عَلَى","ٱلنَّبِىِّ","يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوا۟","صَلُّوا۟","عَلَيْهِ","وَسَلِّمُوا۟","تَسْلِيمًا"],"marked":[9],"facts":{"verb":"صَلَّى"}},{"id":"salla-75-31-3","words":["verb:salla"],"options":[{"bs":"klanjao je","en":"he/it prayed"},{"bs":"blagosiljaju","en":"they send blessings"},{"bs":"pa klanjaj","en":"so pray"},{"bs":"klanja","en":"he/it prays"}],"ref":"75:31","answerWord":"صَلَّىٰ","answerSound":"audio/d1e6a793d1c8f5befdad.m4a","quranTranslation":{"text":"For he neither trusted, nor prayed.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"klanjati, moliti","en":"to pray"},"passage":["فَلَا","صَدَّقَ","وَلَا","صَلَّىٰ"],"marked":[3],"facts":{"verb":"صَلَّى"}},{"id":"salla-87-15-3","words":["verb:salla"],"options":[{"bs":"pa je klanjao","en":"so he/it prayed"},{"bs":"klanja","en":"he/it prays"},{"bs":"pa neka klanjaju","en":"so let them pray"},{"bs":"klanjajte!","en":"(you all) pray!"}],"ref":"87:15","answerWord":"فَصَلَّىٰ","answerSound":"audio/0e5453c918a6c4e9221f.m4a","quranTranslation":{"text":"And remembereth the name of his Lord, so prayeth,","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"klanjati, moliti","en":"to pray"},"passage":["وَذَكَرَ","ٱسْمَ","رَبِّهِۦ","فَصَلَّىٰ"],"marked":[3],"facts":{"verb":"صَلَّى"}},{"id":"salla-96-10-2","words":["verb:salla"],"options":[{"bs":"klanja","en":"he prays"},{"bs":"i klanjaj!","en":"and pray!"},{"bs":"klanjaju","en":"they pray"},{"bs":"klanjajte!","en":"(you all) pray!"}],"ref":"96:10","answerWord":"صَلَّىٰٓ","answerSound":"audio/ec90c865eb24b04d471e.m4a","quranTranslation":{"text":"A slave when he prayeth?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"klanjati, moliti","en":"to pray"},"passage":["عَبْدًا","إِذَا","صَلَّىٰٓ"],"marked":[2],"facts":{"verb":"صَلَّى"}},{"id":"salla-108-2-0","words":["verb:salla"],"options":[{"bs":"pa klanjaj","en":"so pray"},{"bs":"klanjao je","en":"he/it prayed"},{"bs":"klanjajte!","en":"(you all) pray!"},{"bs":"klanja","en":"he/it prays"}],"ref":"108:2","answerWord":"فَصَلِّ","answerSound":"audio/55e97ce721013a942dfd.m4a","quranTranslation":{"text":"So pray unto thy Lord, and sacrifice.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"klanjati, moliti","en":"to pray"},"passage":["فَصَلِّ","لِرَبِّكَ","وَٱنْحَرْ"],"marked":[0],"facts":{"verb":"صَلَّى"}},{"id":"dhabaha-2-67-8","words":["verb:dhabaha"],"options":[{"bs":"koljete","en":"you (all) slaughter"},{"bs":"koljem te","en":"I slaughter you"},{"bs":"pa su je zaklali","en":"so they slaughtered it"},{"bs":"ili ću ga zaklati","en":"I will surely slaughter him"}],"ref":"2:67","answerWord":"تَذْبَحُوا۟","answerSound":"audio/9c14140e370a48979c72.m4a","quranTranslation":{"text":"And when Moses said unto his people: Lo! Allah commandeth you that ye sacrifice a cow, they said: Dost thou make game of us? He answered: Allah forbid that I should be among the foolish!","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zaklati","en":"to slaughter"},"passage":["وَإِذْ","قَالَ","مُوسَىٰ","لِقَوْمِهِۦٓ","إِنَّ","ٱللَّهَ","يَأْمُرُكُمْ","أَن","تَذْبَحُوا۟","بَقَرَةً","قَالُوٓا۟","أَتَتَّخِذُنَا","هُزُوًا","قَالَ","أَعُوذُ","بِٱللَّهِ","أَنْ","أَكُونَ","مِنَ","ٱلْجَٰهِلِينَ"],"marked":[8],"facts":{"verb":"ذَبَحَ"}},{"id":"dhabaha-2-71-20","words":["verb:dhabaha"],"options":[{"bs":"pa su je zaklali","en":"so they slaughtered it"},{"bs":"koljem te","en":"I slaughter you"},{"bs":"ili ću ga zaklati","en":"I will surely slaughter him"},{"bs":"koljete","en":"you (all) slaughter"}],"ref":"2:71","answerWord":"فَذَبَحُوهَا","answerSound":"audio/8f26734bc1fa945e7659.m4a","quranTranslation":{"text":"(Moses) answered: Lo! He saith: Verily she is a cow unyoked; she plougheth not the soil nor watereth the tilth; whole and without mark. They said: Now thou bringest the truth. So they sacrificed her, though almost they did not.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zaklati","en":"to slaughter"},"passage":["قَالَ","إِنَّهُۥ","يَقُولُ","إِنَّهَا","بَقَرَةٌ","لَّا","ذَلُولٌ","تُثِيرُ","ٱلْأَرْضَ","وَلَا","تَسْقِى","ٱلْحَرْثَ","مُسَلَّمَةٌ","لَّا","شِيَةَ","فِيهَا","قَالُوا۟","ٱلْـَٰٔنَ","جِئْتَ","بِٱلْحَقِّ","فَذَبَحُوهَا","وَمَا","كَادُوا۟","يَفْعَلُونَ"],"marked":[20],"facts":{"verb":"ذَبَحَ"}},{"id":"dhabaha-27-21-4","words":["verb:dhabaha"],"options":[{"bs":"ili ću ga zaklati","en":"I will surely slaughter him"},{"bs":"koljete","en":"you (all) slaughter"},{"bs":"zaklan je","en":"he/it was slaughtered"},{"bs":"koljem te","en":"I slaughter you"}],"ref":"27:21","answerWord":"لَأَا۟ذْبَحَنَّهُۥٓ","answerSound":"audio/71d3107ec026b10d5459.m4a","quranTranslation":{"text":"I verily will punish him with hard punishment or I verily will slay him, or he verily shall bring me a plain excuse.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zaklati","en":"to slaughter"},"passage":["لَأُعَذِّبَنَّهُۥ","عَذَابًا","شَدِيدًا","أَوْ","لَأَا۟ذْبَحَنَّهُۥٓ","أَوْ","لَيَأْتِيَنِّى","بِسُلْطَٰنٍ","مُّبِينٍ"],"marked":[4],"facts":{"verb":"ذَبَحَ"}},{"id":"dhabaha-37-102-11","words":["verb:dhabaha"],"options":[{"bs":"koljem te","en":"I slaughter you"},{"bs":"zaklan je","en":"he/it was slaughtered"},{"bs":"pa su je zaklali","en":"so they slaughtered it"},{"bs":"ili ću ga zaklati","en":"I will surely slaughter him"}],"ref":"37:102","answerWord":"أَذْبَحُكَ","answerSound":"audio/7ddcccc77957c8be5519.m4a","quranTranslation":{"text":"And when (his son) was old enough to walk with him, (Abraham) said: O my dear son, I have seen in a dream that I must sacrifice thee. So look, what thinkest thou? He said: O my father! Do that which thou art commanded. Allah willing, thou shalt find me of the steadfast.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"zaklati","en":"to slaughter"},"passage":["فَلَمَّا","بَلَغَ","مَعَهُ","ٱلسَّعْىَ","قَالَ","يَٰبُنَىَّ","إِنِّىٓ","أَرَىٰ","فِى","ٱلْمَنَامِ","أَنِّىٓ","أَذْبَحُكَ","فَٱنظُرْ","مَاذَا","تَرَىٰ","قَالَ","يَٰٓأَبَتِ","ٱفْعَلْ","مَا","تُؤْمَرُ","سَتَجِدُنِىٓ","إِن","شَآءَ","ٱللَّهُ","مِنَ","ٱلصَّٰبِرِينَ"],"marked":[11],"facts":{"verb":"ذَبَحَ"}},{"id":"takallama-24-16-8","words":["verb:takallama"],"options":[{"bs":"govorimo","en":"we speak"},{"bs":"govori","en":"speaks"},{"bs":"progovorit će","en":"will speak"},{"bs":"govore","en":"they speak"}],"ref":"24:16","answerWord":"نَّتَكَلَّمَ","answerSound":"audio/a3562fb5a5c18d2dd79d.m4a","quranTranslation":{"text":"Wherefor, when ye heard it, said ye not: It is not for us to speak of this. Glory be to Thee (O Allah)! This is awful calumny.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"govoriti","en":"to speak"},"passage":["وَلَوْلَآ","إِذْ","سَمِعْتُمُوهُ","قُلْتُم","مَّا","يَكُونُ","لَنَآ","أَن","نَّتَكَلَّمَ","بِهَٰذَا","سُبْحَٰنَكَ","هَٰذَا","بُهْتَٰنٌ","عَظِيمٌ"],"marked":[8],"facts":{"verb":"تَكَلَّمَ"}},{"id":"takallama-30-35-5","words":["verb:takallama"],"options":[{"bs":"govori","en":"speaks"},{"bs":"progovorit će","en":"will speak"},{"bs":"govore","en":"they speak"},{"bs":"govorimo","en":"we speak"}],"ref":"30:35","answerWord":"يَتَكَلَّمُ","answerSound":"audio/6398b10a7857cab857c5.m4a","quranTranslation":{"text":"Or have We revealed unto them any warrant which speaketh of that which they associate with Him?","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"govoriti","en":"to speak"},"passage":["أَمْ","أَنزَلْنَا","عَلَيْهِمْ","سُلْطَٰنًا","فَهُوَ","يَتَكَلَّمُ","بِمَا","كَانُوا۟","بِهِۦ","يُشْرِكُونَ"],"marked":[5],"facts":{"verb":"تَكَلَّمَ"}},{"id":"takallama-78-38-6","words":["verb:takallama"],"options":[{"bs":"govore","en":"they speak"},{"bs":"govorimo","en":"we speak"},{"bs":"progovorit će","en":"will speak"},{"bs":"govori","en":"speaks"}],"ref":"78:38","answerWord":"يَتَكَلَّمُونَ","answerSound":"audio/f4ff9432d6f969c4d134.m4a","quranTranslation":{"text":"On the day when the angels and the Spirit stand arrayed, they speak not, saving him whom the Beneficent alloweth and who speaketh right.","by":"M. M. Pickthall (1930), via tanzil.net"},"gloss":{"bs":"govoriti","en":"to speak"},"passage":["يَوْمَ","يَقُومُ","ٱلرُّوحُ","وَٱلْمَلَٰٓئِكَةُ","صَفًّا","لَّا","يَتَكَلَّمُونَ","إِلَّا","مَنْ","أَذِنَ","لَهُ","ٱلرَّحْمَٰنُ","وَقَالَ","صَوَابًا"],"marked":[6],"facts":{"verb":"تَكَلَّمَ"}}]