m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "أَجْرِمْ", "plain": "أَجْرِمْ", "quran": false, "notUsed": false, "spoken": "audio/ebd2afd4a1140e9e3358.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "أَجْرِمِي", "plain": "أَجْرِمِي", "quran": false, "notUsed": false, "spoken": "audio/ccf401b1df8aba3f460a.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "أَجْرِمَا", "plain": "أَجْرِمَا", "quran": false, "notUsed": false, "spoken": "audio/3bf3f54e8e580a2b18fb.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "أَجْرِمُوا", "plain": "أَجْرِمُوا", "quran": false, "notUsed": false, "spoken": "audio/7691b194d6e41424eda3.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "أَجْرِمْنَ", "plain": "أَجْرِمْنَ", "quran": false, "notUsed": false, "spoken": "audio/ef1795a58e6f30d348e0.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "83:29", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/5877.mp3", "translation": {"en": {"text": "Lo! the guilty used to laugh at those who believed,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Doğrusu o suç işleyenler inananlara gülüyorlardı.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "بیشک مجرم لوگ ایمان والوں سے ہنسا کرتے تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Sesungguhnya orang-orang yang berdosa, adalah mereka yang menertawakan orang-orang yang beriman.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْرَمُوا۟", "hit": true, "audio": "audio/fdbd2846a966f12b9cc8.m4a", "gloss": {"bs": "činili su zločine", "en": "they committed crimes", "tr": "suç işlediler", "fr": "ils ont commis des crimes", "id": "mereka melakukan kejahatan", "ur": "انہوں نے جرم کیے", "bn": "তারা অপরাধ করল", "fa": "آنان مرتکب جرم شدند"}}, {"text": "كَانُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "مِنَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "ءَامَنُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "يَضْحَكُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "11:35", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1508.mp3", "translation": {"en": {"text": "Or say they (again): He hath invented it? Say: If I have invented it, upon me be my crimes, but I am innocent of (all) that ye commit.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yoksa \"Onu uydurdu\" mu diyorlar? De ki; \"Eğer uydurdumsa vebali benim boynumadır. Bense sizin yüklendiğiniz vebalden uzağım\".", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "کیا یہ کہتے ہیں کہ انہوں نے اپنے جی سے بنالیا تم فرماؤ اگر میں نے بنالیا ہوگا تو میرا گناہ مجھ پر ہے اور میں تمہارے گناہ سے الگ ہوں،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Malahan kaum Nuh itu berkata: \"Dia cuma membuat-buat nasihatnya saja\". Katakanlah: \"Jika aku membuat-buat nasihat itu, maka hanya akulah yang memikul dosaku, dan aku berlepas diri dari dosa yang kamu perbuat\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَقُولُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱفْتَرَىٰهُ", "hit": false, "audio": null, "gloss": null}, {"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱفْتَرَيْتُهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "فَعَلَىَّ", "hit": false, "audio": null, "gloss": null}, {"text": "إِجْرَامِى", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنَا۠", "hit": false, "audio": null, "gloss": null}, {"text": "بَرِىٓءٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تُجْرِمُونَ", "hit": true, "audio": "audio/4883e4d1c87829e3aa77.m4a", "gloss": {"bs": "činite (zločine)", "en": "you (all) commit (crimes)", "tr": "(suç) işlersiniz", "fr": "vous commettez (des crimes)", "id": "kalian melakukan (kejahatan)", "ur": "تم سب (جرم) کرتے ہو", "bn": "তোমরা (অপরাধ) কর", "fa": "شما (جرم) مرتکب می‌شوید"}}]}, {"ref": "34:25", "tense": "past", "category": {"tense": "past", "pronoun": "nahnu", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3631.mp3", "translation": {"en": {"text": "Say: Ye will not be asked of what we committed, nor shall we be asked of what ye do.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki: \"Siz bizim yaptığımız günahlardan sorumlu tutulmazsınız. Biz de sizin yaptıklarınızdan sorumlu olmayız.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ ہم نے تمہارے گمان میں اگر کوئی جرم کیا تو اس کی تم سے پوچھ نہیں، نہ تمہارے کوتکوں کا ہم سے سوال", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah: \"Kamu tidak akan ditanya (bertanggung jawab) tentang dosa yang kami perbuat dan kami tidak akan ditanya (pula) tentang apa yang kamu perbuat\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُل", "hit": false, "audio": null, "gloss": null}, {"text": "لَّا", "hit": false, "audio": null, "gloss": null}, {"text": "تُسْـَٔلُونَ", "hit": false, "audio": null, "gloss": null}, {"text": "عَمَّآ", "hit": false, "audio": null, "gloss": null}, {"text": "أَجْرَمْنَا", 