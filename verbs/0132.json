80.m4a", "recited": "audio/182e9e13cd7efc0b4810.m4a", "recitedText": "جَٰهِدِ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "جَاهِدِي", "plain": "جَاهِدِي", "quran": false, "notUsed": false, "spoken": "audio/3b0a4fafa6a8bf7abbcf.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "جَاهِدَا", "plain": "جَاهِدَا", "quran": false, "notUsed": false, "spoken": "audio/acbab1feb366ab445b7c.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "جَٰهِدُوا۟", "plain": "جَاهِدُوا", "quran": true, "notUsed": false, "spoken": "audio/4ef9c36ac257db094fa5.m4a", "recited": "audio/9af2c97e88efb4a41dd6.m4a", "recitedText": "وَجَٰهِدُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "جَاهِدْنَ", "plain": "جَاهِدْنَ", "quran": false, "notUsed": false, "spoken": "audio/93afcbf5365f75bfdfa9.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "29:69", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3409.mp3", "translation": {"en": {"text": "As for those who strive in Us, We surely guide them to Our paths, and lo! Allah is with the good.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Ama bizim yolumuzda cihad edenleri, elbette kendi yollarımıza eriştireceğiz. Hiç şüphe yok ki Allah iyi davrananlarla beraberdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جنہوں نے ہماری راہ میں کوشش کی ضرور ہم انہیں اپنے راستے دکھادیں گے اور بیشک اللہ نیکوں کے ساتھ ہے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan orang-orang yang berjihad untuk (mencari keridhaan) Kami, benar-benar akan Kami tunjukkan kepada mereka jalan-jalan Kami. Dan sesungguhnya Allah benar-benar beserta orang-orang yang berbuat baik.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَٱلَّذِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "جَٰهَدُوا۟", "hit": true, "audio": "audio/8c4fda709c408c6d2df2.m4a", "gloss": {"bs": "trudili su se", "en": "they strove", "tr": "çaba gösterdiler", "fr": "ils ont lutté", "id": "mereka berjuang", "ur": "انہوں نے جدوجہد کی", "bn": "তারা চেষ্টা করেছে", "fa": "جهاد کردند"}}, {"text": "فِينَا", "hit": false, "audio": null, "gloss": null}, {"text": "لَنَهْدِيَنَّهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "سُبُلَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "وَإِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَمَعَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْمُحْسِنِينَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "25:52", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2907.mp3", "translation": {"en": {"text": "So obey not the disbelievers, but strive against them herewith with a great endeavour.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Madem ki yalnız seni gönderdik) Öyleyse kâfirlere boyun eğme ve bununla (Kur'ân ile) onlara karşı olanca gücünle büyük bir savaş ver!", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تو کافروں کا کہا نہ مان اور اس قرآن سے ان پر جہاد کر بڑا جہاد،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Maka janganlah kamu mengikuti orang-orang kafir, dan berjihadlah terhadap mereka dengan Al Quran dengan jihad yang besar.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تُطِعِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْكَٰفِرِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "وَجَٰهِدْهُم", "hit": true, "audio": "audio/6b931fe9be9c3e20770d.m4a", "gloss": {"bs": "i bori se protiv njih", "en": "and strive against them", "tr": "ve onlara karşı cihat et", "fr": "et lutte contre eux", "id": "dan berjuanglah melawan mereka", "ur": "اور ان سے جہاد کرو", "bn": "এবং তাদের বিরুদ্ধে সংগ্রাম করো", "fa": "و با آنان جهاد کن"}}, {"text": "بِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "جِهَادًا", "hit": false, "audio": null, "gloss": null}, {"text": "كَبِيرًا", "hit": false, "audio": null, "gloss": null}]}, {"ref": "29:6", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3346.mp3", "translation": {"en": {"text": "And whosoever striveth, striveth only for himself, for lo! Allah is altogether Independent of (His) creatures.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Cihad eden ancak kendisi için cihad etmiş olur. Şüphesiz Allah, âlemlerden müstağnidir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جو اللہ کی راہ میں کوشش کرے تو اپنے ہی بھلے کو کوشش کرتا ہے بیشک اللہ بے پرواہ ہے سارے جہان سے", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan barangsiapa yang berjihad, maka sesungguhnya jihadnya itu adalah untuk dirinya sendiri. Sesungguhnya Allah benar-benar Maha Kaya (tidak memerlukan sesuatu) dari semesta alam.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَمَن", "hit": false, "audio": null, "gloss": null}, {"text": "جَٰهَدَ", "hit": true, "audio": "audio/2ed6340225e675587a06.m4a", "gloss": {"bs": "trudi se", "en": "he strives", "tr": "çaba gösterir", "fr": "il lutte", "id": "dia berjuang", "ur": "اس نے جدوجہد کی", "bn": "সে চেষ্টা করেছে", "fa": "جهاد کرد"}}, {"text": "فَإِنَّمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُجَٰهِدُ", "hit": true, "audio": "audio/3f1cf9c8529e1fcf12d9.m4a", "gloss": {"bs": "trudi se", "en": "he strives", "tr": "çaba gösterir", "fr": "il lutte", "id": "dia berjuang", "ur": "وہ جدوجہد کرتا ہے", "bn": "সে চেষ্টা করে", "fa": "جهاد می‌کند"}}, {"text": "لِنَفْسِهِۦٓ", "hit": false, "audio": null, "gloss": null}, {"text": "إِنَّ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهَ", "hit": false, "audio": null, "gloss": null}, {"text": "لَغَنِىٌّ", "hit": false, "audio": null, "gloss": null}, {"text": "عَنِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْعَٰلَمِينَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "وَجَٰهَدُوا۟", "count": 6, "first": "2:218", "audio": "audio/a62e7a6930ae64efb682.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"en": "and they strove", "bs": "i trudili su se", "tr": "ve çabaladılar", "fr": "et ils se sont efforcés", "id": "dan mereka bersungguh-sungguh", "ur": "اور انہوں نے کوشش کی", "bn": "এবং তারা চেষ্টা করল", "fa": "و کوشیدند"}}, {"arabic": "جَٰهَدُوا۟", "count": 5, "first": "3:142", "audio": "audio/8c4fda709c408c6d2df2.m4a", "grammar": [{"tense": "past", "pronoun": "hum", "passive": false, "objects": []}], "gloss": {"bs": "trudili su se", "en": "they strove", "tr": "çaba gösterdiler", "fr": "ils ont lutté", "id": "mereka berjuang", "ur": "انہوں نے جدوجہد کی", "bn": "তারা চেষ্টা করেছে", "fa": "جهاد کردند"}}, {"arabic": "وَجَٰهِدُوا۟", "count": 4, "first": "5:35", "audio": "audio/9af2c97e88efb4a41dd6.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "and (you all) strive!", "bs": "i trudite se!", "tr": "ve çabalayın!", "fr": "et efforcez-vous !", "id": "dan bersungguh-sungguhlah kalian!", "ur": "اور کوشش کرو!", "bn": "এবং তোমরা চেষ্টা কর!", "fa": "و بکوشید!"}}, {"arabic": "يُجَٰهِدُوا۟", "count": 2, "first": "9:44", "audio": "audio/1ce0528f4e86c6432159.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "subjunctive"}], "gloss": {"en": "they strive", "bs": "trude se", "tr": "çabalarlar", "fr": "qu'ils s'efforcent", 