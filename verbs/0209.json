alse, "spoken": "audio/b5fcdec651e5d019588e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِفْرَحِي", "plain": "اِفْرَحِي", "quran": false, "notUsed": false, "spoken": "audio/6cc6968d05a328b147f6.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِفْرَحَا", "plain": "اِفْرَحَا", "quran": false, "notUsed": false, "spoken": "audio/ca1d0c2cebdc82d5a793.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "اِفْرَحُوا", "plain": "اِفْرَحُوا", "quran": false, "notUsed": false, "spoken": "audio/a19cc3db1c8326a75d81.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِفْرَحْنَ", "plain": "اِفْرَحْنَ", "quran": false, "notUsed": false, "spoken": "audio/b703d84155180e64b918.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "10:58", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1422.mp3", "translation": {"en": {"text": "Say: In the bounty of Allah and in His mercy: therein let them rejoice. It is better than what they hoard.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "De ki, \"Allah'ın ihsanıyla ve rahmetiyle, yalnızca bunlarla sevinç duysunlar. Bu, onların biriktirip durduklarından daha hayırlıdır.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "تم فرماؤ اللہ ہی کے فضل اور اسی کی رحمت اور اسی پر چاہیے کہ خوشی کریں وہ ان کے سب دھن دولت سے بہتر ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Katakanlah: \"Dengan kurnia Allah dan rahmat-Nya, hendaklah dengan itu mereka bergembira. Kurnia Allah dan rahmat-Nya itu adalah lebih baik dari apa yang mereka kumpulkan\".", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قُلْ", "hit": false, "audio": null, "gloss": null}, {"text": "بِفَضْلِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱللَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "وَبِرَحْمَتِهِۦ", "hit": false, "audio": null, "gloss": null}, {"text": "فَبِذَٰلِكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلْيَفْرَحُوا۟", "hit": true, "audio": "audio/233f0c0664032a40a887.m4a", "gloss": {"bs": "neka se raduju", "en": "let them rejoice", "tr": "sevinsinler", "fr": "qu'ils se réjouissent", "id": "biarlah mereka bergembira", "ur": "پس وہ خوش ہوں", "bn": "তারা আনন্দিত হোক", "fa": "پس باید شادی کنند"}}, {"text": "هُوَ", "hit": false, "audio": null, "gloss": null}, {"text": "خَيْرٌ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّمَّا", "hit": false, "audio": null, "gloss": null}, {"text": "يَجْمَعُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "40:75", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4208.mp3", "translation": {"en": {"text": "(And it is said unto them): This is because ye exulted in the earth without right, and because ye were petulant.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Bunun sebebi şudur: Çünkü siz yeryüzünde haksız yere seviniyor ve güveniyordunuz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یہ اس کا بدلہ ہے جو تم زمین میں باطل پر خوش ہوتے تھے اور اس کا بدلہ ہے جو تم اتراتے تھے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Yang demikian itu disebabkan karena kamu bersuka ria di muka bumi dengan tidak benar dan karena kamu selalu bersuka ria (dalam kemaksiatan).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "ذَٰلِكُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَفْرَحُونَ", "hit": true, "audio": "audio/067da2e7e35406ecf268.m4a", "gloss": {"en": "you (all) rejoice", "bs": "radujete se", "tr": "sevinirsiniz", "fr": "vous vous réjouissez", "id": "kalian bergembira", "ur": "تم سب خوش ہوتے ہو", "bn": "তোমরা আনন্দিত হও", "fa": "شادمان می‌شوید"}}, {"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَرْضِ", "hit": false, "audio": null, "gloss": null}, {"text": "بِغَيْرِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْحَقِّ", "hit": false, "audio": null, "gloss": null}, {"text": "وَبِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "كُنتُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تَمْرَحُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "30:4", "tense": "present", "category": {"tense": "present", "pronoun": "huwa", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/3413.mp3", "translation": {"en": {"text": "Within ten years - Allah's is the command in the former case and in the latter - and in that day believers will rejoice", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Bu da) birkaç yıl içinde (olacaktır). Onların bu yenilgilerinden önce de sonra da emir Allah'ındır ve o gün müminler, sevineceklerdir.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "چند برس میں حکم اللہ ہی کا ہے آگے اور پیچھے اور اس دن ایمان والے خوش ہوں گے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "dalam beberapa tahun lagi. Bagi Allah-lah urusan sebelum dan sesudah (mereka menang). Dan di hari (kemenangan bangsa Rumawi) itu bergembiralah orang-orang yang beriman,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "فِى", "hit": false, "audio": null, "gloss": null}, {"text": "بِضْعِ", "hit": false, "audio": null, "gloss": null}, {"text": "سِنِينَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِلَّهِ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْأَمْرُ", "hit": false, "audio": n