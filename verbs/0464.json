xt": "أَحْسَنُ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلسَّيِّئَةَ", "hit": false, "audio": null, "gloss": null}, {"text": "نَحْنُ", "hit": false, "audio": null, "gloss": null}, {"text": "أَعْلَمُ", "hit": false, "audio": null, "gloss": null}, {"text": "بِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَصِفُونَ", "hit": false, "audio": null, "gloss": null}]}], "forms": [{"arabic": "ٱدْفَعْ", "count": 2, "first": "23:96", "audio": "audio/286f44b0e8e61b4aa357.m4a", "grammar": [{"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}], "gloss": {"bs": "odbij", "en": "repel", "tr": "defet", "fr": "repousse", "id": "tolaklah", "ur": "دفع کرو", "bn": "প্রতিহত কর", "fa": "دفع کن"}}, {"arabic": "ٱدْفَعُوا۟", "count": 1, "first": "3:167", "audio": "audio/53fa20f4050a6c3fd60f.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "(you all) repel!", "bs": "odbijte!", "tr": "defedin!", "fr": "repoussez !", "id": "tolaklah kalian!", "ur": "دفع کرو!", "bn": "প্রতিহত কর!", "fa": "دفع کنید!"}}, {"arabic": "فَٱدْفَعُوٓا۟", "count": 1, "first": "4:6", "audio": "audio/fb107ccdd62cd99341d9.m4a", "grammar": [{"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "so (you all) deliver!", "bs": "pa predajte!", "tr": "böylece teslim edin!", "fr": "alors livrez !", "id": "maka serahkanlah kalian!", "ur": "پس تم سب سپرد کرو!", "bn": "অতএব সমর্পণ কর!", "fa": "پس تسلیم کنید!"}}, {"arabic": "دَفَعْتُمْ", "count": 1, "first": "4:6", "audio": "audio/b407556ec2e8a7771f76.m4a", "grammar": [{"tense": "past", "pronoun": "antum", "passive": false, "objects": []}], "gloss": {"en": "you (all) delivered", "bs": "predali ste", "tr": "teslim ettiniz", "fr": "vous avez livré", "id": "kalian telah menyerahkan", "ur": "تم سب نے سپرد کیا", "bn": "তোমরা সমর্পণ করেছ", "fa": "تسلیم کردید"}}], "ayatFile": "ayat/0464.json", "ayatTranslations": {"en": "ayat/0464.en.json", "tr": "ayat/0464.tr.json", "ur": "ayat/0464.ur.json", "id": "ayat/0464.id.json"}, "sentences": [{"arabic": "اِدْفَعْ هَذَا الْبَابَ", "spoken": "audio/3a3c61c4701a04006bb4.m4a", "tense": "imperative", "pronoun": "anta", "translation": {"bs": "Gurni ova vrata.", "en": "Push this door.", "bn": "এই দরজাটা ঠেল।", "fa": "این در را هل بده.", "fr": "Pousse cette porte.", "id": "Dorong pintu ini.", "tr": "Bu kapıyı it.", "ur": "اس دروازے کو دھکیلو۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِدْفَعْ", "target": true, "translation": {"bs": "gurni", "en": "push", "bn": "ঠেল", "fa": "هل بده", "fr": "pousse", "id": "dorong", "tr": "it", "ur": "دھکیلو"}}, {"arabic": "هَذَا", "target": false, "translation": {"bs": "ova", "en": "this", "bn": "এই", "fa": "این", "fr": "ceci", "id": "ini", "tr": "bu", "ur": "یہ"}}, {"arabic": "الْبَابَ", "target": false, "translation": {"bs": "vrata", "en": "door", "bn": "দরজা", "fa": "در", "fr": "la porte", "id": "pintu itu", "tr": "kapı", "ur": "دروازہ"}}]}, {"arabic": "اِدْفَعُوا ثَمَنَ التَّذَاكِرِ", "spoken": "audio/288f5b0a911cf573a173.m4a", "tense": "imperative", "pronoun": "antum", "translation": {"bs": "Platite (svi) karte.", "en": "Pay for the tickets, (all of you).", "bn": "তোমরা টিকিটের মূল্য পরিশোধ কর।", "fa": "بهای بلیت‌ها را بپردازید.", "fr": "Payez le prix des billets, vous tous.", "id": "Bayarlah harga tiket-tiket itu, kalian semua.", "tr": "Biletlerin bedelini ödeyin.", "ur": "تم سب ٹکٹوں کی قیمت ادا کرو۔"}, "independentlyReviewed": true, "words": [{"arabic": "اِدْفَعُوا", "target": true, "translation": {"bs": "platite", "en": "pay", "bn": "তোমরা পরিশোধ কর", "fa": "بپردازید", "fr": "payez", "id": "bayarlah (kalian semua)", "tr": "ödeyin", "ur": "تم سب ادا کرو"}}, {"arabic": "ثَمَنَ", "target": false, "translation": {"bs": "cijenu", "en": "the price of", "bn": "মূল্য", "fa": "بهای", "fr": "le prix de", "id": "harga", "tr": "fiyatı", "ur": "قیمت"}}, {"arabic": "التَّذَاكِرِ", "target": false, "translation": {"bs": "karata", "en": "the tickets", "bn": "টিকিট", "fa": "بلیت‌ها", "fr": "les billets", "id": "tiket-tiket itu", "tr": "biletler", "ur": "ٹکٹ"}}]}, {"arabic": "دَفَعْتُمْ ثَمَنًا كَبِيرًا", "spoken": "audio/0904be6c365e809332de.m4a", "tense": "past", "pronoun": "antum", "translation": {"bs": "Vi (svi) ste platili veliku cijenu.", "en": "You (all) paid a great price.", "bn": "তোমরা অনেক বড় মূল্য দিয়েছ।", "fa": "شما بهای سنگینی پرداختید.", "fr": "Vous avez payé un lourd prix.", "id": "Kalian telah membayar harga yang besar.", "tr": "Büyük bir bedel ödediniz.", "ur": "تم سب نے بڑی قیمت ادا کی۔"}, "independentlyReviewed": true, "words": [{"arabic": "دَفَعْتُمْ", "target": true, "translation": {"bs": "platili ste", "en": "paid", "bn": "তোমরা পরিশোধ করেছ", "fa": "پرداختید", "fr": "vous avez payé", "id": "kalian telah membayar", "tr": "ödediniz", "ur": "تم سب نے ادا کیا"}}, {"arabic": "ثَمَنًا", "target": false, "translation": {"bs": "cijenu", "en": "a price", "bn": "একটি মূল্য", "fa": "بهایی", "fr": "un prix", "id": "sebuah harga", "tr": "bir bedel", "ur": "ایک قیمت"}}, {"arabic": "كَبِيرًا", "target": false, "translation": {"bs": "veliku", "en": "great", "bn": "বড়", "fa": "بزرگ", "fr": "grand", "id": "besar", "tr": "büyük", "ur": "بڑا"}}]}]}