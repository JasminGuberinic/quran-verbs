hum", "translation": {"bs": "Nisu u kući.", "en": "They are not in the house.", "bn": "তারা ঘরে নেই।", "fa": "آنان در خانه نیستند.", "fr": "Ils ne sont pas dans la maison.", "id": "Mereka tidak ada di rumah.", "tr": "Evde değiller.", "ur": "وہ گھر میں نہیں ہیں۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَيْسُوا", "target": true, "translation": {"bs": "nisu", "en": "are not", "bn": "নও", "fa": "نیستند", "fr": "ne sont pas", "id": "tidak", "tr": "değiller", "ur": "نہیں ہیں"}}, {"arabic": "فِي", "target": false, "translation": {"bs": "u", "en": "in", "bn": "মধ্যে", "fa": "در", "fr": "dans", "id": "di", "tr": "içinde", "ur": "میں"}}, {"arabic": "الْبَيْتِ", "target": false, "translation": {"bs": "kući", "en": "the house", "bn": "বাড়িতে", "fa": "خانه", "fr": "la maison", "id": "rumah itu", "tr": "ev", "ur": "گھر"}}]}, {"arabic": "لَيْسَتِ السَّمَاءُ صَافِيَةً", "spoken": "audio/0d7451486a549d0e2e9f.m4a", "tense": "past", "pronoun": "hiya", "translation": {"bs": "Nebo nije vedro.", "en": "The sky is not clear.", "bn": "আকাশ পরিষ্কার নয়।", "fa": "آسمان صاف نیست.", "fr": "Le ciel n'est pas dégagé.", "id": "Langit tidak cerah.", "tr": "Gökyüzü açık değil.", "ur": "آسمان صاف نہیں ہے۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَيْسَتِ", "target": true, "translation": {"bs": "nije", "en": "is not", "bn": "নয়", "fa": "نیست", "fr": "n'est pas", "id": "tidak", "tr": "değil", "ur": "نہیں ہے"}}, {"arabic": "السَّمَاءُ", "target": false, "translation": {"bs": "nebo", "en": "the sky", "bn": "আকাশ", "fa": "آسمان", "fr": "le ciel", "id": "langit", "tr": "gökyüzü", "ur": "آسمان"}}, {"arabic": "صَافِيَةً", "target": false, "translation": {"bs": "vedro", "en": "clear", "bn": "পরিষ্কার", "fa": "صاف", "fr": "dégagé", "id": "cerah", "tr": "açık", "ur": "صاف"}}]}, {"arabic": "لَسْتُ مُتَأَخِّرًا", "spoken": "audio/34e8c19e29d46ee029c0.m4a", "tense": "past", "pronoun": "ana", "translation": {"bs": "Nisam zakasnio.", "en": "I am not late.", "bn": "আমি দেরি করিনি।", "fa": "من دیر نکرده‌ام.", "fr": "Je ne suis pas en retard.", "id": "Aku tidak terlambat.", "tr": "Geç kalmadım.", "ur": "میں دیر سے نہیں آیا۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَسْتُ", "target": true, "translation": {"bs": "nisam", "en": "I am not", "bn": "আমি নই", "fa": "نیستم", "fr": "je ne suis pas", "id": "aku tidak", "tr": "değilim", "ur": "میں نہیں ہوں"}}, {"arabic": "مُتَأَخِّرًا", "target": false, "translation": {"bs": "zakasnio", "en": "late", "bn": "দেরিতে", "fa": "دیر", "fr": "tard", "id": "terlambat", "tr": "geç", "ur": "دیر سے"}}]}, {"arabic": "لَسْتَ وَحْدَكَ", "spoken": "audio/c14a25d95479b18fd83b.m4a", "tense": "past", "pronoun": "anta", "translation": {"bs": "Nisi sam.", "en": "You are not alone.", "bn": "তুমি একা নও।", "fa": "تو تنها نیستی.", "fr": "Tu n'es pas seul.", "id": "Kamu tidak sendirian.", "tr": "Yalnız değilsin.", "ur": "تم اکیلے نہیں ہو۔"}, "independentlyReviewed": true, "words": [{"arabic": "لَسْتَ", "target": true, "translation": {"bs": "nisi", "en": "you are not", "bn": "তুমি নও", "fa": "نیستی", "fr": "tu n'es pas", "id": "kamu tidak", "tr": "değilsin", "ur": "تم نہیں ہو"}}, {"arabic": "وَحْدَكَ", "target": false, "translation": {"bs": "sam", "en": "alone", "bn": "একা", "fa": "تنها", "fr": "seul", "id": "sendirian", "tr": "yalnız", "ur": "اکیلے"}}]}]}