{"rank": 125, "root": "ولي", "form": 2, "lemma": "وَلَّى", "count": 30, "ayahCount": 27, "share": 0.16, "meaning": {"bs": "okrenuti, postaviti", "en": "to turn, to appoint", "tr": "çevirmek, tayin etmek", "fr": "se détourner, désigner", "id": "menjadikan, mengangkat", "ur": "منہ پھیرنا، مقرر کرنا", "bn": "ফেরানো, নিযুক্ত করা", "fa": "گرداندن، قرار دادن"}, "lemmaSpoken": "audio/0b7e4be5ff69f70fc035.m4a", "principal": [{"tense": "past", "pronoun": "huwa", "arabic": "وَلَّىٰ", "plain": "وَلَّى", "quran": true, "notUsed": false, "spoken": "audio/0b7e4be5ff69f70fc035.m4a", "recited": "audio/c699ce672029ca03ac63.m4a", "recitedText": "وَلَّىٰ"}, {"tense": "present", "pronoun": "huwa", "arabic": "يُوَلِّي", "plain": "يُوَلِّي", "quran": false, "notUsed": false, "spoken": "audio/f1b8b3649990de8b2c8e.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "وَلِّ", "plain": "وَلِّ", "quran": true, "notUsed": false, "spoken": "audio/ae8343a2fd06e56e0f1a.m4a", "recited": "audio/7a5289a9fd4077c6732c.m4a", "recitedText": "فَوَلِّ"}], "nouns": {"participle": {"lemma": "مُوَلِّي", "count": 1, "spoken": "audio/70251cc2a4d12ecbce59.m4a"}}, "cells": [{"tense": "past", "pronoun": "ana", "arabic": "وَلَّيْتُ", "plain": "وَلَّيْتُ", "quran": false, "notUsed": false, "spoken": "audio/5ed7c37f3632138d13ec.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "nahnu", "arabic": "وَلَّيْنَا", "plain": "وَلَّيْنَا", "quran": false, "notUsed": false, "spoken": "audio/64868afa807a9a417ae2.m4a", "recited": null, "recitedText": null}, {"tense": "past", "pronoun": "anta", "arabic": "وَلَّيْتَ", "plain": "وَلَّيْتَ", "quran": true, "notUsed": false, "spoken": "audio/8d839fdfeda09720e23d.m4a", "recited": "audio/ff12b46fa44918b8bb36.m4a", "recitedText": "لَوَلَّيْتَ"}, {"tense": "past", "pronoun": "anti", "arabic": "وَلَّيْتِ", "plain": "وَلَّيْتِ", "quran": false, "notUsed": false, "spoken": "audio/f723996ccde8836aec1d.m4a", "recited": nul