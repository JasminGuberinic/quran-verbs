": "audio/95b2942d924e562f2286.m4a", "recited": null, "recitedText": null}, {"tense": "present", "pronoun": "hum", "arabic": "يَسْتَمِعُونَ", "plain": "يَسْتَمِعُونَ", "quran": true, "notUsed": false, "spoken": "audio/a6713ca95fbaade378c2.m4a", "recited": "audio/7e790e869227a12cba9d.m4a", "recitedText": "يَسْتَمِعُونَ"}, {"tense": "present", "pronoun": "hunna", "arabic": "يَسْتَمِعْنَ", "plain": "يَسْتَمِعْنَ", "quran": false, "notUsed": false, "spoken": "audio/61219c4eff3bd68fb3e6.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "anta", "arabic": "ٱسْتَمِعْ", "plain": "اِسْتَمِعْ", "quran": true, "notUsed": false, "spoken": "audio/2f7f34a26e453d047182.m4a", "recited": "audio/25fbc923c6e3b6fac66e.m4a", "recitedText": "فَٱسْتَمِعْ"}, {"tense": "imperative", "pronoun": "anti", "arabic": "اِسْتَمِعِي", "plain": "اِسْتَمِعِي", "quran": false, "notUsed": false, "spoken": "audio/dd2857c21b62ebf1d745.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antuma", "arabic": "اِسْتَمِعَا", "plain": "اِسْتَمِعَا", "quran": false, "notUsed": false, "spoken": "audio/d5fcbd8fb5dd53051bff.m4a", "recited": null, "recitedText": null}, {"tense": "imperative", "pronoun": "antum", "arabic": "ٱسْتَمِعُوا۟", "plain": "اِسْتَمِعُوا", "quran": true, "notUsed": false, "spoken": "audio/e8b3c17c182547bf7dd9.m4a", "recited": "audio/12edadd7cf73af8ca1ec.m4a", "recitedText": "فَٱسْتَمِعُوا۟"}, {"tense": "imperative", "pronoun": "antunna", "arabic": "اِسْتَمِعْنَ", "plain": "اِسْتَمِعْنَ", "quran": false, "notUsed": false, "spoken": "audio/290f4348aca259a69ec6.m4a", "recited": null, "recitedText": null}], "ayat": [{"ref": "52:38", "tense": "present", "category": {"tense": "present", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/4773.mp3", "translation": {"en": {"text": "Or have they any stairway (unto heaven) by means of which they overhear (decrees). Then let their listener produce some warrant manifest!", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Yoksa kendilerine mahsus (üzerine çıkıp sırları) dinleyecekleri bir merdivenleri mi var? Öyleyse dinleyenleri, açık bir delil getirsin.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "یا ان کے پاس کوئی زینہ ہے جس میں چڑھ کر سن لیتے ہیں تو ان کا سننے والا کوئی روشن سند لائے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Ataukah mereka mempunyai tangga (ke langit) untuk mendengarkan pada tangga itu (hal-hal yang gaib)? Maka hendaklah orang yang mendengarkan di antara mereka mendatangkan suatu keterangan yang nyata.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "أَمْ", "hit": false, "audio": null, "gloss": null}, {"text": "لَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "سُلَّمٌ", "hit": false, "audio": null, "gloss": null}, {"text": "يَسْتَمِعُونَ", "hit": true, "audio": "audio/876e1163ec81886512b2.m4a", "gloss": {"en": "they listen", "bs": "slušaju", "tr": "dinlerler", "fr": "ils écoutent", "id": "mereka mendengarkan", "ur": "وہ سنتے ہیں", "bn": "তারা শোনে", "fa": "گوش می‌دهند"}}, {"text": "فِيهِ", "hit": false, "audio": null, "gloss": null}, {"text": "فَلْيَأْتِ", "hit": false, "audio": null, "gloss": null}, {"text": "مُسْتَمِعُهُم", "hit": false, "audio": null, "gloss": null}, {"text": "بِسُلْطَٰنٍ", "hit": false, "audio": null, "gloss": null}, {"text": "مُّبِينٍ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "7:204", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/1158.mp3", "translation": {"en": {"text": "And when the Qur'an is recited, give ear to it and pay heed, that ye may obtain mercy.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Kur'ân okunduğu zaman, hemen susup onu dinleyin, umulur ki, rahmete nâil olursunuz.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور جب قرآن پڑھا جائے تو اسے کان لگا کر سنو اور خاموش رہو کہ تم پر رحم ہو", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan apabila dibacakan Al Quran, maka dengarkanlah baik-baik, dan perhatikanlah dengan tenang agar kamu mendapat rahmat.", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَإِذَا", "hit": false, "audio": null, "gloss": null}, {"text": "قُرِئَ", "hit": false, "audio": null, "gloss": null}, {"text": "ٱلْقُرْءَانُ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱسْتَمِعُوا۟", "hit": true, "audio": "audio/12edadd7cf73af8ca1ec.m4a", "gloss": {"en": "so (you all) listen!", "bs": "pa slušajte!", "tr": "böylece dinleyin!", "fr": "alors écoutez !", "id": "maka dengarkanlah kalian!", "ur": "پس تم سب سنو!", "bn": "অতএব তোমরা শোনো!", "fa": "پس گوش دهید!"}}, {"text": "لَهُۥ", "hit": false, "audio": null, "gloss": null}, {"text": "وَأَنصِتُوا۟", "hit": false, "audio": null, "gloss": null}, {"text": "لَعَلَّكُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "تُرْحَمُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "20:13", "tense": "imperative", "category": {"tense": "imperative", "pronoun": "anta", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2361.mp3", "translation": {"en": {"text": "And I have chosen thee, so hearken unto that which is inspired.", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "\"Ben seni seçtim, şimdi (sana) vahyolunacak şeyleri dinle.\"", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اور میں نے تجھے پسند کیا اب کان لگا کر سن جو تجھے وحی ہوتی ہے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Dan Aku telah memilih kamu, maka dengarkanlah apa yang akan diwahyukan (kepadamu).", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "وَأَنَا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱخْتَرْتُكَ", "hit": false, "audio": null, "gloss": null}, {"text": "فَٱسْتَمِعْ", "hit": true, "audio": "audio/25fbc923c6e3b6fac66e.m4a", "gloss": {"bs": "zato slušaj", "en": "so listen", "tr": "öyleyse dinle", "fr": "alors écoute", "id": "maka dengarkanlah", "ur": "پس سنو", "bn": "অতএব মনোযোগ দিয়ে শোনো", "fa": "پس گوش بده"}}, {"text": "لِمَا", "hit": false, "audio": null, "gloss": null}, {"text": "يُوحَىٰٓ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "21:2", "tense": "past", "category": {"tense": "past", "pronoun": "hum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2485.mp3", "translation": {"en": {"text": "Never cometh there unto them a new reminder from their Lord but they listen to it while they play,", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "Rablerinden kendilerine gelen her yeni hatırlatmayı hep eğlenerek dinliyorlar.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "جب ان کے رب کے پاس سے انہیں کوئی نئی نصیحت آتی ہے تو اسے نہیں سنتے مگر کھیلتے ہوئے،", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Tidak datang kepada mereka suatu ayat Al Quran pun yang baru (di-turunkan) dari Tuhan mereka, melainkan mereka mendengarnya, sedang mereka bermain-main,", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "مَا", "hit": false, "audio": null, "gloss": null}, {"text": "يَأْتِيهِم", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "ذِكْرٍ", "hit": false, "audio": null, "gloss": null}, {"text": "مِّن", "hit": false, "audio": null, "gloss": null}, {"text": "رَّبِّهِم", "hit": false, "audio": null, "gloss": null}, {"text": "مُّحْدَثٍ", "hit": false, "audio": null, "gloss": null}, {"text": "إِلَّا", "hit": false, "audio": null, "gloss": null}, {"text": "ٱسْتَمَعُوهُ", "hit": true, "audio": "audio/027edbafed9a1f4220c4.m4a", "gloss": {"bs": "slušaju ga", "en": "they listen to it", "tr": "onu dinlerler", "fr": "ils l'écoutent", "id": "mereka mendengarkannya", "ur": "وہ اسے سنتے ہیں", "bn": "তারা তা মনোযোগ দিয়ে শোনে", "fa": "به آن گوش می‌دهند"}}, {"text": "وَهُمْ", "hit": false, "audio": null, "gloss": null}, {"text": "يَلْعَبُونَ", "hit": false, "audio": null, "gloss": null}]}, {"ref": "26:25", "tense": "present", "category": {"tense": "present", "pronoun": "antum", "passive": false, "objects": []}, "audio": "https://cdn.islamic.network/quran/audio/64/ar.alafasy/2957.mp3", "translation": {"en": {"text": "(Pharaoh) said unto those around him: Hear ye not?", "by": "M. M. Pickthall (1930), via tanzil.net"}, "tr": {"text": "(Firavun) etrafında bulunanlara: \"İşitmiyor musunuz?\" dedi.", "by": "Elmalılı Hamdi Yazır, via tanzil.net"}, "ur": {"text": "اپنے آس پاس والوں سے بولا کیا تم غور سے سنتے نہیں", "by": "احمد رضا خان، کنز الایمان · tanzil.net"}, "id": {"text": "Berkata Fir'aun kepada orang-orang sekelilingnya: \"Apakah kamu tidak mendengarkan?\"", "by": "Kementerian Agama RI, via tanzil.net"}}, "words": [{"text": "قَالَ", "hit": false, "audio": null, "gloss": null}, {"text": "لِمَنْ", "hit": false, "audio": null, "gloss": null}, {"text": "حَوْلَهُۥٓ", "hit": false, "audio": null, "gloss": null}, {"text": "أَلَا", "hit": false, "audio": null, "gloss": null}, {"text": "تَسْتَمِعُونَ", "hit": true, "audio": "audio/26ae2d06fe4e26b422ae.m4a", "gloss": {"bs": "slušate", "en": "you listen", "tr": "dinlersiniz", "fr": "vous écoutez", "id": "kamu mendengarkan", "ur": "تم سنتے ہو", "bn": "তোমরা মনোযোগ দিয়ে শোনো", "fa": "گوش می‌دهید"}}]}], "forms": [{"arabic": "يَسْتَمِعُونَ", "count": 6, "first": "10:42", "audio": "audio/7e790e869227a12cba9d.m4a", "grammar": [{"tense": "present", "pronoun": "hum", "passive": false, "objects": [], "mood": "indicative"}], "gloss": {"en": "they listen", "bs": "slušaju", "tr": "dinlerler", "fr": "ils écoutent", "id": "mereka mendengarkan", "ur": "وہ سنتے ہیں", "bn": "তারা শোনে", "fa": "گوش می‌دهند"}}, {"arabic": "يَسْتَ